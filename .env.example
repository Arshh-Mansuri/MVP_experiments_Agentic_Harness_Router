# Copy to .env and fill in. .env is gitignored; never commit it.
# Required: pays for Luna (routing and the task itself) through OpenRouter.
OPENROUTER_API_KEY=
# Optional: upload each run to Langfuse (study/langfuse_export.py). Leave empty to skip uploads.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
