#!/usr/bin/env python3
"""Modern climate data analysis for Python 3."""

from configparser import ConfigParser
from pathlib import Path

import pandas as pd


BASE_DIR = Path(__file__).resolve().parent
CONFIG_PATH = BASE_DIR / "climate_analyzer" / "config.ini"
DATA_PATH = BASE_DIR / "climate_analyzer" / "sample_data" / "climate_data.csv"


def load_config(config_path: Path) -> ConfigParser:
    """Load the UTF-8 configuration file."""
    config = ConfigParser()
    config.read(config_path, encoding="utf-8")
    return config


def main() -> None:
    config = load_config(CONFIG_PATH)
    data_path = DATA_PATH

    # Access the analysis section when present, keeping configuration loading
    # useful without making optional settings required for this calculation.
    if config.has_section("analysis"):
        config.get("analysis", "baseline_years", fallback="")

    data = pd.read_csv(data_path, encoding="utf-8", parse_dates=["date"])
    data["temperature"] = pd.to_numeric(data["temperature"], errors="raise")

    for station_id, station_data in data.groupby("station_id", sort=True):
        mean_temperature = station_data["temperature"].mean()
        print(f"Station {station_id} mean temperature: {mean_temperature:.1f}°C")


if __name__ == "__main__":
    main()
