[175.977948, "o", "\u001b[?2004hroot@4dd1c14db312:/app# "]
[176.513442, "i", "rm -f /tmp/ocr*.txt; for spec in 'orig:/app/code.png:6' 'orig11:/app/code.png:11' 'pgm:/tmp/code.pgm:6' 'bw:/tmp/bw.pgm:6' 'bw240:/tmp/bw240.pgm:6'; do name=${spec%%:*}; rest=${spec#*:}; f=${rest%:*}; p=${rest##*:}; tesseract \"$f\" \"/tmp/ocr_$name\" --psm \"$p\" 2>/dev/null; echo \"===== $name =====\"; sed -n '1,120p' \"/tmp/ocr_$name.txt\"; done\n"]
[176.514502, "o", "rm -f /tmp/ocr*.txt; for spec in 'orig:/app/code.png:6' 'orig11:/app/code.png:11' 'pgm:/tmp/code.pgm:6' 'bw:/tmp/bw.pgm:6' 'bw240:/tmp/bw240.pgm:6'; do name=${spec%%:*}; rest=${spec#*:}; f=${rest%:*}; p=${rest##*:}; tesseract \"$f\" \"/tmp/ocr_$name\" --psm \"$p\" 2>/dev/null; echo \"===== $name =====\"; sed -n '1,120p' \"/tmp/ocr_$name.txt\"; done\r\n\u001b[?2004l\r"]
[177.308503, "o", "===== orig =====\r\n"]
[177.326856, "o", "def main():\r\nSALT = 6’0000TBENCH-SALT”\r\n"]
[177.32705, "o", "img_ bytes = read_file_ bytes( ‘Tapp/code.png’)\r\nho = cha256(img_ bytes)\r\n# cha2z56(ho // hof:10] [/ SALT)\r\nH = cha256(ho, hof:10], SALT)\r\nprint(H.bex())\r\nreturn\r\n"]
[178.113307, "o", "===== orig11 =====\r\n"]
[178.130323, "o", "def main():\r\n\r\nGALT = b’0000TBENCH-SALT”\r\n\r\n"]
[178.1305, "o", "img_ bytes = read_file_ bytes( ‘Tapp/code.png’)\r\n\r\nho = cha256(img_ bytes)\r\n\r\n# cha256(ho // hof:10] |/ SALT)\r\n\r\nH = cha2z56(ho, hof:10], SALT)\r\n\r\nprint(H.bex())\r\n\r\nreturn\r\n"]
[178.900085, "o", "===== pgm =====\r\n"]
[178.917472, "o", "def main():\r\nSALT = 6’0000TBENCH-SALT”\r\n"]
[178.917726, "o", "img_ bytes = read_file_ bytes( ‘Tapp/code.png’)\r\nho = cha256(img_ bytes)\r\n# cha2z56(ho // hof:10] [/ SALT)\r\nH = cha256(ho, hof:10], SALT)\r\nprint(H.bex())\r\nreturn\r\n"]
[179.804753, "o", "===== bw =====\r\n"]
[179.821946, "o", "def main 0:\r\nSALT = 6’\"0000TBENCH-SALT’\r\n"]
[179.822165, "o", "img_ bytes = read_file_ bytes(/app/code.png”)\r\nbO = cha256(img_ bytes)\r\n# cha25s6(ho [/ hof-to] [/ SALT)\r\nH = chazs6(ho, hof:10], SALT)\r\nprint(H.bex())\r\nreturn\r\n"]
[181.006939, "o", "===== bw240 =====\r\n"]
[181.025741, "o", "def main 0:\r\nCALT = 6”\"0000TBENCH-SALT’\r\n"]
[181.025971, "o", "img_bytes = read_file_ bytes(/app/code.png’)\r\nhO = cha256(img_ bytes)\r\n# cha2s6(ho // hof:to] |/ SALT)\r\nH = cha2s6(ho, hof-10], SALT)\r\nprint (H.hex())\r\nreturn\r\n"]
[181.027417, "o", "\u001b[?2004hroot@4dd1c14db312:/app# "]
[193.328476, "i", "python3 - <<'PY'\nimport hashlib\nimg_bytes=open('/app/code.png','rb').read()\nsalt=b'0000TBENCH-SALT'\nh0=hashlib.sha256(img_bytes).digest()\nH=hashlib.sha256(h0+h0[:10]+salt).hexdigest()\nopen('/app/output.txt','w').write(H+'\\n')\nprint('h0 =',h0.hex())\nprint('H  =',H)\nprint('prefix_ok =',H.startswith('bee26a'))\nPY\ncat /app/output.txt\n"]
[193.331294, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> img_bytes=open('/app/code.png','rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> salt=b'0000TBENCH-SALT'\r\n\u001b[?2004l\r\u001b[?2004h> h0=hashlib.sha256(img_bytes).digest()\r\n\u001b[?2004l\r\u001b[?2004h> H=hashlib.sha256(h0+h0[:10]+salt).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/output.txt','w').write(H+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> print('h0 =',h0.hex())\r\n\u001b[?2004l\r\u001b[?2004h> print('H  =',H)\r\n\u001b[?2004l\r\u001b[?2004h> print('prefix_ok =',H.startswith('bee26a'))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
