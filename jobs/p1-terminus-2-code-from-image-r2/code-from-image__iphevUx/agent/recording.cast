[92.907792, "i", "cat > /tmp/braille.py <<'PY'\nexec(open('/tmp/decode.py').read().split(\"# composite onto white\")[0])\n# pix is decoded RGBA rows; convert to black mask (the image is opaque)\nmask=[]\nfor row in pix:\n mask.append([1 if (299*row[4*x]+587*row[4*x+1]+114*row[4*x+2])//1000 < 128 else 0 for x in range(w)])\nproj=[sum(r) for r in mask]\n# row bands with ink, allowing small gaps inside a line\nbands=[]; start=None; gap=0\nfor y,n in enumerate(proj+[0]):\n if n:\n  if start is None: start=y\n  gap=0\n elif start is not None:\n  gap+=1\n  if gap>=4:\n   bands.append((start,y-gap+1)); start=None; gap=0\nprint('bands',bands)\n# Braille: downsample horizontally by 2, vertically by 1 (each braille cell 2x4)\nfor bi,(a,b) in enumerate(bands):\n # include only relevant x range\n xs=[x for y in range(a,b) for x,v in enumerate(mask[y]) if v]\n if not xs: continue\n l=max(0,min(xs)-3); r=min(w,max(xs)+4)\n print('\\n--- LINE',bi,'rows',a,b,'x',l,r,'---')\n for y0 in range(a,b,4):\n  out=[]\n  for x0 in range(l,r,2):\n   dots=0\n   coords=[(0,0,1),(0,1,2),"]
[92.908717, "o", "cat > /tmp/braille.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> exec(open('/tmp/decode.py').read().split(\"# composite onto white\")[0])\r\n\u001b[?2004l\r"]
[92.908743, "i", "(0,2,4),(1,0,8),(1,1,16),(1,2,32),(0,3,64),(1,3,128)]\n   for dx,dy,bit in coords:\n    if y0+dy<h and x0+dx<w and mask[y0+dy][x0+dx]: dots+=bit\n   out.append(chr(0x2800+dots) if dots else ' ')\n  print(''.join(out).rstrip())\nPY\npython3 /tmp/braille.py\n"]
[92.90891, "o", "\u001b[?2004h> "]
