[62.237894, "i", "cat > /tmp/decode.py <<'PY'\nimport struct,zlib\nb=open('/app/code.png','rb').read(); pos=8; dat=b''\nwhile pos<len(b):\n n=struct.unpack('>I',b[pos:pos+4])[0]; t=b[pos+4:pos+8]; c=b[pos+8:pos+8+n]; pos+=n+12\n if t==b'IHDR': w,h,d,ct,co,fi,inter=struct.unpack('>IIBBBBB',c)\n if t==b'IDAT': dat+=c\nraw=zlib.decompress(dat); bpp=4; stride=w*bpp; off=0; prev=bytearray(stride); pix=[]\nfor y in range(h):\n ft=raw[off]; off+=1; cur=bytearray(raw[off:off+stride]); off+=stride\n for i in range(stride):\n  a=cur[i-bpp] if i>=bpp else 0; bb=prev[i]; c=prev[i-bpp] if i>=bpp else 0\n  if ft==1: cur[i]=(cur[i]+a)&255\n  elif ft==2: cur[i]=(cur[i]+bb)&255\n  elif ft==3: cur[i]=(cur[i]+(a+bb)//2)&255\n  elif ft==4:\n   q=a+bb-c; pa=abs(q-a); pb=abs(q-bb); pc=abs(q-c); pr=a if pa<=pb and pa<=pc else (bb if pb<=pc else c); cur[i]=(cur[i]+pr)&255\n pix.append(cur); prev=cur\n# composite onto white, luminance\nvals=[]; amin=255; amax=0\nfor row in pix:\n for x in range(w):\n  r,g,bl,a=row[4*x:4*x+4]; amin=min(amin,a); amax=max(amax,a)\n  r=(r*a+255"]
[62.238344, "o", "cat > /tmp/decode.py <<'PY'\r\n\u001b[?2004l\r"]
[62.238355, "i", "*(255-a))//255; g=(g*a+255*(255-a))//255; bl=(bl*a+255*(255-a))//255\n  vals.append((299*r+587*g+114*bl)//1000)\nprint(w,h,'alpha',amin,amax,'gray',min(vals),max(vals))\ndef pgm(path, W,H,data):\n open(path,'wb').write(('P5\\n%d %d\\n255\\n'%(W,H)).encode()+bytes(data))\npgm('/tmp/code.pgm',w,h,vals)\n# nearest-neighbor 3x enlarged, threshold variants\nfor name,thr in [('bw',200),('bw240',240),('bw160',160)]:\n out=[]\n for y in range(h):\n  for yy in range(3):\n   for x in range(w):\n    v=0 if vals[y*w+x]<thr else 255\n    out.extend([v]*3)\n pgm('/tmp/'+name+'.pgm',w*3,h*3,out)\nPY\npython3 /tmp/decode.py\nfor f in /tmp/code.pgm /tmp/bw.pgm /tmp/bw240.pgm /tmp/bw160.pgm; do echo ===$f===; for p in 3 6 11 12; do tesseract \"$f\" stdout --psm $p 2>/dev/null; done; done\n"]
[62.239009, "o", "*(255-a))//255; g=(g*a+255*(255-a))//255; bl=(bl*a+255*(255-a))//255\r\n  vals.append((299*r+587*g+114*bl)//1000)\r\nprint(w,h,'alpha',amin,amax,'gray',min(vals),max(vals))\r\ndef pgm(path, W,H,data):\r\n open(path,'wb').write(('P5\\n%d %d\\n255\\n'%(W,H)).encode()+bytes(data))\r\npgm('/tmp/code.pgm',w,h,vals)\r\n# nearest-neighbor 3x enlarged, threshold variants\r\nfor name,thr in [('bw',200),('bw240',240),('bw160',160)]:\r\n out=[]\r\n for y in range(h):\r\n  for yy in range(3):\r\n   for x in range(w):\r\n    v=0 if vals[y*w+x]<thr else 255\r\n    out.extend([v]*3)\r\n pgm('/tmp/'+name+'.pgm',w*3,h*3,out)\r\nPY\r\npython3 /tmp/decode.py\r\nfor f in /tmp/code.pgm /tmp/bw.pgm /tmp/bw240.pgm /tmp/bw160.pgm; do echo ===$f===; for p in 3 6 11 12; do tesseract \"$f\" stdout --psm $p 2>/dev/null; done; done\r\n\u001b[?2004h> import struct,zlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
