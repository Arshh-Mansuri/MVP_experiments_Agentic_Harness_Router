[123.134587, "i", "cat > /tmp/ascii.py <<'PY'\n# load decoder and build mask\nexec(open('/tmp/braille.py').read().split(\"print('bands'\")[0])\n# bands are recomputed\nbands=[]; st=None; gap=0\nfor y,n in enumerate(proj+[0]):\n if n:\n  if st is None: st=y\n  gap=0\n elif st is not None:\n  gap+=1\n  if gap>=4: bands.append((st,y-gap+1)); st=None; gap=0\nimport sys\nbi=int(sys.argv[1]) if len(sys.argv)>1 else 0\na,b=bands[bi]; xs=[x for y in range(a,b) for x,v in enumerate(mask[y]) if v]; l=max(0,min(xs)-2); r=min(w,max(xs)+3)\n# 2x2 block representation for this line\nfor y in range(a,b,2):\n s=''\n for x in range(l,r,2):\n  n=sum(mask[yy][xx] for yy in range(y,min(y+2,h)) for xx in range(x,min(x+2,w)))\n  s += '█' if n>=2 else ('▄' if n else ' ')\n print(s.rstrip())\nPY\nfor i in 0 1 2 3 4 5 6 7; do echo \"=====LINE $i=====\"; python3 /tmp/ascii.py $i; done\n"]
[123.135008, "o", "cat > /tmp/ascii.py <<'PY'\r\n\u001b[?2004l\r"]
[123.136027, "o", "\u001b[?2004h> # load decoder and build mask\r\n\u001b[?2004l\r\u001b[?2004h> exec(open('/tmp/braille.py').read().split(\"print('bands'\")[0])\r\n\u001b[?2004l\r\u001b[?2004h> # bands are recomputed\r\n\u001b[?2004l\r\u001b[?2004h> bands=[]; st=None; gap=0\r\n\u001b[?2004l\r\u001b[?2004h> for y,n in enumerate(proj+[0]):\r\n\u001b[?2004l\r\u001b[?2004h>  if n:\r\n\u001b[?2004l\r\u001b[?2004h>   if st is None: st=y\r\n\u001b[?2004l\r\u001b[?2004h>   gap=0\r\n\u001b[?2004l\r\u001b[?2004h>  elif st is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.136041, "o", "  gap+=1\r\n\u001b[?2004l\r"]
[123.136331, "o", "\u001b[?2004h>   if gap>=4: bands.append((st,y-gap+1)); st=None; gap=0\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> bi=int(sys.argv[1]) if len(sys.argv)>1 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
