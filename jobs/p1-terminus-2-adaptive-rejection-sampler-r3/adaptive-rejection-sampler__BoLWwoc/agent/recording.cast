[234.521428, "o", "  if (any(!is.finite(z)) || any(diff(z) <= 0))\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"could not construct a valid tangent hull\")\r\n\u001b[?2004l\r\u001b[?2004h>   list(slope = slope, intercept = y - slope * x, z = z)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[234.5215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.521553, "o", "> "]
[234.52213, "o", ".exp_integral <- function(a, b, lo, hi) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (abs(a) < 1e-10) exp(b) * (hi - lo)\r\n\u001b[?2004l\r\u001b[?2004h>   else exp(b) * (exp(a * hi) - exp(a * lo)) / a\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.5225, "o", ".sample_envelope <- function(h, n) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(h$slope)\r\n\u001b[?2004l\r\u001b[?2004h>   mass <- vapply(seq_len(k), function(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.523567, "o", "    .exp_integral(h$slope[i], h$intercept[i], h$z[i], h$z[i + 1L]), numeric(1))\r\n\u001b[?2004l\r\u001b[?2004h>   if (any(!is.finite(mass)) || sum(mass) <= 0) stop(\"invalid envelope\")\r\n\u001b[?2004l\r\u001b[?2004h>   piece <- sample.int(k, n, replace = TRUE, prob = mass)\r\n\u001b[?2004l\r\u001b[?2004h>   u <- runif(n); result <- numeric(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.523605, "o", "  for (j in seq_len(n)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.524868, "o", "    i <- piece[j]; a <- h$slope[i]; lo <- h$z[i]; hi <- h$z[i + 1L]\r\n\u001b[?2004l\r\u001b[?2004h>     result[j] <- if (abs(a) < 1e-10) lo + u[j] * (hi - lo) else\r\n\u001b[?2004l\r\u001b[?2004h>       log(exp(a * lo) + u[j] * (exp(a * hi) - exp(a * lo))) / a\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.528784, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h>   result\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ars <- function(density_function, domain, n = sample_count) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.function(density_function)) stop(\"density_function must be a function\")\r\n\u001b[?2004l\r\u001b[?2004h>   domain <- .validate_domain(domain)\r\n\u001b[?2004l\r\u001b[?2004h>   if (missing(n) || length(n) != 1L || !is.numeric(n) || is.na(n) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.566913, "o", "      !is.finite(n) || n < 0 || n != as.integer(n))\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"n must be a non-negative integer\")\r\n\u001b[?2004l\r\u001b[?2004h>   n <- as.integer(n)\r\n\u001b[?2004l\r\u001b[?2004h>   if (n == 0L) return(numeric(0))\r\n\u001b[?2004l\r\u001b[?2004h>   .check_log_concavity(density_function, domain)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   x <- domain[1] + diff(domain) * c(.15, .35, .65, .85)\r\n\u001b[?2004l\r\u001b[?2004h>   y <- .log_density(density_function, x)\r\n\u001b[?2004l\r\u001b[?2004h>   slope <- .slopes_from_points(x, y)\r\n\u001b[?2004l\r\u001b[?2004h>   result <- numeric(0); attempts <- 0L\r\n\u001b[?2004l\r\u001b[?2004h>   max_attempts <- max(10000L, 200L * n)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   while (length(result) < n && attempts < max_attempts) {\r\n\u001b[?2004l\r\u001b[?2004h>     h <- .make_hull(x, y, slope, domain)\r\n\u001b[?2004l\r\u001b[?2004h>     batch <- min(256L, n - length(result))\r\n\u001b[?2004l\r\u001b[?2004h>     proposal <- .sample_envelope(h, batch)\r\n\u001b[?2004l\r\u001b[?2004h>     lp <- .log_density(density_function, proposal)\r\n\u001b[?2004l\r\u001b[?2004h>     index <- pmin(length(x), pmax(1L,\r\n\u001b[?2004l\r\u001b[?2004h>       findInterval(proposal, h$z, rightmost.closed = TRUE)))\r\n\u001b[?2004l\r\u001b[?2004h>     upper <- h$slope[index] * proposal + h$intercept[index]\r\n\u001b[?2004l\r\u001b[?2004h>     if (any(lp > upper + 1e-7))\r\n\u001b[?2004l\r\u001b[?2004h>       stop(\"non-log-concave density detected during sampling\")\r\n\u001b[?2004l\r\u001b[?2004h>     keep <- log(runif(batch)) <= lp - upper\r\n\u001b[?2004l\r\u001b[?2004h>     result <- c(result, proposal[keep]); attempts <- attempts + batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     rejected <- sort(unique(proposal[!keep]))\r\n\u001b[?2004l\r\u001b[?2004h>     rejected <- rejected[rejected > domain[1] & rejected < domain[2]]\r\n\u001b[?2004l\r\u001b[?2004h>     if (length(rejected)) {\r\n\u001b[?2004l\r\u001b[?2004h>       x <- sort(c(x, rejected))\r\n\u001b[?2004l\r\u001b[?2004h>       y <- .log_density(density_function, x)\r\n\u001b[?2004l\r\u001b[?2004h>       slope <- .slopes_from_points(x, y)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (length(result) < n) stop(\"sampling failed to converge\")\r\n\u001b[?2004l\r\u001b[?2004h>   result[seq_len(n)]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.567549, "o", "\u001b[?2004h> test <- function() {\r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(101)\r\n\u001b[?2004l\r\u001b[?2004h>   normal <- ars(function(x) dnorm(x), c(-8, 8), n = 4000)\r\n\u001b[?2004l\r"]
[234.569062, "o", "\u001b[?2004h>   write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE,\r\n\u001b[?2004l\r\u001b[?2004h>               col.names = FALSE)\r\n\u001b[?2004l\r\u001b[?2004h>   normal_ok <- abs(mean(normal)) < .08 && abs(sd(normal) - 1) < .08\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"NORMAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>       if (normal_ok) \"PASS\" else \"FAIL\", mean(normal), sd(normal)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(102)\r\n\u001b[?2004l\r\u001b[?2004h>   exponential <- ars(function(x) dexp(x), c(0, 12), n = 3000)\r\n\u001b[?2004l\r\u001b[?2004h>   exponential_ok <- abs(mean(exponential) - 1) < .08 &&\r\n\u001b[?2004l\r"]
[234.569701, "o", "\u001b[?2004h>     abs(sd(exponential) - 1) < .08\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"EXPONENTIAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>       if (exponential_ok) \"PASS\" else \"FAIL\", mean(exponential), sd(exponential)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   input_ok <- tryCatch({ ars(dnorm, c(1, 1), 2); FALSE },\r\n\u001b[?2004l\r\u001b[?2004h>                        error = function(e) TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"INPUT_VALIDATION: %s\\n\", if (input_ok) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   bimodal <- function(x) 0.5 * dnorm(x, -1, .15) + 0.5 * dnorm(x, 1, .15)\r\n\u001b[?2004l\r\u001b[?2004h>   concavity_ok <- tryCatch({ ars(bimodal, c(-3, 3), 20); FALSE },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.569745, "o", "                           error = function(e) TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"NON_LOG_CONCAVE_CHECK: %s\\n\",\r\n\u001b[?2004l\r"]
[234.571531, "o", "\u001b[?2004h>       if (concavity_ok) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h>   invisible(all(normal_ok, exponential_ok, input_ok, concavity_ok))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if (sys.nframe() == 0L) test()"]
