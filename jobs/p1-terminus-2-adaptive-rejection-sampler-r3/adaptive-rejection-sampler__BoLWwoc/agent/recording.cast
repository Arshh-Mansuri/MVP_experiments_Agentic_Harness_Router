[203.012551, "o", "root@4ecf3cb78874:/app# "]
[234.503795, "i", "cat > /app/ars.R <<'RS'\n# Adaptive rejection sampling for finite-domain log-concave densities.\n\n.validate_domain <- function(domain) {\n  if (!is.numeric(domain) || length(domain) != 2L || anyNA(domain) ||\n      any(!is.finite(domain)) || domain[1] >= domain[2])\n    stop(\"domain must contain two finite increasing numbers\")\n  as.numeric(domain)\n}\n\n.log_density <- function(f, x) {\n  value <- tryCatch(f(x), error = function(e)\n    stop(\"density_function failed: \", conditionMessage(e)))\n  if (!is.numeric(value) || length(value) != length(x) || anyNA(value) ||\n      any(is.nan(value)) || any(value < 0) || any(!is.finite(value)))\n    stop(\"density_function must return finite nonnegative numeric values\")\n  ifelse(value > 0, log(value), -Inf)\n}\n\n.check_log_concavity <- function(f, domain, grid = 81L, tolerance = 1e-7) {\n  x <- seq(domain[1], domain[2], length.out = grid)\n  y <- .log_density(f, x)\n  if (any(!is.finite(y))) stop(\"density must be positive throughout domain\")\n  second <- diff(y, differences = 2)\n  if (any(second > tolerance * (1 + max(abs(y)))))\n    stop(\"density appears to be non-log-concave\")\n  invisible(TRUE)\n}\n\n.slopes_from_points <- function(x, y) {\n  secant <- diff(y) / diff(x)\n  slope <- c(secant[1L],\n    if (length(secant) > 1L)\n      (secant[-length(secant)] + secant[-1L]) / 2 else numeric(0),\n    secant[length(secant)])\n  if (any(diff(slope) > 1e-7))\n    stop(\"non-log-concavity detected while updating hull\")\n  slope\n}\n\n.make_hull <- function(x, y, slope, domain) {\n  z <- c(domain[1], rep(NA_real_, length(x) - 1L), domain[2])\n  if (length(x) > 1L) for (i in seq_len(length(x) - 1L)) {\n    den <- slope[i] - slope[i + 1L]\n    z[i + 1L] <- if (abs(den) < 1e-12) (x[i] + x[i + 1L]) / 2 else\n      (y[i + 1L] - slope[i + 1L] * x[i + 1L] - y[i] + slope[i] * x[i]) / den\n  }\n  if (any(!is.finite(z)) || any(diff(z) <= 0))\n    stop(\"could not construct a valid tangent hull\")\n  list(slope = slope, intercept = y - slope * x, z = z)\n}\n\n.exp_integral <- function(a, b, lo, hi) {\n  if (abs(a) < 1e-10) exp(b) * (hi - lo)\n  else exp(b) * (exp(a * hi) - exp(a * lo)) / a\n}\n\n.sample_envelope <- function(h, n) {\n  k <- length(h$slope)\n  mass <- vapply(seq_len(k), function(i)\n    .exp_integral(h$slope[i], h$intercept[i], h$z[i], h$z[i + 1L]), numeric(1))\n  if (any(!is.finite(mass)) || sum(mass) <= 0) stop(\"invalid envelope\")\n  piece <- sample.int(k, n, replace = TRUE, prob = mass)\n  u <- runif(n); result <- numeric(n)\n  for (j in seq_len(n)) {\n    i <- piece[j]; a <- h$slope[i]; lo <- h$z[i]; hi <- h$z[i + 1L]\n    result[j] <- if (abs(a) < 1e-10) lo + u[j] * (hi - lo) else\n      log(exp(a * lo) + u[j] * (exp(a * hi) - exp(a * lo))) / a\n  }\n  result\n}\n\nars <- function(density_function, domain, n = sample_count) {\n  if (!is.function(density_function)) stop(\"density_function must be a function\")\n  domain <- .validate_domain(domain)\n  if (missing(n) || length(n) != 1L || !is.numeric(n) || is.na(n) ||\n      !is.finite(n) || n < 0 || n != as.integer(n))\n    stop(\"n must be a non-negative integer\")\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0))\n  .check_log_concavity(density_function, domain)\n\n  x <- domain[1] + diff(domain) * c(.15, .35, .65, .85)\n  y <- .log_density(density_function, x)\n  slope <- .slopes_from_points(x, y)\n  result <- numeric(0); attempts <- 0L\n  max_attempts <- max(10000L, 200L * n)\n\n  while (length(result) < n && attempts < max_attempts) {\n    h <- .make_hull(x, y, slope, domain)\n    batch <- min(256L, n - length(result))\n    proposal <- .sample_envelope(h, batch)\n    lp <- .log_density(density_function, proposal)\n    index <- pmin(length(x), pmax(1L,\n      findInterval(proposal, h$z, rightmost.closed = TRUE)))\n    upper <- h$slope[index] * proposal + h$intercept[index]\n    if (any(lp > upper + 1e-7))\n      stop(\"non-log-concave density detected during sampling\")\n    keep <- log(runif(batch)) <= lp - upper\n    result <- c(result, proposal[keep]); attempts <- attempts + batch\n\n    rejected <- sort(unique(proposal[!keep]))\n    rejected <- rejected[rejected > domain[1] & rejected < domain[2]]\n    if (length(reject"]
[234.505197, "i", "ed)) {\n      x <- sort(c(x, rejected))\n      y <- .log_density(density_function, x)\n      slope <- .slopes_from_points(x, y)\n    }\n  }\n  if (length(result) < n) stop(\"sampling failed to converge\")\n  result[seq_len(n)]\n}\n\ntest <- function() {\n  set.seed(101)\n  normal <- ars(function(x) dnorm(x), c(-8, 8), n = 4000)\n  write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE,\n              col.names = FALSE)\n  normal_ok <- abs(mean(normal)) < .08 && abs(sd(normal) - 1) < .08\n  cat(sprintf(\"NORMAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",\n      if (normal_ok) \"PASS\" else \"FAIL\", mean(normal), sd(normal)))\n\n  set.seed(102)\n  exponential <- ars(function(x) dexp(x), c(0, 12), n = 3000)\n  exponential_ok <- abs(mean(exponential) - 1) < .08 &&\n    abs(sd(exponential) - 1) < .08\n  cat(sprintf(\"EXPONENTIAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",\n      if (exponential_ok) \"PASS\" else \"FAIL\", mean(exponential), sd(exponential)))\n\n  input_ok <- tryCatch({ ars(dnorm, c(1, 1), 2); FALSE },\n                       error = function(e) TRUE)\n  cat(sprintf(\"INPUT_VALIDATION: %s\\n\", if (input_ok) \"PASS\" else \"FAIL\"))\n\n  bimodal <- function(x) 0.5 * dnorm(x, -1, .15) + 0.5 * dnorm(x, 1, .15)\n  concavity_ok <- tryCatch({ ars(bimodal, c(-3, 3), 20); FALSE },\n                           error = function(e) TRUE)\n  cat(sprintf(\"NON_LOG_CONCAVE_CHECK: %s\\n\",\n      if (concavity_ok) \"PASS\" else \"FAIL\"))\n  invisible(all(normal_ok, exponential_ok, input_ok, concavity_ok))\n}\n\nif (sys.nframe() == 0L) test()\nRS\nRscript /app/ars.R\nprintf 'normal_samples.txt lines: '; wc -l < /app/normal_samples.txt\n"]
[234.508721, "o", "cat > /app/ars.R <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> # Adaptive rejection sampling for finite-domain log-concave densities.\r\n\u001b[?2004l\r"]
