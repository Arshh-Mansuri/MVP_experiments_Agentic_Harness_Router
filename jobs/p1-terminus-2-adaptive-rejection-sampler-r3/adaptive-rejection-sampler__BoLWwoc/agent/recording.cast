[114.380305, "i", "cat > /app/ars.R <<'RS'\n.validate_domain <- function(d) {\n  if (!is.numeric(d) || length(d)!=2 || any(!is.finite(d)) || d[1]>=d[2])\n    stop(\"domain must be two finite increasing numbers\")\n  d\n}\n.logd <- function(f,x) {\n  v <- tryCatch(f(x),error=function(e) stop(conditionMessage(e)))\n  if (!is.numeric(v) || length(v)!=length(x) || anyNA(v) || any(v<0) || any(!is.finite(v)))\n    stop(\"density must return finite nonnegative numeric values\")\n  ifelse(v>0,log(v),-Inf)\n}\n.check_concavity <- function(f,d) {\n  x <- seq(d[1],d[2],length.out=81); y <- .logd(f,x)\n  if (any(!is.finite(y))) stop(\"density must be positive on domain\")\n  z <- diff(y, differences=2)\n  if (any(z > 1e-7*(1+max(abs(y))))) stop(\"density is not log-concave\")\n  invisible(TRUE)\n}\n.slopes <- function(x,y) {\n  q <- diff(y)/diff(x)\n  s <- c(q[1],if(length(q)>1)(q[-length(q)]+q[-1])/2,n=q[length(q)])\n  if (any(diff(s)>1e-7)) stop(\"non-log-concavity detected in hull\")\n  s\n}\nhull <- function(x,y,s,d) {\n  z <- c(d[1],rep(NA,length(x)-1),d[2])\n  if(length(x)>1) for(i in seq_len(length(x)-1)) {\n    den <- s[i]-s[i+1]\n    z[i+1] <- if(abs(den)<1e-12)(x[i]+x[i+1])/2 else\n      (y[i+1]-s[i+1]*x[i+1]-y[i]+s[i]*x[i])/den\n  }\n  if(any(!is.finite(z)) || any(diff(z)<=0)) stop(\"invalid tangent hull\")\n  list(s=s,b=y-s*x,z=z)\n}\n.mass <- function(a,b,l,r) {\n  if(abs(a)<1e-10) exp(b)*(r-l) else exp(b)*(exp(a*r)-exp(a*l))/a\n}\n.from_hull <- function(h,n) {\n  k <- length(h$s); m <- vapply(seq_len(k),function(i).mass(h$s[i],h$b[i],h$z[i],h$z[i+1]),numeric(1))\n  if(any(!is.finite(m)) || sum(m)<=0) stop(\"invalid envelope\")\n  ii <- sample.int(k,n,replace=TRUE,prob=m); u <- runif(n); out <- numeric(n)\n  for(j in seq_len(n)) { i<-ii[j]; a<-h$s[i]; l<-h$z[i]; r<-h$z[i+1]\n    out[j] <- if(abs(a)<1e-10) l+u[j]*(r-l) else log(exp(a*l)+u[j]*(exp(a*r)-exp(a*l)))/a\n  }; out\n}\nars <- function(density_function, domain, n=sample_count) {\n  if(!is.function(density_function)) stop(\"density_function must be a function\")\n  d <- .validate_domain(domain)\n  if(missing(n) || length(n)!=1 || !is.numeric(n) || !is.finite(n) || n<0 || n!=as.integer(n))\n    stop(\"n must be a nonnegative integer\")\n  n <- as.integer(n); if(n==0) return(numeric())\n  .check_concavity(density_function,d)\n  x <- d[1]+diff(d)*c(.15,.35,.65,.85); y <- .logd(density_function,x)\n  s <- .slopes(x,y); ans <- numeric(); tries <- 0L\n  while(length(ans)<n && tries<200L*n+10000L) {\n    h <- hull(x,y,s,d); b <- min(256L,n-length(ans)); p <- .from_hull(h,b)\n    lp <- .logd(density_function,p); ii <- pmin(length(x),pmax(1L,findInterval(p,h$z,rightmost.closed=TRUE)))\n    up <- h$s[ii]*p+h$b[ii]\n    if(any(lp>up+1e-7)) stop(\"non-log-concave density detected during sampling\")\n    keep <- log(runif(b)) <= lp-up; ans <- c(ans,p[keep]); tries <- tries+b\n    add <- sort(unique(p[!keep])); add <- add[add>d[1]&add<d[2]]\n    if(length(add)) { x<-sort(c(x,add)); y<-.logd(density_function,x); s<-.slopes(x,y) }\n  }\n  if(length(ans)<n) stop(\"sampling failed to converge\")\n  ans[seq_len(n)]\n}\ntest <- function() {\n  set.seed(11); z<-ars(dnorm,c(-8,8),4000); write.table(z,\"/app/normal_samples.txt\",row.names=FALSE,col.names=FALSE)\n  ok<-abs(mean(z))<.08 && abs(sd(z)-1)<.08\n  cat(sprintf(\"NORMAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",if(ok)\"PASS\" else \"FAIL\",mean(z),sd(z)))\n  set.seed(12); e<-ars(dexp,c(0,12),3000); ok2<-abs(mean(e)-1)<.08 && abs(sd(e)-1)<.08\n  cat(sprintf(\"EXPONENTIAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",if(ok2)\"PASS\" else \"FAIL\",mean(e),sd(e)))\n  ok3<-tryCatch({ars(dnorm,c(1,1),2);FALSE},error=function(e)TRUE); cat(sprintf(\"INPUT_VALIDATION: %s\\n\",if(ok3)\"PASS\" else \"FAIL\"))\n  bimodal<-function(x).5*dnorm(x,-1,.15)+.5*dnorm(x,1,.15)\n  ok4<-tryCatch({ars(bimodal,c(-3,3),20);FALSE},error=function(e)TRUE); cat(sprintf(\"NON_LOG_CONCAVE_CHECK: %s\\n\",if(ok4)\"PASS\" else \"FAIL\"))\n  invisible(all(ok,ok2,ok3,ok4))\n}\nif(sys.nframe()==0) test()\nRS\nRscript /app/ars.R\nprintf 'normal_samples.txt lines: '; wc -l < /app/normal_samples.txt\n"]
[114.380773, "o", "cat > /app/ars.R <<'RS'\r\n.validate_domain <- function(d) {\r\n  if (!is.numeric(d) || length(d)!=2 || any(!is.finite(d)) || d[1]>=d[2])\r\n    stop(\"domain must be two finite increasing numbers\")\r\n  d\r\n}\r\n.logd <- function(f,x) {\r\n  v <- tryCatch(f(x),error=function(e) stop(conditionMessage(e)))\r\n  if (!is.numeric(v) || length(v)!=length(x) || anyNA(v) || any(v<0) || any(!is.finite(v)))\r\n    stop(\"density must return finite nonnegative numeric values\")\r\n  ifelse(v>0,log(v),-Inf)\r\n}\r\n.check_concavity <- function(f,d) {\r\n  x <- seq(d[1],d[2],length.out=81); y <- .logd(f,x)\r\n  if (any(!is.finite(y))) stop(\"density must be positive on domain\")\r\n  z <- diff(y, differences=2)\r\n  if (any(z > 1e-7*(1+max(abs(y))))) stop(\"density is not log-concave\")\r\n  invisible(TRUE)\r\n}\r\n.slopes <- function(x,y) {\r\n  q <- diff(y)/diff(x)\r\n  s <- c(q[1],if(length(q)>1)(q[-length(q)]+q[-1])/2,n=q[length(q)])\r\n  if (any(diff(s)>1e-7)) stop(\"non-log-concavity detected in hull\")\r\n  s\r\n}\r\nhull <- function(x,y,s,d) {\r\n  z <- c(d[1],rep(NA,length(x)-1),d[2])\r\n  if(length(x)>1) for(i in seq_len(length(x)-1)) {\r\n    den <- s[i]-s[i+1]\r\n    z[i+1] <- if(abs(den)<1e-12)(x[i]+x[i+1])/2 else\r\n      (y[i+1]-s[i+1]*x[i+1]-y[i]+s[i]*x[i])/den\r\n  }\r\n  if(any(!is.finite(z)) || any(diff(z)<=0)) stop(\"invalid tangent hull\")\r\n  list(s=s,b=y-s*x,z=z)\r\n}\r\n.mass <- function(a,b,l,r) {\r\n  if(abs(a)<1e-10) exp(b)*(r-l) else exp(b)*(exp(a*r)-exp(a*l))/a\r\n}\r\n.from_hull <- function(h,n) {\r\n  k <- length(h$s); m <- vapply(seq_len(k),function(i).mass(h$s[i],h$b[i],h$z[i],h$z[i+1]),numeric(1))\r\n  if(any(!is.finite(m)) || sum(m)<=0) stop(\"invalid envelope\")\r\n  ii <- sample.int(k,n,replace=TRUE,prob=m); u <- runif(n); out <- numeric(n)\r\n  for(j in seq_len(n)) { i<-ii[j]; a<-h$s[i]; l<-h$z[i]; r<-h$z[i+1]\r\n    out[j] <- if(abs(a)<1e-10) l+u[j]*(r-l) else log(exp(a*l)+u[j]*(exp(a*r)-exp(a*l)))/a\r\n  }; out\r\n}\r\nars <- function(density_function, domain, n=sample_count) {\r\n  if(!is.function(density_function)) stop(\"density_function must be a function\")\r\n  d <- .validate_domain(domain)\r\n  if(missing(n) || length(n)!=1 || !is.numeric(n) || !is.finite(n) || n<0 || n!=as.integer(n))\r\n    stop(\"n must be a nonnegative integer\")\r\n  n <- as.integer(n); if(n==0) return(numeric())\r\n  .check_concavity(density_function,d)\r\n  x <- d[1]+diff(d)*c(.15,.35,.65,.85); y <- .logd(density_function,x)\r\n  s <- .slopes(x,y); ans <- numeric(); tries <- 0L\r\n  while(length(ans)<n && tries<200L*n+10000L) {\r\n    h <- hull(x,y,s,d); b <- min(256L,n-length(ans)); p <- .from_hull(h,b)\r\n    lp <- .logd(density_function,p); ii <- pmin(length(x),pmax(1L,findInterval(p,h$"]
[114.380806, "o", "z,rightmost.closed=TRUE)))\r\n    up <- h$s[ii]*p+h$b[ii]\r\n    if(any(lp>up+1e-7)) stop(\"non-log-concave density detected during sampling\")\r\n    keep <- log(runif(b)) <= lp-up; ans <- c(ans,p[keep]); tries <- tries+b\r\n    add <- sort(unique(p[!keep])); a"]
[114.380981, "o", "dd <- add[add>d[1]&add<d[2]]\r\n    if(length(add)) { x<-sort(c(x,add)); y<-.logd(density_function,x); s<-.slopes(x,y) }\r\n  }\r\n  if(length(ans)<n) stop(\"sampling failed to converge\")\r\n  ans[seq_len(n)]\r\n}\r\ntest <- function() {\r\n  set.seed(11); z<-ars(dnorm,c(-8,8),4000); write.table(z,\"/app/normal_samples.txt\",row.names=FALSE,col.names=FALSE)\r\n  ok<-abs(mean(z))<.08 && abs(sd(z)-1)<.08\r\n  cat(sprintf(\"NORMAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",if(ok)\"PASS\" else \"FAIL\",mean(z),sd(z)))\r\n  set.seed(12); e<-ars(dexp,c(0,12),3000); ok2<-abs(mean(e)-1)<.08 && abs(sd(e)-1)<.08\r\n  cat(sprintf(\"EXPONENTIAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n\",if(ok2)\"PASS\" else \"FAIL\",mean(e),sd(e)))\r\n  ok3<-tryCatch({ars(dnorm,c(1,1),2);FALSE},error=function(e)TRUE); cat(sprintf(\"INPUT_VALIDATION: %s\\n\",if(ok3)\"PASS\" else \"FAIL\"))\r\n  bimodal<-function(x).5*dnorm(x,-1,.15)+.5*dnorm(x,1,.15)\r\n  ok4<-tryCatch({ars(bimodal,c(-3,3),20);FALSE},error=function(e)TRUE); cat(sprintf(\"NON_LOG_CONCAVE_CHECK: %s\\n\",if(ok4)\"PASS\" else \"FAIL\"))\r\n  invisible(all(ok,ok2,ok3,ok4))\r\n}\r\nif(sys.nframe()==0) test()\r\nRS\r\nRscript /app/ars.R\r\nprintf 'normal_samples.txt lines: '; wc -l < /app/normal_samples.txt\r\n"]
