Sending keys: ['cat > /app/ars.R <<\'RSCRIPT\'\n# Adaptive rejection sampler for bounded log-concave densities.\n# Based on Gilks and Wild (1992).\n\n.validate_domain <- function(domain) {\n  if (!is.numeric(domain) || length(domain) != 2L || anyNA(domain) ||\n      any(!is.finite(domain)) || domain[1] >= domain[2])\n    stop("domain must contain two finite increasing numbers")\n  as.numeric(domain)\n}\n\n.log_density <- function(f, x) {\n  value <- tryCatch(f(x), error = function(e)\n    stop("density_function failed: ", conditionMessage(e)))\n  if (!is.numeric(value) || length(value) != length(x))\n    stop("density_function must return a numeric vector of matching length")\n  if (anyNA(value) || any(is.nan(value)) || any(value < 0))\n    stop("density_function returned NA, NaN, or negative values")\n  if (any(!is.finite(value)))\n    stop("density_function must return finite values")\n  ifelse(value > 0, log(value), -Inf)\n}\n\n.check_log_concavity <- function(f, domain, grid = 61L, tolerance = 1e-7) {\n  x <- seq(domain[1], domain[2], length.out = grid)\n  y <- .log_density(f, x)\n  if (any(!is.finite(y)))\n    stop("density must be positive throughout the supplied domain")\n  second_difference <- y[-c(1L, 2L)] - 2 * y[-c(1L, length(y))] +\n    y[-c(length(y) - 1L, length(y))]\n  if (any(second_difference > tolerance * (1 + max(abs(y)))))\n    stop("density appears to be non-log-concave")\n  invisible(TRUE)\n}\n\n.make_hull <- function(x, y, slope, domain) {\n  m <- length(x)\n  z <- c(domain[1], rep(NA_real_, m - 1L), domain[2])\n  if (m > 1L) {\n    for (i in seq_len(m - 1L)) {\n      den <- slope[i] - slope[i + 1L]\n      z[i + 1L] <- if (abs(den) < 1e-12) {\n        (x[i] + x[i + 1L]) / 2\n      } else {\n        (y[i + 1L] - slope[i + 1L] * x[i + 1L] -\n           y[i] + slope[i] * x[i]) / den\n      }\n    }\n  }\n  if (any(!is.finite(z)) || any(diff(z) <= 0))\n    stop("could not construct a valid tangent envelope")\n  list(x = x, y = y, slope = slope, intercept = y - slope * x, z = z)\n}\n\n.exp_integral <- function(a, b, lo, hi) {\n  if (abs(a) < 1e-10) exp(b) * (hi - lo)\n  else exp(b) * (exp(a * hi) - exp(a * lo)) / a\n}\n\n.sample_envelope <- function(h, n) {\n  k <- length(h$x)\n  mass <- vapply(seq_len(k), function(i)\n    .exp_integral(h$slope[i], h$intercept[i], h$z[i], h$z[i + 1L]),\n    numeric(1))\n  if (any(!is.finite(mass)) || sum(mass) <= 0)\n    stop("invalid envelope mass")\n  probabilities <- mass / sum(mass)\n  pieces <- sample.int(k, n, replace = TRUE, prob = probabilities)\n  u <- runif(n)\n  result <- numeric(n)\n  for (j in seq_len(n)) {\n    i <- pieces[j]\n    lo <- h$z[i]\n    hi <- h$z[i + 1L]\n    a <- h$slope[i]\n    if (abs(a) < 1e-10) result[j] <- lo + u[j] * (hi - lo)\n    else {\n      left <- exp(a * lo)\n      right <- exp(a * hi)\n      result[j] <- log(left + u[j] * (right - left)) / a\n    }\n  }\n  result\n}\n\n.slopes_from_points <- function(x, y) {\n  secant <- diff(y) / diff(x)\n  # Secant slopes are decreasing for a concave log-density.\n  slope <- c(secant[1L],\n             if (length(secant) > 1L)\n               (secant[-length(secant)] + secant[-1L]) / 2 else numeric(0),\n             secant[length(secant)])\n  if (any(diff(slope) > 1e-8))\n    stop("non-log-concavity detected while updating the envelope")\n  slope\n}\n\n# Generate n samples from a bounded, log-concave target density.\nars <- function(density_function, domain, n = sample_count) {\n  if (!is.function(density_function))\n    stop("density_function must be a function")\n  domain <- .validate_domain(domain)\n  if (missing(n)) stop("n must be supplied")\n  if (length(n) != 1L || !is.numeric(n) || is.na(n) ||\n      !is.finite(n) || n < 0 || n != as.integer(n))\n    stop("n must be a non-negative integer")\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0))\n\n  .check_log_concavity(density_function, domain)\n  initial <- domain[1] + diff(domain) * c(.15, .35, .65, .85)\n  x <- initial\n  y <- .log_density(density_function, x)\n  slope <- .slopes_from_points(x, y)\n  accepted <- numeric(0)\n  attempts <- 0L\n  limit <- max(10000L, 200L * n)\n\n  while (length(accepted) < n && attempts < limit) {\n    hull <- .make_hull(x, y, slope, domain)\n    batch <- min(256L, n - length(accepted))\n    proposal <- .sample_envelope(hull, batch)\n    lp <- .log_density(density_function, proposal)\n    piece <- pmin(length(x), pmax(1L,\n      findInterval(proposal, hull$z, rightmost.closed = TRUE)))\n    upper <- hull$slope[piece] * proposal + hull$intercept[piece]\n    if (any(lp > upper + 1e-7))\n      stop("non-log-concave density detected during sampling")\n    keep <- log(runif(batch)) <= lp - upper\n    accepted <- c(accepted, proposal[keep])\n    attempts <- attempts + batch\n\n    # Add rejected points to adapt the envelope.\n    add <- sort(unique(proposal[!keep]))\n    add <- add[add > domain[1] & add < domain[2]]\n    if (length(add)) {\n      x <- sort(c(x, add))\n      y <- .log_density(density_function, x)\n      slope <- .slopes_from_points(x, y)\n    }\n  }\n  if (length(accepted) < n)\n    stop("sampling did not converge; check log-concavity and domain")\n  accepted[seq_len(n)]\n}\n\n# Formal tests against known moments and invalid-input behavior.\ntest <- function() {\n  set.seed(12345)\n  normal <- ars(function(x) dnorm(x), c(-8, 8), n = 4000)\n  write.table(normal, "/app/normal_samples.txt", row.names = FALSE,\n              col.names = FALSE)\n  normal_ok <- abs(mean(normal)) < 0.08 && abs(sd(normal) - 1) < 0.08\n  cat(sprintf("NORMAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n",\n      if (normal_ok) "PASS" else "FAIL", mean(normal), sd(normal)))\n\n  set.seed(12346)\n  exponential <- ars(function(x) dexp(x), c(0, 12), n = 3000)\n  exponential_ok <- abs(mean(exponential) - 1) < 0.08 &&\n    abs(sd(exponential) - 1) < 0.08\n  cat(sprintf("EXPONENTIAL_MOMENTS: %s (mean=%.4f, sd=%.4f)\\n",\n      if (exponential_ok) "PASS" else "FAIL", mean(exponential), sd(exponential)))\n\n  invalid_ok <- tryCatch({\n    ars(function(x) dnorm(x), c(1, 1), n = 2)\n    FALSE\n  }, error = function(e) TRUE)\n  cat(sprintf("INPUT_VALIDATION: %s\\n", if (invalid_ok) "PASS" else "FAIL"))\n\n  nonconcave_ok <- tryCatch({\n    ars(function(x) 0.5 * dnorm(x, -1, .15) +\n          0.5 * dnorm(x, 1, .15), c(-3, 3), n = 20)\n    FALSE\n  }, error = function(e) TRUE)\n  cat(sprintf("NON_LOG_CONCAVE_CHECK: %s\\n",\n      if (nonconcave_ok) "PASS" else "FAIL"))\n\n  invisible(all(normal_ok, exponential_ok, invalid_ok, nonconcave_ok))\n}\n\nif (sys.nframe() == 0L) test()\nRSCRIPT\nRscript /app/ars.R\nwc -l /app/normal_samples.txt\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
