[12.629328, "o", "table|adjpositions|adjpositions|CREATE TABLE `adjpositions` (\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL,\r\n`position` VARCHAR(24) NOT NULL\r\n)\r\ntable|casedwords|casedwords|CREATE TABLE `casedwords` (\r\n`casedwordid` INT NOT NULL,\r\n`wordid` INT NOT NULL ,\r\n`casedword` VARCHAR(80) NOT NULL\r\n)\r\ntable|domains|domains|CREATE TABLE `domains` (\r\n`domainid` INT NOT NULL,\r\n`domain` VARCHAR(32) NOT NULL,\r\n`domainname` VARCHAR(32) NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL\r\n)\r\ntable|ilis|ilis|CREATE TABLE `ilis` (\r\n`ili` VARCHAR(7) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\ntable|lexes|lexes|CREATE TABLE `lexes` (\r\n`luid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL\r\n)\r\ntable|lexes_morphs|lexes_morphs|CREATE TABLE `lexes_morphs` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`morphid` INT NOT NULL\r\n)\r\ntable|lexes_pronunciations|lexes_pronunciations|CREATE TABLE `lexes_pronunciations` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pronunciationid` INT NOT NULL,\r\n`variety` VARCHAR(2) DEFAULT NULL\r\n)\r\ntable|lexrelations|lexrelations|CREATE TABLE `lexrelations` (\r\n`synset1id` INT NOT NULL,\r\n`lu1id` INT NOT NULL,\r\n`word1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`lu2id` INT NOT NULL,\r\n`word2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\ntable|morphs|morphs|CREATE TABLE `morphs` (\r\n`morphid` INT NOT NULL,\r\n`morph` VARCHAR(70) NOT NULL\r\n)\r\ntable|poses|poses|CREATE TABLE `poses` (\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pos` VARCHAR(20) NOT NULL\r\n)\r\ntable|pronunciations|pronunciations|CREATE TABLE `pronunciations` (\r\n`pronunciationid` INT NOT NULL,\r\n`pronunciation` VARCHAR(50) NOT NULL\r\n)\r\ntable|relations|relations|CREATE TABLE `relations` (\r\n`relationid` INT NOT NULL,\r\n`relation` VARCHAR(50) NOT NULL,\r\n`recurses` TINYINT(1) NOT NULL\r\n)\r\ntable|samples|samples|CREATE TABLE `samples` (\r\n`sampleid` INT NOT NULL,\r\n`sample` MEDIUMTEXT NOT NULL,\r\n`source` MEDIUMTEXT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\ntable|semrelations|semrelations|CREATE TABLE `semrelations` (\r\n`synset1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\ntable|senses|senses|CREATE TABLE `senses` (\r\n`senseid` INT NOT NULL,\r\n`sensekey` VARCHAR(100) DEFAULT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL,\r\n`lexid` INT NOT NULL,\r\n`sensenum` INT DEFAULT NULL,\r\n`tagcount` INT DEFAULT NULL\r\n)\r\ntable|senses_adjpositions|senses_adjpositions|CREATE TABLE `senses_adjpositions` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL\r\n)\r\ntable|senses_vframes|senses_vframes|CREATE TABLE `senses_vframes` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`frameid` INT NOT NULL\r\n)\r\n"]
[12.629572, "o", "table|senses_vtemplates|senses_vtemplates|CREATE TABLE `senses_vtemplates` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`templateid` INT NOT NULL\r\n)\r\ntable|synsets|synsets|CREATE TABLE `synsets` (\r\n`synsetid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`domainid` INT NOT NULL,\r\n`definition` MEDIUMTEXT NOT NULL\r\n)\r\ntable|usages|usages|CREATE TABLE `usages` (\r\n`usageid` INT NOT NULL,\r\n`usagenote` MEDIUMTEXT NOT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\ntable|vframes|vframes|CREATE TABLE `vframes` (\r\n`frameid` INT NOT NULL,\r\n`frame` VARCHAR(50) NOT NULL\r\n)\r\ntable|vtemplates|vtemplates|CREATE TABLE `vtemplates` (\r\n`templateid` INT NOT NULL,\r\n`template` MEDIUMTEXT NOT NULL\r\n)\r\ntable|wikidatas|wikidatas|CREATE TABLE `wikidatas` (\r\n`wikidata` VARCHAR(12) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\ntable|words|words|CREATE TABLE `words` (\r\n`wordid` INT NOT NULL,\r\n`word` VARCHAR(80) NOT NULL\r\n)\r\n"]
