[56.231555, "i", "printf '%s\\n' '--- optimized plan ---'; sqlite3 /app/oewn.sqlite \"EXPLAIN QUERY PLAN $(tr '\\n' ' ' < /app/sol.sql)\"\n"]
[56.23252, "o", "printf '%s\\n' '--- optimized plan ---'; sqlite3 /app/oewn.sqlite \"EXPLAIN QUERY PLAN $(tr '\\n' ' ' < /app/sol.sql)\"\r\n\u001b[?2004l\r"]
[56.233414, "o", "--- optimized plan ---\r\n"]
[56.334569, "o", "QUERY PLAN\r\n"]
[56.335236, "o", "|--CO-ROUTINE word_stats\r\n|  |--SCAN s\r\n|  |--BLOOM FILTER ON syn (synsetid=?)\r\n|  |--SEARCH syn USING AUTOMATIC COVERING INDEX (synsetid=?)\r\n|  |--USE TEMP B-TREE FOR GROUP BY\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  `--USE TEMP B-TREE FOR count(DISTINCT)\r\n|--MATERIALIZE ranked\r\n|  |--CO-ROUTINE (subquery-5)\r\n|  |  |--CO-ROUTINE synset_counts\r\n|  |  |  |--SCAN senses\r\n|  |  |  `--USE TEMP B-TREE FOR GROUP BY\r\n|  |  |--SCAN synset_counts\r\n|  |  `--USE TEMP B-TREE FOR ORDER BY\r\n|  `--SCAN (subquery-5)\r\n|--SCAN r\r\n|--BLOOM FILTER ON ws (wordid=?)\r\n|--SEARCH ws USING AUTOMATIC COVERING INDEX (wordid=?)\r\n|--BLOOM FILTER ON w (wordid=?)\r\n|--SEARCH w USING AUTOMATIC COVERING INDEX (wordid=?)\r\n`--USE TEMP B-TREE FOR ORDER BY\r\n"]
[56.338046, "o", "\u001b[?2004hroot@263ea7a4ea0c:/app# "]
[58.251049, "i", "timeout 60 sqlite3 /app/oewn.sqlite < /app/my-sql-query.sql > /tmp/original.out; status=$?; echo original_status=$status; if [ \"$status\" = 0 ]; then diff -u /tmp/original.out /tmp/solution.out; echo diff_status=$?; fi\n"]
[58.256868, "o", "timeout 60 sqlite3 /app/oewn.sqlite < /app/my-sql-query.sql > /tmp/original.out; status=$?; echo original_status=$status; if [ \"$status\" = 0 ]; then diff -u /tmp/original.out /tmp/solution.out; echo diff_status=$?; fi\r\n\u001b[?2004l\r"]
[118.311525, "o", "original_status=124\r\n"]
[118.311992, "o", "\u001b[?2004hroot@263ea7a4ea0c:/app# "]
[206.235964, "i", "cat > /app/sol.sql <<'SQL'\nWITH synset_counts AS (\n  SELECT wordid, synsetid, COUNT(*) AS sense_count\n  FROM senses\n  GROUP BY wordid, synsetid\n), word_stats AS (\n  SELECT\n    c.wordid,\n    COUNT(*) AS total_synsets,\n    SUM(c.sense_count) AS total_senses,\n    COUNT(DISTINCT syn.domainid) AS distinct_domains,\n    COUNT(DISTINCT syn.posid) AS distinct_posids\n  FROM synset_counts AS c\n  JOIN synsets AS syn ON syn.synsetid = c.synsetid\n  GROUP BY c.wordid\n  HAVING total_synsets >= 2\n     AND distinct_domains >= 2\n     AND total_senses >= 2\n), ranked AS (\n  SELECT\n    wordid,\n    synsetid,\n    sense_count,\n    ROW_NUMBER() OVER (\n      PARTITION BY wordid\n      ORDER BY sense_count DESC, synsetid ASC\n    ) AS rn\n  FROM synset_counts\n)\nSELECT\n  w.wordid AS word_id,\n  w.word AS word,\n  ws.total_synsets,\n  ws.total_senses,\n  ws.distinct_domains,\n  ws.distinct_posids,\n  r.synsetid AS top_synsetid,\n  r.sense_count AS top_synset_sense_count\nFROM word_stats AS ws\nJOIN words AS w ON w.wordid = ws.wordid\nJOIN ranked AS r ON r.wordid = ws.wordid AND r.rn = 1\nORDER BY\n  ws.total_senses DESC,\n  ws.total_synsets DESC,\n  ws.distinct_domains DESC,\n  word_id ASC\nLIMIT 500;\nSQL\nsqlite3 /app/oewn.sqlite < /app/sol.sql > /tmp/solution2.out && printf 'rows=' && wc -l < /tmp/solution2.out && cmp -s /tmp/solution.out /tmp/solution2.out && echo output_unchanged=yes\n"]
[206.237166, "o", "cat > /app/sol.sql <<'SQL'\r\n\u001b[?2004l\r"]
[206.237611, "o", "\u001b[?2004h> WITH synset_counts AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT wordid, synsetid, COUNT(*) AS sense_count\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.237937, "o", "> "]
[206.238278, "o", "  FROM senses\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY wordid, synsetid\r\n\u001b[?2004l\r\u001b[?2004h> ), word_stats AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r\u001b[?2004h>     c.wordid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.238455, "o", "    COUNT(*) AS total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h>     SUM(c.sense_count) AS total_senses,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.2386, "o", "    COUNT(DISTINCT syn.domainid) AS distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.238729, "o", "    COUNT(DISTINCT syn.posid) AS distinct_posids\r\n\u001b[?2004l\r\u001b[?2004h>   FROM synset_counts AS c\r\n\u001b[?2004l\r"]
[206.238812, "o", "\u001b[?2004h>   JOIN synsets AS syn ON syn.synsetid = c.synsetid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.23885, "o", "  GROUP BY c.wordid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.239031, "o", "  HAVING total_synsets >= 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.239078, "o", "     AND distinct_domains >= 2\r\n\u001b[?2004l\r\u001b[?2004h>      AND total_senses >= 2\r\n\u001b[?2004l\r\u001b[?2004h> ), ranked AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r"]
[206.239123, "o", "\u001b[?2004h"]
[206.239318, "o", ">     wordid,\r\n\u001b[?2004l\r\u001b[?2004h>     synsetid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.239391, "o", "    sense_count,\r\n\u001b[?2004l\r\u001b[?2004h>     ROW_NUMBER() OVER (\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.239531, "o", "> "]
[206.239589, "o", "      PARTITION BY wordid\r\n\u001b[?2004l\r\u001b[?2004h>       ORDER BY sense_count DESC, synsetid ASC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.239619, "o", "    ) AS rn\r\n\u001b[?2004l\r"]
[206.239644, "o", "\u001b[?2004h"]
[206.23992, "o", ">   FROM synset_counts\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> SELECT\r\n\u001b[?2004l\r\u001b[?2004h>   w.wordid AS word_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.240895, "o", "  w.word AS word,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_posids,\r\n\u001b[?2004l\r\u001b[?2004h>   r.synsetid AS top_synsetid,\r\n\u001b[?2004l\r\u001b[?2004h>   r.sense_count AS top_synset_sense_count\r\n\u001b[?2004l\r\u001b[?2004h> FROM word_stats AS ws\r\n\u001b[?2004l\r\u001b[?2004h> JOIN words AS w ON w.wordid = ws.wordid\r\n\u001b[?2004l\r\u001b[?2004h> JOIN ranked AS r ON r.wordid = ws.wordid AND r.rn = 1\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_senses DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_synsets DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_domains DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   word_id ASC\r\n\u001b[?2004l\r\u001b[?2004h> LIMIT 500;\r\n\u001b[?2004l\r\u001b[?2004h> SQL\r\n\u001b[?2004l\r"]
