[264.812887, "o", "45-\r\n46-/* This variable is only written with the world stopped, so it need not be\r\n47-   atomic */\r\n48-uintnat caml_major_cycles_completed = 0;\r\n49-\r\n50:/* [num_domains_to_sweep] records the number of domains to sweep in the current\r\n51-   major cycle. The number is set to the [num_domains_in_stw] at the start of\r\n52-   the cycle and _strictly decreases_ to 0.\r\n53-\r\n54:   Domains created in a given cycle will not have any sweep work in that cycle.\r\n55-   Sweep changes GARBAGE coloured objects in the domain's own pools to FREE\r\n56-   (not a distinct colour; object header is set to 0) and adds them to the free\r\n57-   list. No object will have the GARBAGE colour in the domain's own pools since\r\n58-   the domain starts with an empty pool with no objects and new objects are\r\n59-   allocated with colour MARKED. Hence, they do not affect\r\n60:   [num_domains_to_sweep].\r\n61-\r\n62:   Terminating domains terminate after sweeping is complete for their domain.\r\n63-   */\r\n64:static atomic_uintnat num_domains_to_sweep;\r\n65-\r\n66-/* [num_domains_to_mark] records the number of domains to mark in the current\r\n67-   major cycle. The number is set to the [num_domains_in_stw] at the start of\r\n68-   the cycle. The value of [num_domains_to_mark] may decrease or increase.\r\n69-\r\n--\r\n72-   into a potentially empty mark stack of the newly spawned domain.\r\n73-\r\n74-   Terminating domains empty their mark stack before terminating. */\r\n75-static atomic_uintnat num_domains_to_mark;\r\n76-\r\n77:/* [num_domains_to_ephe_sweep] is set to the [participating_count] at the start\r\n78:   of the [Phase_sweep_ephe] and strictly decreases. */\r\n79:static atomic_uintnat num_domains_to_ephe_sweep;\r\n80-\r\n81-/* [num_domains_to_final_update_first] and [num_domains_to_final_update_last]\r\n82-   are initialised to [num_domains_in_stw] at the start of the cycle. Whenever\r\n83-   a domain finishes processing its first or last finalisers, it decrements the\r\n84-   appropriate counter.\r\n--\r\n92-/* When domains terminate, they will orphan their finalisers. As mentioned in\r\n93-   the comment attached to [num_domains_to_final_update_*] counters, a domain\r\n94-   will decrement the counters when the corresponding finalisers are processed\r\n95-   for that domain. We would like to preserve this invariant when adopting\r\n96-   orphaned finalisers. To this end, we orphan and adopt finalisers only in\r\n97:   [Phase_sweep_and_mark_main] when [num_domains_to_final_update_*] counters\r\n98-   have not been decremented for the domain yet.\r\n99-\r\n100-   [num_domains_orphaning_finalisers] keeps a count of the number of domains\r\n101-   currently orphaning finalisers. This counter is only used in the\r\n102:   [Phase_sweep_and_mark_main] to determine whether to proceed to\r\n103-   [Phase_mark_final]. If domains are currently orphaning finalisers, we remain\r\n104:   in [Phase_sweep_and_mark_main] so that the orphaned finalisers can be\r\n105-   adopted before moving onto [Phase_mark_final] where the [GC.finalise]\r\n106-   (finalise first) finalisers are processed. */\r\n107-static atomic_uintnat num_domains_orphaning_finalisers = 0;\r\n108-\r\n109-enum global_roots_status{\r\n--\r\n134-\r\n135-Caml_inline char caml_gc_phase_char(int may_access_gc_phase) {\r\n136-  if (!may_access_gc_phase)\r\n137-    return 'U';\r\n138-  switch (caml_gc_phase) {\r\n139:    case Phase_sweep_and_mark_main:\r\n140-      return 'M';\r\n141-    case Phase_mark_final:\r\n142-      return 'F';\r\n143:    case Phase_sweep_ephe:\r\n144-      return 'E';\r\n145-    default:\r\n146-      return 'U';\r\n147-  }\r\n148-}\r\n--\r\n407-  domain_state->ephe_info->cursor.todop = prev_linkp;\r\n408-\r\n409-  return budget;\r\n410-}\r\n411-\r\n412:static intnat ephe_sweep (caml_domain_state* domain_state, intnat budget)\r\n413-{\r\n414-  value v;\r\n415:  CAMLassert (caml_gc_phase == Phase_sweep_ephe);\r\n416-\r\n417-  while (domain_state->ephe_info->todo != 0 && budget > 0) {\r\n418-    v = domain_state->ephe_info->todo;\r\n419-    domain_state->ephe_info->todo = Ephe_link(v);\r\n420-    CAMLassert (Tag_val(v) == Abstract_tag);\r\n--\r\n483-void caml_orphan_ephemerons (caml_domain_state* domain_state)\r\n484-{\r\n485-  str"]
[264.813003, "o", "uct caml_ephe_info* ephe_info = domain_state->ephe_info;\r\n486-  if (ephe_info->todo == 0 &&\r\n487-      ephe_info->live == 0 &&\r\n488:      ephe_info->must_sweep_ephe == 0)\r\n489-    return;\r\n490-\r\n491-  /* Force all ephemerons and their data on todo list to be alive */\r\n492-  if (ephe_info->todo) {\r\n493-    while (ephe_info->todo) {\r\n--\r\n506-    orph_structs.ephe_list_live = ephe_info->live;\r\n507-    ephe_info->live = 0;\r\n508-    caml_plat_unlock(&orphaned_lock);\r\n509-  }\r\n510-\r\n511:  if (ephe_info->must_sweep_ephe) {\r\n512:    ephe_info->must_sweep_ephe = 0;\r\n513:    (void)caml_atomic_counter_decr(&num_domains_to_ephe_sweep);\r\n514-  }\r\n515:  CAMLassert (ephe_info->must_sweep_ephe == 0);\r\n516-  CAMLassert (ephe_info->live == 0);\r\n517-  CAMLassert (ephe_info->todo == 0);\r\n518-}\r\n519-\r\n520-void caml_orphan_finalisers (caml_domain_state* domain_state)\r\n--\r\n522-  struct caml_final_info* f = domain_state->final_info;\r\n523-\r\n524-  if (f->todo_head != NULL || f->first.size != 0 || f->last.size != 0) {\r\n525-    /* have some final structures */\r\n526-    (void)caml_atomic_counter_incr(&num_domains_orphaning_finalisers);\r\n527:    if (caml_gc_phase != Phase_sweep_and_mark_main) {\r\n528-      /* Force a major GC cycle to simplify constraints for orphaning\r\n529-         finalisers. See note attached to the declaration of\r\n530-         [num_domains_orphaning_finalisers] variable in major_gc.c */\r\n531-      caml_finish_major_cycle(0);\r\n532-    }\r\n533:    CAMLassert(caml_gc_phase == Phase_sweep_and_mark_main);\r\n534-    CAMLassert (!f->updated_first);\r\n535-    CAMLassert (!f->updated_last);\r\n536-\r\n537-    /* Add the finalisers to [orph_structs] */\r\n538-    caml_plat_lock_blocking(&orphaned_lock);\r\n--\r\n592-    domain_state->ephe_info->live = orph_ephe_list_live;\r\n593-  }\r\n594-\r\n595-  while (f != NULL) {\r\n596-    myf = domain_state->final_info;\r\n597:    CAMLassert (caml_gc_phase == Phase_sweep_and_mark_main);\r\n598:    /* Since we are in [Phase_sweep_and_mark_main], the current domain has not\r\n599-       updated its finalisers. */\r\n600-    CAMLassert (!myf->updated_first);\r\n601-    CAMLassert (!myf->updated_last);\r\n602-\r\n603-    if (f->todo_head) {\r\n--\r\n721-  intnat alloc_work, dependent_work, extra_work, new_work;\r\n722-  intnat my_alloc_count, my_alloc_direct_count, my_dependent_count;\r\n723-  intnat my_alloc_suspended_count, my_alloc_resumed_count;\r\n724-  double my_extra_count;\r\n725-  caml_domain_state *dom_st = Caml_state;\r\n726:  uintnat heap_words, heap_size, heap_sweep_words, total_cycle_work;\r\n727-  uintnat percent_free;\r\n728-\r\n729-  my_alloc_count = dom_st->allocated_words;\r\n730-  my_alloc_direct_count = dom_st->allocated_words_direct;\r\n731-  my_alloc_suspended_count = dom_st->allocated_words_suspended;\r\n--\r\n763-              PE = dom_st->extra_heap_resources\r\n764-     Proportion of total work to do in this slice:\r\n765-              P  = max (PH, PE)\r\n766-     Amount of marking work for the GC cycle:\r\n767-              MW = heap_words * 100 / (100 + caml_percent_free)\r\n768:     Amount of sweeping work for the GC cycle:\r\n769:              SW = heap_sweep_words\r\n770-     Amount of total work for the GC cycle:\r\n771-              TW = MW + SW\r\n772:              = heap_words * 100 / (100 + caml_percent_free) + heap_sweep_words\r\n773-\r\n774-     Amount of time to spend on this slice:\r\n775-                 T = P * TT\r\n776-\r\n777-     Since we must do TW amount of work in TT time, the amount of work done\r\n778-     for this slice is:\r\n779-                 S = P * TW\r\n780-  */\r\n781-  heap_size = caml_heap_size(dom_st->shared_heap);\r\n782-  heap_words = Wsize_bsize(heap_size);\r\n783:  heap_sweep_words = heap_words;\r\n784-  percent_free = atomic_load(&caml_percent_free);\r\n785-\r\n786-  total_cycle_work =\r\n787:    heap_sweep_words\r\n788-    + (uintnat) ((double) heap_words * 100.0 / (100.0 + percent_free));\r\n789-\r\n790-  if (heap_words > 0) {\r\n791-    double alloc_ratio =\r\n792-      total_cycle_work\r\n--\r\n1147-\r\n1148-  CAMLassert(Has_status_val(block, caml_global_heap_state.MARKED));\r\n1149-  CAMLassert(Is_block(block));\r\n1150-  CAMLassert(!Is_young(block));\r\n115"]
[264.813443, "o", "1-  CAMLassert(Tag_val(block) != Infix_tag);\r\n1152:  CAMLassert(Tag_val(block) < No_scan_tag);\r\n1153-  CAMLassert(Tag_val(block) != Cont_tag);\r\n1154-\r\n1155-  /* Optimisation to avoid pushing small, unmarkable objects such as\r\n1156-     [Some 42] into the mark stack. */\r\n1157-  end = (block_wsz < 8 ? block_wsz : 8);\r\n--\r\n1236-        } else {\r\n1237-          atomic_store_relaxed(\r\n1238-            Hp_atomic_val(child),\r\n1239-            With_status_hd(chd, caml_global_heap_state.MARKED));\r\n1240-        }\r\n1241:        if(Tag_hd(chd) < No_scan_tag){\r\n1242-          *work -= mark_stack_push_block(stk, child);\r\n1243-        } else {\r\n1244-          *work -= Wosize_hd(chd);\r\n1245-        }\r\n1246-      }\r\n--\r\n1303-            Hp_atomic_val(block),\r\n1304-            With_status_hd(hd, caml_global_heap_state.MARKED));\r\n1305-      }\r\n1306-\r\n1307-      budget--; /* header word */\r\n1308:      if (Tag_hd(hd) >= No_scan_tag) {\r\n1309-        /* Nothing to scan here */\r\n1310-        budget -= Wosize_hd(hd);\r\n1311-        continue;\r\n1312-      }\r\n1313-\r\n--\r\n1461-      caml_darken_cont(v);\r\n1462-    } else {\r\n1463-      atomic_store_relaxed(\r\n1464-         Hp_atomic_val(v),\r\n1465-         With_status_hd(hd, caml_global_heap_state.MARKED));\r\n1466:      if (Tag_hd(hd) < No_scan_tag) {\r\n1467-        mark_stack_push_block(domain_state->mark_stack, v);\r\n1468-      }\r\n1469-    }\r\n1470-  }\r\n1471-}\r\n--\r\n1530-    last_cycle.not_garbage_words = not_garbage_words;\r\n1531-  }\r\n1532-\r\n1533-  domain->swept_words = 0;\r\n1534-\r\n1535:  caml_atomic_counter_init(&num_domains_to_sweep, num_domains_in_stw);\r\n1536-  caml_atomic_counter_init(&num_domains_to_mark, num_domains_in_stw);\r\n1537-\r\n1538:  caml_gc_phase = Phase_sweep_and_mark_main;\r\n1539-  caml_atomic_counter_init(&ephe_cycle_info.num_domains_todo,\r\n1540-                           num_domains_in_stw);\r\n1541-  caml_atomic_counter_init(&ephe_cycle_info.ephe_cycle, 1);\r\n1542-  caml_atomic_counter_init(&ephe_cycle_info.num_domains_done, 0);\r\n1543-\r\n1544:  caml_atomic_counter_init(&num_domains_to_ephe_sweep, 0);\r\n1545-  /* Will be set to the correct number when switching to\r\n1546:     [Phase_sweep_ephe] */\r\n1547-\r\n1548-  caml_atomic_counter_init(&num_domains_to_final_update_first,\r\n1549-                           num_domains_in_stw);\r\n"]
