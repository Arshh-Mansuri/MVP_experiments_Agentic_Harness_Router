-\u001b[m\u001b[K        /* count the free block and any that follow it (stored in the\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           size bits in the header)*/\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1589\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        s->free += wh * (1 + \u001b[01;31m\u001b[KWosize_hd(hd)\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        p += \u001b[01;31m\u001b[KWosize_hd(hd)\u001b[m\u001b[K * wh;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r"]
[562.512186, "o", "\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(end == p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->allocated += POOL_WSIZE;\r\n"]
