[348.038752, "i", "cd /app/ocaml\npython3 - <<'PY'\np='runtime/shared_heap.c'\nlines=open(p).read().splitlines(True)\nfor i,line in enumerate(lines):\n    if 'p += wh * Wosize_hd(hd);' in line:\n        lines[i] = '''        /* Skip the complete compressed free run.  The free header's\n           wosize is the number of additional free blocks in the run. */\n        p += wh * (Wosize_hd(hd) + 1);\n'''\n        # The next common increment must not also be applied to a free run.\n        for j in range(i + 1, min(i + 12, len(lines))):\n            if 'p += Whsize_hd(hd);' in lines[j]:\n                lines[j] = '''      if (!POOL_BLOCK_FREE_HD(hd))\n        p += Whsize_hd(hd);\n'''\n                break\n        else:\n            raise SystemExit('common increment not found')\n        break\nelse:\n    raise SystemExit('free-run increment not found')\nopen(p,'w').writelines(lines)\nPY\nnl -ba runtime/shared_heap.c | sed -n '638,660p'\n"]
