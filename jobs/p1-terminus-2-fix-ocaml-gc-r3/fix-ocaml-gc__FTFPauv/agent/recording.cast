ared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_words -= Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner->swept_words += Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* reload hd */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        hd = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* If the current block was garbage (and is now a free block) or was\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      initially a free block, see if we can merge it with the last free block we\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      encountered or if we cannot then update the pointer in the last free block\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      to point to this one */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (POOL_BLOCK_FREE_HD(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if any block is free then this is no longer a full pool */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K618\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if there was a free block before us, check first if we can\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           merge with it */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K620\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if( last_free_block ) "]
[561.975268, "o", "{\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert(POOL_BLOCK_FREE_HP(last_free_block));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* check if we can merge with the last free block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if( last_free_block + (1 + Wosize_hp(last_free_block)) * wh == p ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if we can then update the wosize of the last free block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_free_block = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(last_free_block)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                                  + Wosize_hd(hd) + 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K629\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* in this case there's a non-free block between us so update\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                the next pointer */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block[1] = (value)p;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block = p;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* if we're the first free block then set the next_obj pointer for\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K637\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            the pool (which indicates the start of the freelist) */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          a->next_obj = (value*)p;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if there are free blocks after this, use those */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              );\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert((header_t*)next <= POOL_END(to_pool));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              next[1] = new_p[1];\r\n\u001b[35m\u001b[Krunti"]
[561.97539, "o", "me/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value *next = (value*)new_p[1];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (!next) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                /* This pool is full. Move it to unswept_full_pools */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_avail_pools[sz_class] = to_pool->next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                to_pool->next = heap->unswept_full_pools[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_full_pools[sz_class] = to_pool;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              }\r\n"]
