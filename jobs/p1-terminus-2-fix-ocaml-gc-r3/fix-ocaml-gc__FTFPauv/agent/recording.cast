[581.344085, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  sizeclass sz;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K} pool;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic_assert(sizeof(pool) == Bsize_wsize(POOL_HEADER_WSIZE), \"\");\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_SLAB_WOFFSET(sz) (POOL_HEADER_WSIZE + wastage_sizeclass[sz])\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_FIRST_BLOCK(p, sz) ((header_t*)(p) + POOL_SLAB_WOFFSET(sz))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_END(p) ((header_t*)(p) + POOL_WSIZE)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[581.345593, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd) \\\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  (Tag_hd(hd) == No_scan_tag && (Color_hd(hd) == NOT_MARKABLE))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(p) (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(Hd_hp(p)))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize) Make_header(wosize, No_scan_tag, NOT_MARKABLE)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktypedef struct large_alloc {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_domain_state* owner;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct large_alloc* next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K} large_alloc;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic_assert(sizeof(large_alloc) % sizeof(value) == 0, \"\");\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define LARGE_ALLOC_HEADER_SZ sizeof(large_alloc)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K74\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[581.345747, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  s->pool_frag_words += POOL_SLAB_WOFFSET(sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (p + wh <= end) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_words += Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_frag_words += wh - Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_blocks++;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh * Wosize_hd(hd); /* skip contiguous free blocks */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p += wh;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(r);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat pool_blocks = (end - p) / wsize_sizeclass[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[3