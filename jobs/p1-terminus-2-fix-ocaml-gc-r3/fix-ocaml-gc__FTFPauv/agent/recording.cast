[562.507795, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(end == p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->allocated += POOL_WSIZE;\r\n"]
[562.508889, "o", "\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K783\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    extern_int(s, Long_val(v));\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K784\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  else {\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K786\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = Hd_val(v);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K787\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    tag_t tag = Tag_hd(hd);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K788\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    mlsize_t sz = \u001b[01;31m\u001b[KWosize_hd(hd)\u001b[m\u001b[K;\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[562.509005, "o", "\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K790\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (tag == Forward_tag) {\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K791\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      value f = Forward_val (v);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K792\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (Is_block (f)\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          && (   Tag_val (f) == Forward_tag\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else if (extern_lookup_position(s, v, &pos, &h)) {\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* Already seen and counted, nothing to do */\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = Hd_val(v);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      tag_t tag = Tag_hd(hd);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1298\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      mlsize_t sz = \u001