[540.217593, "o", "se */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1382\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(to_pool, sz_class) <= (header_t*)next\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              );\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              CAMLassert((header_t*)next <= \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(to_pool));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              next[1] = new_p[1];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value *next = (value*)new_p[1];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (!next) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                /* This pool is full. Move it to unswept_full_pools */\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1501\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      Note that we may have no \"available\" pools left, if all\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1502\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      remaining pools have been filled up by evacuated blocks. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1503\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1504\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* cur_pool = evacuated_pools;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1505\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (cur_pool) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1506\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* next_pool = cur_pool->next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1507\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1508\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    #ifdef DEBUG\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1509\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (header_t *p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(cur_pool, cur_pool->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1510\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K         p < \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(cur_pool); p++) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1511\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      *p = Debug_free_major;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1512\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1513\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    #endif\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K"]
[540.217798, "o", "\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_free(heap, cur_pool, cur_pool->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1516\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = next_pool;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1517\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1518\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat free;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat overhead;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat live_blocks;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1560\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_pool(pool* a, sizeclass sz, struct mem_stats* s) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (value *v = a->next_obj; v; v = (value*)v[1]) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1563\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(v));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1567\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1568\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1569\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    mlsize_t wh = \u001b[01;31m\u001b[Kwsize_sizeclass\u001b[m\u001b[K[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->overhead += POOL_SLAB_WOFFSET(sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1572\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1573\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* This header can be read here and concurrently marked by the GC, but\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1574\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         this is fine: marking can only turn UNMARKED objects into MARKED or\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1575\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         NOT_MARKABLE, which is of no consequence for this verification\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1576\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         (namely, that there is no garbage left). */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1577\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = Hd_hp(p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd) ||\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          !Has_status_hd(hd, caml_global_heap_state.GARBAGE)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      );\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1582\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live += Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->overhead += wh - Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live_blocks++;\r\n\u001b"]
[540.21796, "o", "[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* count the free block and any that follow it (stored in the\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           size bits in the header)*/\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->free += wh * (1 + Wosize_hd(hd));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += Wosize_hd(hd) * wh;\r\n"]
