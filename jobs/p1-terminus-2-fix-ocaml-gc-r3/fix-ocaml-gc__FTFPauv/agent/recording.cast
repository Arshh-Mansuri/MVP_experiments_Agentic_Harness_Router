b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* add to freelist. This could be optimised, we don't need\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        to write the free header if we're going to merge it with a prior\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        free block but it makes this codepath more complex. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        *p = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block((value)p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (mlsize_t i = 1, wo = Wosize_whsize(wh); i < wo; i++) {\r\n\u0