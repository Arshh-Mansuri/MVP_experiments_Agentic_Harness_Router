[246.640868, "o", "   125\t# Do not strip the header produced by cl\r\n   126\tifneq \"$(TOOLCHAIN)\" \"msvc\"\r\n   127\t\t$(STRIP) $@\r\n   128\tendif\r\n   129\t\r\n   130\tstdlib.cma: $(OBJS)\r\n   131\t\t$(V_LINKC)$(CAMLC) -a -o $@ $^\r\n   132\t\r\n   133\tstdlib.cmxa: $(OBJS:.cmo=.cmx)\r\n   134\t\t$(V_LINKOPT)$(CAMLOPT) -a -o $@ $^\r\n   135\t\r\n   136\t.PHONY: distclean\r\n   137\tdistclean: clean\r\n   138\t\trm -f sys.ml META runtime.info target_runtime.info\r\n   139\t\r\n   140\t.PHONY: clean\r\n   141\tclean::\r\n   142\t\trm -f $(HEADER_NAME) target_$(HEADER_NAME)\r\n   143\t\r\n   144\texport AWK\r\n   145\t\r\n   146\t%.cmi: %.mli\r\n   147\t\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) -c $<\r\n   148\t\r\n   149\t# The dependency on the .mli file is in .depend (since stdlib__Foo.cmi\r\n   150\t# depends on stdlib__foo.mli)\r\n   151\tstdlib__%.cmi:\r\n   152\t\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) \\\r\n   153\t\t         -o $@ -c $(filter %.mli, $^)\r\n   154\t\r\n   155\t%.cmo: %.ml\r\n   156\t\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) -c $<\r\n   157\t\r\n   158\t# The dependency on the .ml file is in .depend (since stdlib__Foo.cmo\r\n   159\t# depends on stdlib__foo.ml)\r\n   160\tstdlib__%.cmo:\r\n"]
