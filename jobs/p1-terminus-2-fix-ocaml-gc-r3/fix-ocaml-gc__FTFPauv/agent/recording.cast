[271.524846, "o", "stats to the orphan pools.\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K844\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   You need to hold the [pool_freelist] lock. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K845\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void orphan_heap_stats_with_lock(\u001b[01;31m\u001b[Kstruct caml_heap_state\u001b[m\u001b[K *heap) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K846\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_accum_heap_stats(&pool_freelist.stats, &heap->stats);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K847\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  memset(&heap->stats, 0, sizeof(heap->stats));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K848\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K849\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K850\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* The stats for an adopted pool are moved from the free pool stats to\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   the heap stats of the adopting domain.\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   You need to hold the [pool_freelist] lock. */\r\n\u001b[35m\u001b[Kruntime/shared_h