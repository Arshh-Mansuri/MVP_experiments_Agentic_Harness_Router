01b[K562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* note that the below will have to be changed for the new GC pacing\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Tag_hd (hd) == Custom_tag) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (final_fun != NULL) final_fun(Val_hp(p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* add to freelist. This could be optimised, we don't need\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        to write the free header if we're going to merge it with a prior\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        free block but it makes this codepath more complex. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        *p = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block((value)p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (mlsize_t i = 1, wo = Wosize_whsize(wh); i < wo; i++) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          Field(Val_hp(p), i) = Debug_free_major;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K596\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n"]
[540.212458, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K597\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K598\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K599\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K600\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* update stats */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K601\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_blocks--;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_words -= Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner->swept_words += Whsize_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* reload hd */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        hd = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* If the current block was garbage (and is now a free block) or was\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      initially a free block, see if we can merge it with the last free block we\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      encountered or if we cannot then update the pointer in the last free block\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      to point to this one */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if any block is free then this is no longer a full pool */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K618\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if there was a free block before us, check first if we can\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           merge with it */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K620\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if( last_free_block ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(last_free_block));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* check if we can merge with the last free block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if( last_free_block + (1 + Wosize_hp(last_free_block)) * wh == p ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if we can then update the wosize of the last free block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_free_block = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(last_free_block)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                                  + Wosize_hd(hd) + 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K629\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* i"]
[540.213245, "o", "n this case there's a non-free block between us so update\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                the next pointer */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block[1] = (value)p;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block = p;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* Skip the complete compressed free run.  The free header's\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K644\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           wosize is the number of additional free blocks in the run. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * (Wosize_hd(hd) + 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K646\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-