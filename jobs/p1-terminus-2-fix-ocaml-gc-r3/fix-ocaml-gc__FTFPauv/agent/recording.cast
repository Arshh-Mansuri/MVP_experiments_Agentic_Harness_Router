001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].free_blocks = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].live_blocks = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t h = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(h)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* this tells us the number of spaces of size wh after this */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          mlsize_t wosize = Wosize_hd(h);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          pool_stats[k].free_blocks += wosize + 1;\r\n"]
[581.348061, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          total_free_blocks += wosize + 1;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* skip to the next block */\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* end = POOL_END(cur_pool);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, caml_global_heap_state.MARKED));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, NOT_MARKABLE));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* Reminder: since colours have rotated, UNMARKED indicates a MARKED\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          (i.e live) block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (Has_status_hd(hd, caml_global_heap_state.UNMARKED)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* live block in an evacuating pool, so we evacuate it to\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K             * the first available block */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            pool* to_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            value* new_p = to_pool->next_obj;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(new_p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if there are free blocks after this, use those */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\n\u001b[35"]
[581.348534, "o", "m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              );\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert((header_t*)next <= POOL_END(to_pool));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              next[1] = new_p[1];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value *next = (value*)new_p[1];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to_pool->next_obj = next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (!next) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                /* This pool is full. Move it to unswept_full_pools */\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat free;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat overhead;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat live_blocks;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1560\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_pool(pool* a, sizeclass sz, struct mem_stats* s) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001