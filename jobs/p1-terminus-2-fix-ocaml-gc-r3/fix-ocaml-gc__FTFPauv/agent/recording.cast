[540.209061, "o", "\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic const unsigned int \u001b[01;31m\u001b[Kwsize_sizeclass\u001b[m\u001b[K[NUM_SIZECLASSES] =\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{ /*  0:*/ 1, 2, 3, 4, 5,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /*  5:*/ 6, 7, 8, 10, 12,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* 10:*/ 14, 16, 17, 19, 22,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* 15:*/ 25, 28, 32, 33, 37,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* 20:*/ 42, 47, 53, 59, 65,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* 25:*/ 73, 81, 89, 99, 108,\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* 30:*/ 118, 128 };\r\n\u001b[35m\u001b[Kruntime/caml/sizeclasses.h\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[540.210264, "o", "\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktypedef struct pool {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K52\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct pool* next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  value* next_obj;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_domain_state* owner;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  sizeclass sz;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K} pool;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic_assert(sizeof(pool) == Bsize_wsize(POOL_HEADER_WSIZE), \"\");\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_SLAB_WOFFSET(sz) (POOL_HEADER_WSIZE + wastage_sizeclass[sz])\r\n"]
[540.210339, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(p, sz) ((header_t*)(p) + POOL_SLAB_WOFFSET(sz))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(p) ((header_t*)(p) + POOL_WSIZE)\r\n"]
