[580.832201, "o", "printf '%s\\n' '--- statistics loop ---'\r\n\u001b[?2004l\r--- statistics loop ---\r\n\u001b[?2004hroot@441fc5dcb96c:/app/ocaml# "]
[580.83232, "o", "nl -ba runtime/shared_heap.c | sed -n '1550,1600p'\r\n\u001b[?2004l\r"]
[580.906803, "o", "  1550\t\r\n  1551\tstruct mem_stats {\r\n  1552\t  /* unit is words */\r\n  1553\t  uintnat allocated;\r\n  1554\t  uintnat live;\r\n  1555\t  uintnat free;\r\n  1556\t  uintnat overhead;\r\n  1557\t\r\n  1558\t  uintnat live_blocks;\r\n  1559\t};\r\n  1560\t\r\n  1561\tstatic void verify_pool(pool* a, sizeclass sz, struct mem_stats* s) {\r\n  1562\t  for (value *v = a->next_obj; v; v = (value*)v[1]) {\r\n  1563\t    CAMLassert(POOL_BLOCK_FREE_HP(v));\r\n  1564\t  }\r\n  1565\t\r\n  1566\t  {\r\n  1567\t    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n  1568\t    header_t* end = POOL_END(a);\r\n  1569\t    mlsize_t wh = wsize_sizeclass[sz];\r\n  1570\t    s->overhead += POOL_SLAB_WOFFSET(sz);\r\n  1571\t\r\n  1572\t    while (p + wh <= end) {\r\n  1573\t      /* This header can be read here and concurrently marked by the GC, but\r\n  1574\t         this is fine: marking can only turn UNMARKED objects into MARKED or\r\n  1575\t         NOT_MARKABLE, which is of no consequence for this verification\r\n  1576\t         (namely, that there is no garbage left). */\r\n  1577\t      header_t hd = Hd_hp(p);\r\n  1578\t      CAMLassert(\r\n  1579\t        POOL_BLOCK_FREE_HD(hd) ||\r\n  1580\t          !Has_status_hd(hd, caml_global_heap_state.GARBAGE)\r\n  1581\t      );\r\n  1582\t      if (!POOL_BLOCK_FREE_HD(hd)) {\r\n  1583\t        s->live += Whsize_hd(hd);\r\n  1584\t        s->overhead += wh - Whsize_hd(hd);\r\n  1585\t        s->live_blocks++;\r\n  1586\t      } else {\r\n  1587\t        /* count the free block and any that follow it (stored in the\r\n  1588\t           size bits in the header)*/\r\n  1589\t        s->free += wh * (1 + Wosize_hd(hd));\r\n  1590\t        p += Wosize_hd(hd) * wh;\r\n  1591\t      }\r\n  1592\t      p += wh;\r\n  1593\t    }\r\n  1594\t    CAMLassert(end == p);\r\n  1595\t    s->allocated += POOL_WSIZE;\r\n  1596\t  }\r\n  1597\t}\r\n  1598\t\r\n  1599\tstatic void verify_large(large_alloc* a, struct mem_stats* s) {\r\n  1600\t  for (; a; a = a->next) {\r\n"]
