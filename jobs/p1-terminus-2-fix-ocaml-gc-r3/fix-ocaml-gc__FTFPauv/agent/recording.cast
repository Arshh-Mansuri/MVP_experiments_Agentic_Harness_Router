[271.522096, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (p += 2; p < end; p++) *p = Debug_free_major;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert((uintptr_t)end % Cache_line_bsize == 0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Allocating an object from a pool */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCAMLno_tsan_for_perf\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic intnat pool_sweep(\u001b[01;31m\u001b[Kstruct caml_heap_state\u001b[m\u001b[K* local,\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool**,\r\n"]
[271.522344, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz,\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         int release_to_global_pool);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void pool_finalise(\u001b[01;31m\u001b[Kstruct caml_heap_state\u001b[m\u001b[K* local, pool**, sizeclass sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Adopt pool from the pool_freelist avail and full pools\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   to satisfy an allocation */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic pool* pool_global_adopt(\u001b[01;31m\u001b[Kstruct caml_heap_state\u001b[m\u001b[K* local, sizeclass sz)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r = NULL;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[3