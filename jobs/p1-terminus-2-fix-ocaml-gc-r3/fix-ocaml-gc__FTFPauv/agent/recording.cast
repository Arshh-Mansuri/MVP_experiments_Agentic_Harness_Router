[271.009142, "o", "grep -n -i -C6 -E 'run.?length|compressed|free.*block|freelist|free list' runtime/shared_heap.c\r\n\u001b[?2004l\r"]
[271.037031, "o", "\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_FIRST_BLOCK(p, sz) ((header_t*)(p) + POOL_SLAB_WOFFSET(sz))\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_END(p) ((header_t*)(p) + POOL_WSIZE)\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_BLOCK_FREE_HD(hd) \\\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  (Tag_hd(hd) == No_scan_tag && (Color_hd(hd) == NOT_MARKABLE))\r\n"]
[271.038805, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define POOL_BLOCK_\u001b[01;31m\u001b[KFREE_HP(p) (POOL_BLOCK\u001b[m\u001b[K_FREE_HD(Hd_hp(p)))\r\n"]
[271.038914, "o", "\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define POOL_FREE_HEADER(wosize) Make_header(wosize, No_scan_tag, NOT_MARKABLE)\r\n\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Ktypedef struct large_alloc {\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_domain_state* owner;\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct large_alloc* next;\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K} large_alloc;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* these only contain swept memory of terminated domains*/\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_stats stats;\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  _Atomic(pool*) global_avail_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  _Atomic(pool*) global_full_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  large_alloc* global_large;\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K} pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K = {\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_PLAT_MUTEX_INITIALIZER,\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  NULL,\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  { 0, },\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  { NULL, },\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  { NULL, },\r\n\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  NULL\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_domain_state* owner;\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_stats stats;\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct compact_pool_stat {\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  int \u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks;\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int live_blocks;\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[271.03894, "o", "\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* You need to hold the [pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K] lock to call these functions. */\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void orphan_heap_stats_with_lock(struct caml_heap_state *);\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_pool_stats_with_lock(struct caml_heap_state *,\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                       pool *, sizeclass);\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_all_pool_stats_with_lock(struct caml_heap_state *adopter);\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return count;\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_orphan_shared_heap(struct caml_heap_state* heap) {\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int released = 0, released_large = 0;\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[271.039064, "o", "\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int i = 0; i < NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released +=\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      move_all_pools(&heap->avail_pools[i],\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                     &pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[i], NULL);\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released +=\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      move_all_pools(&heap->full_pools[i],\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                     &pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[i], NULL);\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* should be swept by now */\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(!heap->unswept_avail_pools[i]);\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(!heap->unswept_full_pools[i]);\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(!heap->unswept_large);\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (heap->swept_large) {\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large_alloc* a = heap->swept_large;\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->swept_large = a->next;\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    a->next = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large;\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large = a;\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released_large++;\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  orphan_heap_stats_with_lock(heap);\r\n\u001b[32m\u001b[K181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Orphan shared heap. Released %d active pools, %d large\",\r\n\u001b[32m\u001b[K183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              released, released_large);\r\n\u001b[32m\u001b[K184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_adopt_all_orphan_heaps(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int received_p = 0, received_l = 0;\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int i = 0; i < NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    received_p += move_all_pools(\r\n\u001b[32m\u001b[K191\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        (pool**)&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[i],\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        (_Atomic(pool*)*)&local->unswept_avail_pools[i],\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner);\r\n\u001b[32m\u001b[K194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    received_p += move_all_pools(\r\n"]
[271.039089, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        (pool**)&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[i],\r\n\u001b[32m\u001b[K196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        (_Atomic(pool*)*)&local->unswept_full_pools[i],\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner);\r\n\u001b[32m\u001b[K198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n"]
[271.03923, "o", "\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  while (pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large) {\r\n\u001b[32m\u001b[K200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    large_alloc* a = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large;\r\n\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large = a->next;\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    a->owner = local->owner;\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    a->next = local->unswept_large;\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->unswept_large = a;\r\n\u001b[32m\u001b[K205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    received_l++;\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (received_p || received_l) {\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    adopt_all_pool_stats_with_lock(local);\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (received_p || received_l)\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_gc_log(\"Received %d new pools, %d new large allocs\",\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                received_p, received_l);\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->next_to_sweep = 0;\r\n\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_free_shared_heap(struct caml_heap_state* heap) {\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_assert_shared_heap_is_empty(heap);\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_stat_free(heap);\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* Allocating and deallocating pools from the global \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K. */\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic pool* pool_acquire(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r;\r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if (!pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free) {\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    void* mem = caml_mem_map(Bsize_wsize(POOL_WSIZE), 0);\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (mem) {\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      CAMLassert(pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free == NULL);\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r = (pool*)mem;\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      r->next = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free;\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->owner = NULL;\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free = r;\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free;\r\n"]
[271.039257, "o", "\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (r)\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free = r->next;\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (r) CAMLassert (r->owner == NULL);\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return r;\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* release [pool] to the current \u001b[01;31m\u001b[Kfree list\u001b[m\u001b[K of pools */\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void pool_release(struct caml_heap_state* local,\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool* pool,\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz)\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n"]
[271.03942, "o", "\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool->owner = NULL;\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(pool->sz == sz);\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->stats.pool_words -= POOL_WSIZE;\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->stats.pool_frag_words -= POOL_HEADER_WSIZE + wastage_sizeclass[sz];\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  pool->next = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free;\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free = pool;\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* free the memory of [pool], giving it back to the OS */\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void pool_free(struct caml_heap_state* local,\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool* pool,\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz)\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!POOL_BLOCK_FREE_HD(hd)) {\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_words += Whsize_hd(hd);\r\n\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_frag_words += wh - Whsize_hd(hd);\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_blocks++;\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      p += wh * Wosize_hd(hd); /* skip contiguous \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks */\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p += wh;\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(end == p);\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  s->pool_words += POOL_WSIZE;\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* Initialize a pool and its object \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCaml_inline void pool_initialize(pool* r,\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                 sizeclass sz,\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                 caml_domain_state* owner)\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* p = POOL_FIRST_BLOCK(r, sz);\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(r);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->next = 0;\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->owner = owner;\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->next_obj = (value*)p;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->sz = sz;\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  p[0] = POOL_\u001b[01;31m\u001b[KFREE_HEADER(pool_block\u001b[m\u001b[Ks-1);\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  p[1] = 0;\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (p += 2; p < end; p++) *p = Debug_free_major;\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[271.039568, "o", "\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic intnat pool_sweep(struct caml_heap_state* local,\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool**,\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz,\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         int release_to_global_pool);\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void pool_finalise(struct caml_heap_state* local, pool**, sizeclass sz);\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* Adopt pool from the pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K avail and full pools\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   to satisfy an allocation */\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic pool* pool_global_adopt(struct caml_heap_state* local, sizeclass sz)\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r = NULL;\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int adopted_pool = 0;\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* probably no available pools out there to be had */\r\n"]
[271.039622, "o", "\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if( !atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[sz]) &&\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      !atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[sz]) )\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return NULL;\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Haven't managed to find a pool locally, try the global ones */\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if( atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[sz]) ) {\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r = atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[sz]);\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( r ) {\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      atomic_store_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[sz], r->next);\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->next = 0;\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->owner = local->owner;\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      local->avail_pools[sz] = r;\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopt_pool_stats_with_lock(local, r, sz);\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      #ifdef DEBUG\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* There were no global avail pools, so let's adopt one of the full ones and\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     try our luck sweeping it later on */\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( !r ) {\r\n"]
[271.039804, "o", "\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r = atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[sz]);\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( r ) {\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      atomic_store_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[sz], r->next);\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->next = local->full_pools[sz];\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->owner = local->owner;\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      local->full_pools[sz] = r;\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopt_pool_stats_with_lock(local, r, sz);\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopted_pool = 1;\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r = 0; // this pool is full\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( !r && adopted_pool ) {\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Caml_state->major_work_done_between_slices +=\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_sweep(local, &local->full_pools[sz], sz, 0);\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r = local->avail_pools[sz];\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  p = r->next_obj;\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* assert that p is inside the pool */\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(p >= (value*)POOL_FIRST_BLOCK(r, sz));\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(p < (value*)r + POOL_WSIZE);\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(POOL_BLOCK_FREE_HP(p));\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* in this case there are more \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks immediately after */\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( Wosize_hp(p) > 0 ) {\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    next = (value*)(p + wsize_sizeclass[sz]);\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* we update the pool header of the next block */\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *next = POOL_FREE_HEADER(Wosize_hp(p) - 1);\r\n\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* also copy the next_obj pointer from p */\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(p[1] == 0 || POOL_BLOCK_FREE_HP(p[1]));\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* a = *plist;\r\n\u001b[32m\u001b[K547\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!a) return 0;\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  *plist = a->next;\r\n\u001b[32m\u001b[K549\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K = NULL;\r\n\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int all_used = 1;\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct heap_stats* s = &local->stats;\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(a->owner == local->owner);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if( (char*)p + caml_plat_pagesize < (char*)end ) {\r\n\u001b[32m\u001b[K569\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        caml_prefetch((char*)p + caml_plat_pagesize);\r\n\u001b[32m\u001b[K570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K572\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* The pools mark a block as being free by setting the tag to No_scan_tag\r\n\u001b[32m\u001b[K573\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        and the color to NOT_MARKABLE. The wosize is used to indicate the\r\n\u001b[32m\u001b[K574\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        number of contiguous \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks that follow. The first field is a\r\n\u001b[32m\u001b[K575\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        pointer to the next \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K beyond the immediately following\r\n\u001b[32m\u001b[K576\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        contiguous \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks (if any). */\r\n\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* Check if the current block is garbage, if it is turn "]
[271.03983, "o", "it into a free\r\n\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      block */\r\n\u001b[32m\u001b[K580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (Has_status_hd(hd, caml_global_heap_state.GARBAGE)) {\r\n\u001b[32m\u001b[K581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Whsize_hd(hd) <= wh);\r\n\u001b[32m\u001b[K582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Tag_hd (hd) == Custom_tag) {\r\n\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;\r\n\u001b[32m\u001b[K584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (final_fun != NULL) final_fun(Val_hp(p));\r\n\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        /* add to \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K. This could be optimised, we don't need\r\n\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        to write the free header if we're going to merge it with a prior\r\n\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K but it makes this codepath more complex. */\r\n\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        *p = POOL_FREE_HEADER(0);\r\n\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block((value)p));\r\n\u001b[32m\u001b[K593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (mlsize_t i = 1, wo = Wosize_whsize(wh); i < wo; i++) {\r\n\u001b[32m\u001b[K595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          Field(Val_hp(p), i) = Debug_free_major;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* reload hd */\r\n\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        hd = POOL_FREE_HEADER(0);\r\n\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[271.039973, "o", "\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      /* If the current block was garbage (and is now a \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K) or was\r\n"]
[271.040098, "o", "\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      initially a \u001b[01;31m\u001b[Kfree block, see if we can merge it with the last free block\u001b[m\u001b[K we\r\n\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      encountered or if we cannot then update the pointer in the last \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      to point to this one */\r\n\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (POOL_BLOCK_FREE_HD(hd)) {\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if any block is free then this is no longer a full pool */\r\n\u001b[32m\u001b[K616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K618\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        /* if there was a \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K before us, check first if we can\r\n\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           merge with it */\r\n\u001b[32m\u001b[K620\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if( last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K ) {\r\n\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(POOL_BLOCK_\u001b[01;31m\u001b[KFREE_HP(last_free_block\u001b[m\u001b[K));\r\n\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          /* check if we can merge with the last \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          if( last_\u001b[01;31m\u001b[Kfree_block + (1 + Wosize_hp(last_free_block\u001b[m\u001b[K)) * wh == p ) {\r\n\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            /* if we can then update the wosize of the last \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_\u001b[01;31m\u001b[Kfree_block = POOL_FREE_HEADER(Wosize_hp(last_free_block\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                                  + Wosize_hd(hd) + 1);\r\n\u001b[32m\u001b[K628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          } else {\r\n\u001b[32m\u001b[K629\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            /* in this case there's a non-\u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K between us so update\r\n\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                the next pointer */\r\n\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K[1] = (value)p;\r\n\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K = p;\r\n\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          }\r\n\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          /* if we're the first \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K then set the next_obj pointer for\r\n\u001b[32m\u001b[K637\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            the pool (which indicates the start of the \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K) */\r\n\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          a->next_obj = (value*)p;"]
[271.040145, "o", "\r\n\u001b[32m\u001b[K639\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K640\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K = p;\r\n\u001b[32m\u001b[K641\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K642\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        /* add the \u001b[01;31m\u001b[Kfree blocks following this block\u001b[m\u001b[K, skipping over them */\r\n\u001b[32m\u001b[K644\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * Wosize_hd(hd);\r\n\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K646\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* there's still a live block, the pool can't be released to the global\r\n\u001b[32m\u001b[K647\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K648\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        release_to_global_pool = 0;\r\n\u001b[32m\u001b[K649\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += Whsize_hd(hd);\r\n\u001b[32m\u001b[K651\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } while (p + wh <= end);\r\n\u001b[32m\u001b[K652\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(p == end);\r\n\u001b[32m\u001b[K653\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K654\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( !all_used ) {\r\n\u001b[32m\u001b[K655\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      /* the last \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K should have 0 as its next pointer */\r\n\u001b[32m\u001b[K656\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      last_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[K[1] = 0;\r\n\u001b[32m\u001b[K657\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K658\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K659\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(\r\n\u001b[32m\u001b[K660\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* if all spaces are used then next_obj should be 0 */\r\n\u001b[32m\u001b[K661\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      (all_used && !a->next_obj)\r\n\u001b[32m\u001b[K662\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      /* otherwise it should point to a \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K663\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      || (!all_used && POOL_BLOCK_FREE_HP(a->next_obj))\r\n\u001b[32m\u001b[K664\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    );\r\n\u001b[32m\u001b[K665\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (release_to_global_pool) {\r\n\u001b[32m\u001b[K667\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_release(local, a, sz);\r\n\u001b[32m\u001b[K668\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K835\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K836\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p += wh;\r\n\u001b[32m\u001b[K837\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K838\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K839\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K840\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[271.040426, "o", "\u001b[32m\u001b[K841\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/* Heap and \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K stats */\r\n\u001b[32m\u001b[K842\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K843\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Move the given heap stats to the orphan pools.\r\n\u001b[32m\u001b[K844\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   You need to hold the [pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K] lock. */\r\n\u001b[32m\u001b[K845\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void orphan_heap_stats_with_lock(struct caml_heap_state *heap) {\r\n\u001b[32m\u001b[K846\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_accum_heap_stats(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats, &heap->stats);\r\n\u001b[32m\u001b[K847\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  memset(&heap->stats, 0, sizeof(heap->stats));\r\n\u001b[32m\u001b[K848\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K849\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K850\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* The stats for an adopted pool are moved from the free pool stats to\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   the heap stats of the adopting domain.\r\n\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   You need to hold the [pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K] lock. */\r\n\u001b[32m\u001b[K853\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_pool_stats_with_lock(\r\n\u001b[32m\u001b[K854\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* adopter, pool *r, sizeclass sz)\r\n\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K856\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct heap_stats pool_stats = { 0, };\r\n\u001b[32m\u001b[K857\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K858\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    calc_pool_stats(r, sz, &pool_stats);\r\n\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_accum_heap_stats(&adopter->stats, &pool_stats);\r\n\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    caml_remove_heap_stats(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats, &pool_stats);\r\n\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K862\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Move the stats of all orphan pools into the given heap.\r\n"]
[271.041374, "o", "\u001b[32m\u001b[K864\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   You need to hold the [pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K] lock. */\r\n\u001b[32m\u001b[K865\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_all_pool_stats_with_lock(struct caml_heap_state *adopter) {\r\n\u001b[32m\u001b[K866\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_accum_heap_stats(&adopter->stats, &pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats);\r\n\u001b[32m\u001b[K867\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  memset(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats, 0, sizeof(pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats));\r\n\u001b[32m\u001b[K868\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K869\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K870\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_collect_heap_stats_sample(\r\n\u001b[32m\u001b[K871\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* local,\r\n\u001b[32m\u001b[K872\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_stats* sample)\r\n\u001b[32m\u001b[K873\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K874\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  *sample = local->stats;\r\n\u001b[32m\u001b[K875\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K876\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Add the orphan pool stats to a stats accumulator. */\r\n\u001b[32m\u001b[K878\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_accum_orphan_heap_stats(struct heap_stats* acc)\r\n\u001b[32m\u001b[K879\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K880\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K881\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_accum_heap_stats(acc, &pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.stats);\r\n\u001b[32m\u001b[K882\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K883\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K884\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K885\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K886\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Atoms */\r\n\u001b[32m\u001b[K887\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic const header_t atoms[256] = {\r\n\u001b[32m\u001b[K888\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#define A(i) Make_header(0, i, NOT_MARKABLE)\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (!POOL_BLOCK_FREE_HP(p)) {\r\n\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Has_status_val(Val_hp(p), caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          compact_update_block(p);\r\n\u001b[32m\u001b[K1121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K1122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        /* Skip over \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks */\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * Wosize_hp(p);\r\n\u001b[32m\u001b[K1125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[32m\u001b[K1127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      c. For each live block in each pool in the evacuation list,\r\n\u001b[32m\u001b[K1176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         allocate and copy into a non-evacuating pool.\r\n\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    2. Proceed through the roots and the heap, updating pointers to evacuated\r\n\u001b[32m\u001b[K1178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks to point to the new location of the block. Update finalisers and\r\n\u001b[32m\u001b[K1179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       ephemerons too.\r\n\u001b[32m\u001b[K1180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    3. Go through pools evacuated and release them. Finally free all but\r\n\u001b[32m\u001b[K1181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        one pool in the \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.\r\n\u001b[32m\u001b[K1182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    4. One domain needs to release the pools in the \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K back to the OS.\r\n\u001b[32m\u001b[K1183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    The algorithm requires one full pass through the whole heap (pools and large\r\n\u001b[32m\u001b[K1185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    allocations) to rewrite pointers, as well as two passes through the\r\n\u001b[32m\u001b[K1186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    partially-occupied pools in the heap to compute the number of live blocks\r\n\u001b[32m\u001b[K1187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    and evacuate them.\r\n\u001b[32m\u001b[K1188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  */\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->avail_pools[sz_class] == NULL);\r\n\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->full_pools[sz_class] == NULL);\r\n\u001b[32m\u001b[K1205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->swept_large == NULL);\r\n\u001b[32m\u001b[K1206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* No pools waiting for adoption */\r\n\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (participants[0] == Caml_state) {\r\n\u001b[32m\u001b[K1208\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_avail_pools[sz_class]) ==\r\n\u001b[32m\u001b[K1210\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            NULL);\r\n\u001b[32m\u001b[K1211\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          atomic_load_relaxed(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_full_pools[sz_class]) ==\r\n\u001b[32m\u001b[K1213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            NULL);\r\n\u001b[32m\u001b[K1214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* The minor heap is empty */\r\n\u001b[32m\u001b[K1216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(Caml_state->young_ptr == Caml_state->young_end);\r\n\u001b[32m\u001b[K1217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* The mark stack is empty */\r\n\u001b[32m\u001b[K1218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(caml_mark_stack_is_empty());\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      continue;\r\n\u001b[32m\u001b[K1254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /* Count the number of \u001b[01;31m\u001b[Kfree and live block\u001b[m\u001b[Ks in each pool. Note that a live\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       block here currently has the header status UNMARKED (because it was\r\n\u001b[32m\u001b[K1260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       MARKED in the previous cycle). After compaction the shared pools will\r\n"]
[271.041529, "o", "\u001b[32m\u001b[K1261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       contain UNMARKED and GARBAGE from the \"to\" pools and UNMARKED from the\r\n\u001b[32m\u001b[K1262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       \"from\" pools which were evacuated.\r\n\u001b[32m\u001b[K1263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       At the cost of some complexity or an additional pass we could compute the\r\n\u001b[32m\u001b[K1265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       exact amount of space needed or even sweep all pools in this counting\r\n\u001b[32m\u001b[K1266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       pass.\r\n\u001b[32m\u001b[K1267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    */\r\n\u001b[32m\u001b[K1268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int k = 0;\r\n\u001b[32m\u001b[K1269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int total_live_blocks = 0;\r\n\u001b[32m\u001b[K1270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int total_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks = 0;\r\n\u001b[32m\u001b[K1272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\n\u001b[32m\u001b[K1275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* end = POOL_END(cur_pool);\r\n\u001b[32m\u001b[K1276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[32m\u001b[K1277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      pool_stats[k].\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks = 0;\r\n\u001b[32m\u001b[K1279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].live_blocks = 0;\r\n\u001b[32m\u001b[K1280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[32m\u001b[K1282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t h = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (POOL_BLOCK_FREE_HD(h)) {\r\n\u001b[32m\u001b[K1285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* this tells us the number of spaces of size wh after this */\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          mlsize_t wosize = Wosize_hd(h);\r\n\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          pool_stats[k].\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks += wosize + 1;\r\n\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          total_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks += wosize + 1;\r\n\u001b[32m\u001b[K1291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* skip to the next block */\r\n\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          p += wh * wosize;\r\n\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else if (Has_status_hd(h, caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          total_live_blocks++;\r\n\u001b[32m\u001b[K1296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          pool_stats[k].live_blocks++;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      k++;\r\n\u001b[32m\u001b[K1303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Note that partially filled pools must have at least some free space*/\r\n\u001b[32m\u001b[K1306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1307\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(total_\u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks > 0);\r\n\u001b[32m\u001b[K1308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!total_live_blocks) {\r\n\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* No live (i.e unmarked) blocks in partially filled pools, nothing to do\r\n\u001b[32m\u001b[K1312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         for this size class */\r\n\u001b[32m\u001b[K1313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      continue;\r\n\u001b[32m\u001b[K1314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Now we use the pool stats to calculate which pools will be evacuated. We\r\n\u001b[32m\u001b[K1317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       want to walk through the pools and check whether we have enough free\r\n\u001b[32m\u001b[K1318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks in the pools behind us to accommodate all the remaining live\r\n\u001b[32m\u001b[K1319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks. */\r\n\u001b[32m\u001b[K1320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    int \u001b[01;31m\u001b[Kfree_block\u001b[m\u001b[Ks = 0;\r\n\u001b[32m\u001b[K1321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int j = 0;\r\n\u001b[32m\u001b[K1322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int remaining_live_blocks = total_live_blocks;\r\n\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = heap->"]
[271.041951, "o", "unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* [last_pool_p] will be a pointer to the next field of the last\r\n\u001b[32m\u001b[K1326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       non-evacuating pool. We need this so we can snip the list of evacuating\r\n\u001b[32m\u001b[K1327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       pools from [unswept_avail_pools] and eventually attach them all to\r\n\u001b[32m\u001b[K1328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       [evacuated_pools]. */\r\n\u001b[32m\u001b[K1329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool **last_pool_p = &heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1331\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[Kfree_blocks >= remaining_live_block\u001b[m\u001b[Ks) {\r\n\u001b[32m\u001b[K1332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        break;\r\n\u001b[32m\u001b[K1333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1335\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      \u001b[01;31m\u001b[Kfree_blocks += pool_stats[j].free_block\u001b[m\u001b[Ks;\r\n\u001b[32m\u001b[K1336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      remaining_live_blocks -= pool_stats[j].live_blocks;\r\n\u001b[32m\u001b[K1337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      last_pool_p = &cur_pool->next;\r\n\u001b[32m\u001b[K1338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      j++;\r\n\u001b[32m\u001b[K1340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (Has_status_hd(hd, caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* live block in an evacuating pool, so we evacuate it to\r\n\u001b[32m\u001b[K1369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K             * the first available block */\r\n\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            pool* to_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            value* new_p = to_pool->next_obj;\r\n\u001b[32m\u001b[K1372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            CAMLassert(POOL_BLOCK_FREE_HP(new_p));\r\n\u001b[32m\u001b[K1373\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            /* if there are \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[Ks after this, use those */\r\n\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = next_pool;\r\n\u001b[32m\u001b[K1515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1516\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1517\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_END(EV_COMPACT_RELEASE);\r\n\u001b[32m\u001b[K1518\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_global_barrier(participating_count);\r\n\u001b[32m\u001b[K1519\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1520\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* Fourth phase: one domain also needs to release the \u001b[01;31m\u001b[Kfree list\u001b[m\u001b[K */\r\n\u001b[32m\u001b[K1521\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( participants[0] == Caml_state ) {\r\n\u001b[32m\u001b[K1522\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* cur_pool;\r\n\u001b[32m\u001b[K1523\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* next_pool;\r\n\u001b[32m\u001b[K1524\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1525\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K1526\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    cur_pool = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free;\r\n\u001b[32m\u001b[K1527\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1528\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while( cur_pool ) {\r\n\u001b[32m\u001b[K1529\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      next_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1530\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* No stats to update so just unmap */\r\n\u001b[32m\u001b[K1531\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      caml_mem_unmap(cur_pool, Bsize_wsize(POOL_WSIZE));\r\n\u001b[32m\u001b[K1532\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = next_pool;\r\n\u001b[32m\u001b[K1533\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1534\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1535\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.free = NULL;\r\n\u001b[32m\u001b[K1536\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1537\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K1538\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1539\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* We are done, increment our compaction count */\r\n\u001b[32m\u001b[K1540\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    atomic_fetch_add(&caml_compactions_count, 1);\r\n\u001b["]
[271.042098, "o", "32m\u001b[K1541\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1542\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1543\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Compacting heap complete\");\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1579\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      );\r\n\u001b[32m\u001b[K1580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (!POOL_BLOCK_FREE_HD(hd)) {\r\n\u001b[32m\u001b[K1581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live += Whsize_hd(hd);\r\n\u001b[32m\u001b[K1582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->overhead += wh - Whsize_hd(hd);\r\n\u001b[32m\u001b[K1583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live_blocks++;\r\n\u001b[32m\u001b[K1584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1585\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        /* count the \u001b[01;31m\u001b[Kfree block\u001b[m\u001b[K and any that follow it (stored in the\r\n\u001b[32m\u001b[K1586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           size bits in the header)*/\r\n\u001b[32m\u001b[K1587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->free += wh * (1 + Wosize_hd(hd));\r\n\u001b[32m\u001b[K1588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += Wosize_hd(hd) * wh;\r\n\u001b[32m\u001b[K1589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[32m\u001b[K1591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1665\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->unswept_large = local->swept_large;\r\n\u001b[32m\u001b[K1666\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->swept_large = NULL;\r\n\u001b[32m\u001b[K1667\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1668\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_adopt_all_orphan_heaps(local);\r\n\u001b[32m\u001b[K1669\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1670\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1671\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid caml_finalise_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K(void) {\r\n\u001b[32m\u001b[K1672\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int freed_large = 0;\r\n\u001b[32m\u001b[K1673\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1674\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K1675\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  while (pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large) {\r\n\u001b[32m\u001b[K1676\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    large_alloc* a = pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large;\r\n\u001b[32m\u001b[K1677\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.global_large = a->next;\r\n\u001b[32m\u001b[K1678\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    free(a);\r\n\u001b[32m\u001b[K1679\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    freed_large++;\r\n\u001b[32m\u001b[K1680\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1681\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_plat_unlock(&pool_\u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K.lock);\r\n\u001b[32m\u001b[K1682\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_gc_log(\"Finalise \u001b[01;31m\u001b[Kfreelist\u001b[m\u001b[K. Freed %d large\", freed_large);\r\n\u001b[32m\u001b[K1683\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n"]
