                                     + Wosize_hd(hd) + 1);\r\nruntime/shared_heap.c:644:        p += wh * Wosize_hd(hd);\r\nruntime/shared_heap.c:736:      pool_sweep(local, &local->unswept_avail_pools[sz], sz, 1);\r\nruntime/shared_heap.c:740:      full_sweep_work = pool_sweep(local,\r\nruntime/shared_heap.c:787:        p += wh * Wosize_hd(hd);\r\nruntime/shared_heap.c:1000:    for (; i < Wosize_val(v); i++) {\r\nruntime/shared_heap.c:1100:      mlsize_t wosz = Wosize_hd(hd);\r\nruntime/shared_heap.c:1124:        p += wh * Wosize_hp(p);\r\nruntime/shared_heap.c:1143:    mlsize_t wosize = Wosize_val(ephe);\r\nruntime/shared_heap.c:1146:    for (int i = CAML_EPHE_FIRST_KEY ; i < wosize ; i++) {\r\nruntime/shared_heap.c:1286:          mlsize_t wosize = Wosize_hd(h);\r\nruntime/shared_heap.c:1288:          pool_stats[k].free_blocks += wosize + 1;\r\nruntime/shared_heap.c:1290:          total_free_blocks += wosize + 1;\r\nruntime/shared_heap.c:1293:          p += wh * wosize;\r\nruntime/shared_heap.c:1374:            mlsize_t wosize = Wosize_hp(new_p);\r\nruntime/shared_heap.c:1375:            if( wosize > 0 ) {\r\nruntime/shared_heap.c:1385:              *next = POOL_FREE_HEADER(wosize - 1);\r\nruntime/shared_heap.c:1434:          mlsize_t wosize = Wosize_hd(hd);\r\nruntime/shared_heap.c:1435:          p += wosize * wh;\r\nruntime/shared_heap.c:1468:  /* Next, one domain does the global roots */\r\nruntime/shared_heap.c:1587:        s->free += wh * (1 + Wosize_hd(hd));\r\nruntime/shared_heap.c:1588:        p += Wosize_hd(hd) * wh;\r\nruntime/shared_heap.c:1682:  caml_gc_log(\"Finalise freelist. Freed %d large\", freed_large);\r\nruntime/caml/config.h:194:#define Max_young_wosize 256\r\nruntime/caml/config.h:195:#define Max_young_whsize (Whsize_wosize (Max_young_wosize))\r\nruntime/caml/config.h:199:   This must be at least [Max_young_wosize + 1]. */\r\nruntime/caml/config.h:200:#define Minor_heap_min (Max_young_wosize + 1)\r\nruntime/caml/fiber.h:256:struct stack_info* caml_alloc_stack_noexc(mlsize_t wosize, value hval,\r\nruntime/caml/fiber.h:264:CAMLextern void caml_free_stack(struct stack_info* stk);\r\n"]
