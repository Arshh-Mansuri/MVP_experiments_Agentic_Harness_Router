[314.402893, "i", "cd /app/ocaml\npython3 - <<'PY'\np='runtime/shared_heap.c'\ns=open(p).read()\nold='''          /* add the free blocks following this block, skipping over them */\n          p += wh * Wosize_hd(hd);\n        } else {'''\nnew='''          /* Skip the rest of this compressed free run.  The wosize in\n             a free header is the number of additional free blocks in the\n             run, so include the current block as well. */\n          p += wh * (Wosize_hd(hd) + 1);\n        } else {'''\nif old not in s:\n    raise SystemExit('free-run block not found')\ns=s.replace(old,new,1)\nold2='''        p += Whsize_hd(hd);\n      } while (p + wh <= end);'''\nnew2='''        if (!POOL_BLOCK_FREE_HD(hd))\n          p += Whsize_hd(hd);\n      } while (p + wh <= end);'''\nif old2 not in s:\n    raise SystemExit('common cursor increment not found')\ns=s.replace(old2,new2,1)\nopen(p,'w').write(s)\nPY\nsed -n '638,658p' runtime/shared_heap.c\n"]
