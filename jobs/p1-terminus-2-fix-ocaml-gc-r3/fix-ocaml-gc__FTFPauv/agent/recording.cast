K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1079\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     bug in traversing the shared pools). */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1080\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1081\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1082\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  tag_t tag = Tag_hd(hd);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1083\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1084"]
[581.347963, "o", "\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* We should never encounter an Infix tag iterating over the shared pools or\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1085\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large allocations. We could find it in roots but those use\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1086\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    [compact_update_value]. */\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1087\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(tag != Infix_tag);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1088\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void compact_update_pools(pool *cur_pool)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (cur_pool) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K1116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(cur_pool);\r\n\u001b[35m\u001