[605.315464, "i", "cat > /tmp/scanphase.py <<'PY'\nimport subprocess\nfor ns,np in ((2,4),(3,3),(4,2),(4,3),(5,2)):\n  f=f'/tmp/sp_{ns}_{np}.red'\n  x=[';redcode-94',f';name Phase Scanner {ns} {np}',';assert CORESIZE == 8000','start spl s1']\n  # balanced process tree\n  labels=[f's{i}' for i in range(1,ns+1)]+[f'p{i}' for i in range(1,np+1)]\n  for lab in labels[1:]: x.append(' spl '+lab)\n  x.append(' jmp '+labels[-1])\n  for i in range(ns):\n    st=(7,17,31,13,23)[i]\n    x += [f's{i+1} mov bomb, @q{i+1}',f' add #{st}, q{i+1}',f' sne bomb, @q{i+1}',f' jmp s{i+1}',f' mov bomb, @q{i+1}',f' jmp s{i+1}']\n  for i in range(np):\n    k=i+1\n    x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n  x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]\n  x += [f'q{i+1} dat {i*997}, {i*997}' for i in range(ns)]+['bomb dat #0, #0','end start']\n  open(f,'w').write('\\n'.join(x)+'\\n')\n  vals=[]\n  for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n    z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n    vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n  print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/scanphase.py\n"]
[605.316578, "o", "cat > /tmp/scanphase.py <<'PY'\r\n\u001b[?2004l\r"]
