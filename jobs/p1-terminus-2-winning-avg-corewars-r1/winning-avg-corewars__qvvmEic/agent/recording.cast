[371.698945, "i", "cat > /tmp/bombpaper.py <<'PY'\nimport subprocess, os\nfor st in (2667,1999,1333,997):\n  for n in (2,3,4,5):\n    f=f'/tmp/bp_{st}_{n}.red'\n    x=[';redcode-94',f';name Bomb Paper {st} {n}',';assert CORESIZE == 8000','start spl p1']\n    for i in range(2,n): x += [f' spl p{i}']\n    x += [f' jmp p{n}']\n    for i in range(1,n+1):\n      x += [f'p{i} mov payload, *a{i}',f' add #1, a{i}',f' mov payload, @a{i}',f' add #{st}, a{i}',f' jmp p{i}']\n    x += ['payload spl 0, 0',' dat #0, #0']+[f'a{i} dat {st}, {st*2}' for i in range(1,n+1)]+['end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','50','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(os.path.basename(f), ' | '.join(vals), flush=True)\nPY\npython3 /tmp/bombpaper.py | tee /tmp/bombpaper.out\n"]
[371.701083, "o", "cat > /tmp/bombpaper.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess, os\r\n\u001b[?2004l\r\u001b[?2004h> for st in (2667,1999,1333,997):\r\n\u001b[?2004l\r\u001b[?2004h> "]
