[136.446115, "o", " jmp p2\r\n\u001b[?2004l\r\u001b[?2004h> p3 mov copy, *c\r\n\u001b[?2004l\r\u001b[?2004h>  add #1, c\r\n\u001b[?2004l\r\u001b[?2004h>  mov copy, @c\r\n"]
