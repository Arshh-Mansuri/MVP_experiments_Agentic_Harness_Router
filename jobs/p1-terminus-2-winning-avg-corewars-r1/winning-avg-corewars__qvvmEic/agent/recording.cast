[101.058532, "o", "\u001b[?2004h>  mov copy, @b\r\n\u001b[?2004l\r\u001b[?2004h>  add #2667, b\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p2\r\n\u001b[?2004l\r\u001b[?2004h> p3 mov copy, *c\r\n\u001b[?2004l\r\u001b[?2004h>  add #1, c\r\n\u001b[?2004l\r\u001b[?2004h>  mov copy, @c\r\n\u001b[?2004l\r\u001b[?2004h>  add #2667, c\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p3\r\n\u001b[?2004l\r\u001b[?2004h> copy spl 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> a dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> b dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> c dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> s8 add #8, x8\r\n\u001b[?2004l\r\u001b[?2004h> scan8 sne 0, @x8\r\n\u001b[?2004l\r\u001b[?2004h>  mov bomb, @x8\r\n\u001b[?2004l\r\u001b[?2004h>  jmp s8\r\n\u001b[?2004l\r\u001b[?2004h> s13 add #13, x13\r\n\u001b[?2004l\r\u001b[?2004h> scan13 sne 0, @x13\r\n\u001b[?2004l\r\u001b[?2004h>  mov bomb, @x13\r\n\u001b[?2004l\r\u001b[?2004h>  jmp s13\r\n\u001b[?2004l\r\u001b[?2004h> x8 dat 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> x13 dat 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> bomb dat #0, #0\r\n\u001b[?2004l\r\u001b[?2004h> end start\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[101.075735, "o", "\u001b[?2004hroot@a585ef15f2dc:/app# cat > /tmp/mix3.red <<'EOF'\r\n\u001b[?2004l\r"]
