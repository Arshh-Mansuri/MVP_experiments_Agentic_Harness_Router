[1079.836935, "i", "cat > /tmp/impbalance.py <<'PY'\nimport subprocess\nfor nc,np,ni in ((2,2,1),(2,2,2),(2,3,1),(2,3,2),(3,2,1),(3,3,1)):\n for step in (1,2,4):\n  for order in ('clearfirst','paperfirst','impfirst'):\n   cs=[f'c{i}' for i in range(1,nc+1)]; ps=[f'p{i}' for i in range(1,np+1)]; ins=[f'i{i}' for i in range(1,ni+1)]\n   groups={'clearfirst':cs+ps+ins,'paperfirst':ps+cs+ins,'impfirst':ins+cs+ps}\n   labs=groups[order]; f=f'/tmp/ib_{nc}_{np}_{ni}_{step}_{order}.red'\n   x=[';redcode-94',f';name Imp Balance {nc} {np} {ni}',';assert CORESIZE == 8000','start '+labs[0]]\n   for lab in labs[1:]: x += [' spl '+lab]\n   x += [' jmp '+labs[-1]]\n   for j in range(nc): x += [f'c{j+1} mov bomb, >cp{j+1}',f' add #{step}, cp{j+1}',f' jmp c{j+1}']\n   for j in range(np):\n    k=j+1; x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n   for j in range(ni): x += [f'i{j+1} mov imp, {2667*(j+1)}',f' jmp i{j+1}']\n   x += ['copy spl 0, 0']+[f'a{j+1} dat 2667, 5334' for j in range(np)]+[f'cp{j+1} dat {j*997}, {j*997}' for j in range(nc)]+['imp mov 0, 2667','bomb dat #0, #0','end start']\n   open(f,'w').write('\\n'.join(x)+'\\n'); vals=[]\n   for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n    z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n    vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n   print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/impbalance.py > /tmp/impbalance.out\npython3 - <<'PY'\nimport re\nfor line in open('/tmp/impbalance.out'):\n p=line.strip().split(' | ')\n if len(p)!=5: continue\n a=[[int(x) for x in re.findall(r'\\d+',q)[-3:]] for q in p]; w=[v[0] for v in a]\n if w[0]>=33 and w[1]>=75 and w[2]>=33 and w[3]>=75 and w[4]>=75: print('QUALIFY',line.strip())\nPY\n"]
