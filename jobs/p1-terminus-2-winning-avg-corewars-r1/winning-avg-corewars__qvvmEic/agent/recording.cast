[1148.925386, "i", "cat > /tmp/randomsearch.py <<'PY'\nimport random, subprocess, os, re\nrandom.seed(41); os.makedirs('/tmp/rand',exist_ok=True)\nops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']\ndef make(fn):\n  nc=random.randint(1,8); np=random.randint(1,5); ns=random.randint(0,3); ni=random.randint(0,2)\n  mods=[('c',i) for i in range(nc)]+[('p',i) for i in range(np)]+[('s',i) for i in range(ns)]+[('i',i) for i in range(ni)]\n  random.shuffle(mods); labs=[f'{a}{i}' for a,i in mods]\n  x=[';redcode-94',';name Random Module Warrior',';assert CORESIZE == 8000','start '+labs[0]]\n  for lab in labs[1:]: x += [' spl '+lab]\n  x += [' jmp '+labs[-1]]\n  step=random.choice([1,2,4,7,8,13,17])\n  for a,i in mods:\n    if a=='c': x += [f'c{i} mov bomb, >cp{i}',f' add #{step}, cp{i}',f' jmp c{i}']\n    elif a=='p': x += [f'p{i} mov copy, *a{i}',f' add #1, a{i}',f' mov copy, @a{i}',f' add #2667, a{i}',f' jmp p{i}']\n    elif a=='s':\n      st=random.choice([4,7,13,17,31]); x += [f's{i} mov bomb, @sp{i}',f' add #{st}, sp{i}',f' sne bomb, @sp{i}',f' jmp s{i}',f' mov bomb, @sp{i}',f' jmp s{i}']\n    else: x += [f'i{i} mov imp, {2667*(i+1)}',f' jmp i{i}']\n  x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for a,j in mods if a=='p']+[f'cp{i} dat {random.randrange(8000)}, 0' for a,i in mods if a=='c']+[f'sp{i} dat {random.randrange(8000)}, 0' for a,i in mods if a=='s']+['imp mov 0, 2667','bomb dat #0, #0','end start']\n  open(fn,'w').write('\\n'.join(x)+'\\n')\nfor k in range(180):\n f=f'/tmp/rand/r{k}.red'; make(f); vals=[]\n for o in ops:\n  z=subprocess.run(['pmars','-b','-r','20','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n  q=next((q for q in z.splitlines() if q.startswith('Results:')),'Results: 0 20 0'); vals.append(int(q.split()[1]))\n print(sum(vals),min(vals),f,flush=True)\nPY\npython3 /tmp/randomsearch.py > /tmp/randomsearch.out\nsort -nr /tmp/randomsearch.out | head -20\n"]
