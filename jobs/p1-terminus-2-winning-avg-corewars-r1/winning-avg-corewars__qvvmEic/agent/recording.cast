[101.01103, "i", "cat > /tmp/mix1.red <<'EOF'\n;redcode-94\n;name Mixed Paper Scanner\n;assert CORESIZE == 8000\nstart spl s8\n spl s13\n spl p1\n jmp p2\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\ns8 add #8, x8\nscan8 sne 0, @x8\n mov bomb, @x8\n jmp s8\ns13 add #13, x13\nscan13 sne 0, @x13\n mov bomb, @x13\n jmp s13\nx8 dat 0, 0\nx13 dat 0, 0\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/mix2.red <<'EOF'\n;redcode-94\n;name Mixed Triple Scanner\n;assert CORESIZE == 8000\nstart spl s8\n spl s13\n spl p1\n spl p2\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\ns8 add #8, x8\nscan8 sne 0, @x8\n mov bomb, @x8\n jmp s8\ns13 add #13, x13\nscan13 sne 0, @x13\n mov bomb, @x13\n jmp s13\nx8 dat 0, 0\nx13 dat 0, 0\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/mix3.red <<'EOF'\n;redcode-94\n;name Scanner Paper Scanner\n;assert CORESIZE == 8000\nstart spl s13\n spl p1\n spl s8\n jmp p2\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\ns8 add #8, x8\nscan8 sne 0, @x8\n mov bomb, @x8\n jmp s8\ns13 add #13, x13\nscan13 sne 0, @x13\n mov bomb, @x13\n jmp s13\nx8 dat 0, 0\nx13 dat 0, 0\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/mix1.red /tmp/mix2.red /tmp/mix3.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
