[761.293135, "i", "cat > /tmp/fastclear.py <<'PY'\nimport subprocess\nfor typ in ('plain','djn','djnf'):\n for nc in (2,3,4,5,6):\n  for np in (0,1,2,3):\n   for step in (1,2,4,7):\n    for order in ('clearfirst','paperfirst'):\n     f=f'/tmp/fc_{typ}_{nc}_{np}_{step}_{order}.red'\n     cs=[f'c{i}' for i in range(1,nc+1)]; ps=[f'p{i}' for i in range(1,np+1)]\n     labs=(cs+ps) if order=='clearfirst' else (ps+cs)\n     if not labs: continue\n     x=[';redcode-94',f';name Fast Clear {typ} {nc} {np}',';assert CORESIZE == 8000','start '+labs[0]]\n     for lab in labs[1:]: x += [' spl '+lab]\n     x += [' jmp '+labs[-1]]\n     for i in range(nc):\n      if typ=='plain': x += [f'c{i+1} mov bomb, >ptr{i+1}',f' add #{step}, ptr{i+1}',f' jmp c{i+1}']\n      elif typ=='djn': x += [f'c{i+1} mov bomb, >ptr{i+1}',f' djn c{i+1}, cnt{i+1}']\n      else: x += [f'c{i+1} mov bomb, >ptr{i+1}',f' djn.f c{i+1}, cnt{i+1}']\n     for i in range(np):\n      k=i+1; x += [f'p{k} mov copy, *a{k}',' add #1, a'+str(k),' mov copy, @a'+str(k),' add #2667, a'+str(k),f' jmp p{k}']\n     x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]\n     x += [f'ptr{i+1} dat {i*997}, {i*997}' for i in range(nc)]\n     if typ!='plain': x += [f'cnt{i+1} dat 2000, 2000' for i in range(nc)]\n     x += ['bomb dat #0, #0','end start']\n     open(f,'w').write('\\n'.join(x)+'\\n')\n     vals=[]\n     for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n     print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/fastclear.py > /tmp/fastclear.out\npython3 - <<'PY'\nimport re\nrows=open('/tmp/fastclear.out').read().splitlines()\ndef nums(s):\n m=re.findall(r'Results: (\\d+) (\\d+) (\\d+)',s)\n return list(map(int,m[0])) if m else [0,0,0]\n# columns are G2,paper,snake,stone,vamp; print candidates passing 33/75/33/75/75 wins\nfor r in rows:\n parts=r.split(' | ')\n a=[nums(p) for p in parts]\n wins=[v[0] for v in a]\n if wins[0]>=33 and wins[1]>=75 and wins[2]>=33 and wins[3]>=75 and wins[4]>=75: print('QUALIFY',r)\nprint('best G2:')\nfor r in sorted(rows,key=lambda z: nums(z.split(' | ')[0])[0],reverse=True)[:20]: print(r)\nPY\n"]
