[265.497309, "i", "cat > /tmp/focused.py <<'PY'\nimport subprocess, os\nos.makedirs('/tmp/focused',exist_ok=True)\nsteps=[2667,1999,1601,1333,997,1143,4001,2701]\nfor st in steps:\n  for n in range(3,9):\n    f=f'/tmp/focused/q{st}_{n}.red'; x=[';redcode-94',f';name Focused Paper {st} {n}',';assert CORESIZE == 8000','start spl p1']\n    for i in range(2,n): x += [f' spl p{i}']\n    x += [f' jmp p{n}']\n    for i in range(1,n+1):\n      x += [f'p{i} mov copy, *a{i}',f' add #1, a{i}',' mov copy, @a'+str(i),f' add #{st}, a{i}',f' jmp p{i}']\n    x += ['copy spl 0, 0']+[f'a{i} dat {st}, {st*2}' for i in range(1,n+1)]+['end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','snake.red','vampire.red','stone.red']:\n      z=subprocess.run(['pmars','-b','-r','30','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(os.path.basename(f), ' | '.join(vals), flush=True)\nPY\npython3 /tmp/focused.py | tee /tmp/focused.out\n"]
