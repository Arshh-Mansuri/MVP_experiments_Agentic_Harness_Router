[1194.528835, "i", "python3 - <<'PY'\nimport subprocess,re,glob\nops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']\nrows=[]\nfor f in glob.glob('/tmp/rand/*.red'):\n    wins=[]\n    for o in ops:\n        z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n        q=next((x for x in z.splitlines() if x.startswith('Results:')),None)\n        if q: wins.append(int(q.split()[1]))\n    if len(wins)==5: rows.append((min(wins),sum(wins),f,wins))\nfor r in sorted(rows,reverse=True)[:20]: print(r)\nPY\n"]
