[1186.553846, "i", "python3 - <<'PY'\nimport subprocess,re,glob\nops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']\nrows=[]\nfor f in glob.glob('/tmp/rand/*.red'):\n    wins=[]; ok=True\n    for o in ops:\n        z=subprocess.run(['pmars','-b','-r','20','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n        q=next((x for x in z.splitlines() if x.startswith('Results:')),None)\n        if not q: ok=False; break\n        wins.append(int(q.split()[1]))\n    if ok: rows.append((min(wins),sum(wins),f,wins))\nfor r in sorted(rows,reverse=True)[:30]: print(r)\nPY\n"]
