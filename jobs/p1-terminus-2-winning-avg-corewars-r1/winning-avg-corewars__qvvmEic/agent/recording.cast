[706.318932, "i", "cat > /tmp/clearpaper.py <<'PY'\nimport subprocess\nfor nc in (2,3,4):\n  for np in (1,2,3,4):\n    for step in (1,4,8):\n      f=f'/tmp/cp_{nc}_{np}_{step}.red'\n      labs=[f'c{i}' for i in range(1,nc+1)]+[f'p{i}' for i in range(1,np+1)]\n      x=[';redcode-94',f';name Clear Paper {nc} {np} {step}',';assert CORESIZE == 8000','start '+labs[0]]\n      # Start one process, split into all remaining processes.\n      for lab in labs[1:]: x += [' spl '+lab]\n      x += [' jmp '+labs[-1]]\n      for i in range(nc):\n        x += [f'c{i+1} mov bomb, >cp{i+1}',f' add #{step}, cp{i+1}',f' jmp c{i+1}']\n      for i in range(np):\n        k=i+1\n        x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n      x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]\n      x += [f'cp{i+1} dat {i*997}, {i*997}' for i in range(nc)]+['bomb dat #0, #0','end start']\n      open(f,'w').write('\\n'.join(x)+'\\n')\n      vals=[]\n      for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n        z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n        vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n      print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/clearpaper.py | tee /tmp/clearpaper.out\n"]
[706.320218, "o", "cat > /tmp/clearpaper.py <<'PY'\r\n\u001b[?2004l\r"]
[706.320347, "o", "\u001b[?2004h"]
