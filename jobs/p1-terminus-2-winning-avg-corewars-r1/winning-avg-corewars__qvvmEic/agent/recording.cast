[1257.291328, "i", "cat > /tmp/remoteclear.py <<'PY'\nimport subprocess\nfor nc in (2,3,4):\n for np in (2,3,4,5):\n  for step in (1,2,4):\n   for base in (1000,2000,3000,5000,7000):\n    f=f'/tmp/rc_{nc}_{np}_{step}_{base}.red'\n    cs=[f'c{i}' for i in range(nc)]; ps=[f'p{i}' for i in range(np)]; labs=cs+ps\n    x=[';redcode-94',f';name Remote Clear {nc} {np} {step} {base}',';assert CORESIZE == 8000','start '+labs[0]]\n    for lab in labs[1:]: x += [' spl '+lab]\n    x += [' jmp '+labs[-1]]\n    for i in range(nc): x += [f'c{i} mov bomb, >cp{i}',f' add #{step}, cp{i}',f' jmp c{i}']\n    for i in range(np):\n     k=i; x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n    x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(np)]+[f'cp{i} dat {base+i*997}, {base+i*997}' for i in range(nc)]+['bomb dat #0, #0','end start']\n    open(f,'w').write('\\n'.join(x)+'\\n'); vals=[]\n    for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n     z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n     vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    w=[int(v.split()[0]) for v in vals]\n    print(f,' | '.join(vals),flush=True)\n    if w[0]>=33 and w[1]>=75 and w[2]>=33 and w[3]>=75 and w[4]>=75:\n     print('QUALIFY',f,flush=True); raise SystemExit\nPY\npython3 /tmp/remoteclear.py > /tmp/remoteclear.out\ntail -30 /tmp/remoteclear.out\n"]
[1257.29311, "o", "cat > /tmp/remoteclear.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> for nc in (2,3,4):\r\n\u001b[?2004l\r\u001b[?2004h>  for np in (2,3,4,5):\r\n\u001b[?2004l\r\u001b[?2004h>   for step in (1,2,4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
