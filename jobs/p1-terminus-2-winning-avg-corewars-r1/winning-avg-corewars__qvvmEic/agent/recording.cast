[1034.516322, "o", "echo '--- closest G2 candidate ---'; cat /tmp/fcp_8_1_2.red; echo '--- current warrior ---'; head -20 my_warrior.red\r\n\u001b[?2004l\r--- closest G2 candidate ---\r\n"]
[1034.544046, "o", ";redcode-94\r\n;name Focus Clear Paper 8 1 2\r\n;assert CORESIZE == 8000\r\nstart c1\r\n spl c2\r\n spl c3\r\n spl c4\r\n spl c5\r\n spl c6\r\n spl c7\r\n spl c8\r\n spl p1\r\n jmp p1\r\nc1 mov bomb, >cp1\r\n add #2, cp1\r\n jmp c1\r\nc2 mov bomb, >cp2\r\n add #2, cp2\r\n jmp c2\r\nc3 mov bomb, >cp3\r\n add #2, cp3\r\n jmp c3\r\nc4 mov bomb, >cp4\r\n add #2, cp4\r\n jmp c4\r\nc5 mov bomb, >cp5\r\n add #2, cp5\r\n jmp c5\r\nc6 mov bomb, >cp6\r\n add #2, cp6\r\n jmp c6\r\nc7 mov bomb, >cp7\r\n add #2, cp7\r\n jmp c7\r\nc8 mov bomb, >cp8\r\n add #2, cp8\r\n jmp c8\r\np1 mov copy, *a1\r\n add #1, a1\r\n mov copy, @a1\r\n add #2667, a1\r\n jmp p1\r\ncopy spl 0, 0\r\na1 dat 2667, 5334\r\ncp1 dat 0, 0\r\ncp2 dat 997, 997\r\ncp3 dat 1994, 1994\r\ncp4 dat 2991, 2991\r\ncp5 dat 3988, 3988\r\ncp6 dat 4985, 4985\r\ncp7 dat 5982, 5982\r\ncp8 dat 6979, 6979\r\nbomb dat #0, #0\r\nend start\r\n"]
[1034.545749, "o", "--- current warrior ---\r\n"]
[1034.562802, "o", ";strategy Canonical stride-7 scanner with three independent paper processes\r\n;redcode-94\r\n;name Canonical Scanner Paper 7 3\r\n;assert CORESIZE == 8000\r\nstart spl scan\r\n spl p1\r\n spl p2\r\n jmp p3\r\nscan mov bomb, @ptr\r\n add #7, ptr\r\n sne bomb, @ptr\r\n jmp scan\r\n mov bomb, @ptr\r\n jmp scan\r\nptr dat 0, 0\r\np1 mov copy, *a1\r\n add #1, a1\r\n mov copy, @a1\r\n add #2667, a1\r\n jmp p1\r\n"]
[1034.564178, "o", "\u001b[?2004hroot@a585ef15f2dc:/app# "]
[1035.021385, "i", "cat > /tmp/lastmix.py <<'PY'\nimport subprocess\n# Eight clear processes, then one to four paper processes. Try both compact and delayed\n# paper payload placement so the clear processes do not immediately erase all paper state.\nfor np in (1,2,3,4):\n for step in (1,2,4):\n  for mode in ('clearfirst','paperfirst'):\n   f=f'/tmp/lm_{np}_{step}_{mode}.red'\n   cs=[f'c{i}' for i in range(1,9)]; ps=[f'p{i}' for i in range(1,np+1)]\n   labs=(cs+ps) if mode=='clearfirst' else (ps+cs)\n   x=[';redcode-94',f';name Last Mix {np} {step} {mode}',';assert CORESIZE == 8000','start '+labs[0]]\n   for lab in labs[1:]: x += [' spl '+lab]\n   x += [' jmp '+labs[-1]]\n   for i in range(8): x += [f'c{i+1} mov bomb, >cp{i+1}',f' add #{step}, cp{i+1}',f' jmp c{i+1}']\n   for i in range(np):\n    k=i+1\n    x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n   x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]+[f'cp{i+1} dat {i*997}, {i*997}' for i in range(8)]+['bomb dat #0, #0','end start']\n   open(f,'w').write('\\n'.join(x)+'\\n')\n   vals=[]\n   for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n    z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n    vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n   print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/lastmix.py > /tmp/lastmix.out\ncat /tmp/lastmix.out\n"]
[1035.021762, "o", "cat > /tmp/lastmix.py <<'PY'\r\n\u001b[?2004l\r"]
[1035.022099, "o", "\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> "]
