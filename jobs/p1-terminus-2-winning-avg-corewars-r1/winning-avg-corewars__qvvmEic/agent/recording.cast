[83.604071, "i", "cat > /tmp/h3a.red <<'EOF'\n;redcode-94\n;name Triple Paper Scanner A\n;assert CORESIZE == 8000\nstep equ 8\nstart spl scanner\n spl p1\n spl p2\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nscanner add #step, ptr\nscan sne 0, @ptr\n mov bomb, @ptr\n jmp scanner\nptr dat 0, 0\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/h3b.red <<'EOF'\n;redcode-94\n;name Triple Paper Scanner B\n;assert CORESIZE == 8000\nstep equ 4\nstart spl scanner1\n spl scanner2\n spl p1\n spl p2\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nscanner1 add #step, ptr1\nscan1 sne 0, @ptr1\n mov bomb, @ptr1\n jmp scanner1\nscanner2 add #step, ptr2\nscan2 sne 0, @ptr2\n mov bomb, @ptr2\n jmp scanner2\nptr1 dat 0, 0\nptr2 dat 0, 0\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/h3c.red <<'EOF'\n;redcode-94\n;name Triple Paper Scanner C\n;assert CORESIZE == 8000\nstep equ 13\nstart spl scanner1\n spl scanner2\n spl 1\n spl p1\n jmp p2\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nscanner1 add #step, ptr1\nscan1 sne 0, @ptr1\n mov bomb, @ptr1\n jmp scanner1\nscanner2 add #step, ptr2\nscan2 sne 0, @ptr2\n mov bomb, @ptr2\n jmp scanner2\nptr1 dat 0, 0\nptr2 dat 0, 0\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/h3a.red /tmp/h3b.red /tmp/h3c.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
