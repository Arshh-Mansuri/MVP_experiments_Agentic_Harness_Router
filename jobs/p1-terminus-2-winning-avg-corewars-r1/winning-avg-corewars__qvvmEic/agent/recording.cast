[119.062107, "i", "cat > /tmp/paper4.red <<'EOF'\n;redcode-94\n;name Quad Paper\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl p3\n jmp p4\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\np4 mov copy, *d\n add #1, d\n mov copy, @d\n add #2667, d\n jmp p4\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nd dat 2667, 5334\nend start\nEOF\ncat > /tmp/paper5.red <<'EOF'\n;redcode-94\n;name Penta Paper\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl p3\n spl p4\n jmp p5\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\np4 mov copy, *d\n add #1, d\n mov copy, @d\n add #2667, d\n jmp p4\np5 mov copy, *e\n add #1, e\n mov copy, @e\n add #2667, e\n jmp p5\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nd dat 2667, 5334\ne dat 2667, 5334\nend start\nEOF\ncat > /tmp/paperimp.red <<'EOF'\n;redcode-94\n;name Paper Imp\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl imp\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nimp mov 0, 2667\nend start\nEOF\ncat > /tmp/paperimp2.red <<'EOF'\n;redcode-94\n;name Paper Imp Ring\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl imp1\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nimp1 spl 1\n spl 1\n jmp imp, 2667\n jmp imp, 5334\nimp mov 0, 2667\nend start\nEOF\nfor w in /tmp/paper4.red /tmp/paper5.red /tmp/paperimp.red /tmp/paperimp2.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
