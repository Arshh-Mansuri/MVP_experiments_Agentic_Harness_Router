[662.214871, "i", "cat > /tmp/g2sig.py <<'PY'\nimport subprocess\nsigs={\n 'mov': 'mov *bptr, >gate',\n 'djn': 'djn.f clear, }bomb',\n 'ptr': 'dat bomb, 9',\n 'bomb': 'spl #2700, 11',\n}\nfor name,sig in sigs.items():\n  for step in (1,4,7):\n    f=f'/tmp/g2sig_{name}_{step}.red'\n    x=[';redcode-94',f';name G2 {name} {step}',';assert CORESIZE == 8000','start scan','scan add #'+str(step)+', ptr',' sne target, @ptr',' mov bomb, @ptr',' jmp scan','ptr dat 0, 0','target '+sig,'bomb dat #0, #0','bptr dat 0, 0','gate dat 0, 0','clear dat 0, 0','end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(name,step,' | '.join(vals),flush=True)\nPY\npython3 /tmp/g2sig.py\n"]
