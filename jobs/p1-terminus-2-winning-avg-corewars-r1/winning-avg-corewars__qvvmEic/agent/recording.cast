[296.910583, "i", "cat > /tmp/dp4a.red <<'EOF'\n;redcode-94\n;name Direct Split Quad Paper\n;assert CORESIZE == 8000\nstart spl attack\n spl p1\n spl p2\n jmp p3\nattack spl attack1\n spl attack2\n jmp attack3\nattack1 mov bomb, 4000\n jmp attack1\nattack2 mov bomb, 3999\n jmp attack2\nattack3 mov bomb, 4001\n jmp attack3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/dp4b.red <<'EOF'\n;redcode-94\n;name Quad Paper Direct Split\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl attack\n jmp p3\nattack spl attack1\n spl attack2\n jmp attack3\nattack1 mov bomb, 4000\n jmp attack1\nattack2 mov bomb, 3999\n jmp attack2\nattack3 mov bomb, 4001\n jmp attack3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/dp4c.red <<'EOF'\n;redcode-94\n;name Direct Split Quad Wide\n;assert CORESIZE == 8000\nstart spl attack\n spl p1\n spl p2\n jmp p3\nattack spl attack1\n spl attack2\n jmp attack3\nattack1 mov bomb, 3990\n jmp attack1\nattack2 mov bomb, 4000\n jmp attack2\nattack3 mov bomb, 4010\n jmp attack3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/dp4a.red /tmp/dp4b.red /tmp/dp4c.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
