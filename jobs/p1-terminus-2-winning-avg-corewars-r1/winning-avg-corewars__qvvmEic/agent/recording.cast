[548.903071, "i", "cat > /tmp/finalmix.py <<'PY'\nimport subprocess\nvariants=[]\nfor step in (7,17):\n  for n in (3,4,5):\n    f=f'/tmp/fmix_{step}_{n}.red'\n    x=[';redcode-94',f';name Final Mix {step} {n}',';assert CORESIZE == 8000','start spl scan']\n    for i in range(1,n): x += [f' spl p{i}']\n    x += [f' jmp p{n}']\n    x += ['scan mov bomb, @ptr',f' add #{step}, ptr',' sne bomb, @ptr',' jmp scan',' mov bomb, @ptr',' jmp scan','ptr dat 0, 0']\n    for i in range(1,n+1):\n      x += [f'p{i} mov copy, *a{i}',' add #1, a'+str(i),' mov copy, @a'+str(i),f' add #2667, a{i}',f' jmp p{i}']\n    x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(1,n+1)]+['bomb dat #0, #0','end start']\n    open(f,'w').write('\\n'.join(x)+'\\n'); variants.append(f)\nfor f in variants:\n  print('===',f)\n  for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n    z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n    print(o,next((q for q in z.splitlines() if q.startswith('Results:')),'ERR'))\nPY\npython3 /tmp/finalmix.py\n"]
