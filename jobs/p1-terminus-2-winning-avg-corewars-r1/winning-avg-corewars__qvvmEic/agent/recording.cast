[202.414494, "i", "cat > /tmp/target1.red <<'EOF'\n;redcode-94\n;name Targeted Hunter Paper\n;assert CORESIZE == 8000\nstart spl hg2\n spl hstone\n spl hpaper\n jmp hvamp\nhg2 add #1, pg2\n seq sg2, *pg2\n mov bomb, *pg2\n jmp hg2\nhstone add #1, pst\n seq sstone, *pst\n mov bomb, *pst\n jmp hstone\nhpaper add #1, ppa\n seq spaper, *ppa\n mov bomb, *ppa\n jmp hpaper\nhvamp add #1, pva\n seq svamp, *pva\n mov bomb, *pva\n jmp hvamp\nsg2 spl #2700, 11\nsstone add #4, 3\nspaper mov copy, *ptr\nsvamp mov ptr, @ptr\npg2 dat 0, 0\npst dat 0, 0\nppa dat 0, 0\npva dat 0, 0\nbomb dat #0, #0\npaper spl 1\nloop mov copy, *ptr\n add #1, ptr\n mov copy, @ptr\n add #2667, ptr\n jmp loop\ncopy spl 0, 0\nptr dat 2667, 5334\nend start\nEOF\ncat > /tmp/target2.red <<'EOF'\n;redcode-94\n;name Targeted Hunter Quad Paper\n;assert CORESIZE == 8000\nstart spl hg2\n spl hstone\n spl hpaper\n jmp p1\nhg2 add #1, pg2\n seq sg2, *pg2\n mov bomb, *pg2\n jmp hg2\nhstone add #1, pst\n seq sstone, *pst\n mov bomb, *pst\n jmp hstone\nhpaper add #1, ppa\n seq spaper, *ppa\n mov bomb, *ppa\n jmp hpaper\np1 spl p2\n spl p3\n jmp p4\np2 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p2\np3 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p3\np4 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p4\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nsg2 spl #2700, 11\nsstone add #4, 3\nspaper mov copy, *ptr\npg2 dat 0, 0\npst dat 0, 0\nppa dat 0, 0\nptr dat 2667, 5334\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/target1.red /tmp/target2.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
