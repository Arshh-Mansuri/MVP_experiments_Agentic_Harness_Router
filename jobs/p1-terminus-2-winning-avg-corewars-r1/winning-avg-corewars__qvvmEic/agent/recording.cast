[1035.022521, "o", "for np in (1,2,3,4):\r\n\u001b[?2004l\r\u001b[?2004h>  for step in (1,2,4):\r\n\u001b[?2004l\r"]
[1035.022711, "o", "\u001b[?2004h>   for mode in ('clearfirst','paperfirst'):\r\n\u001b[?2004l\r\u001b[?2004h>    f=f'/tmp/lm_{np}_{step}_{mode}.red'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1035.02283, "o", "   cs=[f'c{i}' for i in range(1,9)]; ps=[f'p{i}' for i in range(1,np+1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1035.022949, "o", "   labs=(cs+ps) if mode=='clearfirst' else (ps+cs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1035.023135, "o", "   x=[';redcode-94',f';name Last Mix {np} {step} {mode}',';assert CORESIZE == 8000','start '+labs[0]]\r\n\u001b[?2004l\r\u001b[?2004h>    for lab in labs[1:]: x += [' spl '+lab]\r\n\u001b[?2004l\r"]
[1035.023175, "o", "\u001b[?2004h>    x += [' jmp '+labs[-1]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
