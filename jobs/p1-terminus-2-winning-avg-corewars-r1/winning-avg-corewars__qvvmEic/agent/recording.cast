[136.442844, "i", "cat > /tmp/qpstone1.red <<'EOF'\n;redcode-94\n;name Quad Paper Stone\n;assert CORESIZE == 8000\nstart spl bomber\n spl p1\n spl p2\n spl p3\n jmp p4\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\np4 mov copy, *d\n add #1, d\n mov copy, @d\n add #2667, d\n jmp p4\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nd dat 2667, 5334\nbombptr dat 0, 0\nbomber add #4, bombptr\n mov bomb, @bombptr\n jmp bomber\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/qpstone2.red <<'EOF'\n;redcode-94\n;name Quad Paper Delayed Stone\n;assert CORESIZE == 8000\nstart spl p1\n spl p2\n spl p3\n spl bomber\n jmp p4\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\np4 mov copy, *d\n add #1, d\n mov copy, @d\n add #2667, d\n jmp p4\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nd dat 2667, 5334\nbombptr dat 0, 0\nbomber add #4, bombptr\n mov bomb, @bombptr\n jmp bomber\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/qpscan.red <<'EOF'\n;redcode-94\n;name Quad Paper Scan\n;assert CORESIZE == 8000\nstart spl scan\n spl p1\n spl p2\n spl p3\n jmp p4\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\np4 mov copy, *d\n add #1, d\n mov copy, @d\n add #2667, d\n jmp p4\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nd dat 2667, 5334\nscan add #8, ptr\nsne 0, @ptr\n mov bomb, @ptr\n jmp scan\nptr dat 0, 0\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/qpstone1.red /tmp/qpstone2.red /tmp/qpscan.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
