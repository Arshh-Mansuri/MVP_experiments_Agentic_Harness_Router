[569.453429, "i", "cat > /tmp/multihunt.py <<'PY'\nimport subprocess\nfor ns,np in ((2,3),(3,2),(3,3)):\n f=f'/tmp/multihunt_{ns}_{np}.red'\n x=[';redcode-94',f';name Multi Hunt {ns} {np}',';assert CORESIZE == 8000','start spl s1']\n for i in range(1,ns+np): x += [f' spl '+(f's{i+1}' if i<ns else f'p{i-ns+1}')]\n x += [f' jmp '+(f'p{np}' if np else f's{ns}')]\n strides=[7,17,31]\n for i in range(ns):\n  st=strides[i]; phase=i*997\n  x += [f's{i+1} mov bomb, @q{i+1}',f' add #{st}, q{i+1}',' sne bomb, @q'+str(i+1),' jmp s'+str(i+1),' mov bomb, @q'+str(i+1),' jmp s'+str(i+1)]\n for i in range(np):\n  k=i+1\n  x += [f'p{k} mov copy, *a{k}',' add #1, a'+str(k),' mov copy, @a'+str(k),' add #2667, a'+str(k),' jmp p'+str(k)]\n x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]\n x += [f'q{i+1} dat {i*997}, {i*997}' for i in range(ns)]+['bomb dat #0, #0','end start']\n open(f,'w').write('\\n'.join(x)+'\\n')\n vals=[]\n for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n  z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n  vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/multihunt.py\n"]
