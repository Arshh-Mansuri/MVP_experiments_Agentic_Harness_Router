[31.122104, "i", "cat > /tmp/scanner.red <<'EOF'\n;redcode-94\n;name Test Scanner\n;assert CORESIZE == 8000\nstep equ 17\nstart add #step, scan\nscan sne 0, @scan\n mov bomb, @scan\n jmp scan\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/hybrid.red <<'EOF'\n;redcode-94\n;name Test Scanner Paper\n;assert CORESIZE == 8000\nstep equ 17\nstart spl 1\n spl scanner\npaper mov copy, *ptr\n add #1, ptr\n mov copy, @ptr\n add #2667, ptr\n jmp paper\ncopy spl 0, 0\nptr dat 2667, 5334\nscanner add #step, scan\nscan sne 0, @scan\n mov bomb, @scan\n jmp scan\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/scanner.red /tmp/hybrid.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
