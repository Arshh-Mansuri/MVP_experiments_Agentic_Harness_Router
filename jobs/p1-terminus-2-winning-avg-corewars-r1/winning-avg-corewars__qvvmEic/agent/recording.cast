[636.677537, "i", "cat > /tmp/g2hunt.py <<'PY'\nimport subprocess\nfor step in (1,4,7,17):\n  for ns in (1,2,3,4):\n    f=f'/tmp/g2h_{step}_{ns}.red'\n    x=[';redcode-94',f';name G2 Signature Hunter {step} {ns}',';assert CORESIZE == 8000','start spl s1']\n    for i in range(1,ns): x += [f' spl s{i+1}']\n    x += [f' jmp s{ns}']\n    for i in range(ns):\n      x += [f's{i+1} add #{step}, ptr{i+1}',f' sne target, @ptr{i+1}',f' mov bomb, @ptr{i+1}',f' jmp s{i+1}']\n    x += ['target spl #2700, 11','bomb dat #0, #0']+[f'ptr{i+1} dat {i*997}, {i*997}' for i in range(ns)]+['end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/g2hunt.py\n"]
