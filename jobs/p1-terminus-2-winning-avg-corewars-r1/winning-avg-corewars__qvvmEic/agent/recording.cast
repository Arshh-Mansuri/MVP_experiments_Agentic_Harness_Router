[525.0448, "i", "cat > /tmp/hcanon.py <<'PY'\nimport subprocess\nfor step in (7,17,31):\n  for n in (3,4,5):\n    f=f'/tmp/hc_{step}_{n}.red'\n    x=[';redcode-94',f';name Canonical Scanner Paper {step} {n}',';assert CORESIZE == 8000','start spl scan']\n    for i in range(1,n): x += [f' spl p{i}']\n    x += [f' jmp p{n}']\n    x += ['scan mov bomb, @ptr',f' add #{step}, ptr',' sne bomb, @ptr',' jmp scan',' mov bomb, @ptr',' jmp scan','ptr dat 0, 0']\n    for i in range(1,n+1):\n      x += [f'p{i} mov copy, *a{i}',' add #1, a'+str(i),' mov copy, @a'+str(i),f' add #2667, a{i}',f' jmp p{i}']\n    x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(1,n+1)]+['bomb dat #0, #0','end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(f, ' | '.join(vals),flush=True)\nPY\npython3 /tmp/hcanon.py\n"]
[525.049273, "o", "cat > /tmp/hcanon.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> for step in (7,17,31):\r\n\u001b[?2004l\r\u001b[?2004h>   for n in (3,4,5):\r\n\u001b[?2004l\r\u001b[?2004h>     f=f'/tmp/hc_{step}_{n}.red'\r\n\u001b[?2004l\r\u001b[?2004h>     x=[';redcode-94',f';name Canonical Scanner Paper {step} {n}',';assert CORESIZE == 8000','start spl scan']\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(1,n): x += [f' spl p{i}']\r\n\u001b[?2004l\r\u001b[?2004h>     x += [f' jmp p{n}']\r\n\u001b[?2004l\r\u001b[?2004h>     x += ['scan mov bomb, @ptr',f' add #{step}, ptr',' sne bomb, @ptr',' jmp scan',' mov bomb, @ptr',' jmp scan','ptr dat 0, 0']\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(1,n+1):\r\n\u001b[?2004l\r\u001b[?2004h>       x += [f'p{i} mov copy, *a{i}',' add #1, a'+str(i),' mov copy, @a'+str(i),f' add #2667, a{i}',f' jmp p{i}']\r\n\u001b[?2004l\r\u001b[?2004h>     x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(1,n+1)]+['bomb dat #0, #0','end start']\r\n\u001b[?2004l\r\u001b[?2004h>     open(f,'w').write('\\n'.join(x)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\r\n\u001b[?2004l\r\u001b[?2004h>       z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\r\n\u001b[?2004l\r\u001b[?2004h>       vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\r\n\u001b[?2004l\r\u001b[?2004h>     print(f, ' | '.join(vals),flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
