[230.432657, "i", "cat > /tmp/makepapers.py <<'PY'\nimport subprocess, os\nstepsets=[(2667,2667,2667),(2667,1143,1901),(1999,2667,3331),(997,1999,2999),(4001,2667,1333)]\nfor ix,ss in enumerate(stepsets):\n  for n in (2,3,4,5):\n    f=f'/tmp/vp{ix}_{n}.red'; x=[';redcode-94',f';name Varied Paper {ix} {n}',';assert CORESIZE == 8000','start spl p1']\n    for i in range(2,n): x += [f' spl p{i}']\n    x += [f' jmp p{n}']\n    for i in range(1,n+1):\n      st=ss[(i-1)%len(ss)]\n      x += [f'p{i} mov copy, *a{i}',f' add #{st}, a{i}',' mov copy, @a'+str(i),f' add #{st}, a{i}',f' jmp p{i}']\n    x += ['copy spl 0, 0']+[f'a{i} dat {ss[(i-1)%len(ss)]}, {ss[(i-1)%len(ss)]*2}' for i in range(1,n+1)]+['end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(os.path.basename(f), ' | '.join(vals))\nPY\npython3 /tmp/makepapers.py\n"]
