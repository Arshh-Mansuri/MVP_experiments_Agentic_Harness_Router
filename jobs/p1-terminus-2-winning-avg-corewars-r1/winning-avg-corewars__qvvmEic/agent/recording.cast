[920.861971, "o", "\u001b[?2004hroot@a585ef15f2dc:/app# "]
[921.071584, "i", "cat > /tmp/focuscp.py <<'PY'\nimport subprocess\nfor nc in (4,5,6,7,8):\n for np in (1,2,3,4,5):\n  for step in (2,4,7):\n   f=f'/tmp/fcp_{nc}_{np}_{step}.red'\n   cs=[f'c{i}' for i in range(1,nc+1)]; ps=[f'p{i}' for i in range(1,np+1)]; labs=cs+ps\n   x=[';redcode-94',f';name Focus Clear Paper {nc} {np} {step}',';assert CORESIZE == 8000','start '+labs[0]]\n   for lab in labs[1:]: x += [' spl '+lab]\n   x += [' jmp '+labs[-1]]\n   for i in range(nc): x += [f'c{i+1} mov bomb, >cp{i+1}',f' add #{step}, cp{i+1}',f' jmp c{i+1}']\n   for i in range(np):\n    k=i+1; x += [f'p{k} mov copy, *a{k}',f' add #1, a{k}',f' mov copy, @a{k}',f' add #2667, a{k}',f' jmp p{k}']\n   x += ['copy spl 0, 0']+[f'a{i+1} dat 2667, 5334' for i in range(np)]+[f'cp{i+1} dat {i*997}, {i*997}' for i in range(nc)]+['bomb dat #0, #0','end start']\n   open(f,'w').write('\\n'.join(x)+'\\n'); vals=[]\n   for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n    z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n    vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n   print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/focuscp.py > /tmp/focuscp.out\npython3 - <<'PY'\nimport re\nfor line in open('/tmp/focuscp.out'):\n p=line.strip().split(' | ')\n if len(p)!=5: continue\n a=[[int(x) for x in re.findall(r'\\d+',q)[-3:]] for q in p]\n w=[v[0] for v in a]\n if w[0]>=33 and w[1]>=75 and w[2]>=33 and w[3]>=75 and w[4]>=75: print('QUALIFY',line.strip())\nPY\n"]
[921.072871, "o", "cat > /tmp/focuscp.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> "]
[921.073044, "o", "for nc in (4,5,6,7,8):\r\n\u001b[?2004l\r\u001b[?2004h>  for np in (1,2,3,4,5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
