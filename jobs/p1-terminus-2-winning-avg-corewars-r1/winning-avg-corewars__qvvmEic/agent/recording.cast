[421.578354, "i", "cat > /tmp/searchg2.py <<'PY'\nimport subprocess\nhits=[]\nfor off in range(3000,5001):\n    f=f'/tmp/g{off}.red'\n    open(f,'w').write(f';redcode-94\\nstart mov bomb, {off}\\n jmp start\\nbomb dat #0,#0\\nend start\\n')\n    z=subprocess.run(['pmars','-b','-r','5','-c','80000','-f',f,'warriors/g2-clear.red'],capture_output=True,text=True).stdout\n    r=next((q for q in z.splitlines() if q.startswith('Results:')),'')\n    if r and r.split()[1] != '0':\n        print(off,r,flush=True); hits.append(off)\nprint('HITS',hits)\nPY\npython3 /tmp/searchg2.py | tee /tmp/searchg2.out\n"]
