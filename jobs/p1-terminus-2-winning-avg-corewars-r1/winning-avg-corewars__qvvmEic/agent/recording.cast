[314.850161, "i", "cat > /tmp/broad.py <<'PY'\nimport subprocess, os\nfor radius in (5,10,20,40):\n  for papers in (0,2,3,4):\n    f=f'/tmp/broad_{radius}_{papers}.red'\n    x=[';redcode-94',f';name Broad Strike {radius} {papers}',';assert CORESIZE == 8000','start spl a0']\n    # SPL tree launches attack processes; paper processes are attached afterward\n    for i in range(1,radius*2+papers): x.append(f' spl a{i}')\n    x.append(f' jmp a{radius*2+papers}')\n    for i,off in enumerate(range(4000-radius,4001+radius)):\n      x += [f'a{i} mov bomb, {off}',f' jmp a{i}']\n    for j in range(papers):\n      k=j+radius*2+1\n      x += [f'p{k} mov copy, *p{j}',f' add #1, p{j}',f' mov copy, @p{j}',f' add #2667, p{j}',f' jmp p{k}']\n    x += ['copy spl 0, 0']+[f'p{j} dat 2667, 5334' for j in range(papers)]+['bomb dat #0, #0','end start']\n    open(f,'w').write('\\n'.join(x)+'\\n')\n    vals=[]\n    for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n      z=subprocess.run(['pmars','-b','-r','30','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n      vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n    print(os.path.basename(f), ' | '.join(vals), flush=True)\nPY\npython3 /tmp/broad.py | tee /tmp/broad.out\n"]
[314.852803, "o", "cat > /tmp/broad.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess, os\r\n\u001b[?2004l\r\u001b[?2004h> for radius in (5,10,20,40):\r\n\u001b[?2004l\r\u001b[?2004h>   for papers in (0,2,3,4):\r\n\u001b[?2004l\r\u001b[?2004h>     f=f'/tmp/broad_{radius}_{papers}.red'\r\n\u001b[?2004l\r\u001b[?2004h> "]
