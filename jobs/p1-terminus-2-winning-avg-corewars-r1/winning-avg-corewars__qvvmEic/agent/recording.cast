[216.17206, "i", "cat > /tmp/direct1.red <<'EOF'\n;redcode-94\n;name Direct Strike\n;assert CORESIZE == 8000\nstart mov bomb, 4000\n mov bomb, 3999\n mov bomb, 4001\n mov bomb, 3998\n mov bomb, 4002\n jmp start\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/direct2.red <<'EOF'\n;redcode-94\n;name Direct Strike Split\n;assert CORESIZE == 8000\nstart spl attack\n spl attack2\n jmp attack3\nattack mov bomb, 4000\n jmp attack\nattack2 mov bomb, 3999\n jmp attack2\nattack3 mov bomb, 4001\n jmp attack3\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/direct3.red <<'EOF'\n;redcode-94\n;name Direct Paper\n;assert CORESIZE == 8000\nstart mov bomb, 4000\n mov bomb, 3999\n mov bomb, 4001\n spl p1\n spl p2\n jmp p3\np1 mov copy, *a\n add #1, a\n mov copy, @a\n add #2667, a\n jmp p1\np2 mov copy, *b\n add #1, b\n mov copy, @b\n add #2667, b\n jmp p2\np3 mov copy, *c\n add #1, c\n mov copy, @c\n add #2667, c\n jmp p3\ncopy spl 0, 0\na dat 2667, 5334\nb dat 2667, 5334\nc dat 2667, 5334\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/direct1.red /tmp/direct2.red /tmp/direct3.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
