[684.621187, "i", "cat > /tmp/clears.py <<'PY'\nimport subprocess\nvariants=[]\nfor np in (1,2,3,4):\n for step in (1,4,8,16):\n  f=f'/tmp/mc_{np}_{step}.red'\n  x=[';redcode-94',f';name Multi Clear {np} {step}',';assert CORESIZE == 8000','start c1']\n  for i in range(1,np): x += [f' spl c{i+1}']\n  x += [f' jmp c{np}']\n  for i in range(np):\n   x += [f'c{i+1} mov bomb, >p{i+1}',f' add #{step}, p{i+1}',f' jmp c{i+1}']\n  x += [f'p{i+1} dat {i*997}, {i*997}' for i in range(np)]+['bomb dat #0, #0','end start']\n  open(f,'w').write('\\n'.join(x)+'\\n'); variants.append(f)\nfor f in variants:\n vals=[]\n for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n  z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n  vals.append(next((q[8:] for q in z.splitlines() if q.startswith('Results:')),'ERR'))\n print(f,' | '.join(vals),flush=True)\nPY\npython3 /tmp/clears.py\n"]
