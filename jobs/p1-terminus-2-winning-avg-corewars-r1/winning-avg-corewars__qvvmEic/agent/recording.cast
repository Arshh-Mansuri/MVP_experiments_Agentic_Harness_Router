[358.429326, "o", "\u001b[?2004h> ;author assistant\r\n\u001b[?2004l\r\u001b[?2004h> ;assert CORESIZE == 8000\r\n\u001b[?2004l\r\u001b[?2004h> start spl attack\r\n\u001b[?2004l\r\u001b[?2004h>  spl p1\r\n\u001b[?2004l\r\u001b[?2004h>  spl p2\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p3\r\n\u001b[?2004l\r\u001b[?2004h> attack spl hit0\r\n\u001b[?2004l\r\u001b[?2004h>  spl hit3\r\n\u001b[?2004l\r\u001b[?2004h>  jmp hit4\r\n\u001b[?2004l\r\u001b[?2004h> hit0 mov bomb, 4000\r\n\u001b[?2004l\r\u001b[?2004h>  jmp hit0\r\n\u001b[?2004l\r\u001b[?2004h> hit3 mov bomb, 4003\r\n\u001b[?2004l\r\u001b[?2004h>  jmp hit3\r\n\u001b[?2004l\r\u001b[?2004h> hit4 mov bomb, 4004\r\n\u001b[?2004l\r\u001b[?2004h>  jmp hit4\r\n\u001b[?2004l\r\u001b[?2004h> p1 mov copy, *a\r\n\u001b[?2004l\r\u001b[?2004h>  add #1, a\r\n\u001b[?2004l\r\u001b[?2004h>  mov copy, @a\r\n\u001b[?2004l\r\u001b[?2004h>  add #2667, a\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p1\r\n\u001b[?2004l\r\u001b[?2004h> p2 mov copy, *b\r\n\u001b[?2004l\r\u001b[?2004h>  add #1, b\r\n\u001b[?2004l\r\u001b[?2004h>  mov copy, @b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.429914, "o", " add #2667, b\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p2\r\n\u001b[?2004l\r\u001b[?2004h> p3 mov copy, *c\r\n\u001b[?2004l\r\u001b[?2004h>  add #1, c\r\n\u001b[?2004l\r\u001b[?2004h>  mov copy, @c\r\n\u001b[?2004l\r\u001b[?2004h>  add #2667, c\r\n\u001b[?2004l\r\u001b[?2004h>  jmp p3\r\n\u001b[?2004l\r\u001b[?2004h> copy spl 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> a dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> b dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> c dat 2667, 5334\r\n\u001b[?2004l\r\u001b[?2004h> bomb dat #0, #0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.430573, "o", "end start\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
