[920.583546, "i", "python3 - <<'PY'\nimport re\nrows=[]\nfor line in open('/tmp/fastclear.out'):\n p=line.strip().split(' | ')\n if len(p)!=5: continue\n try: a=[[int(x) for x in re.findall(r'\\d+',q)[-3:]] for q in p]\n except: continue\n score=min(a[0][0],a[1][0],a[2][0],a[3][0],a[4][0])\n rows.append((score,sum(v[0] for v in a),line.strip()))\nfor r in sorted(rows,reverse=True)[:20]: print(r[0],r[1],r[2])\nPY\n"]
