[83.607857, "o", "\u001b[?2004h>  jmp scanner\r\n\u001b[?2004l\r"]
[83.607901, "o", "\u001b[?2004h> "]
[83.607939, "o", "ptr dat 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.607973, "o", "bomb dat #0, #0\r\n\u001b[?2004l\r"]
[83.608305, "o", "\u001b[?2004h> "]
[83.608392, "o", "end start\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
