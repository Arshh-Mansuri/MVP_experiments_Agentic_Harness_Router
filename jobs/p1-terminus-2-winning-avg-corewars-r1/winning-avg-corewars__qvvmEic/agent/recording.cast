[48.537446, "i", "cat > /tmp/multiscan.red <<'EOF'\n;redcode-94\n;name Multi Scanner\n;assert CORESIZE == 8000\nstep equ 17\nstart spl 1\n spl 1\n spl 1\n jmp scanner1\n jmp scanner2\nscanner1 add #step, scan1\nscan1 sne 0, @scan1\n mov bomb, @scan1\n jmp scanner1\nscanner2 add #step, scan2\nscan2 sne 0, @scan2\n mov bomb, @scan2\n jmp scanner2\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/multiscan2.red <<'EOF'\n;redcode-94\n;name Multi Scanner 2\n;assert CORESIZE == 8000\nstep equ 17\nstart spl 1\n spl 1\n spl 1\n spl scanner1\n spl scanner2\n jmp scanner3\nscanner1 add #step, scan1\nscan1 sne 0, @scan1\n mov bomb, @scan1\n jmp scanner1\nscanner2 add #step, scan2\nscan2 sne 0, @scan2\n mov bomb, @scan2\n jmp scanner2\nscanner3 add #step, scan3\nscan3 sne 0, @scan3\n mov bomb, @scan3\n jmp scanner3\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/faststone.red <<'EOF'\n;redcode-94\n;name Fast Stone\n;assert CORESIZE == 8000\nstart spl 1\n add #4, ptr\n mov bomb, @ptr\n jmp -2\nptr dat 0, 0\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/stone2.red <<'EOF'\n;redcode-94\n;name Stone 2\n;assert CORESIZE == 8000\nstart add #4, 2\n mov bomb, @2\n jmp -2\nbomb dat #0, #0\nend start\nEOF\ncat > /tmp/hybrid2.red <<'EOF'\n;redcode-94\n;name Paper Multi Scanner\n;assert CORESIZE == 8000\nstep equ 17\nstart spl 1\n spl 1\n spl scanner1\n spl scanner2\npaper mov copy, *ptr\n add #1, ptr\n mov copy, @ptr\n add #2667, ptr\n jmp paper\ncopy spl 0, 0\nptr dat 2667, 5334\nscanner1 add #step, scan1\nscan1 sne 0, @scan1\n mov bomb, @scan1\n jmp scanner1\nscanner2 add #step, scan2\nscan2 sne 0, @scan2\n mov bomb, @scan2\n jmp scanner2\nbomb dat #0, #0\nend start\nEOF\nfor w in /tmp/multiscan.red /tmp/multiscan2.red /tmp/faststone.red /tmp/stone2.red /tmp/hybrid2.red; do echo \"=== $w ===\"; for o in warriors/*.red; do printf '%-25s ' \"$o\"; pmars -b -r 100 -c 80000 -f \"$w\" \"$o\"; done; done\n"]
