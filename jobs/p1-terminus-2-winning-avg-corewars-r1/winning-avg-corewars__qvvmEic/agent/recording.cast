[396.368398, "i", "cat > /tmp/offsets.py <<'PY'\nimport subprocess, os\nfor off in range(3950,4051):\n  f=f'/tmp/o{off}.red'\n  open(f,'w').write(f''';redcode-94\n;name Offset {off}\nstart mov bomb, {off}\n      jmp start\nbomb  dat #0, #0\nend start\n''')\n  z=subprocess.run(['pmars','-b','-r','10','-c','80000','-f',f,'warriors/g2-clear.red'],capture_output=True,text=True).stdout\n  r=next((q for q in z.splitlines() if q.startswith('Results:')),'')\n  if r and r.split()[1] != '0': print('G2',off,r)\nprint('stone hits')\nfor off in range(3950,4051):\n  f=f'/tmp/o{off}.red'\n  z=subprocess.run(['pmars','-b','-r','10','-c','80000','-f',f,'warriors/stone.red'],capture_output=True,text=True).stdout\n  r=next((q for q in z.splitlines() if q.startswith('Results:')),'')\n  if r and r.split()[1] != '0': print('STONE',off,r)\nPY\npython3 /tmp/offsets.py\n"]
