[154.155238, "i", "cat > /tmp/sweep.py <<'PY'\nimport os, subprocess\nops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']\nos.makedirs('/tmp/cands',exist_ok=True)\nfor n in range(2,9):\n  for mode in ['p','s','b']:\n    for stride in ([4,8,13,17,23] if mode!='p' else [0]):\n      fn=f'/tmp/cands/c{n}{mode}{stride}.red'\n      x=[';redcode-94',f';name sweep {n}{mode}{stride}',';assert CORESIZE == 8000']\n      x += ['start spl p1']\n      for i in range(2,n): x += [f' spl p{i}']\n      if n>1: x += [f' jmp p{n}']\n      for i in range(1,n+1):\n        x += [f'p{i} mov copy, *a{i}', ' add #1, a'+str(i), ' mov copy, @a'+str(i), ' add #2667, a'+str(i), f' jmp p{i}']\n      x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(1,n+1)]\n      if mode=='s': x += [f'scan add #{stride}, ptr', ' sne 0, @ptr', ' mov bomb, @ptr', ' jmp scan', 'ptr dat 0, 0', 'bomb dat #0, #0']\n      if mode=='b': x += [f'bombing add #{stride}, bptr', ' mov bomb, @bptr', ' jmp bombing', 'bptr dat 0, 0', 'bomb dat #0, #0']\n      x += ['end start']\n      open(fn,'w').write('\\n'.join(x)+'\\n')\nfor fn in sorted(os.listdir('/tmp/cands')):\n  path='/tmp/cands/'+fn\n  vals=[]\n  for op in ops:\n    z=subprocess.run(['pmars','-b','-r','20','-c','80000','-f',path,'warriors/'+op],capture_output=True,text=True).stdout\n    line=[q for q in z.splitlines() if q.startswith('Results:')]\n    vals.append(line[0].replace('Results: ','') if line else 'ERR')\n  print(fn, ' | '.join(vals))\nPY\npython3 /tmp/sweep.py > /tmp/sweep.out\ncat /tmp/sweep.out | head -100\n"]
[154.157599, "o", "cat > /tmp/sweep.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os, subprocess\r\n\u001b[?2004l\r\u001b[?2004h> ops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/tmp/cands',exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> for n in range(2,9):"]
