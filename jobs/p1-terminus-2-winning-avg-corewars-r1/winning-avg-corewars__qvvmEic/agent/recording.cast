[509.627941, "i", "cat > /tmp/canonical.py <<'PY'\nimport subprocess, os\nvariants=[]\nfor step in (4,7,13,17,31):\n  variants.append((f'/tmp/cs_{step}.red',f''';redcode-94\n;name Canonical Scanner {step}\n;assert CORESIZE == 8000\nstep equ {step}\nstart mov bomb, @ptr\nscan add #step, ptr\n sne bomb, @ptr\n jmp scan\n mov bomb, @ptr\n jmp scan\nptr dat 0, 0\nbomb dat #0, #0\nend start\n'''))\nvariants.append(('/tmp/clearimp.red',''';redcode-94\n;name Clear Imp\n;assert CORESIZE == 8000\nstart spl 1\n spl 1\n spl clear\n jmp imp, 2667\n jmp imp, 5334\nclear mov bomb, >gate\n jmp clear\ngate dat 4000, 4000\nbomb dat #0, #0\nimp mov 0, 2667\nend start\n'''))\nvariants.append(('/tmp/djnscan.red',''';redcode-94\n;name DJN Scanner\n;assert CORESIZE == 8000\nstart mov bomb, @ptr\nscan add #17, ptr\n sne bomb, @ptr\n mov bomb, @ptr\n djn scan, count\n jmp start\nptr dat 0, 0\ncount dat 470, 0\nbomb dat #0, #0\nend start\n'''))\nfor f,s in variants:\n open(f,'w').write(s)\n print('===',f)\n for o in ['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']:\n  z=subprocess.run(['pmars','-b','-r','100','-c','80000','-f',f,'warriors/'+o],capture_output=True,text=True).stdout\n  print(o,next((q for q in z.splitlines() if q.startswith('Results:')),'ERR'))\nPY\npython3 /tmp/canonical.py\n"]
