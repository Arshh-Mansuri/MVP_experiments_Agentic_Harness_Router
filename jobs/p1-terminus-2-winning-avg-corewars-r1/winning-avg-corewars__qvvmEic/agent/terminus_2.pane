[?2004hroot@a585ef15f2dc:/app# cat > /tmp/sweep.py <<'PY'
[?2004l[?2004h> import os, subprocess
[?2004l[?2004h> ops=['g2-clear.red','paper.red','snake.red','stone.red','vampire.red']
[?2004l[?2004h> os.makedirs('/tmp/cands',exist_ok=True)
[?2004l[?2004h> for n in range(2,9):
[?2004l[?2004h>   for mode in ['p','s','b']:
[?2004l[?2004h>     for stride in ([4,8,13,17,23] if mode!='p' else [0]):
[?2004l[?2004h>       fn=f'/tmp/cands/c{n}{mode}{stride}.red'
[?2004l[?2004h>       x=[';redcode-94',f';name sweep {n}{mode}{stride}',';assert CORESIZE == 8000']
[?2004l[?2004h>       x += ['start spl p1']
[?2004l[?2004h>       for i in range(2,n): x += [f' spl p{i}']
[?2004l[?2004h>       if n>1: x += [f' jmp p{n}']
[?2004l[?2004h>       for i in range(1,n+1):
[?2004l[?2004h>         x += [f'p{i} mov copy, *a{i}', ' add #1, a'+str(i), ' mov copy, @a'+str(i), ' add #2667, a'+str(i), f' jmp p{i}']
[?2004l[?2004h>       x += ['copy spl 0, 0']+[f'a{i} dat 2667, 5334' for i in range(1,n+1)]
[?2004l[?2004h>       if mode=='s': x += [f'scan add #{stride}, ptr', ' sne 0, @ptr', ' mov bomb, @ptr', ' jmp scan', 'ptr dat 0, 0', 'bomb dat #0, #0']
[?2004l[?2004h>       if mode=='b': x += [f'bombing add #{stride}, bptr', ' mov bomb, @bptr', ' jmp bombing', 'bptr dat 0, 0', 'bomb dat #0, #0']
[?2004l[?2004h>       x += ['end start']
[?2004l[?2004h>       open(fn,'w').write('\n'.join(x)+'\n')
[?2004l[?2004h> for fn in sorted(os.listdir('/tmp/cands')):
[?2004l[?2004h>   path='/tmp/cands/'+fn
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for op in ops:
[?2004l[?2004h>     z=subprocess.run(['pmars','-b','-r','20','-c','80000','-f',path,'warriors/'+op],capture_output=True,text=True).stdout
[?2004l[?2004h>     line=[q for q in z.splitlines() if q.startswith('Results:')]
[?2004l[?2004h>     vals.append(line[0].replace('Results: ','') if line else 'ERR')
[?2004l[?2004h>   print(fn, ' | '.join(vals))
[?2004l[?2004h> PY
