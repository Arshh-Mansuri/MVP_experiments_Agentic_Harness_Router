[?2004l[?2004h>    labs=(cs+ps) if mode=='clearfirst' else (ps+cs)
[?2004l[?2004h>    x=[';redcode-94',f';name Last Mix {np} {step} {mode}',';assert CORESIZE == 8000','start '+labs[0]]
[?2004l[?2004h>    for lab in labs[1:]: x += [' spl '+lab]
[?2004l[?2004h>    x += [' jmp '+labs[-1]]
[?2004l[?2004h>    for i in range(8): x += [f'c{i+1} mov bomb, >cp{i+1}',f' add #{step}, cp{i+1}',f' jmp c{i+1}']
[?2004l[?2004h>    for i in range(np):
[?2004l[?2004h>     k=i+1
