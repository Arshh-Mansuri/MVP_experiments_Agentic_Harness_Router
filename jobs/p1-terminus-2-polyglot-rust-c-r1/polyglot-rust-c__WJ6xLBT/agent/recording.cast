[130.376973, "i", "cat > /app/polyglot/main.rs <<'EOF'\n/*\n*\n/ #include <cstdio>\n/*\n*\n/ #include <fstream>\n/*\n*\n/ #include <string>\n/*\n*\n/ #include <vector>\n/*\n*\n/ #define fn int\n/*\n*\n/ #define u128 unsigned __int128\n/*\n*\n/ #define let auto\n/*\n*\n/ #define mut\n/*\n*\n/ #define unsafe\n/*\n*\n/ #define std poly\n/*\n*\n/ namespace poly {\n/*\n*\n/ namespace env {\n/*\n*\n/ struct Arg {\n/*\n*\n/     ::std::string value;\n/*\n*\n/     Arg nth(unsigned long long i) const {\n/*\n*\n/         ::std::ifstream f(\"/proc/self/cmdline\", ::std::ios::binary);\n/*\n*\n/         ::std::vector<::std::string> a;\n/*\n*\n/         ::std::string s;\n/*\n*\n/         char c;\n/*\n*\n/         while (f.get(c)) {\n/*\n*\n/             if (c == '\\0') { a.push_back(s); s.clear(); }\n/*\n*\n/             else s += c;\n/*\n*\n/         }\n/*\n*\n/         if (!s.empty()) a.push_back(s);\n/*\n*\n/         return Arg{i < a.size() ? a[i] : ::std::string()};\n/*\n*\n/     }\n/*\n*\n/     Arg unwrap() const { return *this; }\n/*\n*\n/     u128 parse() const {\n/*\n*\n/         u128 n = 0;\n/*\n*\n/         for (char c : value) if (c >= '0' && c <= '9') n = n * 10 + (c - '0');\n/*\n*\n/         return n;\n/*\n*\n/     }\n/*\n*\n/ };\n/*\n*\n/ inline Arg args() { return Arg{}; }\n/*\n*\n/ }\n/*\n*\n/ }\n/*\n*\n/ */\n\nextern \"C\" {\n    fn putchar(_: u128);\n}\n\nfn main() {\n    let k = std::env::args().nth(1).unwrap().parse().unwrap();\n    let mut a = 1;\n    let mut b = 1;\n    let mut i = 0;\n    while i < k {\n        let c = a + b;\n        a = b;\n        b = c;\n        i = i + 1;\n    }\n\n    let mut p = 1;\n    while p <= a / 10 {\n        p = p * 10;\n    }\n    while p > 0 {\n        unsafe { putchar(a / p + 48); }\n        a = a % p;\n        p = p / 10;\n    }\n    unsafe { putchar(10); }\n}\nEOF\nrustc /app/polyglot/main.rs -o /app/polyglot/rmain && printf 'Rust: ' && /app/polyglot/rmain 0 && /app/polyglot/rmain 1 && /app/polyglot/rmain 10 && g++ -x c++ /app/polyglot/main.rs -o /app/polyglot/cmain && printf 'C++: ' && /app/polyglot/cmain 0 && /app/polyglot/cmain 1 && /app/polyglot/cmain 10 && /app/polyglot/cmain 20\n"]
