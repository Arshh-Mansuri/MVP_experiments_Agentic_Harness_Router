[85.777173, "i", "mkdir -p /app/polyglot\ncat > /app/polyglot/main.rs <<'EOF'\n/* C++ compatibility layer\n#include <cstdio>\n#include <fstream>\n#include <string>\n#include <vector>\n#define fn int\n#define u128 unsigned __int128\n#define let auto\n#define mut\n#define unsafe\n#define std poly\n\nnamespace poly {\nnamespace env {\nstruct Arg {\n    std::string value;\n    Arg nth(unsigned long long i) const {\n        std::ifstream f(\"/proc/self/cmdline\", std::ios::binary);\n        std::vector<std::string> a;\n        std::string s;\n        char c;\n        while (f.get(c)) {\n            if (c == '\\0') { a.push_back(s); s.clear(); }\n            else s += c;\n        }\n        if (!s.empty()) a.push_back(s);\n        return Arg{i < a.size() ? a[i] : std::string()};\n    }\n    Arg unwrap() const { return *this; }\n    u128 parse() const {\n        u128 n = 0;\n        for (char c : value) if (c >= '0' && c <= '9') n = n * 10 + (c - '0');\n        return n;\n    }\n};\ninline Arg args() { return Arg{}; }\n}\n}\n*/\n\nextern \"C\" {\n    fn putchar(u128);\n}\n\nfn output(n: u128) {\n    if n >= 10 {\n        output(n / 10);\n    }\n    unsafe { putchar(n % 10 + 48); }\n}\n\nfn main() {\n    let k = std::env::args().nth(1).unwrap().parse();\n    let mut a = 1;\n    let mut b = 1;\n    let mut i = 0;\n    while i < k {\n        let c = a + b;\n        a = b;\n        b = c;\n        i = i + 1;\n    }\n    output(a);\n    unsafe { putchar(10); }\n}\nEOF\nrustc /app/polyglot/main.rs -o /app/polyglot/rmain && /app/polyglot/rmain 0 && /app/polyglot/rmain 1 && /app/polyglot/rmain 10\ng++ -x c++ /app/polyglot/main.rs -o /app/polyglot/cmain && /app/polyglot/cmain 0 && /app/polyglot/cmain 1 && /app/polyglot/cmain 10\n"]
