K‘\u001b[01m\u001b[Kvector\u001b[m\u001b[K’ is not a member of ‘\u001b[01m\u001b[Kruststd\u001b[m\u001b[K’\r\n   29 |         ::std::\u001b[01;31m\u001b[Kvector\u001b[m\u001b[K<::std::string> args;\r\n      |                \u001b[01;31m\u001b[K^~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/app/polyglot/main.rs:29:16:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[Ksuggested alternatives:\r\nIn file included from \u001b[01m\u001b[K/usr/include/c++/13/vector:66\u001b[m\u001b[K,\r\n                 from \u001b[01m\u001b[K/app/polyglot/main.rs:7\u001b[m\u001b[K:\r\n\u001b[01m\u001b[K/usr/include/c++/13/bits/stl_vector.h:428:11:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K  ‘\u001b[01m\u001b[Kstd::vector\u001b[m\u001b[K’\r\n  428 |     class \u001b[01;36m\u001b[Kvector\u001b[m\u001b[K : protected _Vector_base<_Tp, _Alloc>\r\n      |           \u001b[01;36m\u001b[K^~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/usr/include/c++/13/vector:86:13:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K  ‘\u001b[01m\u001b[Kstd::pmr::vector\u001b[m\u001b[K’\r\n   86 |       using \u001b[01;36m\u001b[Kvector\u001b[m\u001b[K = std::vector<_Tp, polymorphic_allocator<_Tp>>;\r\n      |             \u001b[01;36m\u001b[K^~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/app/polyglot/main.rs:29:30:\u001b[m\u001b[K \u001b[01;31m\u001b[Kerror: \u001b[m\u001b[K‘\u001b[01m\u001b[Kstring\u001b[m\u001b[K’ is not a member of ‘\u001b[01m\u001b[Kruststd\u001b[m\u001b[K’\r\n   29 |         ::std::vector<::std::\u001b[01;31m\u001b[Kstring\u001b[m\u001b[K> args;\r\n      |                              \u001b[01;31m\u001b[K^~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/app/polyglot/main.rs:29:30:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[Ksuggested alternatives:\r\nIn file included from \u001b[01m\u001b[K/usr/include/c++/13/iosfwd:41\u001b[m\u001b[K:\r\n\u001b[01m\u001b[K/usr/include/c++/13/bits/stringfwd.h:77:33:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m