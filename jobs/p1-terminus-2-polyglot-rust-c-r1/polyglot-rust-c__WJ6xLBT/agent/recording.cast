[153.400065, "i", "cat > /app/polyglot/main.rs <<'EOF'\n/*\n/*\n*/\n#include <cstdio>\n#include <fstream>\n#include <string>\n#include <vector>\n\n#define fn int\n#define u128 unsigned __int128\n#define let auto\n#define mut\n#define unsafe\n#define std ruststd\n#define putchar poly_putchar\n\nstatic void poly_putchar(u128 x) { std::putchar((int)x); }\n\nnamespace ruststd {\nnamespace env {\nstruct Parsed {\n    u128 value;\n    u128 unwrap() const { return value; }\n};\nstruct Arg {\n    ::std::string value;\n    Arg nth(unsigned long long wanted) const {\n        ::std::ifstream file(\"/proc/self/cmdline\", ::std::ios::binary);\n        ::std::vector<::std::string> args;\n        ::std::string current;\n        char ch;\n        while (file.get(ch)) {\n            if (ch == '\\0') { args.push_back(current); current.clear(); }\n            else current += ch;\n        }\n        if (!current.empty()) args.push_back(current);\n        return Arg{wanted < args.size() ? args[wanted] : ::std::string()};\n    }\n    Arg unwrap() const { return *this; }\n    Parsed parse() const {\n        u128 number = 0;\n        for (char ch : value)\n            if (ch >= '0' && ch <= '9') number = number * 10 + ch - '0';\n        return Parsed{number};\n    }\n};\ninline Arg args() { return Arg{}; }\n}\n}\n/*\n*/\n*/\n\nextern \"C\" {\n    fn putchar(_: u128);\n}\n\nfn main() {\n    let k = std::env::args().nth(1).unwrap().parse().unwrap();\n    let mut a = 1;\n    let mut b = 1;\n    let mut i = 0;\n    while i < k {\n        let c = a + b;\n        a = b;\n        b = c;\n        i = i + 1;\n    }\n\n    let mut p = 1;\n    while p <= a / 10 { p = p * 10; }\n    while p > 0 {\n        unsafe { putchar(a / p + 48); }\n        a = a % p;\n        p = p / 10;\n    }\n    unsafe { putchar(10); }\n}\nEOF\nrustc /app/polyglot/main.rs -o /app/polyglot/rmain && printf 'Rust\\n' && for n in 0 1 2 10 20; do /app/polyglot/rmain $n; done\ng++ -x c++ /app/polyglot/main.rs -o /app/polyglot/cmain && printf 'C++\\n' && for n in 0 1 2 10 20; do /app/polyglot/cmain $n; done\n"]
