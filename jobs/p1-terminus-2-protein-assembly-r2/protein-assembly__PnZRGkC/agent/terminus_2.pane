[?2004l[?2004h> from urllib.request import Request,urlopen
[?2004l[?2004h> import re,json,os
[?2004l[?2004h> ids=[x.strip().lower() for x in open('/app/pdb_ids.txt') if x.strip()]
[?2004l[?2004h> def fetch(url):
[?2004l[?2004h>     req=Request(url,headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>     return urlopen(req,timeout=30).read().decode()
[?2004l[?2004h> def parse_fasta(t):
[?2004l[?2004h>     rec=[]
[?2004l[?2004h>     h=None;s=[]
[?2004l[?2004h>     for line in t.splitlines():
[?2004l[?2004h>         if line.startswith('>'):
[?2004l[?2004h>             if h is not None: rec.append((h,''.join(s).replace('X','')))
[?2004l[?2004h>             h=line[1:];s=[]
[?2004l[?2004h>         else:s.append(re.sub('[^A-Za-z]','',line).upper())
[?2004l[?2004h>     if h is not None:rec.append((h,''.join(s).replace('X','')))
[?2004l[?2004h>     return rec
[?2004l[?2004h> for pid in ids:
[?2004l[?2004h>     try:
[?2004l[?2004h>         t=fetch(f'https://www.rcsb.org/fasta/entry/{pid}')
[?2004l[?2004h>         open(f'/tmp/{pid}.fasta','w').write(t)
