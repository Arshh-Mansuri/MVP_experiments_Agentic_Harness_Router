python3 - <<'PY'
from urllib.request import Request,urlopen
from urllib.parse import urlencode
import re,os
for rid in ['C2A3CWE8014','C2A3E9NK014']:
 u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urlencode({'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML'})
 try:
  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()
  open('/tmp/'+rid+'_latest','w').write(t)
  print('\nRID',rid,'LEN',len(t))
  for pat in ['Status','READY','WAITING','FAILED','QBlastInfo','Iteration','BlastOutput','ThereAreHits']:
   print(pat,re.findall(r'.{0,100}'+pat+r'.{0,160}',t,re.I)[:3])
 except Exception as e:print(rid,e)
