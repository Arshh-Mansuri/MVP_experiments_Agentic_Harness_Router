python3 - <<'PY'
import glob,re,html
for f in glob.glob('/tmp/C2A3*latest')+glob.glob('/tmp/ncbi_*.html'):
 t=open(f,errors='ignore').read()
 print('\n###',f,len(t))
 print('TITLE',re.findall(r'<title[^>]*>(.*?)</title>',t,re.I|re.S)[:2])
 for pat in ['QBlastInfo','Status=','RID','READY','WAITING','FAILED','No hits','Hit_def','BLAST','error']:
  hits=re.findall(r'.{0,120}'+pat+r'.{0,240}',t,re.I|re.S)
  if hits: print(pat, re.sub(r'\s+',' ',html.unescape(hits[0]))[:500])
