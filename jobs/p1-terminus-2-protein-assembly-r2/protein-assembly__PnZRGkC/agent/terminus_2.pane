[?2004l[?2004h> from urllib.request import Request,urlopen
[?2004l[?2004h> import re
[?2004l[?2004h> # retrieve canonical/common fluorescent and SNAP sequences through UniProt REST by known accessions/search terms
[?2004l[?2004h> urls={
[?2004l[?2004h>  'gfp':'https://rest.uniprot.org/uniprotkb/P42212.fasta',
[?2004l[?2004h>  'snap':'https://rest.uniprot.org/uniprotkb/Q9H0U4.fasta',
[?2004l[?2004h>  'mcherry_search':'https://rest.uniprot.org/uniprotkb/search?query=protein_name:mCherry&format=fasta&size=1',
[?2004l[?2004h>  'gamillus_search':'https://rest.uniprot.org/uniprotkb/search?query=protein_name:Gamillus&format=fasta&size=5'}
[?2004l[?2004h> for k,u in urls.items():
[?2004l[?2004h>  try:
[?2004l[?2004h>   t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()
[?2004l[?2004h>   print('\n###',k,len(t));print(t[:1500])
[?2004l[?2004h>  except Exception as e:print(k,e)
[?2004l[?2004h> PY
