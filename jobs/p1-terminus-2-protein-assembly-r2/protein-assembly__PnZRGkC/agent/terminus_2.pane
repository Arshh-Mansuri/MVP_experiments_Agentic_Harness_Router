[?2004hroot@f7ddbf9a14ab:/app# cat > /tmp/make_gblock.py <<'PY'
[?2004ltranslation="([A-Za-z\n ]+)"',pl,re.I)),key=len)
parts=[gfp,gam,dh,mch,snap]
parts=[x[1:] if x.startswith('M') else x for x in parts]
protein='GGSGGS'.join(parts)
# Standard codons selected to keep local GC near 50%.
codons={
'A':['GCT','GCC','GCA','GCG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],'N':['AAT','AAC'],'D':['GAT','GAC'],'C':['TGT','TGC'],'Q':['CAA','CAG'],'E':['GAA','GAG'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'K':['AAA','AAG'],'M':['ATG'],'F':['TTT','TTC'],'P':['CCT','CCC','CCA','CCG'],'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T':['ACT','ACC','ACA','ACG'],'W':['TGG'],'Y':['TAT','TAC'],'V':['GTT','GTC','GTA','GTG']}
dna=''
for aa in protein:
    best=None
    for c in codons[aa]:
        trial=dna+c
        penalty=abs((c.count('G')+c.count('C'))-1.5)
        for i in range(max(0,len(trial)-50),len(trial)-49):
            gc=(trial[i:i+50].count('G')+trial[i:i+50].count('C'))/50
            if gc<.30 or gc>.70: penalty+=100
        if best is None or penalty<best[0]: best=(penalty,c)
    dna+=best[1]
assert len(dna)<=3000
assert set(dna)<=set('ACGT') and '\n' not in dna and '\r' not in dna
assert all(.30 <= (dna[i:i+50].count('G')+dna[i:i+50].count('C'))/50 <= .70 for i in range(len(dna)-49))
open('/app/gblock.txt','w').write(dna)
print('components_aa',*[len(x) for x in parts])
print('protein_aa',len(protein),'gblock_nt',len(dna))
PY
python3 /tmp/make_gblock.py
