[200.549903, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import urlencode\nimport re,time\n# recover the two BLAST submission pages by resubmitting with explicit parameters\nab=open('/app/antibody.fasta').read()\nseqs=[]; h=None; s=[]\nfor line in ab.splitlines():\n line=line.strip()\n if line.startswith('>'):\n  if h: seqs.append((h,''.join(s)))\n  h=line[1:];s=[]\n elif line:s.append(re.sub('[^A-Za-z]','',line).upper())\nif h:seqs.append((h,''.join(s)))\nrids=[]\nfor h,seq in seqs:\n q=urlencode({'CMD':'Put','PROGRAM':'blastp','DATABASE':'swissprot','QUERY':seq,'FORMAT_TYPE':'XML','HITLIST_SIZE':'20'})\n try:\n  t=urlopen(Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+q,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n  open('/tmp/ncbi_'+h.replace(' ','_')+'.html','w').write(t)\n  found=re.findall(r'(?:RID|rid)\\s*[=:]\\s*([A-Z0-9-]+)',t)\n  print(h,'RID candidates',found[:10])\n  rids += found[:1]\n except Exception as e:print('submit error',h,e)\nfor rid in rids:\n for n in range(12):\n "]
[200.550631, "i", " time.sleep(5)\n  u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urlencode({'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML'})\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n  print('RID',rid,'poll',n,'len',len(t),'status',re.findall(r'<Status>(.*?)</Status>',t)[:1])\n  if '<Iteration>' in t or '<BlastOutput>' in t:\n   open('/tmp/'+rid+'.xml','w').write(t)\n   for hit in re.findall(r'<Hit_def>(.*?)</Hit_def>',t)[:10]:print(' HIT',hit)\n   for acc in re.findall(r'<Hit_accession>(.*?)</Hit_accession>',t)[:10]:print(' ACC',acc)\n   break\nPY\n"]
