[418.532921, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import quote\nimport re,html\nab=open('/app/antibody.fasta').read(); rec=[];h=None;s=[]\nfor line in ab.splitlines():\n line=line.strip()\n if line.startswith('>'):\n  if h:rec.append((h,''.join(s)))\n  h=line[1:];s=[]\n elif line:s.append(re.sub('[^A-Za-z]','',line).upper())\nif h:rec.append((h,''.join(s)))\nqs=[rec[0][1][35:95],rec[0][1][95:155],rec[1][1][35:95],rec[1][1][95:155]]\nfor q in qs:\n print('\\nQUERY',q)\n for host in ['www.google.com/search?q=','www.bing.com/search?q=','duckduckgo.com/html/?q=']:\n  try:\n   t=urlopen(Request('https://'+host+quote('\"'+q+'\"'),headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode('utf-8','ignore')\n   t=html.unescape(re.sub(r'<[^>]*>',' ',t));t=re.sub(r'\\s+',' ',t)\n   print(host.split('/')[0],re.sub(r'.{0,100}(?:anti|antibody|GFP|protein|target).{0,220}',lambda m:m.group(0),t,re.I)[:1200])\n  except Exception as e: print('ERR',host,e)\nPY\n"]
