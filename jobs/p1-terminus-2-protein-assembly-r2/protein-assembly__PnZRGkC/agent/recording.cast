[334.531523, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import urlencode\nimport re,time\nfor rid in ['C2A3CWE8014','C2A3E9NK014']:\n    u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urlencode({'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML','NCBI_GI':'yes'})\n    try:\n        t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n        print('\\nRID',rid,'LEN',len(t))\n        print('QBlast statuses:',re.findall(r'<QBlastInfo[^>]*>(.*?)</QBlastInfo>',t,re.S)[:2])\n        print('XML?', '<BlastOutput>' in t, 'Iterations?', '<Iteration>' in t)\n        for tag in ['Hit_def','Hit_accession','Hit_id']:\n            print(tag,re.findall(r'<'+tag+r'>(.*?)</'+tag+r'>',t,re.S)[:10])\n        open('/tmp/'+rid+'_poll.xml','w').write(t)\n    except Exception as e:print('ERROR',rid,e)\nPY\n"]
