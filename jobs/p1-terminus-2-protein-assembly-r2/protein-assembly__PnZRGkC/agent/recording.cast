[398.726483, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport re\n# retrieve canonical/common fluorescent and SNAP sequences through UniProt REST by known accessions/search terms\nurls={\n 'gfp':'https://rest.uniprot.org/uniprotkb/P42212.fasta',\n 'snap':'https://rest.uniprot.org/uniprotkb/Q9H0U4.fasta',\n 'mcherry_search':'https://rest.uniprot.org/uniprotkb/search?query=protein_name:mCherry&format=fasta&size=1',\n 'gamillus_search':'https://rest.uniprot.org/uniprotkb/search?query=protein_name:Gamillus&format=fasta&size=5'}\nfor k,u in urls.items():\n try:\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()\n  print('\\n###',k,len(t));print(t[:1500])\n except Exception as e:print(k,e)\nPY\n"]
