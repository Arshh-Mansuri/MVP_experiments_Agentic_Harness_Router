[478.263069, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import quote\nimport re,html\nab=open('/app/antibody.fasta').read(); seq=''.join(re.findall('[A-Za-z]',ab.split('>light chain')[0])).upper()\nfor q in [seq[35:75],seq[75:115],seq[115:155]]:\n u='https://www.bing.com/search?q='+quote('\"'+q+'\"')\n try:\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode('utf-8','ignore')\n  for title,link in re.findall(r'<li class=\"b_algo\".*?<h2><a href=\"(.*?)\"[^>]*>(.*?)</a>',t,re.S|re.I):\n   print(html.unescape(re.sub('<.*?>','',title)),'URL',html.unescape(link))\n except Exception as e: print(e)\nPY\n"]
