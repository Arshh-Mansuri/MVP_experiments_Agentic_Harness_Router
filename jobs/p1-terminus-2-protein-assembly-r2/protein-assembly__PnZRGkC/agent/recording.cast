[181.943613, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport urllib.parse,re\nseq=''.join(re.findall('[A-Za-z]',open('/app/antibody.fasta').read().split('>light chain')[0].split('\\n',1)[1])).upper()\nfor url in ['https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode({'CMD':'Put','PROGRAM':'blastp','DATABASE':'nr','QUERY':seq,'FORMAT_TYPE':'HTML'}), 'https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode({'CMD':'Put','PROGRAM':'blastp','DATABASE':'swissprot','QUERY':seq,'FORMAT_TYPE':'XML'})]:\n try:\n  t=urlopen(Request(url,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n  print('LEN',len(t)); print(t[:2000]); open('/tmp/blast_result.txt','w').write(t)\n except Exception as e: print('ERR',e)\nPY\n"]
