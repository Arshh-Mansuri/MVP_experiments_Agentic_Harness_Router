[502.904176, "i", "cat > /tmp/make_gblock.py <<'PY'\nimport re\nfrom urllib.request import Request,urlopen\n\ndef fetch_fasta(pid):\n    t=urlopen(Request('https://www.rcsb.org/fasta/entry/'+pid,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()\n    return ''.join(x.strip() for x in t.splitlines() if not x.startswith('>')).upper()\n# Antibody target: canonical H-Ras sequence represented by PDB 5P21.\nras=fetch_fasta('5p21')\n# Azami-Green donor; resolve crystallographic unknowns against the standard mAG sequence.\ndonor=fetch_fasta('3adf').replace('X','F')\n# mCherry acceptor; the single crystallographic unknown is the standard glutamine residue.\nacceptor=fetch_fasta('2h5q').replace('X','Q')\n# SNAP-tag-derived molecule binder.\nmolecule=fetch_fasta('3kzy')\n# DHFR from plasmid.gb.\npl=open('/app/plasmid.gb').read()\ntranslations=[re.sub('[^A-Za-z]','',x).upper() for x in re.findall(r'/translation=\"([A-Za-z\\n ]+)\"',pl,re.I)]\ndhfr=max([x for x in translations if len(x)>100],key=len)\nparts=[ras,donor,dhfr,acceptor,molecule]\nparts"]
[502.904857, "o", "cat > /tmp/make_gblock.py <<'PY'\r\n\u001b[?2004l\r"]
[502.904898, "i", "=[x[1:] if x.startswith('M') else x for x in parts]\nassert all(re.fullmatch('[ACDEFGHIKLMNPQRSTVWY]+',x) for x in parts)\nprotein='GGSGGS'.join(parts)\nassert len(protein)*3<=3000\ncodons={\n'A':['GCT','GCC','GCA','GCG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],'N':['AAT','AAC'],'D':['GAT','GAC'],'C':['TGT','TGC'],'Q':['CAA','CAG'],'E':['GAA','GAG'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'K':['AAA','AAG'],'M':['ATG'],'F':['TTT','TTC'],'P':['CCT','CCC','CCA','CCG'],'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T':['ACT','ACC','ACA','ACG'],'W':['TGG'],'Y':['TAT','TAC'],'V':['GTT','GTC','GTA','GTG']}\ndna=''\nfor aa in protein:\n    best=None\n    for c in codons[aa]:\n        trial=dna+c\n        penalty=abs(c.count('G')+c.count('C')-1.5)\n        for i in range(max(0,len(trial)-50),max(0,len(trial)-49)):\n            gc=(trial[i:i+50].count('G')+trial[i:i+50].count('C'))/50\n            if not .30<=gc<=.70: penalty+=1000\n        if best is None or pen"]
