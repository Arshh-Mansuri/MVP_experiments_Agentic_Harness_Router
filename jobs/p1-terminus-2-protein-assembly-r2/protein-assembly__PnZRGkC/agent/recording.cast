[277.23146, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import urlencode\nimport re,os\nfor rid in ['C2A3CWE8014','C2A3E9NK014']:\n u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urlencode({'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML'})\n try:\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n  open('/tmp/'+rid+'_latest','w').write(t)\n  print('\\nRID',rid,'LEN',len(t))\n  for pat in ['Status','READY','WAITING','FAILED','QBlastInfo','Iteration','BlastOutput','ThereAreHits']:\n   print(pat,re.findall(r'.{0,100}'+pat+r'.{0,160}',t,re.I)[:3])\n except Exception as e:print(rid,e)\nPY\n"]
