[56.378641, "i", "python3 - <<'PY'\nimport requests\nids=[x.strip().lower() for x in open('/app/pdb_ids.txt') if x.strip()]\nfor pid in ids:\n    u=f'https://www.rcsb.org/fasta/entry/{pid}'\n    r=requests.get(u,timeout=30)\n    print('\\n###',pid,r.status_code,len(r.text))\n    print(r.text[:1200].replace('\\n',' | '))\nPY\n"]
