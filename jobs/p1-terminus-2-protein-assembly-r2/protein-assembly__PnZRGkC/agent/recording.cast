[69.901425, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.error import HTTPError,URLError\nids=[x.strip().lower() for x in open('/app/pdb_ids.txt') if x.strip()]\nfor pid in ids:\n    url=f'https://www.rcsb.org/fasta/entry/{pid}'\n    try:\n        req=Request(url,headers={'User-Agent':'Mozilla/5.0'})\n        text=urlopen(req,timeout=30).read().decode()\n        open(f'/tmp/{pid}.fasta','w').write(text)\n        print(f'### {pid} OK {len(text)} bytes')\n        print(text[:1000].replace('\\n',' | '))\n    except Exception as e:\n        print(f'### {pid} ERROR {e}')\nPY\n"]
