[527.305203, "i", "cat > /tmp/make_gblock.py <<'PY'\nimport re,random\nfrom urllib.request import Request,urlopen\n\ndef fetch(pid):\n    t=urlopen(Request('https://www.rcsb.org/fasta/entry/'+pid,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()\n    return re.sub('[^A-Za-z]',''.join(x.strip() for x in t.splitlines() if not x.startswith('>')).upper(),'')\n# Correct the expression above through a simple FASTA parser.\ndef fasta(pid):\n    t=urlopen(Request('https://www.rcsb.org/fasta/entry/'+pid,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()\n    return ''.join(x.strip() for x in t.splitlines() if not x.startswith('>')).upper()\nras=fasta('5p21')\ndonor=fasta('3adf').replace('X','F')\nacceptor=fasta('2h5q').replace('X','Q')\nmolecule=fasta('3kzy')\npl=open('/app/plasmid.gb').read()\nm=re.search(r'/gene=\"folA\".*?/translation=\"([A-Za-z\\n ]+)\"',pl,re.S|re.I)\nassert m,'folA translation not found'\ndhfr=re.sub('[^A-Za-z]','',m.group(1)).upper()\nparts=[ras,donor,dhfr,acceptor,molecule]\nparts=[x[1:] if x.startswith('M"]
[527.307518, "o", "cat > /tmp/make_gblock.py <<'PY'\r\n\u001b[?2004l\r"]
[527.307897, "i", "') else x for x in parts]\nassert [len(x) for x in parts]==[165,225,159,232,182],[len(x) for x in parts]\nprotein='GGSGGS'.join(parts)\nassert len(protein)==987\ncodons={\n'A':['GCT','GCC','GCA','GCG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],'N':['AAT','AAC'],'D':['GAT','GAC'],'C':['TGT','TGC'],'Q':['CAA','CAG'],'E':['GAA','GAG'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'K':['AAA','AAG'],'M':['ATG'],'F':['TTT','TTC'],'P':['CCT','CCC','CCA','CCG'],'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T':['ACT','ACC','ACA','ACG'],'W':['TGG'],'Y':['TAT','TAC'],'V':['GTT','GTC','GTA','GTG']}\n# Randomized balanced reverse translation; retry until every 50-nt window is valid.\nfor attempt in range(10000):\n    dna=''.join(random.choice(codons[a]) for a in protein)\n    vals=[(dna[i:i+50].count('G')+dna[i:i+50].count('C'))/50 for i in range(len(dna)-49)]\n    if min(vals)>=.30 and max(vals)<=.70:\n        assert len(dna)==2961\n        open('/app/gblock.txt','w')."]
