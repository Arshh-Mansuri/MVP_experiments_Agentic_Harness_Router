[358.158603, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import urlencode\nimport re\nfor rid in ['C2A3CWE8014','C2A3E9NK014']:\n for params in [\n  {'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo'},\n  {'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'},\n  {'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'HTML'}]:\n  try:\n   u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urlencode(params)\n   t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=60).read().decode()\n   print('\\n',rid,params,'LEN',len(t))\n   print(re.sub(r'\\s+',' ',t[:1200]))\n   print('xml', '<BlastOutput>' in t, 'hits', re.findall(r'<Hit_def>(.*?)</Hit_def>',t,re.S)[:5])\n  except Exception as e: print('ERR',e)\nPY\n"]
