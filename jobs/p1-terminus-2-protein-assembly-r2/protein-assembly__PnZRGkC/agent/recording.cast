[90.133629, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport re,json,os\nids=[x.strip().lower() for x in open('/app/pdb_ids.txt') if x.strip()]\ndef fetch(url):\n    req=Request(url,headers={'User-Agent':'Mozilla/5.0'})\n    return urlopen(req,timeout=30).read().decode()\ndef parse_fasta(t):\n    rec=[]\n    h=None;s=[]\n    for line in t.splitlines():\n        if line.startswith('>'):\n            if h is not None: rec.append((h,''.join(s).replace('X','')))\n            h=line[1:];s=[]\n        else:s.append(re.sub('[^A-Za-z]','',line).upper())\n    if h is not None:rec.append((h,''.join(s).replace('X','')))\n    return rec\nfor pid in ids:\n    try:\n        t=fetch(f'https://www.rcsb.org/fasta/entry/{pid}')\n        open(f'/tmp/{pid}.fasta','w').write(t)\n        print(pid)\n        for h,s in parse_fasta(t): print(' ',len(s),h)\n        try:\n            m=json.loads(fetch(f'https://data.rcsb.org/rest/v1/core/entry/{pid}'))\n            print(' TITLE:',m.get('struct',{}).get('title',''))\n        except Exception as e: pri"]
[90.135438, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[90.135572, "i", "nt(' META_ERROR',e)\n    except Exception as e: print(pid,'ERROR',e)\nPY\n"]
