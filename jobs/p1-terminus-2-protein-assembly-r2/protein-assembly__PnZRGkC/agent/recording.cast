[260.474467, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport json\nfor u in ['https://data.rcsb.org/rest/v1/core/entry/3kzy','https://data.rcsb.org/rest/v1/core/polymer_entity/3kzy/1','https://data.rcsb.org/rest/v1/core/nonpolymer_entity/3kzy/2']:\n try:\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode(); print('\\nURL',u,'\\n',t[:8000])\n except Exception as e:print('ERR',u,e)\nPY\n"]
