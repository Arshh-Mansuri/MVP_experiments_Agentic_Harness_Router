[150.278175, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport re\nfor u in ['https://www.fpbase.org/proteins/gamillus/','https://www.fpbase.org/proteins/mcherry/','https://www.fpbase.org/proteins/','https://raw.githubusercontent.com/ulerlab/FPbase/master/data/proteins.json','https://raw.githubusercontent.com/FPbase/FPbase/master/data/proteins.json']:\n try:\n  t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode()\n  print('\\nURL',u,'LEN',len(t)); print(t[:1500]);\n except Exception as e: print('ERROR',u,e)\nPY\n"]
