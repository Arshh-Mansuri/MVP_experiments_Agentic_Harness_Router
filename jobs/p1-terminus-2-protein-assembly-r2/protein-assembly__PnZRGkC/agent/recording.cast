[388.701777, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import quote\nimport re\nab=open('/app/antibody.fasta').read()\nseqs=[];h=None;s=[]\nfor line in ab.splitlines():\n line=line.strip()\n if line.startswith('>'):\n  if h:seqs.append((h,''.join(s)))\n  h=line[1:];s=[]\n elif line:s.append(re.sub('[^A-Za-z]','',line).upper())\nif h:seqs.append((h,''.join(s)))\nqueries=[seqs[0][1][:60],seqs[0][1][20:90],seqs[1][1][:60],seqs[1][1][20:90]]\nfor q in queries:\n print('\\nQUERY',q)\n for base in ['https://www.google.com/search?q=','https://www.bing.com/search?q=']:\n  try:\n   t=urlopen(Request(base+quote('\"'+q+'\"'),headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode('utf-8','ignore')\n   clean=re.sub('<[^>]+>',' ',t); clean=re.sub(r'\\s+',' ',clean)\n   print(base.split('/')[2],len(t),clean[:1200])\n  except Exception as e:print('ERR',e)\nPY\n"]
[388.704881, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[388.708381, "o", "\u001b[?2004h> from urllib.request import Request,urlopen\r\n\u001b[?2004l\r\u001b[?2004h> from urllib.parse import quote\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> ab=open('/app/antibody.fasta').read()\r\n\u001b[?2004l\r\u001b[?2004h> seqs=[];h=None;s=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in ab.splitlines():\r\n\u001b[?2004l\r\u001b[?2004h>  line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>  if line.startswith('>'):\r\n\u001b[?2004l\r\u001b[?2004h>   if h:seqs.append((h,''.join(s)))\r\n\u001b[?2004l\r\u001b[?2004h>   h=line[1:];s=[]\r\n\u001b[?2004l\r\u001b[?2004h>  elif line:s.append(re.sub('[^A-Za-z]','',line).upper())\r\n\u001b[?2004l\r\u001b[?2004h> if h:seqs.append((h,''.join(s)))\r\n\u001b[?2004l\r\u001b[?2004h> queries=[seqs[0][1][:60],seqs[0][1][20:90],seqs[1][1][:60],seqs[1][1][20:90]]\r\n\u001b[?2004l\r\u001b[?2004h> for q in queries:\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\nQUERY',q)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.709019, "o", " for base in ['https://www.google.com/search?q=','https://www.bing.com/search?q=']:\r\n\u001b[?2004l\r\u001b[?2004h>   try:\r\n\u001b[?2004l\r\u001b[?2004h>    t=urlopen(Request(base+quote('\"'+q+'\"'),headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode('utf-8','ignore')\r\n\u001b[?2004l\r\u001b[?2004h>    clean=re.sub('<[^>]+>',' ',t); clean=re.sub(r'\\s+',' ',clean)\r\n\u001b[?2004l\r\u001b[?2004h>    print(base.split('/')[2],len(t),clean[:1200])\r\n\u001b[?2004l\r\u001b[?2004h>   except Exception as e:print('ERR',e)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
