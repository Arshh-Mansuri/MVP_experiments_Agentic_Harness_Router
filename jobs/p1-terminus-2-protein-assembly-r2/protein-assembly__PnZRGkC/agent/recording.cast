[171.928099, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import quote\nimport re,json\n# parse antibody sequences\nrec=[]; h=None; s=[]\nfor line in open('/app/antibody.fasta'):\n line=line.strip()\n if line.startswith('>'):\n  if h: rec.append((h,''.join(s)))\n  h=line[1:];s=[]\n elif line:s.append(re.sub('[^A-Za-z]','',line).upper())\nif h:rec.append((h,''.join(s)))\nfor h,seq in rec:\n print('\\n###',h,len(seq))\n urls=[\n  'https://rest.uniprot.org/uniprotkb/search?query='+quote('sequence:'+seq)+'&format=tsv&fields=accession,id,protein_name,organism_name,length&size=10',\n  'https://rest.uniprot.org/uniparc/search?query='+quote('sequence:'+seq)+'&format=tsv&fields=upi&size=10'\n ]\n for u in urls:\n  try:\n   t=urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=45).read().decode()\n   print(t[:4000])\n  except Exception as e: print('ERR',e)\nPY\n"]
