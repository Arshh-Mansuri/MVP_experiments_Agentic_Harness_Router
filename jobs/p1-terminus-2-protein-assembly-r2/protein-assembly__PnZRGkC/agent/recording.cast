[118.572707, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nimport json\nfor pid in ['2ib5','5jzl','1h6r','4kge','4q7t','2h5q']:\n u=f'https://data.rcsb.org/rest/v1/core/entry/{pid}'\n try:\n  d=json.loads(urlopen(Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read())\n  print('\\n###',pid)\n  print('chem',json.dumps(d.get('rcsb_entry_container_identifiers',{}),indent=2)[:1500])\n  print('expt',json.dumps(d.get('exptl',[]),indent=2)[:500])\n except Exception as e: print(pid,e)\nPY\n"]
