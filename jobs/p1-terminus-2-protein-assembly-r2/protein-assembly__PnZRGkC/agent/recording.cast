[140.275302, "i", "python3 - <<'PY'\nfrom urllib.request import Request,urlopen\nfrom urllib.parse import urlencode\nimport re,json\nab=open('/app/antibody.fasta').read()\nseqs=[]; h=None; s=[]\nfor line in ab.splitlines():\n if line.startswith('>'):\n  if s: seqs.append((''.join(s),h))\n  h=line[1:];s=[]\n else:s.append(re.sub('[^A-Za-z]','',line))\nif s:seqs.append((''.join(s),h))\nfor seq,h in seqs:\n # EBI protein similarity search REST\n data=urlencode({'email':'test@example.org','program':'blastp','stype':'protein','sequence':seq,'database':'uniprotkb'}).encode()\n try:\n  r=urlopen(Request('https://www.ebi.ac.uk/Tools/services/rest/run',data=data,headers={'User-Agent':'Mozilla/5.0'}),timeout=60)\n  job=r.read().decode().strip(); print(h,'JOB',job)\n  open('/tmp/ebi_'+h.replace(' ','_'),'w').write(job)\n except Exception as e: print(h,'ERROR',e)\nPY\n"]
