cd /app && ls -lh metadata.parquet && python3 -c "import pyarrow.parquet as pq; from collections import Counter; p=pq.read_table('metadata.parquet').to_pydict(); print('rows',len(p['domain'])); print('domains',Counter(p['domain'])); print('science',sum(x=='science' for x in p['domain'])); print('reasoning_chars',sum(len(p['deepseek_reasoning'][i] or '') for i,x in enumerate(p['domain']) if x=='science')); print('solution_chars',sum(len(p['deepseek_solution'][i] or '') for i,x in enumerate(p['domain']) if x=='science'))"
python3 - <<'PY'
from transformers import AutoTokenizer
import pyarrow.parquet as pq
p=pq.read_table('/app/metadata.parquet').to_pydict()
tok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')
inds=[i for i,x in enumerate(p['domain']) if str(x).lower()=='science']
for field in ['deepseek_reasoning','deepseek_solution']:
    n=sum(len(tok.encode(p[field][i] or '', add_special_tokens=False)) for i in inds)
    print(field,n)
print('reasoning_plus_solution',sum(len(tok.encode((p['deepseek_reasoning'][i] or '')+(p['deepseek_solution'][i] or ''), add_special_tokens=False)) for i in inds))
