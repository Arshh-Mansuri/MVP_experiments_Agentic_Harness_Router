[95.251533, "i", "cd /app && cat > /tmp/count.py <<'PY'\nimport pyarrow.parquet as pq\nfrom transformers import AutoTokenizer\np=pq.read_table('/app/metadata.parquet').to_pydict()\nscience={'physics','chemistry','biology'}\ninds=[i for i,x in enumerate(p['domain']) if x in science]\nprint('science_records',len(inds), 'domains', {x:sum(p['domain'][i]==x for i in inds) for x in sorted(science)})\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nfor f in ('deepseek_reasoning','deepseek_solution'):\n print(f, sum(len(tok.encode(p[f][i] or '',add_special_tokens=False)) for i in inds))\nprint('concat_no_separator',sum(len(tok.encode((p['deepseek_reasoning'][i] or '')+(p['deepseek_solution'][i] or ''),add_special_tokens=False)) for i in inds))\nprint('concat_newline',sum(len(tok.encode((p['deepseek_reasoning'][i] or '')+'\\n'+(p['deepseek_solution'][i] or ''),add_special_tokens=False)) for i in inds))\nPY\npython3 /tmp/count.py\n"]
[95.253319, "o", "cd /app && cat > /tmp/count.py <<'PY'\r\n"]
