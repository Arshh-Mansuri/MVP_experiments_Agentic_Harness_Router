[39.358906, "i", "cd /app && python3 - <<'PY'\nfrom urllib.request import urlopen\nu='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\nwith urlopen(u,timeout=120) as r, open('metadata.parquet','wb') as f:\n    while True:\n        b=r.read(1024*1024)\n        if not b: break\n        f.write(b)\nprint('downloaded')\nPY\npython3 - <<'PY'\nimport pyarrow.parquet as pq\np=pq.read_table('/app/metadata.parquet')\nprint(p.schema)\nprint('rows',p.num_rows)\nd=p.to_pydict()\nfrom collections import Counter\nprint('domains',Counter(d['domain']))\nfor i,x in enumerate(d['domain']):\n if x=='science':\n  print('first science index',i)\n  for k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\n   print(k,repr(d[k][i][:300] if isinstance(d[k][i],str) else d[k][i]))\n  break\nPY\n"]
[39.359443, "o", "cd /app && python3 - <<'PY'\r\nfrom urllib.request import urlopen\r\nu='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\r\nwith urlopen(u,timeout=120) as r, open('metadata.parquet','wb') as f:\r\n    while True:\r\n        b=r.read(1024*1024)\r\n        if not b: break\r\n        f.write(b)\r\nprint('downloaded')\r\nPY\r\npython3 - <<'PY'\r\nimport pyarrow.parquet as pq\r\np=pq.read_table('/app/metadata.parquet')\r\nprint(p.schema)\r\nprint('rows',p.num_rows)\r\nd=p.to_pydict()\r\nfrom collections import Counter\r\nprint('domains',Counter(d['domain']))\r\nfor i,x in enumerate(d['domain']):\r\n if x=='science':\r\n  print('first science index',i)\r\n  for k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\r\n   print(k,repr(d[k][i][:300] if isinstance(d[k][i],str) else d[k][i]))\r\n  break\r\nPY\r\n"]
[61.833961, "i", "cd /app && ls -lh metadata.parquet && python3 -c \"import pyarrow.parquet as pq; from collections import Counter; p=pq.read_table('metadata.parquet').to_pydict(); print('rows',len(p['domain'])); print('domains',Counter(p['domain'])); print('science',sum(x=='science' for x in p['domain'])); print('reasoning_chars',sum(len(p['deepseek_reasoning'][i] or '') for i,x in enumerate(p['domain']) if x=='science')); print('solution_chars',sum(len(p['deepseek_solution'][i] or '') for i,x in enumerate(p['domain']) if x=='science'))\"\n"]
[61.839672, "o", "cd /app && ls -lh metadata.parquet && python3 -c \"import pyarrow.parquet as pq; from collections import Counter; p=pq.read_table('metadata.parquet').to_pydict(); print('rows',len(p['domain'])); print('domains',Counter(p['domain'])); print('science',sum(x=='science' for x in p['domain'])); print('reasoning_chars',sum(len(p['deepseek_reasoning'][i] or '') for i,x in enumerate(p['domain']) if x=='science')); print('solution_chars',sum(len(p['deepseek_solution'][i] or '') for i,x in enumerate(p['domain']) if x=='science'))\"\r\n"]
[63.632229, "i", "python3 - <<'PY'\nfrom transformers import AutoTokenizer\nimport pyarrow.parquet as pq\np=pq.read_table('/app/metadata.parquet').to_pydict()\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\ninds=[i for i,x in enumerate(p['domain']) if str(x).lower()=='science']\nfor field in ['deepseek_reasoning','deepseek_solution']:\n    n=sum(len(tok.encode(p[field][i] or '', add_special_tokens=False)) for i in inds)\n    print(field,n)\nprint('reasoning_plus_solution',sum(len(tok.encode((p['deepseek_reasoning'][i] or '')+(p['deepseek_solution'][i] or ''), add_special_tokens=False)) for i in inds))\nPY\n"]
[63.635049, "o", "python3 - <<'PY'\r\nfrom transformers import AutoTokenizer\r\nimport pyarrow.parquet as pq\r\np=pq.read_table('/app/metadata.parquet').to_pydict()\r\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\r\ninds=[i for i,x in enumerate(p['domain']) if str(x).lower()=='science']\r\nfor field in ['deepseek_reasoning','deepseek_solution']:\r\n    n=sum(len(tok.encode(p[field][i] or '', add_special_tokens=False)) for i in inds)\r\n    print(field,n)\r\nprint('reasoning_plus_solution',sum(len(tok.encode((p['deepseek_reasoning'][i] or '')+(p['deepseek_solution'][i] or ''), add_special_tokens=False)) for i in inds))\r\nPY\r\n"]
