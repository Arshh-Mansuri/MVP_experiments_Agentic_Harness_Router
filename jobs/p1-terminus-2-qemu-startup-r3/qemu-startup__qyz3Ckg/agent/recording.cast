[36.486704, "i", "rm -f /tmp/alpine-qemu.log /tmp/alpine-qemu.pid; nohup qemu-system-x86_64 -accel tcg,thread=single -cdrom /app/alpine.iso -m 512M -nographic -serial telnet:127.0.0.1:6665,server=on,nowait -monitor none > /tmp/alpine-qemu.log 2>&1 & echo $! > /tmp/alpine-qemu.pid; for i in $(seq 1 60); do if ! kill -0 \"$(cat /tmp/alpine-qemu.pid)\" 2>/dev/null; then echo 'QEMU exited'; cat /tmp/alpine-qemu.log; exit 1; fi; (echo >/dev/tcp/127.0.0.1/6665) >/dev/null 2>&1 && { echo \"QEMU ready on 127.0.0.1:6665 (PID $(cat /tmp/alpine-qemu.pid))\"; exit 0; }; sleep 1; done; echo 'QEMU did not open port 6665'; cat /tmp/alpine-qemu.log; exit 1\n"]
