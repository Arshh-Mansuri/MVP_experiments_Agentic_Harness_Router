[36.224948, "i", "cat /tmp/alpine-qemu.log; echo '--- process ---'; ps aux | grep '[q]emu'; echo '--- qemu version ---'; qemu-system-x86_64 --version; echo '--- kvm ---'; test -e /dev/kvm && ls -l /dev/kvm || echo '/dev/kvm unavailable'\n"]
