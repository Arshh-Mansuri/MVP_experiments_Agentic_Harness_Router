[12.397924, "i", "QEMU_BIN=\"$(command -v qemu-system-x86_64 || command -v qemu-system-i386)\"; nohup \"$QEMU_BIN\" -cdrom /app/alpine.iso -m 512M -nographic -serial telnet:127.0.0.1:6665,server=on,nowait > /tmp/alpine-qemu.log 2>&1 & echo $! > /tmp/alpine-qemu.pid; for i in $(seq 1 60); do (echo >/dev/tcp/127.0.0.1/6665) >/dev/null 2>&1 && { echo \"QEMU ready on 127.0.0.1:6665 (PID $(cat /tmp/alpine-qemu.pid))\"; exit 0; }; sleep 1; done; echo 'QEMU did not open port 6665'; tail -50 /tmp/alpine-qemu.log; exit 1\n"]
