[27.866946, "o", "    if (PyArray_NDIM(weights) != 1 || PyArray_NDIM(returns) != 1) {\r\n\u001b[?2004l\r\u001b[?2004h>         PyErr_SetString(PyExc_ValueError, \"weights and returns must be 1-D\");\r\n\u001b[?2004l\r\u001b[?2004h>         goto fail;\r\n\u001b[?2004l\r\u001b[?2004h"]
