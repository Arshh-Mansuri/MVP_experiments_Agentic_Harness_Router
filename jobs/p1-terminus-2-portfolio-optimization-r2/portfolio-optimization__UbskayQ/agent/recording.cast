[27.91118, "o", "\u001b[?2004h> "]
[27.911901, "o", "\"\"\"Python interface for the optimized portfolio calculations.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from portfolio_optimized_c import (\r\n\u001b[?2004l\r\u001b[?2004h>     portfolio_risk_c as _portfolio_risk_c,\r\n\u001b[?2004l\r"]
[27.911924, "o", "\u001b[?2004h>     portfolio_return_c as _portfolio_return_c,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def portfolio_risk_c(weights, cov_matrix):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Calculate sqrt(weights.T @ cov_matrix @ weights).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.913096, "o", "    w = np.asarray(weights, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     cov = np.asarray(cov_matrix, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     return _portfolio_risk_c(w, cov)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def portfolio_return_c(weights, expected_returns):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Calculate the expected portfolio return.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     w = np.asarray(weights, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     returns = np.asarray(expected_returns, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     return _portfolio_return_c(w, returns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> __all__ = [\"portfolio_risk_c\", \"portfolio_return_c\"]\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[27.939094, "o", "\u001b[?2004hroot@7b24c8591fe7:/app# python3 setup.py build_ext --inplace\r\n\u001b[?2004l\r"]
[29.007907, "i", "python3 - <<'PY'\nfrom portfolio_baseline import generate_test_data, portfolio_risk_python, portfolio_return_python\nfrom portfolio_optimized import portfolio_risk_c, portfolio_return_c\nw, c, r = generate_test_data(20)\npr, pc = portfolio_risk_python(w, c), portfolio_risk_c(w, c)\nrr, rc = portfolio_return_python(w, r), portfolio_return_c(w, r)\nprint('risk', pr, pc, abs(pr-pc))\nprint('return', rr, rc, abs(rr-rc))\nassert abs(pr-pc) < 1e-10\nassert abs(rr-rc) < 1e-10\nPY\n"]
[29.007995, "o", "python3 - <<'PY'\r\nfrom portfolio_baseline import generate_test_data, portfolio_risk_python, portfolio_return_python\r\nfrom portfolio_optimized import portfolio_risk_c, portfolio_return_c\r\nw, c, r = generate_test_data(20)\r\npr, pc = portfolio_risk_python(w, c), portfolio_risk_c(w, c)\r\nrr, rc = portfolio_return_python(w, r), portfolio_return_c(w, r)\r\nprint('risk', pr, pc, abs(pr-pc))\r\nprint('return', rr, rc, abs(rr-rc))\r\nassert abs(pr-pc) < 1e-10\r\nassert abs(rr-rc) < 1e-10\r\nPY\r\n"]
[29.32988, "o", "running build_ext\r\n"]
