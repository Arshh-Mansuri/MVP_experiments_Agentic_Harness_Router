[27.866163, "o", "\r\n\u001b[?2004l\r"]
[27.866245, "o", "\u001b[?2004h> "]
[27.866515, "o", "        returns_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\r\n\u001b[?2004l\r\u001b[?2004h"]
