[27.868139, "o", "    if (PyArray_DIM(returns, 0) != n) {\r\n\u001b[?2004l\r\u001b[?2004h>         PyErr_SetString(PyExc_ValueError,\r\n\u001b[?2004l\r\u001b[?2004h>                         \"weights and returns must have the same length\");\r\n\u001b[?2004l\r\u001b[?2004h>         goto fail;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const double *w = (const double *)PyArray_DATA(weights);\r\n\u001b[?2004l\r\u001b[?2004h>     const double *r = (const double *)PyArray_DATA(returns);\r\n\u001b[?2004l\r\u001b[?2004h>     double total_return = 0.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.868203, "o", "    for (npy_intp i = 0; i < n; ++i)\r\n\u001b[?2004l\r\u001b[?2004h>         total_return += w[i] * r[i];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[27.868581, "o", "\u001b[?2004h> "]
[27.871147, "o", "    Py_DECREF(weights);\r\n\u001b[?2004l\r\u001b[?2004h>     Py_DECREF(returns);\r\n\u001b[?2004l\r\u001b[?2004h>     return PyFloat_FromDouble(total_return);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fail:\r\n\u001b[?2004l\r\u001b[?2004h>     Py_XDECREF(weights);\r\n\u001b[?2004l\r\u001b[?2004h>     Py_XDECREF(returns);\r\n\u001b[?2004l\r\u001b[?2004h>     return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static PyMethodDef module_methods[] = {\r\n\u001b[?2004l\r\u001b[?2004h>     {\"portfolio_risk_c\", portfolio_risk_c, METH_VARARGS,\r\n\u001b[?2004l\r\u001b[?2004h>      \"Calculate portfolio risk\"},\r\n\u001b[?2004l\r\u001b[?2004h>     {\"portfolio_return_c\", portfolio_return_c, METH_VARARGS,\r\n\u001b[?2004l\r\u001b[?2004h>      \"Calculate portfolio return\"},\r\n\u001b[?2004l\r\u001b[?2004h>     {NULL, NULL, 0, NULL}\r\n\u001b[?2004l\r\u001b[?2004h> };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static struct PyModuleDef moduledef = {\r\n\u001b[?2004l\r\u001b[?2004h>     PyModuleDef_HEAD_INIT, \"portfolio_optimized_c\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"Optimized portfolio calculations\", -1, module_methods\r\n\u001b[?2004l\r\u001b[?2004h> };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[27.871187, "o", "\u001b[?2004l\r\u001b[?2004h> PyMODINIT_FUNC PyInit_portfolio_optimized_c(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     import_array();\r\n\u001b[?2004l\r\u001b[?2004h>     return PyModule_Create(&moduledef);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
