[27.855811, "i", "cat > portfolio_optimized.c <<'EOF'\n/* High-performance portfolio calculations using the NumPy C API. */\n#define NPY_NO_DEPRECATED_API NPY_1_7_API_VERSION\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <math.h>\n\nstatic PyObject *portfolio_risk_c(PyObject *self, PyObject *args) {\n    PyObject *weights_obj, *cov_obj;\n    PyArrayObject *weights = NULL, *cov = NULL;\n    if (!PyArg_ParseTuple(args, \"OO\", &weights_obj, &cov_obj))\n        return NULL;\n\n    weights = (PyArrayObject *)PyArray_FROM_OTF(\n        weights_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n    cov = (PyArrayObject *)PyArray_FROM_OTF(\n        cov_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n    if (weights == NULL || cov == NULL)\n        goto fail;\n\n    if (PyArray_NDIM(weights) != 1 || PyArray_NDIM(cov) != 2) {\n        PyErr_SetString(PyExc_ValueError,\n                        \"weights must be 1-D and covariance matrix must be 2-D\");\n        goto fail;\n    }\n    npy_intp n = PyArray_DIM(weights, 0);\n    if (PyArray_DIM(cov, 0) != n || PyArray_DIM("]
[27.855891, "i", "cov, 1) != n) {\n        PyErr_SetString(PyExc_ValueError,\n                        \"covariance matrix dimensions must match weights\");\n        goto fail;\n    }\n\n    const double *w = (const double *)PyArray_DATA(weights);\n    const double *s = (const double *)PyArray_DATA(cov);\n    double risk_squared = 0.0;\n    for (npy_intp i = 0; i < n; ++i) {\n        const double *row = s + i * n;\n        double row_sum = 0.0;\n        for (npy_intp j = 0; j < n; ++j)\n            row_sum += row[j] * w[j];\n        risk_squared += w[i] * row_sum;\n    }\n\n    Py_DECREF(weights);\n    Py_DECREF(cov);\n    return PyFloat_FromDouble(sqrt(risk_squared));\n\nfail:\n    Py_XDECREF(weights);\n    Py_XDECREF(cov);\n    return NULL;\n}\n\nstatic PyObject *portfolio_return_c(PyObject *self, PyObject *args) {\n    PyObject *weights_obj, *returns_obj;\n    PyArrayObject *weights = NULL, *returns = NULL;\n    if (!PyArg_ParseTuple(args, \"OO\", &weights_obj, &returns_obj))\n        return NULL;\n\n    weights = (PyArrayObject *)PyArray_FROM_OTF(\n        weig"]
[27.856278, "i", "hts_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n    returns = (PyArrayObject *)PyArray_FROM_OTF(\n        returns_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n    if (weights == NULL || returns == NULL)\n        goto fail;\n\n    if (PyArray_NDIM(weights) != 1 || PyArray_NDIM(returns) != 1) {\n        PyErr_SetString(PyExc_ValueError, \"weights and returns must be 1-D\");\n        goto fail;\n    }\n    npy_intp n = PyArray_DIM(weights, 0);\n    if (PyArray_DIM(returns, 0) != n) {\n        PyErr_SetString(PyExc_ValueError,\n                        \"weights and returns must have the same length\");\n        goto fail;\n    }\n\n    const double *w = (const double *)PyArray_DATA(weights);\n    const double *r = (const double *)PyArray_DATA(returns);\n    double total_return = 0.0;\n    for (npy_intp i = 0; i < n; ++i)\n        total_return += w[i] * r[i];\n\n    Py_DECREF(weights);\n    Py_DECREF(returns);\n    return PyFloat_FromDouble(total_return);\n\nfail:\n    Py_XDECREF(weights);\n    Py_XDECREF(returns);\n    return NULL;\n}\n\nstatic PyMethodDef mod"]
