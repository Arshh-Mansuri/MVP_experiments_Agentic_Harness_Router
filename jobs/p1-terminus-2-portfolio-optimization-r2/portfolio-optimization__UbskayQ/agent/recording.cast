[222.129323, "i", "cat > portfolio_optimized.c <<'EOF'\n#define NPY_NO_DEPRECATED_API NPY_1_7_API_VERSION\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <math.h>\n\nstatic PyObject *portfolio_risk_c(PyObject *self, PyObject *args) {\n    PyObject *w_obj, *s_obj;\n    if (!PyArg_ParseTuple(args, \"OO\", &w_obj, &s_obj)) return NULL;\n\n    if (PyArray_Check(w_obj) && PyArray_Check(s_obj)) {\n        PyArrayObject *w = (PyArrayObject *)PyArray_FROM_OTF(w_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n        PyArrayObject *s = (PyArrayObject *)PyArray_FROM_OTF(s_obj, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);\n        if (!w || !s) { Py_XDECREF(w); Py_XDECREF(s); return NULL; }\n        if (PyArray_NDIM(w) != 1 || PyArray_NDIM(s) != 2 ||\n            PyArray_DIM(s, 0) != PyArray_DIM(w, 0) ||\n            PyArray_DIM(s, 1) != PyArray_DIM(w, 0)) {\n            PyErr_SetString(PyExc_ValueError, \"invalid portfolio dimensions\");\n            Py_DECREF(w); Py_DECREF(s); return NULL;\n        }\n        npy_intp n = PyArray_DIM(w, 0);\n        const double *wp "]
