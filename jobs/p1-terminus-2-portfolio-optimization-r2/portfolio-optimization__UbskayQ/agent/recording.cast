[222.192908, "o", "    # the matrix and can exhaust memory. The C extension handles both paths.\r\n\u001b[?2004l\r\u001b[?2004h>     if not isinstance(weights, list) or not isinstance(cov_matrix, list):\r\n\u001b[?2004l\r\u001b[?2004h>         weights = np.asarray(weights, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>         cov_matrix = np.asarray(cov_matrix, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     return _risk(weights, cov_matrix)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def portfolio_return_c(weights, expected_returns):\r\n\u001b[?2004l\r"]
[222.210605, "o", "\u001b[?2004h>     if not isinstance(weights, list) or not isinstance(expected_returns, list):\r\n\u001b[?2004l\r\u001b[?2004h>         weights = np.asarray(weights, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>         expected_returns = np.asarray(expected_returns, dtype=np.float64, order=\"C\")\r\n\u001b[?2004l\r\u001b[?2004h>     return _return(weights, expected_returns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> __all__ = [\"portfolio_risk_c\", \"portfolio_return_c\"]\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
