[39.942868, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nbg=[(240,217,181),(181,136,99)]\nsq=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5','e5','h5','a3','c3']\nfor name in sq:\n c=ord(name[0])-97; r=8-int(name[1]); x0,y0=c*80,r*80; base=bg[(r+c)%2]\n print('\\n###',name)\n for j in range(16):\n  s=''\n  for i in range(16):\n   best=(0,(0,0,0))\n   for yy in range(y0+j*5,y0+(j+1)*5):\n    for xx in range(x0+i*5,x0+(i+1)*5):\n     p=im.getpixel((xx,yy)); d=sum(abs(p[k]-base[k]) for k in range(3))\n     if d>best[0]: best=(d,p)\n   d,p=best\n   if d<35: ch=' '\n   elif sum(p)<220: ch='#'\n   elif min(p)>225: ch='@'\n   elif sum(p)<430: ch='+'\n   else: ch='.'\n   s+=ch\n  print(s)\nPY\n"]
[39.945847, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('/app/chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> bg=[(240,217,181),(181,136,99)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
