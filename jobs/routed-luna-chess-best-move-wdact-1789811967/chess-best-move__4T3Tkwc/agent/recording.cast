[20.204663, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('L')\n# Render each square's inner area, normalized against its square background.\nfor r in range(8):\n  print('\\nRANK',8-r)\n  for yy in range(8):\n    line=[]\n    for c in range(8):\n      x0,y0=c*80,r*80\n      vals=[]\n      for xx in range(8):\n        x=x0+12+xx*56//8; y=y0+12+yy*56//8\n        vals.append(im.getpixel((x,y)))\n      # map darkness; pieces show as dark deviations\n      line.append(''.join('##' if v<70 else '++' if v<120 else '..' if v<180 else '  ' for v in vals))\n    print(' '.join(line))\nPY\n"]
