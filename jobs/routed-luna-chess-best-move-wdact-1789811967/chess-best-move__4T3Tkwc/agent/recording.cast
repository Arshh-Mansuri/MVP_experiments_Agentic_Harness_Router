[13.130512, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nim=Image.open('/app/chess_board.png').convert('L')\na=np.array(im)\nprint('range',a.min(),a.max())\n# coarse grayscale preview\nchars=' .:-=+*#%@'\nfor row in np.array_split(a, min(40,a.shape[0]), axis=0):\n    vals=row.mean(axis=0)\n    vals=vals[::max(1,len(vals)//80)]\n    print(''.join(chars[int(v)*len(chars)//256 if int(v)<256 else -1] for v in vals))\nPY\n"]
