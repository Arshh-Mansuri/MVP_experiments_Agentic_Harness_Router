[33.481856, "o", "\u001b[?2004hroot@44e2a3447f5a:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.482445, "o", "from PIL import Image\r\n\u001b[?2004l\r"]
[33.482835, "o", "\u001b[?2004h> "]
[33.483338, "o", "im=Image.open('/app/chess_board.png').convert('RGB')\r\n\u001b[?2004l\r"]
[33.483431, "o", "\u001b[?2004h> bg=[(240,217,181),(181,136,99)]"]
[33.484388, "o", "\r\n\u001b[?2004l\r"]
[33.485931, "o", "\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>   for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     x0,y0=c*80,r*80; base=bg[(r+c)%2]\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'\\n{chr(97+c)}{8-r}')\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>       s=''\r\n\u001b[?2004l\r\u001b[?2004h>       for i in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for yy in range(y0+j*5,y0+(j+1)*5):\r\n\u001b[?2004l\r\u001b[?2004h>           for xx in range(x0+i*5,x0+(i+1)*5):\r\n\u001b[?2004l\r\u001b[?2004h>             p=im.getpixel((xx,yy)); d=sum(abs(p[k]-base[k]) for k in range(3))\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.486506, "o", "> "]
[33.486807, "o", "            vals.append((d,p))\r\n\u001b[?2004l\r"]
[33.487038, "o", "\u001b[?2004h> "]
[33.487296, "o", "        d,p=max(vals,key=lambda z:z[0])\r\n\u001b[?2004l\r"]
[33.487929, "o", "\u001b[?2004h>         if d<35: ch=' '\r\n\u001b[?2004l\r\u001b[?2004h>         elif sum(p)<220: ch='#'\r\n\u001b[?2004l\r\u001b[?2004h>         elif min(p)>225: ch='@'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.48822, "o", "        elif sum(p)<430: ch='+'"]
[33.489042, "o", "\r\n\u001b[?2004l\r"]
[33.489088, "o", "\u001b[?2004h>         else: ch='.'\r\n\u001b[?2004l\r\u001b[?2004h>         s+=ch\r\n\u001b[?2004l\r\u001b[?2004h>       print(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
