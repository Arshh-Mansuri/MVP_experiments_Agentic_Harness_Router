[31.537484, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nbg=[(240,217,181),(181,136,99)]\nfor r in range(8):\n  out=[]\n  for c in range(8):\n    x0,y0=c*80,r*80; base=bg[(r+c)%2]\n    pts=[]\n    for y in range(y0+4,y0+76):\n      for x in range(x0+4,x0+76):\n        p=im.getpixel((x,y))\n        # deviation from board color; exclude mild antialiasing\n        d=sum(abs(p[i]-base[i]) for i in range(3))\n        if d>45: pts.append((x,y,p))\n    if pts:\n      xs=[p[0] for p in pts]; ys=[p[1] for p in pts]\n      dark=sum(1 for _,_,p in pts if sum(p)<300)\n      white=sum(1 for _,_,p in pts if min(p)>220)\n      out.append(f'{chr(97+c)}{8-r}:n{len(pts)} box{min(xs)-x0},{min(ys)-y0}-{max(xs)-x0},{max(ys)-y0} d{dark} w{white}')\n  print(' | '.join(out) or '(empty)')\nPY\n"]
