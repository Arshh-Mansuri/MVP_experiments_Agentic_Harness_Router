[32.273491, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nbg=[(240,217,181),(181,136,99)]\nfor r in range(8):\n  for c in range(8):\n    x0,y0=c*80,r*80; base=bg[(r+c)%2]\n    print(f'\\n{chr(97+c)}{8-r}')\n    for j in range(16):\n      s=''\n      for i in range(16):\n        vals=[]\n        for yy in range(y0+j*5,y0+(j+1)*5):\n          for xx in range(x0+i*5,x0+(i+1)*5):\n            p=im.getpixel((xx,yy)); d=sum(abs(p[k]-base[k]) for k in range(3))\n            vals.append((d,p))\n        d,p=max(vals,key=lambda z:z[0])\n        if d<35: ch=' '\n        elif sum(p)<220: ch='#'\n        elif min(p)>225: ch='@'\n        elif sum(p)<430: ch='+'\n        else: ch='.'\n        s+=ch\n      print(s)\nPY\n"]
[32.275437, "o", "python3 - <<'PY'\r\nfrom PIL import Image\r\nim=Image.open('/app/chess_board.png').convert('RGB')\r\nbg=[(240,217,181),(181,136,99)]\r\nfor r in range(8):\r\n  for c in range(8):\r\n    x0,y0=c*80,r*80; base=bg[(r+c)%2]\r\n    print(f'\\n{chr(97+c)}{8-r}')\r\n    for j in range(16):\r\n      s=''\r\n      for i in range(16):\r\n        vals=[]\r\n        for yy in range(y0+j*5,y0+(j+1)*5):\r\n          for xx in range(x0+i*5,x0+(i+1)*5):\r\n            p=im.getpixel((xx,yy)); d=sum(abs(p[k]-base[k]) for k in range(3))\r\n            vals.append((d,p))\r\n        d,p=max(vals,key=lambda z:z[0])\r\n        if d<35: ch=' '\r\n        elif sum(p)<220: ch='#'\r\n        elif min(p)>225: ch='@'\r\n        elif sum(p)<430: ch='+'\r\n        else: ch='.'\r\n        s+=ch\r\n      print(s)\r\nPY\r\n"]
