[?2004l[?2004h>       for x in range(x0+4,x0+76):
[?2004l[?2004h>         p=im.getpixel((x,y))
[?2004l[?2004h>         # deviation from board color; exclude mild antialiasing
[?2004l[?2004h>         d=sum(abs(p[i]-base[i]) for i in range(3))
[?2004l[?2004h>         if d>45: pts.append((x,y,p))
