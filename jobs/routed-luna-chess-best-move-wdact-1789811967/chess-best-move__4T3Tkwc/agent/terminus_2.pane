[?2004lpython3 - <<'PY'
from PIL import Image
im=Image.open('/app/chess_board.png').convert('RGB')
bg=[(240,217,181),(181,136,99)]
for r in range(8):
  for c in range(8):
    x0,y0=c*80,r*80; base=bg[(r+c)%2]
    print(f'\n{chr(97+c)}{8-r}')
    for j in range(16):
      s=''
      for i in range(16):
        vals=[]
        for yy in range(y0+j*5,y0+(j+1)*5):
          for xx in range(x0+i*5,x0+(i+1)*5):
            p=im.getpixel((xx,yy)); d=sum(abs(p[k]-base[k]) for k in range(3))
            vals.append((d,p))
        d,p=max(vals,key=lambda z:z[0])
        if d<35: ch=' '
        elif sum(p)<220: ch='#'
        elif min(p)>225: ch='@'
        elif sum(p)<430: ch='+'
        else: ch='.'
        s+=ch
      print(s)
