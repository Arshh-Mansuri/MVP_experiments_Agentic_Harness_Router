[?2004l[?2004h>       white=sum(1 for _,_,p in pts if min(p)>220)
[?2004l[?2004h>       out.append(f'{chr(97+c)}{8-r}:n{len(pts)} box{min(xs)-x0},{min(ys)-y0}-{max(xs)-x0},{max(ys)-y0} d{dark} w{white}')
