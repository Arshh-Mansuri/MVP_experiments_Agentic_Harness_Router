[63.265773, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('input.tex')\ns=p.read_text()\nrepls={\n    'curious':'odd',\n    'riotous':'wild',\n    'excursions':'trips',\n    'responsiveness':'reaction',\n    'temperament':'mood',\n    'pathfinder':'scout',\n}\nimport re\nfor old,new in repls.items():\n    s=re.sub(r'\\b'+re.escape(old)+r'\\b',new,s)\np.write_text(s)\nPY\npdflatex -interaction=nonstopmode -halt-on-error main.tex >/tmp/pdflatex.out 2>&1; rc=$?; echo \"pdflatex_exit=$rc\"; grep -n 'Overfull \\\\hbox' main.log || echo 'No overfull hbox warnings'; tail -25 /tmp/pdflatex.out\n"]
