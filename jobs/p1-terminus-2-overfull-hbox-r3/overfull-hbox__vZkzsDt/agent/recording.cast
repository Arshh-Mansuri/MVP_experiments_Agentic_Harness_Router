[217.255291, "i", "cat > /tmp/exhaust2.py <<'PY'\nfrom pathlib import Path\nimport re, subprocess\np=Path('input.tex')\nfams=[]\nfor line in Path('synonyms.txt').read_text().splitlines():\n    ws=re.findall(r\"[A-Za-z]+(?:'[A-Za-z]+)?\",line.lower())\n    if len(ws)>1: fams.append(set(ws))\nlookup={}\nfor f in fams:\n    for w in f: lookup.setdefault(w,set()).update(f-{w})\ntok=re.compile(r\"[A-Za-z]+(?:'[A-Za-z]+)?\")\n\ndef score():\n    subprocess.run(['pdflatex','-interaction=nonstopmode','-halt-on-error','main.tex'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=20)\n    log=Path('main.log').read_text(errors='ignore')\n    xs=[float(x) for x in re.findall(r'Overfull .*?\\(([0-9.]+)pt too wide',log)]\n    return (len(xs),sum(xs),max(xs,default=0.0)),xs\n\ncur=p.read_text(); best,vals=score(); print('start',best,vals,flush=True)\nfor rnd in range(10):\n    pos=cur.find('unsought')\n    a=cur.rfind('\\n\\n',0,pos)+2\n    z=cur.find('\\n\\n',pos)\n    if z<0: z=len(cur)\n    para=cur[a:z]\n    candidates=[]\n    for m in tok.finditer(para):\n        old=m.group(0)\n        for alt in sorted(lookup.get(old.lower(),())):\n            new=alt.capitalize() if old[:1].isupper() else alt\n            candidates.append((a+m.start(),a+m.end(),old,new))\n    found=None\n    for x,y,old,new in candidates:\n        trial=cur[:x]+new+cur[y:]\n        p.write_text(trial)\n        sc,vs=score()\n        if sc<best:\n            found=(trial,sc,vs,old,new)\n            break\n    if not found:\n        p.write_text(cur)\n        print('no further improvement',best,vals,flush=True)\n        break\n    cur,best,vals,old,new=found\n    p.write_text(cur)\n    print('accepted',old,'->',new,best,vals,flush=True)\n    if best[0]==0: break\nprint('FINAL',score(),flush=True)\nPY\npython3 /tmp/exhaust2.py\npdflatex -interaction=nonstopmode -halt-on-error main.tex >/tmp/final.out 2>&1; rc=$?; echo \"pdflatex_exit=$rc\"; if grep -q 'Overfull \\\\hbox' main.log; then grep 'Overfull \\\\hbox' main.log; else echo 'No overfull hbox warnings'; fi\n"]
