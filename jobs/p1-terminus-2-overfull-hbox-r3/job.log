Sending keys: ['cat > /tmp/search_fix.py <<\'PY\'\nfrom pathlib import Path\nimport re, subprocess\nsrc=Path(\'input.tex\').read_text()\n# Parse allowed synonym families.\nfams=[]\nfor line in Path(\'synonyms.txt\').read_text().splitlines():\n    ws=re.findall(r"[A-Za-z]+(?:\'[A-Za-z]+)?",line.lower())\n    if len(ws)>1: fams.append(set(ws))\nlookup={}\nfor f in fams:\n    for w in f: lookup.setdefault(w,set()).update(f-{w})\ntok=re.compile(r"[A-Za-z]+(?:\'[A-Za-z]+)?")\n\ndef score(text):\n    Path(\'input.tex\').write_text(text)\n    subprocess.run([\'pdflatex\',\'-interaction=nonstopmode\',\'-halt-on-error\',\'main.tex\'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=20)\n    log=Path(\'main.log\').read_text(errors=\'ignore\')\n    xs=[float(x) for x in re.findall(r\'Overfull \\\\hbox \\(([0-9.]+)pt too wide\',log)]\n    return (len(xs),sum(xs)),xs\n\ncur=src\nbest, widths=score(cur)\nprint(\'initial\',best,widths,flush=True)\n# Work paragraph-by-paragraph, focusing on the two paragraphs named by the log.\nfor target in (\'unsought\',\'cooked\'):\n    # Repeatedly try every legal substitution in the paragraph containing target.\n    for iteration in range(3):\n        para_start=cur.rfind(\'\\n\\n\',0,cur.find(target))+2\n        para_end=cur.find(\'\\n\\n\',cur.find(target))\n        if para_end<0: para_end=len(cur)\n        para=cur[para_start:para_end]\n        candidates=[]\n        for m in list(tok.finditer(para)):\n            w=m.group(0); alts=lookup.get(w.lower(),())\n            for alt in alts:\n                repl=alt.capitalize() if w[0].isupper() else alt\n                candidates.append((para_start+m.start(),para_start+m.end(),w,repl))\n        improved=False\n        for a,b,w,repl in candidates:\n            trial=cur[:a]+repl+cur[b:]\n            sc,ws=score(trial)\n            if sc<best:\n                print(\'accept\',w,\'->\',repl,sc,ws,flush=True)\n                cur=trial; best=sc; improved=True\n                break\n        if not improved: break\n        if best[0]==0: break\n    if best[0]==0: break\nPath(\'input.tex\').write_text(cur)\nprint(\'final\',score(cur),flush=True)\nPY\npython3 /tmp/search_fix.py\npdflatex -interaction=nonstopmode -halt-on-error main.tex >/tmp/final.out 2>&1; rc=$?; echo "pdflatex_exit=$rc"; if grep -q \'Overfull \\\\hbox\' main.log; then grep \'Overfull \\\\hbox\' main.log; else echo \'No overfull hbox warnings\'; fi\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
