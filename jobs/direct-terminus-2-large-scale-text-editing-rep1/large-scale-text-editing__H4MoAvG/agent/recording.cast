[15.659197, "i", "cp input.csv input.csv.orig\ncat > apply_macros.vim <<'EOF'\ncall setreg('a', \":s/^\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*,\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*,\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*$/\\\\3;\\\\2;\\\\1;OK/\\rgUU\")\ncall setreg('b', \"0\")\ncall setreg('c', \"$\")\n:%normal! @a\n:%normal! @b\n:%normal! @c\n:wq\nEOF\nvim -Nu NONE -n -Es input.csv -S apply_macros.vim\nrc=$?; echo vim_rc=$rc; cmp -s input.csv expected.csv; echo cmp_rc=$?; echo '--- script ---'; cat apply_macros.vim; echo '--- checks ---'; wc -c apply_macros.vim; test $rc -eq 0 && cmp -s input.csv expected.csv && echo SUCCESS\n"]
