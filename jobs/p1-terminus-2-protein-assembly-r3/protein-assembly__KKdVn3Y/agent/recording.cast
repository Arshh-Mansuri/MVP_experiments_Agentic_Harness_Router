[858.472, "i", "python3 - <<'PY'\nimport json,urllib.request\nfor pid in ['1ZAN','2AEP','2ADF','2G2R','2G5B','3BKC','3BKJ','3BKM','4HDI']:\n try:\n  d=json.load(urllib.request.urlopen('https://data.rcsb.org/rest/v1/core/entry/'+pid,timeout=30))\n  print('\\n###',pid,d.get('struct',{}).get('title'))\n  for e in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=json.load(urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{e}',timeout=30))\n   s=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','').replace(' ','')\n   print(e,x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'LEN',len(s),'SEQ',s[:120])\n except Exception as ex: print(pid,'ERROR',ex)\nPY\n"]
