[590.829069, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\nfor rid in ['C5X1H706014','C5X6HZ1S014']:\n for fmt in ['SearchInfo','XML','Text']:\n  u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_TYPE':fmt,'FORMAT_OBJECT':'Alignment'})\n  s=urllib.request.urlopen(u,timeout=60).read().decode(errors='ignore')\n  print(rid,fmt,'len',len(s),'waiting',('Status=WAITING' in s),'ready',('Status=READY' in s),'hits',re.findall(r'<Hit_def>(.*?)</Hit_def>',s)[:3])\n  if 'Status=READY' in s or '<BlastOutput>' in s: open('/tmp/'+rid+'.'+fmt,'w').write(s)\nPY\n"]
