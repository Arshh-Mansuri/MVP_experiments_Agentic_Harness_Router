[34.157732, "i", "command -v curl; command -v jq || true; python3 - <<'PY'\nimport json,urllib.request\nprint('stdlib json/urllib available')\nids=open('/app/pdb_ids.txt').read().split()\nfor pid in ids:\n try:\n  with urllib.request.urlopen('https://data.rcsb.org/rest/v1/core/entry/'+pid,timeout=20) as r: d=json.load(r)\n  title=d.get('struct',{}).get('title','')\n  ents=d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[])\n  print('\\n'+pid+' '+title)\n  for e in ents:\n   with urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{e}',timeout=20) as r: x=json.load(r)\n   desc=x.get('rcsb_polymer_entity',{}).get('pdbx_description')\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   print(e,desc,'length',len(seq),'sequence',seq)\n except Exception as ex: print(pid,'ERROR',repr(ex))\nPY\n"]
