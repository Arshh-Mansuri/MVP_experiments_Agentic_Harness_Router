[937.867284, "i", "python3 - <<'PY'\nimport json,urllib.request\nfor pid in ['2AEP','5WJ2','2H5Q','3KZY']:\n d=json.load(urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/entry/{pid}',timeout=30))\n print('\\n',pid)\n for e in d.get('rcsb_entry_container_identifiers',{}).get('non_polymer_entity_ids',[]):\n  x=json.load(urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{e}',timeout=30))\n  print('NONPOLY',e,x.get('pdbx_entity_nonpoly',{}))\nPY\n"]
