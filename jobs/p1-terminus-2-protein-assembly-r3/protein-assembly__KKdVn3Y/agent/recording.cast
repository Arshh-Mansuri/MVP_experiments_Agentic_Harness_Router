[251.35534, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\nrid='C5X1H706014'\nfor params in [\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML','FORMAT_OBJECT':'Alignment'},\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML'},\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'Text','FORMAT_OBJECT':'Alignment'}]:\n u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(params)\n s=urllib.request.urlopen(u,timeout=60).read().decode(errors='ignore')\n print('PARAMS',params,'LEN',len(s),'XML',s.lstrip().startswith('<?xml'),'WAIT',('Status=WAITING' in s))\n print(re.findall(r'<Hit_def>(.*?)</Hit_def>',s)[:10])\n print(re.findall(r'\\n(?:gi\\|[^\\n]+|[A-Z0-9_]+\\.[0-9]+[^\\n]*)',s)[:5])\n open('/tmp/blast_'+str(len(s))+'.out','w').write(s)\nPY\n"]
[251.356639, "o", "python3 - <<'PY'\r\nimport urllib.request,urllib.parse,re\r\nrid='C5X1H706014'\r\nfor params in [\r\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML','FORMAT_OBJECT':'Alignment'},\r\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML'},\r\n {'CMD':'Get','RID':rid,'FORMAT_TYPE':'Text','FORMAT_OBJECT':'Alignment'}]:\r\n u='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(params)\r\n s=urllib.request.urlopen(u,timeout=60).read().decode(errors='ignore')\r\n print('PARAMS',params,'LEN',len(s),'XML',s.lstrip().startswith('<?xml'),'WAIT',('Status=WAITING' in s))\r\n print(re.findall(r'<Hit_def>(.*?)</Hit_def>',s)[:10])\r\n print(re.findall(r'\\n(?:gi\\|[^\\n]+|[A-Z0-9_]+\\.[0-9]+[^\\n]*)',s)[:5])\r\n open('/tmp/blast_'+str(len(s))+'.out','w').write(s)\r\nPY\r\n"]
