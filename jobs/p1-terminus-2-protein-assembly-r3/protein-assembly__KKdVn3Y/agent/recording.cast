[16.234107, "i", "python3 - <<'PY'\nfrom Bio import SeqIO\np=SeqIO.read('/app/plasmid.gb','genbank')\nprint('record length',len(p.seq))\nfor i,f in enumerate(p.features):\n    print('\\nFEATURE',i,f.type,f.location)\n    for k,v in f.qualifiers.items(): print(' ',k, v)\n    if f.type=='CDS':\n        print('DNA',f.extract(p.seq))\n        print('TRANSLATION',f.qualifiers.get('translation'))\nPY\n"]
