[358.172646, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/gblock.txt')\nassert p.is_file(), 'gBlock file missing'\ns=p.read_text()\nseq=s[:-1] if s.endswith('\\n') else s\nprint('newline_count',s.count('\\n'))\nprint('nt_length',len(seq))\nprint('valid_dna',bool(seq) and set(seq)<=set('ACGT'))\nprint('gc_min',min(sum(c in 'GC' for c in seq[i:i+50])*2 for i in range(len(seq)-49)))\nprint('gc_max',max(sum(c in 'GC' for c in seq[i:i+50])*2 for i in range(len(seq)-49)))\nassert s.count('\\n')==1 and s.endswith('\\n')\nassert '\\n' not in seq and seq and set(seq)<=set('ACGT')\nassert len(seq)<=3000\nassert all(30<=sum(c in 'GC' for c in seq[i:i+50])*2<=70 for i in range(len(seq)-49))\nprint('VALID')\nPY\n"]
