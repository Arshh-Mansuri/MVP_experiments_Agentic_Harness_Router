[455.533941, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\nqs=['\"GYSFTTYTIH\" antibody','\"GYDYWGQGATL\"','\"QGSHVPYTFGGGTK\"','\"YINPSSGYAAYNQNF\" antibody','\"KVSNRFSGVPDRFSGSGSG\"']\nfor q in qs:\n u='https://www.google.com/search?q='+urllib.parse.quote(q)\n req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n s=urllib.request.urlopen(req,timeout=30).read().decode(errors='ignore')\n txt=re.sub('<[^>]+>',' ',s)\n txt=re.sub(r'\\\\x..',' ',txt)\n print('\\nQUERY',q)\n for m in re.finditer('antib',txt,re.I): print(re.sub(r'\\s+',' ',txt[max(0,m.start()-180):m.start()+400])[:580])\nPY\n"]
