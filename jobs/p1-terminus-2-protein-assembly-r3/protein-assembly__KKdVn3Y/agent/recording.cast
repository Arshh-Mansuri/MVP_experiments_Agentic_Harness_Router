[403.960387, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse\nqueries=['Clover FPbase','mCherry FPbase','Kusabira Orange FPbase','Azami Green FPbase','TagRFP FPbase']\nfor q in queries:\n u='https://www.google.com/search?q='+urllib.parse.quote(q)\n try:\n  req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n  s=urllib.request.urlopen(req,timeout=20).read().decode(errors='ignore')\n  print('\\nQUERY',q,'LEN',len(s))\n  for term in ['excitation','emission','505','610']:\n   i=s.lower().find(term.lower()); print(term, s[i:i+300] if i>=0 else '-')\n except Exception as e: print(e)\nPY\n"]
