[927.815565, "i", "python3 - <<'PY'\nimport urllib.parse,urllib.request,json\nsm='Nc3nc(OCc1ccccc1)c2nc[nH]c2n3'\nu='https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/smiles/'+urllib.parse.quote(sm,safe='')+'/property/IUPACName,Title,CanonicalSMILES,IsomericSMILES/JSON'\ntry:\n d=json.load(urllib.request.urlopen(u,timeout=30)); print(json.dumps(d,indent=2))\nexcept Exception as e: print('ERROR',e)\nPY\n"]
