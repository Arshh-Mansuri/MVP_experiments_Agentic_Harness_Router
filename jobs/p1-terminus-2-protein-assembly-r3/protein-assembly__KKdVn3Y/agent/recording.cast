[357.003221, "o", "\u001b[?2004h> "]
[357.003382, "o", "import random\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.003616, "o", "# GFP antigen recognized by the supplied anti-GFP antibody (EGFP/common GFP variant), without initial M.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.003838, "o", "gfp='SKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFSYGVQCFSRYPDHMKQHDFFKSAMPEGYVQERTIFFKDDGNYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNIEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSTQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\r\n\u001b[?2004l\r"]
[357.003983, "o", "\u001b[?2004h> # Clover core from 5WJ2, excluding crystallization/tag residues and initial M.\r\n\u001b[?2004l\r"]
[357.004057, "o", "\u001b[?2004h> "]
[357.004292, "o", "clover='SKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFGYGLMCFARYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\r\n\u001b[?2004l\r"]
[357.0044, "o", "\u001b[?2004h> "]
[357.004569, "o", "dhfr='ISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.004889, "o", "mcherry='VSKGEEDNMAIIKEFMRFKVHMEGSVNGHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFXSKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQDSSLQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'.replace('X','Q')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.005116, "o", "snap='PGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'\r\n\u001b[?2004l\r"]
[357.005135, "o", "\u001b[?2004h> "]
[357.005244, "o", "link='GSGSG'\r\n\u001b[?2004l\r\u001b[?2004h> parts=[gfp,clover,dhfr,mcherry,snap]\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.005269, "o", "> "]
[357.00528, "o", "for s in parts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.005375, "o", "> "]
[357.005534, "o", " assert s and s[0]!='M' and all(c in 'ACDEFGHIKLMNPQRSTVWY' for c in s)\r\n\u001b[?2004l\r\u001b[?2004h> aa=link.join(parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.005617, "o", "# Codons selected to be GC-moderate and suitable for E. coli expression.\r\n\u001b[?2004l\r"]
[357.005808, "o", "\u001b[?2004h> cod={\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.006199, "o", "'A':['GCT','GCC'],'C':['TGC','TGT'],'D':['GAT','GAC'],'E':['GAA','GAG'],'F':['TTC','TTT'],'G':['GGC','GGT','GGA','GGG'],'H':['CAT','CAC'],'I':['ATC','ATT','ATA'],'K':['AAA','AAG'],'L':['CTG','CTT','TTA','TTG'],'M':['ATG'],'N':['AAC','AAT'],'P':['CCG','CCT','CCA','CCC'],'Q':['CAG','CAA'],'R':['CGT','CGC','AGA','AGG'],'S':['AGC','TCC','TCT','TCA','TCG'],'T':['ACC','ACT','ACA','ACG'],'V':['GTG','GTT','GTA','GTC'],'W':['TGG'],'Y':['TAC','TAT']}\r\n\u001b[?2004l\r"]
[357.006374, "o", "\u001b[?2004h> def gc(s): return sum(x in 'GC' for x in s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.006601, "o", "# Choose codons by repeatedly minimizing violations and distance from 50% GC in all affected windows.\r\n\u001b[?2004l\r\u001b[?2004h> out=[]\r\n\u001b[?2004l\r\u001b[?2004h> for i,aa0 in enumerate(aa):\r\n\u001b[?2004l\r\u001b[?2004h>  opts=cod[aa0]\r\n\u001b[?2004l\r"]
[357.006781, "o", "\u001b[?2004h>  best=None\r\n\u001b[?2004l\r\u001b[?2004h>  for c in opts:\r\n\u001b[?2004l\r\u001b[?2004h>   trial=''.join(out)+c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.006938, "o", "  score=0\r\n\u001b[?2004l\r\u001b[?2004h>   for j in range(max(0,len(trial)-50),len(trial)-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007008, "o", "   w=trial[j:j+50]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007098, "o", "   if len(w)==50: score += max(0,30-gc(w))**2+max(0,gc(w)-35)**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007164, "o", "  score += abs(gc(c)-1.5)*0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.00726, "o", "  if best is None or score<best[0]: best=(score,c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007318, "o", " out.append(best[1])\r\n\u001b[?2004l\r"]
[357.007347, "o", "\u001b[?2004h> dna=''.join(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007451, "o", "print('aa length',len(aa),'nt length',len(dna))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.00768, "o", "print('parts',list(map(len,parts)),'linker',len(link))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007791, "o", "print('gc range',min(gc(dna[i:i+50])*2 for i in range(len(dna)-49)),'to',max(gc(dna[i:i+50])*2 for i in range(len(dna)-49)))\r\n\u001b[?2004l\r\u001b[?2004h> assert len(dna)<=3000\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.007934, "o", "assert all(30<=gc(dna[i:i+50)*100/50<=70 for i in range(len(dna)-49))\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/gblock.txt','w').write(dna+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
