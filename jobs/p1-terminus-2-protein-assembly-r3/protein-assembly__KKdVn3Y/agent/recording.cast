[835.100794, "i", "python3 - <<'PY'\nimport urllib.request,json\nfor acc in ['P84751','P84750']:\n d=json.load(urllib.request.urlopen(f'https://rest.uniprot.org/uniprotkb/{acc}.json',timeout=30))\n print('\\n',acc)\n print('names',d.get('proteinDescription'))\n print('sequence',d.get('sequence',{}).get('value'))\n print('comments')\n for c in d.get('comments',[]): print(c)\n print('refs')\n for r in d.get('references',[]): print(r.get('citation',{}).get('title'),r.get('citation',{}).get('publicationDate'))\nPY\n"]
