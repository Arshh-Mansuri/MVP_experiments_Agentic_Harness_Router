import urllib.parse,urllib.request,re,time
seq='DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIRRADAAPTVSIFPPSSEQLTSGGASVVCFLNNFYPKDINVKWKIDGSERQNGVLNSWTDQDSKDSTYSMSSTLTLTKDEYERHNSYTCEATHKTSTSPIVKSFNRNQC'
data=urllib.parse.urlencode({'CMD':'Put','PROGRAM':'blastp','DATABASE':'nr','QUERY':seq,'FORMAT_TYPE':'XML','HITLIST_SIZE':'10'}).encode()
r=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi',data=data,headers={'User-Agent':'Mozilla/5.0'})
s=urllib.request.urlopen(r,timeout=60).read().decode(errors='ignore'); print(s[:300]); m=re.search(r'RID = ([A-Z0-9-]+)',s)
if m:
 rid=m.group(1); print('RID',rid)
