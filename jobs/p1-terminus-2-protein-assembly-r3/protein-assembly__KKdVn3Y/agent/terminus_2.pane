python3 /tmp/build_gblock.py
python3 - <<'PY'
from pathlib import Path
p=Path('/app/gblock.txt')
s=p.read_text()
print('exists',p.exists())
print('newline_count',s.count('\n'))
seq=s.rstrip('\n')
print('nt_length',len(seq))
print('valid_dna',set(seq)<=set('ACGT'))
print('line_count',len(s.splitlines()))
gcs=[sum(c in 'GC' for c in seq[i:i+50])*100/50 for i in range(len(seq)-49)]
print('gc_min',min(gcs),'gc_max',max(gcs))
print('length_ok',len(seq)<=3000)
print('gc_ok',all(30<=x<=70 for x in gcs))
assert s.count('\n')==1 and '\n' not in seq
assert set(seq)<=set('ACGT')
assert len(seq)<=3000
assert all(30<=x<=70 for x in gcs)
PY
