python3 - <<'PY'
import urllib.request,urllib.parse,json
for q in ['gene:NA AND organism_id:11320 AND strain:"Memphis/31/98"','protein_name:neuraminidase AND organism_id:11320']:
 u='https://rest.uniprot.org/uniprotkb/search?'+urllib.parse.urlencode({'query':q,'format':'json','size':20})
 try:
  d=json.load(urllib.request.urlopen(u,timeout=30)); print('\nQUERY',q)
  for x in d.get('results',[]): print(x.get('primaryAccession'),x.get('proteinDescription'),x.get('organism',{}).get('scientificName'),x.get('sequence',{}).get('length'))
 except Exception as e: print('ERROR',e)
PY
