cat > /tmp/build_gblock.py <<'PY'
import random
# GFP antigen recognized by the supplied anti-GFP antibody (EGFP/common GFP variant), without initial M.
gfp='SKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFSYGVQCFSRYPDHMKQHDFFKSAMPEGYVQERTIFFKDDGNYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNIEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSTQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'
# Clover core from 5WJ2, excluding crystallization/tag residues and initial M.
clover='SKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFGYGLMCFARYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'
dhfr='ISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR'
mcherry='VSKGEEDNMAIIKEFMRFKVHMEGSVNGHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFXSKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQDSSLQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'.replace('X','Q')
snap='PGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'
link='GSGSG'
parts=[gfp,clover,dhfr,mcherry,snap]
for s in parts:
 assert s and s[0]!='M' and all(c in 'ACDEFGHIKLMNPQRSTVWY' for c in s)
aa=link.join(parts)
# Codons selected to be GC-moderate and suitable for E. coli expression.
cod={
'A':['GCT','GCC'],'C':['TGC','TGT'],'D':['GAT','GAC'],'E':['GAA','GAG'],'F':['TTC','TTT'],'G':['GGC','GGT','GGA','GGG'],'H':['CAT','CAC'],'I':['ATC','ATT','ATA'],'K':['AAA','AAG'],'L':['CTG','CTT','TTA','TTG'],'M':['ATG'],'N':['AAC','AAT'],'P':['CCG','CCT','CCA','CCC'],'Q':['CAG','CAA'],'R':['CGT','CGC','AGA','AGG'],'S':['AGC','TCC','TCT','TCA','TCG'],'T':['ACC','ACT','ACA','ACG'],'V':['GTG','GTT','GTA','GTC'],'W':['TGG'],'Y':['TAC','TAT']}
def gc(s): return sum(x in 'GC' for x in s)
# Choose codons by repeatedly minimizing violations and distance from 50% GC in all affected windows.
out=[]
for i,aa0 in enumerate(aa):
 opts=cod[aa0]
 best=None
 for c in opts:
  trial=''.join(out)+c
  score=0
  for j in range(max(0,len(trial)-50),len(trial)-1):
   w=trial[j:j+50]
   if len(w)==50: score += max(0,30-gc(w))**2+max(0,gc(w)-35)**2
  score += abs(gc(c)-1.5)*0.01
  if best is None or score<best[0]: best=(score,c)
 out.append(best[1])
dna=''.join(out)
print('aa length',len(aa),'nt length',len(dna))
print('parts',list(map(len,parts)),'linker',len(link))
print('gc range',min(gc(dna[i:i+50])*2 for i in range(len(dna)-49)),'to',max(gc(dna[i:i+50])*2 for i in range(len(dna)-49)))
assert len(dna)<=3000
assert all(30<=gc(dna[i:i+50)*100/50<=70 for i in range(len(dna)-49))
open('/app/gblock.txt','w').write(dna+'\n')
PY
python3 /tmp/build_gblock.py
