import urllib.request,json
for acc in ['P84751']:
 for fmt in ['json','txt']:
  u=f'https://rest.uniprot.org/uniprotkb/{acc}.{fmt}'
  try:
   s=urllib.request.urlopen(u,timeout=30).read().decode(errors='ignore')
   open('/tmp/'+acc+'.'+fmt,'w').write(s)
   print('\nFORMAT',fmt,'LEN',len(s))
   if fmt=='json':
    d=json.loads(s)
    print('protein',d.get('proteinDescription'))
    print('comments',json.dumps(d.get('comments',[]),indent=2)[:12000])
    print('refs',json.dumps(d.get('references',[]),indent=2)[:5000])
   else:
    for line in s.splitlines():
     if line.startswith(('ID','DE','CC','DR','RN','RP','RX','RA','RT')): print(line)
  except Exception as e: print('ERROR',e)
