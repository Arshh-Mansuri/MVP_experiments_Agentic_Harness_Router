import json,urllib.request
ids=open('/app/pdb_ids.txt').read().split()
for pid in ids:
 try:
  with urllib.request.urlopen('https://data.rcsb.org/rest/v1/core/entry/'+pid,timeout=20) as r:d=json.load(r)
  print('\n###',pid,d.get('struct',{}).get('title',''))
  for e in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):
   with urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{e}',timeout=20) as r:x=json.load(r)
   ep=x.get('entity_poly',{})
   seq=ep.get('pdbx_seq_one_letter_code_can','').replace('\n','').replace(' ','')
   print('ENTITY',e,'DESC',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'LEN',len(seq),'SEQ',seq)
  for e in d.get('rcsb_entry_container_identifiers',{}).get('non_polymer_entity_ids',[]):
   with urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{e}',timeout=20) as r:x=json.load(r)
   print('NONPOLY',e,x.get('pdbx_entity_nonpoly',{}).get('name'),x.get('pdbx_entity_nonpoly',{}).get('comp_id'))
 except Exception as ex: print(pid,'ERROR',ex)
PY
