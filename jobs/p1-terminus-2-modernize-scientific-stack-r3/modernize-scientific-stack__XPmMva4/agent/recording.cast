[25.779537, "o", "    \"\"\"Return the configured CSV path, falling back to the bundled sample data.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     config = ConfigParser()\r\n\u001b[?2004l\r\u001b[?2004h>     config.read(CONFIG_PATH, encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h>     if config.has_option(\"climate\", \"data_file\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.779846, "o", "        configured_path = Path(config.get(\"climate\", \"data_file\")).expanduser()\r\n\u001b[?2004l\r\u001b[?2004h>         if configured_path.is_absolute():\r\n\u001b[?2004l\r\u001b[?2004h>             return configured_path\r\n\u001b[?2004l\r\u001b[?2004h>         return CONFIG_PATH.parent / configured_path\r\n\u001b[?2004l\r\u001b[?2004h>     return DEFAULT_DATA_PATH\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.779995, "o", "\u001b[?2004h> def main() -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.780336, "o", "    data = pd.read_csv(get_data_path(), encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for station_id in (101, 102):\r\n\u001b[?2004l\r\u001b[?2004h>         station_data = data[data[\"station_id\"] == station_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.780402, "o", "        mean_temperature = station_data[\"temperature\"].mean()\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.781552, "o", ">         print(f\"Station {station_id} mean temperature: {mean_temperature:.1f}°C\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
