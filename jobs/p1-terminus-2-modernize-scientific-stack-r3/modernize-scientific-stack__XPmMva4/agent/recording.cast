[16.977293, "o", "#!/usr/bin/env python3\r\n"]
[16.977866, "o", "\"\"\"Modern Python 3 climate analysis script.\"\"\"\r\n\r\nfrom configparser import ConfigParser\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\nBASE_DIR = Path(__file__).resolve().parent\r\nCONFIG_PATH = BASE_DIR / \"climate_analyzer\" / \"config.ini\"\r\nDEFAULT_DATA_PATH = BASE_DIR / \"climate_analyzer\" / \"sample_data\" / \"climate_data.csv\"\r\n\r\n\r\ndef get_data_path() -> Path:\r\n    \"\"\"Read the configured data path when available, otherwise use sample data.\"\"\"\r\n    config = ConfigParser()\r\n    config.read(CONFIG_PATH, encoding=\"utf-8\")\r\n    configured_path = config.get(\"climate\", \"data_file\", fallback=\"\")\r\n    if not configured_path:\r\n        return DEFAULT_DATA_PATH\r\n    path = Path(configured_path).expanduser()\r\n    return path if path.is_absolute() else CONFIG_PATH.parent / path\r\n\r\n\r\ndef main() -> None:\r\n    data_path = get_data_path()\r\n    data = pd.read_csv(data_path, encoding=\"utf-8\")\r\n\r\n    station_column = next(\r\n        column for column in data.columns if column.strip().lower() in {\"station\", \"station_id\", \"id\"}\r"]
[16.978197, "o", "\n    )\r\n    temperature_column = next(\r\n        column\r\n        for column in data.columns\r\n        if \"temp\" in column.strip().lower()\r\n    )\r\n\r\n    for station_id in (101, 102):\r\n        station_data = data[data[station_column] == station_id]\r\n        if station_data.empty:\r\n            continue\r\n        mean_temperature = station_data[temperature_column].mean()\r\n        print(f\"Station {station_id} mean temperature: {mean_temperature:.1f}°C\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[16.981955, "o", "--- requirements ---\r\n"]
