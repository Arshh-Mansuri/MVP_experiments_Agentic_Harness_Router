[?2004l[?2004h>  xs=[q for p in a0 for q in (p[0],p[2])]; ys=[q for p in a0 for q in (p[1],p[3])]
[?2004l[?2004h>  pts.append((zz,(min(xs)+max(xs))/2,(min(ys)+max(ys))/2))
[?2004l[?2004h> def fit(i):
[?2004l[?2004h>  mz=sum(p[0] for p in pts)/len(pts); mv=sum(p[i] for p in pts)/len(pts)
[?2004l[?2004h>  return sum((p[0]-mz)*(p[i]-mv) for p in pts)/sum((p[0]-mz)**2 for p in pts)
[?2004l[?2004h> a,b=fit(1),fit(2); print('slopes',a,b)
[?2004l[?2004h> for cutoff in [55,60,63,64]:
[?2004l[?2004h>  ss=[]
[?2004l[?2004h>  for x,y,z,X,Y,Z in seg:
[?2004l[?2004h>   if z>=cutoff or Z>=cutoff: ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))
[?2004l[?2004h>  xs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])]
[?2004l[?2004h>  xmin,xmax,ymin,ymax=min(xs),max(xs),min(ys),max(ys); W=180; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[' ']*W for _ in range(H)]
[?2004l[?2004h>  def put(x,y):
[?2004l[?2004h>   i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))
[?2004l[?2004h>   if 0<=i<W and 0<=j<H:g[j][i]='#'
[?2004l[?2004h>  for x,y,X,Y in ss:
[?2004l[?2004h>   put(x,y);put(X,Y)
[?2004l[?2004h>  print('\n=== CUTOFF',cutoff,'segments',len(ss),'bbox',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1),'===')
[?2004l[?2004h>  print('\n'.join(''.join(r).rstrip() for r in g))
[?2004l[?2004h> PY
