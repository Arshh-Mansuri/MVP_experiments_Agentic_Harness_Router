[?2004hroot@a1c2b6783ce2:/app# cat > /tmp/project.py <<'PY'
[?2004lect onto coordinates u=x-a*z, v=y-b*z
ss=[]
for x,y,z,X,Y,Z in seg:ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))
xs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)
print('projected bbox',xmin,xmax,ymin,ymax)
W=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[' ']*W for _ in range(H)]
def p(x,y):
 i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))
 if 0<=i<W and 0<=j<H:g[j][i]='#'
for x,y,X,Y in ss:
 n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*4))
 for k in range(n+1):p(x+(X-x)*k/n,y+(Y-y)*k/n)
print('\n'.join(''.join(r).rstrip() for r in g))
