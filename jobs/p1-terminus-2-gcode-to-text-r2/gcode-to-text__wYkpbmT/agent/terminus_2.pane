[?2004hroot@a1c2b6783ce2:/app# python3 - <<'PY'
[?2004l[?2004h> # extract and report the projection parameters from the existing script without printing its raster
[?2004l[?2004h> s=open('/tmp/project.py').read(); s=s.replace("print('\\n'.join(''.join(r).rstrip() for r in g))", "pass")
[?2004l[?2004h> exec(s)
[?2004l[?2004h> PY
[?2004lcat > /tmp/dense.py <<'PY'
import re,math
obj=-1;x=y=z=0.; seg=[]; byz={}
for line in open('/app/text.gcode',errors='ignore'):
 s=line.strip()
 if s.startswith('M486'):
  m=re.match(r'M486\s+S(-?\d+)',s)
  if m: obj=int(m.group(1))
  continue
 if not(s.startswith('G0') or s.startswith('G1')):continue
 v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\d+\.?\d*|\.\d+))',s)};X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)
 if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):seg.append((x,y,z,X,Y,Z));byz.setdefault(round(z,2),[]).append((x,y,X,Y))
 x,y,z=X,Y,Z
p=[]
for zz,a0 in byz.items():
 xx=[q for q in a0 for q in(q[0],q[2])];yy=[q for q in a0 for q in(q[1],q[3])];p.append((zz,(min(xx)+max(xx))/2,(min(yy)+max(yy))/2))
def f(i):
 mz=sum(q[0] for q in p)/len(p);mv=sum(q[i] for q in p)/len(p);return sum((q[0]-mz)*(q[i]-mv) for q in p)/sum((q[0]-mz)**2 for q in p)
a,b=f(1),f(2);print('slopes',a,b)
# projected coordinates; use fine grid and density, rather than drawing every segment as filled strokes
P=[(x-a*z,y-b*z,X-a*Z,Y-b*Z) for x,y,z,X,Y,Z in seg]
xs=[q for r in P for q in(r[0],r[2])];ys=[q for r in P for q in(r[1],r[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)
W=240;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.55)); grid=[[0]*W for _ in range(H)]
def put(x,y):
 i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))
 if 0<=i<W and 0<=j<H:grid[j][i]+=1
for x,y,X,Y in P:
 n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*2))
 for k in range(n+1):put(x+(X-x)*k/n,y+(Y-y)*k/n)
# print thresholded density, retaining gaps
print('bbox',xmin,xmax,ymin,ymax,'size',W,H)
for r in grid:
 print(''.join('#' if q>=2 else ('+' if q else ' ') for q in r).rstrip())
PY
