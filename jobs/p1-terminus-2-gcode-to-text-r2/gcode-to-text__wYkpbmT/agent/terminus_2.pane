[?2004l[?2004h> for line in open('/app/text.gcode', errors='ignore'):
[?2004l[?2004h>  s=line.strip()
[?2004l[?2004h>  if s.startswith('M486'):
[?2004l[?2004h>   m=re.match(r'M486\s+S(-?\d+)',s)
[?2004l[?2004h>   if m: obj=int(m.group(1))
[?2004l[?2004h>   continue
[?2004l[?2004h>  if not (s.startswith('G0') or s.startswith('G1')): continue
[?2004l[?2004h>  v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\d+\.?\d*|\.\d+))',s)}
[?2004l[?2004h>  nx=v.get('X',x); ny=v.get('Y',y); nz=v.get('Z',z)
[?2004l[?2004h>  if obj==0 and v.get('E',0)>0 and ('X' in v or 'Y' in v):
[?2004l[?2004h>   key=round(nz,2); layers.setdefault(key,[]).append((x,y,nx,ny))
[?2004l[?2004h>  x,y,z=nx,ny,nz
[?2004l[?2004h> keys=sorted(layers)
[?2004l[?2004h> print('layers:',[(k,len(layers[k])) for k in keys])
[?2004l[?2004h> for key in keys[-12:]:
[?2004l[?2004h>  ss=layers[key]
[?2004l[?2004h>  xmin=min(min(a,c) for a,b,c,d in ss); xmax=max(max(a,c) for a,b,c,d in ss)
[?2004l[?2004h>  ymin=min(min(b,d) for a,b,c,d in ss); ymax=max(max(b,d) for a,b,c,d in ss)
[?2004l[?2004h>  W=180; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5)); g=[[' ']*W for _ in range(H)]
[?2004l[?2004h>  def p(X,Y):
[?2004l[?2004h>   ix=round((X-xmin)/(xmax-xmin)*(W-1)) if xmax>xmin else 0; iy=round((ymax-Y)/(ymax-ymin)*(H-1)) if ymax>ymin else 0
[?2004l[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'
[?2004l[?2004h>  for a,b,c,d in ss:
[?2004l[?2004h>   n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*4))
[?2004l[?2004h>   for i in range(n+1):p(a+(c-a)*i/n,b+(d-b)*i/n)
[?2004l[?2004h>  print('\n=== Z',key,'n',len(ss),'bbox',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1),'===')
[?2004l[?2004h>  print('\n'.join(''.join(r).rstrip() for r in g))
[?2004l[?2004h> PY
[?2004l[?2004hroot@a1c2b6783ce2:/app# python3 /tmp/layers.py
