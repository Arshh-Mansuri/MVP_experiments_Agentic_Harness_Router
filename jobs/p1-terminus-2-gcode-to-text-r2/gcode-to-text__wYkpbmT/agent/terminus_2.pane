[?2004hroot@a1c2b6783ce2:/app# cat > /tmp/pca.py <<'PY'
[?2004l[?2004h> import re,math
[?2004l[?2004h> obj=-1;x=y=z=0.; pts=[]
[?2004l[?2004h> for line in open('/app/text.gcode',errors='ignore'):
[?2004l[?2004h>  s=line.strip()
[?2004l[?2004h>  if s.startswith('M486'):
[?2004l[?2004h>   m=re.match(r'M486\s+S(-?\d+)',s)
[?2004l[?2004h>   if m:obj=int(m.group(1))
[?2004l[?2004h>   continue
[?2004l[?2004h>  if not(s.startswith('G0') or s.startswith('G1')):continue
[?2004l[?2004h>  v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\d+\.?\d*|\.\d+))',s)};X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)
[?2004l[?2004h>  if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):pts += [(x,y,z),(X,Y,Z)]
[?2004l[?2004h>  x,y,z=X,Y,Z
[?2004l[?2004h> # covariance and power iteration with deflation
[?2004l[?2004h> n=len(pts); c=[sum(p[j] for p in pts)/n for j in range(3)]
[?2004l[?2004h> A=[[sum((p[i]-c[i])*(p[j]-c[j]) for p in pts)/n for j in range(3)] for i in range(3)]
[?2004l[?2004h> def eig(A):
[?2004l[?2004h>  v=[1.,.7,.3]
[?2004l[?2004h>  for _ in range(100):
[?2004l[?2004h>   w=[sum(A[i][j]*v[j] for j in range(3)) for i in range(3)]; q=math.sqrt(sum(t*t for t in w));v=[t/q for t in w]
[?2004l[?2004h>  lam=sum(v[i]*sum(A[i][j]*v[j] for j in range(3)) for i in range(3));return lam,v
[?2004l[?2004h> l1,v1=eig(A);B=[[A[i][j]-l1*v1[i]*v1[j] for j in range(3)] for i in range(3)];l2,v2=eig(B)
[?2004l[?2004h> print('center',c,'eigenvalues',l1,l2,'axes',v1,v2)
[?2004l[?2004h> Q=[]
[?2004l[?2004h> for p in pts:
[?2004l[?2004h>  d=[p[i]-c[i] for i in range(3)];Q.append((sum(d[i]*v1[i] for i in range(3)),sum(d[i]*v2[i] for i in range(3)),p[2]))
[?2004l[?2004h> for mode in ['all','top']:
[?2004l[?2004h>  R=[q for q in Q if mode=='all' or q[2]>=sorted(t[2] for t in Q)[int(.9*len(Q))]]
[?2004l[?2004h>  xs=[q[0] for q in R];ys=[q[1] for q in R];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys);W=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[0]*W for _ in range(H)]
[?2004l[?2004h>  for u,v,z0 in R:
[?2004l[?2004h>   i=round((u-xmin)/(xmax-xmin)*(W-1));j=round((ymax-v)/(ymax-ymin)*(H-1))
[?2004l[?2004h>   if 0<=i<W and 0<=j<H:g[j][i]+=1
[?2004l[?2004h>  print('\n===',mode,'bbox',xmin,xmax,ymin,ymax,'===')
[?2004l[?2004h>  for row in g:print(''.join('#' if q>=2 else ('+' if q else ' ') for q in row).rstrip())
