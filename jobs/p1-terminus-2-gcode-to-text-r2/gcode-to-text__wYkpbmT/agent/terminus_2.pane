[?2004hroot@a1c2b6783ce2:/app# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> s=open('/app/text.gcode').read().splitlines(); obj=-1; x=y=z=0.; d={}
[?2004l[?2004h> for q in s:
[?2004l[?2004h>  t=q.strip()
[?2004l[?2004h>  if t.startswith('M486'):
[?2004l[?2004h>   m=re.match(r'M486\s+S(-?\d+)',t)
[?2004l[?2004h>   if m: obj=int(m.group(1))
[?2004l[?2004h>   continue
[?2004l[?2004h>  if not (t.startswith('G0') or t.startswith('G1')): continue
[?2004l[?2004h>  v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\d+\.?\d*|\.\d+))',t)}; nx=v.get('X',x); ny=v.get('Y',y); nz=v.get('Z',z)
[?2004l[?2004h>  if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):
[?2004l[?2004h>   d.setdefault(round(nz,2),[]).append((x,y,nx,ny))
[?2004l[?2004h>  x,y,z=nx,ny,nz
[?2004l[?2004h> for k in sorted(d)[-25:]:
[?2004l[?2004h>  a=d[k]; xs=[q for p in a for q in (p[0],p[2])]; ys=[q for p in a for q in (p[1],p[3])]
[?2004l[?2004h>  print(k,len(a),round(min(xs),1),round(max(xs),1),round(min(ys),1),round(max(ys),1))
[?2004l[?2004h> PY
