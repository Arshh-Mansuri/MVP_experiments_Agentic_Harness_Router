[196.189916, "o", "\u001b[?2004l\r\u001b[?2004h> print('center',c,'eigenvalues',l1,l2,'axes',v1,v2)\r\n\u001b[?2004l\r\u001b[?2004h> Q=[]\r\n\u001b[?2004l\r\u001b[?2004h> for p in pts:\r\n\u001b[?2004l\r\u001b[?2004h>  d=[p[i]-c[i] for i in range(3)];Q.append((sum(d[i]*v1[i] for i in range(3)),sum(d[i]*v2[i] for i in range(3)),p[2]))\r\n\u001b[?2004l\r\u001b[?2004h> for mode in ['all','top']:\r\n\u001b[?2004l\r\u001b[?2004h>  R=[q for q in Q if mode=='all' or q[2]>=sorted(t[2] for t in Q)[int(.9*len(Q))]]\r\n\u001b[?2004l\r\u001b[?2004h>  xs=[q[0] for q in R];ys=[q[1] for q in R];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys);W=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[0]*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h>  for u,v,z0 in R:\r\n\u001b[?2004l\r\u001b[?2004h>   i=round((u-xmin)/(xmax-xmin)*(W-1));j=round((ymax-v)/(ymax-ymin)*(H-1))\r\n\u001b[?2004l\r\u001b[?2004h>   if 0<=i<W and 0<=j<H:g[j][i]+=1\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n===',mode,'bbox',xmin,xmax,ymin,ymax,'===')\r\n\u001b[?2004l\r\u001b[?2004h>  for row in g:print(''.join('#' if q>=2 else ('+' if q else ' ') for q in row).rstrip())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
