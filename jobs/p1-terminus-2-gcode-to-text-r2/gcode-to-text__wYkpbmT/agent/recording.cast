[147.575176, "i", "cat > /tmp/dense.py <<'PY'\nimport re,math\nobj=-1;x=y=z=0.; seg=[]; byz={}\nfor line in open('/app/text.gcode',errors='ignore'):\n s=line.strip()\n if s.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\n  if m: obj=int(m.group(1))\n  continue\n if not(s.startswith('G0') or s.startswith('G1')):continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)};X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):seg.append((x,y,z,X,Y,Z));byz.setdefault(round(z,2),[]).append((x,y,X,Y))\n x,y,z=X,Y,Z\np=[]\nfor zz,a0 in byz.items():\n xx=[q for q in a0 for q in(q[0],q[2])];yy=[q for q in a0 for q in(q[1],q[3])];p.append((zz,(min(xx)+max(xx))/2,(min(yy)+max(yy))/2))\ndef f(i):\n mz=sum(q[0] for q in p)/len(p);mv=sum(q[i] for q in p)/len(p);return sum((q[0]-mz)*(q[i]-mv) for q in p)/sum((q[0]-mz)**2 for q in p)\na,b=f(1),f(2);print('slopes',a,b)\n# projected coordinates; use fine grid and density, rather than drawing every segment as filled strokes\nP=[(x-a*z,y"]
[147.576277, "o", "cat > /tmp/dense.py <<'PY'\r\nimport re,math\r\nobj=-1;x=y=z=0.; seg=[]; byz={}\r\nfor line in open('/app/text.gcode',errors='ignore'):\r\n s=line.strip()\r\n if s.startswith('M486'):\r\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\r\n  if m: obj=int(m.group(1))\r\n  continue\r\n if not(s.startswith('G0') or s.startswith('G1')):continue\r\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)};X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)\r\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):seg.append((x,y,z,X,Y,Z));byz.setdefault(round(z,2),[]).append((x,y,X,Y))\r\n x,y,z=X,Y,Z\r\np=[]\r\nfor zz,a0 in byz.items():\r\n xx=[q for q in a0 for q in(q[0],q[2])];yy=[q for q in a0 for q in(q[1],q[3])];p.append((zz,(min(xx)+max(xx))/2,(min(yy)+max(yy))/2))\r\ndef f(i):\r\n mz=sum(q[0] for q in p)/len(p);mv=sum(q[i] for q in p)/len(p);return sum((q[0]-mz)*(q[i]-mv) for q in p)/sum((q[0]-mz)**2 for q in p)\r\na,b=f(1),f(2);print('slopes',a,b)\r\n# projected coordinates; use fine grid and density, rather than drawing every segment as filled "]
[147.576683, "i", "-b*z,X-a*Z,Y-b*Z) for x,y,z,X,Y,Z in seg]\nxs=[q for r in P for q in(r[0],r[2])];ys=[q for r in P for q in(r[1],r[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)\nW=240;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.55)); grid=[[0]*W for _ in range(H)]\ndef put(x,y):\n i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))\n if 0<=i<W and 0<=j<H:grid[j][i]+=1\nfor x,y,X,Y in P:\n n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*2))\n for k in range(n+1):put(x+(X-x)*k/n,y+(Y-y)*k/n)\n# print thresholded density, retaining gaps\nprint('bbox',xmin,xmax,ymin,ymax,'size',W,H)\nfor r in grid:\n print(''.join('#' if q>=2 else ('+' if q else ' ') for q in r).rstrip())\nPY\npython3 /tmp/dense.py\n"]
[147.576746, "o", "strokes\r\nP=[(x-a*z,y-b*z,X-a*Z,Y-b*Z) for x,y,z,X,Y,Z in seg]\r\nxs=[q for r in P for q in(r[0],r[2])];ys=[q for r in P for q in(r[1],r[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)\r\nW=240;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.55)); grid=[[0]*W for _ in range(H)]\r\ndef put(x,y):\r\n i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))\r\n if 0<=i<W and 0<=j<H:grid[j][i]+=1\r\nfor x,y,X,Y in P:\r\n n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*2))\r\n for k in range(n+1):put(x+(X-x)*k/n,y+(Y-y)*k/n)\r\n# print thresholded density, retaining gaps\r\nprint('bbox',xmin,xmax,ymin,ymax,'size',W,H)\r\nfor r in grid:\r\n print(''.join('#' if q>=2 else ('+' if q else ' ') for q in r).rstrip())\r\nPY\r\npython3 /tmp/dense.py\r\n"]
