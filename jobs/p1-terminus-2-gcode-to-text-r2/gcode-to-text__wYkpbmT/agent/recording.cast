[196.176181, "o", "A=[[sum((p[i]-c[i])*(p[j]-c[j]) for p in pts)/n for j in range(3)] for i in range(3)]\r\n\u001b[?2004l\r"]
[196.181993, "o", "\u001b[?2004h> def eig(A):\r\n\u001b[?2004l\r\u001b[?2004h>  v=[1.,.7,.3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.182316, "o", " for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h"]
