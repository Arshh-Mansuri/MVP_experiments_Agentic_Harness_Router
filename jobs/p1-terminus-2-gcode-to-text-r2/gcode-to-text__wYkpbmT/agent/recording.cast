[126.687943, "i", "cat > /tmp/bands.py <<'PY'\nexec(open('/tmp/project.py').read().split(\"# project onto coordinates\")[0])\n# derive linear center shifts\npts=[]\nfor zz,a0 in byz.items():\n xs=[q for p in a0 for q in (p[0],p[2])]; ys=[q for p in a0 for q in (p[1],p[3])]\n pts.append((zz,(min(xs)+max(xs))/2,(min(ys)+max(ys))/2))\ndef fit(i):\n mz=sum(p[0] for p in pts)/len(pts); mv=sum(p[i] for p in pts)/len(pts)\n return sum((p[0]-mz)*(p[i]-mv) for p in pts)/sum((p[0]-mz)**2 for p in pts)\na,b=fit(1),fit(2); print('slopes',a,b)\nfor cutoff in [55,60,63,64]:\n ss=[]\n for x,y,z,X,Y,Z in seg:\n  if z>=cutoff or Z>=cutoff: ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))\n xs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])]\n xmin,xmax,ymin,ymax=min(xs),max(xs),min(ys),max(ys); W=180; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[' ']*W for _ in range(H)]\n def put(x,y):\n  i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))\n  if 0<=i<W and 0<=j<H:g[j][i]='#'\n for x,y,X,Y in ss:\n  put(x,y);put(X,Y)\n print('\\n"]
[126.725021, "o", "cat > /tmp/bands.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> exec(open('/tmp/project.py').read().split(\"# project onto coordinates\")[0])\r\n\u001b[?2004l\r\u001b[?2004h> # derive linear center shifts\r\n\u001b[?2004l\r\u001b[?2004h> pts=[]\r\n\u001b[?2004l\r\u001b[?2004h> for zz,a0 in byz.items():\r\n\u001b[?2004l\r\u001b[?2004h>  xs=[q for p in a0 for q in (p[0],p[2])]; ys=[q for p in a0 for q in (p[1],p[3])]\r\n\u001b[?2004l\r\u001b[?2004h>  pts.append((zz,(min(xs)+max(xs))/2,(min(ys)+max(ys))/2))\r\n\u001b[?2004l\r\u001b[?2004h> def fit(i):\r\n\u001b[?2004l\r\u001b[?2004h>  mz=sum(p[0] for p in pts)/len(pts); mv=sum(p[i] for p in pts)/len(pts)\r\n\u001b[?2004l\r\u001b[?2004h>  return sum((p[0]-mz)*(p[i]-mv) for p in pts)/sum((p[0]-mz)**2 for p in pts)\r\n\u001b[?2004l\r\u001b[?2004h> a,b=fit(1),fit(2); print('slopes',a,b)\r\n\u001b[?2004l\r\u001b[?2004h> for cutoff in [55,60,63,64]:\r\n\u001b[?2004l\r\u001b[?2004h>  ss=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for x,y,z,X,Y,Z in seg:\r\n\u001b[?2004l\r\u001b[?2004h>   if z>=cutoff or Z>=cutoff: ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))\r\n\u001b[?2004l\r\u001b[?2004h>  xs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])]\r\n\u001b[?2004l\r"]
