[35.802521, "i", "cat > /tmp/render.py <<'PY'\nimport re, math\nfn='/app/text.gcode'\nobj=-1; x=y=z=0.0; seg=[]; layers={}\nlastz=None\nfor line in open(fn, errors='ignore'):\n    s=line.strip()\n    if s.startswith('M486'):\n        m=re.match(r'M486\\\\s+S(-?\\\\d+)',s)\n        if m: obj=int(m.group(1))\n        continue\n    if not (s.startswith('G0') or s.startswith('G1')): continue\n    vals={k:float(v) for k,v in re.findall(r'([XYZE])(-?(?:\\\\d+\\\\.?\\\\d*|\\\\.\\\\d+))',s)}\n    nx=vals.get('X',x); ny=vals.get('Y',y); nz=vals.get('Z',z)\n    if obj==0 and 'E' in vals and vals['E']>0 and ('X' in vals or 'Y' in vals):\n        seg.append((x,y,nx,ny,nz))\n        layers.setdefault(round(nz,2),0); layers[round(nz,2)]+=1\n    x,y,z=nx,ny,nz\nprint('segments',len(seg),'layers',layers)\nif not seg: raise SystemExit\nxmin=min(min(a,c) for a,b,c,d,e in seg); xmax=max(max(a,c) for a,b,c,d,e in seg)\nymin=min(min(b,d) for a,b,c,d,e in seg); ymax=max(max(b,d) for a,b,c,d,e in seg)\nprint('bbox',xmin,xmax,ymin,ymax)\n# rasterize union, preserving aspect ratio\nW=160;"]
[35.806598, "i", " H=max(1,round((ymax-ymin)/(xmax-xmin)*W*0.5))\ngrid=[[' ']*W for _ in range(H)]\ndef pix(px,py):\n    ix=round((px-xmin)/(xmax-xmin)*(W-1)); iy=round((ymax-py)/(ymax-ymin)*(H-1))\n    if 0<=ix<W and 0<=iy<H: grid[iy][ix]='#'\nfor a,b,c,d,e in seg:\n    n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*3))\n    for i in range(n+1): pix(a+(c-a)*i/n,b+(d-b)*i/n)\nprint('raster',W,H)\nfor row in grid: print(''.join(row).rstrip())\nPY\npython3 /tmp/render.py\n"]
[35.886901, "o", "cat > /tmp/render.py <<'PY'\r\n\u001b[?2004l\r"]
[35.888216, "o", "\u001b[?2004h> import re, math\r\n\u001b[?2004l\r\u001b[?2004h> fn='/app/text.gcode'\r\n\u001b[?2004l\r\u001b[?2004h> obj=-1; x=y=z=0.0; seg=[]; layers={}\r\n\u001b[?2004l\r\u001b[?2004h> lastz=None\r\n\u001b[?2004l\r\u001b[?2004h> for line in open(fn, errors='ignore'):\r\n\u001b[?2004l\r\u001b[?2004h>     s=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if s.startswith('M486'):\r\n\u001b[?2004l\r\u001b[?2004h>         m=re.match(r'M486\\\\s+S(-?\\\\d+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>         if m: obj=int(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if not (s.startswith('G0') or s.startswith('G1')): continue\r\n\u001b[?2004l\r\u001b[?2004h>     vals={k:float(v) for k,v in re.findall(r'([XYZE])(-?(?:\\\\d+\\\\.?\\\\d*|\\\\.\\\\d+))',s)}\r\n\u001b[?2004l\r\u001b[?2004h>     nx=vals.get('X',x); ny=vals.get('Y',y); nz=vals.get('Z',z)\r\n\u001b[?2004l\r\u001b[?2004h>     if obj==0 and 'E' in vals and vals['E']>0 and ('X' in vals or 'Y' in vals):\r\n\u001b[?2004l\r\u001b[?2004h>         seg.append((x,y,nx,ny,nz))\r\n\u001b[?2004l\r\u001b[?2004h>         layers.setdefault(round(nz,2),0); layers[round(nz,2)]+=1\r\n\u001b[?2004l\r\u001b[?2004h>     x,y,z=nx,ny,nz\r\n\u001b[?2004l\r\u001b[?20"]
[35.888321, "o", "04h> print('segments',len(seg),'layers',layers)\r\n\u001b[?2004l\r\u001b[?2004h> if not seg: raise SystemExit\r\n\u001b[?2004l\r\u001b[?2004h> xmin=min(min(a,c) for a,b,c,d,e in seg); xmax=max(max(a,c) for a,b,c,d,e in seg)\r\n\u001b[?2004l\r\u001b[?2004h> ymin=min(min(b,d) for a,b,c,d,e in seg); ymax=max(max(b,d) for a,b,c,d,e in seg)\r\n\u001b[?2004l\r\u001b[?2004h> print('bbox',xmin,xmax,ymin,ymax)\r\n\u001b[?2004l\r\u001b[?2004h> # rasterize union, preserving aspect ratio\r\n\u001b[?2004l\r\u001b[?2004h> W=160; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*0.5))\r\n\u001b[?2004l\r\u001b[?2004h> grid=[[' ']*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> def pix(px,py):\r\n\u001b[?2004l\r\u001b[?2004h>     ix=round((px-xmin)/(xmax-xmin)*(W-1)); iy=round((ymax-py)/(ymax-ymin)*(H-1))\r\n\u001b[?2004l\r\u001b[?2004h>     if 0<=ix<W and 0<=iy<H: grid[iy][ix]='#'\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,c,d,e in seg:\r\n\u001b[?2004l\r\u001b[?2004h>     n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*3))\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n+1): pix(a+(c-a)*i/n,b+(d-b)*i/n)\r\n\u001b[?2004l\r\u001b[?2004h> print('raster',W,H)\r\n\u001b[?2004l\r\u001b[?2004h> for row in grid: print(''.jo"]
