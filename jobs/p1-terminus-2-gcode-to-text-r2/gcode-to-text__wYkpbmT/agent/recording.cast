[63.48576, "i", "cat > /tmp/layers.py <<'PY'\nimport re, math\nobj=-1; x=y=z=0.; layers={}\nfor line in open('/app/text.gcode', errors='ignore'):\n s=line.strip()\n if s.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\n  if m: obj=int(m.group(1))\n  continue\n if not (s.startswith('G0') or s.startswith('G1')): continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)}\n nx=v.get('X',x); ny=v.get('Y',y); nz=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X' in v or 'Y' in v):\n  key=round(nz,2); layers.setdefault(key,[]).append((x,y,nx,ny))\n x,y,z=nx,ny,nz\nkeys=sorted(layers)\nprint('layers:',[(k,len(layers[k])) for k in keys])\nfor key in keys[-12:]:\n ss=layers[key]\n xmin=min(min(a,c) for a,b,c,d in ss); xmax=max(max(a,c) for a,b,c,d in ss)\n ymin=min(min(b,d) for a,b,c,d in ss); ymax=max(max(b,d) for a,b,c,d in ss)\n W=180; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5)); g=[[' ']*W for _ in range(H)]\n def p(X,Y):\n  ix=round((X-xmin)/(xmax-xmin)*(W-1)) if xmax>xmin else 0; iy=round((ymax-Y)/(ymax-ymin)*(H-1)"]
[63.486359, "o", "cat > /tmp/layers.py <<'PY'\r\n\u001b[?2004l\r"]
[63.486404, "i", ") if ymax>ymin else 0\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\n for a,b,c,d in ss:\n  n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*4))\n  for i in range(n+1):p(a+(c-a)*i/n,b+(d-b)*i/n)\n print('\\n=== Z',key,'n',len(ss),'bbox',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1),'===')\n print('\\n'.join(''.join(r).rstrip() for r in g))\nPY\npython3 /tmp/layers.py\n"]
