[89.874649, "i", "python3 - <<'PY'\nexec(open('/tmp/layers.py').read().split(\"for key in keys[-12:]:\")[0])\nfor k in [0.2,1.6,3.0,5.8,8.6,11.4,14.2,18.4,22.6,27.0,32.4,36.6,40.8,45.0,49.2,53.4,57.6,60.4,62.9]:\n if k in layers:\n  a=layers[k]; xs=[v for p in a for v in (p[0],p[2])]; ys=[v for p in a for v in (p[1],p[3])]\n  print(k,len(a),round(min(xs),2),round(max(xs),2),round(min(ys),2),round(max(ys),2))\nPY\n"]
