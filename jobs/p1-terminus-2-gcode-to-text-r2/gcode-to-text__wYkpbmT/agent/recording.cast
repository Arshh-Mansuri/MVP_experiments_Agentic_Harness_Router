[74.929734, "i", "python3 - <<'PY'\nimport re\ns=open('/app/text.gcode').read().splitlines(); obj=-1; x=y=z=0.; d={}\nfor q in s:\n t=q.strip()\n if t.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',t)\n  if m: obj=int(m.group(1))\n  continue\n if not (t.startswith('G0') or t.startswith('G1')): continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',t)}; nx=v.get('X',x); ny=v.get('Y',y); nz=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):\n  d.setdefault(round(nz,2),[]).append((x,y,nx,ny))\n x,y,z=nx,ny,nz\nfor k in sorted(d)[-25:]:\n a=d[k]; xs=[q for p in a for q in (p[0],p[2])]; ys=[q for p in a for q in (p[1],p[3])]\n print(k,len(a),round(min(xs),1),round(max(xs),1),round(min(ys),1),round(max(ys),1))\nPY\n"]
