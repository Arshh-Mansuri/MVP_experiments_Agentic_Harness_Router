[175.196748, "i", "Z,Y-b*Z,Z))\nxs=[q[0] for q in P];ys=[q[1] for q in P];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)\nW=240;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.55)); mx=[[-1e9]*W for _ in range(H)]\nfor u,v,z in P:\n i=round((u-xmin)/(xmax-xmin)*(W-1));j=round((ymax-v)/(ymax-ymin)*(H-1))\n if 0<=i<W and 0<=j<H and z>mx[j][i]:mx[j][i]=z\nprint('slopes',a,b,'grid',W,H,'zrange',min(z for u,v,z in P),max(z for u,v,z in P))\nfor tol in [0.15,0.4,0.8]:\n print('\\n=== surface tolerance',tol,'===')\n for row in mx:\n  top=max(q for q in row if q>-1e8) if any(q>-1e8 for q in row) else -1e9\n  print(''.join('#' if q>=top-tol else ' ' for q in row).rstrip())\nPY\npython3 /tmp/surface.py\n"]
