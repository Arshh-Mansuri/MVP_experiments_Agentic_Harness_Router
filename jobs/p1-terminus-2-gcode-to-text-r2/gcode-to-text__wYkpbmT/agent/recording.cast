[46.535081, "i", "cat > /tmp/render.py <<'PY'\nimport re, math\nfn='/app/text.gcode'\nobj=-1; x=y=z=0.0; seg=[]; layers={}\nfor line in open(fn, errors='ignore'):\n    s=line.strip()\n    if s.startswith('M486'):\n        m=re.match(r'M486\\s+S(-?\\d+)', s)\n        if m: obj=int(m.group(1))\n        continue\n    if not (s.startswith('G0') or s.startswith('G1')): continue\n    vals={k:float(v) for k,v in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))', s)}\n    nx=vals.get('X',x); ny=vals.get('Y',y); nz=vals.get('Z',z)\n    if obj==0 and vals.get('E',0)>0 and ('X' in vals or 'Y' in vals):\n        seg.append((x,y,nx,ny,nz))\n        layers.setdefault(round(nz,2),0); layers[round(nz,2)]+=1\n    x,y,z=nx,ny,nz\nprint('segments',len(seg),'layers',layers)\nif not seg: raise SystemExit\nxmin=min(min(a,c) for a,b,c,d,e in seg); xmax=max(max(a,c) for a,b,c,d,e in seg)\nymin=min(min(b,d) for a,b,c,d,e in seg); ymax=max(max(b,d) for a,b,c,d,e in seg)\nprint('bbox',xmin,xmax,ymin,ymax)\nW=200; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*0.5))\ngrid=[[' ']*W for _ in"]
[46.535906, "i", " range(H)]\ndef pix(px,py):\n    ix=round((px-xmin)/(xmax-xmin)*(W-1)); iy=round((ymax-py)/(ymax-ymin)*(H-1))\n    if 0<=ix<W and 0<=iy<H: grid[iy][ix]='#'\nfor a,b,c,d,e in seg:\n    n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*3))\n    for i in range(n+1): pix(a+(c-a)*i/n,b+(d-b)*i/n)\nprint('raster',W,H)\nfor row in grid: print(''.join(row).rstrip())\nPY\npython3 /tmp/render.py\n"]
