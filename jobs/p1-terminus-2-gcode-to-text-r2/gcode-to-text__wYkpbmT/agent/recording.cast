[108.022596, "i", "cat > /tmp/project.py <<'PY'\nimport re,math\nobj=-1;x=y=z=0.; seg=[]; byz={}\nfor line in open('/app/text.gcode',errors='ignore'):\n s=line.strip()\n if s.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\n  if m: obj=int(m.group(1))\n  continue\n if not(s.startswith('G0') or s.startswith('G1')): continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)}\n nx=v.get('X',x);ny=v.get('Y',y);nz=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):\n  seg.append((x,y,z,nx,ny,nz)); byz.setdefault(round(nz,2),[]).append((x,y,nx,ny))\n x,y,z=nx,ny,nz\n# fit center x/y versus z using layer bounding box centers\npts=[]\nfor zz,a in byz.items():\n xs=[q for p in a for q in (p[0],p[2])];ys=[q for p in a for q in (p[1],p[3])]\n pts.append((zz,(min(xs)+max(xs))/2,(min(ys)+max(ys))/2))\ndef fit(i):\n mz=sum(p[0] for p in pts)/len(pts); mv=sum(p[i] for p in pts)/len(pts)\n return sum((p[0]-mz)*(p[i]-mv) for p in pts)/sum((p[0]-mz)**2 for p in pts)\na=fit(1);b=fit(2);print('shift slopes',a,b)\n# proj"]
[108.023187, "o", "cat > /tmp/project.py <<'PY'\r\n"]
[108.023236, "i", "ect onto coordinates u=x-a*z, v=y-b*z\nss=[]\nfor x,y,z,X,Y,Z in seg:ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))\nxs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)\nprint('projected bbox',xmin,xmax,ymin,ymax)\nW=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[' ']*W for _ in range(H)]\ndef p(x,y):\n i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))\n if 0<=i<W and 0<=j<H:g[j][i]='#'\nfor x,y,X,Y in ss:\n n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*4))\n for k in range(n+1):p(x+(X-x)*k/n,y+(Y-y)*k/n)\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\npython3 /tmp/project.py\n"]
[108.023247, "o", "\u001b[?2004l\r"]
[108.024629, "o", "ect onto coordinates u=x-a*z, v=y-b*z\r\nss=[]\r\nfor x,y,z,X,Y,Z in seg:ss.append((x-a*z,y-b*z,X-a*Z,Y-b*Z))\r\nxs=[q for p in ss for q in (p[0],p[2])];ys=[q for p in ss for q in (p[1],p[3])];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys)\r\nprint('projected bbox',xmin,xmax,ymin,ymax)\r\nW=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[' ']*W for _ in range(H)]\r\ndef p(x,y):\r\n i=round((x-xmin)/(xmax-xmin)*(W-1));j=round((ymax-y)/(ymax-ymin)*(H-1))\r\n if 0<=i<W and 0<=j<H:g[j][i]='#'\r\nfor x,y,X,Y in ss:\r\n n=max(1,round(math.hypot(X-x,Y-y)*W/(xmax-xmin)*4))\r\n for k in range(n+1):p(x+(X-x)*k/n,y+(Y-y)*k/n)\r\nprint('\\n'.join(''.join(r).rstrip() for r in g))\r\nPY\r\npython3 /tmp/project.py\r\n\u001b[?2004h> import re,math\r\n\u001b[?2004l\r\u001b[?2004h> obj=-1;x=y=z=0.; seg=[]; byz={}\r\n\u001b[?2004l\r\u001b[?2004h> for line in open('/app/text.gcode',errors='ignore'):\r\n\u001b[?2004l\r\u001b[?2004h>  s=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>  if s.startswith('M486'):\r\n\u001b[?2004l\r\u001b[?2004h>   m=re.match(r'M486\\s+S(-?\\d+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>   if m: obj=int(m.group(1)"]
