[63.490094, "o", "  if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\r\n\u001b[?2004l\r\u001b[?2004h>  for a,b,c,d in ss:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.490131, "o", "  n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*4))\r\n\u001b[?2004l\r\u001b[?2004h>   for i in range(n+1):p(a+(c-a)*i/n,b+(d-b)*i/n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.490416, "o", " print('\\n=== Z',key,'n',len(ss),'bbox',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1),'===')\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n'.join(''.join(r).rstrip() for r in g))\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.490471, "o", "> PY\r\n\u001b[?2004l\r"]
