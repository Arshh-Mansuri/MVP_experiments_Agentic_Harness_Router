[90.363675, "o", "\u001b[?2004hroot@a1c2b6783ce2:/app# "]
[91.004778, "i", "cat > /tmp/one.py <<'PY'\nexec(open('/tmp/layers.py').read().split(\"for key in keys[-12:]:\")[0])\nimport sys,math\nkey=round(float(sys.argv[1]),2); ss=layers[key]\nxs=[v for p in ss for v in (p[0],p[2])]; ys=[v for p in ss for v in (p[1],p[3])]; xmin,xmax=min(xs),max(xs); ymin,ymax=min(ys),max(ys)\nW=140; H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5)); g=[[' ']*W for _ in range(H)]\ndef p(x,y):\n i=round((x-xmin)/(xmax-xmin)*(W-1)); j=round((ymax-y)/(ymax-ymin)*(H-1))\n if 0<=i<W and 0<=j<H:g[j][i]='#'\nfor a,b,c,d in ss:\n n=max(1,round(math.hypot(c-a,d-b)*W/(xmax-xmin)*5))\n for q in range(n+1):p(a+(c-a)*q/n,b+(d-b)*q/n)\nprint('Z',key,'bbox',xmin,xmax,ymin,ymax)\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\nfor z in 8.6 22.6 36.6 49.2 57.6; do echo \"===== $z =====\"; python3 /tmp/one.py $z | tail -35; done\n"]
[91.005136, "o", "cat > /tmp/one.py <<'PY'\r\n\u001b[?2004l\r"]
