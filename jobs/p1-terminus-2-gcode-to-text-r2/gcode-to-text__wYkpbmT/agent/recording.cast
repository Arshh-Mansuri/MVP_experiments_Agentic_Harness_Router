[196.171615, "i", "cat > /tmp/pca.py <<'PY'\nimport re,math\nobj=-1;x=y=z=0.; pts=[]\nfor line in open('/app/text.gcode',errors='ignore'):\n s=line.strip()\n if s.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\n  if m:obj=int(m.group(1))\n  continue\n if not(s.startswith('G0') or s.startswith('G1')):continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)};X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v):pts += [(x,y,z),(X,Y,Z)]\n x,y,z=X,Y,Z\n# covariance and power iteration with deflation\nn=len(pts); c=[sum(p[j] for p in pts)/n for j in range(3)]\nA=[[sum((p[i]-c[i])*(p[j]-c[j]) for p in pts)/n for j in range(3)] for i in range(3)]\ndef eig(A):\n v=[1.,.7,.3]\n for _ in range(100):\n  w=[sum(A[i][j]*v[j] for j in range(3)) for i in range(3)]; q=math.sqrt(sum(t*t for t in w));v=[t/q for t in w]\n lam=sum(v[i]*sum(A[i][j]*v[j] for j in range(3)) for i in range(3));return lam,v\nl1,v1=eig(A);B=[[A[i][j]-l1*v1[i]*v1[j] for j in range(3)] for i in range(3)];l2,v2"]
[196.172658, "i", "=eig(B)\nprint('center',c,'eigenvalues',l1,l2,'axes',v1,v2)\nQ=[]\nfor p in pts:\n d=[p[i]-c[i] for i in range(3)];Q.append((sum(d[i]*v1[i] for i in range(3)),sum(d[i]*v2[i] for i in range(3)),p[2]))\nfor mode in ['all','top']:\n R=[q for q in Q if mode=='all' or q[2]>=sorted(t[2] for t in Q)[int(.9*len(Q))]]\n xs=[q[0] for q in R];ys=[q[1] for q in R];xmin,xmax=min(xs),max(xs);ymin,ymax=min(ys),max(ys);W=220;H=max(1,round((ymax-ymin)/(xmax-xmin)*W*.5));g=[[0]*W for _ in range(H)]\n for u,v,z0 in R:\n  i=round((u-xmin)/(xmax-xmin)*(W-1));j=round((ymax-v)/(ymax-ymin)*(H-1))\n  if 0<=i<W and 0<=j<H:g[j][i]+=1\n print('\\n===',mode,'bbox',xmin,xmax,ymin,ymax,'===')\n for row in g:print(''.join('#' if q>=2 else ('+' if q else ' ') for q in row).rstrip())\nPY\npython3 /tmp/pca.py\n"]
[196.17275, "o", "cat > /tmp/pca.py <<'PY'\r\n"]
[196.173787, "o", "\u001b[?2004l\r\u001b[?2004h> import re,math\r\n\u001b[?2004l\r\u001b[?2004h> obj=-1;x=y=z=0.; pts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
