[175.191938, "i", "cat > /tmp/surface.py <<'PY'\nimport re,math\nobj=-1;x=y=z=0.; seg=[]; byz={}\nfor line in open('/app/text.gcode',errors='ignore'):\n s=line.strip()\n if s.startswith('M486'):\n  m=re.match(r'M486\\s+S(-?\\d+)',s)\n  if m: obj=int(m.group(1))\n  continue\n if not(s.startswith('G0') or s.startswith('G1')): continue\n v={k:float(n) for k,n in re.findall(r'([XYZE])(-?(?:\\d+\\.?\\d*|\\.\\d+))',s)}\n X=v.get('X',x);Y=v.get('Y',y);Z=v.get('Z',z)\n if obj==0 and v.get('E',0)>0 and ('X'in v or 'Y'in v): seg.append((x,y,z,X,Y,Z));byz.setdefault(round(z,2),[]).append((x,y,X,Y))\n x,y,z=X,Y,Z\np=[]\nfor zz,a0 in byz.items():\n xx=[q for a in a0 for q in(a[0],a[2])]; yy=[q for a in a0 for q in(a[1],a[3])];p.append((zz,(min(xx)+max(xx))/2,(min(yy)+max(yy))/2))\ndef fit(i):\n mz=sum(q[0] for q in p)/len(p);mv=sum(q[i] for q in p)/len(p)\n return sum((q[0]-mz)*(q[i]-mv) for q in p)/sum((q[0]-mz)**2 for q in p)\na,b=fit(1),fit(2)\n# use projected u,v and a high-resolution max-Z map\nP=[]\nfor x,y,z,X,Y,Z in seg:\n P.append((x-a*z,y-b*z,z));P.append((X-a*"]
