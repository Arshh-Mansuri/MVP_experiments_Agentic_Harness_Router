],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],'K':['AAA','AAG'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'N':['AAT','AAC'],'P':['CCT','CCC','CCA','CCG'],'Q':['CAA','CAG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T':['ACT','ACC','ACA','ACG'],'V':['GTT','GTC','GTA','GTG'],'Y':['TAT','TAC']}\n# Select codon per residue greedily to keep each rolling 50-nt region within bounds.\ncodons=[]\nfor i,x in enumerate(aa):\n opts=sorted(choices[x],key=lambda z:abs(sum(c in 'GC' for c in z)-1.5))\n best=opts[0]\n for z in opts:\n  trial=''.join(codons+[z])\n  if len(trial)>=50:\n   w=trial[-50:];gc=sum(c in 'GC' for c in w)/50\n   if .30<=gc<=.70: best=z;break\n  else: best=z\n codons.append(best)\ndna=''.join(codons)\nassert len(dna)==3*len(aa)\nassert len(dna)<=3000\nassert all(.30<=sum(c in 'GC' for c in dna[i:i+50])/len(dna[i:i+50])<=.70 for i in range(len(dna)-49))\n# Translation check.\nrev={v:k for k,v in cod.items()}\n# verify by amino-acid codon table from choices\nfor i,x in enumerate(aa): assert codons[i] in choices[x]\nopen('/app/gblock.txt','w').write(dna+'\\n')\nprint('aa_len',len(aa),'nt_len',len(dna),'gc',sum(c in 'GC' for c in dna)/len(dna))\nprint('parts',[(k,len(parts[k])) for k in order])\nprint('first',dna[:60],'last',dna[-60:])\nPY\npython3 /tmp/build.py\nwc -c /app/gblock.txt; grep -n . /app/gblock.txt\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
