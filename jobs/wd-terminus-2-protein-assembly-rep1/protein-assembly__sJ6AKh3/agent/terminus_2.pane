python3 - <<'PY'
import urllib.request,urllib.parse,time,re
rid='AWNUP63E016'
base='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'
for i in range(18):
 p={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'}
 try:
  t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=40).read().decode(errors='replace')
  print('poll',i,'ready=',re.findall(r'Status=([^< ]+)',t)[:3], 'len',len(t))
  print(re.sub('<[^>]+>',' ',t)[-1000:])
  if 'Status=READY' in t or 'READY' in t and 'WAITING' not in t: break
 except Exception as e: print(e)
 time.sleep(5)
p={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'}
try:
 t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=60).read().decode(errors='replace')
 print('XML',len(t),t[:500]);open('/tmp/blast.xml','w').write(t)
 for tag in ['Hit_def','Hit_accession','Hit_len','Hsp_identity','Hsp_qseq','Hsp_hseq']:
  print(tag,re.findall(r'<'+tag+r'>(.*?)</'+tag+r'>',t)[:30])
except Exception as e: print(e)
PY
