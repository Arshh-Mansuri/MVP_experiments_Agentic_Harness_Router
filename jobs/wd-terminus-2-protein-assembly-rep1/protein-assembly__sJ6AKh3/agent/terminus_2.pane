import urllib.request,re
u='https://opig.stats.ox.ac.uk/webapps/newsabdab/sabdab/assets/index-BaHLkXjt.js'
t=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode(errors='replace')
print('bytes',len(t));
for pat in ['api','sequence','search','graphql','axios','fetch(']:
 print('\nPAT',pat)
 for m in list(re.finditer(pat,t,re.I))[:20]: print(t[max(0,m.start()-150):m.start()+300])
open('/tmp/sabdab.js','w').write(t)
