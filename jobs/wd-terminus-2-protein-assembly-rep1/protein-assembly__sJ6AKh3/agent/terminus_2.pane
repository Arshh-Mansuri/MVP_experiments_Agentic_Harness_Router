python3 - <<'PY'
import urllib.request,json
ids=['1IGF','1T66','1ZEA','2IGF','4OCX','1IGY','1T64','2D1F','2D1E','3U2A','4G3Y']
def get(u):
 q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})
 with urllib.request.urlopen(q,timeout=30) as r:return json.load(r)
for pid in ids:
 try:
  d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')
  print('\n###',pid,d.get('struct',{}).get('title'))
  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):
   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')
   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\n','')
   print('ENTITY',eid,'len',len(seq),'desc',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'organism',x.get('rcsb_entity_source_organism',{}))
   print(seq[:500])
 except Exception as e: print('ERR',pid,e)
