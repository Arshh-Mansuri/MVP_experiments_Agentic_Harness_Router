python3 - <<'PY'
import urllib.request,urllib.parse,time,re
rid='AWNUP63E016';base='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'
for i in range(12):
 u=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'})
 t=urllib.request.urlopen(u,timeout=40).read().decode(errors='replace')
 print(i,re.findall(r'Status=([^\s<]+)',t)[:3], 'READY' in t, 'WAITING' in t, 'FAILED' in t)
 if 'Status=READY' in t: break
 time.sleep(10)
u=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'})
t=urllib.request.urlopen(u,timeout=60).read().decode(errors='replace');print(t[:500]);open('/tmp/blast.xml','w').write(t)
print('hits',re.findall(r'<Hit_def>(.*?)</Hit_def>',t)[:20])
