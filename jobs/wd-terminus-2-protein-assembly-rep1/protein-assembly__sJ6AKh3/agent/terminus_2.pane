import urllib.request,json
# Check common amyloid-beta precursor/protein records and retrieve sequences if available
for pid in ['3IFL','3IFN','1BA4','1IYT']:
 try:
  q=urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/entry/{pid}',headers={'User-Agent':'Mozilla/5.0'})
  d=json.load(urllib.request.urlopen(q,timeout=15))
  print(pid,d.get('struct',{}).get('title'))
  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):
   x=json.load(urllib.request.urlopen(urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',headers={'User-Agent':'Mozilla/5.0'})))
   s=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\n','')
   if len(s)<=100: print(eid,s)
 except Exception as e: print(pid,e)
