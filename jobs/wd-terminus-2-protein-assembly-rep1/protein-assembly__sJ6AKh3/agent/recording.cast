[8167.327544, "i", "python3 - <<'PY'\nimport urllib.request,re\nu='https://opig.stats.ox.ac.uk/webapps/newsabdab/sabdab/assets/index-BaHLkXjt.js'\nt=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode(errors='replace')\nprint('bytes',len(t));\nfor pat in ['api','sequence','search','graphql','axios','fetch(']:\n print('\\nPAT',pat)\n for m in list(re.finditer(pat,t,re.I))[:20]: print(t[max(0,m.start()-150):m.start()+300])\nopen('/tmp/sabdab.js','w').write(t)\nPY\n"]
[8167.329557, "o", "python3 - <<'PY'\r\nimport urllib.request,re\r\nu='https://opig.stats.ox.ac.uk/webapps/newsabdab/sabdab/assets/index-BaHLkXjt.js'\r\nt=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode(errors='replace')\r\nprint('bytes',len(t));\r\nfor pat in ['api','sequence','search','graphql','axios','fetch(']:\r\n print('\\nPAT',pat)\r\n for m in list(re.finditer(pat,t,re.I))[:20]: print(t[max(0,m.start()-150):m.start()+300])\r\nopen('/tmp/sabdab.js','w').write(t)\r\nPY\r\n"]
