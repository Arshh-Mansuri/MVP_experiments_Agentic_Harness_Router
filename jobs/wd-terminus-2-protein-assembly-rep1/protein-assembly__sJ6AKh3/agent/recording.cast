[8566.593386, "o", "ids='6PXR 9ME5 2PCP 3IFL 3IFN 3IFO 4Q0X 8ROR 1F3D 1KEL 1KEM 3GNM 6A9K 6DC7 6DC8 6IGU 9WLC 2UYL 2Z4Q 3NZ8 4HXB 4HZL'.split()\r\n\u001b[?2004l\r\u001b[?2004h> def get(u):\r\n\u001b[?2004l\r\u001b[?2004h>  q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\r\n\u001b[?2004l\r\u001b[?2004h>  with urllib.request.urlopen(q,timeout=12) as r:return json.load(r)\r\n\u001b[?2004l\r\u001b[?2004h> for pid in ids:\r\n\u001b[?2004l\r\u001b[?2004h>  try:\r\n\u001b[?2004l\r\u001b[?2004h>   d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\r\n\u001b[?2004l\r\u001b[?2004h>   print('\\n###',pid,d.get('struct',{}).get('title'))\r\n\u001b[?2004l\r\u001b[?2004h>   for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\r\n\u001b[?2004l\r\u001b[?2004h>    x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\r\n\u001b[?2004l\r\u001b[?2004h>    seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\r\n\u001b[?2004l\r\u001b[?2004h>    src=x.get('rcsb_entity_source_organism',[{}])\r\n\u001b[?2004l\r\u001b[?2004h> "]
