[75.854178, "i", "python3 - <<'PY'\nimport urllib.request,json\n\ndef get(u):\n req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n with urllib.request.urlopen(req,timeout=30) as r:return json.load(r)\nids=open('/app/pdb_ids.txt').read().split()\nfor pid in ids:\n try:\n  d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\n  print('\\n###',pid,d.get('struct',{}).get('title'))\n  print('IDs',d.get('rcsb_entry_container_identifiers',{}))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('non_polymer_entity_ids',[]):\n   x=get(f'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{eid}')\n   print(' nonpoly',eid,x.get('pdbx_entity_nonpoly',{}))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   print(' entity',eid,'len',len(seq),'desc',x.get('rcsb_polymer_entity',{}).get('pdbx_description'))\n   print(seq"]
[75.854784, "i", ")\n except Exception as e: print('ERROR',pid,e)\nPY\n"]
