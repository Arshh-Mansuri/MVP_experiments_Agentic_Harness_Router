[8000.869954, "i", "python3 - <<'PY'\nimport urllib.request,json\nfor slug in ['clover','mcherry','snap-tag','snaptag','egfp','gfp']:\n for suffix in ['/','']:\n  u='https://fpbase.org/api/proteins/'+slug+suffix\n  try:\n   q=urllib.request.Request(u,headers={'User-Agent':'Googlebot'})\n   d=json.load(urllib.request.urlopen(q,timeout=20))\n   print('\\n',slug,d.get('name'),'len',len(d.get('seq','')),'ex/em',[(s.get('ex_max'),s.get('em_max')) for s in d.get('states',[])])\n   print(d.get('seq',''))\n   break\n  except Exception as e: pass\nPY\n"]
