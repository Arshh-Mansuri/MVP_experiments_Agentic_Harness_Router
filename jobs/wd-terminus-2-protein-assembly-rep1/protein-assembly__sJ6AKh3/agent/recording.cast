[8064.554082, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse\n# EBI protein similarity search submission using the heavy-chain variable sequence\nseq='QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSSAS'\nurls=['https://www.ebi.ac.uk/Tools/services/rest/ncbiblast/run','https://www.ebi.ac.uk/Tools/services/rest/ncbiblast/status/']\ntry:\n data=urllib.parse.urlencode({'email':'test@example.com','program':'blastp','stype':'protein','database':'uniprotkb','sequence':seq}).encode()\n req=urllib.request.Request(urls[0],data=data)\n print(urllib.request.urlopen(req,timeout=30).read().decode())\nexcept Exception as e: print('EBI',e)\nPY\n"]
