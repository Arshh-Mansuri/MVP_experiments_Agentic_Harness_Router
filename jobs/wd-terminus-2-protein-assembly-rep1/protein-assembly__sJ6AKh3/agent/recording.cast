[8339.707583, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8339.707807, "o", "import urllib.request,urllib.parse,time,re\r\n\u001b[?2004l\r"]
[8339.708831, "o", "\u001b[?2004h> "]
[8339.710385, "o", "rid='AWNUP63E016';base='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(12):\r\n\u001b[?2004l\r\u001b[?2004h>  u=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'})\r\n\u001b[?2004l\r\u001b[?2004h>  t=urllib.request.urlopen(u,timeout=40).read().decode(errors='replace')\r\n\u001b[?2004l\r\u001b[?2004h>  print(i,re.findall(r'Status=([^\\s<]+)',t)[:3], 'READY' in t, 'WAITING' in t, 'FAILED' in t)\r\n\u001b[?2004l\r"]
[8339.710937, "o", "\u001b[?2004h>  if 'Status=READY' in t: break\r\n\u001b[?2004l\r\u001b[?2004h>  time.sleep(10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8339.711221, "o", "u=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'})\r\n\u001b[?2004l\r"]
[8339.711401, "o", "\u001b[?2004h> "]
[8339.711788, "o", "t=urllib.request.urlopen(u,timeout=60).read().decode(errors='replace');print(t[:500]);open('/tmp/blast.xml','w').write(t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[8339.712156, "o", "print('hits',re.findall(r'<Hit_def>(.*?)</Hit_def>',t)[:20])"]
