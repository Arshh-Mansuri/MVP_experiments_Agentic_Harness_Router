[8010.783641, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\nseqs={\n'H':'QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSSASTTPPSVYPLAPGSAAQTNSMVTLGCLVKGYFPEPVTVTWNSGSLSSGVHTFPAVLQSDLYTLSSSVTVPSSTWPSQTVTCNVAHPASSTKVDKKIVPRAAA',\n'L':'DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIRRADAAPTVSIFPPSSEQLTSGGASVVCFLNNFYPKDINVKWKIDGSERQNGVLNSWTDQDSKDSTYSMSSTLTLTKDEYERHNSYTCEATHKTSTSPIVKSFNRNQC'}\nfor name,s in seqs.items():\n for db in ['pdb','protein']:\n  u='https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db='+db+'&term='+urllib.parse.quote(s[:30]+'[All Fields]')\n  try:\n   t=urllib.request.urlopen(u).read().decode(); print(name,db,re.findall(r'<Count>(.*?)</Count>',t))\n  except Exception as e: print(e)\nPY\n"]
