[8188.97158, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,time,re\nrid='AWNUP63E016'\nbase='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'\nfor i in range(18):\n p={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'}\n try:\n  t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=40).read().decode(errors='replace')\n  print('poll',i,'ready=',re.findall(r'Status=([^< ]+)',t)[:3], 'len',len(t))\n  print(re.sub('<[^>]+>',' ',t)[-1000:])\n  if 'Status=READY' in t or 'READY' in t and 'WAITING' not in t: break\n except Exception as e: print(e)\n time.sleep(5)\np={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'}\ntry:\n t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=60).read().decode(errors='replace')\n print('XML',len(t),t[:500]);open('/tmp/blast.xml','w').write(t)\n for tag in ['Hit_def','Hit_accession','Hit_len','Hsp_identity','Hsp_qseq','Hsp_hseq']:\n  print(tag,re.findall(r'<'+tag+r'>(.*?)</'+tag+r'>',t)[:30])\nexcept Exception as e: print(e)\nPY\n"]
[8188.97465, "o", "python3 - <<'PY'\r\nimport urllib.request,urllib.parse,time,re\r\nrid='AWNUP63E016'\r\nbase='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'\r\nfor i in range(18):\r\n p={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'}\r\n try:\r\n  t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=40).read().decode(errors='replace')\r\n  print('poll',i,'ready=',re.findall(r'Status=([^< ]+)',t)[:3], 'len',len(t))\r\n  print(re.sub('<[^>]+>',' ',t)[-1000:])\r\n  if 'Status=READY' in t or 'READY' in t and 'WAITING' not in t: break\r\n except Exception as e: print(e)\r\n time.sleep(5)\r\np={'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'}\r\ntry:\r\n t=urllib.request.urlopen(base+urllib.parse.urlencode(p),timeout=60).read().decode(errors='replace')\r\n print('XML',len(t),t[:500]);open('/tmp/blast.xml','w').write(t)\r\n for tag in ['Hit_def','Hit_accession','Hit_len','Hsp_identity','Hsp_qseq','Hsp_hseq']:\r\n  print(tag,re.findall(r'<'+tag+r'>(.*?)</'+tag+r'>',t)[:30])\r\nexcept Exception as e: print(e)\r\nPY\r\n"]
