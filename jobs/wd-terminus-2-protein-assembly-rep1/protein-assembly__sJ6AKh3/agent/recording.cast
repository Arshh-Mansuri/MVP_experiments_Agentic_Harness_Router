[216.270141, "i", "python3 - <<'PY'\nimport urllib.request,csv,io,json\nu='https://fpbase.org/api/proteins/'\nr=urllib.request.Request(u,headers={'User-Agent':'Googlebot'})\ndata=urllib.request.urlopen(r).read().decode()\nprint('CSV bytes',len(data))\nrows=list(csv.DictReader(io.StringIO(data)))\nids={x.lower() for x in open('/app/pdb_ids.txt').read().split()}\nfor x in rows:\n vals=' '.join(str(x.get('pdb.'+str(i),'')) for i in range(11)).lower()\n if any(pid in vals for pid in ids) or x.get('name','').lower() in ['egfp','gfp','mcherry','tagrfp','gamillus','mko','psmorange']:\n  print(x.get('name'),x.get('slug'),'pdb=',[x.get('pdb.'+str(i)) for i in range(11) if x.get('pdb.'+str(i))], 'ex',x.get('states.0.ex_max'),'em',x.get('states.0.em_max'),'seq_len',len(x.get('seq','')))\nPY\n"]
