[11.868426, "i", "python3 - <<'PY'\nimport requests, json\nids=open('/app/pdb_ids.txt').read().split()\nfor pid in ids:\n    u=f'https://data.rcsb.org/rest/v1/core/entry/{pid}'\n    try:\n        d=requests.get(u,timeout=20).json()\n        print('\\n###',pid, d.get('struct',{}).get('title'))\n        print('keywords:',d.get('struct_keywords',{}))\n        print('nonpoly:',[(x.get('comp_id'),x.get('chem_comp_name')) for x in d.get('nonpolymer_entities',[])])\n        for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n            x=requests.get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',timeout=20).json()\n            desc=x.get('rcsb_polymer_entity',{}).get('pdbx_description')\n            seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n            print(' entity',eid,'len',len(seq),'desc',desc,'seq',seq[:80])\n    except Exception as e: print('ERROR',pid,e)\nPY\n"]
