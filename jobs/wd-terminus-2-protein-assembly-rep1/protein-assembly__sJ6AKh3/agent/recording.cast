[358.349284, "i", "python3 - <<'PY'\nimport urllib.request,json\nfor slug in ['egfp','gfp','mcherry','tagrfp','gamillus','mko','psmorange','superfolder-gfp']:\n try:\n  req=urllib.request.Request('https://fpbase.org/api/proteins/'+slug+'/',headers={'User-Agent':'Googlebot'})\n  d=json.load(urllib.request.urlopen(req))\n  print(slug,d.get('name'),'ex/em',[(s.get('ex_max'),s.get('em_max')) for s in d.get('states',[])],'pdb',d.get('pdb'),'seq',len(d.get('seq','')))\n except Exception as e: print(slug,e)\nPY\n"]
