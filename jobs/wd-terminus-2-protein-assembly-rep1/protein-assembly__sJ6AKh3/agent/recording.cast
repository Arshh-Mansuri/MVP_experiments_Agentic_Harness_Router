[8054.383607, "o", "\u001b[?2004h> qs=['\"EKFYGYDYW\"','\"KASGYSFTTYTIH\"','\"GYAAYNQNFK\" immunoglobulin','\"GYSFTTYTIHWVK\"']\r\n\u001b[?2004l\r\u001b[?2004h> for q in qs:\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n###',q)\r\n\u001b[?2004l\r\u001b[?2004h>  u='https://www.bing.com/search?q='+urllib.parse.quote(q)\r\n\u001b[?2004l\r\u001b[?2004h>  try:\r\n\u001b[?2004l\r\u001b[?2004h>   req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\r\n\u001b[?2004l\r\u001b[?2004h>   t=urllib.request.urlopen(req,timeout=30).read().decode(errors='replace')\r\n\u001b[?2004l\r\u001b[?2004h>   for m in re.finditer(r'<li class=\"b_algo\".*?</li>',t,re.S):\r\n\u001b[?2004l\r\u001b[?2004h>    x=html.unescape(re.sub(r'<[^>]+>',' ',m.group()))\r\n\u001b[?2004l\r\u001b[?2004h>    x=re.sub(r'\\s+',' ',x)\r\n\u001b[?2004l\r\u001b[?2004h>    print(x[:1200])\r\n\u001b[?2004l\r\u001b[?2004h>  except Exception as e: print(e)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
