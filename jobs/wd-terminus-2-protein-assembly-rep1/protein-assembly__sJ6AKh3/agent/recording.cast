[8420.786739, "i", "python3 - <<'PY'\nimport urllib.request,json\nids=['1IGF','1T66','1ZEA','2IGF','4OCX']\ndef get(u):\n q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n with urllib.request.urlopen(q,timeout=15) as r:return json.load(r)\nfor pid in ids:\n try:\n  d=get('https://data.rcsb.org/rest/v1/core/entry/'+pid)\n  print('\\n###',pid,d.get('struct',{}).get('title'))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   src=x.get('rcsb_entity_source_organism',[{}])\n   print('ENTITY',eid,'LEN',len(seq),'DESC',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'SRC',src[0].get('scientific_name') if src else '')\n   print(seq)\n except Exception as e: print('ERR',pid,e)\nPY\n"]
[8420.793117, "o", "python3 - <<'PY'\r\nimport urllib.request,json\r\nids=['1IGF','1T66','1ZEA','2IGF','4OCX']\r\ndef get(u):\r\n q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\r\n with urllib.request.urlopen(q,timeout=15) as r:return json.load(r)\r\nfor pid in ids:\r\n try:\r\n  d=get('https://data.rcsb.org/rest/v1/core/entry/'+pid)\r\n  print('\\n###',pid,d.get('struct',{}).get('title'))\r\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\r\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\r\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\r\n   src=x.get('rcsb_entity_source_organism',[{}])\r\n   print('ENTITY',eid,'LEN',len(seq),'DESC',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'SRC',src[0].get('scientific_name') if src else '')\r\n   print(seq)\r\n except Exception as e: print('ERR',pid,e)\r\nPY\r\n"]
