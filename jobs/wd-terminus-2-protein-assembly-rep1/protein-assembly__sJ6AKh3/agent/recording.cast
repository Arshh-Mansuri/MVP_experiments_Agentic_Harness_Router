[8393.865184, "i", "python3 - <<'PY'\nimport urllib.request,json\n# Retrieve RCSB sequence-search results compactly for the heavy chain\ns='QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSSAS'\nq={'query':{'type':'terminal','service':'sequence','parameters':{'evalue_cutoff':1e-3,'identity_cutoff':0.55,'sequence_type':'protein','value':s}},'return_type':'entry','request_options':{'scoring_strategy':'sequence','paginate':{'start':0,'rows':200}}}\nr=urllib.request.Request('https://search.rcsb.org/rcsbsearch/v2/query',data=json.dumps(q).encode(),headers={'Content-Type':'application/json','User-Agent':'Mozilla/5.0'})\nd=json.load(urllib.request.urlopen(r,timeout=60))\nprint('\\n'.join(x['identifier']+' '+str(x.get('score')) for x in d.get('result_set',[])))\nPY\n"]
[8393.867155, "o", "python3 - <<'PY'\r\nimport urllib.request,json\r\n# Retrieve RCSB sequence-search results compactly for the heavy chain\r\ns='QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSSAS'\r\nq={'query':{'type':'terminal','service':'sequence','parameters':{'evalue_cutoff':1e-3,'identity_cutoff':0.55,'sequence_type':'protein','value':s}},'return_type':'entry','request_options':{'scoring_strategy':'sequence','paginate':{'start':0,'rows':200}}}\r\nr=urllib.request.Request('https://search.rcsb.org/rcsbsearch/v2/query',data=json.dumps(q).encode(),headers={'Content-Type':'application/json','User-Agent':'Mozilla/5.0'})\r\nd=json.load(urllib.request.urlopen(r,timeout=60))\r\nprint('\\n'.join(x['identifier']+' '+str(x.get('score')) for x in d.get('result_set',[])))\r\nPY\r\n"]
