[8079.472479, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\n# Search SAbDab/IMGT/abYsis indexed pages for the distinctive CDR3\nfor base in ['https://www.google.com/search?q=','https://www.bing.com/search?q=']:\n for q in ['\"EKFYGYDYWGQG\"','\"KASGYSFTTYTIH\"','\"YINPSSGYAAYNQNF\"']:\n  try:\n   u=base+urllib.parse.quote(q+' antibody antigen')\n   req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n   t=urllib.request.urlopen(req,timeout=20).read().decode(errors='replace')\n   print('\\n',base,q,'len',len(t))\n   for word in ['GFP','DHFR','RFP','mCherry','antigen','SAbDab','PDB']:\n    print(word,[t[max(0,m.start()-100):m.start()+250] for m in list(re.finditer(word,t,re.I))[:3]])\n  except Exception as e: print(e)\nPY\n"]
