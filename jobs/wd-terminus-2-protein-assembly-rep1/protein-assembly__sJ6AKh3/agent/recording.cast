[8566.578064, "i", "python3 - <<'PY'\nimport urllib.request,json\nids='6PXR 9ME5 2PCP 3IFL 3IFN 3IFO 4Q0X 8ROR 1F3D 1KEL 1KEM 3GNM 6A9K 6DC7 6DC8 6IGU 9WLC 2UYL 2Z4Q 3NZ8 4HXB 4HZL'.split()\ndef get(u):\n q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n with urllib.request.urlopen(q,timeout=12) as r:return json.load(r)\nfor pid in ids:\n try:\n  d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\n  print('\\n###',pid,d.get('struct',{}).get('title'))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   src=x.get('rcsb_entity_source_organism',[{}])\n   print(eid,len(seq),x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'|',src[0].get('scientific_name') if src else '')\n except Exception as e: print('ERR',pid,str(e)[:80])\nPY\n"]
