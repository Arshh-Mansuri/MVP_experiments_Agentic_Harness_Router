[8044.776089, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re,html\nqs=['\"EKFYGYDYW\"','\"KASGYSFTTYTIH\"','\"GYAAYNQNFK\" immunoglobulin','\"GYSFTTYTIHWVK\"']\nfor q in qs:\n print('\\n###',q)\n u='https://www.bing.com/search?q='+urllib.parse.quote(q)\n try:\n  req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n  t=urllib.request.urlopen(req,timeout=30).read().decode(errors='replace')\n  for m in re.finditer(r'<li class=\"b_algo\".*?</li>',t,re.S):\n   x=html.unescape(re.sub(r'<[^>]+>',' ',m.group()))\n   x=re.sub(r'\\s+',' ',x)\n   print(x[:1200])\n except Exception as e: print(e)\nPY\n"]
