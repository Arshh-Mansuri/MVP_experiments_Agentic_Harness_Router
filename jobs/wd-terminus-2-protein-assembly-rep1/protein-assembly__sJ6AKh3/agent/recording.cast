[8618.273878, "i", "python3 - <<'PY'\nimport urllib.request,json\n# Check common amyloid-beta precursor/protein records and retrieve sequences if available\nfor pid in ['3IFL','3IFN','1BA4','1IYT']:\n try:\n  q=urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/entry/{pid}',headers={'User-Agent':'Mozilla/5.0'})\n  d=json.load(urllib.request.urlopen(q,timeout=15))\n  print(pid,d.get('struct',{}).get('title'))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=json.load(urllib.request.urlopen(urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',headers={'User-Agent':'Mozilla/5.0'})))\n   s=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   if len(s)<=100: print(eid,s)\n except Exception as e: print(pid,e)\nPY\n"]
[8618.274415, "o", "python3 - <<'PY'\r\nimport urllib.request,json\r\n# Check common amyloid-beta precursor/protein records and retrieve sequences if available\r\nfor pid in ['3IFL','3IFN','1BA4','1IYT']:\r\n try:\r\n  q=urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/entry/{pid}',headers={'User-Agent':'Mozilla/5.0'})\r\n  d=json.load(urllib.request.urlopen(q,timeout=15))\r\n  print(pid,d.get('struct',{}).get('title'))\r\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\r\n   x=json.load(urllib.request.urlopen(urllib.request.Request(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',headers={'User-Agent':'Mozilla/5.0'})))\r\n   s=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\r\n   if len(s)<=100: print(eid,s)\r\n except Exception as e: print(pid,e)\r\nPY\r\n"]
