[140.743747, "o", "\u001b[?2004h> import urllib.request,json,urllib.parse\r\n\u001b[?2004l\r\u001b[?2004h> sm='Nc3nc(OCc1ccccc1)c2nc[nH]c2n3'\r\n\u001b[?2004l\r\u001b[?2004h> for u in ['https://data.rcsb.org/rest/v1/core/chemcomp/']:\r\n\u001b[?2004l\r\u001b[?2004h>  pass\r\n\u001b[?2004l\r\u001b[?2004h> # search RCSB text service for the exact SMILES\r\n\u001b[?2004l\r\u001b[?2004h> q={'query':{'type':'terminal','service':'chemical','parameters':{'attribute':'rcsb_chem_comp_descriptor.smiles','operator':'exact_match','value':sm}},'return_type':'entry','request_options':{'return_all_hits':True}}\r\n\u001b[?2004l\r\u001b[?2004h> r=urllib.request.Request('https://search.rcsb.org/rcsbsearch/v2/query',data=json.dumps(q).encode(),headers={'Content-Type':'application/json'})\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>  d=json.load(urllib.request.urlopen(r)); print(json.dumps(d,indent=2)[:10000])\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e: print(e)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
