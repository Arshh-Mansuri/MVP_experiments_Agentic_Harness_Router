[8299.814347, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,time,re\nrid='AWNUP63E016';base='https://blast.ncbi.nlm.nih.gov/Blast.cgi?'\nfor i in range(12):\n u=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'SearchInfo','FORMAT_TYPE':'HTML'})\n t=urllib.request.urlopen(u,timeout=40).read().decode(errors='replace')\n print(i,re.findall(r'Status=([^\\s<]+)',t)[:3], 'READY' in t, 'WAITING' in t, 'FAILED' in t)\n if 'Status=READY' in t: break\n time.sleep(10)\nu=base+urllib.parse.urlencode({'CMD':'Get','RID':rid,'FORMAT_OBJECT':'Alignment','FORMAT_TYPE':'XML'})\nt=urllib.request.urlopen(u,timeout=60).read().decode(errors='replace');print(t[:500]);open('/tmp/blast.xml','w').write(t)\nprint('hits',re.findall(r'<Hit_def>(.*?)</Hit_def>',t)[:20])\nPY\n"]
