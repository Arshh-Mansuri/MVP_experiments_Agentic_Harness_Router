[8367.249327, "i", "python3 - <<'PY'\nimport urllib.request,json\nids=['1IGF','1T66','1ZEA','2IGF','4OCX','1IGY','1T64','2D1F','2D1E','3U2A','4G3Y']\ndef get(u):\n q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n with urllib.request.urlopen(q,timeout=30) as r:return json.load(r)\nfor pid in ids:\n try:\n  d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\n  print('\\n###',pid,d.get('struct',{}).get('title'))\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   print('ENTITY',eid,'len',len(seq),'desc',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'organism',x.get('rcsb_entity_source_organism',{}))\n   print(seq[:500])\n except Exception as e: print('ERR',pid,e)\nPY\n"]
[8367.250837, "o", "python3 - <<'PY'\r\nimport urllib.request,json\r\nids=['1IGF','1T66','1ZEA','2IGF','4OCX','1IGY','1T64','2D1F','2D1E','3U2A','4G3Y']\r\ndef get(u):\r\n q=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\r\n with urllib.request.urlopen(q,timeout=30) as r:return json.load(r)\r\nfor pid in ids:\r\n try:\r\n  d=get(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\r\n  print('\\n###',pid,d.get('struct',{}).get('title'))\r\n  for eid in d.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\r\n   x=get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}')\r\n   seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\r\n   print('ENTITY',eid,'len',len(seq),'desc',x.get('rcsb_polymer_entity',{}).get('pdbx_description'),'organism',x.get('rcsb_entity_source_organism',{}))\r\n   print(seq[:500])\r\n except Exception as e: print('ERR',pid,e)\r\nPY\r\n"]
