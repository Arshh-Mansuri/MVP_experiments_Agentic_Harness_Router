[339.047086, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re\nqueries=['\"GYSFTTYTIH\"','\"GYDYWGQGATL\" antibody','\"YINPSSGYAAYNQNF\"','\"CAREKFYGYDYW\"']\nfor q in queries:\n print('\\n###',q)\n for site in ['https://www.google.com/search?q=','https://www.bing.com/search?q=','https://html.duckduckgo.com/html/?q=']:\n  try:\n   u=site+urllib.parse.quote(q)\n   req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\n   t=urllib.request.urlopen(req,timeout=20).read().decode(errors='replace')\n   t=re.sub('<script.*?</script>',' ',t,flags=re.S);t=re.sub('<style.*?</style>',' ',t,flags=re.S);t=re.sub('<[^>]+>',' ',t)\n   t=re.sub(r'\\s+',' ',t)\n   print(site, t[:1200])\n  except Exception as e: print(e)\nPY\n"]
