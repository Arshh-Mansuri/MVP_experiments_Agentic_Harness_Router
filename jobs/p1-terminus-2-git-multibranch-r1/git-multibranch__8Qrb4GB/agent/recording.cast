[45.414394, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[45.414525, "o", "cat > /etc/nginx/sites-available/git-server <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.414573, "o", "> server {\r\n\u001b[?2004l\r\u001b[?2004h>     listen 8443 ssl;\r\n\u001b[?2004l\r"]
[45.414771, "o", "\u001b[?2004h>     listen [::]:8443 ssl;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.414857, "o", "    server_name localhost;\r\n\u001b[?2004l\r\u001b[?2004h>     root /var/www/site;\r\n\u001b[?2004l\r\u001b[?2004h>     index index.html;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.415028, "o", "    ssl_certificate /etc/nginx/ssl/git-server.crt;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.415101, "o", "    ssl_certificate_key /etc/nginx/ssl/git-server.key;\r\n\u001b[?2004l\r\u001b[?2004h>     location / {\r\n\u001b[?2004l\r\u001b[?2004h>         try_files $uri $uri/ =404;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[45.440779, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[45.440836, "o", "rm -f /etc/nginx/sites-enabled/default\r\n\u001b[?2004l\r"]
[45.459583, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[45.459722, "o", "ln -sf /etc/nginx/sites-available/git-server /etc/nginx/sites-enabled/git-server\r\n\u001b[?2004l\r"]
[45.479354, "o", "\u001b[?2004hroot@34b11946f285:/app# nginx -t\r\n\u001b[?2004l\r"]
[45.55649, "o", "nginx: the configuration file /etc/nginx/nginx.conf syntax is ok\r\n"]
[45.559064, "o", "nginx: configuration file /etc/nginx/nginx.conf test is successful\r\n"]
[45.561776, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[45.561901, "o", "if pgrep -x sshd >/dev/null; then pkill -HUP -x sshd; else /usr/sbin/sshd; fi\r\n\u001b[?2004l\r"]
[45.654689, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[45.654771, "o", "if pgrep -x nginx >/dev/null; then nginx -s reload; else nginx; fi\r\n\u001b[?2004l\r"]
[45.77426, "o", "\u001b[?2004hroot@34b11946f285:/app# sleep 1\r\n\u001b[?2004l\r"]
[46.879385, "o", "\u001b[?2004hroot@34b11946f285:/app# ss -ltnp | grep -E ':(22|8443) ' || true\r\n\u001b[?2004l\r"]
[46.969604, "o", "LISTEN 0      128          0.0.0.0\u001b[01;31m\u001b[K:22 \u001b[m\u001b[K        0.0.0.0:*    users:((\"sshd\",pid=870,fd=3))  \r\nLISTEN 0      511          0.0.0.0\u001b[01;31m\u001b[K:8443 \u001b[m\u001b[K      0.0.0.0:*    users:((\"nginx\",pid=873,fd=17))\r\n"]
[46.969693, "o", "LISTEN 0      128             [::]\u001b[01;31m\u001b[K:22 \u001b[m\u001b[K           [::]:*    users:((\"sshd\",pid=870,fd=4))  \r\nLISTEN 0      511             [::]\u001b[01;31m\u001b[K:8443 \u001b[m\u001b[K         [::]:*    users:((\"nginx\",pid=873,fd=18))\r\n"]
[46.971618, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[46.971785, "o", "curl -k -s -o /dev/null -w 'HTTPS status: %{http_code}\\n' https://localhost:8443/\r\n\u001b[?2004l\r"]
[47.157804, "o", "HTTPS status: 403\r\n"]
[47.167194, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[47.167379, "o", "printf 'Server setup complete.\\n'\r\n\u001b[?2004l\r"]
[47.167583, "o", "Server setup complete.\r\n"]
[47.167724, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[62.413031, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nset -e\nrepo=/git/project\nweb=/var/www/site\nwhile read -r oldrev newrev refname; do\n    case \"$refname\" in\n        refs/heads/main)\n            target=\"$web\"\n            preserve_dev=1\n            ;;\n        refs/heads/dev)\n            target=\"$web/dev\"\n            preserve_dev=0\n            ;;\n        *)\n            continue\n            ;;\n    esac\n    tmp=$(mktemp -d /tmp/git-deploy.XXXXXX)\n    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\n    mkdir -p \"$target\"\n    if [ \"$preserve_dev\" -eq 1 ]; then\n        find \"$target\" -mindepth 1 -maxdepth 1 ! -name dev -exec rm -rf -- {} +\n    else\n        find \"$target\" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +\n    fi\n    cp -a \"$tmp\"/. \"$target\"/\n    rm -rf \"$tmp\"\n    chown -R git:git \"$target\"\ndone\nEOF\nchmod 755 /git/project/hooks/post-receive\nchown git:git /git/project/hooks/post-receive\nbash -n /git/project/hooks/post-receive\nnginx -t\nnginx -s reload\nprintf 'Verified SSH, Git hook, HTTPS, and Nginx configuration.\\n'\n"]
[62.416724, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> set -e\r\n\u001b[?2004l\r\u001b[?2004h> repo=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> web=/var/www/site\r\n\u001b[?2004l\r\u001b[?2004h> while read -r oldrev newrev refname; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.416801, "o", "    case \"$refname\" in\r\n\u001b[?2004l\r\u001b[?2004h>         refs/heads/main)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.435578, "o", "            target=\"$web\"\r\n\u001b[?2004l\r\u001b[?2004h>             preserve_dev=1\r\n\u001b[?2004l\r\u001b[?2004h>             ;;\r\n\u001b[?2004l\r\u001b[?2004h>         refs/heads/dev)\r\n\u001b[?2004l\r\u001b[?2004h>             target=\"$web/dev\"\r\n\u001b[?2004l\r\u001b[?2004h>             preserve_dev=0\r\n\u001b[?2004l\r\u001b[?2004h>             ;;\r\n\u001b[?2004l\r\u001b[?2004h>         *)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             ;;\r\n\u001b[?2004l\r\u001b[?2004h>     esac\r\n\u001b[?2004l\r\u001b[?2004h>     tmp=$(mktemp -d /tmp/git-deploy.XXXXXX)\r\n\u001b[?2004l\r\u001b[?2004h>     git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>     mkdir -p \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h>     if [ \"$preserve_dev\" -eq 1 ]; then\r\n\u001b[?2004l\r\u001b[?2004h>         find \"$target\" -mindepth 1 -maxdepth 1 ! -name dev -exec rm -rf -- {} +\r\n\u001b[?2004l\r\u001b[?2004h>     else\r\n\u001b[?2004l\r\u001b[?2004h>         find \"$target\" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h>     cp -a \"$tmp\"/. \"$target\"/\r\n\u001b[?2004l\r\u001b[?2004h>     rm -rf \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>     chown -R git:git \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[62.453346, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[62.453435, "o", "chmod 755 /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
[62.475064, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[62.475706, "o", "chown git:git /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
