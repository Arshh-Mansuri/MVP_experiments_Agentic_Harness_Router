[44.746195, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r"]
[44.746456, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r"]
[44.746631, "o", "\u001b[?2004h> set -e"]
[44.74674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> repo=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.746856, "o", "web=/var/www/site\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.746896, "o", "while read -r oldrev newrev refname; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.747012, "o", "    case \"$refname\" in\r\n\u001b[?2004l\r\u001b[?2004h>         refs/heads/main) target=\"$web\" ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.747209, "o", "        refs/heads/dev) target=\"$web/dev\" ;;\r\n\u001b[?2004l\r\u001b[?2004h>         *) continue ;;\r\n\u001b[?2004l\r\u001b[?2004h>     esac\r\n\u001b[?2004l\r"]
[44.747321, "o", "\u001b[?2004h>     tmp=$(mktemp -d /tmp/git-deploy.XXXXXX)\r\n\u001b[?2004l\r"]
[44.747419, "o", "\u001b[?2004h> "]
[44.747541, "o", "    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.747664, "o", ">     mkdir -p \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.747779, "o", "    find \"$target\" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +\r\n\u001b[?2004l\r\u001b[?2004h>     cp -a \"$tmp\"/. \"$target\"/\r\n\u001b[?2004l\r\u001b[?2004h>     rm -rf \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.747864, "o", "    chown -R git:git \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.747935, "o", "EOF\r\n\u001b[?2004l\r"]
[44.766426, "o", "\u001b[?2004hroot@34b11946f285:/app# chmod 755 /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
[44.783759, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[44.78379, "o", "chown git:git /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
[44.805502, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[44.805614, "o", "mkdir -p /etc/ssh/sshd_config.d\r\n\u001b[?2004l\r"]
[44.823254, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[44.823356, "o", "cat > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> PasswordAuthentication yes\r\n\u001b[?2004l\r"]
[44.823459, "o", "\u001b[?2004h> KbdInteractiveAuthentication yes\r\n\u001b[?2004l\r\u001b[?2004h> UsePAM yes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.823526, "o", "EOF\r\n\u001b[?2004l\r"]
[44.849378, "o", "\u001b[?2004hroot@34b11946f285:/app# ssh-keygen -A\r\n\u001b[?2004l\r"]
[44.888195, "o", "\u001b[?2004hroot@34b11946f285:/app# mkdir -p /run/sshd\r\n\u001b[?2004l\r"]
[44.906138, "o", "\u001b[?2004hroot@34b11946f285:/app# sshd -t\r\n\u001b[?2004l\r"]
[44.975496, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[44.975666, "o", "mkdir -p /etc/nginx/ssl\r\n\u001b[?2004l\r"]
[44.99384, "o", "\u001b[?2004hroot@34b11946f285:/app# "]
[44.993947, "o", "if [ ! -f /etc/nginx/ssl/git-server.crt ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.994235, "o", "  openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\r\n\u001b[?2004l\r"]
[44.994331, "o", "\u001b[?2004h>     -keyout /etc/nginx/ssl/git-server.key \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.994463, "o", "    -out /etc/nginx/ssl/git-server.crt \\\r\n\u001b[?2004l\r\u001b[?2004h>     -subj '/CN=localhost' \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.994589, "o", "    -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
