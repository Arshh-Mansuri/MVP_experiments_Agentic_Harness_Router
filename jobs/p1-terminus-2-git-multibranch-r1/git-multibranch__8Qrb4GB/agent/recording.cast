[44.442096, "i", "set -e\nid git >/dev/null 2>&1 || useradd -m -d /home/git -s /bin/bash git\necho 'git:password' | chpasswd\nmkdir -p /git /var/www/site /var/www/site/dev\nif [ ! -d /git/project ]; then git init --bare /git/project; fi\nchown -R git:git /git /home/git\nchown -R git:git /var/www/site\ncat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nset -e\nrepo=/git/project\nweb=/var/www/site\nwhile read -r oldrev newrev refname; do\n    case \"$refname\" in\n        refs/heads/main) target=\"$web\" ;;\n        refs/heads/dev) target=\"$web/dev\" ;;\n        *) continue ;;\n    esac\n    tmp=$(mktemp -d /tmp/git-deploy.XXXXXX)\n    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\n    mkdir -p \"$target\"\n    find \"$target\" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +\n    cp -a \"$tmp\"/. \"$target\"/\n    rm -rf \"$tmp\"\n    chown -R git:git \"$target\"\ndone\nEOF\nchmod 755 /git/project/hooks/post-receive\nchown git:git /git/project/hooks/post-receive\nmkdir -p /etc/ssh/sshd_config.d\ncat > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'\nPasswordAuthentication yes\nKbdInteractiveAuthentication yes\nUsePAM yes\nEOF\nssh-keygen -A\nmkdir -p /run/sshd\nsshd -t\nmkdir -p /etc/nginx/ssl\nif [ ! -f /etc/nginx/ssl/git-server.crt ]; then\n  openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\n    -keyout /etc/nginx/ssl/git-server.key \\\n    -out /etc/nginx/ssl/git-server.crt \\\n    -subj '/CN=localhost' \\\n    -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'\nfi\ncat > /etc/nginx/sites-available/git-server <<'EOF'\nserver {\n    listen 8443 ssl;\n    listen [::]:8443 ssl;\n    server_name localhost;\n    root /var/www/site;\n    index index.html;\n    ssl_certificate /etc/nginx/ssl/git-server.crt;\n    ssl_certificate_key /etc/nginx/ssl/git-server.key;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\nrm -f /etc/nginx/sites-enabled/default\nln -sf /etc/nginx/sites-available/git-server /etc/nginx/sites-enabled/git-server\nnginx -t\nif pgrep -x sshd >/dev/null; then pkill -HUP -x sshd; else /usr/sbin/sshd; fi\nif pgrep -x nginx >/dev/null; then nginx -s reload; else nginx; fi\nsleep 1\nss -ltnp | grep -E ':(22|8443) ' || true\ncurl -k -s -o /dev/null -w 'HTTPS status: %{http_code}\\n' https://localhost:8443/\nprintf 'Server setup complete.\\n'\n"]
