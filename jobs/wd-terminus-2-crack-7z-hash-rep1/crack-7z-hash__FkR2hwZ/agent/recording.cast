[1382.453081, "o", "thin the .sfx!\r\n/app/john/run/7z2john.pl:3527:  if (sfx_7z_pe_search ($fp))\r\n/app/john/run/7z2john.pl:3550:  while (sfx_7z_512_search ($fp) != 0)\r\n/app/john/run/7z2john.pl:3582:    print STDERR \"WARNING: searching for the 7z signature in a $file_size bytes long file ('\";\r\n/app/john/run/7z2john.pl:3588:  my ($full_search_found, $full_search_idx) = sfx_7z_full_search ($fp);\r\n/app/john/run/7z2john.pl:3600:      # we can skip the database updates because it's our last try to find the 7z file\r\n/app/john/run/7z2john.pl:3618:    ($full_search_found, $full_search_idx) = sfx_7z_full_search ($fp);\r\n/app/john/run/7z2john.pl:3760:      print STDERR \"WARNING: it seems that some files could be part of a splitted 7z archive named '$file_prefix'\\n\";\r\n/app/john/run/7z2john.pl:3854:  # check if valid and supported 7z file\r\n/app/john/run/7z2john.pl:3858:    print STDERR \"ERROR: the splitted archive file '$first_splitted_file' is not a valid 7z file\\n\";\r\n/app/john/run/7z2john.pl:3913:# try to handle this special case: splitted .7z files (.7z.001, .7z.002, .7z.003, ...)\r\n/app/john/run/bitlocker2john.py:5:# - $bitlocker$0$ and $bitlocker$1$ = VMK protected by a user password\r\n/app/john/run/bitlocker2john.py:16:PROTECTION_TYPES = {0x0: 'VMK protected with clear key', 0x100: 'VMK protected with TPM', 0x200: 'VMK protected with startup key', 0x500: 'VMK protected with TPM and PIN', 0x800: 'VMK protected with recovery password', 0x2000: 'VMK protected with password'}\r\n/app/john/run/bitlocker2john.py:249:        print(\"\\nNo hashes associated with the user password or recovery password found. Exiting...\")\r\n/app/john/run/utf8.chr:6676:�\u0017\u000b�\u0017\f�\u0017\r�\u0017\u000e�\u0017\u000f�\u0017\u0010�\u0017\u0011�\u0017\u0012�\u0017\u0013�\u0017\u0014�\u0017\u0015�\u0017\u0016�\u0017\u0017�ae1ionrls02tm3c98dy54hu6b7kgpjvfwzAxEIOLRNSTMqCD.BYH!_UPKGJ-* VF@WZ#/X$,&+\\Q?)=(�'�;%<]�~[^:�`\"�>�������{�}��ĳ�����|���⼡���������׀Ή��źЇ����я�ύ