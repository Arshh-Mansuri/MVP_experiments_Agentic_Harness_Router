[1382.441454, "o", "/app/john/LICENSE:3:John the Ripper password cracker,\r\n/app/john/LICENSE:37:password hashing) implementation found in John the Ripper, I have placed\r\n/app/john/LICENSE:43:The intent is to provide modern password hashing for your servers and\r\n/app/john/run/mcafee_epo2john.py:3:# Convert McAfee ePO passwords to John format.\r\n/app/john/run/mcafee_epo2john.py:25:# Loaded 1 password hashes with 1 different salts (dynamic_24 [sha1($p.$s) 128/128 AVX 10x4x1])\r\n/app/john/run/dynamic_flat_sse_formats.conf:1:# NOTE, same format as dynamic_0  It is slower (50% slower, or more).  But it is not limited to 55 byte passwords.\r\n/app/john/run/dynamic_flat_sse_formats.conf:2:# This should work for passwords up to 110 bytes long (max length dynamic will currently allow). It should not be\r\n/app/john/run/dynamic_flat_sse_formats.conf:3:# used for shorter passwords (under 55 bytes).  Use dyna_0 for those.\r\n/app/john/run/androidfde2john.py:54:#  * Finally there is the salt used with the user password.\r\n/app/john/run/mac2john-alt.py:66:        print(\"This program helps in extracting password hashes from OS X / macOS systems (>= Mountain Lion -> 10.8+).\\n\")\r\n/app/john/run/dns/tsig.py:239:        # print(\"MAC is valid for the given password!\")\r\n/app/john/run/7z2john.pl:27:# - is able to identify and parse .7z files\r\n/app/john/run/7z2john.pl:28:# - is able to identify and parse splitted .7z files (.7z.001, .7z.002, ...)\r\n/app/john/run/7z2john.pl:45:# \"7z\"\r\n/app/john/run/7z2john.pl:81:# This field is the first field after the hash signature (i.e. after \"$7z$).\r\n/app/john/run/7z2john.pl:170:my $SEVEN_ZIP_MAGIC = \"7z\\xbc\\xaf\\x27\\x1c\";\r\n/app/john/run/7z2john.pl:207:my $SEVEN_ZIP_AES               = \"\\x06\\xf1\\x07\\x01\"; # all the following codec values are from CPP/7zip/Archive/7z/7zHeader.h\r\n/app/john/run/7z2john.pl:227:my $SEVEN_ZIP_HASH_SIGNATURE    = \"\\$7z\\$\";\r\n/app/john/run/7z2john.pl:320:        print STDERR \"ERROR: could not read from splitted 7z file '$name'\\n\";\r\n/app/john/run/7z2john.pl:1166:      print STDERR \"Since AES-CBC is used by the 7z algorithm and the data length of this file allows a padding attack,\\n\";\r\n/app/john/run/7z2john.pl:1167:      print STDERR \"the password recovery tool might be able to use that to verify the correctness of password candidates.\\n\";\r\n/app/john/run/7z2john.pl:1181:        print STDERR \"INFO: it might still be possible to crack the password of this archive since the data part seems\\n\";\r\n/app/john/run/7z2john.pl:1227:  my $type_of_data = $SEVEN_ZIP_UNCOMPRESSED; # this variable will hold the \"number\" after the \"$7z$\" hash signature\r\n/app/john/run/7z2john.pl:1401:              print STDERR \"      The problem might have to do with this small paragraph hidden in the 7z documentation (quote):\\n\";\r\n/app/john/run/7z2john.pl:1408:              print STDERR \"      (taken from the DOC/lzma-specification.txt file of the 7z-SDK: see for instance:\\n\";\r\n/app/john/run/7z2john.pl:1425:    # check the decompressed 7zip header\r\n/app/john/run/7z2john.pl:1524:      print STDERR \"WARNING: no AES data found in the 7z file '\" . $file_path . \"'\\n\";\r\n/app/john/run/7z2john.pl:3188:      # when we reach this code section we probably found an invalid 7z file (just ignore it!)\r\n/app/john/run/7z2john.pl:3281:  # check if valid and supported 7z file\r\n/app/john/run/7z2john.pl:3304:# 1. only use sfx-checks whenever the 7z header is not at start (i.e. if parsing of a \"regular\" 7z failed)\r\n/app/john/run/7z2john.pl:3309:# sfx_7z_pe_search () searches for the 7z signature by seeking to the correct offset in the PE file\r\n/app/john/run/7z2john.pl:3312:sub sfx_7z_pe_search\r\n/app/john/run/7z2john.pl:3403:  # check if 7z signature found (after stub)\r\n/app/john/run/7z2john.pl:3419:# sfx_7z_512_search () searches for the 7z signature by only looking at every 512 byte boundery\r\n/app/john/run/7z2john.pl:3421:sub sfx_7z_512_search\r\n/app/john/run/7z2john.pl:3453:# sfx_7z_full_search () searches for the 7z signature by looking at every byte in the file\r\n/app/john/run/7z2john.pl:3456:sub sfx_7z_full_search\r\n/app/john/run/7z2john.pl:3521:  # we make the assump"]
