[?2004l[?2004h>   if f==1: cur[x]=(cur[x]+a)&255
[?2004l[?2004h>   elif f==2: cur[x]=(cur[x]+bb)&255
[?2004l[?2004h>   elif f==3: cur[x]=(cur[x]+((a+bb)//2))&255
[?2004l[?2004h>   elif f==4:
[?2004l[?2004h>    q=a+bb-c; pa=abs(q-a); pb=abs(q-bb); pc=abs(q-c); pr=a if pa<=pb and pa<=pc else (bb if pb<=pc else c)
