def main():

GALT = b’0000TBENCH-SALT”

img_ bytes = read_file_ bytes( ‘Tapp/code.png’)

ho = cha256(img_ bytes)

# cha256(ho // hof:10] |/ SALT)

H = cha2z56(ho, hof:10], SALT)

print(H.bex())

return
