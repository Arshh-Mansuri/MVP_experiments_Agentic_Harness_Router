[?2004l[?2004h>   elif ct==4: v=q[0]
[?2004l[?2004h>   elif ct==6: v=(299*q[0]+587*q[1]+114*q[2])//1000
[?2004l[?2004h>   else: v=255 if q[0]==0 else 0
[?2004l[?2004h>   vals.append(v)
[?2004l[?2004h>  pix.append(vals)
