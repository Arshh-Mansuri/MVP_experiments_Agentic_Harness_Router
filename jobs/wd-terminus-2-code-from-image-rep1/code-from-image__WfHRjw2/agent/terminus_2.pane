[?2004hroot@3bde421fb98f:/app# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> b=open('/tmp/code.pgm','rb').read(); m=re.match(rb'P5\s+(\d+)\s+(\d+)\s+255\s',b); w,h=map(int,m.groups()); pix=b[m.end():]
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for y in range(h):
[?2004l[?2004h>  row=pix[y*w:(y+1)*w]
[?2004l[?2004h>  rows.append(sum(v<180 for v in row))
[?2004l[?2004h> active=[i for i,n in enumerate(rows) if n>2]
[?2004l[?2004h> groups=[]
[?2004l[?2004h> for y in active:
[?2004l[?2004h>  if not groups or y>groups[-1][-1]+2: groups.append([y])
[?2004l[?2004h>  else: groups[-1].append(y)
[?2004l[?2004h> print('size',w,h,'line groups',[(g[0],g[-1]) for g in groups])
[?2004l[?2004h> for k,g in enumerate(groups):
[?2004l[?2004h>  y0=max(0,g[0]-3); y1=min(h,g[-1]+4)
[?2004l[?2004h>  xs=[]
[?2004l[?2004h>  for y in range(y0,y1):
[?2004l[?2004h>   row=pix[y*w:(y+1)*w]
[?2004l[?2004h>   xs += [x for x,v in enumerate(row) if v<180]
[?2004l[?2004h>  if not xs: continue
[?2004l[?2004h>  x0=max(0,min(xs)-5); x1=min(w,max(xs)+6)
[?2004l[?2004h>  # downsample into at most 180 columns, preserving enough glyph detail
[?2004l[?2004h>  target=min(180,x1-x0)
[?2004l[?2004h>  sx=(x1-x0)/target
[?2004l[?2004h>  print('\nLINE',k+1,'bbox',x0,y0,x1,y1)
[?2004l[?2004h>  for yy in range(y0,y1):
[?2004l[?2004h>   out=''
[?2004l[?2004h>   for j in range(target):
[?2004l[?2004h>    a=int(x0+j*sx); z=max(a+1,int(x0+(j+1)*sx))
[?2004l[?2004h>    v=min(pix[yy*w+a:yy*w+z])
[?2004l[?2004h>    out += '##' if v<100 else ('++' if v<180 else '  ')
[?2004l[?2004h>   if out.strip(): print(out.rstrip())
[?2004l[?2004h> PY
