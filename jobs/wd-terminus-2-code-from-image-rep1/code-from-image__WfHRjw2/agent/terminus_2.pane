import hashlib
p='/app/code.png'; data=open(p,'rb').read(); h=hashlib.sha256(data).digest()
salts=[b'0000T-BENCH-SALT',b'0000TBENCH-SALT',b'0000T-BENCH_SALT',b'0000Tbench-SALT',b'0000TBENCH-SALT']
parts=[h+h[:10],h.hex().encode()+h.hex()[:10].encode()]
for salt in salts:
 for base in parts:
  for sep in [b'',b'|',b'//',b' ']:
   out=hashlib.sha256(base+sep+salt).hexdigest()
   print(salt, 'match' if out.startswith('bee26a') else '', out)
