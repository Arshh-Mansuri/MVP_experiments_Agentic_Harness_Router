[134.206221, "i", "python3 - <<'PY'\nimport hashlib\np='/app/code.png'; data=open(p,'rb').read(); h=hashlib.sha256(data).digest()\nsalts=[b'0000T-BENCH-SALT',b'0000TBENCH-SALT',b'0000T-BENCH_SALT',b'0000Tbench-SALT',b'0000TBENCH-SALT']\nparts=[h+h[:10],h.hex().encode()+h.hex()[:10].encode()]\nfor salt in salts:\n for base in parts:\n  for sep in [b'',b'|',b'//',b' ']:\n   out=hashlib.sha256(base+sep+salt).hexdigest()\n   print(salt, 'match' if out.startswith('bee26a') else '', out)\nPY\n"]
[134.278046, "o", "python3 - <<'PY'\r\nimport hashlib\r\np='/app/code.png'; data=open(p,'rb').read(); h=hashlib.sha256(data).digest()\r\nsalts=[b'0000T-BENCH-SALT',b'0000TBENCH-SALT',b'0000T-BENCH_SALT',b'0000Tbench-SALT',b'0000TBENCH-SALT']\r\nparts=[h+h[:10],h.hex().encode()+h.hex()[:10].encode()]\r\nfor salt in salts:\r\n for base in parts:\r\n  for sep in [b'',b'|',b'//',b' ']:\r\n   out=hashlib.sha256(base+sep+salt).hexdigest()\r\n   print(salt, 'match' if out.startswith('bee26a') else '', out)\r\nPY\r\n"]
