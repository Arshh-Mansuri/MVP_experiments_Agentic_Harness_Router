[41.373889, "i", "python3 - <<'PY'\nimport struct,zlib\np='/app/code.png'; b=open(p,'rb').read()\nassert b[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\npos=8; chunks=[]; data=b''; w=h=ct=bd=None\nwhile pos<len(b):\n n=struct.unpack('>I',b[pos:pos+4])[0]; typ=b[pos+4:pos+8]; dat=b[pos+8:pos+8+n]; pos+=12+n\n chunks.append((typ.decode('latin1'),n))\n if typ==b'IHDR': w,h,bd,ct,comp,flt,inter=struct.unpack('>IIBBBBB',dat); print('PNG',w,h,'bitdepth',bd,'color type',ct,'interlace',inter)\n if typ==b'IDAT': data+=dat\n if typ==b'IEND': break\nprint('chunks:',chunks)\nraw=zlib.decompress(data)\nprint('raw bytes:',len(raw))\n# Decode 8-bit non-interlaced PNGs (likely RGB/RGBA/grayscale)\nchannels={0:1,2:3,3:1,4:2,6:4}[ct]; bpp=channels\nstride=w*bpp; rows=[]; i=0; prev=[0]*stride\nfor y in range(h):\n f=raw[i]; i+=1; cur=list(raw[i:i+stride]); i+=stride\n for x in range(stride):\n  a=cur[x-bpp] if x>=bpp else 0; bb=prev[x]; c=prev[x-bpp] if x>=bpp else 0\n  if f==1: cur[x]=(cur[x]+a)&255\n  elif f==2: cur[x]=(cur[x]+bb)&255\n  elif f==3: cur[x]=(cur[x]+((a+bb)//2))&255\n  el"]
