[151.57895, "o", "parts=[h+h[:10],h.hex().encode()+h.hex()[:10].encode()]\r\n\u001b[?2004l\r\u001b[?2004h> for salt in salts:\r\n\u001b[?2004l\r\u001b[?2004h>  for base in parts:\r\n\u001b[?2004l\r\u001b[?2004h>   for sep in [b'',b'|',b'//',b' ']:\r\n\u001b[?2004l\r\u001b[?2004h>    out=hashlib.sha256(base+sep+salt).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>    print(salt, 'match' if out.startswith('bee26a') else '', out)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
