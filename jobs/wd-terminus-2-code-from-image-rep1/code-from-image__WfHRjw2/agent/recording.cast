[52.49811, "o", " sx=(x1-x0)/target\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\nLINE',k+1,'bbox',x0,y0,x1,y1)\r\n\u001b[?2004l\r\u001b[?2004h>  for yy in range(y0,y1):\r\n\u001b[?2004l\r\u001b[?2004h>   out=''\r\n\u001b[?2004l\r\u001b[?2004h>   for j in range(target):\r\n\u001b[?2004l\r\u001b[?2004h>    a=int(x0+j*sx); z=max(a+1,int(x0+(j+1)*sx))\r\n\u001b[?2004l\r\u001b[?2004h>    v=min(pix[yy*w+a:yy*w+z])\r\n\u001b[?2004l\r"]
