[52.489776, "i", "python3 - <<'PY'\nimport re\nb=open('/tmp/code.pgm','rb').read(); m=re.match(rb'P5\\s+(\\d+)\\s+(\\d+)\\s+255\\s',b); w,h=map(int,m.groups()); pix=b[m.end():]\nrows=[]\nfor y in range(h):\n row=pix[y*w:(y+1)*w]\n rows.append(sum(v<180 for v in row))\nactive=[i for i,n in enumerate(rows) if n>2]\ngroups=[]\nfor y in active:\n if not groups or y>groups[-1][-1]+2: groups.append([y])\n else: groups[-1].append(y)\nprint('size',w,h,'line groups',[(g[0],g[-1]) for g in groups])\nfor k,g in enumerate(groups):\n y0=max(0,g[0]-3); y1=min(h,g[-1]+4)\n xs=[]\n for y in range(y0,y1):\n  row=pix[y*w:(y+1)*w]\n  xs += [x for x,v in enumerate(row) if v<180]\n if not xs: continue\n x0=max(0,min(xs)-5); x1=min(w,max(xs)+6)\n # downsample into at most 180 columns, preserving enough glyph detail\n target=min(180,x1-x0)\n sx=(x1-x0)/target\n print('\\nLINE',k+1,'bbox',x0,y0,x1,y1)\n for yy in range(y0,y1):\n  out=''\n  for j in range(target):\n   a=int(x0+j*sx); z=max(a+1,int(x0+(j+1)*sx))\n   v=min(pix[yy*w+a:yy*w+z])\n   out += '##' if v<100 else ('++' if v<180 el"]
[52.490753, "i", "se '  ')\n  if out.strip(): print(out.rstrip())\nPY\n"]
