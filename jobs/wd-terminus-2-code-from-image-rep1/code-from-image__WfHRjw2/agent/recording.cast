[41.382882, "i", "if f==4:\n   q=a+bb-c; pa=abs(q-a); pb=abs(q-bb); pc=abs(q-c); pr=a if pa<=pb and pa<=pc else (bb if pb<=pc else c)\n   cur[x]=(cur[x]+pr)&255\n  elif f!=0: raise Exception('filter '+str(f))\n rows.append(cur); prev=cur\n# luminance and crop\npix=[]\nfor row in rows:\n vals=[]\n for x in range(w):\n  q=row[x*bpp:x*bpp+bpp]\n  if ct==0: v=q[0]\n  elif ct==2: v=(299*q[0]+587*q[1]+114*q[2])//1000\n  elif ct==4: v=q[0]\n  elif ct==6: v=(299*q[0]+587*q[1]+114*q[2])//1000\n  else: v=255 if q[0]==0 else 0\n  vals.append(v)\n pix.append(vals)\n# make PGM\nwith open('/tmp/code.pgm','wb') as f:\n f.write(f'P5\\n{w} {h}\\n255\\n'.encode()); f.write(bytes(v for row in pix for v in row))\n# crop non-white bounding box\npts=[(x,y) for y in range(h) for x,v in enumerate(pix[y]) if v<220]\nif pts:\n x0=min(x for x,y in pts); x1=max(x for x,y in pts); y0=min(y for x,y in pts); y1=max(y for x,y in pts)\n print('content bbox',x0,y0,x1,y1)\nelse: x0=y0=0; x1=w-1; y1=h-1\n# render at native-ish resolution, preserve text with 2x2 blocks\nchars='@%#*+=-:. '\nfor "]
