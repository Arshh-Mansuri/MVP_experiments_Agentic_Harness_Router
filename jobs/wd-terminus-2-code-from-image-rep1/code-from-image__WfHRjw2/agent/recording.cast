[142.086545, "i", "python3 - <<'PY'\nimport hashlib\nwith open('/app/code.png','rb') as f:\n    img_bytes=f.read()\nsalt=b'0000TBENCH-SALT'\nh0=hashlib.sha256(img_bytes).digest()\nH=hashlib.sha256(h0 + h0[:10] + salt).hexdigest()\nprint('h0 =', h0.hex())\nprint('H  =', H)\nwith open('/app/output.txt','w') as f:\n    f.write(H+'\\n')\nPY\ncat /app/output.txt\n"]
