[293.544697, "i", "cat > eval.scm <<'EOF'\n;; Metacircular evaluator using interp.py's fread primitive.\n\n(define (second x) (car (cdr x)))\n(define (third x) (car (cdr (cdr x))))\n(define (fourth x) (car (cdr (cdr (cdr x)))))\n(define (list1 a) (cons a '()))\n(define (list2 a b) (cons a (cons b '())))\n(define (list3 a b c) (cons a (cons b (cons c '()))))\n(define (list4 a b c d) (cons a (cons b (cons c (cons d '())))))\n\n(define (append a b)\n  (if (null? a) b (cons (car a) (append (cdr a) b))))\n\n;; An environment is (bindings . parent), and each binding is (name . value).\n(define (make-env parent) (cons '() parent))\n(define (define-var e name value)\n  (set-car! e (cons (cons name value) (car e))))\n(define (find e name)\n  (if (null? e) #f\n      (find-bindings (car e) name e)))\n(define (find-bindings bs name e)\n  (if (null? bs)\n      (find (cdr e) name)\n      (if (eq? (car (car bs)) name)\n          (car bs)\n          (find-bindings (cdr bs) name e))))\n(define (lookup e name)\n  (let ((b (find e name)))\n    (if b (cdr b) #f)))\n(define (as"]
[293.546774, "i", "sign e name value)\n  (let ((b (find e name)))\n    (if b (set-cdr! b value)\n        (assign (cdr e) name value))))\n\n(define (make-closure params body env)\n  (list4 'closure params body env))\n(define (closure? x)\n  (and (pair? x) (eq? (car x) 'closure)))\n\n(define (bind-all names values env)\n  (if (null? names) env\n      (begin\n        (define-var env (car names) (car values))\n        (bind-all (cdr names) (cdr values) env))))\n\n(define (eval-list xs env)\n  (if (null? xs) '()\n      (cons (evaluate (car xs) env)\n            (eval-list (cdr xs) env))))\n\n(define (eval-sequence xs env)\n  (if (null? xs) #f\n      (if (null? (cdr xs))\n          (evaluate (car xs) env)\n          (begin (evaluate (car xs) env)\n                 (eval-sequence (cdr xs) env)))))\n\n(define (sum xs n)\n  (if (null? xs) n (sum (cdr xs) (+ n (car xs)))))\n(define (product xs n)\n  (if (null? xs) n (product (cdr xs) (* n (car xs)))))\n\n(define (primitive name args)\n  (if (eq? name '+) (sum args 0)\n      (if (eq? name '-)\n          (if (null? (cdr args"]
