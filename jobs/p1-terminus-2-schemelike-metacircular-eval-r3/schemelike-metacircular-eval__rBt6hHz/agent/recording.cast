[13.206116, "o", " function - reads an S-expression from input\r\n   349\t    def read_sexp():\r\n   350\t        line = input()\r\n   351\t        tokens = tokenize(line)\r\n   352\t        if tokens:\r\n   353\t            expr, _ = parse_expr(tokens, 0)\r\n   354\t            return expr\r\n   355\t        return None\r\n   356\t\r\n   357\t    env.define(\"read\", read_sexp)\r\n   358\t\r\n   359\t    def symbol_from_list(lst):\r\n   360\t        chars = []\r\n   361\t        while lst is not None:\r\n   362\t            if isinstance(lst, Pair):\r\n   363\t                chars.append(chr(lst.car))\r\n   364\t                lst = lst.cdr\r\n   365\t            else:\r\n   366\t                break\r\n   367\t        return \"\".join(chars)\r\n   368\t\r\n   369\t    env.define(\"symbol\", symbol_from_list)\r\n   370\t\r\n   371\t    # Additional built-ins needed for eval.scm\r\n   372\t    env.define(\"symbol?\", lambda x: isinstance(x, str))\r\n   373\t    env.define(\"string?\", lambda x: isinstance(x, String))\r\n   374\t    env.define(\"number?\", lambda x: isinstance(x, int))\r\n   375\t    env.define(\"se"]
