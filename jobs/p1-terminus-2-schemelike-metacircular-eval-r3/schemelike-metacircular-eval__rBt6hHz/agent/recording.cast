[13.208211, "o", ", fgetchr)\r\n   475\t    env.define(\"fputchr\", fputchr)\r\n   476\t    env.define(\"fdisplay\", fdisplay)\r\n   477\t    env.define(\"fread\", fread)\r\n   478\t\r\n   479\t    return env\r\n   480\t\r\n   481\t\r\n   482\tdef run_file(filename):\r\n   483\t    env = make_global_env()\r\n   484\t\r\n   485\t    with open(filename, \"r\") as f:\r\n   486\t        content = f.read()\r\n   487\t\r\n   488\t    tokens = tokenize(content)\r\n   489\t    index = 0\r\n   490\t\r\n   491\t    while index < len(tokens):\r\n   492\t        try:\r\n   493\t            # Parse one complete expression\r\n   494\t            expr, new_index = parse_expr(tokens, index)\r\n   495\t            index = new_index\r\n   496\t\r\n   497\t            # Evaluate it\r\n   498\t            eval_expr(expr, env)\r\n   499\t\r\n   500\t            # Don't print results - only display/newline should print\r\n   501\t            pass\r\n   502\t\r\n   503\t        except SchemeError as e:\r\n   504\t            print(f\"Error: {e}\")\r\n   505\t            break\r\n   506\t\r\n   507\t        except Exception as e:\r\n   508\t            print(f"]
[13.208236, "o", "\"Unexpected error: {e}\")\r\n   509\t            break\r\n   510\t\r\n   511\t\r\n   512\tdef parse_expr(tokens, index):\r\n   513\t    if index >= len(tokens):\r\n   514\t        raise SchemeError(\"Unexpected end of input\")\r\n   515\t\r\n   516\t    token = tokens[index]\r\n   517\t\r\n   518\t    if token == \"(\":\r\n   519\t        index += 1\r\n   520\t        elements = []\r\n   521\t        while index < len(tokens) and tokens[index] != \")\":\r\n   522\t            expr, index = parse_expr(tokens, index)\r\n   523\t            elements.append(expr)\r\n   524\t        if index >= len(tokens):\r\n   525\t            raise SchemeError(\"Missing closing parenthesis\")\r\n   526\t        index += 1\r\n   527\t\r\n   528\t        result = None\r\n   529\t        for i in range(len(elements) - 1, -1, -1):\r\n   530\t            result = Pair(elements[i], result)\r\n   531\t        return result, index\r\n   532\t\r\n   533\t    elif token == \")\":\r\n   534\t        raise SchemeError(\"Unexpected closing parenthesis\")\r\n   535\t\r\n   536\t    elif isinstance(token, String):\r\n   537\t        return"]
[13.20825, "o", " token, index + 1\r\n   538\t\r\n   539\t    elif token == \"'\":\r\n   540\t        expr, index = parse_expr(tokens, index + 1)\r\n   541\t        return Pair(\"quote\", Pair(expr, None)), index\r\n   542\t\r\n   543\t    else:\r\n   544\t        # Try to parse as number\r\n   545\t        try:\r\n   546\t            return int(token), index + 1\r\n   547\t        except ValueError:\r\n   548\t            pass\r\n   549\t\r\n   550\t        # Check for boolean literals\r\n   551\t        if token == \"#t\":\r\n   552\t            return True, index + 1\r\n   553\t        elif token == \"#f\":\r\n   554\t            return False, index + 1\r\n   555\t\r\n   556\t        # Otherwise it's a symbol\r\n   557\t        return token, index + 1\r\n   558\t\r\n   559\t\r\n   560\tdef parse(tokens):\r\n"]
