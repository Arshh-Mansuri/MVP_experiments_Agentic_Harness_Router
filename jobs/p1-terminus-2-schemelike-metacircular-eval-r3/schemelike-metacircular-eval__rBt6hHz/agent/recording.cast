[506.786046, "o", "grep -nE 'define \\(run-file|define target|define file|define root|install root|define \\(evaluate|eq\\? op' eval.scm; sed -n '145,205p' eval.scm\r\n\u001b[?2004l\r"]
[506.834277, "o", "132:(define (evaluate expr env)\r\n136:          ((eq? op 'quote) (car args))\r\n137:          ((eq? op 'if)\r\n141:          ((eq? op 'lambda) (make-closure (car args) (cdr args) env))\r\n142:          ((eq? op 'define)\r\n147:          ((eq? op 'set!) (assign env (car args) (evaluate (second args) env)))\r\n148:          ((or (eq? op 'begin) (eq? op 'progn)) (eval-sequence args env))\r\n149:          ((eq? op 'let) (eval-let (car args) (cdr args) env))\r\n150:          ((eq? op 'cond) (eval-cond args env))\r\n161:(define (run-file f env)\r\n170:(define target (read))\r\n171:(define file (fopen target \"r\"))\r\n172:(define root (make-env '()))\r\n"]
[506.835047, "o", "173:(install root '(+ - * / = < > <= >= cons car cdr null? pair? eq? equal? not and or display newline getchr putchr chr read symbol fopen fclose fgetchr fputchr fdisplay fread string? set-car! set-cdr!))\r\n"]
[506.88728, "o", "                 (make-closure (cdr (car args)) (cdr args) env))\r\n               (define-var env (car args) (evaluate (second args) env))))\r\n          ((eq? op 'set!) (assign env (car args) (evaluate (second args) env)))\r\n          ((or (eq? op 'begin) (eq? op 'progn)) (eval-sequence args env))\r\n          ((eq? op 'let) (eval-let (car args) (cdr args) env))\r\n          ((eq? op 'cond) (eval-cond args env))\r\n          (else (apply-procedure (evaluate op env) (eval-list args env)))))\r\n      (if (or (number? expr) (eq? expr #t) (eq? expr #f) (string? expr))\r\n          expr\r\n          (lookup env expr))))\r\n\r\n(define (install env names)\r\n  (if (null? names) env\r\n      (begin (define-var env (car names) (car names))\r\n             (install env (cdr names)))))\r\n\r\n(define (run-file f env)\r\n  (let ((expr (fread f)))"]
[506.887544, "o", "\r\n    (if (eq? expr #f)\r\n        #f\r\n        (if (null? expr)\r\n            #f\r\n            (begin (evaluate expr env) (run-file f env))))))\r\n\r\n;; Consume exactly the first input expression as the target path.\r\n(define target (read))\r\n(define file (fopen target \"r\"))\r\n(define root (make-env '()))\r\n(install root '(+ - * / = < > <= >= cons car cdr null? pair? eq? equal? not and or display newline getchr putchr chr read symbol fopen fclose fgetchr fputchr fdisplay fread string? set-car! set-cdr!))\r\n(define-var root 'else #t)\r\n(run-file file root)\r\n(fclose file)\r\n"]
