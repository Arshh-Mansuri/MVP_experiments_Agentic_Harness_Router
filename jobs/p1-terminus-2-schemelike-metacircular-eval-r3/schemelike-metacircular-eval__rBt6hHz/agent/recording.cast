[352.481003, "o", "(display \"Reading\")\r\n(newline)\r\n(let ((line (read)))\r\n  (cond\r\n   ((= (car line) '+)\r\n    (display (+ (car (cdr line)) (car (cdr (cdr line))))))\r\n   ((= (car line) '-)\r\n    (display (- (car (cdr line)) (car (cdr (cdr line))))))\r\n   ((= (car line) '*)\r\n    (display (* (car (cdr line)) (car (cdr (cdr line))))))))\r\n(newline)\r\n(display \"Done\")\r\n(newline)\r\n"]
[352.50983, "o", "   435\t    def fread(file_id):\r\n   436\t        if file_id in open_files:\r\n   437\t            tokens = []\r\n   438\t            paren_count = 0\r\n   439\t\r\n   440\t            while True:\r\n   441\t                line = open_files[file_id].readline()\r\n   442\t                if not line:  # EOF\r\n   443\t                    return None\r\n   444\t\r\n   445\t                # Skip empty lines and comments when we have no tokens yet\r\n   446\t                if not tokens and (not line.strip() or line.strip().startswith(\";\")):\r\n   447\t                    continue\r\n   448\t\r\n   449\t                # Tokenize line and add to accumulated tokens\r\n   450\t                line_tokens = tokenize(line.strip())\r\n   451\t                tokens.extend(line_tokens)\r\n   452\t\r\n   453\t                # Count parentheses to check if expression is complete\r\n   454\t                for token in line_tokens:\r\n   455\t                    if token == \"(\":\r\n   456\t                        paren_count += 1\r\n   457\t                    elif token == \")\":\r\n  "]
[352.510406, "o", " 458\t                        paren_count -= 1\r\n   459\t\r\n   460\t                # If parentheses are balanced and we have tokens, try to parse\r\n   461\t                if tokens and paren_count == 0:\r\n   462\t                    try:\r\n   463\t                        expr, _ = parse_expr(tokens, 0)\r\n   464\t                        return expr\r\n   465\t                    except Exception:\r\n   466\t                        # If parsing fails with balanced parens, skip this expression\r\n   467\t                        tokens = []\r\n   468\t                        paren_count = 0\r\n   469\t                        continue\r\n   470\t        return False\r\n   471\t\r\n   472\t    env.define(\"fopen\", fopen)\r\n   473\t    env.define(\"fclose\", fclose)\r\n   474\t    env.define(\"fgetchr\", fgetchr)\r\n   475\t    env.define(\"fputchr\", fputchr)\r\n   476\t    env.define(\"fdisplay\", fdisplay)\r\n   477\t    env.define(\"fread\", fread)\r\n   478\t\r\n   479\t    return env\r\n   480\t\r\n   481\t\r\n"]
