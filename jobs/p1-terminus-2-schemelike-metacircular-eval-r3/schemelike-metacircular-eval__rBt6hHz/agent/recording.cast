[155.257937, "i", "python3 - <<'PY'\np='eval.scm'\nlines=open(p).read().splitlines()\nfor i,line in enumerate(lines):\n    if line.startswith('(define (sum '):\n        j=i-1\n        while j>=0 and lines[j].strip()=='': j-=1\n        if lines[j].rstrip().endswith(')'):\n            lines[j]=lines[j].rstrip()[:-1]\n        break\nopen(p,'w').write('\\n'.join(lines)+'\\n')\nPY\npython3 - <<'PY'\ns=open('eval.scm').read(); st=[]; ins=False; esc=False; line=1\nfor c in s:\n if c=='\\n': line+=1\n if ins:\n  if esc: esc=False\n  elif c=='\\\\': esc=True\n  elif c=='\"': ins=False\n elif c=='\"': ins=True\n elif c=='(': st.append((line,c))\n elif c==')':\n  if st: st.pop()\n  else: print('extra close at',line)\nprint('unclosed', [x[0] for x in st])\nPY\n"]
