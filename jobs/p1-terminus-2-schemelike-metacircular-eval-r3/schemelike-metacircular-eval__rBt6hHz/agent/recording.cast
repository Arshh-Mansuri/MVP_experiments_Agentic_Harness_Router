[352.668769, "i", "python3 - <<'PY'\np='eval.scm'; s=open(p).read()\ns=s.replace(\"(define target (read))\\n(define file (fopen target \\\"r\\\"))\", \"(define target (read))\\n(define file (fopen target \\\"r\\\"))\")\ns=s.replace(\"(define (run-file f env)\\n  (let ((expr (fread f)))\\n    (if expr\\n        (begin (evaluate expr env) (run-file f env))\\n        #f)))\", \"(define (run-file f env)\\n  (let ((expr (fread f)))\\n    (if (eq? expr #f)\\n        #f\\n        (if (null? expr)\\n            #f\\n            (begin (evaluate expr env) (run-file f env))))))\")\nopen(p,'w').write(s)\nPY\npython3 - <<'PY'\ns=open('eval.scm').read(); st=[]; ins=False; esc=False\nfor c in s:\n if ins:\n  if esc: esc=False\n  elif c=='\\\\': esc=True\n  elif c=='\"': ins=False\n elif c=='\"': ins=True\n elif c=='(': st.append(c)\n elif c==')':\n  if st: st.pop()\n  else: print('extra')\nprint('unclosed',len(st))\nPY\n"]
