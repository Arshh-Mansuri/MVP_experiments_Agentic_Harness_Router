(define (install env names)
  (if (null? names) env
      (begin (define-var env (car names) (car names))
             (install env (cdr names)))))

(define (run-file f env)
  (let ((expr (fread f)))
    (if (eq? expr #f)
        #f
        (if (null? expr)
            #f
            (begin (evaluate expr env) (run-file f env))))))

;; Consume exactly the first input expression as the target path.
(define target (read))
(define file (fopen target "r"))
(define root (make-env '()))
(install root '(+ - * / = < > <= >= cons car cdr null? pair? eq? equal? not and or display newline getchr putchr chr read symbol fopen fclose fgetchr fputchr fdisplay fread string? set-car! set-cdr!))
(define-var root 'else #t)
(run-file file root)
(fclose file)
