;; Test filter operations

(define (filter pred lst)
  (cond ((null? lst) '())
        ((pred (car lst))
         (cons (car lst) (filter pred (cdr lst))))
        (else (filter pred (cdr lst)))))

(define (even? n)
  (= (- n (* (/ n 2) 2)) 0))

(define (odd? n)
