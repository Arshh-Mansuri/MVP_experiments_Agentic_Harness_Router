(define (out-chars x) (if (null? x) #f (begin (putchr (car x)) (out-chars (cdr x)))))
(define (out-tail x)
  (if (null? x) #f (begin (putchr 32) (out (car x)) (out-tail (cdr x)))))

(define (apply* p a)
  (if (closure? p)
      (let ((e (new-env (fourth p))))
        (bind-params (second p) a e)
        (ev-seq (third p) e))
      (prim p a)))
(define (evaluate x e)
  (if (pair? x)
      (let ((op (car x)) (args (cdr x)))
        (if (eq? op 'quote) (car args)
            (if (eq? op 'if) (if (evaluate (car args) e) (evaluate (second args) e) (evaluate (third args) e))
