                                    (if (eq? op 'let)
                                        (let ((ne (new-env e))) (let-bind (car args) ne e) (ev-seq (cdr args) ne))
                                        (if (eq? op 'cond) (cond-eval args e)
                                            (apply* (evaluate op e) (ev-args args e)))))))))))
      (if (str? x) x (if (or (number? x) (eq? x #t) (eq? x #f)) x (lookup e x)))))
(define (let-bind bs ne e)
  (if (null? bs) #f (bind ne (car (car bs)) (evaluate (second (car bs)) e)) (let-bind (cdr bs) ne e)))
(define (cond-eval cs e)
  (if (null? cs) #f (if (evaluate (car (car cs)) e) (ev-seq (cdr (car cs)) e) (cond-eval (cdr cs) e))))

(define (run xs e)
  (let ((p (parse-one xs)))
    (if (car p) (begin (evaluate (car p) e) (run (second p) e)) #f)))

;; First input expression is the path; all later input remains available to read.
(define target (read))
(define fh (fopen target "r"))
(define source (read-file fh))
(fclose fh)
(define root (new-env '()))
(run source root)
