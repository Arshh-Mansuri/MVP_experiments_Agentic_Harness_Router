                    (if (eq? op 'begin) (ev-seq args e)
                        (if (eq? op 'lambda) (closure (car args) (cdr args) e)
                            (if (eq? op 'define)
                                (if (pair? (car args))
                                    (let ((n (car (car args))) (v (closure (cdr (car args)) (cdr args) e))) (bind e n v))
