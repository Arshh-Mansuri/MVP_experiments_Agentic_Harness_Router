rue\n\n    if not (buyer_found and seller_found and book_found and valid_owner):\n        print(\'Transaction failed due to validation errors\')\n        return\n\n    # COBOL PIC 9(10) fields are fixed-width, zero-padded decimal fields.\n    # Apply the account updates in file order, preserving all other bytes.\n    for offset, record in records(accounts, ACCOUNT_SIZE):\n        account_id = bytes(record[0:4])\n        if account_id == buyer_id:\n            balance = int(bytes(record[24:34])) - amount\n            accounts[offset + 24:offset + 34] = f\'{balance:010d}\'.encode(\'ascii\')\n        if account_id == seller_id:\n            balance = int(bytes(record[24:34])) + amount\n            accounts[offset + 24:offset + 34] = f\'{balance:010d}\'.encode(\'ascii\')\n\n    for offset, record in records(books, BOOK_SIZE):\n        if bytes(record[0:4]) == book_id:\n            books[offset + 24:offset + 28] = buyer_id\n\n    accounts_path.write_bytes(accounts)\n    books_path.write_bytes(books)\n    with transactions_path.open(\'ab\') as transaction_file:\n        transaction_file.write(book_id + f\'{amount:010d}\'.encode(\'ascii\') + seller_id + buyer_id)\n\n    print(\'Transaction completed successfully\')\n\n\nif __name__ == \'__main__\':\n    main()\nPY\nchmod +x /app/program.py\npython3 -m py_compile /app/program.py\nsed -n \'1,240p\' /app/program.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
