[?2004l[?2004h> import re,math
[?2004l[?2004h> b=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\d+',b[17:])));w=2400
[?2004l[?2004h> # sample every 6 pixels; only grayscale lower pixels
[?2004l[?2004h> S=[]
[?2004l[?2004h> for y in range(900,1800,6):
[?2004l[?2004h>  z=y-900
[?2004l[?2004h>  for x in range(0,w,6):
[?2004l[?2004h>   r,g,q=a[3*(y*w+x):3*(y*w+x)+3]
[?2004l[?2004h>   if r==g==q and r in (67,152):S.append((x-1200,z,0 if r==152 else 1))
[?2004l[?2004h> print('samples',len(S))
[?2004l[?2004h> best=(0,None)
[?2004l[?2004h> for h in [0,1,5,10,20,30,40,50,60,75,100]:
[?2004l[?2004h>  for A in [i/20 for i in range(10,81)]:
[?2004l[?2004h>   for B in range(400,2001,25):
[?2004l[?2004h>    for C in range(2):
[?2004l[?2004h>     ok=0
[?2004l[?2004h>     for X,z,t in S:
[?2004l[?2004h>      zz=z+h
[?2004l[?2004h>      v=((int(math.floor(A*X/zz))+int(math.floor(B/zz))+C)&1)
[?2004l[?2004h>      ok+=v==t
[?2004l[?2004h>     if ok>best[0]:best=(ok,(A,B,C,h))
[?2004l[?2004h> print(best,best[0]/len(S))
