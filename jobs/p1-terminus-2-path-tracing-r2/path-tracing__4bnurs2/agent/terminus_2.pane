[?2004hroot@cebfdc561d16:/app# python3 - <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> b=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\d+',b[17:])));w=2400
[?2004l[?2004h> for y in [840,850,860,870,880,890,900,910,920,930,940,950,1000,1100,1200,1300,1400]:
[?2004l[?2004h>  r=[];last=None;st=0
[?2004l[?2004h>  for x in range(w):
[?2004l[?2004h>   q=tuple(a[3*(y*w+x):3*(y*w+x)+3])
[?2004l[?2004h>   if q!=last:
[?2004l[?2004h>    if x-st>8:r.append((st,x,last))
[?2004l[?2004h>    st=x;last=q
[?2004l[?2004h>  print(y,r)
[?2004l[?2004h> PY
