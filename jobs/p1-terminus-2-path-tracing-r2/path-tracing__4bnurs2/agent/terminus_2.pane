[?2004lpython3 - <<'PY'
import re,collections
b=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\d+',b[17:])));w=2400
for y in [840,850,860,870,880,890,900,910,920,930,940,950,1000,1100,1200,1300,1400]:
 r=[];last=None;st=0
 for x in range(w):
  q=tuple(a[3*(y*w+x):3*(y*w+x)+3])
  if q!=last:
   if x-st>8:r.append((st,x,last))
   st=x;last=q
 print(y,r)
