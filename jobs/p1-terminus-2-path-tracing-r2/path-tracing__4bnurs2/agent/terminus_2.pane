import re,collections,statistics
s=open('/app/image.ppm','rb').read(); a=list(map(int,re.findall(rb'\d+',s[17:])))
w,h=2400,1800
p=[a[i:i+3] for i in range(0,len(a),3)]
print('pixels',len(p),'minmax',min(a),max(a),'unique colors',len(set(map(tuple,p))))
print('top colors',collections.Counter(map(tuple,p)).most_common(25))
print('coarse RGB samples:')
for y in range(0,h,150):
 print(y, ['%d,%d,%d'%tuple(p[y*w+x]) for x in range(0,w,150)])
print('row averages:')
for y in range(0,h,50):
 q=p[y*w:(y+1)*w]; print(y,tuple(round(sum(z[k] for z in q)/w,1) for k in range(3)))
print('column averages:')
for x in range(0,w,100):
 q=p[x::w]; print(x,tuple(round(sum(z[k] for z in q)/h,1) for k in range(3)))
