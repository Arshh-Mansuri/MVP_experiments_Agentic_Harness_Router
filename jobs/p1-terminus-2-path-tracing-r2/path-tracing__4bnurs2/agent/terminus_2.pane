import re
b=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\d+',b[17:])));w=2400
for y in [0,100,200,400,600,800]:
 print(y,[tuple(a[3*(y*w+x):3*(y*w+x)+3]) for x in [0,300,600,900,1200,1500,1800,2100,2399]])
