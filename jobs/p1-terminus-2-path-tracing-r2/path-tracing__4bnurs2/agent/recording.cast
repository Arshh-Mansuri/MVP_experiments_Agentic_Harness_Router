[16.609292, "i", "cat > /tmp/an.py <<'PY'\nimport re,collections,statistics\ns=open('/app/image.ppm','rb').read(); a=list(map(int,re.findall(rb'\\d+',s[17:])))\nw,h=2400,1800\np=[a[i:i+3] for i in range(0,len(a),3)]\nprint('pixels',len(p),'minmax',min(a),max(a),'unique colors',len(set(map(tuple,p))))\nprint('top colors',collections.Counter(map(tuple,p)).most_common(25))\nprint('coarse RGB samples:')\nfor y in range(0,h,150):\n print(y, ['%d,%d,%d'%tuple(p[y*w+x]) for x in range(0,w,150)])\nprint('row averages:')\nfor y in range(0,h,50):\n q=p[y*w:(y+1)*w]; print(y,tuple(round(sum(z[k] for z in q)/w,1) for k in range(3)))\nprint('column averages:')\nfor x in range(0,w,100):\n q=p[x::w]; print(x,tuple(round(sum(z[k] for z in q)/h,1) for k in range(3)))\nPY\npython3 /tmp/an.py > /tmp/stats.txt\nhead -80 /tmp/stats.txt\n"]
