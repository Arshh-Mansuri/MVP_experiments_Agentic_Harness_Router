[334.450932, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();s=s.replace('floor(1200/z))&1','floor(1350/z))&1');open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport re,math\ndef r(p):return list(map(int,re.findall(rb'\\d+',open(p,'rb').read()[17:])))\na=r('image.ppm');b=r('reconstructed.ppm');e=sum((x-y)**2 for x,y in zip(a,b));s=sum(x*x for x in a);print('similarity',1-math.sqrt(e/s))\nfor l,u in [(0,900),(900,1200),(1200,1800)]:\n i=3*2400*l;j=3*2400*u;e=sum((x-y)**2 for x,y in zip(a[i:j],b[i:j]));s=sum(x*x for x in a[i:j]);print(l,u,1-math.sqrt(e/s))\nPY\n"]
