[371.292168, "i", "python3 - <<'PY'\nimport re\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\nfor x in [300,400,500,700,1800,2100]:\n print('X',x); last=None;st=900\n for y in range(900,1800):\n  q=tuple(a[3*(y*w+x):3*(y*w+x)+3])\n  if q!=last:\n   if y-st>=5: print(st,y,last)\n   st=y;last=q\n print(st,1800,last)\nPY\n"]
