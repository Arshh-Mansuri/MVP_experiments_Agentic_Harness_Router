[6.893363, "o", "\u001b[?2004h>  w,h,maxv=map(int,m.groups()[1:]); off=m.end(); print('w h max',w,h,maxv,'offset',off)\r\n\u001b[?2004l\r\u001b[?2004h>  if m.group(1)==b'6':\r\n\u001b[?2004l\r\u001b[?2004h>   pix=b[off:off+3*w*h]; c=collections.Counter(tuple(pix[i:i+3]) for i in range(0,len(pix)-2,3)); print('colors',len(c),'top',c.most_common(20))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
