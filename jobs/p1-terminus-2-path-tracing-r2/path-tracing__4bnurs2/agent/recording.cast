[811.338923, "i", "cat >/tmp/search2.py <<'PY'\nimport re,math\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400;S=[]\nfor y in range(910,1800,10):\n z=y-900\n for x in range(0,w,10):\n  if 950<x<1450:continue\n  i=3*(y*w+x);r,g,q=a[i:i+3]\n  if r==g==q and r in (67,152):S.append((x,z,0 if r==152 else 1))\nprint(len(S));best=(0,None)\nfor A in [1.45+i*.01 for i in range(11)]:\n for O in range(1150,1251,5):\n  for B in range(700,1701,10):\n   for ph in range(2):\n    n=0\n    for x,z,t in S:\n     v=(int(math.floor(A*(x-O)/z))+int(math.floor(B/z))+ph)&1;n+=v==t\n    if n>best[0]:best=(n,(A,O,B,ph))\nprint(best,best[0]/len(S))\nPY\npython3 /tmp/search2.py\n"]
