[268.771177, "i", "python3 - <<'PY'\nimport re,math\n\ndef read(p):\n b=open(p,'rb').read();return list(map(int,re.findall(rb'\\d+',b[17:])))\na=read('image.ppm');b=read('reconstructed.ppm');\nse=0;sa=0; n=len(a)\nfor x,y in zip(a,b):se+=(x-y)*(x-y);sa+=x*x\nprint('rmse',math.sqrt(se/n),'relative_l2',math.sqrt(se/sa),'approx_similarity',1-math.sqrt(se/sa))\nfor y0,y1 in [(0,900),(900,1200),(1200,1800)]:\n i=3*2400*y0;j=3*2400*y1;e=sum((x-y)**2 for x,y in zip(a[i:j],b[i:j]));s=sum(x*x for x in a[i:j]);print(y0,y1,math.sqrt(e/(j-i)),1-math.sqrt(e/s))\nPY\n"]
