[45.199689, "i", "python3 - <<'PY'\nimport re,collections\nw,h=2400,1800\nf=open('/app/image.ppm','rb'); f.readline(); f.readline(); f.readline()\n# Parse tokens incrementally, retain only sampled pixels and row/column means\nbuf=b''; nums=[]; n=0; rows=[[] for _ in range(12)]; cols=[[] for _ in range(24)]; c=collections.Counter(); mins=[999]*3; maxs=[0]*3\nwhile n<w*h:\n b=f.read(1<<20)\n if not b: break\n buf+=b\n z=re.findall(rb'\\d+',buf); tail=re.search(rb'\\d*$',buf)\n if tail: buf=tail.group(); z=z[:-1] if tail.group()==z[-1] else z\n nums.extend(map(int,z))\n while len(nums)>=3 and n<w*h:\n  rgb=tuple(nums[:3]); nums=nums[3:]; x=n%w; y=n//w; n+=1\n  c[rgb]+=1\n  for k in range(3): mins[k]=min(mins[k],rgb[k]); maxs[k]=max(maxs[k],rgb[k])\n  if x%(w//24)==0: cols[x//(w//24)].append((y,rgb))\n  if y%(h//12)==0 and x%(w//24)==0: rows[y//(h//12)].append(rgb)\nprint('pixels',n,'range',mins,maxs,'colors',len(c)); print('top',c.most_common(20)); print('samples')\nfor y,row in enumerate(rows): print(y*h//12,row)\nPY\n"]
[45.200377, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[45.201356, "o", "\u001b[?2004h> import re,collections\r\n\u001b[?2004l\r\u001b[?2004h> w,h=2400,1800\r\n\u001b[?2004l\r\u001b[?2004h> f=open('/app/image.ppm','rb'); f.readline(); f.readline(); f.readline()\r\n\u001b[?2004l\r\u001b[?2004h> # Parse tokens incrementally, retain only sampled pixels and row/column means\r\n\u001b[?2004l\r\u001b[?2004h> "]
