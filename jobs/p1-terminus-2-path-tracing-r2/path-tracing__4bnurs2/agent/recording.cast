[769.024434, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();old='r=(int)(146.42475+10.27459*t+100.46499*t*t-86.86687*t*t*t+20.19274*d-59.17651*d*t+66.96629*d*t*t);g=(int)(189.22462-3.79276*t+141.42367*t*t-148.29979*t*t*t+20.94152*d-112.07164*d*t+142.23012*d*t*t);b=255;'\nnew='r=(int)(144.72978+44.63052*t-114.30778*t*t+350.89603*t*t*t-275.87506*t*t*t*t+36.56502*d-88.42473*d*t-126.96332*d*t*t+322.57208*d*t*t*t-36.48396*d*d+251.68044*d*d*t-329.29407*d*d*t*t);g=(int)(187.23926+48.53416*t-193.23850*t*t+546.53560*t*t*t-445.12797*t*t*t*t+44.21194*d-179.15986*d*t-168.11343*d*t*t+559.70568*d*t*t*t-57.50445*d*d+457.36597*d*d*t-604.01068*d*d*t*t);b=255;'\nassert old in s;s=s.replace(old,new);open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport re,math\ndef r(p):return list(map(int,re.findall(rb'\\d+',open(p,'rb').read()[17:])))\na=r('image.ppm');b=r('reconstructed.ppm');e=sum((x-y)**2 for x,y in zip(a,b));s=sum(x*x for x in a);print('overall',1-math.sqrt(e/s))\nfor l,u in [(0,900),(900,1200),(1200,1800)]:\n i=3*2400*l;j=3*2400*u;e=sum((x-y)**2 for x,y in zip(a[i:j],b[i:j]));s=sum(x*x for x in a[i:j]);print(l,u,1-math.sqrt(e/s))\nPY\necho -n 'gzip_bytes=';gzip -c image.c|wc -c\n"]
