[1504.265181, "o", "for name,cond in [('all',lambda x,y:1),('outer',lambda x,y:not(950<x<1450)),('sky',lambda x,y:y<900),('floor',lambda x,y:y>=900 and not(950<x<1450)),('center',lambda x,y:950<x<1450 and y>=900)]:\r\n\u001b[?2004l\r"]
