[6.890832, "i", "python3 - <<'PY'\nimport re,collections,math\np='/app/image.ppm'; b=open(p,'rb').read();\nprint('bytes',len(b),'head',b[:80])\nm=re.match(br'P([356])\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s',b)\nprint('header',m.groups() if m else None)\nif m:\n w,h,maxv=map(int,m.groups()[1:]); off=m.end(); print('w h max',w,h,maxv,'offset',off)\n if m.group(1)==b'6':\n  pix=b[off:off+3*w*h]; c=collections.Counter(tuple(pix[i:i+3]) for i in range(0,len(pix)-2,3)); print('colors',len(c),'top',c.most_common(20))\nPY\n"]
[6.891459, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[6.891851, "o", "\u001b[?2004h> "]
[6.892072, "o", "import re,collections,math\r\n\u001b[?2004l\r"]
