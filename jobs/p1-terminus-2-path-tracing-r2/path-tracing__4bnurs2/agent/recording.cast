[544.374995, "i", "cat >/tmp/fit.py <<'PY'\nimport re,math\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\n# accumulate normal equations for basis [1,t,t2,t3,d,dt,dt2]\nN=7; M=[[0.]*N for _ in range(N)];Y=[[0.,0.] for _ in range(N)]\nfor y in range(0,900,10):\n t=y/900.;\n for x in range(0,w,10):\n  i=3*(y*w+x);r,g,bv=a[i:i+3]\n  d=((x-1200)/1200.)**2; q=[1,t,t*t,t*t*t,d,d*t,d*t*t]\n  for j in range(N):\n   Y[j][0]+=q[j]*r;Y[j][1]+=q[j]*g\n   for k in range(N):M[j][k]+=q[j]*q[k]\ndef solve(v):\n A=[M[i][:]+[v[i]] for i in range(N)]\n for i in range(N):\n  z=max(range(i,N),key=lambda j:abs(A[j][i]));A[i],A[z]=A[z],A[i];q=A[i][i]\n  for k in range(i,N+1):A[i][k]/=q\n  for j in range(N):\n   if j!=i:\n    q=A[j][i]\n    for k in range(i,N+1):A[j][k]-=q*A[i][k]\n return [A[i][N] for i in range(N)]\ncr,cg=solve([x[0] for x in Y]),solve([x[1] for x in Y]);print('R',cr);print('G',cg)\nfor y in [0,100,200,400,600,800]:\n print(y,[tuple(a[3*(y*w+x):3*(y*w+x)+3]) for x in [0,600,1200,1800,2399]])\nPY\npython3 /tmp/fit.py\n"]
