[303.574123, "i", "python3 - <<'PY'\nimport re\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\nP=lambda x,y:tuple(a[3*(y*w+x):3*(y*w+x)+3])\nfor x in [0,300,600,800,900,1000,1400,1500,1800,2100,2399]:\n print('\\nX',x);last=P(x,900);st=900\n for y in range(901,1800):\n  q=P(x,y)\n  if q!=last:\n   if y-st>=8 and (last in [(67,67,67),(152,152,152),(20,20,20),(46,46,46),(51,10,10)]):print(st,y,last)\n   st=y;last=q\n if 1800-st>=8: print(st,1800,last)\nPY\n"]
