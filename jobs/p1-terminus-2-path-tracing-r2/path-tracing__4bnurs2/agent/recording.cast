[91.398918, "i", "python3 - <<'PY'\nimport re,collections\nb=open('/app/image.ppm','rb').read(); a=list(map(int,re.findall(rb'\\d+',b[17:]))); w=2400; h=1800\nfor y in [0,400,800,820,840,860,880,900,950,1000,1100,1200,1300,1400,1500,1700,1799]:\n r=[tuple(a[3*(y*w+x):3*(y*w+x)+3]) for x in range(w)]\n runs=[]; st=0\n for x in range(1,w+1):\n  if x==w or r[x]!=r[st]:\n   if x-st>10:runs.append((st,x,x-st,r[st]))\n   st=x\n print(y,runs[:40])\nPY\n"]
