[717.919056, "o", "int main(){int W=2400,H=1800,x,y,r,g,b;FILE*f=fopen(\"reconstructed.ppm\",\"w\");fprintf(f,\"P3\\n%d %d\\n255\\n\",W,H);for(y=0;y<H;y++)for(x=0;x<W;x++){double X=x-1200.,t=y/900.,z=y-900.,d=X*X/1440000.;if(y<900){r=(int)(146.42475+10.27459*t+100.46499*t*t-86.86687*t*t*t+20.19274*d-59.17651*d*t+66.96629*d*t*t);g=(int)(189.22462-3.79276*t+141.42367*t*t-148.29979*t*t*t+20.94152*d-112.07164*d*t+142.23012*d*t*t);b=255;}else{int q=z<1?0:((int)floor(1.5*X/z)+(int)floor(1350/z)+1)&1;r=g=q?67:152;b=r;double L=0,R=0;int k=0;if(y<1160){k=1;L=y<950?1041-(y-900)*.4:y<1000?1021-(y-950)*.1:y<1050?1016+(y-1000)*.18:y<1100?1025+(y-1050)*.5:1050+(y-1100)*1.06;R=y<950?1268+(y-900)*.96:y<1000?1316+(y-950)*.62:y<1050?1347+(y-1000)*.3:y<1100?1362-(y-1050)*.24:1350-(y-1100)*1.06;}else if(y<1170){k=2;L=1011;R=1279;}else if(y<1210){k=3;L=951-(y-1170)*3.3;R=1267+(y-1170)*.3;}else if(y<1240){k=4;L=783-(y-1210)*2.13;R=1275-(y-1210)*.57;}else if(y<1350){k=3;L=691-(y-1240)*1.73;R=1247-(y-1240)*1.9;}else if(y<1420){k=4;L=500+(y-1350)*.17;R=1007-(y-1350)*3.74;}if(k&&x>=L&&x<R){if(k==1){r=51;g=10;b=10;}else if(k==2||k==4)r=g=b=46;else r=g=b=20;}}fprintf(f,\"%d %d %d\\n\",r,g,b);}fclose(f);return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
