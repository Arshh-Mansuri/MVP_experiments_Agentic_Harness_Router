[1504.257893, "i", "grep -o 'floor([^;]*' image.c; python3 - <<'PY'\nimport re,math,collections\n\ndef read(p): return list(map(int,re.findall(rb'\\d+',open(p,'rb').read()[17:])))\na=read('image.ppm');b=read('reconstructed.ppm');w=2400;H=1800\nfor name,cond in [('all',lambda x,y:1),('outer',lambda x,y:not(950<x<1450)),('sky',lambda x,y:y<900),('floor',lambda x,y:y>=900 and not(950<x<1450)),('center',lambda x,y:950<x<1450 and y>=900)]:\n n=e=ok=0\n for y in range(0,H,4):\n  for x in range(0,w,4):\n   if cond(x,y):\n    i=3*(y*w+x);q=a[i:i+3];r=b[i:i+3];n+=3;e+=sum((u-v)**2 for u,v in zip(q,r));ok+=q==r\n print(name,'exact',ok/(n/3),'rmse',math.sqrt(e/n))\nprint('target colors',collections.Counter(tuple(a[i:i+3]) for i in range(0,len(a),3)).most_common(12))\nPY\n"]
