[401.645853, "i", "cat >/tmp/search.py <<'PY'\nimport re,math\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\n# sample every 6 pixels; only grayscale lower pixels\nS=[]\nfor y in range(900,1800,6):\n z=y-900\n for x in range(0,w,6):\n  r,g,q=a[3*(y*w+x):3*(y*w+x)+3]\n  if r==g==q and r in (67,152):S.append((x-1200,z,0 if r==152 else 1))\nprint('samples',len(S))\nbest=(0,None)\nfor h in [0,1,5,10,20,30,40,50,60,75,100]:\n for A in [i/20 for i in range(10,81)]:\n  for B in range(400,2001,25):\n   for C in range(2):\n    ok=0\n    for X,z,t in S:\n     zz=z+h\n     v=((int(math.floor(A*X/zz))+int(math.floor(B/zz))+C)&1)\n     ok+=v==t\n    if ok>best[0]:best=(ok,(A,B,C,h))\nprint(best,best[0]/len(S))\nPY\npython3 /tmp/search.py\n"]
