[116.973287, "i", "python3 - <<'PY'\nimport re\nb=open('/app/image.ppm','rb').read(); a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400;h=1800\nfor j in range(45):\n s=''\n for i in range(60):\n  x=min(w-1,(i*w)//60);y=min(h-1,(j*h)//45); r,g,z=a[3*(y*w+x):3*(y*w+x)+3]\n  if r>180 and g>210 and z>240:c='.'\n  elif r>145 and r<190 and abs(r-g)<3:c='G'\n  elif r<35 and abs(r-g)<3:c='D'\n  elif r<60 and g<20:c='R'\n  elif r<100 and abs(r-g)<3:c='d'\n  else:c='?'\n  s+=c\n print(s)\nPY\n"]
