[595.752281, "i", "python3 - <<'PY'\nimport re\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\nfor y in range(900,1800,10):\n q=[];on=0;st=0;col=None\n for x in range(500,1900):\n  i=3*(y*w+x);r,g,b=a[i:i+3]; k=(r==g==b and r in (20,46)) or (r==51 and g==10)\n  if k and not on:st=x;on=1;col=(r,g,b)\n  if on and (not k or x==1899):\n   if x-st>3:q.append((st,x,col))\n   on=0\n print(y,q)\nPY\n"]
