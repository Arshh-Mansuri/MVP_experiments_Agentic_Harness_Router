[616.093615, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();old='double a=z<0?0:z<60?52+2.6*z:150;\\nif(fabs(X)<a){if(y<1180)r=51,g=10,b=10;else if(y<1237)r=g=b=20;else if(y<1279)r=g=b=46;}'\nnew='double L=0,R=0;int k=0;if(y>=900&&y<1160){double u=(y-900)/250.;L=1041+X*0;L=1041-25*u+37*u*u;R=1268+110*u-28*u*u;k=1;}else if(y>=1160&&y<1210){L=1011-4.56*(y-1160);R=1279-0.08*(y-1160);k=2;}else if(y>=1210&&y<1340){L=783-2.18*(y-1210);R=1275-1.82*(y-1210);k=3;}else if(y>=1340&&y<1420){L=500+0.9*(y-1340);R=1038-5.0*(y-1340);k=4;}if(k&&x>=L&&x<R){if(k==1)r=51,g=10,b=10;else if(k==2)r=g=b=46;else if(k==3)r=g=b=20;else r=g=b=20;}'\nassert old in s;s=s.replace(old,new);open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport re,math\ndef r(p):return list(map(int,re.findall(rb'\\d+',open(p,'rb').read()[17:])))\na=r('image.ppm');b=r('reconstructed.ppm');e=sum((x-y)**2 for x,y in zip(a,b));s=sum(x*x for x in a);print('overall',1-math.sqrt(e/s))\nfor l,u in [(0,900),(900,1200),(1200,1800)]:\n i=3*2400*l;j=3*2400*u;e=sum((x-y)**2 for x,y in zip(a[i:j],b[i:j]));s=sum(x*x for x in a[i:j]);print(l,u,1-math.sqrt(e/s))\nPY\ngzip -c image.c | wc -c\n"]
