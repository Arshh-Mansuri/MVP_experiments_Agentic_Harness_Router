[561.056963, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();old='r=(int)(146+38*t*t+1.5*t+13*d*(1-.55*t));g=(int)(190+25*t*t+2*t+7*d*(1-.5*t));b=255;';new='r=(int)(146.42475+10.27459*t+100.46499*t*t-86.86687*t*t*t+20.19274*d-59.17651*d*t+66.96629*d*t*t);g=(int)(189.22462-3.79276*t+141.42367*t*t-148.29979*t*t*t+20.94152*d-112.07164*d*t+142.23012*d*t*t);b=255;';assert old in s;s=s.replace(old,new);open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport re,math\ndef r(p):return list(map(int,re.findall(rb'\\d+',open(p,'rb').read()[17:])))\na=r('image.ppm');b=r('reconstructed.ppm');e=sum((x-y)**2 for x,y in zip(a,b));s=sum(x*x for x in a);print('overall',1-math.sqrt(e/s))\nfor l,u in [(0,900),(900,1200),(1200,1800)]:\n i=3*2400*l;j=3*2400*u;e=sum((x-y)**2 for x,y in zip(a[i:j],b[i:j]));s=sum(x*x for x in a[i:j]);print(l,u,1-math.sqrt(e/s))\nPY\ngzip -c image.c | wc -c\n"]
