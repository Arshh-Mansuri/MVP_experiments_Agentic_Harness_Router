[750.501954, "i", "cat >/tmp/fit2.py <<'PY'\nimport re\nb=open('image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\n# basis: t^0..t^4, d*t^0..t^3, d^2*t^0..t^2\nN=12;M=[[0.0]*N for _ in range(N)];Y=[[0.,0.] for _ in range(N)]\nfor y in range(0,900,8):\n t=y/900.;\n for x in range(0,w,8):\n  i=3*(y*w+x);r,g,z=a[i:i+3];d=((x-1200)/1200.)**2\n  q=[t**j for j in range(5)]+[d*t**j for j in range(4)]+[d*d*t**j for j in range(3)]\n  for j in range(N):\n   Y[j][0]+=q[j]*r;Y[j][1]+=q[j]*g\n   for k in range(N):M[j][k]+=q[j]*q[k]\ndef sol(v):\n A=[M[i][:]+[v[i]] for i in range(N)]\n for i in range(N):\n  z=max(range(i,N),key=lambda j:abs(A[j][i]));A[i],A[z]=A[z],A[i];q=A[i][i]\n  for k in range(i,N+1):A[i][k]/=q\n  for j in range(N):\n   if j!=i:\n    q=A[j][i]\n    for k in range(i,N+1):A[j][k]-=q*A[i][k]\n return [A[i][N] for i in range(N)]\nprint('R',sol([v[0] for v in Y]));print('G',sol([v[1] for v in Y]))\nPY\npython3 /tmp/fit2.py\n"]
