[511.464229, "i", "python3 - <<'PY'\nimport re,collections,math\nD=[]\nfor p in ['image.ppm','reconstructed.ppm']:\n b=open(p,'rb').read();D.append(list(map(int,re.findall(rb'\\d+',b[17:]))))\na,c=D;w=2400\nfor y0,y1 in [(0,900),(900,1200),(1200,1800)]:\n for typ in ['all','gray','sky','red']:\n  ok=n=0\n  for y in range(y0,y1,3):\n   for x in range(0,w,3):\n    i=3*(y*w+x); q=tuple(a[i:i+3]); z=tuple(c[i:i+3]);\n    use=typ=='all' or (typ=='gray' and q[0]==q[1]==q[2]) or (typ=='sky' and q[2]==255 and q[0]!=q[1]) or (typ=='red' and q[0]>q[1]*2)\n    if use:n+=1;ok+=q==z\n  print(y0,y1,typ,n,ok/n if n else 0)\n# sky polynomial least squares using normal equations\nimport numpy as np\nX=[];Y=[]\nfor y in range(0,900,5):\n t=y/900.;\n for x in range(0,w,5):\n  i=3*(y*w+x);r,g,b=a[i:i+3]\n  if b==255 and r!=g:\n   d=((x-1200)/1200)**2;X.append([1,t,t*t,d,d*t,d*t*t]);Y.append([r,g])\nX=np.array(X);Y=np.array(Y);print('coef',np.linalg.lstsq(X,Y,rcond=None)[0]);print('sky rmse',np.sqrt(np.mean((X@np.linalg.lstsq(X,Y,rcond=None)[0]-Y)**2,axis=0)))\nPY\n"]
