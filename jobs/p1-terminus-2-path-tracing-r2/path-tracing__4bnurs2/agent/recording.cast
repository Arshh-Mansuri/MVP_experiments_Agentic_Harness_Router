[153.722853, "i", "python3 - <<'PY'\nimport re,collections\nb=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\nfor y in [840,850,860,870,880,890,900,910,920,930,940,950,1000,1100,1200,1300,1400]:\n r=[];last=None;st=0\n for x in range(w):\n  q=tuple(a[3*(y*w+x):3*(y*w+x)+3])\n  if q!=last:\n   if x-st>8:r.append((st,x,last))\n   st=x;last=q\n print(y,r)\nPY\n"]
[153.724205, "o", "python3 - <<'PY'\r\nimport re,collections\r\nb=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400\r\nfor y in [840,850,860,870,880,890,900,910,920,930,940,950,1000,1100,1200,1300,1400]:\r\n r=[];last=None;st=0\r\n for x in range(w):\r\n  q=tuple(a[3*(y*w+x):3*(y*w+x)+3])\r\n  if q!=last:\r\n   if x-st>8:r.append((st,x,last))\r\n   st=x;last=q\r\n print(y,r)\r\nPY\r\n"]
