[148.538653, "i", "python3 - <<'PY'\nimport re,collections\nb=open('/app/image.ppm','rb').read();a=list(map(int,re.findall(rb'\\d+',b[17:])));w=2400;h=1800\nP=lambda x,y:tuple(a[3*(y*w+x):3*(y*w+x)+3])\nfor x in [0,300,600,900,1200,1500,1800,2100,2399]:\n last=P(x,800); st=800; z=[]\n for y in range(801,h):\n  q=P(x,y)\n  if q!=last:\n   if y-st>3:z.append((st,y,last))\n   st=y;last=q\n print('X',x,z[:40])\nprint('center rows')\nfor y in range(800,1800,10): print(y,P(1200,y))\nPY\n"]
