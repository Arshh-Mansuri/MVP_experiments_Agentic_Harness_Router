[?2004hroot@2f202cba00b1:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80
[?2004l[?2004h> cand=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>  for c in range(8):
[?2004l[?2004h>   p=[im.getpixel((x,y)) for y in range(r*S,(r+1)*S) for x in range(c*S,(c+1)*S)]
[?2004l[?2004h>   if any(sum(q)/3<30 for q in p) or any(sum(q)/3>245 for q in p): cand.append((r,c))
[?2004l[?2004h> for r,c in cand:
[?2004l[?2004h>  name=chr(97+c)+str(8-r); print('\n###',name)
[?2004l[?2004h>  # sample 20x20 blocks, mark black and white extreme pixels
[?2004l[?2004h>  for typ in ('black','white'):
[?2004l[?2004h>   print(typ)
[?2004l[?2004h>   for yy in range(20):
[?2004l[?2004h>    line=''
[?2004l[?2004h>    for xx in range(20):
[?2004l[?2004h>     hit=False
[?2004l[?2004h>     for dy in range(4):
[?2004l[?2004h>      for dx in range(4):
[?2004l[?2004h>       q=im.getpixel((c*S+xx*4+dx,r*S+yy*4+dy)); v=sum(q)/3
[?2004l[?2004h>       if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True
[?2004l[?2004h>     line += '#' if hit else ' '
[?2004l[?2004h>    print(line.rstrip())
[?2004l[?2004h> PY
