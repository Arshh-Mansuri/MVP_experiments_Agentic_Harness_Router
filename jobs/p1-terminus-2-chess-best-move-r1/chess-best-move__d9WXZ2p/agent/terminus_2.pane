[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80
[?2004l[?2004h> sq=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','e5','f5','g5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']
[?2004l[?2004h> for name in sq:
[?2004l[?2004h>  c=ord(name[0])-97; r=8-int(name[1]); pts=[]
[?2004l[?2004h>  for y in range(r*S,(r+1)*S):
[?2004l[?2004h>   for x in range(c*S,(c+1)*S):
[?2004l[?2004h>    v=sum(im.getpixel((x,y)))/3
[?2004l[?2004h>    if v<30 or v>245: pts.append(v)
[?2004l[?2004h>  typ='black' if sum(v<30 for v in pts)>=sum(v>245 for v in pts) else 'white'
[?2004l[?2004h>  print(name,typ)
[?2004l[?2004h>  for yy in range(12):
[?2004l[?2004h>   line=''
[?2004l[?2004h>   for xx in range(16):
[?2004l[?2004h>    hit=False
[?2004l[?2004h>    for y in range(r*S+yy*6,(r*S+(yy+1)*6)):
[?2004l[?2004h>     for x in range(c*S+xx*5,(c*S+(xx+1)*5)):
[?2004l[?2004h>      v=sum(im.getpixel((x,y)))/3
[?2004l[?2004h>      if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True
[?2004l[?2004h>    line += '#' if hit else ' '
[?2004l[?2004h>   print(line.rstrip())
