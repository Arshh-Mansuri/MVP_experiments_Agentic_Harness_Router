[?2004hroot@2f202cba00b1:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> import math
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>   for c in range(8):
[?2004l[?2004h>     pix=[im.getpixel((x,y)) for y in range(r*S+6,(r+1)*S-6) for x in range(c*S+6,(c+1)*S-6)]
[?2004l[?2004h>     gs=[sum(p)/3 for p in pix]; m=sum(gs)/len(gs); sd=math.sqrt(sum((v-m)**2 for v in gs)/len(gs))
[?2004l[?2004h>     mr=sum(p[0] for p in pix)/len(pix); mg=sum(p[1] for p in pix)/len(pix); mb=sum(p[2] for p in pix)/len(pix)
[?2004l[?2004h>     # only print squares with substantial variation beyond board texture
[?2004l[?2004h>     if sd>8:
[?2004l[?2004h>       print(f'{chr(97+c)}{8-r}: mean={m:.1f} rgb=({mr:.0f},{mg:.0f},{mb:.0f}) sd={sd:.1f} min={min(gs):.0f} max={max(gs):.0f}')
[?2004l[?2004h> PY
