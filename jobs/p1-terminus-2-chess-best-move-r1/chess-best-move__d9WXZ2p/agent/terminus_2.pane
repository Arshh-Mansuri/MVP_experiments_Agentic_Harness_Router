[?2004hroot@2f202cba00b1:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>  for c in range(8):
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for y in range(r*S,(r+1)*S):
[?2004l[?2004h>    for x in range(c*S,(c+1)*S):
[?2004l[?2004h>     q=im.getpixel((x,y)); v=sum(q)/3
[?2004l[?2004h>     if v<30 or v>245: vals.append((x-c*S,y-r*S,v))
[?2004l[?2004h>   if not vals: continue
[?2004l[?2004h>   # select dominant extreme: black or white
[?2004l[?2004h>   nb=sum(v<30 for x,y,v in vals); nw=len(vals)-nb; typ='B' if nb>=nw else 'W'; test=(lambda v:v<30) if typ=='B' else (lambda v:v>245)
[?2004l[?2004h>   pts=[(x,y) for x,y,v in vals if test(v)]
[?2004l[?2004h>   bx=(min(x for x,y in pts),max(x for x,y in pts),min(y for x,y in pts),max(y for x,y in pts))
[?2004l[?2004h>   mask=[]
[?2004l[?2004h>   for yy in range(10):
[?2004l[?2004h>    s=''
[?2004l[?2004h>    for xx in range(10):
[?2004l[?2004h>     hit=False
[?2004l[?2004h>     for y in range(yy*8,(yy+1)*8):
[?2004l[?2004h>      for x in range(xx*8,(xx+1)*8):
[?2004l[?2004h>       q=im.getpixel((c*S+x,r*S+y)); v=sum(q)/3
[?2004l[?2004h>       if test(v): hit=True
[?2004l[?2004h>     s += '#' if hit else '.'
[?2004l[?2004h>    mask.append(s)
[?2004l[?2004h>   print(chr(97+c)+str(8-r),typ,'n='+str(len(pts)),'box='+str(bx),' '.join(mask))
[?2004l[?2004h> PY
