[101.656022, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); S=80\nfor name in ['e8','d8','c6','d5','f5','g5','e2','c3','c1']:\n c=ord(name[0])-97; r=8-int(name[1]); vals=[]\n for y in range(r*S,(r+1)*S):\n  for x in range(c*S,(c+1)*S):\n   vals.append(sum(im.getpixel((x,y)))/3)\n typ='black' if sum(v<30 for v in vals)>=sum(v>245 for v in vals) else 'white'\n print('\\n'+name+' '+typ)\n for yy in range(20):\n  line=''\n  for xx in range(20):\n   hit=False\n   for y in range(r*S+yy*4,(r*S+(yy+1)*4)):\n    for x in range(c*S+xx*4,(c*S+(xx+1)*4)):\n     v=sum(im.getpixel((x,y)))/3\n     if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True\n   line += '#' if hit else ' '\n  print(line.rstrip())\nPY\n"]
[101.660706, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80\r\n\u001b[?2004l\r\u001b[?2004h> for name in ['e8','d8','c6','d5','f5','g5','e2','c3','c1']:\r\n\u001b[?2004l\r\u001b[?2004h>  c=ord(name[0])-97; r=8-int(name[1]); vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(r*S,(r+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>   for x in range(c*S,(c+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>    vals.append(sum(im.getpixel((x,y)))/3)\r\n\u001b[?2004l\r\u001b[?2004h>  typ='black' if sum(v<30 for v in vals)>=sum(v>245 for v in vals) else 'white'\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n'+name+' '+typ)\r\n\u001b[?2004l\r\u001b[?2004h>  for yy in range(20):\r\n\u001b[?2004l\r\u001b[?2004h>   line=''\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.661204, "o", ">   for xx in range(20):\r\n\u001b[?2004l\r\u001b[?2004h>    hit=False\r\n\u001b[?2004l\r\u001b[?2004h>    for y in range(r*S+yy*4,(r*S+(yy+1)*4)):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(c*S+xx*4,(c*S+(xx+1)*4)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.661275, "o", "> "]
