[170.600867, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); S=80\nfor name in ['c6','d5','f5','g5','e2','c3','c1']:\n c=ord(name[0])-97; r=8-int(name[1]); vals=[]\n for y in range(r*S,(r+1)*S):\n  for x in range(c*S,(c+1)*S): vals.append(sum(im.getpixel((x,y)))/3)\n black=sum(v<30 for v in vals)>=sum(v>245 for v in vals); mark=(lambda v:v<30) if black else (lambda v:v>245)\n print(name, 'B' if black else 'W')\n for yy in range(16):\n  line=''\n  for xx in range(16):\n   hit=False\n   for y in range(r*S+yy*5,(r*S+(yy+1)*5)):\n    for x in range(c*S+xx*5,(c*S+(xx+1)*5)):\n     if mark(sum(im.getpixel((x,y)))/3): hit=True\n   line+='#' if hit else ' '\n  print(line.rstrip())\nPY\n"]
[170.601723, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[170.602035, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
