[44.604378, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport math\nim=Image.open('chess_board.png').convert('RGB'); S=80\nfor r in range(8):\n  for c in range(8):\n    pix=[im.getpixel((x,y)) for y in range(r*S+6,(r+1)*S-6) for x in range(c*S+6,(c+1)*S-6)]\n    gs=[sum(p)/3 for p in pix]; m=sum(gs)/len(gs); sd=math.sqrt(sum((v-m)**2 for v in gs)/len(gs))\n    mr=sum(p[0] for p in pix)/len(pix); mg=sum(p[1] for p in pix)/len(pix); mb=sum(p[2] for p in pix)/len(pix)\n    # only print squares with substantial variation beyond board texture\n    if sd>8:\n      print(f'{chr(97+c)}{8-r}: mean={m:.1f} rgb=({mr:.0f},{mg:.0f},{mb:.0f}) sd={sd:.1f} min={min(gs):.0f} max={max(gs):.0f}')\nPY\n"]
[44.605094, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[44.60526, "o", "\u001b[?2004h> "]
[44.605535, "o", "from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.605866, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>   for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.606035, "o", "    pix=[im.getpixel((x,y)) for y in range(r*S+6,(r+1)*S-6) for x in range(c*S+6,(c+1)*S-6)]\r\n\u001b[?2004l\r\u001b[?2004h>     gs=[sum(p)/3 for p in pix]; m=sum(gs)/len(gs); sd=math.sqrt(sum((v-m)**2 for v in gs)/len(gs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.606174, "o", "    mr=sum(p[0] for p in pix)/len(pix); mg=sum(p[1] for p in pix)/len(pix); mb=sum(p[2] for p in pix)/len(pix)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.606259, "o", "    # only print squares with substantial variation beyond board texture\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.606321, "o", "    if sd>8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.606503, "o", "      print(f'{chr(97+c)}{8-r}: mean={m:.1f} rgb=({mr:.0f},{mg:.0f},{mb:.0f}) sd={sd:.1f} min={min(gs):.0f} max={max(gs):.0f}')\r\n\u001b[?2004l\r"]
