[86.788771, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); S=80\nsq=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','e5','f5','g5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\nfor name in sq:\n c=ord(name[0])-97; r=8-int(name[1]); pts=[]\n for y in range(r*S,(r+1)*S):\n  for x in range(c*S,(c+1)*S):\n   v=sum(im.getpixel((x,y)))/3\n   if v<30 or v>245: pts.append(v)\n typ='black' if sum(v<30 for v in pts)>=sum(v>245 for v in pts) else 'white'\n print(name,typ)\n for yy in range(12):\n  line=''\n  for xx in range(16):\n   hit=False\n   for y in range(r*S+yy*6,(r*S+(yy+1)*6)):\n    for x in range(c*S+xx*5,(c*S+(xx+1)*5)):\n     v=sum(im.getpixel((x,y)))/3\n     if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True\n   line += '#' if hit else ' '\n  print(line.rstrip())\nPY\n"]
[86.796063, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB'); S=80\r\n\u001b[?2004l\r\u001b[?2004h> sq=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','e5','f5','g5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\r\n\u001b[?2004l\r\u001b[?2004h> for name in sq:\r\n\u001b[?2004l\r\u001b[?2004h>  c=ord(name[0])-97; r=8-int(name[1]); pts=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(r*S,(r+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>   for x in range(c*S,(c+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>    v=sum(im.getpixel((x,y)))/3\r\n\u001b[?2004l\r\u001b[?2004h>    if v<30 or v>245: pts.append(v)\r\n\u001b[?2004l\r\u001b[?2004h>  typ='black' if sum(v<30 for v in pts)>=sum(v>245 for v in pts) else 'white'\r\n\u001b[?2004l\r\u001b[?2004h>  print(name,typ)\r\n\u001b[?2004l\r\u001b[?2004h>  for yy in range(12):\r\n\u001b[?2004l\r\u001b[?2004h>   line=''\r\n\u001b[?2004l\r\u001b[?2004h>   for xx in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>    hit=False\r\n\u001b[?2004l\r\u001b[?2004h>    for y in range(r*S+yy*6,(r*S+(yy+1)*6)):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(c*S+xx*5,(c*S+(xx+1)*5)):\r\n\u001b[?2004l\r\u001b[?2004h>      v=sum(im.getpixel((x,y)))/3\r\n\u001b[?2004l\r\u001b[?2004h>      if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True\r\n\u001b[?2004l\r\u001b[?2004h>    line += '#' if hit else ' '\r\n\u001b[?2004l\r\u001b[?2004h>   print(line.rstrip())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
