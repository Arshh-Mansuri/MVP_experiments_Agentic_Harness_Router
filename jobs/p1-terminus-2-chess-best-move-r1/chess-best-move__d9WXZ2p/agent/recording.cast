[178.191655, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); name='c6'; S=80\nc=ord(name[0])-97; r=8-int(name[1]); vals=[sum(im.getpixel((x,y)))/3 for y in range(r*S,(r+1)*S) for x in range(c*S,(c+1)*S)]\nblack=sum(v<30 for v in vals)>=sum(v>245 for v in vals); test=(lambda v:v<30) if black else (lambda v:v>245)\nprint(name,'black' if black else 'white')\nfor yy in range(16):\n line=''\n for xx in range(16):\n  hit=any(test(sum(im.getpixel((x,y)))/3) for y in range(r*S+yy*5,r*S+(yy+1)*5) for x in range(c*S+xx*5,c*S+(xx+1)*5))\n  line += '#' if hit else '.'\n print(line)\nPY\n"]
[178.194033, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[178.196827, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB'); name='c6'; S=80\r\n\u001b[?2004l\r\u001b[?2004h> c=ord(name[0])-97; r=8-int(name[1]); vals=[sum(im.getpixel((x,y)))/3 for y in range(r*S,(r+1)*S) for x in range(c*S,(c+1)*S)]\r\n\u001b[?2004l\r\u001b[?2004h> black=sum(v<30 for v in vals)>=sum(v>245 for v in vals); test=(lambda v:v<30) if black else (lambda v:v>245)\r\n\u001b[?2004l\r\u001b[?2004h> print(name,'black' if black else 'white')\r\n\u001b[?2004l\r\u001b[?2004h> for yy in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>  line=''\r\n\u001b[?2004l\r\u001b[?2004h>  for xx in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>   hit=any(test(sum(im.getpixel((x,y)))/3) for y in range(r*S+yy*5,r*S+(yy+1)*5) for x in range(c*S+xx*5,c*S+(xx+1)*5))\r\n\u001b[?2004l\r\u001b[?2004h>   line += '#' if hit else '.'\r\n\u001b[?2004l\r\u001b[?2004h>  print(line)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
