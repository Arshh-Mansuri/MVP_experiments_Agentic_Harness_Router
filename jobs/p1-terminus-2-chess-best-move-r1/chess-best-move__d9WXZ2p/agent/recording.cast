[24.684394, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nim=np.array(Image.open('chess_board.png').convert('RGB'))\nS=80\n# Print mean and standard deviation for each square, excluding a small border\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        a=im[r*S+8:(r+1)*S-8,c*S+8:(c+1)*S-8].astype(float)\n        row.append('%3d/%3d'%(a.mean(),a.std()))\n    print(' '.join(row))\nprint('\\nASCII squares (16x16; darker-than-local-background pixels shown)')\nfor r in range(8):\n  for c in range(8):\n    a=im[r*S:(r+1)*S,c*S:(c+1)*S].mean(2)\n    # normalize each square; piece pixels tend to be outliers from smooth board color\n    small=np.array(Image.fromarray(a.astype('uint8')).resize((16,16)))\n    bg=np.median(small)\n    # print darkness relative to median, preserving board pattern\n    chars=' .:-=+*#%@'\n    x=np.clip((bg-small)/max(8,np.std(small))*1.8+2,0,9).astype(int)\n    print(f'[{chr(97+c)}{8-r}]')\n    for line in x: print(''.join(chars[v] for v in line))\nPY\n"]
