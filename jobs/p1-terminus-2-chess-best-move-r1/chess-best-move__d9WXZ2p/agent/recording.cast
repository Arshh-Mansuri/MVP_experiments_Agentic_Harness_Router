[70.028225, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); S=80\nfor r in range(8):\n for c in range(8):\n  vals=[]\n  for y in range(r*S,(r+1)*S):\n   for x in range(c*S,(c+1)*S):\n    q=im.getpixel((x,y)); v=sum(q)/3\n    if v<30 or v>245: vals.append((x-c*S,y-r*S,v))\n  if not vals: continue\n  # select dominant extreme: black or white\n  nb=sum(v<30 for x,y,v in vals); nw=len(vals)-nb; typ='B' if nb>=nw else 'W'; test=(lambda v:v<30) if typ=='B' else (lambda v:v>245)\n  pts=[(x,y) for x,y,v in vals if test(v)]\n  bx=(min(x for x,y in pts),max(x for x,y in pts),min(y for x,y in pts),max(y for x,y in pts))\n  mask=[]\n  for yy in range(10):\n   s=''\n   for xx in range(10):\n    hit=False\n    for y in range(yy*8,(yy+1)*8):\n     for x in range(xx*8,(xx+1)*8):\n      q=im.getpixel((c*S+x,r*S+y)); v=sum(q)/3\n      if test(v): hit=True\n    s += '#' if hit else '.'\n   mask.append(s)\n  print(chr(97+c)+str(8-r),typ,'n='+str(len(pts)),'box='+str(bx),' '.join(mask))\nPY\n"]
[70.033605, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[70.033689, "o", "\u001b[?2004h"]
[70.034322, "o", "> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.034458, "o", "im=Image.open('chess_board.png').convert('RGB'); S=80\r\n\u001b[?2004l\r"]
[70.034597, "o", "\u001b[?2004h> "]
[70.035185, "o", "for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>  for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>   vals=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.035739, "o", "  for y in range(r*S,(r+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>    for x in range(c*S,(c+1)*S):\r\n\u001b[?2004l\r\u001b[?2004h>     q=im.getpixel((x,y)); v=sum(q)/3\r\n\u001b[?2004l\r\u001b[?2004h>     if v<30 or v>245: vals.append((x-c*S,y-r*S,v))\r\n\u001b[?2004l\r\u001b[?2004h>   if not vals: continue\r\n\u001b[?2004l\r\u001b[?2004h>   # select dominant extreme: black or white\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.036099, "o", "  nb=sum(v<30 for x,y,v in vals); nw=len(vals)-nb; typ='B' if nb>=nw else 'W'; test=(lambda v:v<30) if typ=='B' else (lambda v:v>245)\r\n\u001b[?2004l\r\u001b[?2004h>   pts=[(x,y) for x,y,v in vals if test(v)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.037149, "o", "  bx=(min(x for x,y in pts),max(x for x,y in pts),min(y for x,y in pts),max(y for x,y in pts))\r\n\u001b[?2004l\r\u001b[?2004h>   mask=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for yy in range(10):\r\n\u001b[?2004l\r\u001b[?2004h>    s=''\r\n\u001b[?2004l\r"]
[70.037791, "o", "\u001b[?2004h>    for xx in range(10):\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.03844, "o", "> "]
[70.038675, "o", "    hit=False\r\n\u001b[?2004l\r"]
[70.042266, "o", "\u001b[?2004h>     for y in range(yy*8,(yy+1)*8):\r\n\u001b[?2004l\r\u001b[?2004h>      for x in range(xx*8,(xx+1)*8):\r\n\u001b[?2004l\r\u001b[?2004h>       q=im.getpixel((c*S+x,r*S+y)); v=sum(q)/3\r\n\u001b[?2004l\r\u001b[?2004h>       if test(v): hit=True\r\n\u001b[?2004l\r\u001b[?2004h>     s += '#' if hit else '.'\r\n\u001b[?2004l\r\u001b[?2004h>    mask.append(s)\r\n\u001b[?2004l\r\u001b[?2004h>   print(chr(97+c)+str(8-r),typ,'n='+str(len(pts)),'box='+str(bx),' '.join(mask))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
