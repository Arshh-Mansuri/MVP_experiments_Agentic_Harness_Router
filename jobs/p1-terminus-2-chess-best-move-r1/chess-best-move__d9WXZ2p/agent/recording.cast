[33.387188, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport math\nim=Image.open('chess_board.png').convert('RGB')\nS=80\nfor r in range(8):\n    out=[]\n    for c in range(8):\n        vals=[]\n        for y in range(r*S+8,(r+1)*S-8):\n            for x in range(c*S+8,(c+1)*S-8):\n                q=im.getpixel((x,y)); vals.append(sum(q)/3)\n        m=sum(vals)/len(vals); sd=math.sqrt(sum((v-m)**2 for v in vals)/len(vals))\n        out.append('%3d/%3d'%(m,sd))\n    print(' '.join(out))\nprint('\\nASCII: each square, dark pixels relative to square median')\nchars=' .:-=+*#%@'\nfor r in range(8):\n  for c in range(8):\n    vals=[]\n    for yy in range(16):\n      row=[]\n      for xx in range(16):\n        x=c*S+xx*5+2; y=r*S+yy*5+2\n        q=im.getpixel((x,y)); row.append(sum(q)/3)\n      vals.append(row)\n    flat=[v for row in vals for v in row]; med=sorted(flat)[len(flat)//2]\n    sd=math.sqrt(sum((v-med)**2 for v in flat)/len(flat)) or 1\n    print(f'[{chr(97+c)}{8-r}]')\n    for row in vals:\n      print(''.join(chars[max(0,min(9,int((med-v)/max(10,sd)*2+2)))] for v in row))\nPY\n"]
