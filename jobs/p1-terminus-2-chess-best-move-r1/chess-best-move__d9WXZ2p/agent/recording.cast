[55.632651, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB'); S=80\ncand=[]\nfor r in range(8):\n for c in range(8):\n  p=[im.getpixel((x,y)) for y in range(r*S,(r+1)*S) for x in range(c*S,(c+1)*S)]\n  if any(sum(q)/3<30 for q in p) or any(sum(q)/3>245 for q in p): cand.append((r,c))\nfor r,c in cand:\n name=chr(97+c)+str(8-r); print('\\n###',name)\n # sample 20x20 blocks, mark black and white extreme pixels\n for typ in ('black','white'):\n  print(typ)\n  for yy in range(20):\n   line=''\n   for xx in range(20):\n    hit=False\n    for dy in range(4):\n     for dx in range(4):\n      q=im.getpixel((c*S+xx*4+dx,r*S+yy*4+dy)); v=sum(q)/3\n      if (typ=='black' and v<30) or (typ=='white' and v>245): hit=True\n    line += '#' if hit else ' '\n   print(line.rstrip())\nPY\n"]
[55.634628, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
