[9.386262, "o", "import asyncio\r\n"]
[9.386386, "o", "from collections.abc import Awaitable, Callable\r\n\r\n\r\nasync def run_tasks(\r\n    tasks: list[Callable[[], Awaitable[None]]],\r\n    max_concurrent: int,\r\n) -> None:\r\n"]
[9.386512, "o", "    \"\"\"Run async jobs with at most ``max_concurrent`` jobs at once.\r\n\r\n    If this function is cancelled, all jobs that have started (and any queued\r\n    workers) are cancelled and awaited before cancellation is propagated. This\r\n    gives jobs an opportunity to run their ``finally`` cleanup blocks.\r\n    \"\"\"\r\n    if max_concurrent < 1:\r\n        raise ValueError(\"max_concurrent must be at least 1\")\r\n\r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n\r\n    async def worker(task_factory: Callable[[], Awaitable[None]]) -> None:\r\n        async with semaphore:\r\n            await task_factory()\r\n\r\n    workers = [asyncio.create_task(worker(task)) for task in tasks]\r\n    if not workers:\r\n        return\r\n\r\n    try:\r\n        await asyncio.gather(*workers)\r\n    except BaseException:\r\n        for worker_task in workers:\r\n            if not worker_task.done():\r\n                worker_task.cancel()\r\n        await asyncio.gather(*workers, return_exceptions=True)\r\n        raise\r\n"]
[9.387797, "o", "\u001b[?2004hroot@e12d9e3657f4:/app# "]
[16.15598, "i", "python3 - <<'PY'\nimport asyncio\nimport sys\nsys.path.insert(0, '/app')\nfrom run import run_tasks\n\nasync def main():\n    active = 0\n    peak = 0\n    cleaned = []\n\n    async def job(i):\n        nonlocal active, peak\n        active += 1\n        peak = max(peak, active)\n        try:\n            await asyncio.sleep(0.05)\n        finally:\n            active -= 1\n            cleaned.append(i)\n\n    await run_tasks([lambda i=i: job(i) for i in range(5)], 2)\n    assert peak == 2, peak\n    assert len(cleaned) == 5, cleaned\n\n    cleaned.clear()\n\n    async def long_job(i):\n        try:\n            await asyncio.sleep(10)\n        finally:\n            cleaned.append(i)\n\n    runner = asyncio.create_task(run_tasks([lambda i=i: long_job(i) for i in range(4)], 2))\n    await asyncio.sleep(0.05)\n    runner.cancel()\n    try:\n        await runner\n    except asyncio.CancelledError:\n        pass\n    assert sorted(cleaned) == [0, 1], cleaned\n\nasyncio.run(main())\nprint('behavior tests passed')\nPY"]
[16.156478, "o", "python3 - <<'PY'\r\n"]
