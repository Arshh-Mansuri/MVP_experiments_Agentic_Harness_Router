e * wh;\r\n\u001b[32m\u001b[K1436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K1437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh;\r\n\u001b[32m\u001b[K1439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1440\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* move pool to evacuated pools list, continue to next pool */\r\n\u001b[32m\u001b[K1441\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool *next = cur_pool->next;\r\n\u001b[32m\u001b[K1442\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool->next = evacuated_pools;\r\n\u001b[32m\u001b[K1443\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      evacuated_pools = cur_pool;\r\n\u001b[32m\u001b[K1444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = next;\r\n\u001b[32m\u001b[K1445\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_END(EV_COMPACT_EVACUATE);\r\n\u001b[32m\u001b[K1449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_global_barrier(participating_count);\r\n\u001b[32m\u001b[K1450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_BEGIN(EV_COMPACT_FORWARD);\r\n\u001b[32m\u001b[K1451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Second phase: at this point all live blocks in evacuated pools\r\n\u001b[32m\u001b[K1453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    have been moved and their old locations' first fields now point to\r\n\u001b[32m\u001b[K1454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    their new locations. We now go through all pools again (including\r\n\u001b[32m\u001b[K1455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    full ones this time) and for each field we check if the block the\r\n\u001b[32m\u001b[K1456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    field points to has the header status MARKED - if it does then the block\r\n\u001b[32m\u001b[K1457"]
[26.719155, "o", "\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    has been evacuated and we need to update the field to point to the new\r\n\u001b[32m\u001b[K1458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    location. We do this by using the forwarding pointer that is in the first\r\n\u001b[32m\u001b[K1459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    field of the evacuated block. */\r\n\u001b[32m\u001b[K1460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* First we do roots (locals and finalisers) */\r\n\u001b[32m\u001b[K1462\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_do_roots(&compact_update_value, 0, NULL, Caml_state, 1);\r\n\u001b[32m\u001b[K1463\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1464\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Memprof roots and \"weak\" pointers to tracked blocks */\r\n\u001b[32m\u001b[K1465\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_memprof_scan_roots(&compact_update_value, 0, NULL,\r\n\u001b[32m\u001b[K1466\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                          Caml_state, true);\r\n\u001b[32m\u001b[K1467\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1468\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Next, one domain does the global roots */\r\n\u001b[32m\u001b[K1469\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (participants[0] == Caml_state) {\r\n\u001b[32m\u001b[K1470\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_scan_global_roots(&compact_update_value, NULL);\r\n\u001b[32m\u001b[K1471\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1472\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1473\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Shared heap pools. */\r\n\u001b[32m\u001b[K1474\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int sz_class = 1; sz_class < NUM_SIZECLASSES; sz_class++) {\r\n\u001b[32m\u001b[K1475\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    compact_update_pools(heap->unswept_avail_pools[sz_class]);\r\n\u001b[32m\u001b[K1476\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    compact_update_pools(heap->unswept_full_pools[sz_class]);\r\n\u001b[32m\u001b[K1477\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1478\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1479\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Large allocations */\r\n\u001b[32m\u001b[K1480\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (large_alloc *la = heap->unswept_large; la != NULL; la = la->next) {\r\n\u001b[32m\u001b[K1481\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = (header_t*)((char*)la + LARGE_ALLOC_HEADER_SZ);\r\n\u001b[32m\u001b[K1482\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (Has_status_val(Val_hp(p), caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1483\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      compact_update_block(p);\r\n\u001b[32m\u001b[K1484\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1485\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1486\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1487\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Ephemerons */\r\n\u001b[32m\u001b[K1488\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_ephe_info* ephe_info = Caml_state->ephe_info;\r\n\u001b[32m\u001b[K1489\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  compact_update_ephe_list(&ephe_info->todo);\r\n\u001b[32m\u001b[K1490\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  compact_update_ephe_list(&ephe_info->live);\r\n\u001b[32m\u001b[K1491\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1492\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_END(EV_COMPACT_FORWARD);\r\n\u001b[32m\u001b[K1493\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_global_barrier(participating_count);\r\n\u001b[32m\u001b[K1494\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_BEGIN(EV_COMPACT_RELEASE);\r\n\u001b[32m\u001b[K1495\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1496\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Third phase: free all evacuated pools and release the mappings back to\r\n\u001b[32m\u001b[K1497\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      the OS.\r\n\u001b[32m\u001b[K1498\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1499\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      Note that we may have no \"available\" pools left, if all\r\n\u001b[32m\u001b[K1500\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      remaining pools have been filled up by evacuated blocks. */\r\n\u001b[32m\u001b[K1501\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1502\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* cur_pool = evacuated_pools;\r\n\u001b[32m\u001b[K1503\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (cur_pool) {\r\n\u001b[32m\u001b[K1504\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* next_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1505\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1506\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    #ifdef DEBUG\r\n\u001b[32m\u001b[K1507\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (header_t *p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\n\u001b[32m\u001b[K1508\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         p < POOL_END(cur_pool); p++) {\r\n\u001b[32m\u001b[K1509\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      *p = Debug_free_major;\r\n\u001b[32m\u001b[K1510\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1511\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    #endif\r\n\u001b[32m\u001b[K1512\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1513\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_free(heap, cur_pool, cur_pool->sz);\r\n\u001b[32m\u001b[K1514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = next_pool;\r\n\u001b[32m\u001b[K1515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1516\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1517\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_END(EV_COMPACT_RELEASE);\r\n\u001b[32m\u001b[K1518\u001b[m\u001b[K\u001b[36m\u001b[K-"]
[26.719691, "o", "\u001b[m\u001b[K  caml_global_barrier(participating_count);\r\n\u001b[32m\u001b[K1519\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1520\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Fourth phase: one domain also needs to release the free list */\r\n\u001b[32m\u001b[K1521\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( participants[0] == Caml_state ) {\r\n\u001b[32m\u001b[K1522\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* cur_pool;\r\n\u001b[32m\u001b[K1523\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* next_pool;\r\n\u001b[32m\u001b[K1524\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1525\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_plat_lock_blocking(&pool_freelist.lock);\r\n\u001b[32m\u001b[K1526\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = pool_freelist.free;\r\n\u001b[32m\u001b[K1527\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1528\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while( cur_pool ) {\r\n\u001b[32m\u001b[K1529\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      next_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1530\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* No stats to update so just unmap */\r\n\u001b[32m\u001b[K1531\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      caml_mem_unmap(cur_pool, Bsize_wsize(POOL_WSIZE));\r\n\u001b[32m\u001b[K1532\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = next_pool;\r\n\u001b[32m\u001b[K1533\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1534\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1535\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_freelist.free = NULL;\r\n\u001b[32m\u001b[K1536\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1537\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_plat_unlock(&pool_freelist.lock);\r\n\u001b[32m\u001b[K1538\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1539\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* We are done, increment our compaction count */\r\n\u001b[32m\u001b[K1540\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    atomic_fetch_add(&caml_compactions_count, 1);\r\n\u001b[32m\u001b[K1541\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1542\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1543\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Compacting heap complete\");\r\n\u001b[32m\u001b[K1544\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_END(EV_COMPACT);\r\n\u001b[32m\u001b[K1545\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1546\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1547\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Compaction end */\r\n\u001b[32m\u001b[K1548\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1549\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct mem_stats {\r\n\u001b[32m\u001b[K1550\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* unit is words */\r\n\u001b[32m\u001b[K1551\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat allocated;\r\n\u001b[32m\u001b[K1552\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat live;\r\n\u001b[32m\u001b[K1553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat free;\r\n\u001b[32m\u001b[K1554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat overhead;\r\n\u001b[32m\u001b[K1555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat live_blocks;\r\n\u001b[32m\u001b[K1557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K1558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_pool(pool* a, sizeclass sz, struct mem_stats* s) {\r\n\u001b[32m\u001b[K1560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  for (value *v = a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K; v; v = (value*)v[1]) {\r\n\u001b[32m\u001b[K1561\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(v));\r\n\u001b[32m\u001b[K1562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1563\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[32m\u001b[K1565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[32m\u001b[K1566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K1567\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K1568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->overhead += POOL_SLAB_WOFFSET(sz);\r\n\u001b[32m\u001b[K1569\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[32m\u001b[K1571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* This header can be read here and concurrently marked by the GC, but\r\n\u001b[32m\u001b[K1572\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         this is fine: marking can only turn UNMARKED objects into MARKED or\r\n\u001b[32m\u001b[K1573\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         NOT_MARKABLE, which is of no consequence for this verification\r\n\u001b[32m\u001b[K1574\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         (namely, that there is no garbage left). */\r\n\u001b[32m\u001b[K1575\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = Hd_hp(p);\r\n\u001b[32m\u001b[K1576\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1577\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd) ||\r\n\u001b[32m\u001b[K1578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          !Has_status_hd(hd, caml_global_heap_state.GARBAGE)\r\n\u001b[32m\u001b[K1579\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      );\r\n\u001b[32m\u001b[K1580\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K1581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live += Whsize_hd(hd);\r\n\u001b[32m\u001b[K1582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->overhead += wh - Whsize_hd(hd);\r\n\u001b[32m\u001b[K1583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s"]
[26.720155, "o", "->live_blocks++;\r\n\u001b[32m\u001b[K1584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* count the free block and any that follow it (stored in the\r\n\u001b[32m\u001b[K1586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           size bits in the header)*/\r\n\u001b[32m\u001b[K1587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->free += wh * (1 + Wosize_hd(hd));\r\n\u001b[32m\u001b[K1588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += Wosize_hd(hd) * wh;\r\n\u001b[32m\u001b[K1589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[32m\u001b[K1591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(end == p);\r\n\u001b[32m\u001b[K1593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->allocated += POOL_WSIZE;\r\n\u001b[32m\u001b[K1594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1596\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1597\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_large(large_alloc* a, struct mem_stats* s) {\r\n\u001b[32m\u001b[K1598\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (; a; a = a->next) {\r\n\u001b[32m\u001b[K1599\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = *(header_t*)((char*)a + LARGE_ALLOC_HEADER_SZ);\r\n\u001b[32m\u001b[K1600\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert (!Has_status_hd(hd, caml_global_heap_state.GARBAGE));\r\n\u001b[32m\u001b[K1601\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->allocated += Wsize_bsize(LARGE_ALLOC_HEADER_SZ) + Whsize_hd(hd);\r\n\u001b[32m\u001b[K1602\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->overhead += Wsize_bsize(LARGE_ALLOC_HEADER_SZ);\r\n\u001b[32m\u001b[K1603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->live_blocks++;\r\n\u001b[32m\u001b[K1604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1607\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_swept (struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K1608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct mem_stats pool_stats = {0,}, large_stats = {0,};\r\n\u001b[32m\u001b[K1609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* sweeping should be done by this point */\r\n\u001b[32m\u001b[K1611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->next_to_sweep == NUM_SIZECLASSES);\r\n\u001b[32m\u001b[K1612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int i = 0; i < NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K1613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_avail_pools[i] == NULL);\r\n\u001b[32m\u001b[K1614\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_full_pools[i] == NULL);\r\n\u001b[32m\u001b[K1615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (pool *p = local->avail_pools[i]; p; p = p->next)\r\n\u001b[32m\u001b[K1616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      verify_pool(p, i, &pool_stats);\r\n\u001b[32m\u001b[K1617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (pool *p = local->full_pools[i]; p; p = p->next) {\r\n\u001b[32m\u001b[K1618\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      CAMLassert(p->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K == NULL);\r\n\u001b[32m\u001b[K1619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      verify_pool(p, i, &pool_stats);\r\n\u001b[32m\u001b[K1620\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1621\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Pooled memory: %\" CAML_PRIuNAT \" allocated, \"\r\n\u001b[32m\u001b[K1623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              \"%\" CAML_PRIuNAT \" free, %\" CAML_PRIuNAT \" fragmentation\",\r\n\u001b[32m\u001b[K1624\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              pool_stats.allocated, pool_stats.free, pool_stats.overhead);\r\n\u001b[32m\u001b[K1625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1626\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  verify_large(local->swept_large, &large_stats);\r\n\u001b[32m\u001b[K1627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->unswept_large == NULL);\r\n\u001b[32m\u001b[K1628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Large memory: %\" CAML_PRIuNAT \" allocated, \"\r\n\u001b[32m\u001b[K1629\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              \"%\" CAML_PRIuNAT \" free, %\" CAML_PRIuNAT \" fragmentation\",\r\n\u001b[32m\u001b[K1630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              large_stats.allocated, large_stats.free, large_stats.overhead);\r\n\u001b[32m\u001b[K1631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Check stats are being computed correctly */\r\n\u001b[32m\u001b[K1633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.pool_words == pool_stats.allocated);\r\n\u001b[32m\u001b[K1634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.pool_live_words == pool_stats.live);\r\n\u001b[32m\u001b[K1635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.pool_live_blocks == pool_stats.live_blocks);\r\n\u001b[32m\u001b[K1636\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.pool_frag_words == pool_stats.overhead);\r\n\u001b[32m\u001b[K1637\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.pool_words -\r\n\u001b[32m\u001b[K1638\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         (local->stats.pool_li"]
[26.720884, "o", "ve_words + local->stats.pool_frag_words)\r\n\u001b[32m\u001b[K1639\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         == pool_stats.free);\r\n\u001b[32m\u001b[K1640\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.large_words == large_stats.allocated);\r\n\u001b[32m\u001b[K1641\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->stats.large_blocks == large_stats.live_blocks);\r\n\u001b[32m\u001b[K1642\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1643\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1644\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_cycle_heap_from_stw_single (void) {\r\n\u001b[32m\u001b[K1645\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct global_heap_state oldg = caml_global_heap_state;\r\n\u001b[32m\u001b[K1646\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct global_heap_state newg;\r\n\u001b[32m\u001b[K1647\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  newg.UNMARKED     = oldg.MARKED;\r\n\u001b[32m\u001b[K1648\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  newg.GARBAGE      = oldg.UNMARKED;\r\n\u001b[32m\u001b[K1649\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  newg.MARKED       = oldg.GARBAGE; /* should be empty because\r\n\u001b[32m\u001b[K1650\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                        garbage was swept */\r\n\u001b[32m\u001b[K1651\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_global_heap_state = newg;\r\n\u001b[32m\u001b[K1652\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1653\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1654\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_cycle_heap(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K1655\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Cycling heap [%02d]\", local->owner->id);\r\n\u001b[32m\u001b[K1656\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int i = 0; i < NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K1657\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_avail_pools[i] == NULL);\r\n\u001b[32m\u001b[K1658\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->unswept_avail_pools[i] = local->avail_pools[i];\r\n\u001b[32m\u001b[K1659\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->avail_pools[i] = NULL;\r\n\u001b[32m\u001b[K1660\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_full_pools[i] == NULL);\r\n\u001b[32m\u001b[K1661\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->unswept_full_pools[i] = local->full_pools[i];\r\n\u001b[32m\u001b[K1662\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->full_pools[i] = NULL;\r\n\u001b[32m\u001b[K1663\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1664\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(local->unswept_large == NULL);\r\n\u001b[32m\u001b[K1665\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->unswept_large = local->swept_large;\r\n\u001b[32m\u001b[K1666\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->swept_large = NULL;\r\n\u001b[32m\u001b[K1667\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1668\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_adopt_all_orphan_heaps(local);\r\n\u001b[32m\u001b[K1669\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1670\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1671\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_finalise_freelist(void) {\r\n\u001b[32m\u001b[K1672\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int freed_large = 0;\r\n\u001b[32m\u001b[K1673\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1674\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_freelist.lock);\r\n\u001b[32m\u001b[K1675\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (pool_freelist.global_large) {\r\n\u001b[32m\u001b[K1676\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large_alloc* a = pool_freelist.global_large;\r\n\u001b[32m\u001b[K1677\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_freelist.global_large = a->next;\r\n\u001b[32m\u001b[K1678\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    free(a);\r\n\u001b[32m\u001b[K1679\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    freed_large++;\r\n\u001b[32m\u001b[K1680\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1681\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_unlock(&pool_freelist.lock);\r\n\u001b[32m\u001b[K1682\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Finalise freelist. Freed %d large\", freed_large);\r\n\u001b[32m\u001b[K1683\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n--- configuration ---\r\n"]
