[26.714493, "o", "16),A(117),A(118),\r\n\u001b[32m\u001b[K901\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(119),A(120),A(121),A(122),A(123),A(124),A(125),A(126),A(127),\r\n\u001b[32m\u001b[K902\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(128),A(129),A(130),A(131),A(132),A(133),A(134),A(135),A(136),\r\n\u001b[32m\u001b[K903\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(137),A(138),A(139),A(140),A(141),A(142),A(143),A(144),A(145),\r\n\u001b[32m\u001b[K904\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(146),A(147),A(148),A(149),A(150),A(151),A(152),A(153),A(154),\r\n\u001b[32m\u001b[K905\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(155),A(156),A(157),A(158),A(159),A(160),A(161),A(162),A(163),\r\n\u001b[32m\u001b[K906\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(164),A(165),A(166),A(167),A(168),A(169),A(170),A(171),A(172),\r\n\u001b[32m\u001b[K907\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(173),A(174),A(175),A(176),A(177),A(178),A(179),A(180),A(181),\r\n\u001b[32m\u001b[K908\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(182),A(183),A(184),A(185),A(186),A(187),A(188),A(189),A(190),\r\n\u001b[32m\u001b[K909\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(191),A(192),A(193),A(194),A(195),A(196),A(197),A(198),A(199),\r\n\u001b[32m\u001b[K910\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(200),A(201),A(202),A(203),A(204),A(205),A(206),A(207),A(208),\r\n\u001b[32m\u001b[K911\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(209),A(210),A(211),A(212),A(213),A(214),A(215),A(216),A(217),\r\n\u001b[32m\u001b[K912\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(218),A(219),A(220),A(221),A(222),A(223),A(224),A(225),A(226),\r\n\u001b[32m\u001b[K913\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(227),A(228),A(229),A(230),A(231),A(232),A(233),A(234),A(235),\r\n\u001b[32m\u001b[K914\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KA(236),A(237),A(238),A(239),A(240),A(241),A(242),A(243),A(244),\r\n\u001b[32m\u00