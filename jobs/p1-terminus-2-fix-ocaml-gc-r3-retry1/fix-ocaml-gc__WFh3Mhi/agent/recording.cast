lise_heap(void) {\r\n\u001b[32m\u001b[K797\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state *local = Caml_state->shared_heap;\r\n\u001b[32m\u001b[K798\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  sizeclass sz;\r\n\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Finalise and release unswept local pools. */\r\n\u001b[32m\u001b[K801\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (sz = 0; sz < NUM_SIZECLASSES; sz++) {\r\n\u001b[32m\u001b[K802\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_finalise(local, &local->unswept_avail_pools[sz], sz);\r\n\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_finalise(local, &local->unswept_full_pools[sz], sz);\r\n\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K806\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Finalise and free large unswept objects. */\r\n\u001b[32m\u001b[K807\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (local->unswept_large)\r\n\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large_alloc_finalise(local);\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuintnat caml_heap_size(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K812\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return Bsize_wsize(local->stats.pool_words + local->stats.large_words);\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K814\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K815\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuintnat caml_top_heap_words(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K816\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* FIXME: summing two maximums computed at different points in time\r\n\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     returns an incorrect result. */\r\n\u001b[32m\u001b[K818\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return local->stats.pool_max_words + local->stats.large_max_words;\r\n\u001b[32m\u001b[K819\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K820\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K822\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuintnat caml_heap_blocks(struct caml_heap_state* local) {\r\n\u001b[32m\u001b[K823\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return local->stats.pool_live_blocks + local->stats.large_blocks;\r\n\u001b[32m\u001b[K824\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K825\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K826\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_redarken_pool(struct pool* r, scanning_action f, void* fdata) {\r\n\u001b[32m\u001b[K827\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  mlsize_t wh = wsize_sizeclass[r->sz];\r\n\u001b[32m\u001b[K828\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* p = POOL_FIRST_BLOCK(r, r->sz);\r\n\u001b[32m\u001b[K829\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(r);\r\n\u001b[32m\u001b[K830\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K831\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (p + wh <= end) {\r\n\u001b[32m\u001b[K832\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = p[0];\r\n\u001b[32m\u001b[K833\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (Has_status_hd(hd, caml_global_heap_state.MARKED)) {\r\n\u001b[32m\u001b[K834\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      f(fdata, Val_hp(p), 0);\r\n\u001b[32m\u001b[K835\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K836\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p += wh;\r\n\u001b[32m\u001b[K837\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K838\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K839\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K840\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K841\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Heap and freelist stats */\r\n\u001b[32m\u001b[K842\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K843\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Move the given heap stats to the orphan pools.\r\n\u001b[32m\u001b"]
[26.713937, "o", "[K844\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   You need to hold the [pool_freelist] lock. */\r\n\u001b[32m\u001b[K845\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void orphan_heap_stats_with_lock(struct caml_heap_state *heap) {\r\n\u001b[32m\u001b[K846\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_accum_heap_stats(&pool_freelist.stats, &heap->stats);\r\n\u001b[32m\u001b[K847\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  memset(&heap->stats, 0, sizeof(heap->stats));\r\n\u001b[32m\u001b[K848\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K849\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K850\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* The stats for an adopted pool are moved from the free pool stats to\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   the heap stats of the adopting domain.\r\n\u001b[32m\u001b[K852\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   You need to hold the [pool_freelist] lock. */\r\n\u001b[32m\u001b[K853\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_pool_stats_with_lock(\r\n\u001b[32m\u001b[K854\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* adopter, pool *r, sizeclass sz)\r\n\u001b[32m\u001b[K855\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K856\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct heap_stats pool_stats = { 0, };\r\n\u001b[32m\u001b[K857\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K858\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    calc_pool_stats(r, sz, &pool_stats);\r\n\u001b[32m\u001b[K859\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_accum_heap_stats(&adopter->stats, &pool_stats);\r\n\u001b[32m\u001b[K860\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_remove_heap_stats(&pool_freelist.stats, &pool_stats);\r\n\u001b[32m\u001b[K861\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K862\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Move the stats of all orphan pools into the given heap.\r\n\u001b[32m\u001b[K864\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   You need to hold the [pool_freelist] lock. */\r\n\u001b[32m\u001b[K865\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_all_pool_stats_with_lock(struct caml_heap_state *adopter) {\r\n\u001b[32m\u001b[K866\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_accum_heap_stats(&adopter->stats, &pool_freelist.stats);\r\n\u001b[32m\u001b[K867\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  memset(&pool_freelist.stats, 0, sizeof(pool_freelist.stats));\r\n\u001b[32m\u001b[K868\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K869\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K870\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_collect_heap_stats_sample(\r\n\u001b[32m\u001b[K871\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* local,\r\n\u001b[32m\u001b[K872\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_stats* sample)\r\n\u001b[32m\u001b[K873\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K874\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  *sample = local->stats;\r\n\u001b[32m\u001b[K875\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K876\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K877\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Add the orphan pool stats to a stats accumulator. */\r\n\u001b[32m\u001b[K878\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_accum_orphan_heap_stats(struct heap_stats* acc)\r\n\u001b[32m\u001b[K879\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K880\u001b[m\u0