[26.710756, "o", "d_hp (p) = Make_header_with_reserved(wosize, tag, colour, reserved);\r\n\u001b[32m\u001b[K527\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Annotating a release barrier on `p` because TSan does not see the\r\n\u001b[32m\u001b[K528\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   * happens-before relationship established by address dependencies\r\n\u001b[32m\u001b[K529\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   * between the initializing writes here and the read in major_gc.c\r\n\u001b[32m\u001b[K530\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   * marking (#12894) */\r\n\u001b[32m\u001b[K531\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_TSAN_ANNOTATE_HAPPENS_BEFORE(p);\r\n\u001b[32m\u001b[K532\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K533\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[32m\u001b[K534\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i < wosize; i++) {\r\n\u001b[32m\u001b[K535\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      Field(Val_hp(p), i) = Debug_free_major;\r\n\u001b[32m\u001b[K536\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K537\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K538\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K539\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return p;\r\n\u001b[32m\u001b[K540\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K541\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K542\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Sweeping of the major heap shared pools */\r\n\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic intnat pool_sweep(struct caml_heap_state* local, pool** plist,\r\n\u001b[32m\u001b[K544\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz, int release_to_global_pool) {\r\n\u001b[32m\u001b[K545\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  intnat work;\r\n\u001b[32m\u001b[K546\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* a = *plist;\r\n\u001b[32m\u001b[K547\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!a) return 0;\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  *plist = a->next;\r\n\u001b[32m\u001b[K549\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K550\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* last_free_block = NULL;\r\n\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    const mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int all_used = 1;\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct heap_stats* s = &local->stats;\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(a->owner == local->owner);\r\n\u001b[32m\u001b[K559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* note that the below will have to be changed for the new GC pacing\r\n\u001b[32m\u001b[K563\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      logic */\r\n\u001b[32m\u001b[K564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    work = end - p;\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    do {\r\n\u001b[32m\u001b[K566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K567\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if( (char*)p + caml_plat_pagesize < (char*)end ) {\r\n\u001b[32m\u001b[K569\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        caml_prefetch((char*)p + caml_plat_pagesize);\r\n\u001b[32m\u001b[K570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K572\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* The pools mark a block as being free by setting the tag to No_scan_tag\r\n\u001b[32m\u001b[K573\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        and the color to NOT_MARKABLE. The wosize is used to indicate the\r\n\u001b[32m\u001b[K574\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        number of contiguous free blocks that follow. The first field is a\r\n\u001b[32m\u001b[K575\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        pointer to the next free block beyond the immediately following\r\n\u001b[32m\u001b[K576\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        contiguous free blocks (if any). */\r\n\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* Check if the current block is garbage, if it is turn it into a free\r\n\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      block */\r\n\u001b[32m\u001b[K580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (Has_status_hd(hd, caml_global_heap_state.GARBAGE)) {\r\n\u001b[32m\u001b[K581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Whsize_hd(hd) <= wh);\r\n\u001b[32m\u001b[K582\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Tag_hd (hd) == Custom_tag) {\r\n\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;\r\n\u001b[32m\u001b[K584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (final_fun != NULL) final_fun(Val_hp(p));\r\n\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b["]
[26.711614, "o", "m\u001b[K        /* add to freelist. This could be optimised, we don't need\r\n\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        to write the free header if we're going to merge it with a prior\r\n\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        free block but it makes this codepath more complex. */\r\n\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        *p = POOL_FREE_HEADER(0);\r\n\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block((value)p));\r\n\u001b[32m\u001b[K593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (mlsize_t i = 1, wo = Wosize_whsize(wh); i < wo; i++) {\r\n\u001b[32m\u001b[K595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          Field(Val_hp(p), i) = Debug_free_major;\r\n\u001b[32m\u001b[K596\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K597\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K598\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K599\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[32m\u001b[K600\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* update stats */\r\n\u001b[32m\u001b[K601\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_blocks--;\r\n\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_words -= Whsize_hd(hd);\r\n\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner->swept_words += Whsize_hd(hd);\r\n\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u