.c:661:      (all_used && !a->next_obj)\r\nruntime/shared_heap.c:663:      || (!all_used && POOL_BLOCK_FREE_HP(a->next_obj))\r\nruntime/shared_heap.c:778:      if (!POOL_BLOCK_FREE_HD(hd)) {\r\nruntime/shared_heap.c:1284:        if (POOL_BLOCK_FREE_HD(h)) {\r\nruntime/shared_heap.c:1361:        if (!POOL_BLOCK_FREE_HD(hd)) {\r\nruntime/shared_heap.c:1371:            value* new_p = to_pool->next_obj;\r\nruntime/shared_heap.c:1385:              *next = POOL_FREE_HEADER(wosize - 1);\r\nruntime/shared_heap.c:1387:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1390:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1560:  for (value *v = a->next_obj; v; v = (value*)v[1]) {\r\nruntime/shared_heap.c:1577:        POOL_BLOCK_FREE_HD(hd) ||\r\nruntime/shared_heap.c:1580:      if (!POOL_BLOCK_FREE_HD(hd)) {\r\nruntime/shared_heap.c:1618:      CAMLassert(p->next_obj == NULL);\r\n"]
