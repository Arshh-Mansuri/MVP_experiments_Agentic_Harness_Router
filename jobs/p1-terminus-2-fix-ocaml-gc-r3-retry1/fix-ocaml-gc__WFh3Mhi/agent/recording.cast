[34.193904, "o", "--- macros ---\r\n"]
[34.23406, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(p, sz) ((header_t*)(p) + POOL_SLAB_WOFFSET(sz))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(p) ((header_t*)(p) + POOL_WSIZE)\r\n"]
[34.234177, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd) \\\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define POOL_BLOCK_FREE_HP(p) (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(Hd_hp(p)))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize) Make_header(wosize, No_scan_tag, NOT_MARKABLE)\r\n"]
[34.234219, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(r, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(r);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  p[0] = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(pool_blocks-1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic void* \u001b[01;31m\u001b[Kpool_allocate\u001b[m\u001b[K(struct caml_heap_state* local, sizeclass sz) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(p >= (value*)\u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(r, sz));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(p) - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p = \u001b[01;31m\u001b[Kpool_allocate\u001b[m\u001b[K(local, sz);\r\n"]
[34.234565, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        *p = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        hd = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_free_block = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(last_free_block)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K772\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K773\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K778\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K828\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(r, r->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K829\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(r);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(cur_pool, cur_pool->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(cur_pool);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1274\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(cur_pool, sz_class);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1275\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(cur_pool);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(h)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1354\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(cur_pool, sz_class);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(cur_pool);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(to_pool, sz_class) <= (header_t*)next\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              CAMLassert((header_t*)next <= \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(to_pool));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1507\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (header_t *p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(cur_pool, cur_pool->sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1508\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K         p < \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(cur_pool); p++) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1565\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* p = \u001b[01;31m\u001b[KPOOL_FIRST_BLOCK\u001b[m\u001b[K(a, sz);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1566\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    header_t* end = \u001b[01;31m\u001b[KPOOL_END\u001b[m\u001b[K(a);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1577\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd) ||\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1580\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n"]
[34.238014, "o", "--- build/config docs ---\r\n"]
[34.258626, "o", "(ocamltest and converting C compiler warnings to errors).\r\n\r\n2. Consult link:INSTALL.adoc[] for build instructions. Here is the gist of it:\r\n+\r\n----\r\n./configure\r\nmake -j 4\r\n----\r\nIf you are on a release build and need development options, you can add\r\n`--enable-ocamltest` (to allow running the testsuite) and `--enable-warn-error`\r\n(so you don't get caught by CI later!).\r\n\r\n3. Try the newly built compiler binaries `ocamlc`, `ocamlopt` or their\r\n`.opt` version. To try the toplevel, use:\r\n+\r\n"]
[34.298821, "o", "37-\r\n38-* If you do not have write access to `/tmp`, you should set the environment\r\n39-  variable `TMPDIR` to the name of some other temporary directory.\r\n40-\r\n41-* The zstd library is used for compression of marshaled data. The option\r\n42:  `--without-zstd` may be passed to `configure` in order to disable it.\r\n43-\r\n44-== Prerequisites (special cases)\r\n45-\r\n46-* Under Cygwin, the `gcc-core` package is required. `flexdll` is also necessary\r\n47-  for shared library support.\r\n48-\r\n49-* Binutils including `ar` and `strip` are required if your distribution\r\n50-  does not already provide them with the C compiler.\r\n51-\r\n52-== Configuration\r\n53-\r\n54-From the top directory, do:\r\n55-\r\n56:        ./configure\r\n57-\r\n58-This generates the three configuration files `Makefile.config`,\r\n59-`runtime/caml/m.h` and `runtime/caml/s.h`.\r\n60-\r\n61:The `configure` script accepts options that can be discovered by running:\r\n62-\r\n63:        ./configure --help\r\n64-\r\n65-Some options or variables like LDLIBS may not be taken into account\r\n66-by the OCaml build system at the moment. Please report an issue if you\r\n67-discover such a variable or option and this causes troubles to you.\r\n68-\r\n69-Examples:\r\n70-\r\n71-* Standard installation in `/usr/{bin,lib,man}` instead of `/usr/local`:\r\n72:    ./configure --prefix=/usr\r\n73-\r\n74-\r\n75-* On a Linux x86-64 host, to build a 32-bit version of OCaml:\r\n76-\r\n77:    ./configure --build=x86_64-pc-linux-gnu --host=i686-linux-gnu\r\n78-\r\n79-* For AIX 7.x with the IBM compiler `xlc`:\r\n80-\r\n81:    ./configure CC=xlc\r\n82-+\r\n83-By default, build is 32-bit. For 64-bit build, please set environment variable `OBJECT_MODE=64`\r\n84:  for _both_ `configure` and `make world` phases. Note, if this variable is set for only one phase,\r\n85-  your build will break (`ocamlrun` segfaults).\r\n86-+\r\n87-* For Solaris/Illumos on SPARC machines with Sun PRO compiler only 64-bit\r\n88-  bytecode target is supported (32-bit fails due to alignment issues; the optimization\r\n89-  is preset to `-O4` for inlining):\r\n90-\r\n91:    ./configure CC=\"cc -m64\"\r\n92-+\r\n93-If something goes wrong during the automatic configuration, or if the generated\r\n94-files cause errors later on, then look at the template files:\r\n95-\r\n96-        Makefile.config.in\r\n97-        Makefile.build_config.in\r\n98-        runtime/caml/m.h.in\r\n99-        runtime/caml/s.h.in\r\n100-+\r\n101-for guidance on how to edit the generated files by hand.\r\n102-\r\n103-== Building the compiler\r\n104-\r\n105-From the top directory, do:\r\n106-\r\n107-        make\r\n108-\r\n109-This builds the OCaml compiler for the first time.  This phase is\r\n110-fairly verbose; consider redirecting the output to a file:\r\n111-\r\n112-        make > make.log 2>&1     # in sh\r\n113-        make >& make.log         # in csh\r\n114-\r\n115-== (Optional) Running the testsuite\r\n116-\r\n"]
[34.300514, "o", "\u001b[?2004hroot@3d6ea14718e0:/app/ocaml# "]
[34.737616, "i", "printf '%s\\n' '--- tool versions ---'; cc --version | head -1; make --version | head -1; printf '%s\\n' '--- configure options ---'; ./configure --help | grep -E -i 'ocamltest|warn-error|with-debug|shared|flambda' | head -40\n"]
[34.738098, "o", "printf '%s\\n' '--- tool versions ---'; cc --version | head -1; make --version | head -1; printf '%s\\n' '--- configure options ---'; ./configure --help | grep -E -i 'ocamltest|warn-error|with-debug|shared|flambda' | head -40\r\n\u001b[?2004l\r"]
[34.738268, "o", "--- tool versions ---\r\n"]
[34.789675, "o", "cc (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0\r\n"]
[34.814527, "o", "GNU Make 4.3\r\n"]
[34.816424, "o", "--- configure options ---\r\n"]
[36.139918, "o", "  --sharedstatedir=DIR    modifiable architecture-independent data [PREFIX/com]\r\n  --disable-ocamltest     do not build ocamltest\r\n  --enable-flambda        enable flambda optimizations\r\n  --enable-flambda-invariants\r\n                          enable invariants checks in flambda\r\n  --enable-warn-error     treat C compiler warnings as errors\r\n  --enable-shared[=PKGS]  build shared libraries [default=yes]\r\n                          shared library versioning (aka \"SONAME\") variant to\r\n"]
[36.141482, "o", "\u001b[?2004hroot@3d6ea14718e0:/app/ocaml# "]
[41.588398, "i", "cd /app/ocaml; awk 'NR>=330 && NR<=570 {printf \"%5d %s\\n\", NR, $0}' runtime/shared_heap.c\n"]
[41.595376, "o", "cd /app/ocaml; awk 'NR>=330 && NR<=570 {printf \"%5d %s\\n\", NR, $0}' runtime/shared_heap.c\r\n\u001b[?2004l\r"]
[41.689149, "o", "  330 \r\n  331   CAMLassert((uintptr_t)end % Cache_line_bsize == 0);\r\n  332 }\r\n  333 \r\n  334 /* Allocating an object from a pool */\r\n  335 CAMLno_tsan_for_perf\r\n  336 static intnat pool_sweep(struct caml_heap_state* local,\r\n  337                          pool**,\r\n  338                          sizeclass sz,\r\n  339                          int release_to_global_pool);\r\n  340 static void pool_finalise(struct caml_heap_state* local, pool**, sizeclass sz);\r\n  341 \r\n  342 /* Adopt pool from the pool_freelist avail and full pools\r\n  343    to satisfy an allocation */\r\n  344 static pool* pool_global_adopt(struct caml_heap_state* local, sizeclass sz)\r\n  345 {\r\n"]
[41.690228, "o", "  346   pool* r = NULL;\r\n  347   int adopted_pool = 0;\r\n  348 \r\n  349   /* probably no available pools out there to be had */\r\n  350   if( !atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]) &&\r\n  351       !atomic_load_relaxed(&pool_freelist.global_full_pools[sz]) )\r\n  352     return NULL;\r\n  353 \r\n  354   /* Haven't managed to find a pool locally, try the global ones */\r\n  355   caml_plat_lock_blocking(&pool_freelist.lock);\r\n  356   if( atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]) ) {\r\n  357     r = atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]);\r\n  358 \r\n  359     if( r ) {\r\n  360       atomic_store_relaxed(&pool_freelist.global_avail_pools[sz], r->next);\r\n  361       r->next = 0;\r\n  362       r->owner = local->owner;\r\n  363       local->avail_pools[sz] = r;\r\n  364       adopt_pool_stats_with_lock(local, r, sz);\r\n  365 \r\n  366       #ifdef DEBUG\r\n  367       {\r\n  368         value* next_obj = r->next_obj;\r\n  369         while( next_obj ) {\r\n  370           CAMLassert(POOL_BLOCK_FREE_HP(next_obj));\r\n  371           next_obj = (value*)next_obj[1];\r\n  372         }\r\n  373       }\r\n  374       #endif\r\n  375 \r\n  376     }\r\n  377   }\r\n  378 \r\n  379   /* There were no global avail pools, so let's adopt one of the full ones and\r\n  380      try our luck sweeping it later on */\r\n  381   if( !r ) {\r\n  382     r = atomic_load_relaxed(&pool_freelist.global_full_pools[sz]);\r\n  383 \r\n  384     if( r ) {\r\n  385       atomic_store_relaxed(&pool_freelist.global_full_pools[sz], r->next);\r\n  386       r->next = local->full_pools[sz];\r\n  387       r->owner = local->owner;\r\n  388       local->full_pools[sz] = r;\r\n  389       adopt_pool_stats_with_lock(local, r, sz);\r\n  390 \r\n  391       adopted_pool = 1;\r\n  392       r = 0; // this pool is full\r\n  393     }\r\n  394   }\r\n  395 \r\n  396   caml_plat_unlock(&pool_freelist.lock);\r\n  397 \r\n  398   if( !r && adopted_pool ) {\r\n  399     Caml_state->major_work_done_between_slices +=\r\n  400       pool_sweep(local, &local->full_pools[sz], sz, 0);\r\n  401     r = local->avail_pools[sz];\r\n  402   }\r\n  403 \r\n  404   CAMLassert(r == NULL || r->owner == local->owner);\r\n  405   return r;\r\n  406 }\r\n  407 \r\n  408 /* Allocating an object from a pool */\r\n  409 static pool* pool_find(struct caml_heap_state* local, sizeclass sz) {\r\n  410   pool* r;\r\n  411 \r\n  412   /* Hopefully we have a pool we can use directly */\r\n  413   r = local->avail_pools[sz];\r\n  414   if (r) return r;\r\n  415 \r\n  416   /* Otherwise, try to sweep until we find one */\r\n  417   while (!local->avail_pools[sz] && local->unswept_avail_pools[sz]) {\r\n  418     Caml_state->major_work_done_between_slices +=\r\n  419       pool_sweep(local, &local->unswept_avail_pools[sz], sz, 0);\r\n  420   }\r\n  421 \r\n  422   r = local->avail_pools[sz];\r\n  423   if (r) return r;\r\n  424 \r\n  425   /* Haven't managed to find a pool locally, try the global ones */\r\n  426   r = pool_global_adopt(local, sz);\r\n  427   if (r) return r;\r\n  428 \r\n  429   /* Failing that, we need to allocate a new pool */\r\n  430   r = pool_acquire(local);\r\n  431   if (!r) return 0; /* if we can't allocate, give up */\r\n  432 \r\n  433   local->stats.pool_words += POOL_WSIZE;\r\n  434   if (local->stats.pool_words > local->stats.pool_max_words)\r\n  435     local->stats.pool_max_words = local->stats.pool_words;\r\n  436   local->stats.pool_frag_words += POOL_HEADER_WSIZE + wastage_sizeclass[sz];\r\n  437 \r\n  438   /* Having allocated a new pool, set it up for size sz */\r\n  439   local->avail_pools[sz] = r;\r\n  440   pool_initialize(r, sz, local->owner);\r\n  441 \r\n  442   return r;\r\n  443 }\r\n  444 \r\n  445 static void* pool_allocate(struct caml_heap_state* local, sizeclass sz) {\r\n  446   value* p;\r\n  447   value* next;\r\n  448   pool* r = pool_find(local, sz);\r\n  449 \r\n  450   if (!r) return 0;\r\n  451 \r\n  452   p = r->next_obj;\r\n  453   /* assert that p is inside the pool */\r\n  454   CAMLassert(p >= (value*)POOL_FIRST_BLOCK(r, sz));\r\n  455   CAMLassert(p < (value*)r + POOL_WSIZE);\r\n  456   CAMLassert(POOL_BLOCK_FREE_HP(p));\r\n  457 \r\n  458   /* in this case there are more free bloc"]
[41.691505, "o", "ks immediately after */\r\n  459   if( Wosize_hp(p) > 0 ) {\r\n  460     next = (value*)(p + wsize_sizeclass[sz]);\r\n  461     /* we update the pool header of the next block */\r\n  462     *next = POOL_FREE_HEADER(Wosize_hp(p) - 1);\r\n  463     /* also copy the next_obj pointer from p */\r\n  464     CAMLassert(p[1] == 0 || POOL_BLOCK_FREE_HP(p[1]));\r\n  465     next[1] = p[1];\r\n  466   } else {\r\n  467     next = (value*)p[1];\r\n  468   }\r\n  469 \r\n  470   r->next_obj = next;\r\n  471   if (!next) {\r\n  472     local->avail_pools[sz] = r->next;\r\n  473     r->next = local->full_pools[sz];\r\n  474     local->full_pools[sz] = r;\r\n  475   }\r\n  476 \r\n  477   CAMLassert(\r\n  478     /* either there's no more free space and we've moved the pool */\r\n  479     (r->next_obj == 0 && local->full_pools[sz] == r)\r\n  480     /* or there's still free space */\r\n  481     || POOL_BLOCK_FREE_HP(r->next_obj));\r\n  482 \r\n  483   return p;\r\n  484 }\r\n  485 \r\n  486 static void* large_allocate(struct caml_heap_state* local, mlsize_t sz) {\r\n  487   large_alloc* a = malloc(sz + LARGE_ALLOC_HEADER_SZ);\r\n  488   if (!a) return NULL;\r\n  489   local->stats.large_words += Wsize_bsize(sz + LARGE_ALLOC_HEADER_SZ);\r\n  490   if (local->stats.large_words > local->stats.large_max_words)\r\n  491     local->stats.large_max_words = local->stats.large_words;\r\n  492   local->stats.large_blocks++;\r\n  493   a->owner = local->owner;\r\n  494   a->next = local->swept_large;\r\n  495   local->swept_large = a;\r\n  496   return (char*)a + LARGE_ALLOC_HEADER_SZ;\r\n  497 }\r\n  498 \r\n  499 value* caml_shared_try_alloc(struct caml_heap_state* local, mlsize_t wosize,\r\n  500                              tag_t tag, reserved_t reserved)\r\n  501 {\r\n  502   mlsize_t whsize = Whsize_wosize(wosize);\r\n  503   value* p;\r\n  504   uintnat colour;\r\n  505 \r\n  506   CAMLassert (wosize > 0);\r\n  507   CAMLassert (tag != Infix_tag);\r\n  508 \r\n  509   CAML_EV_ALLOC(wosize);\r\n  510 \r\n  511   if (whsize <= SIZECLASS_MAX) {\r\n  512     struct heap_stats* s;\r\n  513     sizeclass sz = sizeclass_wsize[whsize];\r\n  514     CAMLassert(wsize_sizeclass[sz] >= whsize);\r\n  515     p = pool_allocate(local, sz);\r\n  516     if (!p) return 0;\r\n  517     s = &local->stats;\r\n  518     s->pool_live_blocks++;\r\n  519     s->pool_live_words += whsize;\r\n  520     s->pool_frag_words += wsize_sizeclass[sz] - whsize;\r\n  521   } else {\r\n  522     p = large_allocate(local, Bsize_wsize(whsize));\r\n  523     if (!p) return 0;\r\n  524   }\r\n  525   colour = caml_global_heap_state.MARKED;\r\n  526   Hd_hp (p) = Make_header_with_reserved(wosize, tag, colour, reserved);\r\n  527   /* Annotating a release barrier on `p` because TSan does not see the\r\n  528    * happens-before relationship established by address dependencies\r\n  529    * between the initializing writes here and the read in major_gc.c\r\n  530    * marking (#12894) */\r\n  531   CAML_TSAN_ANNOTATE_HAPPENS_BEFORE(p);\r\n  532 #ifdef DEBUG\r\n  533   {\r\n  534     for (int i = 0; i < wosize; i++) {\r\n  535       Field(Val_hp(p), i) = Debug_free_major;\r\n  536     }\r\n  537   }\r\n  538 #endif\r\n  539   return p;\r\n  540 }\r\n  541 \r\n  542 /* Sweeping of the major heap shared pools */\r\n  543 static intnat pool_sweep(struct caml_heap_state* local, pool** plist,\r\n  544                          sizeclass sz, int release_to_global_pool) {\r\n  545   intnat work;\r\n  546   pool* a = *plist;\r\n  547   if (!a) return 0;\r\n  548   *plist = a->next;\r\n  549 \r\n  550   {\r\n  551     header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n  552     header_t* last_free_block = NULL;\r\n  553     const header_t* end = POOL_END(a);\r\n  554     const mlsize_t wh = wsize_sizeclass[sz];\r\n  555     int all_used = 1;\r\n  556     struct heap_stats* s = &local->stats;\r\n  557 \r\n  558     CAMLassert(a->owner == local->owner);\r\n  559 \r\n  560     a->next_obj = 0;\r\n  561 \r\n  562     /* note that the below will have to be changed for the new GC pacing\r\n  563       logic */\r\n  564     work = end - p;\r\n  565     do {\r\n  566       header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n  567 \r\n  568       if( (char*)p + caml_plat_pagesize < (char*)end ) {\r\n  569    "]
