[34.193038, "i", "printf '%s\\n' '--- macros ---'; grep -RIn -E 'POOL_FREE_HEADER|POOL_BLOCK_FREE_HD|POOL_FIRST_BLOCK|POOL_END|pool_allocate' runtime --include='*.h' --include='*.c'; printf '%s\\n' '--- build/config docs ---'; sed -n '24,38p' HACKING.adoc; grep -n -A35 -B5 'configure' INSTALL.adoc | head -80\n"]
