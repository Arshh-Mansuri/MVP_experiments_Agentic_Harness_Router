[26.708675, "o", "\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* readable and writable only by the current thread */\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct caml_heap_state {\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* avail_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* full_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* unswept_avail_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* unswept_full_pools[NUM_SIZECLASSES];\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  large_alloc* swept_large;\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  large_alloc* unswept_large;\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  sizeclass next_to_sweep;\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_domain_state* owner;\r\n\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_stats stats;\r\n\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct compact_pool_stat {\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int free_blocks;\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int live_blocks;\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* You need to hold the [pool_freelist] lock to call these functions. */\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void orphan_heap_stats_with_lock(struct caml_heap_state *);\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_pool_stats_with_lock(struct caml_heap_state *,\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                       pool *, sizeclass);\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void adopt_all_pool_stats_with_lock(struct caml_heap_state *adopter);\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[26.708944, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct caml_heap_state* caml_init_shared_heap (void) {\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* heap;\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  heap = caml_stat_alloc_noexc(sizeof(struct caml_heap_state));\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if(heap != NULL) {\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = 0; i<NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      heap->avail_pools[i] = heap->full_pools[i] =\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        heap->unswept_avail_pools[i] = heap->unswept_full_pools[i] = 0;\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->next_to_sweep = 0;\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->swept_large = NULL;\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->unswept_large = NULL;\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->owner = Caml_state;\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    memset(&heap->stats, 0, sizeof(heap->stats));\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return heap;\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic int move_all_pools(pool** src, _Atomic(pool*)* dst,\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                          caml_domain_state* new_owner) {\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int count = 0;\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (*src) {\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* p = *src;\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *src = p->next;\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->owner = new_owner;\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p->next = *dst;\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *dst = p;\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    count++;\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return count;\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_orphan_shared_heap(struct caml_heap_state* heap) {\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int released = 0, released_large = 0;\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_freelist.lock);\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int i = 0; i < NUM_SIZECLASSES; i++) {\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released +=\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      move_all_pools(&heap->avail_pools[i],\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                     &pool_freelist.global_avail_pools[i], NULL);\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released +=\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      move_all_pools(&heap->full_pools[i],\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                     &pool_freelist.global_full_pools[i], NULL);\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* should be swept by now */\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(!heap->unswept_avail_pools[i]);\r\n\u001b[32m\u001b[K170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(!heap->unswept_full_pools[i]);\r\n\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(!heap->unswept_large);\r\n\u001b[32m\u001b[K173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (heap->swept_large) {\r\n\u001b[32m\u001b[K174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large_alloc* a = heap->swept_large;\r\n\u001b[32m\u001b[K175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    heap->swept_large = a->next;\r\n\u001b[32m\u001b[K176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    a->next = pool_freelist.global_large;\r\n\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool_freelist.global_large = a;\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    released_large++;\r\n\u001b[32m\u001b[K179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001