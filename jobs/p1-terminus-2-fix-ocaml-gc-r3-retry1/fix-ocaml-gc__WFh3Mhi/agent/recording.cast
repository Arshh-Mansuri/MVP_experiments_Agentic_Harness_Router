[26.709439, "o", "aml_plat_lock_blocking(&pool_freelist.lock);\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool->next = pool_freelist.free;\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool_freelist.free = pool;\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_unlock(&pool_freelist.lock);\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* free the memory of [pool], giving it back to the OS */\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void pool_free(struct caml_heap_state* local,\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool* pool,\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz)\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(pool->sz == sz);\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->stats.pool_words -= POOL_WSIZE;\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->stats.pool_frag_words -= POOL_HEADER_WSIZE + wastage_sizeclass[sz];\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_mem_unmap(pool, Bsize_wsize(POOL_WSIZE));\r\n\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void calc_pool_stats(pool* a, sizeclass sz, struct heap_stats* s)\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[32m\u001b[K290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  s->pool_frag_words += POOL_SLAB_WOFFSET(sz);\r\n\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (p + wh <= end) {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_words += Whsize_hd(hd);\r\n\u001b[32m\u001b[K298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_frag_words += wh - Whsize_hd(hd);\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      s->pool_live_blocks++;\r\n\u001b[32m\u001b[K300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[32m\u001b[K301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh * Wosize_hd(hd); /* skip contiguous free blocks */\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    p += wh;\r\n\u001b[32m\u001b[K305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(end == p);\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  s->pool_words += POOL_WSIZE;\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Initialize a pool and its object freelist */\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCaml_inline void pool_initialize(pool* r,\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                 sizeclass sz,\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                 caml_domain_state* owner)\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* p = POOL_FIRST_BLOCK(r, sz);\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(r);\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat pool_blocks = (end - p) / wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->next = 0;\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->owner = owner;\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = (value*)p;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->sz = sz;\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  p[0] = POOL_FREE_HEADER(pool_blocks-1);\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  p[1] = 0;\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (p += 2; p < end; p++) *p = Debug_free_major;\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert((uintptr_t)end % Cache_line_bsize == 0);\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Allocating an object from a pool */\r\n\u001b[32m\u001b[K335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCAMLno_tsan_for_perf\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic intnat pool_sweep(struct caml_heap"]
[26.70971, "o", "_state* local,\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         pool**,\r\n\u001b[32m\u001b[K338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         sizeclass sz,\r\n\u001b[32m\u001b[K339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         int release_to_global_pool);\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void pool_finalise(struct caml_heap_state* local, pool**, sizeclass sz);\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Adopt pool from the pool_freelist avail and full pools\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   to satisfy an allocation */\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic pool* pool_global_adopt(struct caml_heap_state* local, sizeclass sz)\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r = NULL;\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int adopted_pool = 0;\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* probably no available pools out there to be had */\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( !atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]) &&\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      !atomic_load_relaxed(&pool_freelist.global_full_pools[sz]) )\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return NULL;\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Haven't managed to find a pool locally, try the global ones */\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_lock_blocking(&pool_freelist.lock);\r\n\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]) ) {\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r = atomic_load_relaxed(&pool_freelist.global_avail_pools[sz]);\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( r ) {\r\n\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      atomic_store_relaxed(&pool_freelist.global_avail_pools[sz], r->next);\r\n\u001b[32m\u001b[K361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->next = 0;\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->owner = local->owner;\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      local->avail_pools[sz] = r;\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopt_pool_stats_with_lock(local, r, sz);\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      #ifdef DEBUG\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      {\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        value* \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        while( \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K ) {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K));\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = (value*)\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K[1];\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      #endif\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* There were no global avail pools, so let's adopt one of the full ones and\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     try our luck sweeping it later on */\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( !r ) {\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r = atomic_load_relaxed(&pool_freelist.global_full_pools[sz]);\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( r ) {\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      atomic_store_relaxed(&pool_freelist.global_full_pools[sz], r->next);\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->next = local->full_pools[sz];\r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r->owner = local->owner;\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      local->full_pools[sz] = r;\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopt_pool_stats_with_lock(local, r, sz);\r\n\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopted_pool = 1;\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      r = 0; // this pool is full\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_plat_unlock(&pool_freelist.lock);\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( !r && adopted_pool )"]
[26.710242, "o", " {\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Caml_state->major_work_done_between_slices +=\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_sweep(local, &local->full_pools[sz], sz, 0);\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r = local->avail_pools[sz];\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(r == NULL || r->owner == local->owner);\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return r;\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Allocating an object from a pool */\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic pool* pool_find(struct caml_heap_state* local, sizeclass sz) {\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r;\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Hopefully we have a pool we can use directly */\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r = local->avail_pools[sz];\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (r) return r;\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Otherwise, try to sweep until we find one */\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (!local->avail_pools[sz] && local->unswept_avail_pools[sz]) {\r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Caml_state->major_work_done_between_slices +=\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_sweep(local, &local->unswept_avail_pools[sz], sz, 0);\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r = local->avail_pools[sz];\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (r) return r;\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Haven't managed to find a pool locally, try the global ones */\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r = pool_global_adopt(local, sz);\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (r) return r;\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Failing that, we need to allocate a new pool */\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r = pool_acquire(local);\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!r) return 0; /* if we can't allocate, give up */\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->stats.pool_words += POOL_WSIZE;\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (local->stats.pool_words > local->stats.pool_max_words)\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->stats.pool_max_words = local->stats.pool_words;\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[