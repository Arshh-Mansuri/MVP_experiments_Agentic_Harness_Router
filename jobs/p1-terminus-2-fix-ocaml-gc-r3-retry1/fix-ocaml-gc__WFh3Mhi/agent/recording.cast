\u001b[36m\u001b[K-\u001b[m\u001b[K  value* stack;\r\n\u001b[32m\u001b[K936\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int stack_len;\r\n\u001b[32m\u001b[K937\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  int sp;\r\n\u001b[32m\u001b[K938\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  intnat objs;\r\n\u001b[32m\u001b[K939\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct addrmap seen;\r\n\u001b[32m\u001b[K940\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K941\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K942\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstruct heap_verify_state* caml_verify_begin (void)\r\n\u001b[32m\u001b[K943\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K944\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_verify_state init = {0, 0, 0, 0, ADDRMAP_INIT};\r\n\u001b[32m\u001b[K945\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_verify_state* st = caml_stat_alloc(sizeof init);\r\n\u001b[32m\u001b[K946\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  *st = init;\r\n\u001b[32m\u001b[K947\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return st;\r\n\u001b[32m\u001b[K948\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K949\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K950\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_push (void* st_v, value v, volatile value* ignored)\r\n\u001b[32m\u001b[K951\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K952\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct heap_verify_state* st = st_v;\r\n\u001b[32m\u001b[K953\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!Is_block(v)) return;\r\n\u001b[32m\u001b[K954\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K955\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (st->sp == st->stack_len) {\r\n\u001b[32m\u001b[K956\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    st->stack_len = st->stack_len * 2 + 100;\r\n\u001b[32m\u001b[K957\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    st->stack = caml_stat_resize(st->stack,\r\n\u001b[32m\u001b[K958\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         sizeof(value*) * st->stack_len);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1048\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* MARKED header status means the location `p` points to a block that\r\n\u001b[32m\u001b[K1049\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         has been evacuated. "]
[26.715287, "o", "Use the forwarding pointer in the first field\r\n\u001b[32m\u001b[K1050\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         to update to the new location. */\r\n\u001b[32m\u001b[K1051\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (Has_status_val(v, caml_global_heap_state.MARKED)) {\r\n\u001b[32m\u001b[K1052\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        value fwd = Field(v, 0) + infix_offset;\r\n\u001b[32m\u001b[K1053\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block(fwd));\r\n\u001b[32m\u001b[K1054\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Tag_val(fwd) == tag);\r\n\u001b[32m\u001b[K1055\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        *p = fwd;\r\n\u001b[32m\u001b[K1056\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1057\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1058\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1059\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1061\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Given a value found at `p` check if it points to an evacuated\r\n\u001b[32m\u001b[K1062\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   block, and if so update it using the forwarding pointer created by\r\n\u001b[32m\u001b[K1063\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   the compactor. */\r\n\u001b[32m\u001b[K1064\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic inline void compact_update_value_at(volatile value* p)\r\n\u001b[32m\u001b[K1065\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1066\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  compact_update_value(NULL, *p, p);\r\n\u001b[32m\u001b[K1067\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1068\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1069\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* For each pointer in the block pointed to by `p`, check if it points\r\n\u001b[32m\u001b[K1070\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   to an evacuated block and if so update it using the forwarding\r\n\u001b[32m\u001b[K1071\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K   pointer created by the compactor. */\r\n\u001b[32m\u001b[K1072\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void compact_update_block(header_t* p)\r\n\u001b[32m\u001b[K1073\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1074\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t hd = Hd_hp(p);\r\n\u001b[32m\u001b[K1075\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1076\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* We should never be called with a block that is free (this would indicate a\r\n\u001b[32m\u001b[K1077\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     bug in traversing the shared pools). */\r\n\u001b[32m\u001b[K1078\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p));\r\n\u001b[32m\u001b[K1079\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1080\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  tag_t tag = Tag_hd(hd);\r\n\u001b[32m\u001b[K1081\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1082\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* We should never encounter an Infix tag iterating over the shared pools or\r\n\u001b[32m\u001b[K1083\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large allocations. We could find it in roots but those use\r\n\u001b[32m\u001b[K1084\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    [compact_update_value]. */\r\n\u001b[32m\u001b[K1085\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(tag != Infix_tag);\r\n\u001b[32m\u001b[K1086\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1087\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (tag == Cont_tag) {\r\n\u001b[32m\u001b[K1088\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    value stk = Field(Val_hp(p), 0);\r\n\u001b[32m\u001b[K1089\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (Ptr_val(stk)) {\r\n\u001b[32m\u001b[K1090\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      caml_scan_stack(&compact_update_value, 0, NULL, Ptr_val(stk), 0);\r\n\u001b[32m\u001b[K1091\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1092\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  } else {\r\n\u001b[32m\u001b[K1093\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    uintnat offset = 0;\r\n\u001b[32m\u001b[K1094\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1095\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (tag == Closure_tag) {\r\n\u001b[32m\u001b[K1096\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      offset = Start_env_closinfo(Closinfo_val(Val_hp(p)));\r\n\u001b[32m\u001b[K1097\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1098\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1099\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (tag < No_scan_tag) {\r\n\u001b[32m\u001b[K1100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wosz = Wosize_hd(hd);\r\n\u001b[32m\u001b[K1101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      for (mlsize_t i = offset; i < wosz; i++) {\r\n\u001b[32m\u001b[K1102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        compact_update_value_at(&Field(Val_hp(p), i));\r\n\u001b[32m\u001b[K1103\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1104\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1105\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1106\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1107\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Update all the live blocks in a list of pools. */\r\n\u001b[32m\u001b[K1109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1110\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void compact_update_pools(pool *cur_pool)\r\n\u001b[32m\u001b[K1111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (cur_pool) {\r\n\u001b[32m\u001b[K1113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\n\u001b[32"]
[26.716276, "o", "m\u001b[K1114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(cur_pool);\r\n\u001b[32m\u001b[K1115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wh = wsize_sizeclass[cur_pool->sz];\r\n\u001b[32m\u001b[K1116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p)) {\r\n\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Has_status_val(Val_hp(p), caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          compact_update_block(p);\r\n\u001b[32m\u001b[K1121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K1122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* Skip over free blocks */\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * Wosize_hp(p);\r\n\u001b[32m\u001b[K1125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[32m\u001b[K1127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Update all the fields in the list of ephemerons found at `*ephe_p` */\r\n\u001b[32m\u001b[K1133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void compact_update_ephe_list(volatile value *ephe_p)\r\n\u001b[32m\u001b[K1135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Direct access to ephemeron fields instead of using Ephe_key/Ephe_data\r\n\u001b[32m\u001b[K1137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     is OK here, since the barrier at the start of compaction means no\r\n\u001b[32m\u001b[K1138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     domain can be doing minor GC at this time. */\r\n\u001b[32m\u001b[K1139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  while (*ephe_p) {\r\n\u001b[32m\u001b[K1140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    compact_update_value_at(ephe_p);\r\n\u001b[32m\u001b[K1141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    value ephe = *ephe_p;\r\n\u001b[32m\u001b[K1143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wosize = Wosize_val(ephe);\r\n\u001b[32m\u001b[K1144\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    compact_update_value_at(&Field(ephe, CAML_EPHE_DATA_OFFSET));\r\n\u001b[32m\u001b[K1145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (int i = CAML_EPHE_FIRST_KEY ; i < wosize ; i++) {\r\n\u001b[32m\u001b[K1147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      compact_update_value_at(&Field(ephe, i));\r\n\u001b[32m\u001b[K1148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ephe_p = &Field(ephe, CAML_EPHE_LINK_OFFSET);\r\n\u001b[32m\u001b[K1151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K1153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K/* Compact the heap for the given domain. Run in parallel for all domains. */\r\n\u001b[32m\u001b[K1155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kvoid caml_compact_heap(caml_domain_state* domain_state,\r\n\u001b[32m\u001b[K1157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         int participating_count,\r\n\u001b[32m\u001b[K1158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                         caml_domain_state** participants)\r\n\u001b[32m\u001b[K1159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Compacting heap start\");\r\n\u001b[32m\u001b[K1161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_BEGIN(EV_COMPACT);\r\n\u001b[32m\u001b[K1162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Warning: caml_compact_heap must only be called from\r\n\u001b[32m\u001b[K1163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     [stw_cycle_all_domains] in major_gc.c as there are\r\n\u001b[32m\u001b[K1164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     very specific conditions the compaction algorithm expects.\r\n\u001b[32m\u001b[K1165\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1166\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    The following code implements a compaction algorithm that is similar to\r\n\u001b[32m\u001b[K1167\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Edward's Two-Finger algorithm from the original 1974 LISP book (The\r\n\u001b[32m\u001b[K1168\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Programming Language LISP). At a high level the algorithm works as a series\r\n\u001b[32m\u001b[K1169\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    of parallel (using all running domains) phases separated by global barriers:\r\n\u001b[32m\u001b[K1170\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1171\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    1. For each size class\r\n\u001b[32m\u001b[K1172\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      a. Compute the number of live blocks in partially filled pools\r\n\u001b[32m\u001b[K1173\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      b. Keep enough pool"]
[26.716408, "o", "s to fully contain the number of live blocks and\r\n\u001b[32m\u001b[K1174\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         set the rest to be evacuated\r\n\u001b[32m\u001b[K1175\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      c. For each live block in each pool in the evacuation list,\r\n\u001b[32m\u001b[K1176\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         allocate and copy into a non-evacuating pool.\r\n\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    2. Proceed through the roots and the heap, updating pointers to evacuated\r\n\u001b[32m\u001b[K1178\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks to point to the new location of the block. Update finalisers and\r\n\u001b[32m\u001b[K1179\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       ephemerons too.\r\n\u001b[32m\u001b[K1180\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    3. Go through pools evacuated and release them. Finally free all but\r\n\u001b[32m\u001b[K1181\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        one pool in the freelist.\r\n\u001b[32m\u001b[K1182\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    4. One domain needs to release the pools in the freelist back to the OS.\r\n\u001b[32m\u001b[K1183\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1184\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    The algorithm requires one full pass through the whole heap (pools and large\r\n\u001b[32m\u001b[K1185\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    allocations) to rewrite pointers, as well as two passes through the\r\n\u001b[32m\u001b[K1186\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    partially-occupied pools in the heap to compute the number of live blocks\r\n\u001b[32m\u001b[K1187\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    and evacuate them.\r\n\u001b[32m\u001b[K1188\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  */\r\n\u001b[32m\u001b[K1189\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1190\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* First phase. Here we compute the number of live blocks in partially\r\n\u001b[32m\u001b[K1191\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  filled pools, determine pools to be evacuated and then evacuate from them.\r\n\u001b[32m\u001b[K1192\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  For the first phase we need not consider full pools, they\r\n\u001b[32m\u001b[K1193\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  cannot be evacuated to or from. */\r\n\u001b[32m\u001b[K1194\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_global_barrier(participating_count);\r\n\u001b[32m\u001b[K1195\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAML_EV_BEGIN(EV_COMPACT_EVACUATE);\r\n\u001b[32m\u001b[K1196\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1197\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  struct caml_heap_state* heap = Caml_state->shared_heap;\r\n\u001b[32m\u001b[K1198\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1199\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  #ifdef DEBUG\r\n\u001b[32m\u001b[K1200\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* Check preconditions for the heap: */\r\n\u001b[32m\u001b[K1201\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int sz_class = 1; sz_class < NUM_SIZECLASSES; sz_class++) {\r\n\u001b[32m\u001b[K1202\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* No sweeping has happened yet */\r\n\u001b[32m\u001b[K1203\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->avail_pools[sz_class] == NULL);\r\n\u001b[32m\u001b[K1204\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->full_pools[sz_class] == NULL);\r\n\u001b[32m\u001b[K1205\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(heap->swept_large == NULL);\r\n\u001b[32m\u001b[K1206\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* No pools waiting for adoption */\r\n\u001b[32m\u001b[K1207\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (participants[0] == Caml_state) {\r\n\u001b[32m\u001b[K1208\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          atomic_load_relaxed(&pool_freelist.global_avail_pools[sz_class]) ==\r\n\u001b[32m\u001b[K1210\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            NULL);\r\n\u001b[32m\u001b[K1211\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1212\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          atomic_load_relaxed(&pool_freelist.global_full_pools[sz_class]) ==\r\n\u001b[32m\u001b[K1213\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            NULL);\r\n\u001b[32m\u001b[K1214\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1215\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* The minor heap is empty */\r\n\u001b[32m\u001b[K1216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(Caml_state->young_ptr == Caml_state->young_end);\r\n\u001b[32m\u001b[K1217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* The mark stack is empty */\r\n\u001b[32m\u001b[K1218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(caml_mark_stack_is_empty());\r\n\u001b[32m\u001b[K1219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  #endif\r\n\u001b[32m\u001b[K1221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* All evacuated pools (of every size class) */\r\n\u001b[32m\u001b[K1223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool *evacuated_pools = NULL;\r\n\u001b[32m\u001b[K1224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (int sz_class = 1; sz_class < NUM_SIZECLASSES; sz_class++) {\r\n\u001b[32m\u001b[K1226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* We only care about moving things in pools that aren't full (we cannot\r\n\u001b[32m\u001b[K1227\u001b[m\u001b[K\u001b[36m\u001b[K"]
[26.716992, "o", "-\u001b[m\u001b[K    evacuate to or from a full pool) */\r\n\u001b[32m\u001b[K1228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool* cur_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1229\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!cur_pool) {\r\n\u001b[32m\u001b[K1231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* No partially filled pools for this size, nothing to do */\r\n\u001b[32m\u001b[K1232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      continue;\r\n\u001b[32m\u001b[K1233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* count the number of pools */\r\n\u001b[32m\u001b[K1236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int num_pools = 0;\r\n\u001b[32m\u001b[K1237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      num_pools++;\r\n\u001b[32m\u001b[K1240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct compact_pool_stat* pool_stats = caml_stat_alloc_noexc(\r\n\u001b[32m\u001b[K1244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      sizeof(struct compact_pool_stat) * num_pools);\r\n\u001b[32m\u001b[K1245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* if we're unable to allocate pool_stats here then we should avoid\r\n\u001b[32m\u001b[K1247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      evacuating this size class. It's unlikely but it may be that we had\r\n\u001b[32m\u001b[K1248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      better success with an earlier size class and that results in some\r\n\u001b[32m\u001b[K1249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      memory being freed up. */\r\n\u001b[32m\u001b[K1250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( pool_stats == NULL ) {\r\n\u001b[32m\u001b[K1251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      caml_gc_log(\"Unable to allocate pool_stats for size class %d\", sz_class);\r\n\u001b[32m\u001b[K1252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      continue;\r\n\u001b[32m\u001b[K1254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Count the number of free and live blocks in each pool. Note that a live\r\n\u001b[32m\u001b[K1259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       block here currently has the header status UNMARKED (because it was\r\n\u001b[32m\u001b[K1260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       MARKED in the previous cycle). After compaction the shared pools will\r\n\u001b[32m\u001b[K1261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       contain UNMARKED and GARBAGE from the \"to\" pools and UNMARKED from the\r\n\u001b[32m\u001b[K1262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       \"from\" pools which were evacuated.\r\n\u001b[32m\u001b[K1263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       At the cost of some complexity or an additional pass we could compute the\r\n\u001b[32m\u001b[K1265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       exact amount of space needed or even sweep all pools in this counting\r\n\u001b[32m\u001b[K1266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       pass.\r\n\u001b[32m\u001b[K1267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    */\r\n\u001b[32m\u001b[K1268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int k = 0;\r\n\u001b[32m\u001b[K1269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int total_live_blocks = 0;\r\n\u001b[32m\u001b[K1270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int total_free_blocks = 0;\r\n\u001b[32m\u001b[K1272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\n\u001b[32m\u001b[K1275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* end = POOL_END(cur_pool);\r\n\u001b[32m\u001b[K1276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[32m\u001b[K1277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].free_blocks = 0;\r\n\u001b[32m\u001b[K1279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].live_blocks = 0;\r\n\u001b[32m\u001b[K1280\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[32m\u001b[K1282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t h = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(h)) {\r\n\u001b[32m\u001b[K1285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* this tells us the number of spaces of size wh after this */\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          mlsize_t wosize = Wosize_hd(h);\r\n\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b["]
[26.717474, "o", "K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          pool_stats[k].free_blocks += wosize + 1;\r\n\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          total_free_blocks += wosize + 1;\r\n\u001b[32m\u001b[K1291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* skip to the next block */\r\n\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          p += wh * wosize;\r\n\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else if (Has_status_hd(h, caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1295\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          total_live_blocks++;\r\n\u001b[32m\u001b[K1296\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          pool_stats[k].live_blocks++;\r\n\u001b[32m\u001b[K1297\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K1298\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh;\r\n\u001b[32m\u001b[K1299\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1300\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1301\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1302\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      k++;\r\n\u001b[32m\u001b[K1303\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1304\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1305\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Note that partially filled pools must have at least some free space*/\r\n\u001b[32m\u001b[K1306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(total_free_blocks > 0);\r\n\u001b[32m\u001b[K1308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1310\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (!total_live_blocks) {\r\n\u001b[32m\u001b[K1311\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* No live (i.e unmarked) blocks in partially filled pools, nothing to do\r\n\u001b[32m\u001b[K1312\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         for this size class */\r\n\u001b[32m\u001b[K1313\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      continue;\r\n\u001b[32m\u001b[K1314\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1315\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Now we use the pool stats to calculate which pools will be evacuated. We\r\n\u001b[32m\u001b[K1317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       want to walk through the pools and check whether we have enough free\r\n\u001b[32m\u001b[K1318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks in the pools behind us to accommodate all the remaining live\r\n\u001b[32m\u001b[K1319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       blocks. */\r\n\u001b[32m\u001b[K1320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int free_blocks = 0;\r\n\u001b[32m\u001b[K1321\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int j = 0;\r\n\u001b[32m\u001b[K1322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int remaining_live_blocks = total_live_blocks;\r\n\u001b[32m\u001b[K1323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1324\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    cur_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* [last_pool_p] will be a pointer to the next field of the last\r\n\u001b[32m\u001b[K1326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       non-evacuating pool. We need this so we can snip the list of evacuating\r\n\u001b[32m\u001b[K1327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       pools from [unswept_avail_pools] and eventually attach them all to\r\n\u001b[32m\u001b[K1328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       [evacuated_pools]. */\r\n\u001b[32m\u001b[K1329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pool **last_pool_p = &heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if (free_blocks >= remaining_live_blocks) {\r\n\u001b[32m\u001b[K1332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        break;\r\n\u001b[32m\u001b[K1333\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1334\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1335\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      free_blocks += pool_stats[j].free_blocks;\r\n\u001b[32m\u001b[K1336\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      remaining_live_blocks -= pool_stats[j].live_blocks;\r\n\u001b[32m\u001b[K1337\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      last_pool_p = &cur_pool->next;\r\n\u001b[32m\u001b[K1338\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      cur_pool = cur_pool->next;\r\n\u001b[32m\u001b[K1339\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      j++;\r\n\u001b[32m\u001b[K1340\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1341\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1342\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* We're done with the pool stats. */\r\n\u001b[32m\u001b[K1343\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    caml_stat_free(pool_stats);\r\n\u001b[32m\u001b[K1344\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1345\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* `cur_pool` now points to the first pool we are evacuating, or NULL if\r\n\u001b[32m\u001b[K1346\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        we could not compact this particular size class (for this domain) */\r\n\u001b[32m\u001b[K1347\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1348\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Snip the evacuating pools from list of pools we are retaining */\r"]
[26.717982, "o", "\n\u001b[32m\u001b[K1349\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    *last_pool_p = NULL;\r\n\u001b[32m\u001b[K1350\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1351\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* Evacuate marked blocks from the evacuating pools into the\r\n\u001b[32m\u001b[K1352\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       avail pools. */\r\n\u001b[32m\u001b[K1353\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (cur_pool) {\r\n\u001b[32m\u001b[K1354\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\n\u001b[32m\u001b[K1355\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t* end = POOL_END(cur_pool);\r\n\u001b[32m\u001b[K1356\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[32m\u001b[K1357\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K1360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K1362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, caml_global_heap_state.MARKED));\r\n\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, NOT_MARKABLE));\r\n\u001b[32m\u001b[K1364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* Reminder: since colours have rotated, UNMARKED indicates a MARKED\r\n\u001b[32m\u001b[K1366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          (i.e live) block */\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (Has_status_hd(hd, caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* live block in an evacuating pool, so we evacuate it to\r\n\u001b[32m\u001b[K1369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K             * the first available block */\r\n\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            pool* to_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            value* new_p = to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(new_p));\r\n\u001b[32m\u001b[K1373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if there are free blocks after this, use those */\r\n\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\n\u001b[32m\u001b[K1381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              );\r\n\u001b[32m\u001b[K1382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert((header_t*)next <= POOL_END(to_pool));\r\n\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              *next = POOL_FREE_HEADER(wosize - 1);\r\n\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              next[1] = new_p[1];\r\n\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = next;\r\n\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value *next = (value*)new_p[1];\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = next;\r\n\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (!next) {\r\n\u001b[32m\u001b[K1393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                /* This pool is full. Move it to unswept_full_pools */\r\n\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_avail_pools[sz_class] = to_pool->next;\r\n\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                to_pool->next = heap->unswept_full_pools[sz_class];\r\n\u001b[32m\u001b[K1396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_full_pools[sz_class] = to_pool;\r\n\u001b[32m\u001b[K1397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              }\r\n\u001b[32m\u001b[K1398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K1399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* Copy the block to the new location */\r\n\u001b[32m\u001b[K1401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            memcpy(new_p, p, Whsize_hd(hd) * sizeof(value));\r\n\u001b[32m\u001b[K1402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* Se"]
[26.718429, "o", "t first field of p to a forwarding pointer */\r\n\u001b[32m\u001b[K1404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            Field(Val_hp(p), 0) = Val_hp(new_p);\r\n\u001b[32m\u001b[K1405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* Since there can be no blocks with the MARKED status, we use this\r\n\u001b[32m\u001b[K1407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              to indicate that a block has been evacuated and any pointers to\r\n\u001b[32m\u001b[K1408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              it should be updated. */\r\n\u001b[32m\u001b[K1409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            *p = With_status_hd(hd, caml_global_heap_state.MARKED);\r\n\u001b[32m\u001b[K1410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          } else if (Has_status_hd(hd, caml_global_heap_state.GARBAGE)) {\r\n\u001b[32m\u001b[K1411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* We are implicitly sweeping pools in the evacuation set and thus\r\n\u001b[32m\u001b[K1412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K               we must remember to call finalisers for Custom blocks that would\r\n\u001b[32m\u001b[K1413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K               have been swept in a subsequent major cycle. */\r\n\u001b[32m\u001b[K1414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if (Tag_hd (hd) == Custom_tag) {\r\n\u001b[32m\u001b[K1415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;\r\n\u001b[32m\u001b[K1416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (final_fun) final_fun(Val_hp(p));\r\n\u001b[32m\u001b[K1417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[32m\u001b[K1418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001