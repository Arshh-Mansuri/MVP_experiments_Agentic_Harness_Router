[32m[K1197[m[K[36m[K-[m[K  struct caml_heap_state* heap = Caml_state->shared_heap;
[32m[K1198[m[K[36m[K-[m[K
[32m[K1199[m[K[36m[K-[m[K  #ifdef DEBUG
[32m[K1200[m[K[36m[K-[m[K  /* Check preconditions for the heap: */
