[32m[K1161[m[K[36m[K-[m[K  CAML_EV_BEGIN(EV_COMPACT);
[32m[K1162[m[K[36m[K-[m[K  /* Warning: caml_compact_heap must only be called from
[32m[K1163[m[K[36m[K-[m[K     [stw_cycle_all_domains] in major_gc.c as there are
