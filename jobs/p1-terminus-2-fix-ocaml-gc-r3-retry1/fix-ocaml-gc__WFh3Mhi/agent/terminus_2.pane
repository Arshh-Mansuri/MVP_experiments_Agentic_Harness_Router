[32m[K1220[m[K[36m[K-[m[K  #endif
[32m[K1221[m[K[36m[K-[m[K
[32m[K1222[m[K[36m[K-[m[K  /* All evacuated pools (of every size class) */
[32m[K1223[m[K[36m[K-[m[K  pool *evacuated_pools = NULL;
[32m[K1224[m[K[36m[K-[m[K
[32m[K1225[m[K[36m[K-[m[K  for (int sz_class = 1; sz_class < NUM_SIZECLASSES; sz_class++) {
