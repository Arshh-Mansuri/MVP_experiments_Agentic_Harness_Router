[32m[K1303[m[K[36m[K-[m[K    }
[32m[K1304[m[K[36m[K-[m[K
[32m[K1305[m[K[36m[K-[m[K    /* Note that partially filled pools must have at least some free space*/
[32m[K1306[m[K[36m[K-[m[K#ifdef DEBUG
[32m[K1307[m[K[36m[K-[m[K    CAMLassert(total_free_blocks > 0);
[32m[K1308[m[K[36m[K-[m[K#endif
[32m[K1309[m[K[36m[K-[m[K
[32m[K1310[m[K[36m[K-[m[K    if (!total_live_blocks) {
[32m[K1311[m[K[36m[K-[m[K      /* No live (i.e unmarked) blocks in partially filled pools, nothing to do
