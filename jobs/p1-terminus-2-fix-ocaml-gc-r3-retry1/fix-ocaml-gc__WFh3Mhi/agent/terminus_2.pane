[32m[K1266[m[K[36m[K-[m[K       pass.
[32m[K1267[m[K[36m[K-[m[K    */
[32m[K1268[m[K[36m[K-[m[K    int k = 0;
[32m[K1269[m[K[36m[K-[m[K    int total_live_blocks = 0;
