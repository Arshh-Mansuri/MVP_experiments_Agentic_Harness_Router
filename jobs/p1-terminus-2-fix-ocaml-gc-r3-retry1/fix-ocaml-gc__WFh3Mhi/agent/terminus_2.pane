[32m[K1102[m[K[36m[K-[m[K        compact_update_value_at(&Field(Val_hp(p), i));
[32m[K1103[m[K[36m[K-[m[K      }
[32m[K1104[m[K[36m[K-[m[K    }
[32m[K1105[m[K[36m[K-[m[K  }
[32m[K1106[m[K[36m[K-[m[K}
[32m[K1107[m[K[36m[K-[m[K
[32m[K1108[m[K[36m[K-[m[K/* Update all the live blocks in a list of pools. */
[32m[K1109[m[K[36m[K-[m[K
[32m[K1110[m[K[36m[K-[m[Kstatic void compact_update_pools(pool *cur_pool)
[32m[K1111[m[K[36m[K-[m[K{
