[32m[K1246[m[K[36m[K-[m[K    /* if we're unable to allocate pool_stats here then we should avoid
[32m[K1247[m[K[36m[K-[m[K      evacuating this size class. It's unlikely but it may be that we had
[32m[K1248[m[K[36m[K-[m[K      better success with an earlier size class and that results in some
[32m[K1249[m[K[36m[K-[m[K      memory being freed up. */
[32m[K1250[m[K[36m[K-[m[K    if( pool_stats == NULL ) {
[32m[K1251[m[K[36m[K-[m[K      caml_gc_log("Unable to allocate pool_stats for size class %d", sz_class);
[32m[K1252[m[K[36m[K-[m[K
[32m[K1253[m[K[36m[K-[m[K      continue;
[32m[K1254[m[K[36m[K-[m[K    }
[32m[K1255[m[K[36m[K-[m[K
[32m[K1256[m[K[36m[K-[m[K    cur_pool = heap->unswept_avail_pools[sz_class];
[32m[K1257[m[K[36m[K-[m[K
[32m[K1258[m[K[36m[K-[m[K    /* Count the number of free and live blocks in each pool. Note that a live
[32m[K1259[m[K[36m[K-[m[K       block here currently has the header status UNMARKED (because it was
