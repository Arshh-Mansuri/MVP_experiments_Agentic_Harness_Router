[32m[K1204[m[K[36m[K-[m[K    CAMLassert(heap->full_pools[sz_class] == NULL);
[32m[K1205[m[K[36m[K-[m[K    CAMLassert(heap->swept_large == NULL);
[32m[K1206[m[K[36m[K-[m[K    /* No pools waiting for adoption */
[32m[K1207[m[K[36m[K-[m[K    if (participants[0] == Caml_state) {
[32m[K1208[m[K[36m[K-[m[K      CAMLassert(
[32m[K1209[m[K[36m[K-[m[K          atomic_load_relaxed(&pool_freelist.global_avail_pools[sz_class]) ==
[32m[K1210[m[K[36m[K-[m[K            NULL);
[32m[K1211[m[K[36m[K-[m[K      CAMLassert(
[32m[K1212[m[K[36m[K-[m[K          atomic_load_relaxed(&pool_freelist.global_full_pools[sz_class]) ==
[32m[K1213[m[K[36m[K-[m[K            NULL);
[32m[K1214[m[K[36m[K-[m[K    }
[32m[K1215[m[K[36m[K-[m[K    /* The minor heap is empty */
[32m[K1216[m[K[36m[K-[m[K    CAMLassert(Caml_state->young_ptr == Caml_state->young_end);
[32m[K1217[m[K[36m[K-[m[K    /* The mark stack is empty */
