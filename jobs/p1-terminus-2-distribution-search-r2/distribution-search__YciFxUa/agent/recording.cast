[40.064096, "o", "\u001b[?2004hroot@d4fd1e3a0f40:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[40.064156, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.064432, "o", "> "]
[40.064454, "o", "p = np.load('/app/dist.npy')\r\n\u001b[?2004l\r\u001b[?2004h> N = len(p)\r\n\u001b[?2004l\r\u001b[?2004h> u = 1.0 / N\r\n\u001b[?2004l\r\u001b[?2004h> print('loaded:', p.shape, p.dtype)\r\n\u001b[?2004l\r\u001b[?2004h> print('sum:', repr(p.sum()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.064546, "o", "print('forward:', repr(np.sum(p*np.log(p/u))))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.064562, "o", "print('backward:', repr(np.sum(u*np.log(u/p))))\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.064739, "o", "> PY\r\n\u001b[?2004l\r"]
[40.780606, "o", "loaded: (150000,) float64\r\n"]
[40.78145, "o", "sum: np.float64(0.9999999999999999)\r\n"]
[40.787004, "o", "forward: np.float64(10.00000000000002)\r\n"]
[40.790421, "o", "backward: np.float64(10.0)\r\n"]
