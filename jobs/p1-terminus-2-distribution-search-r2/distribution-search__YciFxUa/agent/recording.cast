[38.632912, "i", "cat > /app/solve.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import root\n\nN = 150000\nL = 75000\nM = N - L - 1\nTARGET = 10.0\n\ndef calc(x):\n    a, t = float(x[0]), float(x[1])\n    low_r = np.exp(t)\n    low_p = low_r / N\n    low_mass = L * low_p\n    mid_mass = 1.0 - a - low_mass\n    if a <= 0 or mid_mass <= 0 or not np.isfinite(low_r):\n        return np.array([1e6, 1e6])\n    mid_p = mid_mass / M\n    high_r = N * a\n    mid_r = N * mid_p\n    forward = a * np.log(high_r) + low_mass * t + mid_mass * np.log(mid_r)\n    backward = -(np.log(high_r) + L * t + M * np.log(mid_r)) / N\n    return np.array([forward, backward])\n\ndef equations(x):\n    return calc(x) - TARGET\n\nsol = root(equations, np.array([0.87, -40.0]), method=\"hybr\", tol=1e-11)\nif not sol.success or np.max(np.abs(equations(sol.x))) > 1e-8:\n    raise RuntimeError(f\"solve failed: {sol.message}, x={sol.x}, values={calc(sol.x)}\")\n\na, t = map(float, sol.x)\nlow_p = np.exp(t) / N\nmid_mass = 1.0 - a - L * low_p\nmid_p = mid_mass / M\n\np = np.empty(N, dtype=np.floa"]
