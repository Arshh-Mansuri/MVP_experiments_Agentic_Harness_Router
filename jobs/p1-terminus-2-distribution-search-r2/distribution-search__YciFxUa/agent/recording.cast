[24.101472, "i", "cat > /app/solve.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import root\n\nN = 150_000\nH = 1\nL = 1_500\nM = N - H - L\nTARGET = 10.0\nLOGN = np.log(float(N))\n\n# Variables are a = mass of the single high token and t = log(N*p_low).\n# The low group has L identical probabilities p_low = exp(t)/N.\ndef metrics(x):\n    a, t = float(x[0]), float(x[1])\n    low_p = np.exp(t) / N\n    low_mass = L * low_p\n    mid_mass = 1.0 - a - low_mass\n    if a <= 0.0 or mid_mass <= 0.0:\n        return np.array([1e3, 1e3])\n    mid_p = mid_mass / M\n    high_r = N * a\n    mid_r = N * mid_p\n\n    forward = a * np.log(high_r) + low_mass * t + mid_mass * np.log(mid_r)\n    backward = -(np.log(high_r) + L * t + M * np.log(mid_r)) / N\n    return np.array([forward, backward])\n\ndef equations(x):\n    return metrics(x) - TARGET\n\n# A low group occupying 1% of the vocabulary provides enough backward KL,\n# while the high token controls the forward KL.\nsol = root(equations, np.array([0.86, -750.0]), method=\"hybr\", tol=1e-11)\nif not sol.success:\n    "]
[24.103983, "i", "raise RuntimeError(f\"root solve failed: {sol.message}; x={sol.x}; metrics={metrics(sol.x)}\")\n\na, t = map(float, sol.x)\nlow_p = np.exp(t) / N\nmid_mass = 1.0 - a - L * low_p\nmid_p = mid_mass / M\n\np = np.empty(N, dtype=np.float64)\np[0] = a\np[1:1 + L] = low_p\np[1 + L:] = mid_p\n\n# Renormalize only for floating-point roundoff, then validate.\np /= p.sum()\nu = 1.0 / N\nforward = np.sum(p * np.log(p / u))\nbackward = np.sum(u * np.log(u / p))\n\nprint(\"solver success:\", sol.success)\nprint(\"a:\", repr(a))\nprint(\"t:\", repr(t))\nprint(\"min probability:\", p.min())\nprint(\"sum:\", repr(p.sum()))\nprint(\"forward KL:\", repr(forward))\nprint(\"backward KL:\", repr(backward))\n\nif not np.isfinite(p).all() or np.any(p <= 0) or not np.isclose(p.sum(), 1.0, atol=1e-12):\n    raise RuntimeError(\"invalid probability distribution\")\nif abs(forward - TARGET) > 0.001 or abs(backward - TARGET) > 0.001:\n    raise RuntimeError(\"KL divergence tolerance not met\")\n\nnp.save(\"/app/dist.npy\", p)\nprint(\"saved /app/dist.npy\", p.shape, p.dtype)\nPY\npython3 /app/"]
[24.104143, "o", "cat > /app/solve.py <<'PY'\r\n\u001b[?2004l\r"]
[24.104184, "i", "solve.py\npython3 - <<'PY'\nimport numpy as np\np = np.load('/app/dist.npy')\nprint('file exists, shape=', p.shape, 'sum=', repr(p.sum()), 'min=', p.min(), 'max=', p.max())\nPY\n"]
[24.10758, "o", "raise RuntimeError(f\"root solve failed: {sol.message}; x={sol.x}; metrics={metrics(sol.x)}\")\r\n\r\na, t = map(float, sol.x)\r\nlow_p = np.exp(t) / N\r\nmid_mass = 1.0 - a - L * low_p\r\nmid_p = mid_mass / M\r\n\r\np = np.empty(N, dtype=np.float64)\r\np[0] = a\r\np[1:1 + L] = low_p\r\np[1 + L:] = mid_p\r\n\r\n# Renormalize only for floating-point roundoff, then validate.\r\np /= p.sum()\r\nu = 1.0 / N\r\nforward = np.sum(p * np.log(p / u))\r\nbackward = np.sum(u * np.log(u / p))\r\n\r\nprint(\"solver success:\", sol.success)\r\nprint(\"a:\", repr(a))\r\nprint(\"t:\", repr(t))\r\nprint(\"min probability:\", p.min())\r\nprint(\"sum:\", repr(p.sum()))\r\nprint(\"forward KL:\", repr(forward))\r\nprint(\"backward KL:\", repr(backward))\r\n\r\nif not np.isfinite(p).all() or np.any(p <= 0) or not np.isclose(p.sum(), 1.0, atol=1e-12):\r\n    raise RuntimeError(\"invalid probability distribution\")\r\nif abs(forward - TARGET) > 0.001 or abs(backward - TARGET) > 0.001:\r\n    raise RuntimeError(\"KL divergence tolerance not met\")\r\n\r\nnp.save(\"/app/dist.npy\", p)\r\nprint(\"saved /app/dist.npy\", p."]
[24.10769, "o", "shape, p.dtype)\r\nPY\r\npython3 /app/solve.py\r\npython3 - <<'PY'\r\nimport numpy as np\r\np = np.load('/app/dist.npy')\r\nprint('file exists, shape=', p.shape, 'sum=', repr(p.sum()), 'min=', p.min(), 'max=', p.max())\r\nPY\r\n\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import root\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> N = 150_000\r\n\u001b[?2004l\r\u001b[?2004h> H = 1\r\n\u001b[?2004l\r\u001b[?2004h> L = 1_500\r\n\u001b[?2004l\r\u001b[?2004h> M = N - H - L\r\n\u001b[?2004l\r\u001b[?2004h> TARGET = 10.0\r\n\u001b[?2004l\r\u001b[?2004h> LOGN = np.log(float(N))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
