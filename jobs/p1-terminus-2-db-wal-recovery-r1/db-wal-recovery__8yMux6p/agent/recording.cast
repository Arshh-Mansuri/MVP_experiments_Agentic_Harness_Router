[63.608643, "o", "    1  pwd; printf '\\n--- files ---\\n'; find /app -maxdepth 2 -type f -printf '%p %s bytes\\n' | sort; printf '\\n--- directory ---\\n'; ls -la /app\r\n    2  file /app/main.db /app/main.db-wal; printf '\\n--- db header ---\\n'; xxd -g1 -l 128 /app/main.db; printf '\\n--- wal header ---\\n'; xxd -g1 -l 128 /app/main.db-wal; printf '\\n--- sqlite3 ---\\n'; command -v sqlite3 || true; sqlite3 /app/main.db '.schema' 2>&1 || true; printf '\\n--- python read ---\\n'; python3 - <<'PY'\r\nimport sqlite3\r\np='/app/main.db'\r\ntry:\r\n c=sqlite3.connect(p)\r\n print(c.execute(\"select name,sql from sqlite_master\").fetchall())\r\n for t in c.execute(\"select name from sqlite_master where type='table'\").fetchall():\r\n  print(t, c.execute('select * from \"'+t[0]+'\"').fetchall())\r\nexcept Exception as e: print(type(e).__name__, e)\r\nPY\r\n\r\n    3  cp /app/main.db /app/main.db.orig; cp /app/main.db-wal /app/main.db-wal.corrupt; python3 - <<'PY'\r\np='/app/main.db-wal'\r\ndata=open(p,'rb').read()\r\nopen(p,'wb').write(bytes(b ^ 0x42 for b in data))\r\nprint('decrypted', len(data), 'bytes')\r\nPY\r\n\r\n    4  printf '\\n--- repaired WAL header ---\\n'; xxd -g1 -l 64 /app/main.db-wal; printf '\\n--- rows ---\\n'; sqlite3 -header -column /app/main.db 'SELECT id,name,value FROM items ORDER BY id;'\r\n    5  printf '%s\\n' '--- app files ---'; ls -la /app; printf '%s\\n' '--- possible WAL names ---'; find /app /tmp -maxdepth 3 -type f -o -type l 2>/dev/null | sort; printf '%s\\n' '--- deleted open files ---'; for f in /proc/[0-9]*/fd/*; do x=$(readlink \"$f\" 2>/dev/null || true); case \"$x\" in *main.db*|*wal*) echo \"$f -> $x\";; esac; done; printf '%s\\n' '--- history ---'; history 2>/dev/null | tail -30\r\n"]
