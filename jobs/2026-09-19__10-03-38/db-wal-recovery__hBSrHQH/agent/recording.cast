[42.709329, "o", "    1  clear\r\n    2  pwd; printf '\\n-- files --\\n'; ls -la; printf '\\n-- file types --\\n'; file /app/* 2>&1\r\n    3  printf '\\n-- sqlite tools --\\n'; command -v sqlite3 || true; python3 - <<'PY'\r\nimport sqlite3, os, glob\r\nprint('python sqlite', sqlite3.sqlite_version)\r\nfor p in glob.glob('/app/*'):\r\n    try:\r\n        print(p, os.path.getsize(p))\r\n    except OSError:\r\n        pass\r\nPY\r\n\r\n    4  cp -a /app/main.db /app/main.db.original; cp -a /app/main.db-wal /app/main.db-wal.original; printf '%s\\n' '-- sqlite info --'; sqlite3 /app/main.db \"PRAGMA journal_mode; PRAGMA page_size; PRAGMA schema_version; .tables\"; printf '%s\\n' '-- schema --'; sqlite3 /app/main.db \".schema\"; printf '%s\\n' '-- rows visible --'; sqlite3 -header -column /app/main.db \"SELECT * FROM items ORDER BY id;\" 2>&1; printf '%s\\n' '-- headers --'; od -Ax -tx1z -N96 /app/main.db; od -Ax -tx1z -N96 /app/main.db-walprintf '%s\\n' '-- wal strings --'; strings -a /app/main.db-wal | head -100; printf '%s\\n' '-- wal frame offsets --'; for n in 0 1 2 3 4; do printf 'offset %s: ' \"$((n*4096))\"; od -An -tx1 -N32 -j \"$((n*4096))\" /app/main.db-wal; donesqlite3 /app/main.db '.schema'; printf '%s\\n' '--- visible rows ---'; sqlite3 -header -column /app/main.db 'SELECT name FROM sqlite_master; SELECT * FROM items ORDER BY id;' 2>&1; printf '%s\\n' '--- sizes ---'; wc -c /app/main.db /app/main.db-wal /app/main.db.original /app/main.db-wal.original; printf '%s\\n' '--- db header ---'; od -Ax -tx1z -N128 /app/main.db; printf '%s\\n' '--- wal header ---'; od -Ax -tx1z -N128 /app/main.db-wal\r\npython3 - <<'PY'\r\nfrom pathlib import Path\r\nfor fn in ['/app/main.db','/app/main.db-wal']:\r\n    b=Path(fn).read_bytes()\r\n    print('\\n',fn, len(b))\r\n    for i in range(0,min(len(b),20000),4096):\r\n        print('offset',i,'hex',b[i:i+32].hex(),'ascii',repr(''.join(chr(x) if 32<=x<127 else '.' for x in b[i:i+128])))\r\nPY\r\n\r\n    5  python3 -c \"from pathlib import Path; import re; files=['/app/main.db','/app/main.db-wal']; [(lambda b,f: (print(f,len(b),b[:100].hex()), print('strings', re.findall(rb'[ -~]{4,}',b)[:30]), print('frames',[(int.from_bytes(b[o:o+4],'big'),b[o:o+32].hex()) for o in range(32,len(b),4096)]))(Path(f).read_bytes(),f) for f in files]\"\r\n    6  sqlite3 /app/main.db \".schema\"\r\n    7  sqlite3 -header -column /app/main.db \"SELECT name FROM sqlite_master; SELECT * FROM items ORDER BY id;\" 2>&1\r\n    8  printf '%s\\n' '--- database header ---'\r\n    9  od -Ax -tx1z -N128 /app/main.db\r\n   10  printf '%s\\n' '--- wal header and frame starts ---'\r\n   11  od -Ax -tx1z -N128 /app/main.db-wal\r\n   12  od -Ax -tx1z -j4096 -N64 /app/main.db-wal\r\n   13  od -Ax -tx1z -j8192 -N64 /app/main.db-wal\r\n   14  od -Ax -tx1z -j12288 -N64 /app/main.db-wal\r\n   15  od -Ax -tx1z -j16384 -N64 /app/main.db-wal\r\n   16  printf '%s\\n' '--- printable WAL strings ---'\r\n   17  strings -a -n 3 /app/main.db-wal | head -100\r\n   18  python3 -c \"from pathlib import Path; b=Path('/app/main.db-wal').read_bytes(); print('length',len(b)); print('header',b[:32].hex()); print('frame page numbers',[int.from_bytes(b[o:o+4],'big') for o in range(32,len(b),4096)]); print('unique bytes',len(set(b))); print('first 256',b[:256].hex())\"\r\n   19  ls -l /app/*original /app/main.db 2>&1\r\n   20  wc -c /app/main.db.original /app/main.db-wal.original\r\n   21  od -Ax -tx1z -N128 /app/main.db-wal.original\r\n   22  od -Ax -tx1z -j4096 -N96 /app/main.db-wal.original\r\n   23  od -Ax -tx1z -j8192 -N96 /app/main.db-wal.original\r\n   24  od -Ax -tx1z -j12288 -N96 /app/main.db-wal.original\r\n   25  od -Ax -tx1z -j16384 -N96 /app/main.db-wal.original\r\n   26  strings -a -n 3 /app/main.db-wal.original | head -100\r\n   27  python3 -c \"from pathlib import Path; b=Path('/app/main.db-wal.original').read_bytes(); print('length',len(b)); print('header',b[:32].hex()); print('frame_pages',[int.from_bytes(b[o:o+4],'big') for o in range(32,len(b),4096)]); print('unique_bytes',len(set(b))); print('ascii', ''.join(chr(x) if 32<=x<127 else '.' for x in b))\"\r\n   28  printf '%s\\n' '-- app --'; find /app -maxdepth 2 -type f -printf '%p %s bytes\\n' 2>/dev/null; printf '%s\\n' '"]
