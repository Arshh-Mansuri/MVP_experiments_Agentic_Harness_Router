[18.962797, "i", "cat > /app/polyglot/main.py.c <<'EOF'\n#if 0\n\"\"\"\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic char *add_numbers(const char *a, const char *b) {\n    size_t la = strlen(a), lb = strlen(b);\n    size_t n = (la > lb ? la : lb) + 2;\n    char *out = malloc(n);\n    if (!out) exit(1);\n    out[n - 1] = '\\0';\n    size_t ia = la, ib = lb, io = n - 2;\n    int carry = 0;\n    while (ia || ib || carry) {\n        int sum = carry;\n        if (ia) sum += a[--ia] - '0';\n        if (ib) sum += b[--ib] - '0';\n        out[io--] = (char)('0' + sum % 10);\n        carry = sum / 10;\n    }\n    memmove(out, out + io + 1, n - io - 1);\n    return out;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) return 1;\n    unsigned long long k = strtoull(argv[1], NULL, 10);\n    char *a = strdup(\"0\");\n    char *b = strdup(\"1\");\n    if (!a || !b) return 1;\n    for (unsigned long long i = 0; i < k; ++i) {\n        char *next = add_numbers(a, b);\n        free(a);\n        a = b;\n        b = next;\n    }\n    puts(a);\n    free(a);\n    free(b);\n    return 0;\n}\n#if 0\n\"\"\"\n#endif\nimport sys\n\nk = int(sys.argv[1])\na, b = 0, 1\nfor _ in range(k):\n    a, b = b, a + b\nprint(a)\nEOF\npython3 /app/polyglot/main.py.c 10\ngcc /app/polyglot/main.py.c -o /app/polyglot/cmain && /app/polyglot/cmain 10\npython3 /app/polyglot/main.py.c 100 | head -c 30; echo\n/app/polyglot/cmain 100 | head -c 30; echo\n"]
