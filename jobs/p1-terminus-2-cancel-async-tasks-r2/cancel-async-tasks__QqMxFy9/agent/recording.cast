[12.523566, "o", "import asyncio\r\nfrom collections.abc import Awaitable, Callable\r\n\r\n\r\nasync def run_tasks(\r\n    tasks: list[Callable[[], Awaitable[None]]],\r\n    max_concurrent: int,\r\n) -> None:\r\n    \"\"\"Run async task callables with a limit on concurrent execution.\r\n\r\n    If this function is cancelled, all started tasks are cancelled and awaited\r\n    before cancellation is propagated, allowing their cleanup code to run.\r\n    \"\"\"\r\n    if max_concurrent <= 0:\r\n        raise ValueError(\"max_concurrent must be greater than zero\")\r\n\r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n\r\n    async def run_one(task_factory: Callable[[], Awaitable[None]]) -> None:\r\n        async with semaphore:\r\n            await task_factory()\r\n\r\n    child_tasks = [asyncio.create_task(run_one(task)) for task in tasks]\r\n    if not child_tasks:\r\n        return\r\n\r\n    try:\r\n        results = await asyncio.gather(*child_tasks, return_exceptions=True)\r\n    except asyncio.CancelledError:\r\n        for child in child_tasks:\r\n            if not child.done():\r\n"]
[12.523823, "o", "                child.cancel()\r\n        await asyncio.gather(*child_tasks, return_exceptions=True)\r\n        raise\r\n\r\n    for result in results:\r\n        if isinstance(result, BaseException):\r\n            raise result\r\n"]
[12.525665, "o", "\u001b[?2004hroot@2ad2d58d83d5:/app# "]
[22.134516, "i", "python3 - <<'PY'\nimport asyncio\nimport sys\nsys.path.insert(0, '/app')\nfrom run import run_tasks\n\nasync def main():\n    active = 0\n    peak = 0\n\n    async def job():\n        nonlocal active, peak\n        active += 1\n        peak = max(peak, active)\n        try:\n            await asyncio.sleep(0.02)\n        finally:\n            active -= 1\n\n    await run_tasks([job for _ in range(8)], 3)\n    assert peak == 3, peak\n    assert active == 0\n\n    cleaned = 0\n    async def cancellable():\n        nonlocal cleaned\n        try:\n            await asyncio.sleep(10)\n        finally:\n            cleaned += 1\n\n    runner = asyncio.create_task(run_tasks([cancellable, cancellable], 2))\n    await asyncio.sleep(0.02)\n    runner.cancel()\n    try:\n        await runner\n    except asyncio.CancelledError:\n        pass\n    assert cleaned == 2, cleaned\n\nasyncio.run(main())\nprint('behavioral tests passed')\nPY"]
[22.135205, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
