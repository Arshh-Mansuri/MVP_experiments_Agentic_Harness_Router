[299.679274, "o", "def ns(s, labels, p):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in labels: s=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])',p+x,s)\r\n\u001b[?2004l\r"]
