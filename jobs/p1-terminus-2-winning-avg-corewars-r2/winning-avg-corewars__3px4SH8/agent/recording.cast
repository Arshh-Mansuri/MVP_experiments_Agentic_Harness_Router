[266.027654, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nf=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text().splitlines()\ndef stripmeta(lines):\n    out=[]\n    for line in lines:\n        z=line.strip().lower()\n        if not line.strip():\n            continue\n        if z.startswith((';','org ','end ')):\n            continue\n        out.append(line)\n    return out\nlabels=['s01','s02','s03','s04','s05','s06','s07','s08','s09','m01','m02','m03','m04','m05','m06','m07','m08','m09','mark','mark0','paper','stst','st']\n# Namespace only standalone symbol tokens in Flash source.\nfs='\\n'.join(stripmeta(f))\nfor x in labels:\n    fs=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])','F_'+x,fs)\nrs='\\n'.join(stripmeta(r))\ntext=''';redcode-94\n;name Rave Flash Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n'''+rs+'\\n'+fs+'''\\nlaunch   spl     comp\n         jmp     F_stst\n         end     launch\n'''\nPath('/tmp/raveflash4.red').write_text(text)\nPY\npmars -b -r 1 -f /tmp/raveflash4.red warriors/stone.red\n"]
