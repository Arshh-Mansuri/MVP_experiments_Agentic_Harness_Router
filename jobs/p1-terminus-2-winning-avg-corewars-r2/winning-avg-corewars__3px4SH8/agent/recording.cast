[2551.101007, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\ndef clean(path):\n    out=[]\n    for line in Path(path).read_text().splitlines():\n        z=line.strip().lower()\n        if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '):\n            continue\n        out.append(line)\n    return '\\n'.join(out)\n\ndef namespace(s, names, p):\n    for n in sorted(names,key=len,reverse=True):\n        s=re.sub(r'(?<![A-Za-z0-9_])'+re.escape(n)+r'(?![A-Za-z0-9_])',p+n,s)\n    return s\nr=clean('/app/pmars-0.9.4/warriors/rave.red')\na=clean('/app/pmars-0.9.4/warriors/aeka.red')\na_names=['imp_sz01','imp_sz02','imp_sz03','imp_prc01','imp_prc02','imp_prc03','imp_off01','imp_off02','imp_off03','imp_first','stone_inc','stone_offst','dec_offst','start','imp_split','stone_dst','stone_dst2','stone_src','stone','stone_spl','stone_end','cnt','imp_A_fld','imp_B_fld','who','imp_vector','imp_2','imp_3']\na=namespace(a,a_names,'A_')\ntext=''';redcode-94\n;name Rave Aeka Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\norg launch\nlaunch   spl     comp\n         jmp     A_start\n'''+r+'\\n'+a+'\\nend launch\\n'\nPath('/tmp/rave_aeka_fixed.red').write_text(text)\nPY\npmars -b -r 1 -f /tmp/rave_aeka_fixed.red warriors/stone.red\n"]
