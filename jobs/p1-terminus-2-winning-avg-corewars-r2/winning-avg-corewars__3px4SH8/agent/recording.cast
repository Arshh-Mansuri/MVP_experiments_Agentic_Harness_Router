[1728.904602, "i", "for pair in '84_12' '42_14' '24_20' '42_12' '18_8'; do for w in /tmp/x_${pair}_*.red; do [ -f \"$w\" ] || continue; a=$(pmars -b -r 20 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); b=$(pmars -b -r 20 -f \"$w\" warriors/snake.red 2>/dev/null | awk '/Results:/{print $2}'); echo \"$((a+b)) $a $b $w\"; done; done | sort -nr | head -20\n"]
[1728.906971, "o", "for pair in '84_12' '42_14' '24_20' '42_12' '18_8'; do for w in /tmp/x_${pair}_*.red; do [ -f \"$w\" ] || continue; a=$(pmars -b -r 20 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); b=$(pmars -b -r 20 -f \"$w\" warriors/snake.red 2>/dev/null | awk '/Results:/{print $2}'); echo \"$((a+b)) $a $b $w\"; done; done | sort -nr | head -20\r\n\u001b[?2004l\r"]
