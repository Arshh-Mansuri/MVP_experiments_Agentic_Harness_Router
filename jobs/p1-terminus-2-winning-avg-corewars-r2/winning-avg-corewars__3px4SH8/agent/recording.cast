[70.55862, "i", "cat > /tmp/hybrid.red <<'EOF'\n;redcode-94\n;name Paper Bomber Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     paper\n        spl     bomber\n        jmp     paper\npaper   spl     1\n        spl     1\nploop   mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     ploop\ncopy    spl     0, 0\np       dat     2667, 5334\nbomber  add     #4, bp\n        mov     bomb, @bp\n        mov     bomb, *bp\n        jmp     bomber\nbomb    dat     0, 0\nbp      dat     200, 0\n        end start\nEOF\ncat > /tmp/paper4.red <<'EOF'\n;redcode-94\n;name Paper Four Process\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     1\n        spl     1\n        spl     1\n        jmp     loop\nloop    mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     loop\ncopy    spl     0, 0\np       dat     2667, 5334\n        end start\nEOF\ncat > /tmp/imp-paper.red <<'EOF'\n;redcode-94\n;name Paper Imp Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     paper\n        spl     impstart\n        jmp     paper\npaper   spl     1\n        spl     1\nloop    mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     loop\ncopy    spl     0, 0\np       dat     2667, 5334\nimpstart mov     imp, 4000\n        spl     impgo\n        jmp     impgo\nimpgo   mov     0, 2667\nimp     mov     0, 2667\n        end start\nEOF\nfor w in /tmp/hybrid.red /tmp/paper4.red /tmp/imp-paper.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" | grep Results; done; done\n"]
