[2756.175908, "o", "echo '--- candidate head ---'; sed -n '1,18p' /tmp/ha_24_20_one.red; echo '--- directives ---'; grep -nE 'org|end|CDIST|IVAL|launch|comp|A_start' /tmp/ha_24_20_one.red | head -20; echo '--- diagnostics ---'; pmars -b -r 1 -f /tmp/ha_24_20_one.red warriors/stone.red\r\n"]
[2756.176462, "o", "\u001b[?2004l\r"]
[2756.178411, "o", "--- candidate head ---\r\n"]
[2756.208613, "o", ";redcode-94\r\norg launch\r\nlaunch   spl     comp\r\n         jmp     A_start\r\n;redcode-94\r\n;name Rave Aeka Compact\r\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\nCDIST   equ 20\r\nIVAL    equ 24\r\nFIRST   equ scan+OFFSET+IVAL\r\nOFFSET  equ (2*IVAL)\r\nDJNOFF  equ -431\r\nBOMBLEN equ CDIST+2\r\nscan    sub.f  incr,comp\r\n"]
[2756.20958, "o", "comp    cmp.i  FIRST,FIRST-CDIST        ;larger number is A\r\n        slt.a  #incr-comp+BOMBLEN,comp  ;compare to A-number\r\n        djn.f  scan,<FIRST+DJNOFF       ;decrement A- and B-number\r\n        mov.ab #BOMBLEN,count\r\n"]
[2756.211551, "o", "--- directives ---\r\n"]
