[182.218892, "i", "python3 - <<'PY'\nfrom pathlib import Path\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\nf=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text()\na=Path('/app/pmars-0.9.4/warriors/aeka.red').read_text()\ndef body(s):\n    lines=[]\n    for x in s.splitlines():\n        z=x.strip().lower()\n        if z.startswith('org ') or z.startswith('end '): continue\n        lines.append(x)\n    return '\\n'.join(lines)\nhead=''';redcode-94\\n;name Rave Flash Hybrid\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg launch\\nlaunch   spl rave_entry\\n         jmp flash_entry\\nrave_entry:\\n'''\nPath('/tmp/raveflash.red').write_text(head+body(r).replace('org comp','')+'\\nflash_entry:\\n'+body(f)+'\\nend launch\\n')\nhead=''';redcode-94\\n;name Rave Aeka Hybrid\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg launch\\nlaunch   spl rave_entry\\n         jmp aeka_entry\\nrave_entry:\\n'''\nPath('/tmp/raveaeka.red').write_text(head+body(r).replace('org comp','')+'\\naeka_entry:\\n'+body(a)+'\\nend launch\\n')\nPY\nfor w in /tmp/raveflash.red /tmp/raveaeka.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" | grep Results; done; done\n"]
