[237.178732, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\nf=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text()\ndef clean(s):\n    out=[]\n    for line in s.splitlines():\n        if line.strip().lower().startswith(('org ', 'end ')): continue\n        out.append(line)\n    return '\\n'.join(out)\n# Namespace Flash's labels and every reference to them.\nlabels=['s01','s02','s03','s04','s05','s06','s07','s08','s09','m01','m02','m03','m04','m05','m06','m07','m08','m09','mark','mark0','paper','stst','st']\nfor x in labels:\n    f=re.sub(r'(?<![A-Za-z0-9_])'+re.escape(x)+r'(?![A-Za-z0-9_])','F_'+x,f)\nr=clean(r)\nf=clean(f)\ntext=''';redcode-94\n;name Rave Flash Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\norg launch\nlaunch   spl     comp\n         jmp     F_stst\n'''+r+'\\n'+f+'\\nend launch\\n'\nPath('/tmp/raveflash3.red').write_text(text)\nPY\nhead -20 /tmp/raveflash3.red\nfor o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f /tmp/raveflash3.red \"warriors/$o.red\" | grep Results; done\n"]
