[2770.278804, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nbase=Path('/tmp/fixed_one.red').read_text()\nbase=re.sub(r'^;redcode-94\\n;name[^\\n]*\\n;assert[^\\n]*\\norg launch\\nlaunch.*?\\n(?=CDIST)', '', base, count=1, flags=re.S)\nbase=re.sub(r'\\nend launch\\s*$', '\\n', base)\nfor ival,cd in [(24,20),(42,12),(42,14),(84,10),(84,12),(18,8),(14,6)]:\n    s=re.sub(r'(?m)^CDIST\\s+equ\\s+\\d+',f'CDIST   equ {cd}',base)\n    s=re.sub(r'(?m)^IVAL\\s+equ\\s+\\d+',f'IVAL    equ {ival}',s)\n    launches={\n      'rf': 'org launch\\nlaunch   spl     comp\\n         jmp     A_start\\n',\n      'af': 'org launch\\nlaunch   spl     A_start\\n         jmp     comp\\n',\n      'rr': 'org launch\\nlaunch   spl     comp\\n         spl     comp\\n         jmp     A_start\\n',\n      'aa': 'org launch\\nlaunch   spl     A_start\\n         spl     A_start\\n         jmp     comp\\n'\n    }\n    for tag,launch in launches.items():\n        Path(f'/tmp/g_{ival}_{cd}_{tag}.red').write_text(';redcode-94\\n;name tuned hybrid\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n'+launch+s+'end launch\\n')\nPY\nfor w in /tmp/g_*.red; do echo \"### $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
