[2139.049403, "i", "python3 - <<'PY'\nfrom pathlib import Path\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nbody=[]\nfor x in src:\n z=x.strip().lower()\n if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\n body.append(x)\nci=next(i for i,x in enumerate(body) if x.strip().startswith('comp '))\noriginal=body[ci]\nfor inc in [1,2,3,4,6,8,10,12,16,20,24,28,32,40]:\n for off in [50,100,150,200,300,500,700,1000]:\n  b=body[:ci]+['comp    spl     bomber',original]+body[ci+1:]\n  b += [f'bomber  add     #{inc}, bptr','        mov     bdat, @bptr','        jmp     bomber','bdat    dat     0, 0',f'bptr    dat     {off}, 0']\n  Path(f'/tmp/z_{inc}_{off}.red').write_text(';redcode-94\\n;name Rave Bomber\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg comp\\n'+'\\n'.join(b)+'\\nend\\n')\nPY\nfind /tmp -maxdepth 1 -name 'z_*.red' -print0 | xargs -0 -n1 -P12 sh -c 'w=\"$1\"; a=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); b=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); if [ \"${a:-0}\" -ge 75 ] && [ \"${b:-0}\" -ge 33 ]; then echo \"$a $b $w\"; fi' sh | sort -nr\n"]
