[786.290464, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\nfor ival in [12,18,24,30,36,42,48,54,60,72,84,96,108,120]:\n  for cdist in [6,8,10,12,14,16,18,20,24]:\n    s=src\n    s=re.sub(r'(?m)^CDIST\\s+equ\\s+\\d+',f'CDIST   equ {cdist}',s)\n    s=re.sub(r'(?m)^IVAL\\s+equ\\s+\\d+',f'IVAL    equ {ival}',s)\n    Path(f'/tmp/rv_{ival}_{cdist}.red').write_text(s)\nPY\nfor w in /tmp/rv_*.red; do x=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); echo \"$x $w\"; done | sort -nr | head -15\n"]
