[1796.720907, "i", "for pair in 84_12 42_14 24_20 42_12 18_8; do for w in /tmp/x_${pair}_*.red; do [ -f \"$w\" ] || continue; (a=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); b=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk '/Results:/{print $2}'); if [ \"${a:-0}\" -ge 75 ] && [ \"${b:-0}\" -ge 33 ]; then echo \"$a $b $w\"; fi) & done; done; wait\n"]
