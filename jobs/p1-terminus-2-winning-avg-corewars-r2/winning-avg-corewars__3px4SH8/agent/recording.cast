[2688.553111, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nbase=Path('/tmp/rave_aeka_compact3.red').read_text()\n# Remove the existing origin/launcher and rebuild variants while preserving cleaned bodies.\nbody=base\nbody=re.sub(r'(?ms)^org launch\\nlaunch.*?\\n(?=CDIST)', '', body)\nbody=re.sub(r'(?m)^end launch\\s*$', '', body)\nfor ival,cd in [(24,20),(42,12),(42,14),(84,10),(84,12),(18,8),(14,6)]:\n s=re.sub(r'(?m)^CDIST\\s+equ\\s+\\d+',f'CDIST   equ {cd}',body)\n s=re.sub(r'(?m)^IVAL\\s+equ\\s+\\d+',f'IVAL    equ {ival}',s)\n for name,launch in {\n  'one':f'org launch\\nlaunch   spl     comp\\n         jmp     A_start\\n',\n  'two':f'org launch\\nlaunch   spl     comp\\n         spl     comp\\n         jmp     A_start\\n',\n  'aeka_first':f'org launch\\nlaunch   spl     A_start\\n         jmp     comp\\n',\n  'aeka_two':f'org launch\\nlaunch   spl     A_start\\n         spl     comp\\n         jmp     comp\\n'\n }.items():\n  Path(f'/tmp/ha_{ival}_{cd}_{name}.red').write_text(';redcode-94\\n'+launch+s+'end launch\\n')\nPY\nfor w in /tmp/ha_*.red; do echo \"### $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
