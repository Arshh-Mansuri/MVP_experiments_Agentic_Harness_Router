[2139.300745, "o", "find /tmp -maxdepth 1 -name 'z_*.red' -print0 | xargs -0 -n1 -P12 sh -c 'w=\"$1\"; a=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); b=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); if [ \"${a:-0}\" -ge 75 ] && [ \"${b:-0}\" -ge 33 ]; then echo \"$a $b $w\"; fi' sh | sort -nr\r\n\u001b[?2004l\r"]
