[426.533254, "i", "python3 - <<'PY'\nfrom pathlib import Path\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nclean=[]\nfor x in r:\n    z=x.strip().lower()\n    if not z or z.startswith(';') or z.startswith('org') or z == 'end' or z.startswith('end '): continue\n    clean.append(x)\nrs='\\n'.join(clean)\nvariants={\n'ravebomb4':'''launch   spl     bomber\n         jmp     comp\nbomber   add     #4, bptr\n         mov     bdat, @bptr\n         jmp     bomber\nbdat     dat     0, 0\nbptr     dat     200, 0\n''',\n'ravebomb3':'''launch   spl     bomber\n         jmp     comp\nbomber   add     #3, bptr\n         mov     bdat, @bptr\n         jmp     bomber\nbdat     dat     0, 0\nbptr     dat     300, 0\n''',\n'ravebomb7':'''launch   spl     bomber\n         jmp     comp\nbomber   add     #7, bptr\n         mov     bdat, @bptr\n         jmp     bomber\nbdat     dat     0, 0\nbptr     dat     500, 0\n''',\n'ravebomb4x':'''launch   spl     bomber\n         spl     bomber2\n         jmp     comp\nbomber   add     #4, bptr\n         mov     bdat, @bptr\n         jmp     bomber\nbomber2  add     #4, cptr\n         mov     bdat, @cptr\n         jmp     bomber2\nbdat     dat     0, 0\nbptr     dat     200, 0\ncptr     dat     1000, 0\n'''}\nfor n,l in variants.items():\n    Path('/tmp/'+n+'.red').write_text(';redcode-94\\n;name '+n+'\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg launch\\n'+l+rs+'\\nend launch\\n')\nPY\nfor w in /tmp/ravebomb4.red /tmp/ravebomb3.red /tmp/ravebomb7.red /tmp/ravebomb4x.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
