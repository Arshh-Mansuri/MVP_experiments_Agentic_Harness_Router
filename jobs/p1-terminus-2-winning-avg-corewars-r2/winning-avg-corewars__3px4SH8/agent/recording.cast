[466.296278, "i", "python3 - <<'PY'\nfrom pathlib import Path\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nbody=[]\nfor x in r:\n    z=x.strip().lower()\n    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\n    body.append(x)\n# Insert the split without moving the scanner's entry label or its original instructions.\nidx=next(i for i,x in enumerate(body) if x.strip().startswith('scan '))\nvariants={\n 'rave_split4':'''        spl     bomber\n'''+'''bomber  add     #4, bptr\n        mov     bdat, @bptr\n        jmp     bomber\nbdat    dat     0, 0\nbptr    dat     200, 0\n''',\n 'rave_split3':'''        spl     bomber\nbomber  add     #3, bptr\n        mov     bdat, @bptr\n        jmp     bomber\nbdat    dat     0, 0\nbptr    dat     300, 0\n''',\n 'rave_split7':'''        spl     bomber\nbomber  add     #7, bptr\n        mov     bdat, @bptr\n        jmp     bomber\nbdat    dat     0, 0\nbptr    dat     500, 0\n''',\n 'rave_split4x':'''        spl     bomber\nbomber  add     #4, bptr\n        mov     bdat, @bptr\n        jmp     bomber\nbdat    dat     0, 0\nbptr    dat     200, 0\n'''}\nfor name,extra in variants.items():\n    b=body[:idx]+[extra]+body[idx:]\n    # Keep the original Rave entry point.\n    Path('/tmp/'+name+'.red').write_text(';redcode-94\\n;name '+name+'\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg comp\\n'+'\\n'.join(b)+'\\nend\\n')\nPY\nfor w in /tmp/rave_split4.red /tmp/rave_split3.red /tmp/rave_split7.red /tmp/rave_split4x.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
