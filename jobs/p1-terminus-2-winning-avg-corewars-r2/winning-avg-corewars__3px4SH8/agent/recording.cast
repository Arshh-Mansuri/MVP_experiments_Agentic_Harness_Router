[2247.910812, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\nfor ival,cd in [(84,12),(42,12),(42,14),(24,20)]:\n  for dj in range(-430,-299,10):\n    s=re.sub(r'(?m)^CDIST\\s+equ\\s+\\d+',f'CDIST   equ {cd}',src)\n    s=re.sub(r'(?m)^IVAL\\s+equ\\s+\\d+',f'IVAL    equ {ival}',s)\n    s=re.sub(r'(?m)^DJNOFF\\s+equ\\s+-?\\d+',f'DJNOFF  equ {dj}',s)\n    Path(f'/tmp/n_{ival}_{cd}_{abs(dj)}.red').write_text(s)\nPY\nfind /tmp -maxdepth 1 -name 'n_*.red' -print0 | xargs -0 -n1 -P16 sh -c 'w=\"$1\"; a=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); b=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); if [ \"${a:-0}\" -ge 75 ] && [ \"${b:-0}\" -ge 33 ]; then echo \"$a $b $w\"; fi' sh | sort -nr\n"]
