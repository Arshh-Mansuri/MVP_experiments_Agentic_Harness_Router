[299.67669, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nf=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text().splitlines()\na=Path('/app/pmars-0.9.4/warriors/aeka.red').read_text().splitlines()\ndef clean(lines):\n    return '\\n'.join(x for x in lines if x.strip() and not x.strip().lower().startswith((';','org ','end ')))\ndef ns(s, labels, p):\n    for x in labels: s=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])',p+x,s)\n    return s\nfs=ns(clean(f),['s01','s02','s03','s04','s05','s06','s07','s08','s09','m01','m02','m03','m04','m05','m06','m07','m08','m09','mark','mark0','paper','stst','st'],'F_')\nars=ns(clean(a),['start','imp_sz01','imp_sz02','imp_sz03','imp_prc01','imp_prc02','imp_prc03','imp_off01','imp_off02','imp_off03','imp_first','stone_inc','stone_offst','dec_offst','imp_split','stone_dst','stone_dst2','stone_src','stone','stone_spl','stone_end','cnt','imp_A_fld','imp_B_fld','who','imp_vector','imp_2','imp_3'],'A_')\nrs=clean(r)\nbase=''';redcode-94\\n;name Hybrid Test\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n'''+rs+'\\n'+fs+'\\n'+ars+'\\n'\nvariants={\n'flashfirst':'launch spl F_stst\\n       spl F_stst\\n       jmp comp\\n',\n'flashmany':'launch spl F_stst\\n       spl F_stst\\n       spl F_stst\\n       spl F_stst\\n       jmp comp\\n',\n'ravemany':'launch spl comp\\n       spl comp\\n       spl comp\\n       jmp F_stst\\n',\n'aekarave':'launch spl A_start\\n       jmp comp\\n'\n}\nfor n,l in variants.items(): Path('/tmp/'+n+'.red').write_text(base+l+'end launch\\n')\nPY\nfor w in /tmp/flashfirst.red /tmp/flashmany.red /tmp/ravemany.red /tmp/aekarave.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
[299.678237, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[299.678281, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[299.678507, "o", "\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
