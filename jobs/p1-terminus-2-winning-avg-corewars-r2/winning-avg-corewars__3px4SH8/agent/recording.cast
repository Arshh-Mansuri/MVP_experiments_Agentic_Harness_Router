[1030.020028, "i", "for w in /tmp/sv_*.red; do r=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); s=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk '/Results:/{print $2}'); if [ \"${r:-0}\" -ge 75 ] && [ \"${s:-0}\" -ge 33 ]; then echo \"$r $s $w\"; fi; done | sort -nr | head -20\n"]
[1030.021553, "o", "for w in /tmp/sv_*.red; do r=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); s=$(pmars -b -r 100 -f \"$w\" warriors/snake.red 2>/dev/null | awk '/Results:/{print $2}'); if [ \"${r:-0}\" -ge 75 ] && [ \"${s:-0}\" -ge 33 ]; then echo \"$r $s $w\"; fi; done | sort -nr | head -20\r\n\u001b[?2004l\r"]
[1100.6984, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\n# Keep executable and macro lines, remove metadata and end/org directives.\nlines=[]\nfor x in src:\n    z=x.strip().lower()\n    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\n    lines.append(x)\n# Symbols appearing in Rave source, including labels and EQU names.\nsymbols=['CDIST','IVAL','FIRST','OFFSET','DJNOFF','BOMBLEN','scan','comp','incr','count','split','bomb']\ndef copy(prefix,ival,cdist):\n    s='\\n'.join(lines)\n    for x in symbols:\n        s=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])',prefix+x,s)\n    s=re.sub(r'(?m)^'+prefix+'CDIST\\s+equ\\s+\\d+',f'{prefix}CDIST   equ {cdist}',s)\n    s=re.sub(r'(?m)^'+prefix+'IVAL\\s+equ\\s+\\d+',f'{prefix}IVAL    equ {ival}',s)\n    return s\none=copy('S_',24,20)\ntwo=copy('N_',42,12)\ntext=''';redcode-94\n;name Dual Rave Tuned\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\norg launch\nlaunch   spl     S_comp\n         jmp     N_comp\n'''+one+'\\n'+two+'\\nend launch\\n'\nPath('/tmp/dual_rave.red').write_text(text)\nPY\npmars -b -r 1 -f /tmp/dual_rave.red warriors/stone.red\n"]
[1100.772608, "o", "python3 - <<'PY'\r\nfrom pathlib import Path\r\nimport re\r\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\r\n# Keep executable and macro lines, remove metadata and end/org directives.\r\nlines=[]\r\nfor x in src:\r\n    z=x.strip().lower()\r\n    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\r\n    lines.append(x)\r\n# Symbols appearing in Rave source, including labels and EQU names.\r\nsymbols=['CDIST','IVAL','FIRST','OFFSET','DJNOFF','BOMBLEN','scan','comp','incr','count','split','bomb']\r\ndef copy(prefix,ival,cdist):\r\n    s='\\n'.join(lines)\r\n    for x in symbols:\r\n        s=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])',prefix+x,s)\r\n    s=re.sub(r'(?m)^'+prefix+'CDIST\\s+equ\\s+\\d+',f'{prefix}CDIST   equ {cdist}',s)\r\n    s=re.sub(r'(?m)^'+prefix+'IVAL\\s+equ\\s+\\d+',f'{prefix}IVAL    equ {ival}',s)\r\n    return s\r\none=copy('S_',24,20)\r\ntwo=copy('N_',42,12)\r\ntext=''';redcode-94\r\n;name Dual Rave Tuned\r\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\norg launch\r\nlaunch   spl     S_comp\r\n         jmp     N_comp\r\n'''+one+'\\n'+two+'\\nend launch\\n'\r\nPath('/tmp/dual_rave.red').write_text(text)\r\nPY\r\npmars -b -r 1 -f /tmp/dual_rave.red warriors/stone.red\r\n"]
