[375.349421, "o", "cp /app/pmars-0.9.4/warriors/rave.red /tmp/rave.red; cp /app/pmars-0.9.4/warriors/flashpaper.red /tmp/flash.red; pmars -b -r 100 -f /tmp/rave.red warriors/stone.red | grep Results; pmars -b -r 100 -f /tmp/flash.red warriors/stone.red | grep Results\r\n\u001b[?2004l\r"]
