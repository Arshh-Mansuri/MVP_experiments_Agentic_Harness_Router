[48.446349, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Fast Carpet Bomber\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n\nstart   spl     1\n        spl     1\n        jmp     bombloop\n\nbombloop add     #4, ptr\n        mov     bomb, @ptr\n        mov     bomb, *ptr\n        jmp     bombloop\n\nbomb    dat     0, 0\nptr     dat     0, 0\n\n        end     start\nEOF\nfor o in stone vampire paper snake g2-clear; do echo \"=== $o ===\"; pmars -b -r 100 -f my_warrior.red \"warriors/$o.red\"; done\n"]
