[207.688494, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor src,dst,second in [('/tmp/raveflash.red','/tmp/raveflash2.red','flash_entry'),('/tmp/raveaeka.red','/tmp/raveaeka2.red','aeka_entry')]:\n    s=Path(src).read_text()\n    s=s.replace('rave_entry:', 'rave_entry').replace('flash_entry:', 'flash_entry').replace('aeka_entry:', 'aeka_entry')\n    Path(dst).write_text(s)\nPY\nfor w in /tmp/raveflash2.red /tmp/raveaeka2.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" | grep Results; done; done\n"]
