[373.367333, "i", "echo '--- directives ---'; grep -nE 'org|end|launch|comp|F_stst|F_st|stst' /tmp/flashfirst2.red | head -40; echo '--- head ---'; sed -n '1,18p' /tmp/flashfirst2.red; echo '--- tail ---'; tail -20 /tmp/flashfirst2.red; echo '--- test ---'; pmars -b -r 1 -f /tmp/flashfirst2.red warriors/stone.red\n"]
[373.371175, "o", "echo '--- directives ---'; grep -nE 'org|end|launch|comp|F_stst|F_st|stst' /tmp/flashfirst2.red | head -40; echo '--- head ---'; sed -n '1,18p' /tmp/flashfirst2.red; echo '--- tail ---'; tail -20 /tmp/flashfirst2.red; echo '--- test ---'; pmars -b -r 1 -f /tmp/flashfirst2.red warriors/stone.red"]
[373.3722, "o", "\r\n\u001b[?2004l\r"]
[373.372989, "o", "--- directives ---\r\n"]
[373.41451, "o", "10:scan    sub.f  incr,comp\r\n11:comp    cmp.i  FIRST,FIRST-CDIST        ;larger number is A\r\n12:        slt.a  #incr-comp+BOMBLEN,comp  ;compare to A-number\r\n15:split   mov.i  bomb,>comp               ;post-increment\r\n17:        sub.ab #BOMBLEN,comp\r\n22:\tend\r\n42:      spl F_stst,<-2050\r\n66:F_stst  spl F_st,<-2030\r\n67:      spl F_st,<750\r\n68:      spl F_st,<-2630\r\n69:      spl F_st,<-4533\r\n70:      spl F_st,<-1153\r\n71:      spl F_st,<-453\r\n72:F_st    spl 0,0\r\n77:      end\r\n102:A_stone_dst   mov.i   -2,#A_stone_end+1-A_stone_offst     ;\\ notice how these ptrs\r\n103:A_stone_dst2  mov.i   -1,#A_stone_end+1-(A_stone_offst-1) ;/ are conviently erased\r\n104:            spl     <0,#A_imp_vector               ;\\ decrement self to launch\r\n105:A_stone_src   djn.a   @(A_imp_vector-1),#A_stone_end+1 ;/ imps, B-fld before A-fld\r\n108:            add.f   A_stone_end+1,A_stone\r\n110:A_stone_end   mov.i   A_stone_inc,<-A_stone_inc\r\n124:            end\r\n125:org launch\r\n126:launch spl F_stst\r\n127:       spl F_stst\r\n128:       jmp comp\r\n129:end launch\r\n"]
[373.417073, "o", "--- head ---\r\n"]
[373.483706, "o", ";redcode-94\r\n;name Hybrid Test\r\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\nCDIST   equ 12\r\nIVAL    equ 42\r\nFIRST   equ scan+OFFSET+IVAL\r\nOFFSET  equ (2*IVAL)\r\nDJNOFF  equ -431\r\nBOMBLEN equ CDIST+2\r\nscan    sub.f  incr,comp\r\n"]
[373.48396, "o", "comp    cmp.i  FIRST,FIRST-CDIST        ;larger number is A\r\n        slt.a  #incr-comp+BOMBLEN,comp  ;compare to A-number\r\n        djn.f  scan,<FIRST+DJNOFF       ;decrement A- and B-number\r\n        mov.ab #BOMBLEN,count\r\nsplit   mov.i  bomb,>comp               ;post-increment\r\ncount   djn.b  split,#0\r\n        sub.ab #BOMBLEN,comp\r\n        jmn.b  scan,scan\r\n"]
[373.485598, "o", "--- tail ---\r\n"]
[373.502216, "o", "A_stone_end   mov.i   A_stone_inc,<-A_stone_inc\r\nA_cnt         for     65\r\n            dat     0,0\r\n            rof\r\nA_imp_2       mov.i   #(A_imp_sz02/2),A_imp_sz02\r\nA_imp_3       mov.i   #(A_imp_sz03/2),A_imp_sz03\r\nA_imp_A_fld   equ     A_imp_first+(imp_prc&A_who+1-2*A_cnt)*imp_sz&A_who+imp_off&A_who\r\nA_imp_B_fld   equ     A_imp_first+(imp_prc&A_who+0-2*A_cnt)*imp_sz&A_who+imp_off&A_who\r\nA_who         for     3\r\nA_cnt         for     (imp_prc&A_who)/2\r\n            jmp     A_imp_A_fld,A_imp_B_fld\r\n            rof\r\n            rof\r\nA_imp_vector\r\n            end\r\norg launch\r\nlaunch spl F_stst\r\n       spl F_stst\r\n       jmp comp\r\nend launch\r\n"]
[373.503629, "o", "--- test ---\r\n"]
[373.521623, "o", "Hybrid Test by Anonymous scores 0\r\n"]
[373.52214, "o", "Stone by mzvince (Everything2) scores 3\r\nResults: 0 1 0\r\n"]
[373.523463, "o", "\u001b[?2004hroot@726f19086eb9:/app# "]
