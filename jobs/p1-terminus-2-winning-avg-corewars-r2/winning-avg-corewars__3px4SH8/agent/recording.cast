[2139.069453, "o", " if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\r\n\u001b[?2004l\r\u001b[?2004h>  body.append(x)\r\n\u001b[?2004l\r\u001b[?2004h> ci=next(i for i,x in enumerate(body) if x.strip().startswith('comp '))\r\n\u001b[?2004l\r\u001b[?2004h> original=body[ci]\r\n\u001b[?2004l\r\u001b[?2004h> for inc in [1,2,3,4,6,8,10,12,16,20,24,28,32,40]:\r\n\u001b[?2004l\r\u001b[?2004h>  for off in [50,100,150,200,300,500,700,1000]:\r\n\u001b[?2004l\r\u001b[?2004h>   b=body[:ci]+['comp    spl     bomber',original]+body[ci+1:]\r\n\u001b[?2004l\r\u001b[?2004h>   b += [f'bomber  add     #{inc}, bptr','        mov     bdat, @bptr','        jmp     bomber','bdat    dat     0, 0',f'bptr    dat     {off}, 0']\r\n\u001b[?2004l\r\u001b[?2004h>   Path(f'/tmp/z_{inc}_{off}.red').write_text(';redcode-94\\n;name Rave Bomber\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg comp\\n'+'\\n'.join(b)+'\\nend\\n')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
