[1168.817591, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nlines=[]\nfor line in src:\n    z=line.strip().lower()\n    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '):\n        continue\n    lines.append(line)\nsymbols=['CDIST','IVAL','FIRST','OFFSET','DJNOFF','BOMBLEN','scan','comp','incr','count','split','bomb']\ndef make(prefix,ival,cdist):\n    s='\\n'.join(lines)\n    for name in symbols:\n        s=re.sub(r'(?<![A-Za-z0-9_])'+name+r'(?![A-Za-z0-9_])',prefix+name,s)\n    s=re.sub(r'(?m)^'+prefix+'CDIST\\s+equ\\s+\\d+',f'{prefix}CDIST   equ {cdist}',s)\n    s=re.sub(r'(?m)^'+prefix+'IVAL\\s+equ\\s+\\d+',f'{prefix}IVAL    equ {ival}',s)\n    return s\ntext=''';redcode-94\n;name Dual Rave Tuned\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\norg launch\nlaunch   spl     S_comp\n         jmp     N_comp\n'''+make('S_',24,20)+'\\n'+make('N_',42,12)+'\\nend launch\\n'\nPath('/tmp/dual_rave.red').write_text(text)\nPY\npmars -b -r 1 -f /tmp/dual_rave.red warriors/stone.red\n"]
