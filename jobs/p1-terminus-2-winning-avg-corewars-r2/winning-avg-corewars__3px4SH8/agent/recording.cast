[1867.208991, "i", "python3 - <<'PY'\nimport glob,subprocess,re, multiprocessing as mp\nfiles=glob.glob('/tmp/x_*.red')\ndef one(w):\n vals=[]\n for o in ('stone','snake'):\n  try:\n   z=subprocess.run(['pmars','-b','-r','10','-f',w,'warriors/'+o+'.red'],capture_output=True,text=True,timeout=8).stdout\n   m=re.search(r'Results:\\s+(\\d+)',z); vals.append(int(m.group(1)) if m else 0)\n  except Exception: vals.append(0)\n return (sum(vals),min(vals),vals[0],vals[1],w)\nwith mp.Pool(32) as p:\n out=list(p.imap_unordered(one,files,chunksize=4))\nfor x in sorted(out,reverse=True)[:30]: print(*x)\nPY\n"]
[1867.221024, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
