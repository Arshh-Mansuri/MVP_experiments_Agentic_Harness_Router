[29.577373, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Sweep Bomber\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n\nstep    equ 17\n\nstart   spl     1\n        spl     1\n        jmp     scan\n\nscan    cmp     0, step\n        add     #step, scan\n        jmp     scan\n        mov     bomb, @scan\n        mov     bomb, *scan\n        jmp     scan\nbomb    dat     0, 0\n\n        end     start\nEOF\nfor o in stone vampire paper snake g2-clear; do echo \"=== $o ===\"; pmars -b -r 100 -f my_warrior.red \"warriors/$o.red\"; done\n"]
