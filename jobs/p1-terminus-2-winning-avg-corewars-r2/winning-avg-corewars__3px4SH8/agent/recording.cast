[97.454022, "i", "cat > /tmp/scanhybrid.red <<'EOF'\n;redcode-94\n;name Scanner Paper Imp\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     scan\n        spl     paper\n        jmp     impstart\nscan    add     #17, ptr\n        cmp     0, @ptr\n        jmp     scan\n        mov     bomb, @ptr\n        mov     bomb, *ptr\n        jmp     scan\nptr     dat     300, 0\nbomb    dat     0, 0\npaper   spl     1\n        spl     1\nploop   mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     ploop\ncopy    spl     0, 0\np       dat     2667, 5334\nimpstart mov     imp, 4000\n        spl     impgo\n        jmp     impgo\nimpgo   mov     0, 2667\nimp     mov     0, 2667\n        end start\nEOF\ncat > /tmp/scanpaper.red <<'EOF'\n;redcode-94\n;name Scanner Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     scan\n        spl     paper\n        jmp     paper\nscan    add     #17, ptr\n        cmp     0, @ptr\n        jmp     scan\n        mov     bomb, @ptr\n        mov     bomb, *ptr\n        jmp     scan\nptr     dat     300, 0\nbomb    dat     0, 0\npaper   spl     1\n        spl     1\nploop   mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     ploop\ncopy    spl     0, 0\np       dat     2667, 5334\n        end start\nEOF\ncat > /tmp/scanimp.red <<'EOF'\n;redcode-94\n;name Scanner Imp\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     scan\n        spl     impstart\n        jmp     impstart\nscan    add     #17, ptr\n        cmp     0, @ptr\n        jmp     scan\n        mov     bomb, @ptr\n        mov     bomb, *ptr\n        jmp     scan\nptr     dat     300, 0\nbomb    dat     0, 0\nimpstart mov     imp, 4000\n        spl     impgo\n        jmp     impgo\nimpgo   mov     0, 2667\nimp     mov     0, 2667\n        end start\nEOF\nfor w in /tmp/scanhybrid.red /tmp/scanpaper.red /tmp/scanimp.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" | grep Results; done; done\n"]
