[335.92068, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor old,new in [('flashfirst','flashfirst2'),('flashmany','flashmany2'),('ravemany','ravemany2'),('aekarave','aekarave2')]:\n    s=Path('/tmp/'+old+'.red').read_text()\n    s=s.replace('launch spl', 'org launch\\nlaunch spl', 1)\n    Path('/tmp/'+new+'.red').write_text(s)\nPY\nfor w in /tmp/flashfirst2.red /tmp/flashmany2.red /tmp/ravemany2.red /tmp/aekarave2.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" 2>/dev/null | grep Results; done; done\n"]
