[299.680519, "o", "ars=ns(clean(a),['start','imp_sz01','imp_sz02','imp_sz03','imp_prc01','imp_prc02','imp_prc03','imp_off01','imp_off02','imp_off03','imp_first','stone_inc','stone_offst','dec_offst','imp_split','stone_dst','stone_dst2','stone_src','stone','stone_spl','stone_end','cnt','imp_A_fld','imp_B_fld','who','imp_vector','imp_2','imp_3'],'A_')\r\n\u001b[?2004l\r\u001b[?2004h> rs=clean(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[299.680719, "o", "base=''';redcode-94\\n;name Hybrid Test\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\n'''+rs+'\\n'+fs+'\\n'+ars+'\\n'\r\n\u001b[?2004l\r\u001b[?2004h> variants={\r\n\u001b[?2004l\r"]
[299.680773, "o", "\u001b[?2004h> "]
[299.681029, "o", "'flashfirst':'launch spl F_stst\\n       spl F_stst\\n       jmp comp\\n',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[299.681178, "o", "'flashmany':'launch spl F_stst\\n       spl F_stst\\n       spl F_stst\\n       spl F_stst\\n       jmp comp\\n',\r\n\u001b[?2004l\r\u001b[?2004h> 'ravemany':'launch spl comp\\n       spl comp\\n       spl comp\\n       jmp F_stst\\n',\r\n\u001b[?2004l\r\u001b[?2004h> "]
