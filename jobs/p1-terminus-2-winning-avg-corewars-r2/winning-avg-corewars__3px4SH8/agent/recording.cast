[696.374826, "i", "python3 - <<'PY'\nfrom pathlib import Path\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nbody=[]\nfor x in r:\n    z=x.strip().lower()\n    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue\n    body.append(x)\nidx=next(i for i,x in enumerate(body) if x.strip().startswith('scan '))\nfor inc in [8,12,16,20,24,28,32]:\n  for off in [50,100,150,200,300,500]:\n    e=f'''        spl     bomber\nbomber  add     #{inc}, bptr\n        mov     bdat, @bptr\n        mov     bdat, *bptr\n        jmp     bomber\nbdat    dat     0, 0\nbptr    dat     {off}, 0\n'''\n    p=Path(f'/tmp/t_{inc}_{off}.red')\n    p.write_text(';redcode-94\\n;name tuned\\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\\norg comp\\n'+'\\n'.join(body[:idx]+[e]+body[idx:])+'\\nend\\n')\nPY\nfor w in /tmp/t_*.red; do x=$(pmars -b -r 100 -f \"$w\" warriors/stone.red 2>/dev/null | awk '/Results:/{print $2}'); echo \"$x $w\"; done | sort -nr | head -12\n"]
