[124.157309, "i", "cat > /tmp/correctscan.red <<'EOF'\n;redcode-94\n;name Correct Scanner Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     scan\n        spl     paper\n        jmp     paper\nscan    add     #17, ptr\n        cmp     0, *ptr\n        jmp     scan\n        mov     bomb, *ptr\n        mov     bomb, @ptr\n        jmp     scan\nptr     dat     300, 0\nbomb    dat     0, 0\npaper   spl     1\n        spl     1\nploop   mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     ploop\ncopy    spl     0, 0\np       dat     2667, 5334\n        end start\nEOF\ncat > /tmp/correctscan2.red <<'EOF'\n;redcode-94\n;name Dual Scanner Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart   spl     scan1\n        spl     scan2\n        jmp     paper\nscan1   add     #4, p1\n        cmp     0, *p1\n        jmp     scan1\n        mov     bomb, *p1\n        mov     bomb, @p1\n        jmp     scan1\np1      dat     400, 0\nscan2   add     #17, p2\n        cmp     0, *p2\n        jmp     scan2\n        mov     bomb, *p2\n        mov     bomb, @p2\n        jmp     scan2\np2      dat     500, 0\nbomb    dat     0, 0\npaper   spl     1\n        spl     1\nploop   mov     copy, *p\n        add     #1, p\n        mov     copy, @p\n        add     #2667, p\n        jmp     ploop\ncopy    spl     0, 0\np       dat     2667, 5334\n        end start\nEOF\nfor w in /tmp/correctscan.red /tmp/correctscan2.red; do echo \"######## $w\"; for o in stone vampire paper snake g2-clear; do printf '%-8s ' \"$o\"; pmars -b -r 100 -f \"$w\" \"warriors/$o.red\" | grep Results; done; done\n"]
