[394.287934, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nr=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\nf=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text().splitlines()\ndef clean(lines):\n    out=[]\n    for x in lines:\n        z=x.strip().lower()\n        if not z or z.startswith(';') or z.startswith('org') or z == 'end' or z.startswith('end '):\n            continue\n        out.append(x)\n    return '\\n'.join(out)\nrs=clean(r)\nfs=clean(f)\nlabels=['s01','s02','s03','s04','s05','s06','s07','s08','s09','m01','m02','m03','m04','m05','m06','m07','m08','m09','mark','mark0','paper','stst','st']\nfor x in labels:\n    fs=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])','F_'+x,fs)\ntext=''';redcode-94\n;name Rave Flash Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\norg launch\nlaunch   spl     F_stst\n         spl     F_stst\n         jmp     comp\n'''+rs+'\\n'+fs+'\\nend launch\\n'\nPath('/tmp/raveflash_fixed.red').write_text(text)\nPY\nprintf '%s\\n' '--- directives ---'; grep -nE '^\\s*(org|end)' /tmp/raveflash_fixed.red; pmars -b -r 1 -f /tmp/raveflash_fixed.red warriors/stone.red\n"]
[394.289833, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[394.29104, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[394.295573, "o", "r=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> f=Path('/app/pmars-0.9.4/warriors/flashpaper.red').read_text().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> def clean(lines):\r\n\u001b[?2004l\r\u001b[?2004h>     out=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for x in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         z=x.strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h>         if not z or z.startswith(';') or z.startswith('org') or z == 'end' or z.startswith('end '):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         out.append(x)\r\n\u001b[?2004l\r\u001b[?2004h>     return '\\n'.join(out)\r\n\u001b[?2004l\r\u001b[?2004h> rs=clean(r)\r\n\u001b[?2004l\r\u001b[?2004h> fs=clean(f)\r\n\u001b[?2004l\r\u001b[?2004h> labels=['s01','s02','s03','s04','s05','s06','s07','s08','s09','m01','m02','m03','m04','m05','m06','m07','m08','m09','mark','mark0','paper','stst','st']\r\n\u001b[?2004l\r\u001b[?2004h> for x in labels:\r\n\u001b[?2004l\r\u001b[?2004h>     fs=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])','F_'+x,fs)\r\n\u001b[?2004l\r\u001b[?2004h> text=''';redcode-94\r\n\u001b[?2004l\r\u001b[?2004h> ;name Rave Flash Hybrid\r\n\u001b[?2004l\r\u001b[?2004h> ;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\n\u001b[?2004l\r\u001b[?2004h> org launch\r\n\u001b[?2004l\r\u001b[?2004h> launch   spl     F_stst\r\n\u001b[?2004l\r\u001b[?2004h>          spl     F_stst\r\n\u001b[?2004l\r\u001b[?2004h>          jmp     comp\r\n\u001b[?2004l\r\u001b[?2004h> '''+rs+'\\n'+fs+'\\nend launch\\n'\r\n\u001b[?2004l\r\u001b[?2004h> Path('/tmp/raveflash_fixed.red').write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
