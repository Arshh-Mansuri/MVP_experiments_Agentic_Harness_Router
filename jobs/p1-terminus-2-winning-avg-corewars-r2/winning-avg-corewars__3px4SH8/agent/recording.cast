[2838.704037, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nsrc=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\nfor dj in range(-450,-249):\n s=re.sub(r'(?m)^CDIST\\s+equ\\s+\\d+', 'CDIST   equ 12', src)\n s=re.sub(r'(?m)^IVAL\\s+equ\\s+\\d+', 'IVAL    equ 84', s)\n s=re.sub(r'(?m)^DJNOFF\\s+equ\\s+-?\\d+', f'DJNOFF  equ {dj}', s)\n Path(f'/tmp/q_{abs(dj)}.red').write_text(s)\nPY\nfind /tmp -maxdepth 1 -name 'q_*.red' -print0 | xargs -0 -n1 -P16 sh -c 'w=\"$1\"; a=$(pmars -b -r 20 -f \"$w\" warriors/stone.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); b=$(pmars -b -r 20 -f \"$w\" warriors/snake.red 2>/dev/null | awk \"/Results:/{print \\$2}\"); echo \"$((a+b)) $((a<b?a:b)) $a $b $w\"' sh | sort -nr | head -20\n"]
[2838.713892, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> src=Path('/app/pmars-0.9.4/warriors/rave.red').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> for dj in range(-450,-249):\r\n\u001b[?2004l\r"]
