--- head ---
;redcode-94
;name Hybrid Test
;assert CORESIZE == 8000 && MAXCYCLES == 80000
CDIST   equ 12
IVAL    equ 42
FIRST   equ scan+OFFSET+IVAL
OFFSET  equ (2*IVAL)
DJNOFF  equ -431
BOMBLEN equ CDIST+2
scan    sub.f  incr,comp
comp    cmp.i  FIRST,FIRST-CDIST        ;larger number is A
        slt.a  #incr-comp+BOMBLEN,comp  ;compare to A-number
        djn.f  scan,<FIRST+DJNOFF       ;decrement A- and B-number
        mov.ab #BOMBLEN,count
split   mov.i  bomb,>comp               ;post-increment
count   djn.b  split,#0
        sub.ab #BOMBLEN,comp
        jmn.b  scan,scan
--- tail ---
A_stone_end   mov.i   A_stone_inc,<-A_stone_inc
A_cnt         for     65
            dat     0,0
            rof
A_imp_2       mov.i   #(A_imp_sz02/2),A_imp_sz02
A_imp_3       mov.i   #(A_imp_sz03/2),A_imp_sz03
A_imp_A_fld   equ     A_imp_first+(imp_prc&A_who+1-2*A_cnt)*imp_sz&A_who+imp_off&A_who
A_imp_B_fld   equ     A_imp_first+(imp_prc&A_who+0-2*A_cnt)*imp_sz&A_who+imp_off&A_who
A_who         for     3
A_cnt         for     (imp_prc&A_who)/2
            jmp     A_imp_A_fld,A_imp_B_fld
            rof
            rof
A_imp_vector
            end
org launch
launch spl F_stst
       spl F_stst
       jmp comp
end launch
--- test ---
Hybrid Test by Anonymous scores 0
