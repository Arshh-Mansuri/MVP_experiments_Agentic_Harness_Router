103:A_stone_dst2  mov.i   -1,#A_stone_end+1-(A_stone_offst-1) ;/ are conviently erased
104:            spl     <0,#A_imp_vector               ;\ decrement self to launch
105:A_stone_src   djn.a   @(A_imp_vector-1),#A_stone_end+1 ;/ imps, B-fld before A-fld
108:            add.f   A_stone_end+1,A_stone
