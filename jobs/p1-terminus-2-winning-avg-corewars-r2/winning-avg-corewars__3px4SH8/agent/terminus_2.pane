[?2004lpython3 - <<'PY'
from pathlib import Path
import re
src=Path('/app/pmars-0.9.4/warriors/rave.red').read_text().splitlines()
# Keep executable and macro lines, remove metadata and end/org directives.
lines=[]
for x in src:
    z=x.strip().lower()
    if not z or z.startswith(';') or z.startswith('org') or z=='end' or z.startswith('end '): continue
    lines.append(x)
# Symbols appearing in Rave source, including labels and EQU names.
symbols=['CDIST','IVAL','FIRST','OFFSET','DJNOFF','BOMBLEN','scan','comp','incr','count','split','bomb']
def copy(prefix,ival,cdist):
    s='\n'.join(lines)
    for x in symbols:
        s=re.sub(r'(?<![A-Za-z0-9_])'+x+r'(?![A-Za-z0-9_])',prefix+x,s)
    s=re.sub(r'(?m)^'+prefix+'CDIST\s+equ\s+\d+',f'{prefix}CDIST   equ {cdist}',s)
    s=re.sub(r'(?m)^'+prefix+'IVAL\s+equ\s+\d+',f'{prefix}IVAL    equ {ival}',s)
    return s
one=copy('S_',24,20)
two=copy('N_',42,12)
text=''';redcode-94
;name Dual Rave Tuned
;assert CORESIZE == 8000 && MAXCYCLES == 80000
org launch
launch   spl     S_comp
         jmp     N_comp
'''+one+'\n'+two+'\nend launch\n'
Path('/tmp/dual_rave.red').write_text(text)
PY
pmars -b -r 1 -f /tmp/dual_rave.red warriors/stone.red
for o in stone vampire paper snake g2-clear; do echo "=== $o ==="; pmars -b -r 100 -f /tmp/dual_rave.red "warriors/$o.red" | grep Results; done
C-c
printf 'READY\n'; test -s /tmp/dual_rave.red && echo dual-file-present || echo dual-file-missing
if test -s /tmp/dual_rave.red; then pmars -b -r 1 -f /tmp/dual_rave.red warriors/stone.red; else echo 'candidate was not created'; fi
^C
printf 'READY\n'; ls -l /tmp/dual_rave.red my_warrior.red 2>/dev/null
^CC-c

