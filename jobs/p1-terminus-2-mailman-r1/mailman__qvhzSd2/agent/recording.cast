[54.192086, "i", "echo '=== mailman.cfg ==='; cat /etc/mailman3/mailman.cfg; echo '=== postfix ==='; postconf -n; echo '=== processes ==='; ps auxww | grep -E '[m]ailman|[p]ostfix'; echo '=== init scripts ==='; ls -l /etc/init.d/postfix /etc/init.d/mailman* 2>/dev/null || true; echo '=== mailman root queries ==='; mailman --run-as-root info 2>&1 || true; mailman --run-as-root lists 2>&1 || true; echo '=== mailman help ==='; mailman --help 2>&1 | head -100\n"]
