rayObject *weights_array, *cov_array;\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\n                          &PyArray_Type, &cov_array))\n        return NULL;\n\n    if (PyArray_NDIM(weights_array) != 1 || PyArray_NDIM(cov_array) != 2) {\n        PyErr_SetString(PyExc_ValueError, "weights must be 1D and covariance must be 2D");\n        return NULL;\n    }\n    npy_intp n = PyArray_DIM(weights_array, 0);\n    if (PyArray_DIM(cov_array, 0) != n || PyArray_DIM(cov_array, 1) != n) {\n        PyErr_SetString(PyExc_ValueError, "dimensions do not match");\n        return NULL;\n    }\n    if (PyArray_TYPE(weights_array) != NPY_DOUBLE ||\n        PyArray_TYPE(cov_array) != NPY_DOUBLE ||\n        !PyArray_ISC contiguous(weights_array) || !PyArray_ISC contiguous(cov_array)) {\n        PyErr_SetString(PyExc_TypeError, "arrays must be contiguous float64 arrays");\n        return NULL;\n    }\n\n    const double *weights = (const double *)PyArray_DATA(weights_array);\n    const double *cov = (const double *)PyArray_DATA(cov_array);\n    double risk_squared = 0.0;\n    for (npy_intp i = 0; i < n; ++i) {\n        const double *row = cov + i * n;\n        double row_sum = 0.0;\n        for (npy_intp j = 0; j < n; ++j)\n            row_sum += row[j] * weights[j];\n        risk_squared += weights[i] * row_sum;\n    }\n    return PyFloat_FromDouble(sqrt(risk_squared));\n}\n\nstatic PyObject *portfolio_return_c(PyObject *self, PyObject *args) {\n    PyArrayObject *weights_array, *returns_array;\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\n                          &PyArray_Type, &returns_array))\n        return NULL;\n\n    if (PyArray_NDIM(weights_array) != 1 || PyArray_NDIM(returns_array) != 1 ||\n        PyArray_DIM(weights_array, 0) != PyArray_DIM(returns_array, 0)) {\n        PyErr_SetString(PyExc_ValueError, "weights and returns must be matching 1D arrays");\n        return NULL;\n    }\n    if (PyArray_TYPE(weights_array) 