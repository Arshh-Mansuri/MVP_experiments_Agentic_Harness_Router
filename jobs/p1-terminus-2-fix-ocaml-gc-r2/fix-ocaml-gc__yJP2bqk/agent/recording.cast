[11.994875, "o", "* local, pool** plist,\r\nruntime/shared_heap.c:587:        /* add to freelist. This could be optimised, we don't need\r\nruntime/shared_heap.c:637:            the pool (which indicates the start of the freelist) */\r\nruntime/shared_heap.c:647:            freelist */\r\nruntime/shared_heap.c:678:static intnat large_alloc_sweep(struct caml_heap_state* local) {\r\nruntime/shared_heap.c:730:intnat caml_sweep(struct caml_heap_state* local, intnat work) {\r\nruntime/shared_heap.c:732:  while (work > 0 && local->next_to_sweep < NUM_SIZECLASSES) {\r\nruntime/shared_heap.c:733:    sizeclass sz = local->next_to_sweep;\r\nruntime/shared_heap.c:734:    intnat full_sweep_work = 0;\r\nruntime/shared_heap.c:735:    intnat avail_sweep_work =\r\nruntime/shared_heap.c:736:      pool_sweep(local, &local->unswept_avail_pools[sz], sz, 1);\r\nruntime/shared_heap.c:737:    work -= avail_sweep_work;\r\nruntime/shared_heap.c:740:      full_sweep_work = pool_sweep(local,\r\nruntime/shared_heap.c:744:      work -= full_sweep_work;\r\nruntime/shared_heap.c:747:    if(full_sweep_work+avail_sweep_work == 0) {\r\nruntime/shared_heap.c:748:      local->next_to_sweep++;\r\nruntime/shared_heap.c:754:    work -= large_alloc_sweep(local);\r\nruntime/shared_heap.c:758:    /* sweeping is complete, check everything worked */\r\nruntime/shared_heap.c:841:/* Heap and freelist stats */\r\nruntime/shared_heap.c:844:   You need to hold the [pool_freelist] lock. */\r\nruntime/shared_heap.c:846:  caml_accum_heap_stats(&pool_freelist.stats, &heap->stats);\r\nruntime/shared_heap.c:852:   You need to hold the [pool_freelist] lock. */\r\nruntime/shared_heap.c:860:    caml_remove_heap_stats(&pool_freelist.stats, &pool_stats);\r\nruntime/shared_heap.c:864:   You need to hold the [pool_freelist] lock. */\r\nruntime/shared_heap.c:866:  caml_accum_heap_stats(&adopter->stats, &pool_freelist.stats);\r\nruntime/shared_heap.c:867:  memset(&pool_freelist.stats, 0, sizeof(pool_freelist.stats));\r\nruntime/shared_heap.c:880:  caml_plat_lock_blocking(&pool_freelist.lock);\r\nruntime/shared_heap.c:881:  caml_accum_heap_stats(acc, &pool_freelist.stats);\r\nruntime/shared_heap.c:882:  caml_plat_unlock(&pool_freelist.lock);\r\nruntime/shared_heap.c:1181:        one pool in the freelist.\r\nruntime/shared_heap.c:1182:    4. One domain needs to release the pools in the freelist back to the OS.\r\nruntime/shared_heap.c:1202:    /* No sweeping has happened yet */\r\nruntime/shared_heap.c:1209:          atomic_load_relaxed(&pool_freelist.global_avail_pools[sz_class]) ==\r\nruntime/shared_heap.c:1212:          atomic_load_relaxed(&pool_freelist.global_full_pools[sz_class]) ==\r\nruntime/shared_heap.c:1265:       exact amount of space needed or even sweep all pools in this counting\r\nruntime/shared_heap.c:1305:    /* Note that partially filled pools must have at least some free space*/\r\nruntime/shared_heap.c:1411:            /* We are implicitly sweeping pools in the evacuation set and thus\r\nruntime/shared_heap.c:1520:  /* Fourth phase: one domain also needs to release the free list */\r\nruntime/shared_heap.c:1525:    caml_plat_lock_blocking(&pool_freelist.lock);\r\nruntime/shared_heap.c:1526:    cur_pool = pool_freelist.free;\r\nruntime/shared_heap.c:1535:    pool_freelist.free = NULL;\r\nruntime/shared_heap.c:1537:    caml_plat_unlock(&pool_freelist.lock);\r\nruntime/shared_heap.c:1610:  /* sweeping should be done by this point */\r\nruntime/shared_heap.c:1611:  CAMLassert(local->next_to_sweep == NUM_SIZECLASSES);\r\nruntime/shared_heap.c:1671:void caml_finalise_freelist(void) {\r\nruntime/shared_heap.c:1674:  caml_plat_lock_blocking(&pool_freelist.lock);\r\nruntime/shared_heap.c:1675:  while (pool_freelist.global_large) {\r\nruntime/shared_heap.c:1676:    large_alloc* a = pool_freelist.global_large;\r\nruntime/shared_heap.c:1677:    pool_freelist.global_large = a->next;\r\nruntime/shared_heap.c:1681:  caml_plat_unlock(&pool_freelist.lock);\r\nruntime/shared_heap.c:1682: 