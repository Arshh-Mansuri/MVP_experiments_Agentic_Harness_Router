[11.984422, "o", "ne;\r\nruntime/major_gc.c:1809:  intnat sweep_work = 0, mark_work = 0;\r\nruntime/major_gc.c:1839:  if (!domain_state->sweeping_done) {\r\nruntime/major_gc.c:1842:    while (!domain_state->sweeping_done &&\r\nruntime/major_gc.c:1844:      intnat left = caml_sweep(domain_state->shared_heap, budget);\r\nruntime/major_gc.c:1847:      sweep_work += work_done;\r\nruntime/major_gc.c:1850:        domain_state->sweeping_done = 1;\r\nruntime/major_gc.c:1851:        (void)caml_atomic_counter_decr(&num_domains_to_sweep);\r\nruntime/major_gc.c:1886:    if (caml_gc_phase == Phase_sweep_ephe &&\r\nruntime/major_gc.c:1900:    if (caml_gc_phase != Phase_sweep_ephe) {\r\nruntime/major_gc.c:1938:    if (caml_gc_phase == Phase_sweep_ephe) {\r\nruntime/major_gc.c:1941:      if (domain_state->ephe_info->must_sweep_ephe) {\r\nruntime/major_gc.c:1946:        domain_state->ephe_info->must_sweep_ephe = 0;\r\nruntime/major_gc.c:1957:        /* If the todo list is empty, then the ephemeron has no sweeping work\r\nruntime/major_gc.c:1960:          (void)caml_atomic_counter_decr(&num_domains_to_ephe_sweep);\r\nruntime/major_gc.c:1965:        CAMLassert (domain_state->ephe_info->must_sweep_ephe == 0);\r\nruntime/major_gc.c:1971:          intnat left = ephe_sweep (domain_state, budget);\r\nruntime/major_gc.c:1978:          (void)caml_atomic_counter_decr(&num_domains_to_ephe_sweep);\r\nruntime/major_gc.c:1984:    if (is_complete_phase_sweep_and_mark_main() ||\r\nruntime/major_gc.c:1986:      CAMLassert (caml_gc_phase != Phase_sweep_ephe);\r\nruntime/major_gc.c:2003:  caml_gc_log(\"Major slice [%c%c%c]: %\" CAML_PRIdNAT \" sweep, \"\r\nruntime/major_gc.c:2008:              sweep_work, mark_work,\r\nruntime/major_gc.c:2011:  if (mode != Slice_opportunistic && is_complete_phase_sweep_ephe()) {\r\nruntime/major_gc.c:2153:void caml_finish_sweeping (void)\r\nruntime/major_gc.c:2155:  if (Caml_state->sweeping_done) return;\r\nruntime/major_gc.c:2157:  while (!Caml_state->sweeping_done) {\r\nruntime/major_gc.c:2158:    if (caml_sweep(Caml_state->shared_heap, 10) > 0) {\r\nruntime/major_gc.c:2159:      /* just finished sweeping */\r\nruntime/major_gc.c:2160:      CAMLassert(Caml_state->sweeping_done == 0);\r\nruntime/major_gc.c:2161:      Caml_state->sweeping_done = 1;\r\nruntime/major_gc.c:2162:      (void)caml_atomic_counter_decr(&num_domains_to_sweep);\r\nruntime/major_gc.c:2188:  /* Fresh domains do not need to performing marking or sweeping. */\r\nruntime/major_gc.c:2189:  d->sweeping_done = 1;\r\nruntime/startup_aux.c:199:    caml_finalise_freelist();\r\nruntime/gc_ctrl.c:350:  caml_gc_phase = Phase_sweep_and_mark_main;\r\nruntime/domain.c:830:     - Heap stats are moved to the free list on domain termination,\r\nruntime/domain.c:2130:static bool marking_and_sweeping_done(caml_domain_state *domain_state)\r\nruntime/domain.c:2133:          && domain_state->sweeping_done);\r\nruntime/domain.c:2152:    caml_finish_sweeping();\r\nruntime/domain.c:2167:       sweeping work, so we may need to mark and/or sweep again. */\r\nruntime/domain.c:2175:    /* If new marking or sweeping work appeared during orphaning,\r\nruntime/domain.c:2177:    if (!marking_and_sweeping_done(domain_state))\r\nruntime/domain.c:2181:       This is only valid when [sweeping_done], and does\r\nruntime/domain.c:2184:    CAMLassert(marking_and_sweeping_done(domain_state));\r\nruntime/domain.c:2193:       sweep for the next cycle. If a STW section has been started, it will\r\nruntime/domain.c:2195:       GC cycle. This would then require finish marking and sweeping again in\r\nruntime/domain.c:2197:       [num_domains_to_sweep] (see major_gc.c). We do this by running a new\r\nruntime/caml/shared_heap.h:106:intnat caml_sweep(struct caml_heap_state*, intnat);\r\nruntime/caml/shared_heap.h:124:void caml_finalise_freelist(void);\r\nruntime/caml/misc.h:715:  01 -> fields of free list blocks in major heap\r\nruntime/caml/fiber.h:41: *  - handling a freelist of OCaml stacks in a stack_cache\r\nruntime/caml/major_gc.h:22:  Phase_sweep_and_mark_main,\r\nruntime/caml/major_gc.h:24:  Phase_sweep_ephe\r\nruntime/caml/major_gc.h:36:void caml_finish_sweeping(void);\r\nruntime/caml/config.h:211:   the dead objects "]
