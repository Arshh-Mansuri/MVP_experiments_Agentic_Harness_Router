[285.800662, "o", "ap.c:1118:      if (!POOL_BLOCK_FREE_HP(p)) {\r\nruntime/shared_heap.c:1274:      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\nruntime/shared_heap.c:1275:      header_t* end = POOL_END(cur_pool);\r\nruntime/shared_heap.c:1276:      mlsize_t wh = wsize_sizeclass[sz_class];\r\nruntime/shared_heap.c:1284:        if (POOL_BLOCK_FREE_HD(h)) {\r\nruntime/shared_heap.c:1354:      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\nruntime/shared_heap.c:1355:      header_t* end = POOL_END(cur_pool);\r\nruntime/shared_heap.c:1356:      mlsize_t wh = wsize_sizeclass[sz_class];\r\nruntime/shared_heap.c:1361:        if (!POOL_BLOCK_FREE_HD(hd)) {\r\nruntime/shared_heap.c:1371:            value* new_p = to_pool->next_obj;\r\nruntime/shared_heap.c:1372:            CAMLassert(POOL_BLOCK_FREE_HP(new_p));\r\nruntime/shared_heap.c:1380:                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\nruntime/shared_heap.c:1383:              CAMLassert((header_t*)next <= POOL_END(to_pool));\r\nruntime/shared_heap.c:1385:              *next = POOL_FREE_HEADER(wosize - 1);\r\nruntime/shared_heap.c:1387:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1390:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1507:    for (header_t *p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\nruntime/shared_heap.c:1508:         p < POOL_END(cur_pool); p++) {\r\nruntime/shared_heap.c:1560:  for (value *v = a->next_obj; v; v = (value*)v[1]) {\r\nruntime/shared_heap.c:1561:    CAMLassert(POOL_BLOCK_FREE_HP(v));\r\nruntime/shared_heap.c:1565:    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\nruntime/shared_heap.c:1566:    header_t* end = POOL_END(a);\r\nruntime/shared_heap.c:1567:    mlsize_t wh = wsize_sizeclass[sz];\r\nruntime/shared_heap.c:1577:        POOL_BLOCK_FREE_HD(hd) ||\r\nruntime/shared_heap.c:1580:      if (!POOL_BLOCK_FREE_HD(hd)) {\r\nruntime/shared_heap.c:1618:      CAMLassert(p->next_obj == NULL);\r\n"]
