[?2004hroot@fda099c4896d:/app/ocaml# cd /app/ocaml; printf '%s\n' '--- shared_heap sweep implementation ---'; sed -n '500,790p' runtime/shared_heap.c; printf '%s\n' '--- pool/free-list declarations ---'; grep -RInE 'typedef.*pool|struct pool|free.*run|run.*free|RUN|freelist' runtime/*.h runtime/*.c | head -240; printf '%s\n' '--- runtime build artifacts ---'; ls -l boot/ocamlrun boot/*.cm* 2>&1 | head -80; printf '%s\n' '--- configure/build markers ---'; ls -l config/Makefile.config Makefile.config 2>&1
