[71.471213, "o", "# Deterministic ordering, since hidden neurons may be permuted.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.47135, "o", "keys = tuple(A1[:, j] for j in range(D - 1, -1, -1))\r\n\u001b[?2004l\r\u001b[?2004h> A1 = A1[np.lexsort(keys)]\r\n\u001b[?2004l\r\u001b[?2004h> np.save('/app/stolen_A1.npy', A1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.4715, "o", "print('saved /app/stolen_A1.npy with shape', A1.shape)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[71.491951, "o", "\u001b[?2004hroot@abfcd1825246:/app# python3 /app/steal.py\r\n\u001b[?2004l\r"]
[74.475901, "o", "saved /app/stolen_A1.npy with shape (20, 10)\r\n"]
[74.509297, "o", "\u001b[?2004hroot@abfcd1825246:/app# "]
[74.509499, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[74.509677, "o", "\u001b[?2004h> x = np.load('/app/stolen_A1.npy')\r\n\u001b[?2004l\r\u001b[?2004h> print('verified:', x.shape, x.dtype, bool(np.isfinite(x).all()))\r\n\u001b[?2004l\r"]
[74.50973, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[75.155991, "o", "verified: (20, 10) float64 True\r\n"]
