source] is not None), None)\n    merged.append(result)\n\noutput = pd.DataFrame(merged, columns=['user_id', 'name', 'email', 'created_date', 'status'])\noutput['user_id'] = output['user_id'].astype('int64')\nfor col in ['name', 'email', 'created_date', 'status']:\n    output[col] = output[col].astype('string')\noutput.to_parquet(OUT_PARQUET, engine='pyarrow', index=False)\nOUT_CONFLICTS.write_text(json.dumps({\n    'total_conflicts': len(conflicts),\n    'conflicts': conflicts,\n}, indent=2) + '\\n')\nprint(f'wrote {len(output)} users and {len(conflicts)} conflicts')\nPY\npython3 /app/merge_users.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
