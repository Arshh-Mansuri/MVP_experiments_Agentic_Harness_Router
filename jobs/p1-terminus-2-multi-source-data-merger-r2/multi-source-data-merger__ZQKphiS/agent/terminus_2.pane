import json
from pathlib import Path
import pandas as pd

p = '/app/merged_users.parquet'
c = '/app/conflicts.json'
df = pd.read_parquet(p)
report = json.loads(Path(c).read_text())
print('parquet shape:', df.shape)
print('parquet dtypes:')
print(df.dtypes.to_string())
print('rows:')
print(df.to_string(index=False))
print('conflict count:', report['total_conflicts'], 'listed:', len(report['conflicts']))
assert report['total_conflicts'] == len(report['conflicts'])
assert df['user_id'].dtype == 'int64'
assert df['user_id'].is_unique
assert all(df['created_date'].dropna().str.fullmatch(r'\d{4}-\d{2}-\d{2}'))
print('validation: OK')
PY
ls -lh /app/merged_users.parquet /app/conflicts.json && cat /app/conflicts.json
wrote 4 users and 3 conflicts
