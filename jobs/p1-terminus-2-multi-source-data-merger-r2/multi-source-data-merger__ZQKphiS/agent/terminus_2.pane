import json
from pathlib import Path
import pandas as pd

parquet = '/app/merged_users.parquet'
conflicts_file = '/app/conflicts.json'
df = pd.read_parquet(parquet)
report = json.loads(Path(conflicts_file).read_text())
print('shape:', df.shape)
print('columns:', list(df.columns))
print('dtypes:\n' + df.dtypes.to_string())
print(df.to_string(index=False))
print('conflicts:', report['total_conflicts'], 'listed:', len(report['conflicts']))
assert list(df.columns) == ['user_id', 'name', 'email', 'created_date', 'status']
assert str(df['user_id'].dtype) == 'int64'
assert df['user_id'].is_unique
assert report['total_conflicts'] == len(report['conflicts'])
assert all(df['created_date'].dropna().str.fullmatch(r'\d{4}-\d{2}-\d{2}'))
print('validation: OK')
PY
ls -lh /app/merged_users.parquet /app/conflicts.json && cat /app/conflicts.json
