[32.719209, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\nimport pandas as pd\n\np = '/app/merged_users.parquet'\nc = '/app/conflicts.json'\ndf = pd.read_parquet(p)\nreport = json.loads(Path(c).read_text())\nprint('parquet shape:', df.shape)\nprint('parquet dtypes:')\nprint(df.dtypes.to_string())\nprint('rows:')\nprint(df.to_string(index=False))\nprint('conflict count:', report['total_conflicts'], 'listed:', len(report['conflicts']))\nassert report['total_conflicts'] == len(report['conflicts'])\nassert df['user_id'].dtype == 'int64'\nassert df['user_id'].is_unique\nassert all(df['created_date'].dropna().str.fullmatch(r'\\d{4}-\\d{2}-\\d{2}'))\nprint('validation: OK')\nPY\n"]
