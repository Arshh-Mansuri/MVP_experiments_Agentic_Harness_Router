[30.551446, "i", "cat > /app/merge_users.py <<'PY'\nimport json\nfrom datetime import datetime\nfrom pathlib import Path\n\nimport pandas as pd\n\nOUT_PARQUET = Path('/app/merged_users.parquet')\nOUT_CONFLICTS = Path('/app/conflicts.json')\nSOURCES = ['source_a', 'source_b', 'source_c']\n\n\ndef missing(value):\n    if value is None:\n        return True\n    try:\n        return bool(pd.isna(value))\n    except (TypeError, ValueError):\n        return False\n\n\ndef clean_text(value):\n    if missing(value):\n        return None\n    value = str(value).strip()\n    return value if value else None\n\n\ndef normalize_date(value):\n    value = clean_text(value)\n    if value is None:\n        return None\n    parsed = pd.to_datetime(value, errors='coerce')\n    if pd.isna(parsed):\n        raise ValueError(f'Invalid date: {value!r}')\n    return parsed.strftime('%Y-%m-%d')\n\n\ndef normalize_status(value):\n    if missing(value):\n        return None\n    if isinstance(value, bool):\n        return 'active' if value else 'inactive'\n    text = str(value).strip().lower()\n    if text in {'true', '1', 'yes', 'y', 'active'}:\n        return 'active'\n    if text in {'false', '0', 'no', 'n', 'inactive'}:\n        return 'inactive'\n    return text\n\n\ndef read_source(name):\n    if name == 'source_a':\n        rows = json.loads(Path('/data/source_a/users.json').read_text())\n        frame = pd.DataFrame(rows)\n        mapping = {'id': 'user_id', 'full_name': 'name', 'email': 'email',\n                   'registration_date': 'created_date', 'status': 'status'}\n    elif name == 'source_b':\n        frame = pd.read_csv('/data/source_b/users.csv')\n        mapping = {'user_id': 'user_id', 'name': 'name', 'email_address': 'email',\n                   'created_at': 'created_date', 'is_active': 'status'}\n    else:\n        frame = pd.read_parquet('/data/source_c/users.parquet')\n        mapping = {'userId': 'user_id', 'userName': 'name', 'email': 'email',\n                   'joined': 'created_date', 'active': 'status'}\n    frame = frame.rename(columns=mapping)\n    for col in ['user_id', 'name', 'email', 'created_date', 'status']:\n        if col not in frame.columns:\n            frame[col] = None\n    normalized = []\n    for _, row in frame.iterrows():\n        uid = row['user_id']\n        if missing(uid):\n            continue\n        uid = int(uid)\n        normalized.append({\n            'user_id': uid,\n            'name': clean_text(row['name']),\n            'email': clean_text(row['email']),\n            'created_date': normalize_date(row['created_date']),\n            'status': normalize_status(row['status']),\n        })\n    return normalized\n\n\nrecords_by_source = {source: read_source(source) for source in SOURCES}\nby_user = {}\nfor source in SOURCES:\n    for record in records_by_source[source]:\n        by_user.setdefault(record['user_id'], {})[source] = record\n\nfields = ['name', 'email', 'created_date', 'status']\nmerged = []\nconflicts = []\n\nfor user_id in sorted(by_user):\n    source_records = by_user[user_id]\n    result = {'user_id': user_id}\n    for field in fields:\n        values = {source: source_records[source].get(field)\n                  for source in SOURCES if source in source_records}\n        distinct = set(values.values()) - {None}\n        if len(distinct) > 1:\n            report_values = {source: values[source] for source in SOURCES\n                             if source in values and values[source] is not None}\n            selected = next((values[source] for source in SOURCES\n                             if source in values and values[source] is not None), None)\n            conflicts.append({\n                'user_id': user_id,\n                'field': field,\n                'values': report_values,\n                'selected': selected,\n            })\n        result[field] = next((values[source] for source in SOURCES\n                              if source in values and values[source] is not None), None)\n    merged.append(result)\n\noutput = pd.DataFrame(merged, columns=['user_id', 'name', 'email', 'created_date', 'status'])\noutput['user_id'] = output['user_id'].astype('int64')\nfor col in ['name', 'e"]
[30.553099, "i", "mail', 'created_date', 'status']:\n    output[col] = output[col].astype('string')\noutput.to_parquet(OUT_PARQUET, engine='pyarrow', index=False)\nOUT_CONFLICTS.write_text(json.dumps({\n    'total_conflicts': len(conflicts),\n    'conflicts': conflicts,\n}, indent=2) + '\\n')\nprint(f'wrote {len(output)} users and {len(conflicts)} conflicts')\nPY\npython3 /app/merge_users.py\n"]
