[43.301357, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\nimport pandas as pd\n\nparquet = '/app/merged_users.parquet'\nconflicts_file = '/app/conflicts.json'\ndf = pd.read_parquet(parquet)\nreport = json.loads(Path(conflicts_file).read_text())\nprint('shape:', df.shape)\nprint('columns:', list(df.columns))\nprint('dtypes:\\n' + df.dtypes.to_string())\nprint(df.to_string(index=False))\nprint('conflicts:', report['total_conflicts'], 'listed:', len(report['conflicts']))\nassert list(df.columns) == ['user_id', 'name', 'email', 'created_date', 'status']\nassert str(df['user_id'].dtype) == 'int64'\nassert df['user_id'].is_unique\nassert report['total_conflicts'] == len(report['conflicts'])\nassert all(df['created_date'].dropna().str.fullmatch(r'\\d{4}-\\d{2}-\\d{2}'))\nprint('validation: OK')\nPY\n"]
[43.302222, "o", "python3 - <<'PY'\r\nimport json\r\nfrom pathlib import Path\r\nimport pandas as pd\r\n\r\nparquet = '/app/merged_users.parquet'\r\nconflicts_file = '/app/conflicts.json'\r\ndf = pd.read_parquet(parquet)\r\nreport = json.loads(Path(conflicts_file).read_text())\r\nprint('shape:', df.shape)\r\nprint('columns:', list(df.columns))\r\nprint('dtypes:\\n' + df.dtypes.to_string())\r\nprint(df.to_string(index=False))\r\nprint('conflicts:', report['total_conflicts'], 'listed:', len(report['conflicts']))\r\nassert list(df.columns) == ['user_id', 'name', 'email', 'created_date', 'status']\r\nassert str(df['user_id'].dtype) == 'int64'\r\nassert df['user_id'].is_unique\r\nassert report['total_conflicts'] == len(report['conflicts'])\r\nassert all(df['created_date'].dropna().str.fullmatch(r'\\d{4}-\\d{2}-\\d{2}'))\r\nprint('validation: OK')\r\nPY\r\n"]
