python3 /tmp/render.py
[?2004h> import struct,zlib
[?2004l[?2004h> b=open('/app/code.png','rb').read(); pos=8; dat=b''
[?2004l[?2004h> while pos<len(b):
[?2004l[?2004h>  n=struct.unpack('>I',b[pos:pos+4])[0]; t=b[pos+4:pos+8]; x=b[pos+8:pos+8+n]
[?2004l[?2004h>  if t==b'IHDR': w,h,bd,ct,_,_,_=struct.unpack('>IIBBBBB',x)
[?2004l[?2004h>  if t==b'IDAT': dat+=x
[?2004l[?2004h>  pos+=12+n
[?2004l[?2004h> raw=zlib.decompress(dat); bpp=4; stride=w*bpp; rows=[]; prev=bytearray(stride); q=0
[?2004l[?2004h> for y in range(h):
[?2004l[?2004h>  f=raw[q]; q+=1; cur=bytearray(raw[q:q+stride]); q+=stride
[?2004l[?2004h>  for i in range(stride):
[?2004l[?2004h>   a=cur[i-bpp] if i>=bpp else 0; u=prev[i]; ul=prev[i-bpp] if i>=bpp else 0
[?2004l[?2004h>   if f==1: cur[i]=(cur[i]+a)&255
[?2004l[?2004h>   elif f==2: cur[i]=(cur[i]+u)&255
[?2004l[?2004h>   elif f==3: cur[i]=(cur[i]+(a+u)//2)&255
[?2004l[?2004h>   elif f==4:
[?2004l[?2004h>    p=a+u-ul; pa=abs(p-a); pb=abs(p-u); pc=abs(p-ul); pr=a if pa<=pb and pa<=pc else (u if pb<=pc else ul); cur[i]=(cur[i]+pr)&255
[?2004l[?2004h>  rows.append(cur); prev=cur
[?2004l[?2004h> # composite on white, calculate darkness
[?2004l[?2004h> D=[]
[?2004l[?2004h> for row in rows:
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for x in range(w):
[?2004l[?2004h>   r,g,bl,a=row[4*x:4*x+4]; vals.append(255-((r*a+255*(255-a))//255 + (g*a+255*(255-a))//255 + (bl*a+255*(255-a))//255)//3)
[?2004l[?2004h>  D.append(vals)
[?2004l[?2004h> ys=[y for y in range(h) if max(D[y])>20]; xs=[x for y in ys for x in range(w) if D[y][x]>20]
[?2004l[?2004h> print(w,h,'bbox',min(xs),min(ys),max(xs),max(ys))
[?2004l[?2004h> x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys)
[?2004l[?2004h> # output at original vertical resolution, horizontal 2:1; use block max darkness
[?2004l[?2004h> for y in range(y0,y1+1):
[?2004l[?2004h>  s=''
[?2004l[?2004h>  for x in range(x0,x1+1,2):
[?2004l[?2004h>   v=max(D[y][x:min(x+2,x1+1)])
[?2004l[?2004h>   s += '##' if v>160 else ('++' if v>80 else ('..' if v>25 else '  '))
[?2004l[?2004h>  print(s.rstrip())
[?2004l[?2004h> PY
