[?2004hroot@c0f1865bbd63:/app# cat > /tmp/render.py <<'PY'
[?2004l255*(255-a))//255)//3)
 D.append(vals)
ys=[y for y in range(h) if max(D[y])>20]; xs=[x for y in ys for x in range(w) if D[y][x]>20]
print(w,h,'bbox',min(xs),min(ys),max(xs),max(ys))
x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys)
# output at original vertical resolution, horizontal 2:1; use block max darkness
for y in range(y0,y1+1):
 s=''
 for x in range(x0,x1+1,2):
  v=max(D[y][x:min(x+2,x1+1)])
  s += '##' if v>160 else ('++' if v>80 else ('..' if v>25 else '  '))
 print(s.rstrip())
