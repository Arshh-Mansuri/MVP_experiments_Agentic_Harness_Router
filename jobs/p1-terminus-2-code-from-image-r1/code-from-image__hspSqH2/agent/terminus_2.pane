python3 - <<'PY'
import hashlib,itertools
b=open('/app/code.png','rb').read(); h=hashlib.sha256(b).digest()
# likely salts and likely composition forms
salts=[b'0000TBENCH-SALT',b'00000TBENCH-SALT',b'0000T-BENCH-SALT',b'0000TBENCH_SALT',b'0000TBENCH-SALT',b'0x0000TBENCH-SALT',b'\x00\x00\x00\x00TBENCH-SALT',b'B0000TBENCH-SALT',b'6_0000TBENCH-SALT']
parts=[h,h[:10],h.hex().encode(),h[:10].hex().encode()]
for s in salts:
 for x in [h+h[:10]+s,h+s+h[:10],h[:10]+h+s,h.hex().encode()+h[:10]+s]:
  d=hashlib.sha256(x).hexdigest()
  if d.startswith('bee26a'): print('MATCH',repr(s),d)
  print(repr(s),d)
PY
