[?2004lpython3 - <<'PY'
p=open('/tmp/code.ppm','rb').read(); q=p.index(b'\n',p.index(b'\n',p.index(b'\n')+1)+1)+1; w,h=1160,804; z=p[q:]; g=[(z[i]+z[i+1]+z[i+2])//3 for i in range(0,len(z),3)]
# render selected bands 0-2 at 2x2 blocks
c=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]; bs=[]; y=0
while y<h:
 while y<h and c[y]<=2:y+=1
 if y>=h:break
 a=y
 while y<h and c[y]>2:y+=1
 bs.append((a,y-1))
for bi in range(min(3,len(bs))):
 a,b=bs[bi]; pts=[x for y in range(a,b+1) for x in range(w) if g[y*w+x]<210]; x0=max(0,min(pts)-3); x1=min(w-1,max(pts)+3)
 print('\nBAND',bi,a,b,x0,x1)
 for yy in range(a,b+1,2):
  s=''
  for xx in range(x0,x1+1,2):
   n=sum(g[y*w+x]<210 for y in range(yy,min(yy+2,b+1)) for x in range(xx,min(xx+2,x1+1)))
   s += '█' if n>=3 else ('▀' if n else ' ')
  print(s.rstrip())
PY
