[40.470047, "o", "\u001b[?2004hroot@c0f1865bbd63:/app# "]
[43.288266, "i", "cat >> /tmp/render.py <<'PY'\n# write composited opaque PPM for OCR\nwith open('/tmp/code.ppm','wb') as f:\n f.write(('P6\\n%d %d\\n255\\n'%(w,h)).encode())\n for y in range(h):\n  for x in range(w):\n   r,g,bl,a=rows[y][4*x:4*x+4]\n   f.write(bytes(((r*a+255*(255-a))//255,(g*a+255*(255-a))//255,(bl*a+255*(255-a))//255)))\nPY\npython3 /tmp/render.py >/dev/null\nfor psm in 3 6 11 12; do echo \"--- PSM $psm ---\"; tesseract /tmp/code.ppm stdout --psm $psm 2>/dev/null; done\n"]
[43.2905, "o", "cat >> /tmp/render.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.290628, "o", "> # write composited opaque PPM for OCR\r\n\u001b[?2004l\r"]
[43.29095, "o", "\u001b[?2004h> with open('/tmp/code.ppm','wb') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.291198, "o", "> "]
[43.291276, "o", " f.write(('P6\\n%d %d\\n255\\n'%(w,h)).encode())\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(h):\r\n\u001b[?2004l\r"]
[43.291522, "o", "\u001b[?2004h> "]
[43.291573, "o", "  for x in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>    r,g,bl,a=rows[y][4*x:4*x+4]\r\n\u001b[?2004l\r"]
[43.291851, "o", "\u001b[?2004h> "]
