[165.919229, "i", "python3 - <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1; w,h=1160,804; z=p[q:]; g=[(z[i]+z[i+1]+z[i+2])//3 for i in range(0,len(z),3)]\nc=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]; bands=[]; y=0\nwhile y<h:\n while y<h and c[y]<=2:y+=1\n if y>=h:break\n a=y\n while y<h and c[y]>2:y+=1\n bands.append((a,y-1))\nprint(bands)\nPY\n"]
[165.922628, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1; w,h=1160,804; z=p[q:]; g=[(z[i]+z[i+1]+z[i+2])//3 for i in range(0,len(z),3)]\r\n\u001b[?2004l\r\u001b[?2004h> c=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]; bands=[]; y=0\r\n\u001b[?2004l\r\u001b[?2004h> while y<h:\r\n\u001b[?2004l\r\u001b[?2004h>  while y<h and c[y]<=2:y+=1\r\n\u001b[?2004l\r\u001b[?2004h>  if y>=h:break\r\n\u001b[?2004l\r"]
[165.922905, "o", "\u001b[?2004h>  a=y\r\n\u001b[?2004l\r\u001b[?2004h>  while y<h and c[y]>2:y+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.925711, "o", " bands.append((a,y-1))\r\n\u001b[?2004l\r\u001b[?2004h> print(bands)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[166.478633, "i", "python3 - <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1; w,h=1160,804; z=p[q:]; g=[(z[i]+z[i+1]+z[i+2])//3 for i in range(0,len(z),3)]\n# render selected bands 0-2 at 2x2 blocks\nc=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]; bs=[]; y=0\nwhile y<h:\n while y<h and c[y]<=2:y+=1\n if y>=h:break\n a=y\n while y<h and c[y]>2:y+=1\n bs.append((a,y-1))\nfor bi in range(min(3,len(bs))):\n a,b=bs[bi]; pts=[x for y in range(a,b+1) for x in range(w) if g[y*w+x]<210]; x0=max(0,min(pts)-3); x1=min(w-1,max(pts)+3)\n print('\\nBAND',bi,a,b,x0,x1)\n for yy in range(a,b+1,2):\n  s=''\n  for xx in range(x0,x1+1,2):\n   n=sum(g[y*w+x]<210 for y in range(yy,min(yy+2,b+1)) for x in range(xx,min(xx+2,x1+1)))\n   s += '█' if n>=3 else ('▀' if n else ' ')\n  print(s.rstrip())\nPY\n"]
[166.47946, "o", "python3 - <<'PY'\r\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1; w,h=1160,804; z=p[q:]; g=[(z[i]+z[i+1]+z[i+2])//3 for i in range(0,len(z),3)]\r\n# render selected bands 0-2 at 2x2 blocks\r\nc=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]; bs=[]; y=0\r\nwhile y<h:\r\n while y<h and c[y]<=2:y+=1\r\n if y>=h:break\r\n a=y\r\n while y<h and c[y]>2:y+=1\r\n bs.append((a,y-1))\r\nfor bi in range(min(3,len(bs))):\r\n a,b=bs[bi]; pts=[x for y in range(a,b+1) for x in range(w) if g[y*w+x]<210]; x0=max(0,min(pts)-3); x1=min(w-1,max(pts)+3)\r\n print('\\nBAND',bi,a,b,x0,x1)\r\n for yy in range(a,b+1,2):\r\n  s=''\r\n  for xx in range(x0,x1+1,2):\r\n   n=sum(g[y*w+x]<210 for y in range(yy,min(yy+2,b+1)) for x in range(xx,min(xx+2,x1+1)))\r\n   s += '█' if n>=3 else ('▀' if n else ' ')\r\n  print(s.rstrip())\r\nPY\r\n"]
