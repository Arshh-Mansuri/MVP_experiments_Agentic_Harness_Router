[250.457451, "i", "python3 - <<'PY'\nimport hashlib,itertools\nb=open('/app/code.png','rb').read(); h=hashlib.sha256(b).digest()\n# likely salts and likely composition forms\nsalts=[b'0000TBENCH-SALT',b'00000TBENCH-SALT',b'0000T-BENCH-SALT',b'0000TBENCH_SALT',b'0000TBENCH-SALT',b'0x0000TBENCH-SALT',b'\\x00\\x00\\x00\\x00TBENCH-SALT',b'B0000TBENCH-SALT',b'6_0000TBENCH-SALT']\nparts=[h,h[:10],h.hex().encode(),h[:10].hex().encode()]\nfor s in salts:\n for x in [h+h[:10]+s,h+s+h[:10],h[:10]+h+s,h.hex().encode()+h[:10]+s]:\n  d=hashlib.sha256(x).hexdigest()\n  if d.startswith('bee26a'): print('MATCH',repr(s),d)\n  print(repr(s),d)\nPY\n"]
[250.457848, "o", "python3 - <<'PY'\r\nimport hashlib,itertools\r\nb=open('/app/code.png','rb').read(); h=hashlib.sha256(b).digest()\r\n# likely salts and likely composition forms\r\nsalts=[b'0000TBENCH-SALT',b'00000TBENCH-SALT',b'0000T-BENCH-SALT',b'0000TBENCH_SALT',b'0000TBENCH-SALT',b'0x0000TBENCH-SALT',b'\\x00\\x00\\x00\\x00TBENCH-SALT',b'B0000TBENCH-SALT',b'6_0000TBENCH-SALT']\r\nparts=[h,h[:10],h.hex().encode(),h[:10].hex().encode()]\r\nfor s in salts:\r\n for x in [h+h[:10]+s,h+s+h[:10],h[:10]+h+s,h.hex().encode()+h[:10]+s]:\r\n  d=hashlib.sha256(x).hexdigest()\r\n  if d.startswith('bee26a'): print('MATCH',repr(s),d)\r\n  print(repr(s),d)\r\nPY\r\n"]
