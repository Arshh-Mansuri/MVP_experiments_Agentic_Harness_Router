[83.94788, "i", "python3 - <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.rfind(b'\\n',0,30)+1; w,h=1160,804; pix=p[q:]; g=[(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\n# high contrast grayscale PGM, dark foreground\nwith open('/tmp/contrast.pgm','wb') as f:\n f.write(('P5\\n%d %d\\n255\\n'%(w,h)).encode())\n f.write(bytes(0 if v<220 else 255 for v in g))\nPY\nfor p in 3 4 6 11 12 13; do echo ---$p; tesseract /tmp/contrast.pgm stdout --psm $p 2>/dev/null; done\n"]
