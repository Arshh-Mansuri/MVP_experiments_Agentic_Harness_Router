[64.298647, "i", "python3 - <<'PY'\nimport struct\np=open('/tmp/code.ppm','rb').read(); print(p[:30],len(p))\n# parse header\nq=0\nparts=[]\nwhile len(parts)<4:\n if p[q:q+1]==b'#': q=p.index(b'\\n',q)+1; continue\n e=q\n while p[e:e+1] not in (b' ',b'\\n',b'\\r',b'\\t'): e+=1\n parts.append(p[q:e]); q=e+1\nprint(parts, 'pixel bytes',len(p)-q)\nvals=p[q:]\nprint('min max avg',min(vals),max(vals),sum(vals)/len(vals))\nPY\n"]
[64.299974, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[64.302744, "o", "\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> p=open('/tmp/code.ppm','rb').read(); print(p[:30],len(p))\r\n\u001b[?2004l\r\u001b[?2004h> # parse header\r\n\u001b[?2004l\r\u001b[?2004h> q=0\r\n\u001b[?2004l\r\u001b[?2004h> parts=[]\r\n\u001b[?2004l\r\u001b[?2004h> while len(parts)<4:\r\n\u001b[?2004l\r\u001b[?2004h>  if p[q:q+1]==b'#': q=p.index(b'\\n',q)+1; continue\r\n\u001b[?2004l\r\u001b[?2004h>  e=q\r\n\u001b[?2004l\r\u001b[?2004h>  while p[e:e+1] not in (b' ',b'\\n',b'\\r',b'\\t'): e+=1\r\n\u001b[?2004l\r\u001b[?2004h>  parts.append(p[q:e]); q=e+1\r\n\u001b[?2004l\r\u001b[?2004h> print(parts, 'pixel bytes',len(p)-q)\r\n\u001b[?2004l\r\u001b[?2004h> vals=p[q:]\r\n\u001b[?2004l\r\u001b[?2004h> print('min max avg',min(vals),max(vals),sum(vals)/len(vals))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
