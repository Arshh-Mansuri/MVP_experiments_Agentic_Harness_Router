[99.681442, "i", "cat > /tmp/crop.py <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1\nw,h=1160,804; pix=p[q:]; g=[(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\npts=[(i%w,i//w) for i,v in enumerate(g) if v<230]\nprint('points',len(pts))\nx0=max(0,min(x for x,y in pts)-10); x1=min(w-1,max(x for x,y in pts)+10); y0=max(0,min(y for x,y in pts)-10); y1=min(h-1,max(y for x,y in pts)+10)\nprint('bbox',x0,y0,x1,y1)\nfor th in (180,220,240):\n name='/tmp/crop%d.pgm'%th; W=(x1-x0+1)*3; H=(y1-y0+1)*3\n with open(name,'wb') as f:\n  f.write(('P5\\n%d %d\\n255\\n'%(W,H)).encode())\n  row=bytes(0 if g[y*w+x]<th else 255 for x in range(x0,x1+1))\n  for _ in range(3):\n   for b in row:f.write(bytes((b,))*3)\nPY\npython3 /tmp/crop.py\nfor f in /tmp/crop*.pgm; do echo ==== $f; for p in 3 4 6 11 12 13; do tesseract \"$f\" stdout --psm $p 2>/dev/null; done; done\n"]
[99.68313, "o", "cat > /tmp/crop.py <<'PY'\r\n\u001b[?2004l\r"]
