[151.905392, "i", "cat > /tmp/lines.py <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1\nw,h=1160,804; pix=p[q:]; g=[(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\n# dark pixel count by row, ignore faint antialiasing\ncnt=[sum(g[y*w+x]<210 for x in range(w)) for y in range(h)]\nactive=[c>2 for c in cnt]; bands=[]; y=0\nwhile y<h:\n while y<h and not active[y]: y+=1\n if y>=h: break\n a=y\n while y<h and active[y]: y+=1\n bands.append((a,y-1))\nprint('bands',bands)\nfor bi,(a,b) in enumerate(bands):\n xs=[x for y in range(a,b+1) for x in range(w) if g[y*w+x]<210]\n if not xs: continue\n x0=max(0,min(xs)-3); x1=min(w-1,max(xs)+3)\n print('\\n=== BAND',bi,'bbox',x0,a,x1,b,'===')\n # 3x3 blocks: density threshold, preserve strokes\n for yy in range(a,b+1,3):\n  s=''\n  for xx in range(x0,x1+1,2):\n   n=0; total=0\n   for y in range(yy,min(yy+3,b+1)):\n    for x in range(xx,min(xx+2,x1+1)):\n     total+=1; n += g[y*w+x]<210\n   s += '█' if n>=total*.55 else ('▓' if n>=total*.25 else ('░' if "]
