[81.916978, "i", "python3 - <<'PY'\np=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1\nw,h=1160,804; pix=p[q:]; g=[(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\nfor threshold in [50,100,150,200,230,245]:\n pts=[(i%w,i//w) for i,v in enumerate(g) if v<threshold]\n print(threshold, len(pts), (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else None)\n# compact crop using 8x8 blocks, max darkness\npts=[(i%w,i//w) for i,v in enumerate(g) if v<220]; x0=min(x for x,y in pts); x1=max(x for x,y in pts); y0=min(y for x,y in pts); y1=max(y for x,y in pts)\nprint('CROP',x0,y0,x1,y1)\nchars=' .:-=+*#%@'\nfor yy in range(y0,y1+1,8):\n s=''\n for xx in range(x0,x1+1,4):\n  vals=g[y*w+x] for y in range(yy,min(yy+8,y1+1)) for x in range(xx,min(xx+4,x1+1))\n  d=255-min(vals); s+=chars[min(9,d*10//256)]\n print(s.rstrip())\nPY\n"]
[81.920372, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p=open('/tmp/code.ppm','rb').read(); q=p.index(b'\\n',p.index(b'\\n',p.index(b'\\n')+1)+1)+1\r\n\u001b[?2004l\r\u001b[?2004h> w,h=1160,804; pix=p[q:]; g=[(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\r\n\u001b[?2004l\r\u001b[?2004h> for threshold in [50,100,150,200,230,245]:\r\n\u001b[?2004l\r\u001b[?2004h>  pts=[(i%w,i//w) for i,v in enumerate(g) if v<threshold]\r\n\u001b[?2004l\r\u001b[?2004h>  print(threshold, len(pts), (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else None)"]
