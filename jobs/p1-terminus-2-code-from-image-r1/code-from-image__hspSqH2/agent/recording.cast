[64.765956, "i", "python3 - <<'PY'\n# Convert PPM to grayscale binary PBMs, with 2x scale\np=open('/tmp/code.ppm','rb').read(); q=0; toks=[]\nwhile len(toks)<4:\n if p[q:q+1] in b' \\n\\r\\t': q+=1; continue\n e=q\n while p[e:e+1] not in b' \\n\\r\\t': e+=1\n toks.append(p[q:e]); q=e+1\nw,h=int(toks[1]),int(toks[2]); pix=p[q:]\ng=[]\nfor i in range(0,len(pix),3): g.append(sum(pix[i:i+3])//3)\nfor name,inv in [('dark',False),('light',True)]:\n with open('/tmp/'+name+'.pbm','wb') as f:\n  f.write(('P4\\n%d %d\\n'%(w*2,h*2)).encode())\n  for y in range(h):\n   bits=[]\n   for x in range(w):\n    v=g[y*w+x]<200\n    if inv:v=not v\n    bits += [v,v]\n   row=bytearray((len(bits)+7)//8)\n   for i,v in enumerate(bits):\n    if v: row[i//8]|=128>>(i%8)\n   f.write(row); f.write(row)\nPY\nfor f in /tmp/dark.pbm /tmp/light.pbm; do echo ===$f===; for p in 3 6 11 12 13; do tesseract \"$f\" stdout --psm $p 2>/dev/null; done; done\n"]
