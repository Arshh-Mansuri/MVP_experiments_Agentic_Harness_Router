[259.731304, "i", "cat > /tmp/test.py <<'PY'\nimport hashlib,itertools\nb=open('/app/code.png','rb').read(); h=hashlib.sha256(b).digest()\nsalts=[\n b'0000TBENCH-SALT', b'00000TBENCH-SALT', b'0000T-BENCH-SALT',\n b'0000TBENCH_SALT', b'0000TBENCH-SALT', b'0x0000TBENCH-SALT',\n b'\\x00\\x00\\x00\\x00TBENCH-SALT', b'B0000TBENCH-SALT',\n b'6_0000TBENCH-SALT', b'60000TBENCH-SALT', b'0000T-BENCH_SALT'\n]\nforms=[]\nfor s in salts:\n forms += [(repr(s),h+h[:10]+s),(repr(s),h+s+h[:10]),(repr(s),h[:10]+h+s)]\n forms += [(repr(s)+' hex',h.hex().encode()+h[:10]+s),(repr(s)+' allhex',h.hex().encode()+h[:10].hex().encode()+s)]\nfor label,x in forms:\n d=hashlib.sha256(x).hexdigest()\n if d.startswith('bee26a'):\n  print('MATCH',label,d); open('/app/output.txt','w').write(d+'\\n')\nprint('h0',h.hex())\nPY\npython3 /tmp/test.py\n[ -f /app/output.txt ] && { echo RESULT; cat /app/output.txt; }\n"]
