[?2004hroot@4ff057301633:/app# cat > /tmp/braille.py <<'PY'
[?2004l[?2004h> import re,math
[?2004l[?2004h> bl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\d+(?:\.\d*)?|\.\d+)'; x=y=z=None; P=[]
[?2004l[?2004h> for s in bl:
[?2004l[?2004h>  if not s.startswith(('G0 ','G1 ')): continue
[?2004l[?2004h>  v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)
[?2004l[?2004h>  if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3)<.01 and abs(oz-3)<.01 and (x!=ox or y!=oy): P.append((ox,oy,x,y))
[?2004l[?2004h> def dot(a,b): return a
[?2004l[?2004h> for deg in [0,-45,45,90]:
[?2004l[?2004h>  t=math.radians(deg); co,si=math.cos(t),math.sin(t); Q=[(a*co-b*si,a*si+b*co,c*co-d*si,c*si+d*co) for a,b,c,d in P]
[?2004l[?2004h>  x0=min(min(a,c) for a,b,c,d in Q); x1=max(max(a,c) for a,b,c,d in Q); y0=min(min(b,d) for a,b,c,d in Q); y1=max(max(b,d) for a,b,c,d in Q)
[?2004l[?2004h>  # 2 pixels/mm x, 4 pixels/mm y then braille 2x4
[?2004l[?2004h>  Sx=5; Sy=5; W=int((x1-x0)*Sx)+3; H=int((y1-y0)*Sy)+3; A=[[0]*W for _ in range(H)]
[?2004l[?2004h>  for a,b,c,d in Q:
[?2004l[?2004h>   n=max(2,int(max(abs(c-a)*Sx,abs(d-b)*Sy)*4))
[?2004l[?2004h>   for i in range(n+1):
[?2004l[?2004h>    u=i/n; xx=round((a+(c-a)*u-x0)*Sx); yy=round((b+(d-b)*u-y0)*Sy)
[?2004l[?2004h>    for dx in range(-1,2):
[?2004l[?2004h>     for dy in range(-1,2):
[?2004l[?2004h>      if 0<=xx+dx<W and 0<=yy+dy<H:A[H-1-(yy+dy)][xx+dx]=1
[?2004l[?2004h>  print('\nANGLE',deg)
[?2004l[?2004h>  # braille dot indices: (0,1,2,6) left/right mapping
[?2004l[?2004h>  mp={(0,0):1,(0,1):2,(0,2):4,(1,0):8,(1,1):16,(1,2):32,(0,3):64,(1,3):128}
[?2004l[?2004h>  for yy in range(0,H,4):
[?2004l[?2004h>   row=''
[?2004l[?2004h>   for xx in range(0,W,2):
[?2004l[?2004h>    n=0
[?2004l[?2004h>    for dx in range(2):
[?2004l[?2004h>     for dy in range(4):
[?2004l[?2004h>      if yy+dy<H and xx+dx<W and A[yy+dy][xx+dx]: n+=mp[(dx,dy)]
[?2004l[?2004h>    row+=chr(0x2800+n) if n else ' '
[?2004l[?2004h>   print(row.rstrip())
[?2004l[?2004h> PY
