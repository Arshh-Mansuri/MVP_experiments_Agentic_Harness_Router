[?2004hroot@4ff057301633:/app# cat > /tmp/analyze.py <<'PY'
[?2004lpts))))
# combine all text paths; rasterize at 1 mm/cell, print y reversed
allr=[q for r in regions for q in r]
if allr:
    xmin=min(min(a,c) for a,b,c,d in allr); xmax=max(max(a,c) for a,b,c,d in allr)
    ymin=min(min(b,d) for a,b,c,d in allr); ymax=max(max(b,d) for a,b,c,d in allr)
    W=int(xmax-xmin)+2; H=int(ymax-ymin)+2
    grid=[[' ']*W for _ in range(H)]
    for a,b,c,d in allr:
      n=max(abs(c-a),abs(d-b))*4+1
      for j in range(int(n)+1):
        t=j/n; ix=round(a+(c-a)*t-xmin); iy=round(b+(d-b)*t-ymin)
        if 0<=ix<W and 0<=iy<H:grid[H-1-iy][ix]='#'
    print('ASCII bbox',xmin,ymin,xmax,ymax)
    for row in grid:
      print(''.join(row).rstrip())
PY
python3 /tmp/analyze.py > /tmp/result.txt
sed -n '1,180p' /tmp/result.txt
