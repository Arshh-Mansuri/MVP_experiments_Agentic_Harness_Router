[264.679873, "i", "cat > /tmp/pca.py <<'PY'\nimport re,math\nlines=open('/app/text.gcode',errors='ignore').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; blocks=[];i=0\nwhile i<len(lines):\n if lines[i].strip()=='M486 S0':\n  j=i+1\n  while j<len(lines) and lines[j].strip()!='M486 S-1':j+=1\n  blocks.append(lines[i+1:j]);i=j\n i+=1\npts=[]\nfor bi,bl in enumerate(blocks):\n if bi==0: continue\n x=y=z=None\n for s in bl:\n  if not s.startswith(('G0 ','G1 ')):continue\n  v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)};ox,oy,oz=x,y,z;x=v.get('X',x);y=v.get('Y',y);z=v.get('Z',z)\n  if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and x!=ox or False:\n   # include endpoints of XY extrusion moves, with modal Z\n   if ox is not None and oy is not None and z is not None: pts += [(ox,oy,z),(x,y,z)]\nprint('points',len(pts))\nmu=[sum(p[k] for p in pts)/len(pts) for k in range(3)]\nC=[[sum((p[i]-mu[i])*(p[j]-mu[j]) for p in pts)/len(pts) for j in range(3)] for i in range(3)]\ndef power(v):\n for _ in range(1"]
[264.681386, "o", "cat > /tmp/pca.py <<'PY'\r\n\u001b[?2004l\r"]
[264.68145, "i", "00):\n  w=[sum(C[i][j]*v[j] for j in range(3)) for i in range(3)]; n=math.sqrt(sum(q*q for q in w));v=[q/n for q in w]\n return v,sum(v[i]*sum(C[i][j]*v[j] for j in range(3)) for i in range(3))\nvec=[];M=[r[:] for r in C]\nfor k in range(3):\n v,e=power([1,.3,.7] if k==0 else [.2,1,.4]);vec.append(v)\n for i in range(3):\n  for j in range(3):M[i][j]-=e*v[i]*v[j]\n C=M\nprint('vectors',vec)\nQ=[]\nfor p in pts:Q.append((sum((p[i]-mu[i])*vec[0][i] for i in range(3)),sum((p[i]-mu[i])*vec[1][i] for i in range(3))))\nx0=min(q[0] for q in Q);x1=max(q[0] for q in Q);y0=min(q[1] for q in Q);y1=max(q[1] for q in Q);S=8;W=int((x1-x0)*S)+3;H=int((y1-y0)*S)+3;A=[[0]*W for _ in range(H)]\nfor a,b in Q:\n ix=round((a-x0)*S);iy=round((b-y0)*S)\n if 0<=ix<W and 0<=iy<H:A[H-1-iy][ix]=1\nprint('bbox',x0,y0,x1,y1)\nfor yy in range(0,H,3):print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+3,H))) else ' ' for xx in range(W)).rstrip())\nPY\npython3 /tmp/pca.py\n"]
[264.681474, "o", "\u001b[?2004h> import re,math\r\n\u001b[?2004l\r\u001b[?2004h> lines=open('/app/text.gcode',errors='ignore').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; blocks=[];i=0\r\n\u001b[?2004l\r\u001b[?2004h> while i<len(lines):\r\n\u001b[?2004l\r\u001b[?2004h>  if lines[i].strip()=='M486 S0':\r\n\u001b[?2004l\r\u001b[?2004h>   j=i+1\r\n\u001b[?2004l\r\u001b[?2004h>   while j<len(lines) and lines[j].strip()!='M486 S-1':j+=1\r\n\u001b[?2004l\r\u001b[?2004h>   blocks.append(lines[i+1:j]);i=j\r\n\u001b[?2004l\r\u001b[?2004h>  i+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.681733, "o", "pts=[]\r\n\u001b[?2004l\r00):\r\n  w=[sum(C[i][j]*v[j] for j in range(3)) for i in range(3)]; n=math.sqrt(sum(q*q for q in w));v=[q/n for q in w]\r\n return v,sum(v[i]*sum(C[i][j]*v[j] for j in range(3)) for i in range(3))\r\nvec=[];M=[r[:] for r in C]\r\nfor k in range(3):\r\n v,e=power([1,.3,.7] if k==0 else [.2,1,.4]);vec.append(v)\r\n for i in range(3):\r\n  for j in range(3):M[i][j]-=e*v[i]*v[j]\r\n C=M\r\nprint('vectors',vec)\r\nQ=[]\r\nfor p in pts:Q.append((sum((p[i]-mu[i])*vec[0][i] for i in range(3)),sum((p[i]-mu[i])*vec[1][i] for i in range(3))))\r\nx0=min(q[0] for q in Q);x1=max(q[0] for q in Q);y0=min(q[1] for q in Q);y1=max(q[1] for q in Q);S=8;W=int((x1-x0)*S)+3;H=int((y1-y0)*S)+3;A=[[0]*W for _ in range(H)]\r\nfor a,b in Q:\r\n ix=round((a-x0)*S);iy=round((b-y0)*S)\r\n if 0<=ix<W and 0<=iy<H:A[H-1-iy][ix]=1\r\nprint('bbox',x0,y0,x1,y1)\r\nfor yy in range(0,H,3):print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+3,H))) else ' ' for xx in range(W)).rstrip())\r\nPY\r\npython3 /tmp/pca.py\r\n\u001b[?2004h> "]
[264.681844, "o", "for bi,bl in enumerate(blocks):\r\n\u001b[?2004l\r"]
[264.682091, "o", "\u001b[?2004h>  if bi==0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.682283, "o", " x=y=z=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
