[108.530464, "i", "cat > /tmp/flat.py <<'PY'\nimport re\nbl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'\nx=y=z=None; paths=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}\n ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and x is not None and y is not None and oz is not None and abs(oz-3)<.01 and abs(z-3)<.01 and (x!=ox or y!=oy): paths.append((ox,oy,x,y))\nprint('flat paths',len(paths))\nif paths:\n xmin=min(min(a,c) for a,b,c,d in paths); xmax=max(max(a,c) for a,b,c,d in paths); ymin=min(min(b,d) for a,b,c,d in paths); ymax=max(max(b,d) for a,b,c,d in paths); sc=8; W=int((xmax-xmin)*sc)+3; H=int((ymax-ymin)*sc)+3; g=[[' ']*W for _ in range(H)]\n for a,b,c,d in paths:\n  n=int(max(abs(c-a),abs(d-b))*sc*3)+1\n  for j in range(n+1):\n   t=j/n; ix=round((a+(c-a)*t-xmin)*sc); iy=round((b+(d-b)*t-ymin)*sc)\n   if 0<=ix<W and 0<=iy<H:g[H-1-iy][ix]='#'\n print"]
[108.530693, "i", "('bbox',xmin,ymin,xmax,ymax)\n for r in g:\n  q=''.join(r).rstrip()\n  if q.strip():print(q)\nPY\npython3 /tmp/flat.py\n"]
[108.531241, "o", "cat > /tmp/flat.py <<'PY'\r\n\u001b[?2004l\r('bbox',xmin,ymin,xmax,ymax)\r\n for r in g:\r\n  q=''.join(r).rstrip()\r\n  if q.strip():print(q)\r\nPY\r\npython3 /tmp/flat.py\r\n\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
