[27.332922, "i", "cat > /tmp/analyze.py <<'PY'\nimport re\nfrom collections import defaultdict\nfn='/app/text.gcode'\nobj=None; x=y=None; seg=[]; regions=[]; current=[]\nfor line in open(fn, errors='ignore'):\n    s=line.strip()\n    if s.startswith('M486 S0'):\n        obj=0; current=[]\n    elif s.startswith('M486 S1'):\n        obj=1\n    elif s.startswith('M486 S-1'):\n        if obj==0 and current: regions.append(current)\n        obj=None\n    if not s.startswith(('G0 ','G1 ')): continue\n    vals={k:float(v) for k,v in re.findall(r'([XYZE])(-?\\d+(?:\\.\\d+)?)',s)}\n    ox,oy=x,y\n    if 'X' in vals:x=vals['X']\n    if 'Y' in vals:y=vals['Y']\n    if obj==0 and 'E' in vals and vals['E']>0 and ox is not None and oy is not None and x is not None and y is not None:\n        current.append((ox,oy,x,y))\nprint('regions',len(regions))\nfor i,r in enumerate(regions):\n    pts=[p for q in r for p in q]\n    print(i, 'segments',len(r),'bbox', tuple(round(z,2) for z in (min(p[0] for p in pts),min(p[1] for p in pts),max(p[0] for p in pts),max(p[1] for p in "]
[27.333796, "o", "cat > /tmp/analyze.py <<'PY'\r\n\u001b[?2004l\r"]
[27.334072, "i", "pts))))\n# combine all text paths; rasterize at 1 mm/cell, print y reversed\nallr=[q for r in regions for q in r]\nif allr:\n    xmin=min(min(a,c) for a,b,c,d in allr); xmax=max(max(a,c) for a,b,c,d in allr)\n    ymin=min(min(b,d) for a,b,c,d in allr); ymax=max(max(b,d) for a,b,c,d in allr)\n    W=int(xmax-xmin)+2; H=int(ymax-ymin)+2\n    grid=[[' ']*W for _ in range(H)]\n    for a,b,c,d in allr:\n      n=max(abs(c-a),abs(d-b))*4+1\n      for j in range(int(n)+1):\n        t=j/n; ix=round(a+(c-a)*t-xmin); iy=round(b+(d-b)*t-ymin)\n        if 0<=ix<W and 0<=iy<H:grid[H-1-iy][ix]='#'\n    print('ASCII bbox',xmin,ymin,xmax,ymax)\n    for row in grid:\n      print(''.join(row).rstrip())\nPY\npython3 /tmp/analyze.py > /tmp/result.txt\nsed -n '1,180p' /tmp/result.txt\n"]
