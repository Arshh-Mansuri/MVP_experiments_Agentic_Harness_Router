[45.94223, "i", "cat > /tmp/extract.py <<'PY'\nimport re\nlines=open('/app/text.gcode',errors='ignore').read().splitlines()\nblocks=[]; i=0\nwhile i<len(lines):\n if lines[i].strip()=='M486 S0':\n  j=i+1\n  while j<len(lines) and lines[j].strip()!='M486 S-1': j+=1\n  blocks.append(lines[i+1:j]); i=j\n i+=1\nprint('blocks',len(blocks))\nfor bi,bl in enumerate(blocks):\n x=y=None; paths=[]; extrusions=0\n for s in bl:\n  if not s.startswith(('G0 ','G1 ')): continue\n  v={k:float(z) for k,z in re.findall(r'([XYZE])(-?\\d+(?:\\.\\d+)?)',s)}\n  ox,oy=x,y\n  x=v.get('X',x); y=v.get('Y',y)\n  if 'E' in v and v['E']>0: extrusions+=1\n  if 'E' in v and v['E']>0 and ox is not None and oy is not None and x is not None and y is not None and (x!=ox or y!=oy): paths.append((ox,oy,x,y))\n if paths:\n  pts=[z for p in paths for z in p]\n  print(bi,'lines',len(bl),'extrude',extrusions,'paths',len(paths),'bbox',*[round(z,2) for z in (min(p[0] for p in pts),min(p[1] for p in pts),max(p[0] for p in pts),max(p[1] for p in pts))])\n  open('/tmp/block%d.txt'%bi,'w').write('"]
