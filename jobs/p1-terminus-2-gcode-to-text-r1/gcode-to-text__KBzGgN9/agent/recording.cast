[236.584126, "i", "cat > /tmp/face.py <<'PY'\nimport re\nbl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; x=y=z=None; strokes=[]; cur=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)\n if 'E' in v and v['E']<0:\n  if cur: strokes.append(cur); cur=[]\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3)<.01 and abs(oz-3)<.01 and (x!=ox or y!=oy): cur.append((ox,oy,x,y))\nif cur:strokes.append(cur)\n# print each component in face coordinates u=x+y, v=x-y\nfor no,P in enumerate(strokes):\n Q=[]\n for a,b,c,d in P: Q.append((a+b,a-b,c+d,c-d))\n pts=[q for p in Q for q in p]; u0=min(pts[0::2]);u1=max(pts[0::2]);v0=min(pts[1::2]);v1=max(pts[1::2]); sx=8; sy=8; W=int((u1-u0)*sx)+5;H=int((v1-v0)*sy)+5; A=[[0]*W for _ in range(H)]\n for a,b,c,d in Q:\n  n=max(2,int(max(abs(c-a)*sx,abs(d-b)*sy)*4))\n  for i in range(n+1):\n   t=i/n;xx=round"]
[236.5845, "o", "cat > /tmp/face.py <<'PY'\r\n"]
[236.585193, "i", "((a+(c-a)*t-u0)*sx);yy=round((b+(d-b)*t-v0)*sy)\n   if 0<=xx<W and 0<=yy<H:A[H-1-yy][xx]=1\n print('\\nCOMP',no,'uv',round(u0,2),round(v0,2),round(u1,2),round(v1,2))\n for yy in range(0,H,2):\n  print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+2,H))) else ' ' for xx in range(W)).rstrip())\nPY\npython3 /tmp/face.py > /tmp/faceout.txt; cat /tmp/faceout.txt\n"]
