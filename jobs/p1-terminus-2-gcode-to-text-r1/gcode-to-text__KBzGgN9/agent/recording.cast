[89.76716, "i", "cat > /tmp/render2.py <<'PY'\nimport re\nbl=open('/app/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'\nx=y=None; paths=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(z) for k,z in re.findall(r'([XYZE])('+num+')',s)}\n ox,oy=x,y; x=v.get('X',x); y=v.get('Y',y)\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and x is not None and y is not None and (x!=ox or y!=oy):\n  if max(ox,x)<70 and max(oy,y)<92 and min(ox,x)>54 and min(oy,y)>78: paths.append((ox,oy,x,y))\nprint('paths',len(paths))\nxmin,xmax,ymin,ymax=54,70,78,92; sc=10; W=int((xmax-xmin)*sc); H=int((ymax-ymin)*sc); g=[[0]*W for _ in range(H)]\nfor a,b,c,d in paths:\n n=int(max(abs(c-a),abs(d-b))*sc*3)+1\n for j in range(n+1):\n  t=j/n; px=(a+(c-a)*t-xmin)*sc; py=(b+(d-b)*t-ymin)*sc\n  for dx in range(-2,3):\n   for dy in range(-2,3):\n    ix=round(px)+dx; iy=round(py)+dy\n    if 0<=ix<W and 0<=iy<H:g[H-1-iy][ix]=1\n# print 2x2 pixel blocks\nfor yy in range(0,H,2):\n row=''\n for xx in range(0,W,2): row += '##'"]
[89.767453, "i", " if any(g[y][x] for y in range(yy,min(yy+2,H)) for x in range(xx,min(xx+2,W))) else '  '\n if row.strip(): print(row.rstrip())\nPY\npython3 /tmp/render2.py\n"]
[89.768039, "o", "cat > /tmp/render2.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r"]
