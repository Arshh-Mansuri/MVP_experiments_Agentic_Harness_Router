[207.381062, "i", "cat > /tmp/allblocks.py <<'PY'\nimport re,glob\nfor fn in sorted(glob.glob('/tmp/block[0-9]*.txt'), key=lambda s:int(re.search(r'(\\d+)',s).group(1))):\n x=y=z=None; P=[]; num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'\n for s in open(fn):\n  if not s.startswith(('G0 ','G1 ')):continue\n  v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z;x=v.get('X',x);y=v.get('Y',y);z=v.get('Z',z)\n  if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3 if '11' in fn else z-(.2+int(re.search(r'block(\\d+)',fn).group(1))*.?))<999: P.append((ox,oy,x,y))\n print(fn,len(P), (min([q for p in P for q in (p[0],p[2])]),max([q for p in P for q in (p[0],p[2])])) if P else '')\nPY\n# use a simpler summary of all blocks without the malformed heuristic\nfor f in /tmp/block*.txt; do echo -n \"$f \"; grep -cE '^G1 .* E\\.' \"$f\"; done\n"]
[207.381269, "o", "cat > /tmp/allblocks.py <<'PY'\r\n\u001b[?2004l\r"]
