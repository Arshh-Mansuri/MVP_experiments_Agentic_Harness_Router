[35.418181, "i", "sed -n '110,148p' /app/text.gcode; python3 - <<'PY'\nimport re\nobj=None\nfor no,line in enumerate(open('/app/text.gcode'),1):\n s=line.strip()\n if s.startswith('M486 S0'): obj=0; print(no,'STATE 0')\n elif s.startswith('M486 S1'): obj=1; print(no,'STATE 1')\n elif s.startswith('M486 S-1'): print(no,'END state',obj); obj=None\n if 110<=no<=145 and s.startswith(('G0 ','G1 ')):\n  vals={k:float(v) for k,v in re.findall(r'([XYZE])(-?\\d+(?:\\.\\d+)?)',s)}\n  print(no,'obj=',obj,vals)\nPY\n"]
