[67.070316, "i", "cat > /tmp/render.py <<'PY'\nimport re\nbl=open('/tmp/block10.txt').read().splitlines()\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'\nx=y=None; paths=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(z) for k,z in re.findall(r'([XYZE])('+num+')',s)}\n ox,oy=x,y; x=v.get('X',x); y=v.get('Y',y)\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and x is not None and y is not None and (x!=ox or y!=oy): paths.append((ox,oy,x,y))\nxmin=min(min(a,c) for a,b,c,d in paths); xmax=max(max(a,c) for a,b,c,d in paths)\nymin=min(min(b,d) for a,b,c,d in paths); ymax=max(max(b,d) for a,b,c,d in paths)\nscale=8; W=int((xmax-xmin)*scale)+3; H=int((ymax-ymin)*scale)+3\ngrid=[[' ']*W for _ in range(H)]\nfor a,b,c,d in paths:\n n=max(abs(c-a),abs(d-b))*scale*3+1\n for j in range(int(n)+1):\n  t=j/n; ix=round((a+(c-a)*t-xmin)*scale); iy=round((b+(d-b)*t-ymin)*scale)\n  if 0<=ix<W and 0<=iy<H: grid[H-1-iy][ix]='#'\nprint('bbox',xmin,ymin,xmax,ymax,'paths',len(paths))\nfor row in grid:\n z=''.join(row).rstrip()\n if z.strip("]
[67.070381, "i", "): print(z)\nPY\npython3 /tmp/render.py\n"]
