[185.476003, "i", "cat > /tmp/glyphs.py <<'PY'\nexec(open('/tmp/strokes.py').read().split(\"print('strokes'\")[0])\nfor no,P in enumerate(strokes):\n pts=[q for s in P for q in s]; x0=min(pts[0::2]); x1=max(pts[0::2]); y0=min(pts[1::2]); y1=max(pts[1::2]); sx=10; sy=5; W=int((x1-x0)*sx)+5; H=int((y1-y0)*sy)+5; A=[[0]*W for _ in range(H)]\n for a,b,c,d in P:\n  n=max(2,int(max(abs(c-a)*sx,abs(d-b)*sy)*5))\n  for i in range(n+1):\n   t=i/n; xx=round((a+(c-a)*t-x0)*sx); yy=round((b+(d-b)*t-y0)*sy)\n   if 0<=xx<W and 0<=yy<H:A[H-1-yy][xx]=1\n print('\\nGLYPH',no,'bbox',round(x0,2),round(y0,2),round(x1,2),round(y1,2))\n for yy in range(0,H,2):\n  print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+2,H))) else ' ' for xx in range(W)).rstrip())\nPY\npython3 /tmp/glyphs.py\n"]
[185.476364, "o", "cat > /tmp/glyphs.py <<'PY'\r\n\u001b[?2004l\r"]
