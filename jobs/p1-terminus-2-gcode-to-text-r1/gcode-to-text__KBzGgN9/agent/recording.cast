[131.002433, "i", "cat > /tmp/ascii.py <<'PY'\nimport re\nbl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; x=y=z=None; P=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3)<.01 and abs(oz-3)<.01 and (x!=ox or y!=oy): P.append((ox,oy,x,y))\nx0,x1,y0,y1=56.2,67.7,80.1,90.4; S=5; W=round((x1-x0)*S); H=round((y1-y0)*S); A=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(max(abs(c-a),abs(d-b))*S*4))\n for i in range(n+1):\n  t=i/n; X=round((a+(c-a)*t-x0)*S); Y=round((b+(d-b)*t-y0)*S)\n  for dx in range(-1,2):\n   for dy in range(-1,2):\n    if 0<=X+dx<W and 0<=Y+dy<H:A[H-1-(Y+dy)][X+dx]=1\n# group vertical pixels to compensate terminal character height\nfor yy in range(0,H,3):\n print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+3,H))) else ' ' for xx in range(W))."]
[131.002803, "i", "rstrip())\nprint('column occupancy')\nprint(''.join('█' if sum(A[y][x] for y in range(H)) else ' ' for x in range(W)))\nPY\npython3 /tmp/ascii.py\n"]
[131.003072, "o", "cat > /tmp/ascii.py <<'PY'\r\n"]
