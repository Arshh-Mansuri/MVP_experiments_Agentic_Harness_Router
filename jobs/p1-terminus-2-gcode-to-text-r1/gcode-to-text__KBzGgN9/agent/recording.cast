[264.682827, "o", "  v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)};ox,oy,oz=x,y,z;x=v.get('X',x);y=v.get('Y',y);z=v.get('Z',z)\r\n\u001b[?2004l\r\u001b[?2004h>   if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and x!=ox or False:\r\n\u001b[?2004l\r"]
[264.684474, "o", "\u001b[?2004h>    # include endpoints of XY extrusion moves, with modal Z\r\n\u001b[?2004l\r\u001b[?2004h>    if ox is not None and oy is not None and z is not None: pts += [(ox,oy,z),(x,y,z)]\r\n\u001b[?2004l\r\u001b[?2004h> print('points',len(pts))\r\n\u001b[?2004l\r\u001b[?2004h> mu=[sum(p[k] for p in pts)/len(pts) for k in range(3)]\r\n\u001b[?2004l\r\u001b[?2004h> C=[[sum((p[i]-mu[i])*(p[j]-mu[j]) for p in pts)/len(pts) for j in range(3)] for i in range(3)]\r\n\u001b[?2004l\r\u001b[?2004h> def power(v):\r\n\u001b[?2004l\r\u001b[?2004h>  for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h>   w=[sum(C[i][j]*v[j] for j in range(3)) for i in range(3)]; n=math.sqrt(sum(q*q for q in w));v=[q/n for q in w]\r\n\u001b[?2004l\r\u001b[?2004h>  return v,sum(v[i]*sum(C[i][j]*v[j] for j in range(3)) for i in range(3))\r\n\u001b[?2004l\r\u001b[?2004h> vec=[];M=[r[:] for r in C]\r\n\u001b[?2004l\r\u001b[?2004h> for k in range(3):\r\n\u001b[?2004l\r\u001b[?2004h>  v,e=power([1,.3,.7] if k==0 else [.2,1,.4]);vec.append(v)\r\n\u001b[?2004l\r\u001b[?2004h>  for i in range(3):\r\n\u001b[?2004l\r\u001b[?2004h>   for j in range(3):M[i][j]-=e*v[i]*v[j]\r\n\u001b[?2004l\r\u001b[?2004h>  C=M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.684506, "o", "print('vectors',vec)\r\n\u001b[?2004l\r\u001b[?2004h> Q=[]\r\n\u001b[?2004l\r\u001b[?2004h> for p in pts:Q.append((sum((p[i]-mu[i])*vec[0][i] for i in range(3)),sum((p[i]-mu[i])*vec[1][i] for i in range(3))))"]
[264.687565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> x0=min(q[0] for q in Q);x1=max(q[0] for q in Q);y0=min(q[1] for q in Q);y1=max(q[1] for q in Q);S=8;W=int((x1-x0)*S)+3;H=int((y1-y0)*S)+3;A=[[0]*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b in Q:\r\n\u001b[?2004l\r\u001b[?2004h>  ix=round((a-x0)*S);iy=round((b-y0)*S)\r\n\u001b[?2004l\r\u001b[?2004h>  if 0<=ix<W and 0<=iy<H:A[H-1-iy][ix]=1\r\n\u001b[?2004l\r\u001b[?2004h> print('bbox',x0,y0,x1,y1)\r\n\u001b[?2004l\r\u001b[?2004h> for yy in range(0,H,3):print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+3,H))) else ' ' for xx in range(W)).rstrip())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
