[165.981556, "i", "cat > /tmp/thin.py <<'PY'\nimport re\nbl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; x=y=z=None; P=[]\nfor s in bl:\n if not s.startswith(('G0 ','G1 ')): continue\n v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)\n if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3)<.01 and abs(oz-3)<.01 and (x!=ox or y!=oy): P.append((ox,oy,x,y))\nx0,x1,y0,y1=56.2,67.7,80.1,90.4; sx,sy=12,8; W=int((x1-x0)*sx); H=int((y1-y0)*sy); A=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(max(abs(c-a)*sx,abs(d-b)*sy)*5))\n for i in range(n+1):\n  t=i/n; xx=round((a+(c-a)*t-x0)*sx); yy=round((b+(d-b)*t-y0)*sy)\n  if 0<=xx<W and 0<=yy<H:A[H-1-yy][xx]=1\nfor yy in range(0,H,2):\n print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+2,H))) else ' ' for xx in range(W)).rstrip())\nprint('columns')\nprint(''.join('█' if any(A[y][x] for y in range(H)) else ' ' for x in range(W)))\nPY\npy"]
[165.98172, "i", "thon3 /tmp/thin.py\n"]
[165.982233, "o", "cat > /tmp/thin.py <<'PY'\r\n\u001b[?2004l\r"]
[165.984488, "o", "\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> bl=open('/tmp/block11.txt').read().splitlines(); num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; x=y=z=None; P=[]\r\n\u001b[?2004l\r\u001b[?2004h> for s in bl:\r\n\u001b[?2004l\r\u001b[?2004h>  if not s.startswith(('G0 ','G1 ')): continue\r\n\u001b[?2004l\r\u001b[?2004h>  v={k:float(q) for k,q in re.findall(r'([XYZE])('+num+')',s)}; ox,oy,oz=x,y,z; x=v.get('X',x); y=v.get('Y',y); z=v.get('Z',z)\r\n\u001b[?2004l\r\u001b[?2004h>  if 'E' in v and v['E']>0 and ox is not None and oy is not None and oz is not None and abs(z-3)<.01 and abs(oz-3)<.01 and (x!=ox or y!=oy): P.append((ox,oy,x,y))\r\n\u001b[?2004l\r\u001b[?2004h> x0,x1,y0,y1=56.2,67.7,80.1,90.4; sx,sy=12,8; W=int((x1-x0)*sx); H=int((y1-y0)*sy); A=[[0]*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,c,d in P:\r\n\u001b[?2004l\r\u001b[?2004h>  n=max(2,int(max(abs(c-a)*sx,abs(d-b)*sy)*5))\r\n\u001b[?2004l\r\u001b[?2004h>  for i in range(n+1):\r\n\u001b[?2004l\r\u001b[?2004h>   t=i/n; xx=round((a+(c-a)*t-x0)*sx); yy=round((b+(d-b)*t-y0)*sy)\r\n\u001b[?2004l\r\u001b[?2004h>   if 0<=xx<W and 0<=yy<H:A[H-1-yy][xx]=1\r\n\u001b[?2004l\r\u001b[?2004h> for yy in ran"]
[165.984627, "o", "ge(0,H,2):\r\n\u001b[?2004l\r\u001b[?2004h>  print(''.join('█' if any(A[k][xx] for k in range(yy,min(yy+2,H))) else ' ' for xx in range(W)).rstrip())\r\n\u001b[?2004l\r\u001b[?2004h> print('columns')\r\n\u001b[?2004l\r\u001b[?2004h> print(''.join('█' if any(A[y][x] for y in range(H)) else ' ' for x in range(W)))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
