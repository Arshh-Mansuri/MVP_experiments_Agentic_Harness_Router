[25.150515, "i", "cat > /app/apply_macros.vim <<'EOF'\ncall setreg('a', \":s/^\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*,\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*,\\\\s*\\\\([^,]*\\\\S\\\\)\\\\s*$/\\\\U\\\\3;\\\\2;\\\\1;OK\\\\E/\\r\")\ncall setreg('b', \"l\")\ncall setreg('c', \"h\")\n:%normal! @a\n:%normal! @b\n:%normal! @c\n:wq\nEOF\nvim -Nu NONE -n -Es /app/input.csv -S /app/apply_macros.vim\nrc=$?; printf 'vim_exit=%s\\n' \"$rc\"; cmp -s /app/input.csv /app/expected.csv; printf 'cmp_exit=%s\\n' \"$?\"; printf '%s\\n' 'SCRIPT:'; cat /app/apply_macros.vim\n"]
