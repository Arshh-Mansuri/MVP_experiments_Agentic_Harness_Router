[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from decimal import Decimal
[?2004l[?2004h> import csv, shutil
[?2004l[?2004h> src=Path('/app/documents')
[?2004l[?2004h> inv=Path('/app/invoices'); other=Path('/app/other')
[?2004l[?2004h> inv.mkdir(exist_ok=True); other.mkdir(exist_ok=True)
[?2004l[?2004h> # filename: (total, vat)
[?2004l[?2004h> invoices={
[?2004l[?2004h>  '2lgKzDuI4E4g.jpg':('6558','0'),
[?2004l[?2004h>  'KrJiw0OZx7jf.jpg':('9963','0'),
[?2004l[?2004h>  'JOiylq2_7S18.jpg':('6860.45','623.68'),
[?2004l[?2004h>  'ivE2mt3HwvEO.jpg':('819.06','74.46'),
[?2004l[?2004h>  'lxtL9XrYRsVG.jpg':('797.91','72.54'),
[?2004l[?2004h>  'vvK89XK847m3.jpg':('6204.19','564.02'),
[?2004l[?2004h>  'w0i40MJP2Dzm.jpg':('44745.59','4067.78'),
[?2004l[?2004h>  'T0r6Ou8zvqTA.pdf':('4031.0','0'),
[?2004l[?2004h>  'wIQEB5nR79b2.pdf':('440.0','0'),
[?2004l[?2004h>  'UsN9tVTKskms.pdf':('896.0','0'),
[?2004l[?2004h> }
[?2004l[?2004h> allfiles={p.name for p in src.iterdir() if p.is_file()}
[?2004l[?2004h> missing=set(invoices)-allfiles
[?2004l[?2004h> if missing: raise SystemExit('Missing invoice files: '+repr(missing))
[?2004l[?2004h> for name in sorted(allfiles):
[?2004l[?2004h>  dest=inv if name in invoices else other
[?2004l[?2004h>  shutil.move(str(src/name),str(dest/name))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> total=Decimal('0'); vat=Decimal('0')
[?2004l[?2004h> for name,(t,v) in invoices.items():
[?2004l[?2004h>  total+=Decimal(t); vat+=Decimal(v)
[?2004l[?2004h>  rows.append((name,t,v))
[?2004l[?2004h> def fmt(x):
[?2004l[?2004h>  return format(x,'f').rstrip('0').rstrip('.') if x!=x.to_integral() else format(x,'f')
[?2004l[?2004h> with (inv/'summary.csv').open('w',newline='') as f:
[?2004l[?2004h>  w=csv.writer(f); w.writerow(['filename','total_amount','vat_amount'])
[?2004l[?2004h>  w.writerows(rows); w.writerow(['total',fmt(total),fmt(vat)])
[?2004l[?2004h> print('moved invoices:',len(invoices),'other:',len(allfiles)-len(invoices))
[?2004l[?2004h> print('aggregate:',fmt(total),fmt(vat))
[?2004l[?2004h> PY
