[45.316037, "i", "rm -rf /tmp/doc_text; mkdir -p /tmp/doc_text; for f in /app/documents/*.pdf; do n=$(basename \"$f\" .pdf); pdftotext -layout \"$f\" \"/tmp/doc_text/$n.txt\" 2>/dev/null || true; done; for f in /app/documents/*.[JjPp][PpGg]; do n=$(basename \"$f\"); tesseract \"$f\" \"/tmp/doc_text/$n\" 2>/dev/null || true; done; for f in /tmp/doc_text/*; do echo \"===== $(basename \"$f\") =====\"; cat \"$f\"; echo; done\n"]
[45.31809, "o", "rm -rf /tmp/doc_text; mkdir -p /tmp/doc_text; for f in /app/documents/*.pdf; do n=$(basename \"$f\" .pdf); pdftotext -layout \"$f\" \"/tmp/doc_text/$n.txt\" 2>/dev/null || true; done; for f in /app/documents/*.[JjPp][PpGg]; do n=$(basename \"$f\"); tesseract \"$f\" \"/tmp/doc_text/$n\" 2>/dev/null || true; done; for f in /tmp/doc_text/*; do echo \"===== $(basename \"$f\") =====\"; cat \"$f\"; echo; done\r\n"]
