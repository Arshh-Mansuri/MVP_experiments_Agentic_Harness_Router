[216.577993, "i", "cat > /tmp/process_documents.py <<'PY'\nfrom pathlib import Path\nfrom decimal import Decimal\nimport csv, shutil\nsrc=Path('/app/documents')\ninv=Path('/app/invoices'); other=Path('/app/other')\ninv.mkdir(exist_ok=True); other.mkdir(exist_ok=True)\n# filename: (total, vat)\ninvoices={\n '2lgKzDuI4E4g.jpg':('6558','0'),\n 'KrJiw0OZx7jf.jpg':('9963','0'),\n 'JOiylq2_7S18.jpg':('6860.45','623.68'),\n 'ivE2mt3HwvEO.jpg':('819.06','74.46'),\n 'lxtL9XrYRsVG.jpg':('797.91','72.54'),\n 'vvK89XK847m3.jpg':('6204.19','564.02'),\n 'w0i40MJP2Dzm.jpg':('44745.59','4067.78'),\n 'T0r6Ou8zvqTA.pdf':('4031.0','0'),\n 'wIQEB5nR79b2.pdf':('440.0','0'),\n 'UsN9tVTKskms.pdf':('896.0','0'),\n}\nallfiles={p.name for p in src.iterdir() if p.is_file()}\nmissing=set(invoices)-allfiles\nif missing: raise SystemExit('Missing invoice files: '+repr(missing))\nfor name in sorted(allfiles):\n dest=inv if name in invoices else other\n shutil.move(str(src/name),str(dest/name))\nrows=[]\ntotal=Decimal('0'); vat=Decimal('0')\nfor name,(t,v) in invoices.items():\n total+=Decimal(t); vat+=Decimal(v)\n rows.append((name,t,v))\ndef fmt(x):\n return format(x,'f').rstrip('0').rstrip('.') if x!=x.to_integral() else format(x,'f')\nwith (inv/'summary.csv').open('w',newline='') as f:\n w=csv.writer(f); w.writerow(['filename','total_amount','vat_amount'])\n w.writerows(rows); w.writerow(['total',fmt(total),fmt(vat)])\nprint('moved invoices:',len(invoices),'other:',len(allfiles)-len(invoices))\nprint('aggregate:',fmt(total),fmt(vat))\nPY\npython3 /tmp/process_documents.py\nprintf '\\nSource remaining:\\n'; find /app/documents -maxdepth 1 -type f -printf '%f\\n' | sort\nprintf '\\nInvoice files:\\n'; find /app/invoices -maxdepth 1 -type f -printf '%f\\n' | sort\nprintf '\\nOther files:\\n'; find /app/other -maxdepth 1 -type f -printf '%f\\n' | sort\nprintf '\\nCSV:\\n'; cat /app/invoices/summary.csv\n"]
[216.580561, "o", "cat > /tmp/process_documents.py <<'PY'\r\n"]
