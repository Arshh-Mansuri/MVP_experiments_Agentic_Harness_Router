[25.407941, "o", "\u001b[?2004hroot@81a278f39f7b:/app# "]
[26.252016, "i", "python3 - <<'PY'\nimport os,struct\nfor fn in sorted(os.listdir('/app/documents')):\n if not fn.lower().endswith(('.jpg','.jpeg')): continue\n b=open('/app/documents/'+fn,'rb').read(); print(fn,len(b),b[:10])\n i=2\n try:\n  while i<len(b)-9:\n   if b[i]!=255: i+=1; continue\n   marker=b[i+1]; i+=2\n   if marker in (216,217): continue\n   n=struct.unpack('>H',b[i:i+2])[0]\n   if marker in (192,193,194,195):\n    h,w=struct.unpack('>HH',b[i+3:i+7]); print(' ',w,'x',h); break\n   i+=n\n except Exception as e: print(e)\nPY\nprintf '\\nPossible tools:\\n'; find /usr/bin /usr/local/bin -maxdepth 1 -type f -printf '%f\\n' 2>/dev/null | grep -Ei 'ocr|pdf|image|convert|python|node|ruby|perl' | sort\n"]
