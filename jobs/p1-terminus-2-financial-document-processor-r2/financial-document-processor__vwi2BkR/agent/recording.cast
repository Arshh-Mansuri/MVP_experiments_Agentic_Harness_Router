[160.331334, "i", "python3 - <<'PY'\nimport glob,os,re\npat=re.compile(r'(invoice|receipt|bill|total|amount|due|vat|tax|gst|gross|net|subtotal|balance|payment|order)',re.I)\nfor f in sorted(glob.glob('/tmp/doc_text/*')):\n lines=[' '.join(x.split()) for x in open(f,errors='replace').read().splitlines() if x.strip()]\n print('\\n### '+os.path.basename(f)+' ###')\n print('HEAD:', ' | '.join(lines[:5]))\n hits=[x for x in lines if pat.search(x)]\n print('KEY:', ' | '.join(hits[-20:]) if hits else '(none)')\nPY\n"]
