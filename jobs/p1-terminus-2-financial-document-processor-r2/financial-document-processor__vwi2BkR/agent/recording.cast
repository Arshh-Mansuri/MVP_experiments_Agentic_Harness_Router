[14.614222, "i", "python3 - <<'PY'\nimport os\nfor fn in sorted(os.listdir('/app/documents')):\n p='/app/documents/'+fn\n print('\\n###',fn)\n if fn.lower().endswith('.pdf'):\n  b=open(p,'rb').read()\n  print('size',len(b),'strings:',end=' ')\n  import re\n  s=re.findall(rb'[ -~]{4,}',b)\n  print(' | '.join(x.decode('latin1','ignore')[:200] for x in s[:20]))\nPY\n"]
