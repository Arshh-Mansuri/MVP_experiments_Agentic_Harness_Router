        import planarity

        pg = planarity.PGraph(g)
        pg.embed_drawplanar()
        g = planarity.networkx_graph(pg)

        # planarity >= 1.0 stores draw-planar ordering metadata rather than
        # the legacy NetworkX ``pos`` node attribute expected below.  Recover
        # a 2-D planar layout for compatibility with both APIs.
        if any('pos' not in data for _, data in g.nodes(data=True)):
            try:
                import networkx as nx
                positions = nx.planar_layout(g)
            except Exception:
                positions = nx.spring_layout(g, seed=0)
            for node, position in positions.items():
                g.nodes[node]['pos'] = position

        # planarity >= 1.0 also renamed the vertex interval metadata.
        # Translate it to the names used by the original pyknotid code.
        for node, data in g.nodes(data=True):
            if 'start' not in data and 'vertex_start' in data:
                data['start'] = data['vertex_start']
            if 'end' not in data and 'vertex_end' in data:
                data['end'] = data['vertex_end']

        node_labels = {}
        xs = []
        ys = []

        nodes_by_height = {}
        node_xs_by_y = {}
        node_xs_ys = {}
        node_lefts_rights = {}

        for node, data in g.nodes(data=True):
            y = data['pos']
            xb = data['start']
            xe = data['end']
