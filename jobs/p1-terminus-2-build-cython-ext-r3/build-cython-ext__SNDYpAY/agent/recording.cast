[311.246749, "i", "cd /app/pyknotid && python3 - <<'PY'\nimport numpy\nimport pyknotid\nfrom pyknotid.spacecurves import chelpers, ccomplexity\nfrom pyknotid import cinvariants\nimport pyknotid.make as mk\nimport pyknotid.spacecurves as sp\nassert numpy.__version__ == '2.3.0', numpy.__version__\nfor mod in (chelpers, ccomplexity, cinvariants):\n    assert mod.__file__.endswith(('.so', '.pyd')), mod.__file__\nprint('numpy', numpy.__version__)\nprint('pyknotid', pyknotid.__file__)\nprint('extensions:', chelpers.__file__, ccomplexity.__file__, cinvariants.__file__)\nk = sp.Knot(mk.three_twist(num_points=100))\nout = k.alexander_polynomial(-1)\nprint('alexander(-1):', out)\nPY\n"]
