[362.608498, "o", "\u001b[33m`numpy.distutils` is not available from \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                                     \u001b[33m\"\u001b[39;49;00m\u001b[33mPython 3.12 onwards\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, name=\u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m attr \u001b[95min\u001b[39;49;00m __future_scalars__:\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# And future warnings for those that will change, but also give\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# the AttributeError\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            warnings.warn(\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mIn the future `np.\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mattr\u001b[33m}\u001b[39;49;00m\u001b[33m` will be defined as the \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33mcorresponding NumPy scalar.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[96mFutureWarning\u001b[39;49;00m, stacklevel=\u001b[94m2\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m attr \u001b[95min\u001b[39;49;00m __former"]
[362.608503, "o", "_attrs__:\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mraise\u001b[39;49;00m \u001b[96mAttributeError\u001b[39;49;00m(__former_attrs__[attr], name=\u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AttributeError: module 'numpy' has no attribute 'float'.\u001b[0m\r\n\u001b[1m\u001b[31mE           `np.float` was a deprecated alias for the builtin `float`. To avoid this error in existing code, use `float` by itself. Doing this will not modify any behavior and is safe. If you specifically wanted the numpy scalar type, use `np.float64` here.\u001b[0m\r\n\u001b[1m\u001b[31mE           The aliases was originally deprecated in NumPy 1.20; for more details and guidance see the original release note at:\u001b[0m\r\n\u001b[1m\u001b[31mE               https://numpy.org/devdocs/release/1.20.0-notes.html#deprecations\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/numpy/__init__.py\u001b[0m:778: AttributeError\r\n"]
