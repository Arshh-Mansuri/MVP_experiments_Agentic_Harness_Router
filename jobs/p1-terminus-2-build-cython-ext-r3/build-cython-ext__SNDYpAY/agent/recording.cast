[266.715928, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[266.722785, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.2\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[266.788984, "o", "\u001b[?2004hroot@2b40860dedce:/app/pyknotid# "]
[271.77758, "i", "cd /app/pyknotid && python3 - <<'PY'\nimport numpy\nimport pyknotid\nfrom pyknotid.spacecurves import chelpers, ccomplexity\nfrom pyknotid import cinvariants\nimport pyknotid.make as mk\nimport pyknotid.spacecurves as sp\nassert numpy.__version__ == '2.3.0', numpy.__version__\nfor mod in (chelpers, ccomplexity, cinvariants):\n    assert mod.__file__.endswith(('.so', '.pyd')), mod.__file__\nprint('numpy', numpy.__version__)\nprint('pyknotid', pyknotid.__file__)\nprint('extensions:', chelpers.__file__, ccomplexity.__file__, cinvariants.__file__)\nk = sp.Knot(mk.three_twist(num_points=100))\nout = k.alexander_polynomial(-1)\nprint('alexander(-1):', out)\nPY\n"]
[271.77802, "o", "cd /app/pyknotid && python3 - <<'PY'\r\n"]
