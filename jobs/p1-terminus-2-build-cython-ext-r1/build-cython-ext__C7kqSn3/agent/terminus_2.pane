from pathlib import Path
files = [
    Path('pyknotid/spacecurves/spacecurve.py'),
    Path('pyknotid/spacecurves/periodiccell.py'),
    Path('pyknotid/spacecurves/ccomplexity.pyx'),
]
for path in files:
    text = path.read_text()
    updated = text.replace('np.float', 'float').replace('np.bool', 'bool').replace('np.int', 'np.int64')
    if updated != text:
        path.write_text(updated)
        print('patched', path)
PY
