[173.350565, "i", "cd /app/pyknotid && cp -a pyknotid /tmp/pyknotid-before-numpy2-fix && python3 - <<'PY'\nfrom pathlib import Path\nfiles = [\n    Path('pyknotid/spacecurves/spacecurve.py'),\n    Path('pyknotid/spacecurves/periodiccell.py'),\n    Path('pyknotid/spacecurves/ccomplexity.pyx'),\n]\nfor path in files:\n    text = path.read_text()\n    updated = text.replace('np.float', 'float').replace('np.bool', 'bool').replace('np.int', 'np.int64')\n    if updated != text:\n        path.write_text(updated)\n        print('patched', path)\nPY\nrm -rf build\npython3 setup.py build_ext --inplace >/tmp/pyknotid-build-final.log 2>&1\nrc=$?\nprintf 'BUILD_STATUS:%s\\n' \"$rc\"\ntail -80 /tmp/pyknotid-build-final.log\n"]
