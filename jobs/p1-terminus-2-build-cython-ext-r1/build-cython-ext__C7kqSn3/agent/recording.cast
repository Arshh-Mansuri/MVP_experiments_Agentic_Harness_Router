[618.772942, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfor p in Path('pyknotid').rglob('*'):\n    if p.suffix not in {'.py', '.pyx', '.pxd'}:\n        continue\n    s = p.read_text()\n    old = s\n    # Replace only complete deprecated aliases; preserve np.float64, np.int64, etc.\n    s = re.sub(r'\\b(np|n)\\.float\\b', 'float', s)\n    s = re.sub(r'\\b(np|n)\\.int\\b', 'int', s)\n    s = re.sub(r'\\b(np|n)\\.bool\\b', 'bool', s)\n    s = re.sub(r'\\b(np|n)\\.complex\\b', 'complex', s)\n    s = re.sub(r'\\b(np|n)\\.object\\b', 'object', s)\n    if s != old:\n        p.write_text(s)\n        print('patched', p)\nPY\nrm -rf build\npython3 setup.py build_ext --inplace >/tmp/pyknotid-build-numpy-final.log 2>&1\nrc=$?; echo BUILD_STATUS:$rc; tail -50 /tmp/pyknotid-build-numpy-final.log\n"]
