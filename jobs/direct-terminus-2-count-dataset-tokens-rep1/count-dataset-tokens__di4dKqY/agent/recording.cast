[95.196887, "i", "python3 - <<'PY'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nfrom collections import Counter\np='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\nds=load_dataset('parquet', data_files=p, split='train')\nrows=[r for r in ds if r['domain'] in {'physics','chemistry','biology'}]\nprint('counts',Counter(r['domain'] for r in rows),'total',len(rows))\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\ndef n(s): return len(tok.encode(s or '',add_special_tokens=False))\nfor k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\n print(k,sum(n(r[k]) for r in rows))\nprint('reasoning+solution separate',sum(n(r['deepseek_reasoning'])+n(r['deepseek_solution']) for r in rows))\nprint('reasoning+solution newline',sum(n((r['deepseek_reasoning'] or '')+'\\n'+(r['deepseek_solution'] or '')) for r in rows))\nfor r in rows:\n print(r['domain'],n(r['deepseek_reasoning']),n(r['deepseek_solution']))\nPY\n"]
[95.198405, "o", "python3 - <<'PY'\r\n"]
[95.201539, "o", "\u001b[?2004l\r\u001b[?2004h> from datasets import load_dataset\r\n\u001b[?2004l\r\u001b[?2004h> from transformers import AutoTokenizer\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> p='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\r\n\u001b[?2004l\r\u001b[?2004h> ds=load_dataset('parquet', data_files=p, split='train')\r\n\u001b[?2004l\r\u001b[?2004h> rows=[r for r in ds if r['domain'] in {'physics','chemistry','biology'}]\r\n\u001b[?2004l\r\u001b[?2004h> print('counts',Counter(r['domain'] for r in rows),'total',len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> tok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\r\n\u001b[?2004l\r\u001b[?2004h> def n(s): return len(tok.encode(s or '',add_special_tokens=False))\r\n\u001b[?2004l\r\u001b[?2004h> for k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\r\n\u001b[?2004l\r\u001b[?2004h>  print(k,sum(n(r[k]) for r in rows))\r\n\u001b[?2004l\r\u001b[?2004h> print('reasoning+solution separate',sum(n(r['deepseek_reasoning'])+n(r['deepseek_solution']) for r in rows"]
