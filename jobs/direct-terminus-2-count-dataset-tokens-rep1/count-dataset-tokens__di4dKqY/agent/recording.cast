[28.986624, "i", "python3 - <<'PY'\nfrom datasets import load_dataset\np='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\nds=load_dataset('parquet', data_files=p, split='train')\nprint(ds)\nfrom collections import Counter\nprint('domains:', Counter(ds['domain']))\nrows=[r for r in ds if str(r['domain']).lower()=='science']\nprint('science rows:',len(rows))\nfor k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\n vals=[r[k] for r in rows]\n print(k, 'nonempty',sum(bool(v) for v in vals), 'chars',sum(len(v or '') for v in vals), 'sample',repr((vals[0] or '')[:150]))\nPY\n"]
[28.987431, "o", "python3 - <<'PY'\r\nfrom datasets import load_dataset\r\np='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\r\nds=load_dataset('parquet', data_files=p, split='train')\r\nprint(ds)\r\nfrom collections import Counter\r\nprint('domains:', Counter(ds['domain']))\r\nrows=[r for r in ds if str(r['domain']).lower()=='science']\r\nprint('science rows:',len(rows))\r\nfor k in ['problem','deepseek_reasoning','deepseek_solution','ground_truth_solution']:\r\n vals=[r[k] for r in rows]\r\n print(k, 'nonempty',sum(bool(v) for v in vals), 'chars',sum(len(v or '') for v in vals), 'sample',repr((vals[0] or '')[:150]))\r\nPY\r\n"]
[34.00637, "i", "python3 - <<'PY'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\np='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\nds=load_dataset('parquet', data_files=p, split='train')\nrows=[r for r in ds if str(r['domain']).lower()=='science']\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\ndef n(s): return len(tok.encode(s or '', add_special_tokens=False))\nfor k in ['deepseek_reasoning','deepseek_solution']:\n print(k, sum(n(r[k]) for r in rows))\nprint('reasoning+solution separate sum',sum(n(r['deepseek_reasoning'])+n(r['deepseek_solution']) for r in rows))\nprint('concat with newline',sum(n((r['deepseek_reasoning'] or '')+'\\n'+(r['deepseek_solution'] or '')) for r in rows))\nPY\n"]
[34.00777, "o", "python3 - <<'PY'\r\nfrom datasets import load_dataset\r\nfrom transformers import AutoTokenizer\r\np='https://huggingface.co/datasets/ryanmarten/OpenThoughts-1k-sample/resolve/main/metadata/train-00000-of-00001.parquet'\r\nds=load_dataset('parquet', data_files=p, split='train')\r\nrows=[r for r in ds if str(r['domain']).lower()=='science']\r\ntok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\r\ndef n(s): return len(tok.encode(s or '', add_special_tokens=False))\r\nfor k in ['deepseek_reasoning','deepseek_solution']:\r\n print(k, sum(n(r[k]) for r in rows))\r\nprint('reasoning+solution separate sum',sum(n(r['deepseek_reasoning'])+n(r['deepseek_solution']) for r in rows))\r\nprint('concat with newline',sum(n((r['deepseek_reasoning'] or '')+'\\n'+(r['deepseek_solution'] or '')) for r in rows))\r\nPY\r\n"]
