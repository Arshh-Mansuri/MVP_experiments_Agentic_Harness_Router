[48.199923, "i", "python3 - <<'PY'\nimport math\nW=2400;H=1800\nwant={(y,x) for y in [0,100,300,600,900,1200,1500,1799] for x in [0,300,600,900,1200,1500,1800,2100,2399]}\nwant|={(y,1200) for y in range(0,H,100)}\nsamp={};mn=[999]*3;mx=[0]*3;sm=[0]*3;ss=[0]*3;n=0\nwith open('/app/image.ppm','rb') as f:\n def nums():\n  for line in f:\n   for z in line.split(): yield z\n it=nums(); magic=next(it); w=int(next(it)); h=int(next(it)); maxv=int(next(it));print('header',magic,w,h,maxv)\n for y in range(h):\n  for x in range(w):\n   p=(int(next(it)),int(next(it)),int(next(it)));n+=1\n   for c,v in enumerate(p):mn[c]=min(mn[c],v);mx[c]=max(mx[c],v);sm[c]+=v;ss[c]+=v*v\n   if (y,x) in want:samp[y,x]=p\nprint('pixels',n,'min',mn,'max',mx)\nprint('mean',[round(v/n,3) for v in sm],'std',[round(math.sqrt(ss[i]/n-(sm[i]/n)**2),3) for i in range(3)])\nxs=[0,300,600,900,1200,1500,1800,2100,2399]\nfor y in [0,100,300,600,900,1200,1500,1799]:print('row',y,[samp[y,x] for x in xs])\nprint('vertical',[(y,samp[y,1200]) for y in range(0,H,100)])\nPY\n"]
