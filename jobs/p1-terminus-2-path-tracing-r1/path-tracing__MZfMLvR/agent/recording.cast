[15.521103, "i", "python3 - <<'PY'\nimport numpy as np\np='/app/image.ppm'\nwith open(p,'rb') as f:\n b=f.read()\n# locate the fourth whitespace-delimited token, then parse all remaining ASCII numbers\nq=0\nfor _ in range(4):\n while q<len(b) and b[q] in b' \\t\\r\\n': q+=1\n while q<len(b) and b[q] not in b' \\t\\r\\n': q+=1\na=np.fromstring(b[q:].decode(),dtype=np.uint8,sep=' ')\na=a.reshape(1800,2400,3)\nprint('shape',a.shape,'minmax',a.min(axis=(0,1)),a.max(axis=(0,1)))\nprint('mean',a.mean(axis=(0,1)),'std',a.reshape(-1,3).std(axis=0))\nprint('unique colors',len(np.unique(a.reshape(-1,3),axis=0)))\nfor y in [0,100,300,600,900,1200,1500,1799]:\n print('row',y,a[y,[0,300,600,900,1200,1500,1800,2100,2399]].tolist())\nprint('vertical samples at x=1200')\nfor y in range(0,1800,100): print(y,a[y,1200].tolist(),end='; ')\nprint()\nPY\n"]
[15.521713, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/image.ppm'\r\n\u001b[?2004l\r"]
