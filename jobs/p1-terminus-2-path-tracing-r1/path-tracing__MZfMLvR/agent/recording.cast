[29.376756, "i", "python3 - <<'PY'\nimport re, math\nW,H=2400,1800\nwant={(y,x) for y in [0,100,300,600,900,1200,1500,1799] for x in [0,300,600,900,1200,1500,1800,2100,2399]}\nwant |= {(y,1200) for y in range(0,H,100)}\nsamp={}; n=0; mn=[999]*3; mx=[0]*3; sm=[0]*3; ss=[0]*3\nwith open('/app/image.ppm','rb') as f:\n def nums():\n  for line in f:\n   for z in line.split(): yield int(z)\n it=nums()\n magic=next(it); w=next(it); h=next(it); maxv=next(it)\n print('header',magic,w,h,maxv)\n for y in range(h):\n  for x in range(w):\n   p=(next(it),next(it),next(it)); n+=1\n   for c,v in enumerate(p):\n    mn[c]=min(mn[c],v);mx[c]=max(mx[c],v);sm[c]+=v;ss[c]+=v*v\n   if (y,x) in want:samp[(y,x)]=p\nprint('pixels',n,'min',mn,'max',mx)\nprint('mean',[v/n for v in sm],'std',[math.sqrt(ss[i]/n-(sm[i]/n)**2) for i in range(3)])\nfor y in [0,100,300,600,900,1200,1500,1799]:\n print('row',y,[samp[(y,x)] for x in [0,300,600,900,1200,1500,1800,2100,2399]])\nprint('vertical',[(y,samp[(y,1200)]) for y in range(0,H,100)])\nPY\n"]
