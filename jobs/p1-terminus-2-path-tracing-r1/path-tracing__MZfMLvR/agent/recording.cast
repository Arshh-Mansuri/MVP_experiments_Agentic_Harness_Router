[85.390473, "i", "python3 - <<'PY'\n# Since each pixel is visibly written as one line, print selected data lines.\n# Header is 3 lines; pixel index i starts at line 4.\nimport subprocess\nfor y in [0,300,600,900,1200,1500,1799]:\n ids=[3+y*2400+x for x in [0,300,600,900,1200,1500,1800,2100,2399]]\n # awk avoids loading the large file in Python\n expr=';'.join('NR==%d{print}'%(i+1) for i in ids)\n print('ROW',y)\n subprocess.run(['awk',expr,'/app/image.ppm'])\nPY\n"]
