import json
import os
from datetime import datetime
import pandas as pd

paths = {
    'source_a': '/data/source_a/users.json',
    'source_b': '/data/source_b/users.csv',
    'source_c': '/data/source_c/users.parquet',
}

# Read each source while preserving source identity and original column names.
with open(paths['source_a'], 'r', encoding='utf-8') as f:
    raw_a = json.load(f)
if isinstance(raw_a, dict):
    for key in ('users', 'data', 'records'):
        if key in raw_a and isinstance(raw_a[key], list):
            raw_a = raw_a[key]
            break
    else:
        raw_a = [raw_a]
frames = {
    'source_a': pd.DataFrame(raw_a),
    'source_b': pd.read_csv(paths['source_b']),
    'source_c': pd.read_parquet(paths['source_c']),
}

field_map = {
    'user_id': ['user_id', 'id', 'userId'],
    'email': ['email', 'email_address'],
    'name': ['full_name', 'name', 'userName'],
    'created_date': ['registration_date', 'created_at', 'joined'],
    'status': ['status'],
}

def normalize_date(value):
    if pd.isna(value) or value == '':
        return None
    # Handle timestamps, ISO strings, and common date formats consistently.
    try:
        parsed = pd.to_datetime(value, errors='coerce')
        if pd.isna(parsed):
            return str(value)
        return parsed.strftime('%Y-%m-%d')
    except Exception:
        return str(value)

def clean_value(value, field):
    if pd.isna(value):
        return None
    if field == 'user_id':
        return int(value)
    if field == 'created_date':
        return normalize_date(value)
    return str(value)

normalized = {}
for source, frame in frames.items():
    # Make column matching tolerant of accidental whitespace.
    frame = frame.rename(columns={c: str(c).strip() for c in frame.columns})
    records = []
    for _, row in frame.iterrows():
        record = {}
        for unified, candidates in field_map.items():
            found = None
            for col in candidates:
                if col in frame.columns and not pd.isna(row[col]) and row[col] != '':
                    found = row[col]
                    break
            record[unified] = clean_value(found, unified) if found is not None else None
        if record['user_id'] is not None:
            records.append(record)
    normalized[source] = records

# Group records by ID. If a source has duplicate IDs, use its first non-null value
# for selection, while still allowing all source-level values to be compared.
by_id = {}
for source in ('source_a', 'source_b', 'source_c'):
    for rec in normalized[source]:
        uid = rec['user_id']
        by_id.setdefault(uid, {}).setdefault(source, []).append(rec)

out_rows = []
conflicts = []
merge_fields = ['name', 'email', 'created_date', 'status']
for uid in sorted(by_id):
    source_records = by_id[uid]
    selected_row = {'user_id': uid}
    for field in merge_fields:
        source_values = {}
        for source in ('source_a', 'source_b', 'source_c'):
            vals = [r.get(field) for r in source_records.get(source, [])]
            vals = [v for v in vals if v is not None]
            if vals:
                # Deduplicate while preserving order for conflict comparison.
                unique = []
                for v in vals:
                    if v not in unique:
                        unique.append(v)
                source_values[source] = unique[0]
        # Highest-priority available value wins.
        selected = None
        for source in ('source_a', 'source_b', 'source_c'):
            if source in source_values:
                selected = source_values[source]
                break
        selected_row[field] = selected
        distinct = []
        for value in source_values.values():
            if value not in distinct:
                distinct.append(value)
        if len(distinct) > 1:
            conflicts.append({
                'user_id': uid,
                'field': field,
                'values': {s: source_values[s] for s in ('source_a', 'source_b', 'source_c') if s in source_values},
   pandas True
pyarrow True
