[18.845989, "o", "        for source in ('source_a', 'source_b', 'source_c'):\r\n\u001b[?2004l\r\u001b[?2004h>             if source in source_values:\r\n\u001b[?2004l\r\u001b[?2004h>                 selected = source_values[source]\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         selected_row[field] = selected\r\n\u001b[?2004l\r\u001b[?2004h>         distinct = []\r\n\u001b[?2004l\r\u001b[?2004h>         for value in source_values.values():\r\n\u001b[?2004l\r\u001b[?2004h>             if value not in distinct:\r\n\u001b[?2004l\r\u001b[?2004h>                 distinct.append(value)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(distinct) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>             conflicts.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 'user_id': uid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.846035, "o", "                'field': field,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.846283, "o", "                'values': {s: source_values[s] for s in ('source_a', 'source_b', 'source_c') if s in source_values},\r\n\u001b[?2004l\r\u001b[?2004h>                 'selected': selected,\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.846312, "o", "    out_rows.append(selected_row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[18.846402, "o", "\u001b[?2004h> "]
[18.846619, "o", "out = pd.DataFrame(out_rows, columns=['user_id', 'name', 'email', 'created_date', 'status'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.84664, "o", "> "]
