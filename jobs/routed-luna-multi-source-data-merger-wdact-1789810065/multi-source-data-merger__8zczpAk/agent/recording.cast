[17.996903, "i", "cat > /app/merge_users.py <<'PY'\nimport json\nimport os\nfrom datetime import datetime\nimport pandas as pd\n\npaths = {\n    'source_a': '/data/source_a/users.json',\n    'source_b': '/data/source_b/users.csv',\n    'source_c': '/data/source_c/users.parquet',\n}\n\n# Read each source while preserving source identity and original column names.\nwith open(paths['source_a'], 'r', encoding='utf-8') as f:\n    raw_a = json.load(f)\nif isinstance(raw_a, dict):\n    for key in ('users', 'data', 'records'):\n        if key in raw_a and isinstance(raw_a[key], list):\n            raw_a = raw_a[key]\n            break\n    else:\n        raw_a = [raw_a]\nframes = {\n    'source_a': pd.DataFrame(raw_a),\n    'source_b': pd.read_csv(paths['source_b']),\n    'source_c': pd.read_parquet(paths['source_c']),\n}\n\nfield_map = {\n    'user_id': ['user_id', 'id', 'userId'],\n    'email': ['email', 'email_address'],\n    'name': ['full_name', 'name', 'userName'],\n    'created_date': ['registration_date', 'created_at', 'joined'],\n    'status': ['status'],\n}\n\ndef normalize_date(value):\n    if pd.isna(value) or value == '':\n        return None\n    # Handle timestamps, ISO strings, and common date formats consistently.\n    try:\n        parsed = pd.to_datetime(value, errors='coerce')\n        if pd.isna(parsed):\n            return str(value)\n        return parsed.strftime('%Y-%m-%d')\n    except Exception:\n        return str(value)\n\ndef clean_value(value, field):\n    if pd.isna(value):\n        return None\n    if field == 'user_id':\n        return int(value)\n    if field == 'created_date':\n        return normalize_date(value)\n    return str(value)\n\nnormalized = {}\nfor source, frame in frames.items():\n    # Make column matching tolerant of accidental whitespace.\n    frame = frame.rename(columns={c: str(c).strip() for c in frame.columns})\n    records = []\n    for _, row in frame.iterrows():\n        record = {}\n        for unified, candidates in field_map.items():\n            found = None\n            for col in candidates:\n                if col in frame.columns and not pd.isna(row[col]) and row[col] != '':\n                    found = row[col]\n                    break\n            record[unified] = clean_value(found, unified) if found is not None else None\n        if record['user_id'] is not None:\n            records.append(record)\n    normalized[source] = records\n\n# Group records by ID. If a source has duplicate IDs, use its first non-null value\n# for selection, while still allowing all source-level values to be compared.\nby_id = {}\nfor source in ('source_a', 'source_b', 'source_c'):\n    for rec in normalized[source]:\n        uid = rec['user_id']\n        by_id.setdefault(uid, {}).setdefault(source, []).append(rec)\n\nout_rows = []\nconflicts = []\nmerge_fields = ['name', 'email', 'created_date', 'status']\nfor uid in sorted(by_id):\n    source_records = by_id[uid]\n    selected_row = {'user_id': uid}\n    for field in merge_fields:\n        source_values = {}\n        for source in ('source_a', 'source_b', 'source_c'):\n            vals = [r.get(field) for r in source_records.get(source, [])]\n            vals = [v for v in vals if v is not None]\n            if vals:\n                # Deduplicate while preserving order for conflict comparison.\n                unique = []\n                for v in vals:\n                    if v not in unique:\n                        unique.append(v)\n                source_values[source] = unique[0]\n        # Highest-priority available value wins.\n        selected = None\n        for source in ('source_a', 'source_b', 'source_c'):\n            if source in source_values:\n                selected = source_values[source]\n                break\n        selected_row[field] = selected\n        distinct = []\n        for value in source_values.values():\n            if value not in distinct:\n                distinct.append(value)\n        if len(distinct) > 1:\n            conflicts.append({\n                'user_id': uid,\n                'field': field,\n                'values': {s: source_values[s] for s in ('source_a', 'source_b', 'source_c') if s in source_values},\n   "]
[17.999234, "i", "             'selected': selected,\n            })\n    out_rows.append(selected_row)\n\nout = pd.DataFrame(out_rows, columns=['user_id', 'name', 'email', 'created_date', 'status'])\nout['user_id'] = out['user_id'].astype('int64')\nfor col in ['name', 'email', 'created_date', 'status']:\n    out[col] = out[col].astype('string')\nout.to_parquet('/app/merged_users.parquet', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\nprint(f'wrote {len(out)} rows and {len(conflicts)} conflicts')\nPY\npython3 /app/merge_users.py\n"]
[18.000424, "o", "cat > /app/merge_users.py <<'PY'\r\nimport json\r\nimport os\r\nfrom datetime import datetime\r\nimport pandas as pd\r\n\r\npaths = {\r\n    'source_a': '/data/source_a/users.json',\r\n    'source_b': '/data/source_b/users.csv',\r\n    'source_c': '/data/source_c/users.parquet',\r\n}\r\n\r\n# Read each source while preserving source identity and original column names.\r\nwith open(paths['source_a'], 'r', encoding='utf-8') as f:\r\n    raw_a = json.load(f)\r\nif isinstance(raw_a, dict):\r\n    for key in ('users', 'data', 'records'):\r\n        if key in raw_a and isinstance(raw_a[key], list):\r\n            raw_a = raw_a[key]\r\n            break\r\n    else:\r\n        raw_a = [raw_a]\r\nframes = {\r\n    'source_a': pd.DataFrame(raw_a),\r\n    'source_b': pd.read_csv(paths['source_b']),\r\n    'source_c': pd.read_parquet(paths['source_c']),\r\n}\r\n\r\nfield_map = {\r\n    'user_id': ['user_id', 'id', 'userId'],\r\n    'email': ['email', 'email_address'],\r\n    'name': ['full_name', 'name', 'userName'],\r\n    'created_date': ['registration_date', 'created_at', 'joined'],\r\n    'status': ['status'],\r\n}\r\n\r\ndef normalize_date(value):\r\n    if pd.isna(value) or value == '':\r\n        return None\r\n    # Handle timestamps, ISO strings, and common date formats consistently.\r\n    try:\r\n        parsed = pd.to_datetime(value, errors='coerce')\r\n        if pd.isna(parsed):\r\n            return str(value)\r\n        return parsed.strftime('%Y-%m-%d')\r\n    except Exception:\r\n        return str(value)\r\n\r\ndef clean_value(value, field):\r\n    if pd.isna(value):\r\n        return None\r\n    if field == 'user_id':\r\n        return int(value)\r\n    if field == 'created_date':\r\n        return normalize_date(value)\r\n    return str(value)\r\n\r\nnormalized = {}\r\nfor source, frame in frames.items():\r\n    # Make column matching tolerant of accidental whitespace.\r\n    frame = frame.rename(columns={c: str(c).strip() for c in frame.columns})\r\n    records = []\r\n    for _, row in frame.iterrows():\r\n        record = {}\r\n        for unified, candidates in field_map.items():\r\n            found = None\r\n            for col in candidates:\r\n                if col in frame.columns and not pd.isna(row[col]) and row[col] != '':\r\n                    found = row[col]\r\n                    break\r\n            record[unified] = clean_value(found, unified) if found is not None else None\r\n        if record['user_id'] is not None:\r\n            records.append(record)\r\n    normalized[source] = records\r\n\r\n# Group records by ID. If a source has duplicate IDs, use its first non-null value\r\n# for selection, while still allowing all source-level values to be compared.\r\nby_id = {}\r\nfor source in ('source_a', 'source_b', 'source_c'):\r\n    for rec in normalized[source]:\r\n        uid = rec['user_id']\r\n        by_id.setdefault(uid, {}).setdefault(source, []).append(rec)\r\n\r\nout_rows = []\r\nconflicts = []\r\nmerge_fields = ['name', 'email', 'created_date', 'status']\r\nfor uid in sorted(by_id):\r\n    source_records = by_id[uid]\r\n    selected_row = {'user_id': uid}\r\n    for field in merge_fields:\r\n        source_values = {}\r\n        for source in ('source_a', 'source_b', 'source_c'):\r\n            vals = [r.get(field) for r in source_records.get(source, [])]\r\n            vals = [v for v in vals if v is not None]\r\n            if vals:\r\n                # Deduplicate while preserving order for conflict comparison.\r\n                unique = []\r\n                for v in vals:\r\n                    if v not in unique:\r\n                        unique.append(v)\r\n                source_values[source] = unique[0]\r\n        # Highest-priority available value wins.\r\n        selected = None\r\n        for source in ('source_a', 'source_b', 'source_c'):\r\n            if source in source_values:\r\n                selected = source_values[source]\r\n                break\r\n        selected_row[field] = selected\r\n        distinct = []\r\n        for value in source_values.values():\r\n            if value not in distinct:\r\n                distinct.append(value)\r\n        if len(distinct) > 1:\r\n            conflicts.append({\r\n                'user_id': uid,\r\n                'field': field,\r\n    "]
