[44.60329, "i", "python3 - <<'PY'\nimport json, re, pandas as pd\np='/app/merged_users.parquet'\nc='/app/conflicts.json'\ndf=pd.read_parquet(p)\nwith open(c) as f: report=json.load(f)\nassert list(df.columns) == ['user_id','name','email','created_date','status']\nassert df.user_id.dtype == 'int64'\nassert df.user_id.nunique() == len(df) == 4\nassert df.created_date.dropna().astype(str).str.fullmatch(r'\\d{4}-\\d{2}-\\d{2}').all()\nassert report['total_conflicts'] == len(report['conflicts'])\nprint('VALID')\nprint('rows:', len(df), 'unique ids:', df.user_id.nunique())\nprint('columns:', list(df.columns))\nprint('date format valid:', True)\nprint('conflicts:', report['total_conflicts'])\nprint(df.to_string(index=False))\nPY\n"]
