[635.244785, "o", "s=s.replace(\"donor='MGSSHHHHHHSSGENLYFQGHMVSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFAVACFSRYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\", \"donor='MSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFAVACFSRYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.245043, "o", "s=s.replace(\"link='GSGSGSGSGS'\", \"link='GSGSG'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.245784, "o", "# If still over the limit, trim only the terminal GFP tail while preserving its complete chromophore/core region.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.246545, "o", "s=s.replace(\"parts=[gfp[1:],link,donor[1:],link,dhfr[1:],link,acceptor[1:],link,molecule[1:]]\", \"parts=[gfp[1:201],link,donor[1:],link,dhfr[1:],link,acceptor[1:],link,molecule[1:]]\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
