[18.501872, "i", "cat > /tmp/query.py <<'PY'\nimport requests, json, re, os\nids=open('/app/pdb_ids.txt').read().split()\nos.makedirs('/tmp/pdb',exist_ok=True)\nfor pid in ids:\n    pid=pid.upper()\n    u=f'https://data.rcsb.org/rest/v1/core/entry/{pid}'\n    try:\n        e=requests.get(u,timeout=20).json()\n        print('\\n###',pid, e.get('struct',{}).get('title',''))\n        print('keywords:',e.get('struct_keywords',{}))\n        for ent in e.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n            x=requests.get(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{ent}',timeout=20).json()\n            d=x.get('rcsb_polymer_entity',{})\n            desc=d.get('pdbx_description')\n            seq=x.get('entity_poly',{}).get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n            print('ENTITY',ent,'DESC',desc,'LEN',len(seq),'SEQ',seq[:80])\n        open(f'/tmp/pdb/{pid}.json','w').write(json.dumps(e))\n    except Exception as ex: print(pid,'ERROR',repr(ex))\nprint('\\nFPBASE probes')\nfor u in ['http"]
