[35.734866, "i", "cat > /tmp/query.py <<'PY'\nimport urllib.request, urllib.error, json, os\n\ndef getjson(url):\n    req=urllib.request.Request(url,headers={'User-Agent':'Mozilla/5.0'})\n    with urllib.request.urlopen(req,timeout=30) as r:\n        return json.loads(r.read().decode())\n\ndef gettext(url):\n    req=urllib.request.Request(url,headers={'User-Agent':'Mozilla/5.0'})\n    with urllib.request.urlopen(req,timeout=30) as r:\n        return r.read().decode()\n\nids=open('/app/pdb_ids.txt').read().split()\nos.makedirs('/tmp/pdb',exist_ok=True)\nfor pid in ids:\n    pid=pid.upper()\n    try:\n        e=getjson(f'https://data.rcsb.org/rest/v1/core/entry/{pid}')\n        print('\\n###',pid, e.get('struct',{}).get('title',''))\n        print('keywords:',e.get('struct_keywords',{}))\n        ents=e.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[])\n        for ent in ents:\n            x=getjson(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{ent}')\n            d=x.get('rcsb_polymer_entity',{})\n            desc=d.g"]
