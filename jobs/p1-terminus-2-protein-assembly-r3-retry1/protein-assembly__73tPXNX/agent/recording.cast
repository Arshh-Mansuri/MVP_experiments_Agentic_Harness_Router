[512.264385, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse,re,html\nqs=['\"EKFYGYDYW\" antibody GFP','\"GQSHVPYTFGGGTK\" antibody','\"KASGYSFTTYTIH\" GFP antibody','\"QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIH\"']\nfor q in qs:\n u='https://www.bing.com/search?format=rss&q='+urllib.parse.quote(q)\n try:\n  d=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=20).read().decode('utf8','ignore')\n  d=html.unescape(d)\n  items=re.findall(r'<item>(.*?)</item>',d,re.S)\n  print('\\n###',q)\n  for z in items[:8]: print(' '.join(re.sub('<[^>]+>',' ',z).split())[:800])\n except Exception as e: print(e)\nPY\n"]
