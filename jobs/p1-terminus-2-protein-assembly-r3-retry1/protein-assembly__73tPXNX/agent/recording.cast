[596.371503, "i", "cat > /tmp/make_gblock.py <<'PY'\nfrom itertools import product\n# Canonical EGFP/GFP antigen sequence recognized by the supplied anti-GFP antibody.\ngfp='MSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFSYGVQCFSRYPDHMKQHDFFKSAMPEGYVQERTIFFKDDGNYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNIEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSTQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\n# 5WJ2 RCSB sequence, with its unresolved X represented by the known Clover residue A.\ndonor='MGSSHHHHHHSSGENLYFQGHMVSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFAVACFSRYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\n# DHFR translation copied from plasmid.gb.\ndhfr='MISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR'\n# 2H5Q RCSB mCherry sequence.\nacceptor='MVSKGEEDNMAIIKEFMRFKVHMEGSVN"]
[596.372437, "o", "cat > /tmp/make_gblock.py <<'PY'\r\n\u001b[?2004l\r"]
[596.372501, "i", "GHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFASKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQDSSLQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'\n# 3KZY human SNAP-tag sequence.\nmolecule='GPGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'\nlink='GSGSGSGSGS'\nparts=[gfp[1:],link,donor[1:],link,dhfr[1:],link,acceptor[1:],link,molecule[1:]]\naa=''.join(parts)\n# Diverse codons, selected to maintain balanced composition.\ncodons={\n'A':['GCT','GCC','GCA','GCG'],'C':['TGT','TGC'],'D':['GAT','GAC'],'E':['GAA','GAG'],\n'F':['TTT','TTC'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],\n'K':['AAA','AAG'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'M':['ATG'],'N':['AAT','AAC'],\n'P':['CCT','CCC','CCA','CCG'],'Q':['CAA','CAG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],\n'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T'"]
[596.373846, "i", ":['ACT','ACC','ACA','ACG'],'V':['GTT','GTC','GTA','GTG'],\n'W':['TGG'],'Y':['TAT','TAC']}\ndef gc(s): return sum(c in 'GC' for c in s)\n# Greedy codon choice with a strong penalty for invalid recent windows and moderate global balance.\ndna=''\nfor i,aa1 in enumerate(aa):\n    opts=codons[aa1]\n    best=None\n    for c in opts:\n        trial=dna+c\n        if len(trial)>=50:\n            w=trial[-50:]; frac=gc(w)/50\n            penalty=0 if .30<=frac<=.70 else 10000+abs(frac-.5)*1000\n        else: penalty=0\n        fracall=gc(trial)/len(trial)\n        score=penalty+abs(fracall-.50)*2+abs(gc(c)/3-.5)*.05\n        if best is None or score<best[0]: best=(score,c)\n    dna+=best[1]\n# Repair any invalid window with a synonymous codon substitution, repeatedly.\nfor iteration in range(10000):\n    bad=None\n    for start in range(max(1,len(dna)-49)):\n        w=dna[start:start+50]; f=gc(w)/50\n        if f<.30 or f>.70: bad=(start,f); break\n    if bad is None: break\n    start,_=bad; changed=False\n    for pos in range(max(0,start-2),"]
[596.374755, "o", "GHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFASKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQDSSLQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'\r\n# 3KZY human SNAP-tag sequence.\r\nmolecule='GPGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'\r\nlink='GSGSGSGSGS'\r\nparts=[gfp[1:],link,donor[1:],link,dhfr[1:],link,acceptor[1:],link,molecule[1:]]\r\naa=''.join(parts)\r\n# Diverse codons, selected to maintain balanced composition.\r\ncodons={\r\n'A':['GCT','GCC','GCA','GCG'],'C':['TGT','TGC'],'D':['GAT','GAC'],'E':['GAA','GAG'],\r\n'F':['TTT','TTC'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],\r\n'K':['AAA','AAG'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'M':['ATG'],'N':['AAT','AAC'],\r\n'P':['CCT','CCC','CCA','CCG'],'Q':['CAA','CAG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],\r\n'S':['TCT','TCC','TCA','TCG','AGT"]
[596.374906, "i", "min(len(aa),start+52)):\n        old=dna[pos*3:pos*3+3]\n        for c in codons[aa[pos]]:\n            if c==old: continue\n            nd=dna[:pos*3]+c+dna[pos*3+3:]\n            ok=True\n            for s in range(max(0,pos*3-49),min(len(nd)-49,pos*3+50)):\n                f=gc(nd[s:s+50])/50\n                if not .30<=f<=.70: ok=False; break\n            if ok: dna=nd; changed=True; break\n        if changed: break\n    if not changed: raise RuntimeError('Could not satisfy GC constraint')\nassert len(dna)<=3000\nassert dna==dna.upper() and set(dna)<=set('ACGT')\nassert not dna.startswith('ATG') and not dna.endswith(('TAA','TAG','TGA'))\nassert len(parts)==9 and parts[0] and parts[-1]\nassert all(.30<=gc(dna[i:i+50])/50<=.70 for i in range(len(dna)-49))\n# Verify translated sequence using the selected codons.\ntrans=''.join(next(k for k,v in codons.items() if dna[i:i+3] in v) for i in range(0,len(dna),3))\nassert trans==aa\nopen('/app/gblock.txt','w').write(dna+'\\n')\nprint('aa_len',len(aa),'nt_len',len(dna),'gc',gc(dna)/len"]
