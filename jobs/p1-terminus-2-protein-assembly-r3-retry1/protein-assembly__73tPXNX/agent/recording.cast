[680.991477, "i", "python3 - <<'PY'\np='/app/gblock.txt'\nraw=open(p).read()\nlines=raw.splitlines()\nassert len(lines)==1 and lines[0]\ns=lines[0]\nassert len(s)<=3000 and set(s)<=set('ACGT')\nassert not s.startswith('ATG')\nassert s[-3:] not in {'TAA','TAG','TGA'}\nassert all(0.30 <= sum(c in 'GC' for c in s[i:i+50])/50 <= 0.70 for i in range(len(s)-49))\nprint('validated:',p,'length=',len(s),'single_line=True','gc_windows=True')\nPY\n"]
