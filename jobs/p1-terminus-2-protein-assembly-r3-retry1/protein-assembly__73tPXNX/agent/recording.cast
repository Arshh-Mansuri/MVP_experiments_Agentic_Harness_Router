[680.995514, "o", "\u001b[?2004h> p='/app/gblock.txt'\r\n\u001b[?2004l\r\u001b[?2004h> raw=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> lines=raw.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> assert len(lines)==1 and lines[0]\r\n\u001b[?2004l\r\u001b[?2004h> s=lines[0]\r\n\u001b[?2004l\r\u001b[?2004h> assert len(s)<=3000 and set(s)<=set('ACGT')\r\n\u001b[?2004l\r\u001b[?2004h> assert not s.startswith('ATG')\r\n\u001b[?2004l\r\u001b[?2004h> assert s[-3:] not in {'TAA','TAG','TGA'}\r\n\u001b[?2004l\r\u001b[?2004h> assert all(0.30 <= sum(c in 'GC' for c in s[i:i+50])/50 <= 0.70 for i in range(len(s)-49))\r\n\u001b[?2004l\r\u001b[?2004h> print('validated:',p,'length=',len(s),'single_line=True','gc_windows=True')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
