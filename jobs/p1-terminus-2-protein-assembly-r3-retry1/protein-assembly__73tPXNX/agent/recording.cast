[371.996, "i", "python3 - <<'PY'\nimport urllib.request,urllib.parse\n# OAS search API/page for distinctive antibody CDR3\nfor u in ['https://opig.stats.ox.ac.uk/webapps/oas/oasdatabase/','https://opig.stats.ox.ac.uk/webapps/oas/oasdatabase/sequence_search/']:\n try:\n  r=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=20); print(u,r.status,r.read(1000))\n except Exception as e: print(u,e)\nPY\n"]
