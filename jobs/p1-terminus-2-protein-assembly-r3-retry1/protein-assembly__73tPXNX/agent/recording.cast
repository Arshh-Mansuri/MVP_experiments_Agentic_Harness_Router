[399.800744, "i", "cat > /tmp/blast.py <<'PY'\nimport urllib.request,urllib.parse,time,re\nseqs={\n'heavy':'QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSSAS',\n'light':'DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIRRADAAPTVSIFPPS'\n}\ndef post(data):\n d=urllib.parse.urlencode(data).encode(); req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi',data=d,headers={'User-Agent':'Mozilla/5.0'})\n return urllib.request.urlopen(req,timeout=60).read().decode('utf8','ignore')\nfor name,seq in seqs.items():\n t=post({'CMD':'Put','PROGRAM':'blastp','DATABASE':'nr','QUERY':seq,'EXPECT':'1000','HITLIST_SIZE':'20','FORMAT_TYPE':'XML'})\n print(name,'submit',len(t),t[:500]); open('/tmp/'+name+'_submit.txt','w').write(t)\n rid=re.search(r'RID = ([A-Z0-9-]+)',t)\n if not rid: continue\n rid=rid.group(1); print('RID',rid)\n for i in range(12):\n  time.sleep(10)\n  x=post({'CMD':'Get','RID':rid,'FORMAT_TYPE':'XML"]
