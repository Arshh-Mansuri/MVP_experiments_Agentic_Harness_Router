[?2004hroot@ba3539c75eb7:/app# python3 - <<'PY'
[?2004l[?2004h> # Generate an SVG of all extrusion paths in object 0, separated by layer/segment.
[?2004l[?2004h> import re
[?2004l[?2004h> lines=open('/app/text.gcode').read().splitlines(); inside=False; segs=[]
[?2004l[?2004h> for line in lines:
[?2004l[?2004h>     if line.strip()=='M486 S0': inside=True; paths=[]; cur=[]; segs.append(paths)
[?2004l[?2004h>     elif inside and line.strip()=='M486 S-1':
[?2004l[?2004h>         if cur: paths.append(cur)
[?2004l[?2004h>         inside=False
[?2004l[?2004h>     elif inside:
[?2004l[?2004h>         m=re.match(r'G1\s+(.+)',line)
[?2004l[?2004h>         if not m: continue
[?2004l[?2004h>         z=m.group(1); x=re.search(r'\bX(-?[0-9.]+)',z); y=re.search(r'\bY(-?[0-9.]+)',z); e=re.search(r'\bE(-?[0-9.]+)',z)
[?2004l[?2004h>         if x and y and e:
[?2004l[?2004h>             pt=(float(x.group(1)),float(y.group(1)))
[?2004l[?2004h>             if float(e.group(1))>0:
[?2004l[?2004h>                 cur.append(pt)
[?2004l[?2004h>             elif cur:
[?2004l[?2004h>                 paths.append(cur); cur=[]
[?2004l[?2004h> if cur: paths.append(cur)
[?2004l[?2004h> # use all paths and map coordinates into an SVG
[?2004l[?2004h> allp=[p for ss in segs for p in ss for _ in [0]]
