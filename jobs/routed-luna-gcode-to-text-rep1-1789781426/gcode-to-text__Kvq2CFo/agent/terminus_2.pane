[?2004l[?2004h> import re
[?2004l[?2004h> p='/app/text.gcode'
[?2004l[?2004h> lines=open(p).read().splitlines()
[?2004l[?2004h> inside=False; seg=[]; segments=[]
[?2004l[?2004h> for i,line in enumerate(lines,1):
[?2004l[?2004h>     if line.strip()=='M486 S0':
[?2004l[?2004h>         inside=True; seg=[]; start=i
[?2004l[?2004h>     elif inside and line.strip()=='M486 S-1':
[?2004l[?2004h>         segments.append((start,i,seg)); inside=False
[?2004l[?2004h>     elif inside:
[?2004l[?2004h>         m=re.match(r'G1\s+(.+)',line)
[?2004l[?2004h>         if m and (' E' in ' '+m.group(1)):
[?2004l[?2004h>             x=re.search(r'\bX(-?[0-9.]+)',m.group(1)); y=re.search(r'\bY(-?[0-9.]+)',m.group(1)); e=re.search(r'\bE(-?[0-9.]+)',m.group(1))
[?2004l[?2004h>             if x and y and e and float(e.group(1))>0: seg.append((float(x.group(1)),float(y.group(1)),float(e.group(1)),i))
[?2004l[?2004h> for n,(a,b,s) in enumerate(segments):
[?2004l[?2004h>     print(n,a,b,'points',len(s))
[?2004l[?2004h>     if s:
[?2004l[?2004h>         print(' bounds',min(x for x,y,e,i in s),max(x for x,y,e,i in s),min(y for x,y,e,i in s),max(y for x,y,e,i in s))
[?2004l[?2004h>         print(' ',s[:12])
