[82.620979, "o", "\u001b[?2004hroot@ba3539c75eb7:/app# "]
[83.575434, "i", "python3 - <<'PY'\nimport re,math\nlines=open('/app/text.gcode').read().splitlines(); inside=False; start=0; x=y=0.; seg=[]\nfor line in lines:\n s=line.strip()\n if s=='M486 S0': inside=True; start=1; seg=[]\n elif inside and s=='M486 S-1':\n  if seg: last=seg\n  inside=False\n elif inside:\n  m=re.match(r'G1\\s+(.*)',s)\n  if not m: continue\n  a=m.group(1); ox,oy=x,y\n  q=re.search(r'(?:^|\\s)X(-?[0-9.]+)',a); r=re.search(r'(?:^|\\s)Y(-?[0-9.]+)',a); e=re.search(r'(?:^|\\s)E(-?[0-9.]+)',a)\n  if q:x=float(q.group(1))\n  if r:y=float(r.group(1))\n  if e and float(e.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y))\n# use section 10366 by locating its coordinates from file directly\ninside=False; x=y=0.; seg=[]\nfor no,line in enumerate(lines,1):\n s=line.strip()\n if no==10366: inside=True; seg=[]\n if inside:\n  if s=='M486 S-1': break\n  m=re.match(r'G1\\s+(.*)',s)\n  if not m: continue\n  a=m.group(1); ox,oy=x,y\n  q=re.search(r'(?:^|\\s)X(-?[0-9.]+)',a); r=re.search(r'(?:^|\\s)Y(-?[0-9.]+)',a); e=re.search(r'(?:^|\\s)E(-?[0-9.]+)'"]
[83.575961, "i", ",a)\n  if q:x=float(q.group(1))\n  if r:y=float(r.group(1))\n  if e and float(e.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y))\npts=[(a,b) for a,b,c,d in seg]+[(c,d) for a,b,c,d in seg]; mnx=min(x for x,y in pts);mxx=max(x for x,y in pts);mny=min(y for x,y in pts);mxy=max(y for x,y in pts)\nW,H=50,30; g=[[' ']*W for _ in range(H)]\nfor a,b,c,d in seg:\n n=max(2,int(math.hypot(c-a,d-b)*20))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=min(W-1,max(0,int((xx-mnx)/(mxx-mnx)*(W-1)))); iy=min(H-1,max(0,int((yy-mny)/(mxy-mny)*(H-1)))); g[H-1-iy][ix]='█'\nprint('final short text section,',len(seg),'segments')\nfor row in g: print(''.join(row))\nPY\n"]
[83.576198, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[83.576304, "o", ",a)\r\n  if q:x=float(q.group(1))\r\n  if r:y=float(r.group(1))\r\n  if e and float(e.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y))\r\npts=[(a,b) for a,b,c,d in seg]+[(c,d) for a,b,c,d in seg]; mnx=min(x for x,y in pts);mxx=max(x for x,y in pts);mny=min(y for x,y in pts);mxy=max(y for x,y in pts)\r\nW,H=50,30; g=[[' ']*W for _ in range(H)]\r\nfor a,b,c,d in seg:\r\n n=max(2,int(math.hypot(c-a,d-b)*20))\r\n for k in range(n+1):\r\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=min(W-1,max(0,int((xx-mnx)/(mxx-mnx)*(W-1)))); iy=min(H-1,max(0,int((yy-mny)/(mxy-mny)*(H-1)))); g[H-1-iy][ix]='█'\r\nprint('final short text section,',len(seg),'segments')\r\nfor row in g: print(''.join(row))\r\nPY\r\n\u001b[?2004h> import re,math\r\n\u001b[?2004l\r"]
