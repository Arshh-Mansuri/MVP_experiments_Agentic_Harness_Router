[93.979405, "i", "python3 - <<'PY'\nimport re,math\nL=open('/app/text.gcode').read().splitlines(); seg=[]; x=y=0.; active=False\nfor no,line in enumerate(L,1):\n s=line.strip()\n if no==10366: active=True\n if active and s=='M486 S-1': break\n if not active: continue\n m=re.match(r'G1\\s+(.*)',s)\n if not m: continue\n a=m.group(1); ox,oy=x,y\n q=re.search(r'(?:^|\\s)X(-?[0-9.]+)',a); r=re.search(r'(?:^|\\s)Y(-?[0-9.]+)',a); e=re.search(r'(?:^|\\s)E(-?[0-9.]+)',a)\n if q:x=float(q.group(1))\n if r:y=float(r.group(1))\n if e and float(e.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y))\nfor ang in [-60,-45,-30,0,30,45,60]:\n t=math.radians(ang); co,si=math.cos(t),math.sin(t)\n def R(x,y): return (x*co-y*si,x*si+y*co)\n ss=[(*R(a,b),*R(c,d)) for a,b,c,d in seg]\n pts=[(a,b) for a,b,c,d in ss]+[(c,d) for a,b,c,d in ss]; mnx=min(a for a,b in pts);mxx=max(a for a,b in pts);mny=min(b for a,b in pts);mxy=max(b for a,b in pts)\n W,H=55,25; g=[[' ']*W for _ in range(H)]\n for a,b,c,d in ss:\n  n=max(2,int(math.hypot(c-a,d-b)*25))\n  for k in range(n+1):\n"]
[93.981483, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[93.981517, "i", "   u=k/n; xx=a+(c-a)*u; yy=b+(d-b)*u; ix=min(W-1,max(0,int((xx-mnx)/(mxx-mnx)*(W-1)))); iy=min(H-1,max(0,int((yy-mny)/(mxy-mny)*(H-1)))); g[H-1-iy][ix]='█'\n print('\\nANGLE',ang)\n for row in g: print(''.join(row))\nPY\n"]
