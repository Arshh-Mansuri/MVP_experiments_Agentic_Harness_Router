[51.233066, "i", "python3 - <<'PY'\nimport re, math\nlines=open('/app/text.gcode').read().splitlines()\ninside=False; obj=[]; x=y=0.0; start=0\n# collect only the short object-0 sections before the final large section\nfor no,line in enumerate(lines,1):\n    s=line.strip()\n    if s=='M486 S0':\n        inside=True; start=no; obj=[]\n    elif inside and s=='M486 S-1':\n        if start < 15014: obj.append(('END',))\n        inside=False\n    elif inside and start < 15014:\n        m=re.match(r'G1\\\\s+(.*)',s)\n        if not m: continue\n        args=m.group(1)\n        nx=re.search(r'(?:^|\\\\s)X(-?[0-9.]+)',args); ny=re.search(r'(?:^|\\\\s)Y(-?[0-9.]+)',args); ne=re.search(r'(?:^|\\\\s)E(-?[0-9.]+)',args)\n        ox,oy=x,y\n        if nx: x=float(nx.group(1))\n        if ny: y=float(ny.group(1))\n        if ne and float(ne.group(1))>0 and (x!=ox or y!=oy): obj.append((ox,oy,x,y))\npts=[p for p in obj if p[0]!='END']\nmnx=min(min(a,c) for a,b,c,d in pts); mxx=max(max(a,c) for a,b,c,d in pts)\nmny=min(min(b,d) for a,b,c,d in pts); mxy=max(max(b,d) for a,b"]
[51.233758, "i", ",c,d in pts)\nprint('segments',len(pts),'bounds',mnx,mxx,mny,mxy)\nW=100; H=50; grid=[[0]*W for _ in range(H)]\nfor a,b,c,d in pts:\n    for k in range(max(1,int(math.hypot(c-a,d-b)*12))):\n        t=k/max(1,int(math.hypot(c-a,d-b)*12)); xx=a+(c-a)*t; yy=b+(d-b)*t\n        ix=int((xx-mnx)/(mxx-mnx)*(W-1)); iy=int((yy-mny)/(mxy-mny)*(H-1)); grid[iy][ix]=1\nfor reverse in (True,False):\n    print('\\\\n--- orientation ---')\n    rows=grid[::-1] if reverse else grid\n    for row in rows:\n        print(''.join('##' if v else '  ' for v in row))\nPY\n"]
