[59.510287, "i", "python3 - <<'PY'\nimport re, math\nlines=open('/app/text.gcode').read().splitlines()\ninside=False; segments=[]; x=y=0.0; start=0\nfor no,line in enumerate(lines,1):\n    s=line.strip()\n    if s=='M486 S0':\n        inside=True; start=no\n    elif inside and s=='M486 S-1':\n        inside=False\n    elif inside and start < 15014:\n        m=re.match(r'G1\\s+(.*)',s)\n        if not m: continue\n        args=m.group(1); ox,oy=x,y\n        nx=re.search(r'(?:^|\\s)X(-?[0-9.]+)',args); ny=re.search(r'(?:^|\\s)Y(-?[0-9.]+)',args); ne=re.search(r'(?:^|\\s)E(-?[0-9.]+)',args)\n        if nx: x=float(nx.group(1))\n        if ny: y=float(ny.group(1))\n        if ne and float(ne.group(1))>0 and (x!=ox or y!=oy): segments.append((ox,oy,x,y))\nprint('segments',len(segments))\nmnx=min(min(a,c) for a,b,c,d in segments); mxx=max(max(a,c) for a,b,c,d in segments); mny=min(min(b,d) for a,b,c,d in segments); mxy=max(max(b,d) for a,b,c,d in segments)\nprint('bounds',mnx,mxx,mny,mxy)\nW,H=100,50; grid=[[0]*W for _ in range(H)]\nfor a,b,c,d in segments:\n"]
[59.511843, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[59.513318, "i", "    n=max(2,int(math.hypot(c-a,d-b)*20))\n    for k in range(n+1):\n        t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n        ix=min(W-1,max(0,int((xx-mnx)/(mxx-mnx)*(W-1)))); iy=min(H-1,max(0,int((yy-mny)/(mxy-mny)*(H-1))))\n        grid[iy][ix]=1\nfor reverse in (True,False):\n    print('\\n--- orientation ---')\n    for row in (grid[::-1] if reverse else grid): print(''.join('##' if v else '  ' for v in row))\nPY\n"]
