[27.073212, "i", "python3 - <<'PY'\nimport re\np='/app/text.gcode'\nlines=open(p).read().splitlines()\ninside=False; seg=[]; segments=[]\nfor i,line in enumerate(lines,1):\n    if line.strip()=='M486 S0':\n        inside=True; seg=[]; start=i\n    elif inside and line.strip()=='M486 S-1':\n        segments.append((start,i,seg)); inside=False\n    elif inside:\n        m=re.match(r'G1\\s+(.+)',line)\n        if m and (' E' in ' '+m.group(1)):\n            x=re.search(r'\\bX(-?[0-9.]+)',m.group(1)); y=re.search(r'\\bY(-?[0-9.]+)',m.group(1)); e=re.search(r'\\bE(-?[0-9.]+)',m.group(1))\n            if x and y and e and float(e.group(1))>0: seg.append((float(x.group(1)),float(y.group(1)),float(e.group(1)),i))\nfor n,(a,b,s) in enumerate(segments):\n    print(n,a,b,'points',len(s))\n    if s:\n        print(' bounds',min(x for x,y,e,i in s),max(x for x,y,e,i in s),min(y for x,y,e,i in s),max(y for x,y,e,i in s))\n        print(' ',s[:12])\nPY\n"]
