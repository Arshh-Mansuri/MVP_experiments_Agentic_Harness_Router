[42.287386, "i", "python3 - <<'PY'\n# Print a coarse ASCII rendering of the early text geometry for direct visual inspection.\nfrom PIL import Image\nfor fn in ['/app/text_normal.png','/app/text_flip.png']:\n im=Image.open(fn).resize((80,80)).convert('L')\n print('\\n',fn)\n for y in range(80):\n  print(''.join('##' if im.getpixel((x,y))<128 else '  ' for x in range(80)))\nPY\n"]
