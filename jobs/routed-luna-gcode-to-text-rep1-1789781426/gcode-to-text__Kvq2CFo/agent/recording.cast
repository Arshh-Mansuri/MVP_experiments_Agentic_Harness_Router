[28.079159, "i", "python3 - <<'PY'\n# Generate an SVG of all extrusion paths in object 0, separated by layer/segment.\nimport re\nlines=open('/app/text.gcode').read().splitlines(); inside=False; segs=[]\nfor line in lines:\n    if line.strip()=='M486 S0': inside=True; paths=[]; cur=[]; segs.append(paths)\n    elif inside and line.strip()=='M486 S-1':\n        if cur: paths.append(cur)\n        inside=False\n    elif inside:\n        m=re.match(r'G1\\s+(.+)',line)\n        if not m: continue\n        z=m.group(1); x=re.search(r'\\bX(-?[0-9.]+)',z); y=re.search(r'\\bY(-?[0-9.]+)',z); e=re.search(r'\\bE(-?[0-9.]+)',z)\n        if x and y and e:\n            pt=(float(x.group(1)),float(y.group(1)))\n            if float(e.group(1))>0:\n                cur.append(pt)\n            elif cur:\n                paths.append(cur); cur=[]\nif cur: paths.append(cur)\n# use all paths and map coordinates into an SVG\nallp=[p for ss in segs for p in ss for _ in [0]]\npts=[q for ss in segs for p in ss for q in p]\nmnx=min(x for x,y in pts); mxx=max(x for x,y in pts); mn"]
[28.079995, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[28.080047, "i", "y=min(y for x,y in pts); mxy=max(y for x,y in pts)\nsc=8; out=[]\nfor ss in segs:\n  for p in ss:\n    if len(p)>1:\n      d='M '+' '.join(f'{(x-mnx)*sc:.1f},{(mxy-y)*sc:.1f}' for x,y in p)\n      out.append(f'<path d=\"{d}\" fill=\"none\" stroke=\"black\" stroke-width=\"1\"/>')\nopen('/app/text.svg','w').write(f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{(mxx-mnx)*sc:.0f}\" height=\"{(mxy-mny)*sc:.0f}\" viewBox=\"0 0 {(mxx-mnx)*sc:.0f} {(mxy-mny)*sc:.0f}\">'+''.join(out)+'</svg>')\nprint('wrote /app/text.svg',len(out),'paths', 'bounds',mnx,mxx,mny,mxy)\nPY\n"]
