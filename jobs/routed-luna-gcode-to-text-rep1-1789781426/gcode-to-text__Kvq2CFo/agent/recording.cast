[40.262755, "i", "python3 - <<'PY'\nimport re\nfrom PIL import Image,ImageDraw\nlines=open('/app/text.gcode').read().splitlines()\ninside=False; paths=[]; cur=[]\nfor line in lines:\n    if line.strip()=='M486 S0':\n        inside=True; cur=[]\n    elif inside and line.strip()=='M486 S-1':\n        if cur: paths.append(cur)\n        cur=[]; inside=False\n    elif inside:\n        m=re.match(r'G1\\s+(.+)',line)\n        if not m: continue\n        s=m.group(1); x=re.search(r'\\bX(-?[0-9.]+)',s); y=re.search(r'\\bY(-?[0-9.]+)',s); e=re.search(r'\\bE(-?[0-9.]+)',s)\n        if x and y and e and float(e.group(1))>0 and len(paths)<11:\n            cur.append((float(x.group(1)),float(y.group(1))))\n# retain only the 11 short text-layer sections, not the huge final section\npts=[q for p in paths[:11] for q in p]\nmnx=min(x for x,y in pts); mxx=max(x for x,y in pts); mny=min(y for x,y in pts); mxy=max(y for x,y in pts)\nfor flip in (False,True):\n    sc=100; W=int((mxx-mnx)*sc)+100; H=int((mxy-mny)*sc)+100\n    im=Image.new('L',(W,H),255); d=ImageDraw.Draw(im)"]
[40.263008, "i", "\n    for p in paths[:11]:\n        if len(p)>1:\n            q=[((x-mnx)*sc+50, ((y-mny) if flip else (mxy-y))*sc+50) for x,y in p]\n            d.line(q,fill=0,width=8,joint='curve')\n    name=f'/app/text_{{\"flip\" if flip else \"normal\"}}.png'; im.save(name); print(name,im.size)\nPY\nfor f in /app/text_normal.png /app/text_flip.png; do echo ===$f===; tesseract \"$f\" stdout --psm 6 2>/dev/null || true; done\n"]
