[68.998538, "i", "python3 - <<'PY'\nimport re,math\nlines=open('/app/text.gcode').read().splitlines(); sections=[]; inside=False; start=0; x=y=0.; seg=[]\nfor no,line in enumerate(lines,1):\n s=line.strip()\n if s=='M486 S0': inside=True; start=no; seg=[]\n elif inside and s=='M486 S-1':\n  if start<15014: sections.append((start,seg))\n  inside=False\n elif inside and start<15014:\n  m=re.match(r'G1\\s+(.*)',s)\n  if not m: continue\n  a=m.group(1); ox,oy=x,y\n  q=re.search(r'(?:^|\\s)X(-?[0-9.]+)',a); r=re.search(r'(?:^|\\s)Y(-?[0-9.]+)',a); e=re.search(r'(?:^|\\s)E(-?[0-9.]+)',a)\n  if q:x=float(q.group(1))\n  if r:y=float(r.group(1))\n  if e and float(e.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y))\nprint('sections:',[(a,len(b)) for a,b in sections])\nfor si,(st,ss) in enumerate(sections[-3:]):\n pts=[(a,b) for a,b,c,d in ss]+[(c,d) for a,b,c,d in ss]\n mnx=min(p[0] for p in pts);mxx=max(p[0] for p in pts);mny=min(p[1] for p in pts);mxy=max(p[1] for p in pts)\n W,H=80,50; g=[[0]*W for _ in range(H)]\n for a,b,c,d in ss:\n  n=max(2,int(mat"]
[68.999047, "i", "h.hypot(c-a,d-b)*30))\n  for k in range(n+1):\n   t=k/n;xx=a+(c-a)*t;yy=b+(d-b)*t\n   ix=min(W-1,max(0,int((xx-mnx)/(mxx-mnx)*(W-1))));iy=min(H-1,max(0,int((yy-mny)/(mxy-mny)*(H-1))))\n   g[iy][ix]=1\n print('\\nSECTION',st,'bounds',mnx,mxx,mny,mxy)\n for row in g[::-1]: print(''.join('█' if z else ' ' for z in row))\nPY\n"]
