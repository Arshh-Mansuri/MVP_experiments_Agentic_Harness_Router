#include <stdio.h>
int main(){FILE*f=fopen("/app/image.ppm","r");int w,h,m,x,y,r,g,b;fscanf(f,"P3%d%d%d",&w,&h,&m);printf("%d %d %d\n",w,h,m);for(y=0;y<30;y++){for(x=0;x<60;x++){int xx=x*w/60,yy=y*h/30,i;rewind(f);fscanf(f,"P3%d%d%d",&w,&h,&m);for(i=0;i<yy*w+xx;i++)fscanf(f,"%d%d%d",&r,&g,&b);fscanf(f,"%d%d%d",&r,&g,&b);putchar((r+g+b)/3>220?'#':(r+g+b)/3>150?'+':(r+g+b)/3>80?'.':' ');}putchar('\n');}fclose(f);}
EOF
