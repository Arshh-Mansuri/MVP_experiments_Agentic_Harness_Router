import re
p='/app/image.ppm'
with open(p) as f:
    vals=[]
    for line in f:
        if not line.startswith('#'):
            vals += line.split()
            if len(vals)>=4: break
w,h,m=map(int,vals[1:4]); print('size',w,h,m)
# stream all numbers after header, retain a 60x45 nearest-neighbor grid and color extrema
sx,sy=60,45; grid=[[None]*sx for _ in range(sy)]; n=0; mn=[255]*3; mx=[0]*3
with open(p) as f:
    for line in f:
        if line.startswith(('P','#')): continue
        for z in line.split():
            v=int(z); k=n%3; mn[k]=min(mn[k],v); mx[k]=max(mx[k],v); n+=1
            pix=n//3-1; x=pix%w; y=pix//w
            if n%3==0 and x%(w//sx)==w//sx//2 and y%(h//sy)==h//sy//2:
                grid[y//(h//sy)][x//(w//sx)]=tuple(int(a) for a in [])
print('numbers',n,'range',mn,mx)
# second pass, directly sample based on pixel index
with open(p) as f:
    it=(int(z) for line in f if not line.startswith(('P','#')) for z in line.split())
    for y in range(h):
      for x in range(w):
        r,g,b=next(it),next(it),next(it)
        if x%(w//sx)==w//sx//2 and y%(h//sy)==h//sy//2: grid[y//(h//sy)][x//(w//sx)]=(r,g,b)
for row in grid:
 print(' '.join('%02x%02x%02x'%p for p in row))
