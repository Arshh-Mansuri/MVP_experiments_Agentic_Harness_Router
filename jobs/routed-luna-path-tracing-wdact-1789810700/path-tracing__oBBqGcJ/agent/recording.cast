[268.598576, "i", "cat > /app/image.c <<'EOF'\n#include <stdio.h>\n#include <math.h>\nint main(){int W=2400,H=1800,x,y;FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(y=0;y<H;y++)for(x=0;x<W;x++){double X=(double)x/W,Y=(double)y/H;int r=159-55*Y,g=198-65*Y,b=255;double z=0;if(Y>.62){z=67;if(fabs(X-.5)<.38)z=152;if(fabs(X-.5)<.29&&Y>.72)z=67;if(fabs(X-.19)<.08&&Y>.68)z=67;if(fabs(X-.81)<.08&&Y>.68)z=67;if(Y>.88)z=152;if(Y>.94)z=67;r=g=b=z;}r+=3*sin(18*X+5*Y);if(r<0)r=0;if(r>255)r=255;if(g<0)g=0;if(g>255)g=255;unsigned char p[3]={r,g,b};fwrite(p,1,3,f);}fclose(f);return 0;}\nEOF\ngcc -static -o /app/image /app/image.c -lm && /app/image && ls -lh /app/image.c /app/image /app/reconstructed.ppm && head -c 32 /app/reconstructed.ppm | od -An -tc\n"]
[268.627025, "o", "cat > /app/image.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r"]
[268.630833, "o", "\u001b[?2004h> #include <math.h>\r\n\u001b[?2004l\r\u001b[?2004h> int main(){int W=2400,H=1800,x,y;FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(y=0;y<H;y++)for(x=0;x<W;x++){double X=(double)x/W,Y=(double)y/H;int r=159-55*Y,g=198-65*Y,b=255;double z=0;if(Y>.62){z=67;if(fabs(X-.5)<.38)z=152;if(fabs(X-.5)<.29&&Y>.72)z=67;if(fabs(X-.19)<.08&&Y>.68)z=67;if(fabs(X-.81)<.08&&Y>.68)z=67;if(Y>.88)z=152;if(Y>.94)z=67;r=g=b=z;}r+=3*sin(18*X+5*Y);if(r<0)r=0;if(r>255)r=255;if(g<0)g=0;if(g>255)g=255;unsigned char p[3]={r,g,b};fwrite(p,1,3,f);}fclose(f);return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
