[6.987164, "i", "cd /app && ls -l image.ppm && head -c 200 image.ppm | od -An -tc && python3 - <<'PY'\nfrom collections import Counter\np='/app/image.ppm'\nwith open(p,'rb') as f:\n    tok=[]\n    while len(tok)<4:\n        x=f.readline()\n        if not x: break\n        if x.startswith(b'#'): continue\n        tok += x.split()\n    print('header',tok[:4])\n    w,h,m=map(int,tok[1:4]); data=f.read()\n    a=list(data[:w*h*3])\n    c=Counter(zip(a[0::3],a[1::3],a[2::3]))\n    print('size',w,h,'bytes',len(data),'unique',len(c),'top',c.most_common(20))\nPY\n"]
[7.038092, "o", "cd /app && ls -l image.ppm && head -c 200 image.ppm | od -An -tc && python3 - <<'PY'\r\n\u001b[?2004l\r"]
