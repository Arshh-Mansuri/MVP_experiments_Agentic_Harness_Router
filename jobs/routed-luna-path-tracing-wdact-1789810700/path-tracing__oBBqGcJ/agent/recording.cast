[236.856834, "i", "cat > image.c <<'EOF'\n#include <stdio.h>\n#include <math.h>\nint main(){int w=2400,h=1800,x,y;FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",w,h);for(y=0;y<h;y++)for(x=0;x<w;x++){double X=x/(double)w,Y=y/(double)h,t=Y;int r=20+130*(1-t),g=40+160*(1-t),b=110+145*(1-t);double q=0;if(Y>.57){q=Y*255;if(fmod(X*8+Y*3,2)<1)q-=35;r=g=b=(int)q;}if(Y>.72&&fabs(X-.5)<.34)r=g=b=67;if(Y>.78&&fabs(X-.5)<.25)r=g=b=152;if(Y>.84&&fabs(X-.5)<.17)r=g=b=67;if(Y>.9)r=g=b=152;unsigned char c[3]={r<0?0:r>255?255:r,g<0?0:g>255?255:g,b<0?0:b>255?255:b};fwrite(c,1,3,f);}fclose(f);}\nEOF\ngcc -static -o image image.c -lm && ./image && ls -lh image.c reconstructed.ppm && head -c 32 reconstructed.ppm | od -An -tc\n"]
[236.877042, "o", "cat > image.c <<'EOF'\r\n#include <stdio.h>\r\n#include <math.h>\r\nint main(){int w=2400,h=1800,x,y;FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",w,h);for(y=0;y<h;y++)for(x=0;x<w;x++){double X=x/(double)w,Y=y/(double)h,t=Y;int r=20+130*(1-t),g=40+160*(1-t),b=110+145*(1-t);double q=0;if(Y>.57){q=Y*255;if(fmod(X*8+Y*3,2)<1)q-=35;r=g=b=(int)q;}if(Y>.72&&fabs(X-.5)<.34)r=g=b=67;if(Y>.78&&fabs(X-.5)<.25)r=g=b=152;if(Y>.84&&fabs(X-.5)<.17)r=g=b=67;if(Y>.9)r=g=b=152;unsigned char c[3]={r<0?0:r>255?255:r,g<0?0:g>255?255:g,b<0?0:b>255?255:b};fwrite(c,1,3,f);}fclose(f);}\r\nEOF\r\ngcc -static -o image image.c -lm && ./image && ls -lh image.c reconstructed.ppm && head -c 32 reconstructed.ppm | od -An -tc\r\n"]
