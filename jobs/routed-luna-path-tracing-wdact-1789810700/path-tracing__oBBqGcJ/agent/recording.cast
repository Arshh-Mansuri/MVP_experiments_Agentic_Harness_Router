[106.840696, "i", "cat >/tmp/grid.c <<'EOF'\n#include <stdio.h>\nint main(){FILE*f=fopen(\"/app/image.ppm\",\"r\");int w,h,m,r,g,b,x,y,X,Y;fscanf(f,\"P3%d%d%d\",&w,&h,&m);int sx=60,sy=45,n[60][45]={},R[60][45]={},G[60][45]={},B[60][45]={};for(y=0;y<h;y++)for(x=0;x<w;x++){fscanf(f,\"%d%d%d\",&r,&g,&b);X=x*sx/w;Y=y*sy/h;n[X][Y]++;R[X][Y]+=r;G[X][Y]+=g;B[X][Y]+=b;}for(Y=0;Y<sy;Y++){for(X=0;X<sx;X++){r=R[X][Y]/n[X][Y];g=G[X][Y]/n[X][Y];b=B[X][Y]/n[X][Y];printf(\"%02x%02x%02x \",r/16*16,g/16*16,b/16*16);}puts(\"\");}}\nEOF\ngcc -O2 -o /tmp/grid /tmp/grid.c && /tmp/grid > /tmp/grid.txt && sed -n '1,45p' /tmp/grid.txt\n"]
[106.843088, "o", "cat >/tmp/grid.c <<'EOF'\r\n#include <stdio.h>\r\nint main(){FILE*f=fopen(\"/app/image.ppm\",\"r\");int w,h,m,r,g,b,x,y,X,Y;fscanf(f,\"P3%d%d%d\",&w,&h,&m);int sx=60,sy=45,n[60][45]={},R[60][45]={},G[60][45]={},B[60][45]={};for(y=0;y<h;y++)for(x=0;x<w;x++){fscanf(f,\"%d%d%d\",&r,&g,&b);X=x*sx/w;Y=y*sy/h;n[X][Y]++;R[X][Y]+=r;G[X][Y]+=g;B[X][Y]+=b;}for(Y=0;Y<sy;Y++){for(X=0;X<sx;X++){r=R[X][Y]/n[X][Y];g=G[X][Y]/n[X][Y];b=B[X][Y]/n[X][Y];printf(\"%02x%02x%02x \",r/16*16,g/16*16,b/16*16);}puts(\"\");}}\r\nEOF\r\ngcc -O2 -o /tmp/grid /tmp/grid.c && /tmp/grid > /tmp/grid.txt && sed -n '1,45p' /tmp/grid.txt\r\n"]
