[155.959765, "i", "cat >/tmp/fast.c <<'EOF'\n#include <stdio.h>\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32&&c!=EOF);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\nint main(){int w=q(),h=q(),m=q(),x,y,k,X,Y,sx=60,sy=45,n[2700]={},a[8100]={};for(y=0;y<h;y++)for(x=0;x<w;x++)for(k=0;k<3;k++){int v=q();X=x*sx/w;Y=y*sy/h;n[Y*sx+X]++;a[(Y*sx+X)*3+k]+=v;}for(Y=0;Y<sy;Y++){for(X=0;X<sx;X++){int j=Y*sx+X;printf(\"%02x%02x%02x \",a[j*3]/n[j]/16*16,a[j*3+1]/n[j]/16*16,a[j*3+2]/n[j]/16*16);}putchar(10);}}\nEOF\ngcc -O3 -o /tmp/fast /tmp/fast.c && /tmp/fast </app/image.ppm > /tmp/grid.txt && sed -n '1,45p' /tmp/grid.txt\n"]
[156.021736, "o", "cat >/tmp/fast.c <<'EOF'\r\n#include <stdio.h>\r\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32&&c!=EOF);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\r\nint main(){int w=q(),h=q(),m=q(),x,y,k,X,Y,sx=60,sy=45,n[2700]={},a[8100]={};for(y=0;y<h;y++)for(x=0;x<w;x++)for(k=0;k<3;k++){int v=q();X=x*sx/w;Y=y*sy/h;n[Y*sx+X]++;a[(Y*sx+X)*3+k]+=v;}for(Y=0;Y<sy;Y++){for(X=0;X<sx;X++){int j=Y*sx+X;printf(\"%02x%02x%02x \",a[j*3]/n[j]/16*16,a[j*3+1]/n[j]/16*16,a[j*3+2]/n[j]/16*16);}putchar(10);}}\r\nEOF\r\ngcc -O3 -o /tmp/fast /tmp/fast.c && /tmp/fast </app/image.ppm > /tmp/grid.txt && sed -n '1,45p' /tmp/grid.txt\r\n"]
