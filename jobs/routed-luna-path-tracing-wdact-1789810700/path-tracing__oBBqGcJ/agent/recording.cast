[191.946503, "i", "cat >/tmp/thumb.c <<'EOF'\n#include <stdio.h>\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\nint main(){int w=q(),h=q(),m=q(),x,y,r,g,b,X,Y;for(y=0;y<h;y++)for(x=0;x<w;x++){r=q();g=q();b=q();if(x%(w/30)==w/60&&y%(h/20)==h/40){X=x/(w/30);Y=y/(h/20);printf(\"%d %d %d %d %d\\n\",X,Y,r,g,b);}}}\nEOF\ngcc -O3 -o /tmp/thumb /tmp/thumb.c && /tmp/thumb </app/image.ppm | sort -nk2,2 -nk1,1\n"]
[191.947141, "o", "cat >/tmp/thumb.c <<'EOF'\r\n#include <stdio.h>\r\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\r\nint main(){int w=q(),h=q(),m=q(),x,y,r,g,b,X,Y;for(y=0;y<h;y++)for(x=0;x<w;x++){r=q();g=q();b=q();if(x%(w/30)==w/60&&y%(h/20)==h/40){X=x/(w/30);Y=y/(h/20);printf(\"%d %d %d %d %d\\n\",X,Y,r,g,b);}}}\r\nEOF\r\ngcc -O3 -o /tmp/thumb /tmp/thumb.c && /tmp/thumb </app/image.ppm | sort -nk2,2 -nk1,1\r\n"]
