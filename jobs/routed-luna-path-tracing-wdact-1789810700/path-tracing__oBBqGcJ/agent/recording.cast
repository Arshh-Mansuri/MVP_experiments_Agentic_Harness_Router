[215.738552, "i", "cat >/tmp/thumb.c <<'EOF'\n#include <stdio.h>\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32&&c!=EOF);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\nint main(){int w=q(),h=q(),m=q(),x,y,r,g,b;for(y=0;y<h;y++)for(x=0;x<w;x++){r=q();g=q();b=q();if(x==x/80*80+40&&y==y/90*90+45)printf(\"%d %d %d %d %d\\n\",x/80,y/90,r,g,b);}}\nEOF\ngcc -O3 -o /tmp/thumb /tmp/thumb.c\n/tmp/thumb </app/image.ppm >/tmp/thumb.txt\nhead -30 /tmp/thumb.txt\n"]
[215.742732, "o", "cat >/tmp/thumb.c <<'EOF'\r\n#include <stdio.h>\r\nint q(){int c,v=0;do c=getchar_unlocked();while(c<=32&&c!=EOF);while(c>32){v=v*10+c-48;c=getchar_unlocked();}return v;}\r\nint main(){int w=q(),h=q(),m=q(),x,y,r,g,b;for(y=0;y<h;y++)for(x=0;x<w;x++){r=q();g=q();b=q();if(x==x/80*80+40&&y==y/90*90+45)printf(\"%d %d %d %d %d\\n\",x/80,y/90,r,g,b);}}\r\nEOF\r\ngcc -O3 -o /tmp/thumb /tmp/thumb.c\r\n/tmp/thumb </app/image.ppm >/tmp/thumb.txt\r\nhead -30 /tmp/thumb.txt\r\n"]
