[664.449352, "i", "python3 - <<'PY'\nimport json,re\nx=json.load(open('/app/re.json'))\ns='rnbqkbnrpppppppp................................PPPPPPPPRNBQKBNR w KQkq - 0 1'\n# Find rules containing a source pawn at square a2 (index 48) and destination a4 (index 32).\nfor i,(p,r) in enumerate(x):\n    if 'P' in p and 'a4' not in r and ' b ' in r and len(p)>300:\n        m=re.search(p,s)\n        if m:\n            out=re.sub(p,r,s)\n            if '\\na' in out or ' b ' in out:\n                print(i,repr(p[:180]),repr(r[:220]))\n                print(repr(out[-100:]))\nPY\n"]
