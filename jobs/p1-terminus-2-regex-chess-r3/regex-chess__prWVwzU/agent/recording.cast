[71.297659, "i", "$'\n    old=r'\\g<1>.\\g<2>K.\\g<3> w \\g<4> \\g<5> \\g<6> \\g<7>'\n    new=r'\\g<1>R'+r'K'+r'\\g<2>..'+r'\\g<3> b \\g<4> '+marker+r' 0 0'\n  add(pat,old+'\\n'+new)\n\n# Remove lines where the white king is attacked by a black piece.\ndef attack_filter(k, j, kind, path=()):\n  look=[r'(?=.{'+str(k)+'}K)', r'(?=.{'+str(j)+'}'+kind+')']\n  look += [r'(?=.{'+str(x)+'}\\.)' for x in path]\n  add(r'^'+''.join(look)+r'.* b .*$','')\n\nfor kr in range(8):\n for kc in range(8):\n  k=idx(kr,kc)\n  # black pawn attacks downward toward increasing row\n  for dc in (-1,1):\n   if inside(kr-1,kc+dc): attack_filter(k,idx(kr-1,kc+dc),'p')\n  # king and knight\n  for dr in (-1,0,1):\n   for dc in (-1,0,1):\n    if (dr or dc) and inside(kr+dr,kc+dc): attack_filter(k,idx(kr+dr,kc+dc),'k')\n  for dr,dc in [(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]:\n   if inside(kr+dr,kc+dc): attack_filter(k,idx(kr+dr,kc+dc),'n')\n  for dirs,chars in [([(1,0),(-1,0),(0,1),(0,-1)],'[rq]'), ([(1,1),(1,-1),(-1,1),(-1,-1)],'[bq]')]:\n   for dr,dc in dirs:\n    rr,cc=kr+dr"]
