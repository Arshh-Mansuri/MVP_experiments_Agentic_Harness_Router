[433.748346, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re.json'))\nfen='rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'\ns=fen\nprev=1\nfor i,(p,r) in enumerate(rules):\n    old=s\n    s=re.sub(p,r,s)\n    n=len(s.split('\\n'))\n    if n!=prev:\n        print('rule',i,'lines',prev,'=>',n,'pattern',repr(p[:180]),'replacement',repr(r[:80]))\n        if n<prev:\n            print('before lines:',len(old.split('\\n')))\n            print('\\n'.join(old.split('\\n')[:8]))\n            print('after lines:',len(s.split('\\n')))\n            print('\\n'.join(s.split('\\n')[:8]))\n            if n<=1: break\n        prev=n\nPY\n"]
