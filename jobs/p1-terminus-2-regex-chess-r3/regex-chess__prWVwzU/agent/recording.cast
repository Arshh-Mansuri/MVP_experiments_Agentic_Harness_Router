[357.701996, "o", "   if inside(kr-1,kc+dc): attack_filter(k,idx(kr-1,kc+dc),'p')\r\n  # king and knight\r\n  for dr in (-1,0,1):\r\n   for dc in (-1,0,1):\r\n    if (dr or dc) and inside(kr+dr,kc+dc): attack_filter(k,idx(kr+dr,kc+dc),'k')\r\n  for dr,dc in [(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]:\r\n   if inside(kr+dr,kc+dc): attack_filter(k,idx(kr+dr,kc+dc),'n')\r\n  for dirs,chars in [([(1,0),(-1,0),(0,1),(0,-1)],'[rq]'), ([(1,1),(1,-1),(-1,1),(-1,-1)],'[bq]')]:\r\n   for dr,dc in dirs:\r\n    rr,cc=kr+dr,kc+dc; path=[]\r\n    while inside(rr,cc):\r\n     j=idx(rr,cc); attack_filter(k,j,chars,tuple(path)); path.append(j); rr+=dr; cc+=dc\r\n\r\n# Castling transit attacks: marker lines are filtered by testing f1/d1 as an attacked target.\r\n# A conservative set of exact attacker/path filters is generated for those target squares.\r\nfor target,marker in [(5,'castleK'),(3,'castleQ')]:\r\n tr,tc=divmod(target,8)\r\n for kr,kc in [(tr,tc)]:\r\n  for dr in (-1,0,1):\r\n   for dc in (-1,0,1):\r\n    if (dr or dc) and inside(kr+dr,kc+dc):\r\n     j=idx(kr+"]
[357.702125, "o", "dr,kc+dc); add(r'^(?=.{'+str(j)+'}k)(?=.* '+marker+r' .*$).*$', '')\r\n  for dr,dc in [(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]:\r\n   if inside(kr+dr,kc+dc): add(r'^(?=.{'+str(idx(kr+dr,kc+dc))+'}n)(?=.* '+marker+r' .*$).*$', '')\r\n\r\n# Update castling rights from the resulting board. A right is invalid if its king/rook\r\n# is no longer on its original square. Remove one character at a time.\r\nfor pos,ch in [(4,'K'),(0,'Q'),(7,'K'),(60,'k'),(56,'q'),(63,'k')]:\r\n  add(r'^(?=.{'+str(pos)+'}[^'+('K' if pos==4 else 'R' if pos in (0,7) else 'k' if pos==60 else 'r')+r'])(.{64} b )([KQkq-]*)'+ch+r'(.*)$',r'\\g<1>\\g<2>\\g<3>')\r\n# Convert castle markers to normal en-passant field.\r\nadd(r' b castleK ', ' b - ')\r\nadd(r' b castleQ ', ' b - ')\r\n# Remove original white-to-move lines.\r\nadd(r'^.{64} w .*$','')\r\n# Insert rank separators from left to right.\r\nfor n in range(1,8):\r\n  prefix=r'((?:[^/]{8}/){'+str(n-1)+r'}[^/]{8})'\r\n  add(r'^'+prefix+r'(.{'+str(64-8*n)+r'} b .*)$',r'\\g<1>/\\g<2>')\r\n# Compress dot runs, longe"]
