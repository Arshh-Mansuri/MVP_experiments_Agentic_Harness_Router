[504.392019, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\na=s.index('# Update castling rights from the resulting board.')\nb=s.index('# Convert castle markers',a)\nnew=\"\"\"# Update castling rights from the resulting board.\\n# A right is removed if either the relevant king or rook is no longer home.\\nfor pos,expected,right in [\\n (4,'K','K'), (7,'R','K'), (0,'R','Q'),\\n (60,'k','k'), (63,'r','k'), (56,'r','q'),\\n]:\\n  add(r'(?m)^(?=.{'+str(pos)+'}[^'+expected+r'])(.{64} b )([KQkq-]*)'+right+r'(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\n\"\"\"\ns=s[:a]+new+s[b:]\n# Ensure blank lines are removed after all compression rules.\nif \"add(r'(?m)^\\\\n+', '')\" not in s:\n    s=s.replace(\"add(r'\\\\.', '1')\", \"add(r'\\\\.', '1')\\nadd(r'(?m)^\\\\n+', '')\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/make_re.py && python3 /tmp/make_re.py\n"]
