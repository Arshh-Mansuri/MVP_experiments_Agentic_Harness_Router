[71.29718, "i", "' for x in empties)\n  # Exact board captures around e1 and metadata rights.\n  pat=(r'^(.{4})K(.{'+str(dest-5)+'})\\.(.*) w (?=[KQkq-]*'+right+r')([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$')\n  # Simpler exact full-board replacement using a lookahead for path and captures.\n  pat=(r'^(?=.{4}K)(?='+look+r')(.{4})K(.{'+str(dest-5)+'})\\.(.*) w (?=[KQkq-]*'+right+r')([KQkq-]+) ([^ ]+) ([^ ]+)$')\n  # This construction is only reliable for kingside; use explicit board positions instead.\n  if side=='K':\n    pat=r'^(?=.{4}K)(?=.{5}\\.) (?!)'\n  # Emit exact generic full-board pattern with lookaheads and captures.\n  if side=='K':\n    pat=r'^(?=.{4}K)(?=.{5}\\.)(?=.{6}\\.)(.{4})K(.{1})\\.(.*) w (?=[KQkq-]*K)([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$'\n    old=r'\\g<1>K\\g<2>.\\g<3> w \\g<4> \\g<5> \\g<6> \\g<7>'\n    new=r'\\g<1>..'+r'K' + r'R' + r'\\g<3> b \\g<4> '+marker+r' 0 0'\n  else:\n    # e1, empty b1/c1/d1, king c1 and rook d1\n    pat=r'^(?=.{4}K)(?=.{1}\\.)(?=.{2}\\.)(?=.{3}\\.)(.{1})\\.(.{2})K\\.(.*) w (?=[KQkq-]*Q)([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)"]
