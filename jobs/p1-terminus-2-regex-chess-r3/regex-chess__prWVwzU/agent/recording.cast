[1396.279313, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\nneedle=\"add(r'/', '')\\n\"\nrule=\"\"\"add(r'(?m)^(?=.{56}R\\\\.\\\\.\\\\.K\\\\.\\\\.\\\\.)(?=[^ ]* w [KQkq-]*Q)(.{56})R\\\\.\\\\.\\\\.K(.{3}) w ([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$',\\n    r'\\\\g<1>..KR.\\\\g<2> b \\\\g<3> - 0 0')\\n\"\"\"\nassert needle in s\nif rule not in s:\n    s=s.replace(needle,needle+rule,1)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/make_re.py && python3 /tmp/make_re.py\n"]
