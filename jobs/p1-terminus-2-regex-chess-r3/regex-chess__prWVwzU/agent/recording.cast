[421.449271, "o", "     j=idx(kr+dr,kc+dc); add(r'^(?=.{'+str(j)+'}k)(?=.* '+marker+r' .*$).*$', '')\r\n  for dr,dc in [(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]:\r\n   if inside(kr+dr,kc+dc): add(r'^(?=.{'+str(idx(kr+dr,kc+dc))+'}n)(?=.* '+marker+r' .*$).*$', '')\r\n\r\n# Update castling rights from the resulting board. A right is invalid if its king/rook\r\n# is no longer on its original square. Remove one character at a time.\r\nfor pos,ch in [(4,'K'),(0,'Q'),(7,'K'),(60,'k'),(56,'q'),(63,'k')]:\r\n  add(r'^(?=.{'+str(pos)+'}[^'+('K' if pos==4 else 'R' if pos in (0,7) else 'k' if pos==60 else 'r')+r'])(.{64} b )([KQkq-]*)'+ch+r'(.*)$',r'\\g<1>\\g<2>\\g<3>')\r\n# Convert castle markers to normal en-passant field.\r\nadd(r' b castleK ', ' b - ')\r\nadd(r' b castleQ ', ' b - ')\r\n# Remove original white-to-move lines.\r\nadd(r'(?m)^.{64} w .*?(?:\\n|$)', '')\r\n# Insert rank separators from left to right.\r\nfor n in range(1,8):\r\n  prefix=r'((?:[^/]{8}/){'+str(n-1)+r'}[^/]{8})'\r\n  add(r'(?m)^'+prefix+r'(.{'+str(64-8*n)+r'} b .*)$',r'\\g<1>/\\g<2"]
[421.450159, "o", ">')\r\n# Compress dot runs, longest first.\r\nfor n in range(8,1,-1):\r\n  add(r'\\.'*n, str(n))\r\nadd(r'\\.', '1')\r\n\r\nwith open('/app/re.json','w') as f:\r\n json.dump(rules,f,separators=(',',':'))\r\nprint('rules',len(rules),'bytes',__import__('os').path.getsize('/app/re.json'))\r\n"]
[421.659364, "i", "python3 - <<'PY'\nimport json,re\nx=json.load(open('/app/re.json'))\nfen='rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'\ns=fen\nfor i,(p,r) in enumerate(x):\n    s=re.sub(p,r,s)\n    if i>=len(x)-12:\n        print(i,'lines',len(s.split('\\n')))\n        print('\\n'.join(s.split('\\n')[:5]))\nPY\n"]
