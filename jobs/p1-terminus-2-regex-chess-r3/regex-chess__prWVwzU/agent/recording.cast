[1334.809404, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re.json'))\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\ns=fen\nfor n in range(1,9): s=re.sub(str(n)+r'(?=[^ ]* [wb] )','.'*n,s)\ns=s.replace('/','')\ndef show(tag,x):\n print('\\n',tag)\n for z in x.split('\\n'):\n  board=z.split(' ')[0]\n  if len(board)==64 and board[58:60]=='KR' and board[63]=='R': print(repr(z))\nfor i,(p,r) in enumerate(rules):\n old=s; s=re.sub(p,r,s)\n if i in [9,10,11,12,13,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,39"]
