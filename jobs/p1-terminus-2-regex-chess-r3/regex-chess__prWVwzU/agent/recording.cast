[180.434322, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\na=s.index('def normal(')\nb=s.index('\\n# Ordinary white moves.',a)\nnew=r'''def normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None):\n    np=promo or piece\n    rp=rights_pat or r'([KQkq-]+)'\n    # Build a full-board pattern, allowing captures of black pieces or empty squares.\n    cells=[]\n    for i in range(64):\n        if i==s: cells.append(re.escape(piece))\n        elif i==d: cells.append(r'([pnbrqk\\.])')\n        elif i in ():\n            cells.append(r'(.)')\n        else: cells.append(r'(.)')\n    # Path constraints are absolute lookaheads and must be at pattern start.\n    pat='^'+extra_pat+''.join(cells)+r' w '+rp+r' ([^ ]+) ([^ ]+) ([^ ]+)$'\n    # Destination is capture group 1; board unchanged cells are groups 2..65.\n    repl=[]\n    g=2\n    for i in range(64):\n        if i==s: repl.append('.')\n        elif i==d: repl.append(np)\n        else:\n            repl.append(r'\\g<'+str(g)+'>'); g+=1\n    old=[]; g=2\n    for i in range(64):\n        "]
[180.434518, "i", "if i==s: old.append(piece)\n        elif i==d: old.append(r'\\g<1>')\n        else: old.append(r'\\g<'+str(g)+'>'); g+=1\n    # Metadata groups: 66 rights, 67 ep, 68 halfmove, 69 fullmove.\n    old=''.join(old)+r' w \\g<66> \\g<67> \\g<68> \\g<69>'\n    new=''.join(repl)+r' b \\g<66> '+ep+r' 0 0'\n    add(pat,old+'\\n'+new)\n'''\ns=s[:a]+new+s[b:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/make_re.py && python3 /tmp/make_re.py\n"]
