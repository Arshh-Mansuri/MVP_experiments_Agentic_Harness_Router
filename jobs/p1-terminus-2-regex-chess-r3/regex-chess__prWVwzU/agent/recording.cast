[552.381255, "i", "python3 - <<'PY'\nimport sys,json,re\nsys.path.insert(0,'/app')\nfrom check import run_solution\nfen='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'\nprint('OUTPUT')\nprint('\\n'.join(run_solution(fen)))\nx=json.load(open('/app/re.json'))\nprint('RIGHT RULES')\nfor i,(p,r) in enumerate(x):\n if i>6150 and ('([KQkq-]*)' in p or '([KQkq-]' in p): print(i,repr(p),'=>',repr(r))\n# expanded g1 knight position, black to move\nboard='rnbqkbnrpppppppp.....................................N........PPPPPPPRNBQKB.R'\nline=board+' b KQkq - 0 0'\nprint('TEST LINE',line)\nfor i,(p,r) in enumerate(x):\n if '([KQkq-]*)' in p:\n  m=re.search(p,line)\n  if m: print('MATCH',i,repr(p),'=>',repr(re.sub(p,r,line)))\nPY\n"]
