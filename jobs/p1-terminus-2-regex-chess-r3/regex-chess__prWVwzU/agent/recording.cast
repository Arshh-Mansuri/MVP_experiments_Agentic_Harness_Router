[1077.430911, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\na=s.index('# Castling transit attacks:')\nb=s.index('# Update castling rights',a)\nnew=r'''# Castling transit-square attack filters.\n# Correct board indices: d1=59, f1=61.\nfor target,marker in [(61,'castleK'),(59,'castleQ')]:\n    tr,tc=divmod(target,8)\n    # Adjacent black king attacks.\n    for dr in (-1,0,1):\n      for dc in (-1,0,1):\n        if (dr or dc) and inside(tr+dr,tc+dc):\n          j=idx(tr+dr,tc+dc)\n          add(r'(?m)^(?=.* b '+marker+r' .*$)(?=.{'+str(j)+'}k).*$', '')\n    # Black knight attacks.\n    for dr,dc in [(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]:\n      if inside(tr+dr,tc+dc):\n        j=idx(tr+dr,tc+dc)\n        add(r'(?m)^(?=.* b '+marker+r' .*$)(?=.{'+str(j)+'}n).*$', '')\n    # Black pawn attacks upward toward decreasing rank index.\n    for dc in (-1,1):\n      if inside(tr-1,tc+dc):\n        j=idx(tr-1,tc+dc)\n        add(r'(?m)^(?=.* b '+marker+r' .*$)(?=.{'+str(j)+'}p).*$', '')\n    # Sliding attacks, requiring all interv"]
[1077.432215, "o", "python3 - <<'PY'"]
[1077.432617, "i", "ening squares empty.\n    for dirs,chars in [\n      ([(1,0),(-1,0),(0,1),(0,-1)],'[rq]'),\n      ([(1,1),(1,-1),(-1,1),(-1,-1)],'[bq]')]:\n      for dr,dc in dirs:\n        rr,cc=tr+dr,tc+dc; path=[]\n        while inside(rr,cc):\n          j=idx(rr,cc)\n          looks=''.join(r'(?=.{'+str(x)+r'}\\.)' for x in path)\n          add(r'(?m)^(?=.* b '+marker+r' .*$)(?=.{'+str(j)+'}'+chars+r')'+looks+r'.*$', '')\n          path.append(j); rr+=dr; cc+=dc\n\n'''\ns=s[:a]+new+s[b:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/make_re.py && python3 /tmp/make_re.py\n"]
