[1352.029821, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re.json'))\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\ns=fen\nfor i,(p,r) in enumerate(rules[:30]):\n    old=s; s=re.sub(p,r,s)\n    print('\\nRULE',i,repr(p),'=>',repr(r))\n    print('before',repr(old))\n    print('after ',repr(s))\nprint('\\nCASTLE RULES')\nfor i,(p,r) in enumerate(rules):\n    if 'R\\\\.\\\\.\\\\.K' in p or '..KR' in r:\n        print(i,repr(p),'=>',repr(r))\nPY\n"]
