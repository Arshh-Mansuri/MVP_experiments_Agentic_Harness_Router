[1352.036189, "o", "\u001b[?2004h> import json,re\r\n\u001b[?2004l\r\u001b[?2004h> rules=json.load(open('/app/re.json'))\r\n\u001b[?2004l\r\u001b[?2004h> fen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\r\n\u001b[?2004l\r\u001b[?2004h> s=fen\r\n\u001b[?2004l\r\u001b[?2004h> for i,(p,r) in enumerate(rules[:30]):\r\n\u001b[?2004l\r\u001b[?2004h>     old=s; s=re.sub(p,r,s)\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\nRULE',i,repr(p),'=>',repr(r))\r\n\u001b[?2004l\r\u001b[?2004h>     print('before',repr(old))\r\n\u001b[?2004l\r\u001b[?2004h>     print('after ',repr(s))\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nCASTLE RULES')\r\n\u001b[?2004l\r\u001b[?2004h> for i,(p,r) in enumerate(rules):\r\n\u001b[?2004l\r\u001b[?2004h>     if 'R\\\\.\\\\.\\\\.K' in p or '..KR' in r:\r\n\u001b[?2004l\r\u001b[?2004h>         print(i,repr(p),'=>',repr(r))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
