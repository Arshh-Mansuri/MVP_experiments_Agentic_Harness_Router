[71.298088, "i", " pos==4 else 'R' if pos in (0,7) else 'k' if pos==60 else 'r')+r'])(.{64} b )([KQkq-]*)'+ch+r'(.*)$',r'\\g<1>\\g<2>\\g<3>')\n# Convert castle markers to normal en-passant field.\nadd(r' b castleK ', ' b - ')\nadd(r' b castleQ ', ' b - ')\n# Remove original white-to-move lines.\nadd(r'^.{64} w .*$','')\n# Insert rank separators from right to left.\nfor n in range(7,0,-1):\n  pos=8*n+n-1\n  add(r'^(.{'+str(pos)+'})(.{'+str(64-pos)+'} b .*)$',r'\\g<1>/\\g<2>')\n# Compress dot runs, longest first.\nfor n in range(8,1,-1):\n  add(r'\\.'*n, str(n))\n\nwith open('/app/re.json','w') as f:\n json.dump(rules,f,separators=(',',':'))\nprint('rules',len(rules),'bytes',__import__('os').path.getsize('/app/re.json'))\nPY\npython3 /tmp/make_re.py\npython3 - <<'PY'\nimport json,os\nx=json.load(open('/app/re.json'))\nprint(len(x),os.path.getsize('/app/re.json'))\nPY\n"]
