[856.308156, "o", "      for dc in (-1,0,1):\r\n        if (dr or dc) and inside(r+dr,c+dc): normal(s,idx(r+dr,c+dc),'K')\r\n\r\n# Castling. Use marker ep fields until transit-square attack filtering is done.\r\n# e1-g1 and e1-c1, with empty path and required rights.\r\nfor side, dest, rookdest, empties, right, marker in [\r\n ('K',6,5,[5,6],'K','castleK'),('Q',2,3,[1,2,3],'Q','castleQ')]:\r\n  look=''.join(r'(?=.{'+str(x)+'}\\.)' for x in empties)\r\n  # Exact board captures around e1 and metadata rights.\r\n  pat=(r'^(.{4})K(.{'+str(dest-5)+'})\\.(.*) w (?=[KQkq-]*'+right+r')([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$')\r\n  # Simpler exact full-board replacement using a lookahead for path and captures.\r\n  pat=(r'^(?=.{4}K)(?='+look+r')(.{4})K(.{'+str(dest-5)+'})\\.(.*) w (?=[KQkq-]*'+right+r')([KQkq-]+) ([^ ]+) ([^ ]+)$')\r\n  # This construction is only reliable for kingside; use explicit board positions instead.\r\n  if side=='K':\r\n    pat=r'^(?=.{4}K)(?=.{5}\\.) (?!)'\r\n  # Emit exact generic full-board pattern with lookaheads and captures.\r\n  if side=='K':\r"]
[856.30858, "o", "\n    pat=r'^(?=.{4}K)(?=.{5}\\.)(?=.{6}\\.)(.{4})K(.{1})\\.(.*) w (?=[KQkq-]*K)([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$'\r\n    old=r'\\g<1>K\\g<2>.\\g<3> w \\g<4> \\g<5> \\g<6> \\g<7>'\r\n    new=r'\\g<1>..'+r'K' + r'R' + r'\\g<3> b \\g<4> '+marker+r' 0 0'\r\n  else:\r\n    # e1, empty b1/c1/d1, king c1 and rook d1\r\n    pat=r'^(?=.{4}K)(?=.{1}\\.)(?=.{2}\\.)(?=.{3}\\.)(.{1})\\.(.{2})K\\.(.*) w (?=[KQkq-]*Q)([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$'\r\n    old=r'\\g<1>.\\g<2>K.\\g<3> w \\g<4> \\g<5> \\g<6> \\g<7>'\r\n    new=r'\\g<1>R'+r'K'+r'\\g<2>..'+r'\\g<3> b \\g<4> '+marker+r' 0 0'\r\n  add(pat,old+'\\n'+new)\r\n\r\n# Remove lines where the white king is attacked by a black piece.\r\ndef attack_filter(k, j, kind, path=()):\r\n  look=[r'(?=.{'+str(k)+'}K)', r'(?=.{'+str(j)+'}'+kind+')']\r\n  look += [r'(?=.{'+str(x)+'}\\.)' for x in path]\r\n  add(r'^'+''.join(look)+r'.* b .*$','')\r\n\r\nfor kr in range(8):\r\n"]
