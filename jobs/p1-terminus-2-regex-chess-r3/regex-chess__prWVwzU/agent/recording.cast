[1299.017656, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0,'/app')\nfrom check import run_solution\nimport chess\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\nours=set(run_solution(fen)); b=chess.Board(fen); legal=set()\nfor m in b.legal_moves:\n if m.promotion and m.promotion!=chess.QUEEN: continue\n c=b.copy(); c.push(m); legal.add(' '.join(c.fen().split()[:-2]))\nprint('ours',len(ours),'legal',len(legal),'missing',len(legal-ours),'extra',len(ours-legal))\nfor x in sorted(legal-ours): print('MISSING',x)\nfor x in sorted(ours-legal): print('EXTRA',x)\nPY\n"]
[1299.017771, "o", "python3 - <<'PY'\r\nimport sys\r\nsys.path.insert(0,'/app')\r\nfrom check import run_solution\r\nimport chess\r\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\r\nours=set(run_solution(fen)); b=chess.Board(fen); legal=set()\r\nfor m in b.legal_moves:\r\n if m.promotion and m.promotion!=chess.QUEEN: continue\r\n c=b.copy(); c.push(m); legal.add(' '.join(c.fen().split()[:-2]))\r\nprint('ours',len(ours),'legal',len(legal),'missing',len(legal-ours),'extra',len(ours-legal))\r\nfor x in sorted(legal-ours): print('MISSING',x)\r\nfor x in sorted(ours-legal): print('EXTRA',x)\r\nPY\r\n"]
