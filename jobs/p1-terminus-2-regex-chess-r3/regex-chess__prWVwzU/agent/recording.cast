[841.09126, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0,'/app')\nfrom check import run_solution\nimport chess\nfen='rn1qkb1r/ppp2ppp/5n2/4p3/2B1P3/5Q2/PPP2PPP/RNB1K2R w KQkq - 2 7'\nours=set(run_solution(fen))\nb=chess.Board(fen); legal=set(); moves={}\nfor m in b.legal_moves:\n if m.promotion and m.promotion!=chess.QUEEN: continue\n c=b.copy(); c.push(m); f=' '.join(c.fen().split()[:-2]); legal.add(f); moves[f]=m.uci()\nprint('ours',len(ours),'legal',len(legal))\nfor f in sorted(legal-ours): print('MISSING',moves[f],f)\nfor f in sorted(ours-legal): print('EXTRA',f)\nPY\n"]
