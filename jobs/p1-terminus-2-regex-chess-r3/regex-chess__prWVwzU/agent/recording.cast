[723.940247, "o", "idx=lambda r,c: r*8+c\r\n\r\n# Add a normal move. The original line is retained so later rules can branch too.\r\ndef normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None, destcls='pnbrqk\\.'):\r\n    np=promo or piece\r\n    rp=rights_pat or r'([KQkq-]+)'\r\n    cells=[]\r\n    groups={}\r\n    g=1\r\n    for i in range(64):\r\n        if i==s:\r\n            cells.append(re.escape(piece))\r\n        else:\r\n            groups[i]=g\r\n            if i==d:\r\n                cells.append('(['+destcls+'])')\r\n            else:\r\n                cells.append(r'(.)')\r\n            g+=1\r\n    pat='^'+extra_pat+''.join(cells)+r' w '+rp+r' ([^ ]+) ([^ ]+) ([^ ]+)$'\r\n    dg=groups[d]\r\n    old=[]\r\n    moved=[]\r\n    for i in range(64):\r\n        if i==s:\r\n            old.append(piece); moved.append('.')\r\n        elif i==d:\r\n            old.append(r'\\g<'+str(dg)+r'>'); moved.append(np)\r\n        else:\r\n            q=r'\\g<'+str(groups[i])+r'>'\r\n            old.append(q); moved.append(q)\r\n"]
[724.009296, "o", "21:def normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None, destcls='pnbrqk\\.'):\r\n61:      if r-1==0: normal(s,d,'P',promo='Q',destcls=r'\\.')\r\n62:      else: normal(s,d,'P',destcls=r'\\.')\r\n68:        normal(s,d2,'P',ep=chr(97+c)+str(8-(r-2)),extra_pat=pat,destcls=r'\\.')\r\n74:          if r-1==0: normal(s,d,'P',promo='Q',destcls=r'pnbrqk')\r\n75:          else: normal(s,d,'P',destcls=r'pnbrqk')\r\n99:      if inside(r+dr,c+dc): normal(s,idx(r+dr,c+dc),'N')\r\n108:          normal(s,d,piece,extra_pat=look)\r\n113:        if (dr or dc) and inside(r+dr,c+dc): normal(s,idx(r+dr,c+dc),'K')\r\n"]
