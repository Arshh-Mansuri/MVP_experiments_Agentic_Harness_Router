[1369.925875, "o", "pos=s.index('# Remove lines where the white king')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1369.930641, "o", "late=r'''# Late fallback for queenside castling. The normal castling branch can be\r\n\u001b[?2004l\r\u001b[?2004h> # consumed by earlier branching rules; create it again from the surviving source.\r\n\u001b[?2004l\r\u001b[?2004h> # Require a1 rook, b1/c1/d1 empty, e1 king, Q right, and no black attack on e1/d1/c1.\r\n\u001b[?2004l\r\u001b[?2004h> latepat=(r'(?m)^(?=.{56}R\\.\\.\\.K)(?=[^ ]* w [KQkq-]*Q)'\r\n\u001b[?2004l\r\u001b[?2004h>          r'(?!.{60}K.* b)(.{56})R\\.\\.\\.K(.{3}) w ([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$')\r\n\u001b[?2004l\r\u001b[?2004h> add(latepat,r'\\\\g<1>..KR.\\\\g<2> b \\\\g<3> - 0 0')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:pos]+late+s[pos:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
