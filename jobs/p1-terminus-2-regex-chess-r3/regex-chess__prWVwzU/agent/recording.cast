[1059.108543, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re_json')) if False else json.load(open('/app/re.json'))\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\n# expanded initial state\ns=fen\nfor n in range(1,9): s=re.sub(str(n)+r'(?=[^ ]* [wb] )','.'*n,s)\ns=s.replace('/','')\nseen=False\nfor i,(p,r) in enumerate(rules):\n old=s; s=re.sub(p,r,s)\n if 'KR' in old and ' b ' in old and not ('KR' in s):\n  print('castle branch changed/deleted at',i,repr(p),'=>',repr(r))\n  print('before castle lines:')\n  print('\\n'.join(x for x in old.split('\\n') if 'KR' in x)[:1000])\n  print('after castle lines:')\n  print('\\n'.join(x for x in s.split('\\n') if 'KR' in x)[:1000])\n  break\nPY\n"]
