[292.986903, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\na=s.index('def normal(')\nb=s.index('\\n# Ordinary white moves.',a)\nnew=r'''def normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None):\n    np=promo or piece\n    rp=rights_pat or r'([KQkq-]+)'\n    cells=[]\n    groups={}\n    g=1\n    for i in range(64):\n        if i==s:\n            cells.append(re.escape(piece))\n        else:\n            groups[i]=g\n            if i==d:\n                cells.append(r'([pnbrqk\\.])')\n            else:\n                cells.append(r'(.)')\n            g+=1\n    pat='^'+extra_pat+''.join(cells)+r' w '+rp+r' ([^ ]+) ([^ ]+) ([^ ]+)$'\n    dg=groups[d]\n    old=[]\n    moved=[]\n    for i in range(64):\n        if i==s:\n            old.append(piece); moved.append('.')\n        elif i==d:\n            old.append(r'\\g<'+str(dg)+r'>'); moved.append(np)\n        else:\n            q=r'\\g<'+str(groups[i])+r'>'\n            old.append(q); moved.append(q)\n    # 63 board captures, then rights/ep/halfmove/fullmove.\n    old=''.join(old)+r' "]
