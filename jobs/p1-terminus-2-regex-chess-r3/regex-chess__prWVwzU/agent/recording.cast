[539.480561, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re.json'))\nfen='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'\ns=fen\nneedle='rnbqkbnrpppppppp.....................................N........PPPPPPPRNBQKB.R b'\n# locate any expanded g1-knight branch by checking board positions directly\nfor i,(p,r) in enumerate(rules):\n    old=s; new=re.sub(p,r,s)\n    before=[x for x in old.split('\\n') if ' b ' in x and len(x.split(' ')[0].replace('/',''))==64]\n    after=[x for x in new.split('\\n') if ' b ' in x and len(x.split(' ')[0].replace('/',''))==64]\n    if before and after:\n        # detect any line whose rights changed from KQkq to something\n        bset=set(before); aset=set(after)\n        changed=[(b,a) for b in before for a in after if b.split(' b ')[0]==a.split(' b ')[0] and b.split(' b ')[1]!=a.split(' b ')[1]]\n        if changed:\n            print('rule',i,repr(p),'=>',repr(r))\n            print('changed',changed[:5]); break\n    s=new\nelse: print('no rights change found')\nPY\n"]
