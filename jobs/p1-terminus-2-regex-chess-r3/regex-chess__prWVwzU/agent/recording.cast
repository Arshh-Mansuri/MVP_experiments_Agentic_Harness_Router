[71.290463, "i", "cat > /tmp/make_re.py <<'PY'\nimport json, re\n\nrules=[]\n\ndef add(p,r):\n    rules.append([p,r])\n\n# Expand the board: digits become dots, and rank separators are removed.\nfor n in range(1,9):\n    for _ in range(8):\n        add(r'^([1-8/]*?)'+str(n), r'\\g<1>'+'.'*n)\nfor _ in range(7):\n    add(r'^([^ ]*)/', r'\\g<1>')\n\nwhite='PNBRQK'\nblack='pnbrqk'\ninside=lambda r,c: 0<=r<8 and 0<=c<8\nidx=lambda r,c: r*8+c\n\n# Add a normal move. The original line is retained so later rules can branch too.\ndef normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None):\n    m=d-s-1\n    if m<0: return\n    dest='[^PNBRQK]'\n    if promo:\n        np=promo\n    else:\n        np=piece\n    rp=rights_pat or r'([KQkq-]+)'\n    # groups: prefix, middle, destination, suffix, rights, ep, hm, fm\n    pat=(r'^(.{'+str(s)+'})'+re.escape(piece)+r'(.{'+str(m)+'})'+dest+\n         r'(.*) w '+rp+r' ([^ ]+) ([^ ]+) ([^ ]+)$'+extra_pat)\n    orig=(r'\\g<1>'+piece+r'\\g<2>\\g<3>\\g<4> w \\g<5> \\g<6> \\g<7> \\g<8>')\n    new=(r'\\g<1>.'+r'\\g<2>'+np+r'\\g<3>\\g<4>"]
