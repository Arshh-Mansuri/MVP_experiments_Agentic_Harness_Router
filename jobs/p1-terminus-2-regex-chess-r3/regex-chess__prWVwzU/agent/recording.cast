[650.470936, "o", "    old=''.join(old)+r' w \\g<64> \\g<65> \\g<66> \\g<67>'\r\n    new=''.join(moved)+r' b \\g<64> '+ep+r' 0 0'\r\n    add(pat,old+'\\n'+new)\r\n\r\n# Ordinary white moves.\r\nfor r in range(8):\r\n  for c in range(8):\r\n    s=idx(r,c)\r\n    # pawn forward one and two\r\n    if r>0:\r\n      d=idx(r-1,c)\r\n      if r-1==0: normal(s,d,'P',promo='Q',destcls=r'\\.')\r\n      else: normal(s,d,'P',destcls=r'\\.')\r\n      if r==6:\r\n        d2=idx(r-2,c)\r\n        # The intermediate square is required empty.\r\n        pat=r'(?=.{'+str(idx(r-1,c))+'}\\.)'\r\n        normal(s,d,'P',ep='-',extra_pat='')\r\n        normal(s,d2,'P',ep=chr(97+c)+str(8-(r-2)),extra_pat=pat,destcls=r'\\.')\r\n    # pawn captures, including en-passant separately\r\n    if r>0:\r\n      for dc in (-1,1):\r\n        if inside(r-1,c+dc):\r\n          d=idx(r-1,c+dc)\r\n          if r-1==0: normal(s,d,'P',promo='Q',destcls=r'[pnbrqk]')\r\n          else: normal(s,d,'P',destcls=r'[pnbrqk]')\r\n          # en-passant: destination is empty, ep field equals destination,\r\n          # and the black pawn b"]
[650.470994, "o", "ehind destination is removed.\r\n          ep=chr(97+c+dc)+str(8-(r-1))\r\n          m=d-s-1\r\n          # Explicit specialized pattern, preserving the same branching form.\r\n          if m>=0:\r\n            destpos=d\r\n"]
