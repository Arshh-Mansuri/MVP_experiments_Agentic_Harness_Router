[774.352907, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\na=s.index('# Update castling rights from the resulting board.')\nb=s.index('# Convert castle markers',a)\nnew=\"\"\"# Update castling rights from the resulting board.\\n# Board indices are a8=0 through h1=63. Moving a king removes both rights.\\nadd(r'(?m)^(?=.{60}[^K])(.{64} b )([KQkq-]*)(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\n# Above generic rule is replaced by two character-removal rules below.\\nadd(r'(?m)^(?=.{60}[^K])(.{64} b )([KQkq-]*)K(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\nadd(r'(?m)^(?=.{60}[^K])(.{64} b )([KQkq-]*)Q(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\nadd(r'(?m)^(?=.{4}[^k])(.{64} b )([KQkq-]*)k(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\nadd(r'(?m)^(?=.{4}[^k])(.{64} b )([KQkq-]*)q(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\n# Rook moves/captures remove only the corresponding side right.\\nfor pos,expected,right in [\\n (63,'R','K'), (56,'R','Q'), (7,'r','k'), (0,'r','q'),\\n]:\\n  add(r'(?m)^(?=.{'+str(pos)+'}[^'+expected+r'])(.{64} b )([KQkq-]*)'+right+r'(.*)$',r'\\\\g<1>\\\\g<2>\\\\g<3>')\\n\"\"\"\ns=s[:a]+new+s[b"]
