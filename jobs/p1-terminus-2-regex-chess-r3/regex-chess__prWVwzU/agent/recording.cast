[147.889918, "o", "# Expand every board digit, but do not alter en-passant or move counters.\r\n# The lookahead requires the remaining text to reach the side-to-move field.\r\nfor n in range(1,9):\r\n    add(r'\"+str(n)+r'(?=[^ ]* [wb] )', '.'*\"+str(n)+r')\r\n# Remove board rank separators after expansion.\r\nadd(r'/', '')\r\n\r\nwhite='PNBRQK'\r\nblack='pnbrqk'\r\ninside=lambda r,c: 0<=r<8 and 0<=c<8\r\nidx=lambda r,c: r*8+c\r\n\r\n# Add a normal move. The original line is retained so later rules can branch too.\r\ndef normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None):\r\n    m=d-s-1\r\n    if m<0: return\r\n    dest='[^PNBRQK]'\r\n    if promo:\r\n        np=promo\r\n    else:\r\n        np=piece\r\n    rp=rights_pat or r'([KQkq-]+)'\r\n    # groups: prefix, middle, destination, suffix, rights, ep, hm, fm\r\n"]
