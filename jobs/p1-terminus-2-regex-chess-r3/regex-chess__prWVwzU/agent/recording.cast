[1126.40901, "i", "python3 - <<'PY'\nimport json,re\nrules=json.load(open('/app/re.json'))\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\ns=fen\nfor n in range(1,9): s=re.sub(str(n)+r'(?=[^ ]* [wb] )','.'*n,s)\ns=s.replace('/','')\n# Preserve only exact castled-board candidates for tracking.\ndef castle_lines(x):\n    return [z for z in x.split('\\n') if len(z)>=64 and z[58]=='K' and z[59]=='R' and z[63]=='R']\nfor i,(p,r) in enumerate(rules):\n    old=s; s=re.sub(p,r,s)\n    before=castle_lines(old); after=castle_lines(s)\n    if before or after:\n        print('rule',i,'before',len(before),'after',len(after))\n        if before and not after:\n            print('DELETED pattern',repr(p),'=>',repr(r))\n            print('before sample',repr(before[0]))\n            break\nPY\n"]
[1126.412202, "o", "python3 - <<'PY'\r\nimport json,re\r\nrules=json.load(open('/app/re.json'))\r\nfen='rn2kb1r/p3qppp/2p2n2/1p2p1B1/2B1P3/1QN5/PPP2PPP/R3K2R w KQkq - 0 10'\r\ns=fen\r\nfor n in range(1,9): s=re.sub(str(n)+r'(?=[^ ]* [wb] )','.'*n,s)\r\ns=s.replace('/','')\r\n# Preserve only exact castled-board candidates for tracking.\r\ndef castle_lines(x):\r\n    return [z for z in x.split('\\n') if len(z)>=64 and z[58]=='K' and z[59]=='R' and z[63]=='R']\r\nfor i,(p,r) in enumerate(rules):\r\n    old=s; s=re.sub(p,r,s)\r\n    before=castle_lines(old); after=castle_lines(s)\r\n    if before or after:\r\n        print('rule',i,'before',len(before),'after',len(after))\r\n        if before and not after:\r\n            print('DELETED pattern',repr(p),'=>',repr(r))\r\n            print('before sample',repr(before[0]))\r\n            break\r\nPY\r\n"]
