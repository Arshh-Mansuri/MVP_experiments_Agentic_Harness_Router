[1369.921503, "i", "python3 - <<'PY'\np='/tmp/make_re.py'\ns=open(p).read()\npos=s.index('# Remove lines where the white king')\nlate=r'''# Late fallback for queenside castling. The normal castling branch can be\n# consumed by earlier branching rules; create it again from the surviving source.\n# Require a1 rook, b1/c1/d1 empty, e1 king, Q right, and no black attack on e1/d1/c1.\nlatepat=(r'(?m)^(?=.{56}R\\.\\.\\.K)(?=[^ ]* w [KQkq-]*Q)'\n         r'(?!.{60}K.* b)(.{56})R\\.\\.\\.K(.{3}) w ([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$')\nadd(latepat,r'\\\\g<1>..KR.\\\\g<2> b \\\\g<3> - 0 0')\n\n'''\ns=s[:pos]+late+s[pos:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/make_re.py && python3 /tmp/make_re.py\n"]
