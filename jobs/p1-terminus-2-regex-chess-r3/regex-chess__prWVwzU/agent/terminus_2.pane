[?2004limport json, re

rules=[]

def add(p,r):
    rules.append([p,r])

# Expand every board digit, but do not alter en-passant or move counters.
# The lookahead requires the remaining text to reach the side-to-move field.
for n in range(1,9):
    add(r'"+str(n)+r'(?=[^ ]* [wb] )', '.'*"+str(n)+r')
# Remove board rank separators after expansion.
add(r'/', '')

