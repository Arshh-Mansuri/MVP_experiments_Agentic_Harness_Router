# Ordinary white moves.
for r in range(8):
  for c in range(8):
    s=idx(r,c)
    # pawn forward one and two
    if r>0:
      d=idx(r-1,c)
      if r-1==0: normal(s,d,'P',promo='Q',destcls=r'\.')
      else: normal(s,d,'P',destcls=r'\.')
      if r==6:
        d2=idx(r-2,c)
        # The intermediate square is required empty.
        pat=r'(?=.{'+str(idx(r-1,c))+'}\.)'
        normal(s,d,'P',ep='-',extra_pat='')
        normal(s,d2,'P',ep=chr(97+c)+str(8-(r-2)),extra_pat=pat,destcls=r'\.')
