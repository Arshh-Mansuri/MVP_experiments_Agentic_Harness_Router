import json,re
rules=json.load(open('/app/re.json'))
fen='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'
s=fen
for i,(p,r) in enumerate(rules):
    s=re.sub(p,r,s)
    if i in (15,16,17,4180,4179,4181,4182,4188,4189,4195,4196,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199):
        print('INDEX',i,'lines',len(s.split('\n')))
        for x in s.split('\n')[:3]: print(repr(x))
print('last rules',len(rules))
