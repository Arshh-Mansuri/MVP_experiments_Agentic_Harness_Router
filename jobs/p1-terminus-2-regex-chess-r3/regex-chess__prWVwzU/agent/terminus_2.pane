add(r'^.{64} w .*$','')
# Insert rank separators from left to right.
for n in range(1,8):
  prefix=r'((?:[^/]{8}/){'+str(n-1)+r'}[^/]{8})'
  add(r'^'+prefix+r'(.{'+str(64-8*n)+r'} b .*)$',r'\g<1>/\g<2>')
# Compress dot runs, longest first.
for n in range(8,1,-1):
  add(r'\.'*n, str(n))

with open('/app/re.json','w') as f:
 json.dump(rules,f,separators=(',',':'))
print('rules',len(rules),'bytes',__import__('os').path.getsize('/app/re.json'))
