[?2004limport json, re

rules=[]

def add(p,r):
    if p.startswith('^'):
        p='(?m)'+p
    rules.append([p,r])

# Expand every board digit, but do not alter metadata.
for n in range(1,9):
    add(str(n) + r'(?=[^ ]* [wb] )', '.' * n)
add(r'/', '')

white='PNBRQK'
black='pnbrqk'
inside=lambda r,c: 0<=r<8 and 0<=c<8
idx=lambda r,c: r*8+c

# Add a normal move. The original line is retained so later rules can branch too.
def normal(s,d,piece, ep='-', promo=None, extra_pat='', rights_pat=None, destcls='pnbrqk\.'):
    np=promo or piece
    rp=rights_pat or r'([KQkq-]+)'
    cells=[]
    groups={}
    g=1
    for i in range(64):
        if i==s:
            cells.append(re.escape(piece))
        else:
            groups[i]=g
            if i==d:
                cells.append(r'(['+destcls+r'])')
            else:
                cells.append(r'(.)')
            g+=1
    pat='^'+extra_pat+''.join(cells)+r' w '+rp+r' ([^ ]+) ([^ ]+) ([^ ]+)$'
    dg=groups[d]
    old=[]
    moved=[]
    for i in range(64):
        if i==s:
            old.append(piece); moved.append('.')
        elif i==d:
            old.append(r'\g<'+str(dg)+r'>'); moved.append(np)
        else:
            q=r'\g<'+str(groups[i])+r'>'
            old.append(q); moved.append(q)
    # 63 board captures, then rights/ep/halfmove/fullmove.
    old=''.join(old)+r' w \g<64> \g<65> \g<66> \g<67>'
    new=''.join(moved)+r' b \g<64> '+ep+r' 0 0'
    add(pat,old+'\n'+new)

# Castling, with board indices a8=0 through h1=63.
# White kingside: e1 K, f1/g1 empty, h1 rook -> e1 empty, f1 rook, g1 king, h1 empty.
add(r'(?m)^(?=.{61}\.)(?=.{62}\.)(.{60})K\.\.R w ([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$',
    r'\g<1>.RK. b \g<2> - 0 0')
# White queenside: a1 rook, b1/c1/d1 empty, e1 king -> c1 king, d1 rook.
add(r'(?m)^(?=.{57}\.)(?=.{58}\.)(?=.{59}\.)(.{56})R\.\.\.K(.{3}) w ([KQkq-]+) ([^ ]+) ([^ ]+) ([^ ]+)$',
    r'\g<1>..KR.\g<2> b \g<3> - 0 0')

# Set en-passant only for double pushes that leave an adjacent black pawn able to capture.
# A white double push lands on rank 4 (indices 32..39); adjacent black pawns are on that rank.
for c in range(8):
    d=32+c
    ep=chr(97+c)+"3"
    for ac in (c-1,c+1):
        if 0<=ac<8:
            adj=32+ac
            add(r'(?m)^(?=.{'+str(d)+'}P)(?=.{'+str(adj)+'}p)(.{64} b [KQkq-]+ )-([ ]+[^\n]*)$',
                r'\g<1>'+ep+r'\g<2>')


# Ordinary white moves.
for r in range(8):
  for c in range(8):
    s=idx(r,c)
    # pawn forward one and two
    if r>0:
      d=idx(r-1,c)
      if r-1==0: normal(s,d,'P',promo='Q',destcls=r'\.')
      else: normal(s,d,'P',destcls=r'\.')
      if r==6:
        d2=idx(r-2,c)
        # Both the intermediate and destination squares must be empty.
        pat=(r'(?=.{'+str(idx(r-1,c))+'}\.)'+
             r'(?=.{'+str(d2)+'}\.)')
        normal(s,d2,'P',ep='-',extra_pat=pat,destcls=r'\.')
    # pawn captures, including en-passant separately
    if r>0:
      for dc in (-1,1):
        if inside(r-1,c+dc):
          d=idx(r-1,c+dc)
          if r-1==0: normal(s,d,'P',promo='Q',destcls=r'pnbrqk')
          else: normal(s,d,'P',destcls=r'pnbrqk')
          # en-passant: destination is empty, ep field equals destination,
          # and the black pawn behind destination is removed.
          ep=chr(97+c+dc)+str(8-(r-1))
          m=d-s-1
          # Explicit specialized pattern, preserving the same branching form.
          if m>=0:
            destpos=d
            behind=idx(r,c+dc)
            pat=(r'^(.{'+str(s)+'})P(.{'+str(m)+'})\.(.*) w ([KQkq-]+) '+re.escape(ep)+r' ([^ ]+) ([^ ]+)$')
            orig=r'\g<1>P\g<2>.\g<3> w \g<4> '+ep+r' \g<5> \g<6>'
