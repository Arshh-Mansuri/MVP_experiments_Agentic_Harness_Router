Sending keys: ["cat > /app/steal.py <<'PY'\nimport numpy as np\nfrom forward import forward\n\nD = 10\nrng = np.random.default_rng(20250913)\n\ndef f(x):\n    return float(forward(np.asarray(x, dtype=float)))\n\ndef grad(x):\n    x = np.asarray(x, dtype=float)\n    h = 2e-6\n    g = np.empty(D)\n    for j in range(D):\n        xp = x.copy(); xm = x.copy()\n        xp[j] += h; xm[j] -= h\n        g[j] = (f(xp) - f(xm)) / (2*h)\n    return g\n\ndef canon(v):\n    n = np.linalg.norm(v)\n    if not np.isfinite(n) or n < 1e-8:\n        return None\n    v = v / n\n    k = np.argmax(np.abs(v))\n    if v[k] < 0:\n        v = -v\n    return v\n\ncandidates = []\n# The hidden biases and weights are small, so radius 2 covers essentially all\n# crossings. Extra larger scans catch any outlying crossing as well.\nfor radius, trials in [(2.0, 90), (8.0, 25), (32.0, 10)]:\n    n = 2401\n    ts = np.linspace(-radius, radius, n)\n    dt = ts[1] - ts[0]\n    for _ in range(trials):\n        v = rng.normal(size=D)\n        v /= np.linalg.norm(v)\n        ys = np.array([f(t*v) for t in ts])\n        sl = np.diff(ys) / dt\n        # The second difference is nonzero only in cells containing a kink.\n        dsl = np.diff(sl)\n        threshold = max(2e-8, 2e-4*np.max(np.abs(sl)))\n        for i in np.flatnonzero(np.abs(dsl) > threshold):\n            # The kink is near ts[i+1]. Probe two full grid spacings apart;\n            # this is much less likely to leave one gradient on the same side.\n            center = ts[i+1]\n            a = center - 2.2*dt\n            b = center + 2.2*dt\n            ga = grad(a*v)\n            gb = grad(b*v)\n            u = canon(gb-ga)\n            if u is None:\n                continue\n            # Require consistency with a slightly different pair of probes.\n            ga2 = grad((center-1.7*dt)*v)\n            gb2 = grad((center+1.7*dt)*v)\n            u2 = canon(gb2-ga2)\n            if u2 is None or abs(np.dot(u, u2)) < 0.985:\n                continue\n            candidates.append(u)\n\n# Cluster directions. A true A1 row is encountered on many independent lines,\n# whereas accidental mixed jumps are rare and form small clusters.\nclusters = []\nfor u in candidates:\n    best = None\n    bestscore = 0.0\n    for k, c in enumerate(clusters):\n        score = abs(float(np.dot(u, c['center'])))\n        if score > bestscore:\n            bestscore = score\n            best = k\n    if best is not None and bestscore > 0.995:\n        c = clusters[best]\n        if np.dot(u, c['center']) < 0:\n            u = -u\n        c['members'].append(u)\n        c['center'] = canon(np.sum(c['members'], axis=0))\n    else:\n        clusters.append({'center': u.copy(), 'members': [u]})\n\nclusters.sort(key=lambda c: len(c['members']), reverse=True)\nif len(clusters) < 20:\n    raise RuntimeError('Only found %d direction clusters' % len(clusters))\n\n# The model has 20 hidden neurons. The largest recurring direction clusters\n# correspond to their A1 rows; each row is normalized, which is allowed by the\n# requested scaling equivalence.\nA1 = np.asarray([c['center'] for c in clusters[:20]], dtype=float)\nnp.save('/app/stolen_A1.npy', A1)\nprint('candidate jumps:', len(candidates))\nprint('cluster sizes:', [len(c['members']) for c in clusters[:20]])\nprint('saved /app/stolen_A1.npy with shape', A1.shape)\nPY\ncd /app && python3 steal.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
