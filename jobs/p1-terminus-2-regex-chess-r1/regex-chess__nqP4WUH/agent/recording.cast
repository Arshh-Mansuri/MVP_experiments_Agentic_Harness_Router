[246.347906, "i", "cat > /tmp/build.py <<'PY'\nimport json,re,os\nB=chr(92)\nrules=[]\ndef add(p,r): rules.append([p,r])\n# Expand board digits and normalize the input to a 64-character board.\nfor n in range(1,9): add(str(n)+'(?=[^ ]* w )','.'*n)\nadd('^(.{8})/(.{8})/(.{8})/(.{8})/(.{8})/(.{8})/(.{8})/(.{8}) w ([KQkq-]+) ([a-h][36]|-) [^ ]+ [^ ]+$',B+'1'+B+'2'+B+'3'+B+'4'+B+'5'+B+'6'+B+'7'+B+'8 w '+B+'9 '+B+'10|0')\nrights=['-','K','Q','KQ','k','q','kq','Kk','Kq','Qk','Qq','KQk','KQq','Kkq','Qkq','KQkq']\ndef nr(x,s,d):\n q=set(x.replace('-',''))\n if s==4:q-=set('KQ')\n if s in (0,):q.discard('Q')\n if s in (7,):q.discard('K')\n if d==0:q.discard('Q')\n if d==7:q.discard('K')\n return ''.join(c for c in 'KQkq' if c in q) or '-'\ndef path(s,d):\n sr,sc=divmod(s,8);dr,dc=divmod(d,8); rr=(dr>sr)-(dr<sr);cc=(dc>sc)-(dc<sc)\n z=[];r=sr+rr;c=sc+cc\n while (r,c)!=(dr,dc): z.append(r*8+c);r+=rr;c+=cc\n return ''.join('(?=.{'+str(x)+'}'+B+'.)' for x in z)\ndef moverule(s,d,p,dest,phase,rights0,ep='-',extra=''):\n if s<d:\n  g=d-s-1\n  look='(?=(?P<A>.{'+str(s"]
