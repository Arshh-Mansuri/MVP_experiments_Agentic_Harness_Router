[2787.198647, "i", "cat >/tmp/fixnewline.py <<'PY'\nimport json,re,os\np='/app/re.json'\nrules=json.load(open(p))\nrules=[x for x in rules if x != ['\\\\n\\\\Z',''] and x != ['\\\\n$','']]\nrules.append(['\\\\n\\\\Z',''])\njson.dump(rules,open(p,'w'),separators=(',',':'))\nfor a,b in rules:\n    re.compile(a)\nprint('VALID',len(rules),os.path.getsize(p))\nfen='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'\nfor a,b in rules:\n    fen=re.sub(a,b,fen)\nprint('EXACT_COUNT',len(fen.split('\\\\n')),'EMPTY',any(x=='' for x in fen.split('\\\\n')),'TRAILING',repr(fen[-20:]))\nPY\npython3 /tmp/fixnewline.py\n"]
[2787.202028, "o", "cat >/tmp/fixnewline.py <<'PY'\r\n\u001b[?2004l\r"]
[2787.209551, "o", "\u001b[?2004h> import json,re,os\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/re.json'\r\n\u001b[?2004l\r\u001b[?2004h> rules=json.load(open(p))\r\n\u001b[?2004l\r\u001b[?2004h> rules=[x for x in rules if x != ['\\\\n\\\\Z',''] and x != ['\\\\n$','']]\r\n\u001b[?2004l\r\u001b[?2004h> rules.append(['\\\\n\\\\Z',''])\r\n\u001b[?2004l\r\u001b[?2004h> json.dump(rules,open(p,'w'),separators=(',',':'))\r\n\u001b[?2004l\r\u001b[?2004h> for a,b in rules:\r\n\u001b[?2004l\r\u001b[?2004h>     re.compile(a)\r\n\u001b[?2004l\r\u001b[?2004h> print('VALID',len(rules),os.path.getsize(p))\r\n\u001b[?2004l\r\u001b[?2004h> fen='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'\r\n\u001b[?2004l\r\u001b[?2004h> for a,b in rules:\r\n\u001b[?2004l\r\u001b[?2004h>     fen=re.sub(a,b,fen)\r\n\u001b[?2004l\r\u001b[?2004h> print('EXACT_COUNT',len(fen.split('\\\\n')),'EMPTY',any(x=='' for x in fen.split('\\\\n')),'TRAILING',repr(fen[-20:]))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
