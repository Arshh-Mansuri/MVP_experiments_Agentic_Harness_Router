[394.32355, "i", "python3 - <<'PY'\np='/tmp/build.py'\ns=open(p).read()\nneedle='# Phase fallbacks.\\nfor i in range(phase+1): rules.append([\\'^(.*)\\'+B+\\'|\\'+str(i)+\\'$\\',B+\\'g<1>\\'+B+\\'|\\'+str(i+1)])'\nreplacement='''# Phase fallbacks. Reorder candidates so each phase is processed before its advance rule.\n_normal=rules[:9]\n_candidates=rules[9:]\n_groups=[[] for _ in range(phase+1)]\nfor _rule in _candidates:\n    _m=re.search(r'\\\\|([0-9]+)\\\\)',_rule[0])\n    if _m and int(_m.group(1)) < len(_groups):\n        _groups[int(_m.group(1))].append(_rule)\n    else:\n        _groups[-1].append(_rule)\nrules=_normal[:]\nfor i in range(phase+1):\n    rules.extend(_groups[i])\n    rules.append(['^(.*)'+B+'|'+str(i)+'$',B+'g<1>'+B+'|'+str(i+1)])'''\nif needle not in s:\n print('needle not found')\nelse:\n s=s.replace(needle,replacement)\n open(p,'w').write(s)\nPY\npython3 /tmp/build.py\npython3 - <<'PY'\nimport json,re,os\np='/app/re.json'; x=json.load(open(p)); [re.compile(a) for a,b in x]\nprint('VALID',len(x),os.path.getsize(p))\nf='rnb1k1nr/p2p1ppp/3B4/1p1NPN"]
