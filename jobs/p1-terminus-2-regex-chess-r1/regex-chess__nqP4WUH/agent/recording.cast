[483.366518, "i", "python3 - <<'PY'\np='/tmp/build.py'\ns=open(p).read()\n# Literal phase separators in regex patterns must be escaped.\ns=s.replace(\"+' '+re.escape(ep)+'|'+str(phase)+')'\", \"+' '+re.escape(ep)+B+'|'+str(phase)+')'\")\n# The actual source has this exact segment in the generated lookahead.\ns=s.replace(\"re.escape(ep)+'|'+str(phase)+')'\", \"re.escape(ep)+B+'|'+str(phase)+')'\")\n# Replacement strings must contain a plain pipe, not backslash-pipe.\ns=s.replace(\"B+'g<1>'+B+'|'+str(i+1)\", \"B+'g<1>|'+str(i+1)\")\n# Castling and candidate phase output continuation strings.\ns=s.replace(\"B+'g<O>|'+str(phase)\", \"B+'g<O>|'+str(phase)\")\nopen(p,'w').write(s)\nPY\npython3 /tmp/build.py\npython3 - <<'PY'\nimport json,re,os\np='/app/re.json'; x=json.load(open(p)); [re.compile(a) for a,b in x]\nprint('VALID',len(x),os.path.getsize(p))\nPY\n(timeout 30 python3 /tmp/test.py) || echo TEST_TIMEOUT_OR_ERROR\n"]
