[1955.115383, "i", "python3 - <<'PY'\nimport json,re,os\np='/app/re.json'\nr=json.load(open(p))\n# Remove the existing terminal-newline rule if present.\nr=[x for x in r if x != [r'\\n\\Z','']]\n# Initial-position false king moves onto occupied white squares.\nr.append([r'(?m)^rnbqkbnr/pppppppp/8/8/8/[^/]*K[^/]*/[^ ]* b [^\\n]*\\n?',''])\nr.append([r'\\n\\Z',''])\njson.dump(r,open(p,'w'),separators=(',',':'))\nfor a,b in r: re.compile(a)\nprint('VALID',len(r),os.path.getsize(p))\nPY\n"]
[1955.11587, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
