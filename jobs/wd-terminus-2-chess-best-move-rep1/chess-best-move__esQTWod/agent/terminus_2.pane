[?2004l[?2004h>     d=np.linalg.norm(sq-bg,axis=2)
[?2004l[?2004h>     mask=d>25
[?2004l[?2004h>     # ignore board-edge antialiasing, use inner 70x70
[?2004l[?2004h>     m=mask[5:75,5:75]
