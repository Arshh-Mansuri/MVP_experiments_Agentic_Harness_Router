[173.918697, "i", "apt-get install -y sshpass >/dev/null 2>&1\ncd /tmp/git-smoke/client\nexport SSHPASS=password\nexport GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'\nsshpass -e git push origin main\necho 'main response:'\ncurl -k -sS --max-time 5 https://localhost:8443/index.html\necho\ngit checkout -B dev\necho 'dev branch content' > index.html\ngit add index.html\ngit commit -qm dev || true\nsshpass -e git push origin dev\necho 'dev response:'\ncurl -k -sS --max-time 5 https://localhost:8443/dev/index.html\necho\nprintf 'deployed files:\\n'\nfind /var/www/main /var/www/dev -maxdepth 1 -type f -name index.html -exec sh -c 'echo --- $1; cat \"$1\"' sh {} \\;\n"]
