[152.678538, "i", "rm -rf /tmp/git-smoke && mkdir -p /tmp/git-smoke && cd /tmp/git-smoke\ngit init -q client && cd client\ngit config user.email test@example.com\ngit config user.name tester\necho 'main branch content' > index.html\ngit add index.html && git commit -qm main\ngit branch -M main\ngit remote add origin ssh://git@localhost/git/project\nGIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no' GIT_TERMINAL_PROMPT=0 git push -q origin main\nprintf 'main: '; curl -k -sS --max-time 5 https://localhost:8443/index.html\nprintf '\\n'\necho 'dev branch content' > index.html\ngit checkout -qb dev\ngit add index.html && git commit -qm dev\nGIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no' GIT_TERMINAL_PROMPT=0 git push -q origin dev\nprintf 'dev: '; curl -k -sS --max-time 5 https://localhost:8443/dev/index.html\nprintf '\\n'\n"]
