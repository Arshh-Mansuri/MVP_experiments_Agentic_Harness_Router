[151.458329, "o", "    case \"$refname\" in\r\n\u001b[?2004l\r\u001b[?2004h>         refs/heads/main) target=\"$base/main\" ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.458463, "o", "        refs/heads/dev) target=\"$base/dev\" ;;\r\n\u001b[?2004l\r\u001b[?2004h>         *) continue ;;\r\n\u001b[?2004l\r\u001b[?2004h>     esac\r\n\u001b[?2004l\r"]
