[19.367151, "i", "export DEBIAN_FRONTEND=noninteractive\napt-get update -y && apt-get install -y git openssh-server nginx openssl ca-certificates\nuseradd -m -d /home/git -s /usr/bin/git-shell git 2>/dev/null || true\necho 'git:password' | chpasswd\nmkdir -p /git /var/www/main /var/www/dev\nchown -R git:git /git /home/git\nif [ ! -f /git/project/HEAD ]; then git init --bare /git/project; fi\nchown -R git:git /git/project\ncat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/sh\nset -eu\nrepo=/git/project\nbase=/var/www\nwhile read oldrev newrev refname; do\n    case \"$refname\" in\n        refs/heads/main)\n            target=\"$base/main\"\n            ;;\n        refs/heads/dev)\n            target=\"$base/dev\"\n            ;;\n        *)\n            continue\n            ;;\n    esac\n    tmp=\"$base/.deploy-$(basename \"$target\")-$$\"\n    rm -rf \"$tmp\"\n    mkdir -p \"$tmp\"\n    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\n    rm -rf \"$target\"\n    mv \"$tmp\" \"$target\"\n    chmod -R a+rX \"$target\"\ndone\nEOF\nchown git:git /git/project/hooks/post-receive\nchmod 755 /git/project/hooks/post-receive\nmkdir -p /etc/nginx/ssl\nif [ ! -f /etc/nginx/ssl/localhost.crt ]; then\n  openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\n    -keyout /etc/nginx/ssl/localhost.key \\\n    -out /etc/nginx/ssl/localhost.crt \\\n    -subj '/CN=localhost' \\\n    -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'\nfi\nchmod 600 /etc/nginx/ssl/localhost.key\ncat > /etc/nginx/sites-available/git-project <<'EOF'\nserver {\n    listen 8443 ssl;\n    listen [::]:8443 ssl;\n    server_name localhost;\n\n    ssl_certificate /etc/nginx/ssl/localhost.crt;\n    ssl_certificate_key /etc/nginx/ssl/localhost.key;\n    ssl_protocols TLSv1.2 TLSv1.3;\n\n    root /var/www/main;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n    location /dev/ {\n        alias /var/www/dev/;\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\nrm -f /etc/nginx/sites-enabled/default\nln -sf /etc/nginx/sites-available/git-project /etc/nginx/sites-enabled/git-project\nnginx -t\nsed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\nif ! grep -q '^PasswordAuthentication' /etc/ssh/sshd_config; then echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config; fi\nif ! grep -q '^UsePAM' /etc/ssh/sshd_config; then echo 'UsePAM yes' >> /etc/ssh/sshd_config; fi\nmkdir -p /run/sshd\nsshd -t\n(systemctl enable --now ssh 2>/dev/null || service ssh restart 2>/dev/null || /usr/sbin/sshd)\n(systemctl enable --now nginx 2>/dev/null || service nginx restart 2>/dev/null)\nnginx -s reload 2>/dev/null || true\nprintf 'Git SSH and HTTPS deployment server configured.\\n'\n"]
