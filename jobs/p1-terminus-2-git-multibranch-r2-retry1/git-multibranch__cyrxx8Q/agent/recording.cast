[54.009631, "i", "set -e\nuseradd -m -d /home/git -s /usr/bin/git-shell git 2>/dev/null || true\necho 'git:password' | chpasswd\nmkdir -p /git /var/www/main /var/www/dev\nchown -R git:git /git /var/www\nif [ ! -f /git/project/HEAD ]; then git init --bare /git/project; fi\nchown -R git:git /git/project\ncat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/sh\nset -eu\nrepo=/git/project\nbase=/var/www\nwhile IFS=' ' read -r oldrev newrev refname; do\n    case \"$refname\" in\n        refs/heads/main) target=\"$base/main\" ;;\n        refs/heads/dev) target=\"$base/dev\" ;;\n        *) continue ;;\n    esac\n    tmp=\"$base/.deploy-$(basename \"$target\")-$$\"\n    rm -rf \"$tmp\"\n    mkdir \"$tmp\"\n    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\n    rm -rf \"$target\"\n    mv \"$tmp\" \"$target\"\n    chmod -R a+rX \"$target\"\ndone\nEOF\nchown git:git /git/project/hooks/post-receive\nchmod 755 /git/project/hooks/post-receive\nmkdir -p /etc/nginx/ssl\nopenssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\n  -keyout /etc/nginx/ssl/localhost.key \\\n  -out /etc/nginx/ssl/localhost.crt \\\n  -subj '/CN=localhost' \\\n  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' 2>/dev/null\nchmod 600 /etc/nginx/ssl/localhost.key\ncat > /etc/nginx/sites-available/git-project <<'EOF'\nserver {\n    listen 8443 ssl;\n    listen [::]:8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/localhost.crt;\n    ssl_certificate_key /etc/nginx/ssl/localhost.key;\n    ssl_protocols TLSv1.2 TLSv1.3;\n    root /var/www/main;\n    location ^~ /dev/ {\n        alias /var/www/dev/;\n    }\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\nrm -f /etc/nginx/sites-enabled/default\nln -sfn /etc/nginx/sites-available/git-project /etc/nginx/sites-enabled/git-project\nif grep -qE '^[#[:space:]]*PasswordAuthentication' /etc/ssh/sshd_config; then sed -i -E 's/^[#[:space:]]*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config; else echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config; fi\nmkdir -p /run/sshd\nsshd -t\nnginx -t\npkill -x nginx 2>/dev/null || true\n/usr/sbin/nginx\n/usr/sbin/sshd\nprintf 'configured\\n'\n"]
[54.013119, "o", "set -e\r\nuseradd -m -d /home/git -s /usr/bin/git-shell git 2>/dev/null || true\r\necho 'git:password' | chpasswd\r\nmkdir -p /git /var/www/main /var/www/dev\r\nchown -R git:git /git /var/www\r\nif [ ! -f /git/project/HEAD ]; then git init --bare /git/project; fi\r\nchown -R git:git /git/project\r\ncat > /git/project/hooks/post-receive <<'EOF'\r\n#!/bin/sh\r\nset -eu\r\nrepo=/git/project\r\nbase=/var/www\r\nwhile IFS=' ' read -r oldrev newrev refname; do\r\n    case \"$refname\" in\r\n        refs/heads/main) target=\"$base/main\" ;;\r\n        refs/heads/dev) target=\"$base/dev\" ;;\r\n        *) continue ;;\r\n    esac\r\n    tmp=\"$base/.deploy-$(basename \"$target\")-$$\"\r\n    rm -rf \"$tmp\"\r\n    mkdir \"$tmp\"\r\n    git --git-dir=\"$repo\" archive \"$newrev\" | tar -x -C \"$tmp\"\r\n    rm -rf \"$target\"\r\n    mv \"$tmp\" \"$target\"\r\n    chmod -R a+rX \"$target\"\r\ndone\r\nEOF\r\nchown git:git /git/project/hooks/post-receive\r\nchmod 755 /git/project/hooks/post-receive\r\nmkdir -p /etc/nginx/ssl\r\nopenssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\r\n  -keyout /etc/nginx/ssl/"]
[54.013222, "o", "localhost.key \\\r\n  -out /etc/nginx/ssl/localhost.crt \\\r\n  -subj '/CN=localhost' \\\r\n  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' 2>/dev/null\r\nchmod 600 /etc/nginx/ssl/localhost.key\r\ncat > /etc/nginx/sites-available/git-project <<'EOF'\r\nserver {\r\n    listen 8443 ssl;\r\n    listen [::]:8443 ssl;\r\n    server_name localhost;\r\n    ssl_certificate /etc/nginx/ssl/localhost.crt;\r\n    ssl_certificate_key /etc/nginx/ssl/localhost.key;\r\n    ssl_protocols TLSv1.2 TLSv1.3;\r\n    root /var/www/main;\r\n    location ^~ /dev/ {\r\n        alias /var/www/dev/;\r\n    }\r\n    location / {\r\n        try_files $uri $uri/ =404;\r\n    }\r\n}\r\nEOF\r\nrm -f /etc/nginx/sites-enabled/default\r\nln -sfn /etc/nginx/sites-available/git-project /etc/nginx/sites-enabled/git-project\r\nif grep -qE '^[#[:space:]]*PasswordAuthentication' /etc/ssh/sshd_config; then sed -i -E 's/^[#[:space:]]*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config; else echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config; fi\r\nmkdir -p /run/sshd\r\nsshd -t\r\nnginx -t\r\npkill -x nginx 2>/dev/null || true\r\n/usr/sbin/nginx\r\n/usr/sbin/sshd\r\nprintf 'configured\\n'\r\n"]
[75.10409, "i", "printf '%s\\n' '--- listeners ---'; ss -ltnp | grep -E ':(22|8443) ' || true; printf '%s\\n' '--- nginx config ---'; nginx -t; printf '%s\\n' '--- ssh config ---'; sshd -T | grep -E '^(passwordauthentication|pubkeyauthentication) '; printf '%s\\n' '--- repository ---'; git --git-dir=/git/project rev-parse --is-bare-repository; ls -l /git/project/hooks/post-receive; printf '%s\\n' '--- https ---'; curl -k -I --max-time 5 https://localhost:8443/ || true; printf '%s\\n' '--- processes ---'; pgrep -a 'sshd|nginx' || true\n"]
[75.11499, "o", "printf '%s\\n' '--- listeners ---'; ss -ltnp | grep -E ':(22|8443) ' || true; printf '%s\\n' '--- nginx config ---'; nginx -t; printf '%s\\n' '--- ssh config ---'; sshd -T | grep -E '^(passwordauthentication|pubkeyauthentication) '; printf '%s\\n' '--- repository ---'; git --git-dir=/git/project rev-parse --is-bare-repository; ls -l /git/project/hooks/post-receive; printf '%s\\n' '--- https ---'; curl -k -I --max-time 5 https://localhost:8443/ || true; printf '%s\\n' '--- processes ---'; pgrep -a 'sshd|nginx' || true\r\n"]
[90.697018, "i", "set -u\nmkdir -p /run/sshd /var/www/main /var/www/dev\nchown -R git:git /git /var/www\nchmod 755 /git/project/hooks/post-receive\nsshd -t && nginx -t\npgrep -x nginx >/dev/null || /usr/sbin/nginx\npgrep -x sshd >/dev/null || /usr/sbin/sshd\nprintf '\\nLISTENERS\\n'; ss -ltnp | grep -E ':(22|8443) ' || true\nprintf '\\nPROCESSES\\n'; pgrep -a 'sshd|nginx' || true\nprintf '\\nREPOSITORY\\n'; git --git-dir=/git/project rev-parse --is-bare-repository; ls -l /git/project/hooks/post-receive\nprintf '\\nHTTPS\\n'; curl -k -sS -o /dev/null -w 'HTTP %{http_code}\\n' --max-time 5 https://localhost:8443/ || true\n"]
