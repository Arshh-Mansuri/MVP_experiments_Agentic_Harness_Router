cat > /git/project/hooks/post-receive <<'EOF'
#!/bin/sh
set -eu
repo=/git/project
base=/var/www
while IFS=' ' read -r oldrev newrev refname; do
    case "$refname" in
        refs/heads/main) target="$base/main" ;;
        refs/heads/dev) target="$base/dev" ;;
        *) continue ;;
    esac
    tmp="$base/.deploy-$(basename "$target")-$$"
    rm -rf "$tmp"
    mkdir "$tmp"
    git --git-dir="$repo" archive "$newrev" | tar -x -C "$tmp"
    rm -rf "$target"
    mv "$tmp" "$target"
    chmod -R a+rX "$target"
done
EOF
chown git:git /git/project/hooks/post-receive
chmod 755 /git/project/hooks/post-receive
mkdir -p /etc/nginx/ssl
openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
  -keyout /etc/nginx/ssl/localhost.key \
  -out /etc/nginx/ssl/localhost.crt \
  -subj '/CN=localhost' \
  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' 2>/dev/null
chmod 600 /etc/nginx/ssl/localhost.key
cat > /etc/nginx/sites-available/git-project <<'EOF'
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name localhost;
    ssl_certificate /etc/nginx/ssl/localhost.crt;
    ssl_certificate_key /etc/nginx/ssl/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/main;
    location ^~ /dev/ {
        alias /var/www/dev/;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
EOF
