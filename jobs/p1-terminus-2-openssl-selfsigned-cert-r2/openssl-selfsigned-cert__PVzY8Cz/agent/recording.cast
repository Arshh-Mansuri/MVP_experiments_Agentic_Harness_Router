[13.294157, "o", "\u001b[?2004hroot@c3cd6acc85e6:/app# "]
[13.329685, "i", "cat > /app/check_cert.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport ssl\nfrom datetime import datetime\nfrom email.utils import parsedate_to_datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\nif not os.path.isfile(CERT_PATH):\n    raise SystemExit(f\"Certificate not found: {CERT_PATH}\")\n\ntry:\n    with open(CERT_PATH, \"rb\") as cert_file:\n        pem_data = cert_file.read()\n    ssl.PEM_cert_to_DER_cert(pem_data.decode(\"ascii\"))\n    cert_info = ssl._ssl._test_decode_cert(CERT_PATH)\nexcept Exception as exc:\n    raise SystemExit(f\"Certificate could not be loaded: {exc}\")\n\ncommon_name = None\nfor attribute in cert_info.get(\"subject\", ()):\n    for key, value in attribute:\n        if key == \"commonName\":\n            common_name = value\n            break\n    if common_name:\n        break\n\nif not common_name:\n    raise SystemExit(\"Common Name not found\")\n\nexpiration = parsedate_to_datetime(cert_info[\"notAfter\"]).date().isoformat()\nprint(f\"Common Name: {common_name}\")\nprint(f\"Expiration date: {expiration}\")\nprint(\"Certificate "]
[13.329931, "i", "verification successful\")\nPY\nchmod 755 /app/check_cert.py\n/app/check_cert.py\n"]
[13.330142, "o", "cat > /app/check_cert.py <<'PY'\r\n\u001b[?2004l\r"]
[13.330174, "o", "verification successful\")\r\nPY\r\nchmod 755 /app/check_cert.py\r\n/app/check_cert.py\r\n"]
