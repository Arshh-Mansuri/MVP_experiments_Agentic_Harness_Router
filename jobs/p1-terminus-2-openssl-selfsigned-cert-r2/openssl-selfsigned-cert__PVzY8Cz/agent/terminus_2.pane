[?2004l[?2004h> 
[?2004l[?2004h> CERT_PATH = "/app/ssl/server.crt"
[?2004l[?2004h> 
[?2004l[?2004h> if not os.path.isfile(CERT_PATH):
[?2004l[?2004h>     raise SystemExit(f"Certificate not found: {CERT_PATH}")
[?2004l[?2004h> 
[?2004l[?2004h> try:
