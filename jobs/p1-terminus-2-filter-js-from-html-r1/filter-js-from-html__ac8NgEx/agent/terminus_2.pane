class Sanitizer(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=False)
        self.output = []
        self.in_script = False

    def emit(self, text):
        if not self.in_script:
            self.output.append(text)

    def handle_data(self, data):
        self.emit(data)

    def handle_entityref(self, name):
        self.emit("&" + name + ";")

    def handle_charref(self, name):
        self.emit("&#" + name + ";")

    def handle_comment(self, data):
        self.emit("<!--" + data + "-->")

    def handle_decl(self, decl):
        self.emit("<!" + decl + ">")

    def unknown_decl(self, data):
        self.emit("<![" + data + "]>")

    def handle_pi(self, data):
        self.emit("<?" + data + ">")

    def handle_starttag(self, tag, attrs):
        tag_lower = tag.lower()
        raw = self.get_starttag_text() or ("<" + tag + ">")

        if tag_lower == "script":
            self.in_script = True
            return

        remove_names = set()
        attr_values = {name.lower(): (value or "") for name, value in attrs}

        for name, value in attrs:
            lname = name.lower()
            if lname.startswith("on") and len(lname) > 2:
                remove_names.add(lname)
            elif lname == "srcdoc":
                remove_names.add(lname)
            elif lname in URI_ATTRIBUTES and dangerous_url(value):
                remove_names.add(lname)
            elif lname == "style" and dangerous_css(value):
                remove_names.add(lname)

        # A refresh meta tag can navigate to a javascript: URL through its
        # content attribute.
        if tag_lower == "meta":
            equiv = attr_values.get("http-equiv", "").strip().lower()
            content = attr_values.get("content", "")
            if equiv == "refresh" and re.search(r"(?is)(?:^|[;,])\s*url\s*=\s*javascript:", unescape(content)):
                remove_names.add("content")

        if remove_names:
            def replace_attr(match):
                if match.group(2).lower() in remove_names:
                    return ""
                return match.group(0)
            raw = _ATTR_RE.sub(replace_attr, raw)

        self.emit(raw)

    def handle_startendtag(self, tag, attrs):
        if tag.lower() == "script":
            return
        # HTMLParser provides the original spelling and spacing for start tags.
        self.handle_starttag(tag, attrs)
        if self.output and not self.output[-1].rstrip().endswith("/"):
            # This branch is normally unnecessary; retain the source form by
            # using the parser's original self-closing tag text below instead.
            pass

    def handle_endtag(self, tag):
        if tag.lower() == "script":
            self.in_script = False
            return
        self.emit("</" + tag + ">")


