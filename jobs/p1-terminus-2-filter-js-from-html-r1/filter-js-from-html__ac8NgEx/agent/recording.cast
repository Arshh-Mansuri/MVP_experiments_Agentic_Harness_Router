[29.664624, "o", "            self.in_script = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.664695, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.664916, "o", "        self.emit(\"</\" + tag + \">\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.664958, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.665068, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.665161, "o", "> "]
[29.665382, "o", "        raise SystemExit(\"usage: filter.py HTML_FILE\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.665565, "o", "    path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h>     with open(path, \"rb\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.665698, "o", "> "]
[29.665724, "o", "        data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.665874, "o", "    text = data.decode(\"utf-8\", errors=\"surrogateescape\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.666017, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.666064, "o", "    parser = Sanitizer()\r\n\u001b[?2004l\r"]
[29.666206, "o", "\u001b[?2004h>     parser.feed(text)\r\n\u001b[?2004l\r"]
[29.666246, "o", "\u001b[?2004h>     parser.close()\r\n"]
[29.666386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[29.666508, "o", "    result = \"\".join(parser.output).encode(\"utf-8\", errors=\"surrogateescape\")\r\n\u001b[?2004l\r"]
[29.666671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.666694, "o", "    directory = os.path.dirname(path) or \".\"\r\n\u001b[?2004l\r"]
[29.666767, "o", "\u001b[?2004h> "]
[29.666949, "o", "    fd, temporary = tempfile.mkstemp(prefix=\".filter-\", dir=directory)\r\n\u001b[?2004l\r"]
[29.666977, "o", "\u001b[?2004h>     try:"]
[29.666989, "o", "\r\n\u001b[?2004l\r"]
[29.66713, "o", "\u001b[?2004h>         with os.fdopen(fd, \"wb\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.667147, "o", "            f.write(result)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.66728, "o", "        os.chmod(temporary, os.stat(path).st_mode)"]
[29.667486, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         os.replace(temporary, path)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.667594, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h>             os.unlink(temporary)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.667717, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.66789, "o", "        raise\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.667911, "o", "> \r\n"]
[29.668, "o", "\u001b[?2004l\r"]
[29.668032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.668047, "o", "\u001b[?2004h> "]
[29.668166, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[29.66824, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[29.696149, "o", "\u001b[?2004hroot@eef587e4dab1:/app# chmod +x /app/filter.py\r\n\u001b[?2004l\r"]
[29.721628, "o", "\u001b[?2004hroot@eef587e4dab1:/app# python3 -m py_compile /app/filter.py\r\n\u001b[?2004l\r"]
[30.059191, "o", "\u001b[?2004hroot@eef587e4dab1:/app# "]
[36.903285, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/tmp/filter-test.html')\np.write_text('''<!doctype html>\\n<div class=\"ok\" onclick=\"alert(1)\" data-x=\"1\">Hello &amp; <b>world</b></div>\\n<script>alert(1)</script>\\n<a href=\" javascript&#58;alert(1)\" title=\"keep\">link</a>\\n<img src=\"x\" onerror='bad()' />\\n<div style=\"color:red\">safe</div>\\n<div style=\"width: expression(alert(1))\">bad-css</div>\\n<iframe srcdoc=\"<script>alert(1)</script>\"></iframe>\\n<!-- keep comment -->\\n''')\nPY\npython3 /app/filter.py /tmp/filter-test.html\ncat /tmp/filter-test.html\n"]
[36.905402, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('/tmp/filter-test.html')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.907378, "o", "p.write_text('''<!doctype html>\\n<div class=\"ok\" onclick=\"alert(1)\" data-x=\"1\">Hello &amp; <b>world</b></div>\\n<script>alert(1)</script>\\n<a href=\" javascript&#58;alert(1)\" title=\"keep\">link</a>\\n<img src=\"x\" onerror='bad()' />\\n<div style=\"color:red\">safe</div>\\n<div style=\"width: expression(alert(1))\">bad-css</div>\\n<iframe srcdoc=\"<script>alert(1)</script>\"></iframe>\\n<!-- keep comment -->\\n''')\r\n\u001b[?2004l\r"]
[36.907937, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[37.083516, "o", "\u001b[?2004hroot@eef587e4dab1:/app# "]
[37.083809, "o", "python3 /app/filter.py /tmp/filter-test.html\r\n\u001b[?2004l\r"]
[37.261297, "o", "\u001b[?2004hroot@eef587e4dab1:/app# "]
[37.261364, "o", "cat /tmp/filter-test.html\r\n\u001b[?2004l\r"]
[37.278533, "o", "<!doctype html>\r\n<div class=\"ok\" data-x=\"1\">Hello &amp; <b>world</b></div>\r\n\r\n<a title=\"keep\">link</a>\r\n<img src=\"x\" />\r\n<div style=\"color:red\">safe</div>\r\n<div>bad-css</div>\r\n<iframe></iframe>\r\n<!-- keep comment -->\r\n"]
[37.280148, "o", "\u001b[?2004hroot@eef587e4dab1:/app# "]
[37.89412, "i", "grep -nE 'script|onclick|onerror|javascript|expression|srcdoc' /tmp/filter-test.html || true\npython3 -m py_compile /app/filter.py\n"]
[37.894471, "o", "grep -nE 'script|onclick|onerror|javascript|expression|srcdoc' /tmp/filter-test.html || true\r\n\u001b[?2004l\r"]
[37.924145, "o", "\u001b[?2004hroot@eef587e4dab1:/app# "]
[37.924311, "o", "python3 -m py_compile /app/filter.py\r\n\u001b[?2004l\r"]
