[29.624635, "i", "cat > /app/filter.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport re\nimport sys\nimport tempfile\nfrom html import unescape\nfrom html.parser import HTMLParser\n\n\n# Attributes whose values can cause a URL to be interpreted as JavaScript.\nURI_ATTRIBUTES = {\n    \"href\", \"src\", \"action\", \"formaction\", \"xlink:href\", \"poster\",\n    \"background\", \"cite\", \"longdesc\", \"manifest\", \"data\", \"codebase\",\n}\n\n\ndef dangerous_url(value):\n    \"\"\"Recognize javascript: URLs even when whitespace/control characters or\n    character references are used to disguise the scheme.\n    \"\"\"\n    value = unescape(value or \"\")\n    value = re.sub(r\"[\\x00-\\x20\\x7f\\xa0]+\", \"\", value)\n    return bool(re.match(r\"(?i)^javascript:\", value))\n\n\ndef dangerous_css(value):\n    value = unescape(value or \"\")\n    return bool(re.search(\n        r\"(?is)(?:expression\\s*\\(|-moz-binding\\s*:|behavior\\s*:|\"\n        r\"url\\s*\\(\\s*[\\\"']?\\s*javascript:)\", value\n    ))\n\n\n_ATTR_RE = re.compile(\n    r\"(?is)(\\s+)([a-z][a-z0-9_:.-]*)(?:\\s*=\\s*(?:\\\"[^\\\"]*\\\"|'[^']*'|[^\\s\\\"'=<>"]
[29.626991, "i", "`]+))?\"\n)\n\n\nclass Sanitizer(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=False)\n        self.output = []\n        self.in_script = False\n\n    def emit(self, text):\n        if not self.in_script:\n            self.output.append(text)\n\n    def handle_data(self, data):\n        self.emit(data)\n\n    def handle_entityref(self, name):\n        self.emit(\"&\" + name + \";\")\n\n    def handle_charref(self, name):\n        self.emit(\"&#\" + name + \";\")\n\n    def handle_comment(self, data):\n        self.emit(\"<!--\" + data + \"-->\")\n\n    def handle_decl(self, decl):\n        self.emit(\"<!\" + decl + \">\")\n\n    def unknown_decl(self, data):\n        self.emit(\"<![\" + data + \"]>\")\n\n    def handle_pi(self, data):\n        self.emit(\"<?\" + data + \">\")\n\n    def handle_starttag(self, tag, attrs):\n        tag_lower = tag.lower()\n        raw = self.get_starttag_text() or (\"<\" + tag + \">\")\n\n        if tag_lower == \"script\":\n            self.in_script = True\n            return\n\n        remove_names = set()\n      "]
