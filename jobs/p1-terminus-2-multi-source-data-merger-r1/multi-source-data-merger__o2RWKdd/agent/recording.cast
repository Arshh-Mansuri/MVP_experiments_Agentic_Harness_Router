[34.066844, "i", "python3 - <<'PY'\nimport json\nimport pandas as pd\n\nsources = {\n    'source_a': '/data/source_a/users.json',\n    'source_b': '/data/source_b/users.csv',\n    'source_c': '/data/source_c/users.parquet',\n}\npriority = ['source_a', 'source_b', 'source_c']\nfields = ['user_id', 'name', 'email', 'created_date', 'status']\naliases = {\n    'user_id': ['user_id', 'id', 'userId'],\n    'name': ['full_name', 'name', 'userName'],\n    'email': ['email', 'email_address'],\n    'created_date': ['registration_date', 'created_at', 'joined'],\n    'status': ['status', 'is_active'],\n}\n\ndef read_source(src, path):\n    if src == 'source_a':\n        with open(path, encoding='utf-8') as f:\n            obj = json.load(f)\n        if isinstance(obj, dict):\n            obj = obj.get('users', obj.get('data', obj.get('records', [obj])))\n        return pd.DataFrame(obj)\n    if src == 'source_b':\n        return pd.read_csv(path)\n    return pd.read_parquet(path)\n\ndef missing(v):\n    if v is None:\n        return True\n    try:\n        return bool(pd.isna(v))\n    except (TypeError, ValueError):\n        return False\n\ndef norm(v, field):\n    if missing(v):\n        return None\n    if field == 'user_id':\n        return int(v)\n    if field == 'created_date':\n        d = pd.to_datetime(str(v).strip(), errors='coerce')\n        return str(v).strip() if pd.isna(d) else d.strftime('%Y-%m-%d')\n    if field == 'status' and isinstance(v, bool):\n        return 'true' if v else 'false'\n    return str(v).strip()\n\ndef normalize(df):\n    result = []\n    for _, row in df.iterrows():\n        rec = {}\n        for target, names in aliases.items():\n            rec[target] = None\n            for name in names:\n                if name in df.columns:\n                    value = norm(row[name], target)\n                    if value is not None:\n                        rec[target] = value\n                        break\n        if rec['user_id'] is not None:\n            result.append(rec)\n    return result\n\nby_source = {}\nfor src, path in sources.items():\n    grouped = {}\n    for rec in normalize(read_source(src, path)):\n        uid = rec['user_id']\n        if uid not in grouped:\n            grouped[uid] = rec\n        else:\n            for field in fields[1:]:\n                if grouped[uid][field] is None and rec[field] is not None:\n                    grouped[uid][field] = rec[field]\n    by_source[src] = grouped\n\nconflicts = []\nmerged = []\nfor uid in sorted(set().union(*(set(x) for x in by_source.values()))):\n    row = {'user_id': uid}\n    for field in fields[1:]:\n        vals = {src: by_source[src][uid][field] for src in priority if uid in by_source[src] and by_source[src][uid][field] is not None}\n        selected = next((vals[src] for src in priority if src in vals), None)\n        row[field] = selected\n        if len(set(vals.values())) > 1:\n            conflicts.append({'user_id': uid, 'field': field, 'values': vals, 'selected': selected})\n    merged.append(row)\n\nout = pd.DataFrame(merged, columns=fields)\nout['user_id'] = out['user_id'].astype('int64')\nout.to_parquet('/app/merged_users.parquet', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2)\nprint('merged rows:', len(out))\nprint('conflicts:', len(conflicts))\nprint(out.to_string(index=False))\nPY\n"]
