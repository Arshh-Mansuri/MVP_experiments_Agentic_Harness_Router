[16.394193, "i", "cat > /tmp/merge_users.py <<'PY'\nimport json\nimport os\nfrom datetime import datetime\nimport pandas as pd\n\npaths = {\n    'source_a': '/data/source_a/users.json',\n    'source_b': '/data/source_b/users.csv',\n    'source_c': '/data/source_c/users.parquet',\n}\npriority = ['source_a', 'source_b', 'source_c']\nfields = ['user_id', 'name', 'email', 'created_date', 'status']\n\n\ndef load_json(path):\n    with open(path, 'r', encoding='utf-8') as f:\n        obj = json.load(f)\n    if isinstance(obj, dict):\n        for key in ('users', 'data', 'records'):\n            if key in obj and isinstance(obj[key], list):\n                obj = obj[key]\n                break\n        else:\n            obj = [obj]\n    return pd.DataFrame(obj)\n\n\ndef normalize_date(value):\n    if value is None or (isinstance(value, float) and pd.isna(value)) or pd.isna(value):\n        return None\n    s = str(value).strip()\n    if not s:\n        return None\n    dt = pd.to_datetime(s, errors='coerce')\n    if pd.isna(dt):\n        return s[:10] if len(s) >= 10 else s\n    return dt.strftime('%Y-%m-%d')\n\n\ndef clean_value(value, field):\n    if value is None:\n        return None\n    try:\n        if pd.isna(value):\n            return None\n    except (TypeError, ValueError):\n        pass\n    if field == 'user_id':\n        return int(value)\n    if field == 'created_date':\n        return normalize_date(value)\n    return str(value).strip()\n\n\ndef normalize(df):\n    aliases = {\n        'user_id': ['user_id', 'id', 'userId'],\n        'email': ['email', 'email_address'],\n        'name': ['full_name', 'name', 'userName'],\n        'created_date': ['registration_date', 'created_at', 'joined'],\n        'status': ['status'],\n    }\n    out = []\n    for _, row in df.iterrows():\n        rec = {}\n        for target, names in aliases.items():\n            val = None\n            for name in names:\n                if name in df.columns:\n                    candidate = clean_value(row[name], target)\n                    if candidate is not None:\n                        val = candidate\n                        break\n            rec[target] = val\n        if rec['user_id'] is None:\n            continue\n        out.append(rec)\n    return out\n\nraw = {}\nraw['source_a'] = load_json(paths['source_a'])\nraw['source_b'] = pd.read_csv(paths['source_b'])\nraw['source_c'] = pd.read_parquet(paths['source_c'])\nrecords = {src: normalize(df) for src, df in raw.items()}\n\n# Collapse duplicate records within a source, retaining the first non-empty value.\nby_source = {}\nfor src in priority:\n    grouped = {}\n    for rec in records[src]:\n        uid = rec['user_id']\n        if uid not in grouped:\n            grouped[uid] = rec.copy()\n        else:\n            for field in fields[1:]:\n                if grouped[uid].get(field) is None and rec.get(field) is not None:\n                    grouped[uid][field] = rec[field]\n    by_source[src] = grouped\n\nall_ids = sorted(set().union(*(set(x) for x in by_source.values())))\nmerged = []\nconflicts = []\nfor uid in all_ids:\n    selected = {}\n    for field in fields[1:]:\n        vals = {src: by_source[src][uid].get(field) for src in priority if uid in by_source[src] and by_source[src][uid].get(field) is not None}\n        chosen = None\n        for src in priority:\n            if src in vals:\n                chosen = vals[src]\n                break\n        selected[field] = chosen\n        distinct = []\n        for value in vals.values():\n            if value not in distinct:\n                distinct.append(value)\n        if len(distinct) > 1:\n            conflicts.append({\n                'user_id': uid,\n                'field': field,\n                'values': {src: vals[src] for src in priority if src in vals},\n                'selected': chosen,\n            })\n    merged.append({'user_id': uid, **selected})\n\nout = pd.DataFrame(merged, columns=fields)\nout['user_id'] = out['user_id'].astype('int64')\nfor col in ['name', 'email', 'created_date', 'status']:\n    out[col] = out[col].astype('object')\n# Keep the optional status column, as requested, while ensuring nulls are represented properly.\no"]
[16.395368, "i", "ut.to_parquet('/app/merged_users.parquet', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\nprint('sources:', {k: len(v) for k, v in records.items()})\nprint('unique_users:', len(out))\nprint('conflicts:', len(conflicts))\nprint(out.dtypes.to_string())\nPY\npython3 /tmp/merge_users.py\n"]
[16.396021, "o", "cat > /tmp/merge_users.py <<'PY'\r\nimport json\r\nimport os\r\nfrom datetime import datetime\r\nimport pandas as pd\r\n\r\npaths = {\r\n    'source_a': '/data/source_a/users.json',\r\n    'source_b': '/data/source_b/users.csv',\r\n    'source_c': '/data/source_c/users.parquet',\r\n}\r\npriority = ['source_a', 'source_b', 'source_c']\r\nfields = ['user_id', 'name', 'email', 'created_date', 'status']\r\n\r\n\r\ndef load_json(path):\r\n    with open(path, 'r', encoding='utf-8') as f:\r\n        obj = json.load(f)\r\n    if isinstance(obj, dict):\r\n        for key in ('users', 'data', 'records'):\r\n            if key in obj and isinstance(obj[key], list):\r\n                obj = obj[key]\r\n                break\r\n        else:\r\n            obj = [obj]\r\n    return pd.DataFrame(obj)\r\n\r\n\r\ndef normalize_date(value):\r\n    if value is None or (isinstance(value, float) and pd.isna(value)) or pd.isna(value):\r\n        return None\r\n    s = str(value).strip()\r\n    if not s:\r\n        return None\r\n    dt = pd.to_datetime(s, errors='coerce')\r\n    if pd.isna(dt):\r\n        return s[:10] if len(s) >= 10 else s\r\n    return dt.strftime('%Y-%m-%d')\r\n\r\n\r\ndef clean_value(value, field):\r\n    if value is None:\r\n        return None\r\n    try:\r\n        if pd.isna(value):\r\n            return None\r\n    except (TypeError, ValueError):\r\n        pass\r\n    if field == 'user_id':\r\n        return int(value)\r\n    if field == 'created_date':\r\n        return normalize_date(value)\r\n    return str(value).strip()\r\n\r\n\r\ndef normalize(df):\r\n    aliases = {\r\n        'user_id': ['user_id', 'id', 'userId'],\r\n        'email': ['email', 'email_address'],\r\n        'name': ['full_name', 'name', 'userName'],\r\n        'created_date': ['registration_date', 'created_at', 'joined'],\r\n        'status': ['status'],\r\n    }\r\n    out = []\r\n    for _, row in df.iterrows():\r\n        rec = {}\r\n        for target, names in aliases.items():\r\n            val = None\r\n            for name in names:\r\n                if name in df.columns:\r\n                    candidate = clean_value(row[name], target)\r\n                    if candidate is not None:\r\n                        val = candidate\r\n                        break\r\n            rec[target] = val\r\n        if rec['user_id'] is None:\r\n            continue\r\n        out.append(rec)\r\n    return out\r\n\r\nraw = {}\r\nraw['source_a'] = load_json(paths['source_a'])\r\nraw['source_b'] = pd.read_csv(paths['source_b'])\r\nraw['source_c'] = pd.read_parquet(paths['source_c'])\r\nrecords = {src: normalize(df) for src, df in raw.items()}\r\n\r\n# Collapse duplicate records within a source, retaining the first non-empty value.\r\nby_source = {}\r\nfor src in priority:\r\n    grouped = {}\r\n    for rec in records[src]:\r\n        uid = rec['user_id']\r\n        if uid not in grouped:\r\n            grouped[uid] = rec.copy()\r\n        else:\r\n            for field in fields[1:]:\r\n                if grouped[uid].get(field) is None and rec.get(field) is not None:\r\n                    grouped[uid][field] = rec[field]\r\n    by_source[src] = grouped\r\n\r\nall_ids = sorted(set().union(*(set(x) for x in by_source.values())))\r\nmerged = []\r\nconflicts = []\r\nfor uid in all_ids:\r\n    selected = {}\r\n    for field in fields[1:]:\r\n        vals = {src: by_source[src][uid].get(field) for src in priority if uid in by_source[src] and by_source[src][uid].get(field) is not None}\r\n        chosen = None\r\n        for src in priority:\r\n            if src in vals:\r\n                chosen = vals[src]\r\n                break\r\n        selected[field] = chosen\r\n        distinct = []\r\n        for value in vals.values():\r\n            if value not in distinct:\r\n                distinct.append(value)\r\n        if len(distinct) > 1:\r\n            conflicts.append({\r\n                'user_id': uid,\r\n                'field': field,\r\n                'values': {src: vals[src] for src in priority if src in vals},\r\n                'selected': chosen,\r\n            })\r\n    merged.append({'user_id': uid, **selected})\r\n\r\nout = pd.DataFrame(merged, columns=fields)\r\nout['user_id'] = out['user_id'].astype('int64')\r\nfor col in ['name', 'email', 'created_date', 'status']:\r\n    out[c"]
