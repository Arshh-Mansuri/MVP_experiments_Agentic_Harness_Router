[34.076299, "o", "    row = {'user_id': uid}\r\n\u001b[?2004l\r\u001b[?2004h>     for field in fields[1:]:\r\n\u001b[?2004l\r\u001b[?2004h>         vals = {src: by_source[src][uid][field] for src in priority if uid in by_source[src] and by_source[src][uid][field] is not None}\r\n\u001b[?2004l\r\u001b[?2004h>         selected = next((vals[src] for src in priority if src in vals), None)\r\n\u001b[?2004l\r\u001b[?2004h>         row[field] = selected\r\n\u001b[?2004l\r\u001b[?2004h>         if len(set(vals.values())) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>             conflicts.append({'user_id': uid, 'field': field, 'values': vals, 'selected': selected})\r\n\u001b[?2004l\r\u001b[?2004h>     merged.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out = pd.DataFrame(merged, columns=fields)\r\n\u001b[?2004l\r\u001b[?2004h> out['user_id'] = out['user_id'].astype('int64')\r\n\u001b[?2004l\r\u001b[?2004h> out.to_parquet('/app/merged_users.parquet', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/conflicts.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('merged rows:', len(out))\r\n\u001b[?2004l\r\u001b[?2004h> print('conflicts:', len(conflicts))\r\n\u001b[?2004l\r\u001b[?2004h> print(out.to_string(index=False))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
