cat > /tmp/merge_users.py <<'PY'
import json
import os
from datetime import datetime
import pandas as pd

paths = {
    'source_a': '/data/source_a/users.json',
    'source_b': '/data/source_b/users.csv',
    'source_c': '/data/source_c/users.parquet',
}
priority = ['source_a', 'source_b', 'source_c']
fields = ['user_id', 'name', 'email', 'created_date', 'status']


def load_json(path):
    with open(path, 'r', encoding='utf-8') as f:
        obj = json.load(f)
    if isinstance(obj, dict):
        for key in ('users', 'data', 'records'):
            if key in obj and isinstance(obj[key], list):
                obj = obj[key]
                break
        else:
            obj = [obj]
    return pd.DataFrame(obj)


def normalize_date(value):
    if value is None or (isinstance(value, float) and pd.isna(value)) or pd.isna(value):
        return None
    s = str(value).strip()
    if not s:
        return None
    dt = pd.to_datetime(s, errors='coerce')
    if pd.isna(dt):
        return s[:10] if len(s) >= 10 else s
    return dt.strftime('%Y-%m-%d')


def clean_value(value, field):
    if value is None:
        return None
    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass
    if field == 'user_id':
        return int(value)
    if field == 'created_date':
        return normalize_date(value)
    return str(value).strip()


def normalize(df):
    aliases = {
        'user_id': ['user_id', 'id', 'userId'],
        'email': ['email', 'email_address'],
        'name': ['full_name', 'name', 'userName'],
        'created_date': ['registration_date', 'created_at', 'joined'],
        'status': ['status'],
    }
    out = []
    for _, row in df.iterrows():
        rec = {}
        for target, names in aliases.items():
            val = None
            for name in names:
                if name in df.columns:
                    candidate = clean_value(row[name], target)
                    if candidate is not None:
                        val = candidate
                        break
            rec[target] = val
        if rec['user_id'] is None:
            continue
        out.append(rec)
    return out

raw = {}
raw['source_a'] = load_json(paths['source_a'])
raw['source_b'] = pd.read_csv(paths['source_b'])
raw['source_c'] = pd.read_parquet(paths['source_c'])
records = {src: normalize(df) for src, df in raw.items()}

# Collapse duplicate records within a source, retaining the first non-empty value.
by_source = {}
for src in priority:
    grouped = {}
    for rec in records[src]:
        uid = rec['user_id']
        if uid not in grouped:
            grouped[uid] = rec.copy()
        else:
            for field in fields[1:]:
                if grouped[uid].get(field) is None and rec.get(field) is not None:
                    grouped[uid][field] = rec[field]
    by_source[src] = grouped

all_ids = sorted(set().union(*(set(x) for x in by_source.values())))
merged = []
conflicts = []
for uid in all_ids:
    selected = {}
    for field in fields[1:]:
        vals = {src: by_source[src][uid].get(field) for src in priority if uid in by_source[src] and by_source[src][uid].get(field) is not None}
        chosen = None
        for src in priority:
            if src in vals:
                chosen = vals[src]
                break
        selected[field] = chosen
        distinct = []
        for value in vals.values():
            if value not in distinct:
                distinct.append(value)
        if len(distinct) > 1:
            conflicts.append({
                'user_id': uid,
                'field': field,
                'values': {src: vals[src] for src in priority if src in vals},
                'selected': chosen,
            })
    merged.append({'user_id': uid, **selected})

out = pd.DataFrame(merged, columns=fields)
out['user_id'] = out['user_id'].astype('int64')
for col in ['name', 'email', 'created_date', 'status']:
    out[col] = out[col].astype('object')
# Keep the optional status column, as requested, while ensuring nulls are represented properly.
o   userId     userName        email      joined  active
0     101      John D.   john@c.com  2024-01-20    True
1     104  Alice Brown  alice@c.com  2024-04-01    True
userId       int64
userName    object
email       object
joined      object
active        bool
dtype: object
