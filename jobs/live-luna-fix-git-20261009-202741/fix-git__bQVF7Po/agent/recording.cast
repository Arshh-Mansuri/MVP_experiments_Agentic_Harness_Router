[41.960826, "o", "\u001b[m\r\n SHIFT-TAB ...................... ESC-TAB   Complete filename & reverse cycle.\u001b[m\r\n ctrl-L ................................... Complete filename, list all.\u001b[m\r\n\u001b[7mHELP -- END -- Press g to see it again, or q when done\u001b[27m\u001b[K\r\u001b[KExamine: \u001b[KR\bR\u001b[K=\b=\u001b[Kc\bc\u001b[Ka\ba\u001b[Kt\bt\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Kc\bc\u001b[Kh\bh\u001b[Ke\be\u001b[Kr\br\u001b[Kr\br\u001b[Ky\by\u001b[K-\b-\u001b[Kp\bp\u001b[Ki\bi\u001b[Kc\bc\u001b[Kk\bk\u001b[K \b \u001b[Kc\bc\u001b[K4\b4\u001b[K9\b9\u001b[K9\b9\u001b[K7\b7\u001b[K3\b3\u001b[K0\b0\r\u001b[K"]
