[15.53741, "o", "\u001b[Kc\bc\u001b[Ko\bo\u001b[Km\bm\u001b[Km\bm\u001b[Ki\bi\u001b[Kt\bt\u001b[K:\b:\u001b[K \b \u001b[K%\b%\u001b[Ks\bs\u001b[K\\\b\\\u001b[Kn\bn\u001b[K'\b'\u001b[K \b \u001b[K\"\b\"\u001b[K$\b$\u001b[K?\b?\u001b[K\"\b\"\u001b[K;\b;\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Kr\br\u001b[Ke\be\u001b[Kv\bv\u001b[K-\b-"]
[15.53747, "o", "\u001b[Kl\bl\u001b[Ki\bi\u001b[Ks\bs\u001b[Kt\bt\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kp\bp\u001b[Ka\ba\u001b[Kr\br\u001b[Ke\be\u001b[Kn\bn\u001b[Kt\bt\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[Kn\bn\u001b[K \b \u001b[K1\b1\u001b[K \b \u001b[Kc\bc\u001b[K4\b4\u001b[K9\b9\u001b[K9\b9\u001b[K7\b7\u001b[K3\b3\u001b[K0\b0\r\u001b[K"]
[15.53753, "o", "\r\u001b[K\u001b[7mMax buffer space per file: 64K  (press RETURN)\u001b[27m"]
