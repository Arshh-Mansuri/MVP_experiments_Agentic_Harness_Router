[0.773944, "o", "\u001b[?2004hroot@1785cecedb52:/app# "]
[21.584794, "i", "cat > /app/solve_distribution.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nN = 150000\nn1, n2, n3 = 1, 20000, N - 1 - 20000\ntarget = 10.0\n\n# Stable softmax for the total masses of the three groups.\ndef masses(x):\n    z = np.array([x[0], x[1], 0.0], dtype=float)\n    z -= np.max(z)\n    e = np.exp(z)\n    return e / e.sum()\n\ndef divergences(x):\n    m1, m2, m3 = masses(x)\n    counts = np.array([n1, n2, n3], dtype=float)\n    probs = np.array([m1 / n1, m2 / n2, m3 / n3], dtype=float)\n    # Grouped forms of KL(P||U) and KL(U||P), U(i)=1/N.\n    forward = np.sum(np.array([m1, m2, m3]) * np.log(probs * N))\n    backward = np.sum((counts / N) * np.log(1.0 / (probs * N)))\n    return forward, backward\n\ndef residual(x):\n    f, b = divergences(x)\n    return np.array([f - target, b - target])\n\n# The initial point has approximately 85% mass on the singleton,\n# almost all remaining mass on the medium group, and a tiny low-group mass.\nx0 = np.array([10.7, 9.0])\nsol = least_squares(residual, x0, xtol=1e-14"]
[21.588269, "o", "cat > /app/solve_distribution.py <<'PY'"]
[21.588421, "i", ", ftol=1e-14, gtol=1e-14, max_nfev=5000)\nif not sol.success or np.max(np.abs(residual(sol.x))) > 1e-8:\n    raise RuntimeError(f'Could not solve KL constraints: {sol.message}; residual={residual(sol.x)}')\n\nm1, m2, m3 = masses(sol.x)\ndist = np.empty(N, dtype=np.float64)\ndist[0] = m1 / n1\ndist[1:1+n2] = m2 / n2\ndist[1+n2:] = m3 / n3\ndist /= dist.sum()\n\n# Verify using the full array and save the requested artifact.\nuniform = 1.0 / N\nforward = np.sum(dist * np.log(dist / uniform))\nbackward = np.sum(uniform * np.log(uniform / dist))\nif abs(dist.sum() - 1.0) > 1e-12 or np.any(dist <= 0):\n    raise RuntimeError('Invalid probability distribution')\nif abs(forward - target) > 0.001 or abs(backward - target) > 0.001:\n    raise RuntimeError(f'KL tolerance failure: forward={forward}, backward={backward}')\n\nnp.save('/app/dist.npy', dist)\nprint('saved /app/dist.npy')\nprint('shape:', dist.shape)\nprint('sum:', repr(dist.sum()))\nprint('min:', repr(dist.min()), 'max:', repr(dist.max()))\nprint('forward KL:', repr(forward))\nprint("]
[21.588495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.588956, "i", "'backward KL:', repr(backward))\nprint('group masses:', m1, m2, m3)\nPY\npython3 /app/solve_distribution.py\npython3 - <<'PY'\nimport numpy as np\np = np.load('/app/dist.npy')\nprint('exists:', p.shape, p.dtype, np.isclose(p.sum(), 1.0))\nPY\n"]
