python3 - <<'PY'
p='/etc/postfix/main.cf'
lines=open(p).read().splitlines()
remove={'local_transport','mailbox_transport','mailbox_command','home_mailbox'}
out=[]
for line in lines:
    if '=' in line and not line.lstrip().startswith('#'):
        key=line.split('=',1)[0].strip()
        if key in remove:
            continue
    if 'local:$' in line and ('???' in line or '$local_recipient' in line):
        continue
    out.append(line)
# Ensure required valid settings exist exactly once.
def setv(key,val):
    global out
    found=False; new=[]
    for line in out:
        if '=' in line and not line.lstrip().startswith('#') and line.split('=',1)[0].strip()==key:
            if not found: new.append(key+' = '+val); found=True
        else: new.append(line)
    if not found: new.append(key+' = '+val)
    out=new
setv('mydestination','$myhostname, localhost, localhost.localdomain, local.edu')
setv('mail_spool_directory','/var/mail')
setv('transport_maps','hash:/var/lib/mailman3/data/postfix_lmtp')
setv('virtual_alias_maps','')
open(p,'w').write('\n'.join(out)+'\n')
PY
postfix check; echo CHECK=$?; grep -E '^(mydestination|mail_spool_directory|local_transport|mailbox_transport|mailbox_command|home_mailbox|transport_maps|virtual_alias_maps)' /etc/postfix/main.cf
postfix stop 2>/dev/null || true; sleep 1; postfix start; sleep 3; postconf -n | grep -E '^(mydestination|mail_spool_directory|local_transport|mailbox_transport|transport_maps|virtual_alias_maps)' || true; postqueue -f; sleep 5; ls -l /var/mail/0c3e8269bcfbe5da 2>&1 || true; postqueue -p
