[283.270653, "i", "python3 - <<'PY'\np='/etc/postfix/main.cf'\nlines=open(p).read().splitlines()\nremove={'local_transport','mailbox_transport','mailbox_command','home_mailbox'}\nout=[]\nfor line in lines:\n    if '=' in line and not line.lstrip().startswith('#'):\n        key=line.split('=',1)[0].strip()\n        if key in remove:\n            continue\n    if 'local:$' in line and ('???' in line or '$local_recipient' in line):\n        continue\n    out.append(line)\n# Ensure required valid settings exist exactly once.\ndef setv(key,val):\n    global out\n    found=False; new=[]\n    for line in out:\n        if '=' in line and not line.lstrip().startswith('#') and line.split('=',1)[0].strip()==key:\n            if not found: new.append(key+' = '+val); found=True\n        else: new.append(line)\n    if not found: new.append(key+' = '+val)\n    out=new\nsetv('mydestination','$myhostname, localhost, localhost.localdomain, local.edu')\nsetv('mail_spool_directory','/var/mail')\nsetv('transport_maps','hash:/var/lib/mailman3/data/postfix_lmtp')\nsetv('virtual_alias_maps','')\nopen(p,'w').write('\\n'.join(out)+'\\n')\nPY\npostfix check; echo CHECK=$?; grep -E '^(mydestination|mail_spool_directory|local_transport|mailbox_transport|mailbox_command|home_mailbox|transport_maps|virtual_alias_maps)' /etc/postfix/main.cf\n"]
[283.272883, "o", "python3 - <<'PY'\r\np='/etc/postfix/main.cf'\r\nlines=open(p).read().splitlines()\r\nremove={'local_transport','mailbox_transport','mailbox_command','home_mailbox'}\r\nout=[]\r\nfor line in lines:\r\n    if '=' in line and not line.lstrip().startswith('#'):\r\n        key=line.split('=',1)[0].strip()\r\n        if key in remove:\r\n            continue\r\n    if 'local:$' in line and ('???' in line or '$local_recipient' in line):\r\n        continue\r\n    out.append(line)\r\n# Ensure required valid settings exist exactly once.\r\ndef setv(key,val):\r\n    global out\r\n    found=False; new=[]\r\n    for line in out:\r\n        if '=' in line and not line.lstrip().startswith('#') and line.split('=',1)[0].strip()==key:\r\n            if not found: new.append(key+' = '+val); found=True\r\n        else: new.append(line)\r\n    if not found: new.append(key+' = '+val)\r\n    out=new\r\nsetv('mydestination','$myhostname, localhost, localhost.localdomain, local.edu')\r\nsetv('mail_spool_directory','/var/mail')\r\nsetv('transport_maps','hash:/var/lib/mailman3/data/postfix_lmtp')\r\nsetv('virtual_alias_maps','')\r\nopen(p,'w').write('\\n'.join(out)+'\\n')\r\nPY\r\npostfix check; echo CHECK=$?; grep -E '^(mydestination|mail_spool_directory|local_transport|mailbox_transport|mailbox_command|home_mailbox|transport_maps|virtual_alias_maps)' /etc/postfix/main.cf\r\n"]
