[50.358429, "o", "\u001b[01;31m\u001b[Kpostfix\u001b[m\u001b[K-resolvconf.path                      disabled enabled\r\n\u001b[01;31m\u001b[Kmailman\u001b[m\u001b[K3.service                             enabled  enabled\r\n\u001b[01;31m\u001b[Kpostfix\u001b[m\u001b[K-resolvconf.service                   disabled enabled\r\n\u001b[01;31m\u001b[Kpostfix\u001b[m\u001b[K.service                              enabled  enabled\r\n\u001b[01;31m\u001b[Kpostfix\u001b[m\u001b[K@.service                             disabled enabled\r\n"]
