[56.116018, "i", "echo '--- postfix integration ---'; cat /usr/lib/python3/dist-packages/mailman/config/postfix.cfg; echo '--- cli ---'; /usr/bin/mailman create --help 2>&1 | head -80; echo '--- services ---'; systemctl is-active postfix mailman3 || true; echo '--- aliases/maps ---'; find /var/lib/mailman3 /var/lib/mailman -maxdepth 3 -type f 2>/dev/null | grep -E 'postfix|aliases|config' | head -80"]
[56.117152, "o", "echo '--- postfix integration ---'; cat /usr/lib/python3/dist-packages/mailman/config/postfix.cfg; echo '--- cli ---'; /usr/bin/mailman create --help 2>&1 | head -80; echo '--- services ---'; systemctl is-active postfix mailman3 || true; echo '--- aliases/maps ---'; find /var/lib/mailman3 /var/lib/mailman -maxdepth 3 -type f 2>/dev/null | grep -E 'postfix|aliases|config' | head -80"]
[65.112698, "i", "grep -nE '^(var_dir|data_dir|spool_dir|configuration|incoming|lmtp)' /etc/mailman3/mailman.cfg /usr/lib/python3/dist-packages/mailman/config/postfix.cfg 2>/dev/null; echo '---'; /usr/bin/mailman create --help 2>&1 | sed -n '1,100p'; echo '---'; systemctl is-active postfix mailman3 || true\n"]
[65.115423, "o", "grep -nE '^(var_dir|data_dir|spool_dir|configuration|incoming|lmtp)' /etc/mailman3/mailman.cfg /usr/lib/python3/dist-packages/mailman/config/postfix.cfg 2>/dev/null; echo '---'; /usr/bin/mailman create --help 2>&1 | sed -n '1,100p'; echo '---'; systemctl is-active postfix mailman3 || true\r\n"]
[65.115781, "o", "\u001b[?2004l\r"]
[65.116951, "o", "--- postfix integration ---\r\n"]
[65.140718, "o", "[postfix]\r\n# Additional configuration variables for the postfix MTA.\r\n\r\n# This variable describe the program to use for regenerating the transport map\r\n# db file, from the associated plain text files.  The file being updated will\r\n# be appended to this string (with a separating space), so it must be\r\n# appropriate for os.system().\r\npostmap_command: /usr/sbin/postmap\r\n\r\n# This variable describes the type of transport maps that will be generated by\r\n# mailman to be used with postfix for LMTP transport. By default, it is set to\r\n# hash, but mailman also supports `regex` tables.\r\ntransport_file_type: hash\r\n"]
[65.142739, "o", "--- cli ---\r\n"]
[66.125644, "i", "postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu' -e 'mailbox_command =' -e 'mailbox_transport = local:' -e 'home_mailbox =' ; grep -q '^transport_maps' /etc/postfix/main.cf && postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp' || echo 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp' >> /etc/postfix/main.cf; grep -q '^virtual_alias_maps' /etc/postfix/main.cf && postconf -e 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman' || echo 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman' >> /etc/postfix/main.cf; postfix check\n"]
[66.126173, "o", "postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu' -e 'mailbox_command =' -e 'mailbox_transport = local:' -e 'home_mailbox =' ; grep -q '^transport_maps' /etc/postfix/main.cf && postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp' || echo 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp' >> /etc/postfix/main.cf; grep -q '^virtual_alias_maps' /etc/postfix/main.cf && postconf -e 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman' || echo 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman' >> /etc/postfix/main.cf; postfix check\r\n"]
