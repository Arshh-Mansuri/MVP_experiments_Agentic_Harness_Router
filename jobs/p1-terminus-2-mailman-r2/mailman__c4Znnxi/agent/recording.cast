[76.819223, "o", "Usage: mailman create [OPTIONS] LISTNAME\r\n\r\n  Create a mailing list.\r\n\r\n  The 'fully qualified list name', i.e. the posting address of the mailing\r\n  list is required.  It must be a valid email address and the domain must be\r\n  registered with Mailman.  List names are forced to lower case.\r\n\r\nOptions:\r\n  --language CODE                 Set the list's preferred language to CODE,\r\n                                  which must be a registered two letter\r\n                                  language code.\r\n  -o, --owner OWNER               Specify a list owner email address.  If the\r\n                                  address is not currently registered with\r\n                                  Mailman, the address is registered and\r\n                                  linked to a user. Mailman will send a\r\n                                  confirmation message to the address, but it\r\n                                  will also send a list creation notice to the\r\n                                  address.  More than one owner can be\r\n                                  specified.\r\n  -n, --notify / -no-notify, -N   Notify the list owner by email that their\r\n                                  mailing list has been created.\r\n  -q, --quiet                     Print less output.\r\n  -d, --domain / -D, --no-domain  Register the mailing list's domain if not\r\n                                  yet registered.  This is the default\r\n                                  behavior, but these options are provided for\r\n                                  backward compatibility.  With -D do not\r\n                                  register the mailing list's domain.\r\n  -h, --help                      Show this message and exit.\r\n"]
[76.92641, "i", "postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'; postconf -e 'mailbox_command ='; postconf -e 'mailbox_transport = local:'; postconf -e 'home_mailbox ='; postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'; postconf -e 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman'; postconf -n\n"]
[76.926965, "o", "postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'; postconf -e 'mailbox_command ='; postconf -e 'mailbox_transport = local:'; postconf -e 'home_mailbox ='; postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'; postconf -e 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman'; postconf -n\r\n"]
[77.036516, "o", "---\r\n"]
[78.123126, "o", "Usage: mailman aliases [OPTIONS]\r\n\r\n  Regenerate the aliases appropriate for your MTA.\r\n\r\nOptions:\r\n"]
[78.123723, "o", "  -d, --directory DIRECTORY  An alternative directory to output the various\r\n                             MTA files to.\r\n  -h, --help                 Show this message and exit.\r\n"]
[78.358702, "o", "---\r\n"]
[78.396917, "o", "\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kvar_dir\u001b[m\u001b[K: /var/lib/mailman3\r\n"]
[78.39715, "o", "\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kqueue_dir\u001b[m\u001b[K: $var_dir/queue\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kbin_dir\u001b[m\u001b[K: /usr/lib/mailman3/bin\r\n"]
[78.397343, "o", "\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Klog_dir\u001b[m\u001b[K: /var/log/mailman3\r\n"]
[78.397453, "o", "\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdata_dir\u001b[m\u001b[K: $var_dir/data\r\n\u001b[32m\u001b[K244\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kincoming\u001b[m\u001b[K: mailman.mta.postfix.LMTP\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Klmtp\u001b[m\u001b[K_host: 127.0.0.1\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Klmtp\u001b[m\u001b[K_port: 8024\r\n"]
[78.397613, "o", "\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kconfiguration\u001b[m\u001b[K: python:mailman.config.postfix\r\n"]
[78.399112, "o", "---\r\n"]
[78.44139, "o", "\u001b[?2004hroot@3e8db1d31fb1:/app# "]
[78.441931, "o", "postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'; postconf -e 'mailbox_command ='; postconf -e 'mailbox_transport = local:'; postconf -e 'home_mailbox ='; postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'; postconf -e 'virtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman'; postconf -n\r\n\u001b[?2004l\r"]
[80.52241, "o", "alias_database = hash:/etc/aliases\r\nalias_maps = hash:/etc/aliases\r\nappend_dot_mydomain = no\r\nbiff = no\r\ncompatibility_level = 3.6\r\nhome_mailbox =\r\ninet_interfaces = all\r\ninet_protocols = all\r\nmailbox_command =\r\nmailbox_size_limit = 0\r\nmailbox_transport = local:\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu\r\nmyhostname = localhost.local\r\nmynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128\r\nreadme_directory = no\r\nrecipient_delimiter = +\r\nrelayhost =\r\nsmtp_tls_CApath = /etc/ssl/certs\r\nsmtp_tls_security_level = may\r\nsmtp_tls_session_cache_database = btree:${data_directory}/smtp_scache\r\nsmtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)\r\nsmtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\r\nsmtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem\r\nsmtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key\r\nsmtpd_tls_security_level = may\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\nvirtual_alias_maps = hash:/var/lib/mailman3/data/virtual-mailman\r\n"]
[80.526509, "o", "\u001b[?2004hroot@3e8db1d31fb1:/app# "]
[87.289389, "i", "python3 - <<'PY'\np='/etc/postfix/main.cf'\ns=open(p).read()\nvals={\n'mydestination':'$myhostname, localhost, localhost.localdomain, local.edu',\n'mailbox_command':'',\n'mailbox_transport':'local:',\n'transport_maps':'hash:/var/lib/mailman3/data/postfix_lmtp',\n'virtual_alias_maps':'hash:/var/lib/mailman3/data/virtual-mailman'\n}\nlines=s.splitlines()\nseen=set(); out=[]\nfor line in lines:\n    key=line.split('=',1)[0].strip() if '=' in line and not line.lstrip().startswith('#') else ''\n    if key in vals:\n        out.append(key+' = '+vals[key]); seen.add(key)\n    else: out.append(line)\nfor k,v in vals.items():\n    if k not in seen: out.append(k+' = '+v)\nopen(p,'w').write('\\n'.join(out)+'\\n')\nPY\npostfix check || true\ngrep -E '^(mydestination|mailbox_command|mailbox_transport|transport_maps|virtual_alias_maps)' /etc/postfix/main.cf\n"]
[87.292199, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[87.292649, "o", "\u001b[?2004h> "]
[87.292761, "o", "p='/etc/postfix/main.cf'\r\n\u001b[?2004l\r"]
[87.293414, "o", "\u001b[?2004h> "]
[87.294429, "o", "s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> vals={\r\n\u001b[?2004l\r\u001b[?2004h> 'mydestination':'$myhostname, localhost, localhost.localdomain, local.edu',\r\n\u001b[?2004l\r\u001b[?2004h> 'mailbox_command':'',\r\n\u001b[?2004l\r\u001b[?2004h> 'mailbox_transport':'local:',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.294843, "o", "'transport_maps':'hash:/var/lib/mailman3/data/postfix_lmtp',\r\n\u001b[?2004l\r\u001b[?2004h> 'virtual_alias_maps':'hash:/var/lib/mailman3/data/virtual-mailman'\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> lines=s.splitlines()\r\n\u001b[?2004l\r"]
[87.295369, "o", "\u001b[?2004h> seen=set(); out=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>     key=line.split('=',1)[0].strip() if '=' in line and not line.lstrip().startswith('#') else ''\r\n\u001b[?2004l\r\u001b[?2004h>     if key in vals:\r\n\u001b[?2004l\r\u001b[?2004h>         out.append(key+' = '+vals[key]); seen.add(key)\r\n\u001b[?2004l\r"]
[87.29569, "o", "\u001b[?2004h>     else: out.append(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.295866, "o", "for k,v in vals.items():\r\n\u001b[?2004l\r\u001b[?2004h>     if k not in seen: out.append(k+' = '+v)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write('\\n'.join(out)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.295921, "o", "> PY\r\n\u001b[?2004l\r"]
[87.454724, "o", "\u001b[?2004hroot@3e8db1d31fb1:/app# postfix check || true\r\n\u001b[?2004l\r"]
