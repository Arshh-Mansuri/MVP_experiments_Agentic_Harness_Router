[31.822478, "o", "            hidden = llama.norm(hidden)\r\n\u001b[?2004l\r\u001b[?2004h>             logits = model.lm_head(hidden)\r\n\u001b[?2004l\r\u001b[?2004h>             target = targets[mb].to(device=device, dtype=torch.long)\r\n\u001b[?2004l\r\u001b[?2004h>             loss = F.cross_entropy(\r\n\u001b[?2004l\r\u001b[?2004h>                 logits.float().reshape(-1, logits.shape[-1]), target.reshape(-1), reduction=\"mean\"\r\n\u001b[?2004l\r\u001b[?2004h>             ) / n_micro\r\n\u001b[?2004l\r\u001b[?2004h>             losses.append(loss)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             boundary_outputs.append(hidden)\r\n\u001b[?2004l\r\u001b[?2004h>             _send(hidden.detach().to(device=device, dtype=dtype), rank + 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # ---------------------------- all backward -----------------------------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.822946, "o", "    # Reverse microbatch order is the standard AFAB reverse drain and avoids\r\n\u001b[?2004l\r\u001b[?2004h>     # requiring any additional activation recomputation.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.823077, "o", "    for mb in range(n_micro - 1, -1, -1):\r\n\u001b[?2004l\r"]
[31.823262, "o", "\u001b[?2004h>         if is_last:\r\n\u001b[?2004l\r"]
[31.823425, "o", "\u001b[?2004h>             losses[mb].backward()\r\n\u001b[?2004l\r\u001b[?2004h>             if world_size > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.82349, "o", "                # The input to the last stage is the received leaf.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.823661, "o", "                grad = received_inputs[mb].grad\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.82371, "o", "> "]
[31.823821, "o", "                _send(grad.detach().to(device=device, dtype=dtype), rank - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.823956, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824008, "o", "            grad_shape = boundary_outputs[mb].shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824155, "o", "            grad = _recv_like(grad_shape, device, dtype, rank + 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824264, "o", "            boundary_outputs[mb].backward(grad)\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.824316, "o", "> "]
[31.824455, "o", "            if not is_first:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824642, "o", "                input_grad = received_inputs[mb].grad\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824699, "o", "                _send(input_grad.detach().to(device=device, dtype=dtype), rank - 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824799, "o", "    if is_last:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824906, "o", "        return torch.stack(losses).sum().detach()\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.824962, "o", "PY\r\n\u001b[?2004l\r"]
