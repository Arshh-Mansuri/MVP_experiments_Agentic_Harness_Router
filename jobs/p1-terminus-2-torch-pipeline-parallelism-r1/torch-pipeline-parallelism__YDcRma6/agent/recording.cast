[31.780532, "i", "cat > /app/pipeline_parallel.py <<'PY'\n\"\"\"AFAB pipeline-parallel training helper for Hugging Face LLaMA models.\"\"\"\n\nimport inspect\nfrom typing import List\n\nimport torch\nimport torch.distributed as dist\nimport torch.nn.functional as F\n\n\ndef _layer_forward(layer, hidden, position_ids):\n    \"\"\"Call a LlamaDecoderLayer across several transformers API versions.\"\"\"\n    try:\n        params = inspect.signature(layer.forward).parameters\n    except (TypeError, ValueError):\n        params = {}\n\n    kwargs = {}\n    if \"attention_mask\" in params:\n        kwargs[\"attention_mask\"] = None\n    if \"position_ids\" in params:\n        kwargs[\"position_ids\"] = position_ids\n    if \"past_key_value\" in params:\n        kwargs[\"past_key_value\"] = None\n    if \"past_key_values\" in params:\n        kwargs[\"past_key_values\"] = None\n    if \"use_cache\" in params:\n        kwargs[\"use_cache\"] = False\n    if \"cache_position\" in params:\n        kwargs[\"cache_position\"] = position_ids\n\n    # Newer transformers versions may expect precomputed rotary embeddings.\n    if \"position_embeddings\" in params:\n        rotary = getattr(layer, \"rotary_emb\", None)\n        if rotary is None:\n            rotary = getattr(getattr(layer, \"self_attn\", None), \"rotary_emb\", None)\n        if rotary is not None:\n            try:\n                kwargs[\"position_embeddings\"] = rotary(hidden, position_ids)\n            except TypeError:\n                kwargs[\"position_embeddings\"] = rotary(hidden, position_ids, None)\n\n    out = layer(hidden, **kwargs)\n    return out[0] if isinstance(out, (tuple, list)) else out\n\n\ndef _balanced_range(num_layers, rank, world_size):\n    \"\"\"Return a contiguous, approximately equal layer interval for rank.\"\"\"\n    start = (num_layers * rank) // world_size\n    end = (num_layers * (rank + 1)) // world_size\n    return start, end\n\n\ndef _send(tensor, peer):\n    dist.send(tensor=tensor.contiguous(), dst=peer)\n\n\ndef _recv_like(shape, device, dtype, peer):\n    result = torch.empty(shape, device=device, dtype=dtype)\n    dist.recv(tensor=result, src=peer)\n    return result\n\n\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    \"\"\"Run one all-forward/all-backward pipeline training step.\n\n    ``inputs`` and ``targets`` are lists of microbatches.  The function\n    performs the forward pass for every microbatch before beginning any\n    backward pass.  Gradients are accumulated in the model parameters in the\n    usual PyTorch manner; the resulting loss is returned on the last rank and\n    ``None`` is returned on other ranks.\n    \"\"\"\n    rank = dist.get_rank() if dist.is_available() and dist.is_initialized() else 0\n    world_size = dist.get_world_size() if dist.is_available() and dist.is_initialized() else 1\n    if len(inputs) != len(targets):\n        raise ValueError(\"inputs and targets must contain the same number of microbatches\")\n    if not inputs:\n        raise ValueError(\"at least one microbatch is required\")\n\n    llama = model.model\n    layers = llama.layers\n    num_layers = len(layers)\n    first, last = _balanced_range(num_layers, rank, world_size)\n    is_first = rank == 0\n    is_last = rank == world_size - 1\n    n_micro = len(inputs)\n\n    # Keep position IDs consistent with the normal LlamaModel forward.\n    def make_position_ids(x):\n        return torch.arange(x.shape[1], device=device, dtype=torch.long).unsqueeze(0).expand(x.shape[0], -1)\n\n    # A boundary tensor is deliberately detached before communication.  The\n    # receiving side makes it a leaf, and the sender later backpropagates from\n    # the gradient sent back across that boundary.\n    boundary_outputs = []\n    received_inputs = []\n    losses = []\n\n    # ----------------------------- all forward -----------------------------\n    for mb in range(n_micro):\n        x = inputs[mb].to(device=device, dtype=torch.long)\n        position_ids = make_position_ids(x)\n\n        if is_first:\n            hidden = llama.embed_tokens(x).to(device=device, dtype=dtype)\n        else:\n            hidden_size = getattr(getattr(model, \"config\", None), \"hidden_size\", None)\n            if hidden_size is Non"]
[31.782721, "i", "e:\n                hidden_size = llama.embed_tokens.weight.shape[-1]\n            hidden = _recv_like((x.shape[0], x.shape[1], hidden_size), device, dtype, rank - 1)\n            hidden.requires_grad_(True)\n            received_inputs.append(hidden)\n\n        for layer_idx in range(first, last):\n            hidden = _layer_forward(layers[layer_idx], hidden, position_ids)\n            if hidden.dtype != dtype:\n                hidden = hidden.to(dtype=dtype)\n\n        if is_last:\n            hidden = llama.norm(hidden)\n            logits = model.lm_head(hidden)\n            target = targets[mb].to(device=device, dtype=torch.long)\n            loss = F.cross_entropy(\n                logits.float().reshape(-1, logits.shape[-1]), target.reshape(-1), reduction=\"mean\"\n            ) / n_micro\n            losses.append(loss)\n        else:\n            boundary_outputs.append(hidden)\n            _send(hidden.detach().to(device=device, dtype=dtype), rank + 1)\n\n    # ---------------------------- all backward -----------------------------\n    # Reverse microbatch order is the standard AFAB reverse drain and avoids\n    # requiring any additional activation recomputation.\n    for mb in range(n_micro - 1, -1, -1):\n        if is_last:\n            losses[mb].backward()\n            if world_size > 1:\n                # The input to the last stage is the received leaf.\n                grad = received_inputs[mb].grad\n                _send(grad.detach().to(device=device, dtype=dtype), rank - 1)\n        else:\n            grad_shape = boundary_outputs[mb].shape\n            grad = _recv_like(grad_shape, device, dtype, rank + 1)\n            boundary_outputs[mb].backward(grad)\n            if not is_first:\n                input_grad = received_inputs[mb].grad\n                _send(input_grad.detach().to(device=device, dtype=dtype), rank - 1)\n\n    if is_last:\n        return torch.stack(losses).sum().detach()\n    return None\nPY\npython3 -m py_compile /app/pipeline_parallel.py\nls -l /app/pipeline_parallel.py\n"]
