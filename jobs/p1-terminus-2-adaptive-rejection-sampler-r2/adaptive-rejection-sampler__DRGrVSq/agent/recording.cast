[68.60226, "o", "<- c(lo, (lo + hi) / 2, hi)\r\n  h <- .ars_eval_log_density(density_function, x)\r\n  if (any(diff(h) == 0)) warning(\"flat portions detected; continuing with ARS\")\r\n  out <- numeric(n); accepted <- 0L; attempts <- 0L\r\n  while (accepted < n) {\r\n    if (attempts > max(10000L, 1000L * n)) stop(\"ARS acceptance is too low; check density and domain\")\r\n    hull <- .ars_hull(x, h)\r\n    q <- .ars_propose(hull); y <- q$x\r\n    hy <- .ars_eval_log_density(density_function, y)[1L]\r\n    upper <- hull$slope[q$i] * y + hull$intercept[q$i]\r\n    if (hy > upper + 1e-7) stop(\"non-log-concave density detected during sampling\")\r\n    attempts <- attempts + 1L\r\n    if (log(runif(1L)) <= hy - upper) {\r\n      accepted <- accepted + 1L; out[accepted] <- y\r\n      if (all(abs(x - y) > 1e-10)) {\r\n        k <- order(c(x, y)); xx <- c(x, y); hh <- c(h, hy)\r\n        x <- xx[k]; h <- hh[k]\r\n      }\r\n    } else if (all(abs(x - y) > 1e-10)) {\r\n      k <- order(c(x, y)); xx <- c(x, y); hh <- c(h, hy)\r\n      x <- xx[k]; h <- hh[k]\r\n    }\r\n  }\r\n  out\r"]
[68.602514, "o", "\n}\r\n\r\n.print_test <- function(name, ok, values = numeric(0L), target = NA_real_) {\r\n  if (length(values)) {\r\n    cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f\", name, if (ok) \"PASS\" else \"FAIL\",\r\n                mean(values), sd(values)))\r\n    if (is.finite(target)) cat(sprintf(\", target=%.4f\", target))\r\n    cat(\")\\n\")\r\n  } else cat(sprintf(\"%s: %s\\n\", name, if (ok) \"PASS\" else \"FAIL\"))\r\n  invisible(ok)\r\n}\r\n\r\n# Formal stochastic tests against known moments and input/error behavior.\r\ntest <- function() {\r\n  set.seed(2024)\r\n  normal <- ars(function(x) dnorm(x), c(-8, 8), 3000)\r\n  exponential <- ars(function(x) dexp(x), c(0, 25), 3000)\r\n  ok1 <- abs(mean(normal)) < 0.10 && abs(sd(normal) - 1) < 0.10\r\n  ok2 <- abs(mean(exponential) - 1) < 0.08 && abs(sd(exponential) - 1) < 0.08\r\n  bad <- tryCatch({ ars(function(x) 1 + 0.8 * sin(x), c(0, 2*pi), 10); FALSE }, error = function(e) TRUE)\r\n  invalid <- tryCatch({ ars(function(x) dnorm(x), c(1, 0), 2); FALSE }, error = function(e) TRUE)\r\n  .print_test(\"NORMAL_MOMENTS\", ok1, normal, 0)\r\n  .print_test(\"EXPONENTIAL_MOMENTS\", ok2, exponential, 1)\r\n  .print_test(\"NON_LOG_CONCAVE_REJECTION\", bad)\r\n  .print_test(\"INVALID_DOMAIN_REJECTION\", invalid)\r\n  write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\r\n  all_ok <- ok1 && ok2 && b"]
[68.602564, "o", "ad && invalid\r\n  cat(sprintf(\"ALL_TESTS: %s\\n\", if (all_ok) \"PASS\" else \"FAIL\"))\r\n  invisible(all_ok)\r\n}\r\nEOF\r\nRscript -e 'source(\"/app/ars.R\"); test()'\r\nls -l /app/ars.R /app/normal_samples.txt\r\nprintf '\\n-- status --\\n'; command -v R || true; test -f /app/ars.R && wc -l /app/ars.R || true; tail -n 5 /app/ars.R 2>/dev/null || true\r\n"]
