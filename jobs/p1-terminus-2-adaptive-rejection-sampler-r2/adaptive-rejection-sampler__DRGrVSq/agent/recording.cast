[313.614286, "i", "python3 - <<'PY'\np='/app/ars.R'\ns=open(p).read()\n# Replace slope helper with a numerically stable, concavity-compatible estimate.\na=s.index('.ars_slopes <- function'); b=s.index('\\n.ars_hull <- function',a)\nslopes=r'''.ars_slopes <- function(x, h) {\n  n <- length(x)\n  sec <- diff(h) / diff(x)\n  if (n == 2L) return(c(sec[1L], sec[1L]))\n  # Endpoint one-sided extrapolation and weighted interior secants.\n  dx <- diff(x)\n  left <- sec[1L] + (sec[1L] - sec[2L]) * dx[1L] / dx[2L]\n  right <- sec[n - 1L] + (sec[n - 1L] - sec[n - 2L]) * dx[n - 1L] / dx[n - 2L]\n  mid <- (sec[-length(sec)] * dx[-length(dx)] + sec[-1L] * dx[-1L]) /\n         (dx[-length(dx)] + dx[-1L])\n  # A concave log density has non-increasing derivative estimates.\n  -cummax(-c(left, mid, right))\n}\n'''\ns=s[:a]+slopes+s[b:]\n# Replace hull through before mass function.\na=s.index('.ars_hull <- function'); b=s.index('\\n.ars_mass <- function',a)\nhull=r'''.ars_hull <- function(x, h) {\n  slope <- .ars_slopes(x, h)\n  k <- length(x)\n  boundary <- c(x[1L], numeric(k - 1L), x[k])\n  for (i in seq_len(k - 1L)) {\n    den <- slope[i + 1L] - slope[i]\n    if (abs(den) < 1e-12) boundary[i + 1L] <- (x[i] + x[i + 1L]) / 2\n    else boundary[i + 1L] <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] -\n                               h[i] + slope[i] * x[i]) / den\n  }\n  boundary <- pmax(x[1L], pmin(x[k], boundary))\n  boundary <- cummax(boundary)\n  boundary[1L] <- x[1L]; boundary[k + 1L] <- x[k]\n  list(x=x, h=h, slope=slope, intercept=h-slope*x, z=boundary)\n}\n'''\ns=s[:a]+hull+s[b:]\n# Replace masses with consistent k-1 intervals and zero handling.\na=s.index('.ars_hull_masses <- function'); b=s.index('\\n.ars_propose <- function',a)\nmass=r'''.ars_hull_masses <- function(hull) {\n  k <- length(hull$x) - 1L\n  mass <- vapply(seq_len(k), function(i) {\n    if (hull$z[i+1L] <= hull$z[i]) return(0)\n    .ars_mass(hull$z[i], hull$z[i+1L], hull$slope[i], hull$intercept[i])\n  }, numeric(1L))\n  mass[!is.finite(mass) | mass < 0] <- 0\n  if (!any(mass > 0)) stop(\"could not construct a finite ARS envelope\")\n  mass\n}\n'''\ns=s[:a]+mass+s[b:]\nopen(p,'w').write(s)\nPY\nRscript -e 'source(\"/app/ars.R\"); test()'\n"]
[313.618438, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/ars.R'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> # Replace slope helper with a numerically stable, concavity-compatible estimate.\r\n\u001b[?2004l\r\u001b[?2004h> a=s.index('.ars_slopes <- function'); b=s.index('\\n.ars_hull <- function',a)\r\n\u001b[?2004l\r\u001b[?2004h> slopes=r'''.ars_slopes <- function(x, h) {\r\n\u001b[?2004l\r\u001b[?2004h>   n <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h>   sec <- diff(h) / diff(x)\r\n\u001b[?2004l\r\u001b[?2004h>   if (n == 2L) return(c(sec[1L], sec[1L]))\r\n\u001b[?2004l\r\u001b[?2004h>   # Endpoint one-sided extrapolation and weighted interior secants.\r\n\u001b[?2004l\r\u001b[?2004h>   dx <- diff(x)\r\n\u001b[?2004l\r\u001b[?2004h>   left <- sec[1L] + (sec[1L] - sec[2L]) * dx[1L] / dx[2L]\r\n\u001b[?2004l\r\u001b[?2004h>   right <- sec[n - 1L] + (sec[n - 1L] - sec[n - 2L]) * dx[n - 1L] / dx[n - 2L]\r\n\u001b[?2004l\r\u001b[?2004h>   mid <- (sec[-length(sec)] * dx[-length(dx)] + sec[-1L] * dx[-1L]) /\r\n\u001b[?2004l\r\u001b[?2004h>          (dx[-length(dx)] + dx[-1L])\r\n\u001b[?2004l\r\u001b[?2004h>   # A concave log density has non-increasing derivative estimates.\r\n\u001b[?2004l\r\u001b[?2004h>   -cummax(-c(left, mid, right))\r\n\u001b[?2004l\r"]
[313.618967, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+slopes+s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
