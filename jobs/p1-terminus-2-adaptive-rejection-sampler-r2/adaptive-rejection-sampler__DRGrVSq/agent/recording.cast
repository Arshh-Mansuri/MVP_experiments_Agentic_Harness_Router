[200.301636, "i", "cat > /app/ars.R <<'EOF'\n# Adaptive rejection sampler based on Gilks, Wild (1992).\n# The target may be unnormalised, but must be positive and log-concave.\n\n.ars_validate <- function(density_function, domain, n) {\n  if (!is.function(density_function)) stop(\"density_function must be a function\")\n  if (!is.numeric(domain) || length(domain) != 2L || any(!is.finite(domain)) || domain[1] >= domain[2])\n    stop(\"domain must be finite c(lower, upper), with lower < upper\")\n  if (!is.numeric(n) || length(n) != 1L || !is.finite(n) || n < 0 || n != floor(n))\n    stop(\"n must be one non-negative integer\")\n  invisible(TRUE)\n}\n\n.ars_log_density <- function(f, x) {\n  y <- tryCatch(f(x), error = function(e) stop(\"density_function error: \", e$message))\n  if (length(y) == 1L && length(x) > 1L) y <- rep(y, length(x))\n  if (length(y) != length(x)) stop(\"density_function must be vectorized\")\n  if (any(!is.finite(y)) || any(y <= 0))\n    stop(\"density_function must return finite positive values on the domain\")\n  log(y)\n}\n\n.ars_check_concavity <- function(f, domain, grid_n = 201L, tol = 1e-7) {\n  x <- seq(domain[1], domain[2], length.out = grid_n)\n  h <- .ars_log_density(f, x)\n  # For equally spaced points, concavity means every second difference <= 0.\n  d2 <- h[-c(1, 2)] - 2 * h[-c(1, length(h))] + h[-c(length(h)-1, length(h))]\n  scale <- 1 + abs(h[-c(1, 2)]) + 2 * abs(h[-c(1, length(h))]) + abs(h[-c(length(h)-1, length(h))])\n  if (any(d2 > tol * scale)) stop(\"density appears non-log-concave on the supplied domain\")\n  invisible(TRUE)\n}\n\n.ars_slopes <- function(x, h) {\n  sec <- diff(h) / diff(x)\n  if (length(sec) == 1L) return(rep(sec, 2L))\n  # Interior derivative estimates are weighted averages of adjacent secants.\n  interior <- (sec[-length(sec)] * diff(x)[-length(sec)] +\n               sec[-1L] * diff(x)[-1L]) /\n              (diff(x)[-length(sec)] + diff(x)[-1L])\n  c(sec[1L], interior, sec[length(sec)])\n}\n\n.ars_hull <- function(x, h) {\n  slope <- .ars_slopes(x, h)\n  k <- length(x)\n  z <- numeric(k + 1L)\n  z[1L] <- x[1L]; z[k + 1L] <- x[k]\n  for (i in seq_len(k - 1L)) {\n    den <- slope[i + 1L] - slope[i]\n    if (abs(den) < 1e-12) val <- (x[i] + x[i + 1L]) / 2\n    else val <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] - h[i] + slope[i] * x[i]) / den\n    z[i + 1L] <- max(x[i], min(x[i + 1L], val))\n  }\n  intercept <- h - slope * x\n  list(x = x, h = h, slope = slope, intercept = intercept, z = z)\n}\n\n.ars_mass <- function(a, b, m, c) {\n  mid <- (a + b) / 2\n  if (abs(m) < 1e-10) return(exp(m * mid + c) * (b - a))\n  # midpoint form is substantially more stable than exp(c)*(exp(mb)-exp(ma)).\n  exp(m * mid + c) * (2 * sinh(m * (b - a) / 2) / m)\n}\n\n.ars_hull_masses <- function(hull) {\n  k <- length(hull$x)\n  mass <- vapply(seq_len(k), function(i)\n    .ars_mass(hull$z[i], hull$z[i + 1L], hull$slope[i], hull$intercept[i]), numeric(1))\n  if (any(!is.finite(mass)) || any(mass <= 0)) stop(\"could not construct a finite ARS envelope\")\n  mass\n}\n\n.ars_propose <- function(hull, mass) {\n  i <- sample.int(length(mass), 1L, prob = mass / sum(mass))\n  a <- hull$z[i]; b <- hull$z[i + 1L]; m <- hull$slope[i]\n  if (abs(m) < 1e-10) y <- a + runif(1L) * (b - a)\n  else y <- a + log1p(runif(1L) * expm1(m * (b - a))) / m\n  list(y = min(max(y, a), b), i = i)\n}\n\n.ars_insert <- function(x, h, y, hy) {\n  if (any(abs(x - y) < 1e-12)) return(list(x = x, h = h))\n  o <- order(c(x, y))\n  xx <- c(x, y); hh <- c(h, hy)\n  list(x = xx[o], h = hh[o])\n}\n\nars <- function(density_function, domain, n = sample_count) {\n  .ars_validate(density_function, domain, n)\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0L))\n  .ars_check_concavity(density_function, domain)\n  lo <- domain[1L]; hi <- domain[2L]\n  x <- c(lo, (lo + hi) / 2, hi)\n  h <- .ars_log_density(density_function, x)\n  ans <- numeric(n); got <- 0L; attempts <- 0L\n  while (got < n) {\n    attempts <- attempts + 1L\n    if (attempts > max(10000L, 2000L * n)) stop(\"ARS acceptance rate is too low\")\n    hull <- .ars_hull(x, h)\n    mass <- .ars_hull_masses(hull)\n    prop <- .ars_propose(hull, mass)\n    y <- prop$y\n    hy <- .ars_log_density("]
[200.302974, "i", "density_function, y)\n    upper <- hull$slope[prop$i] * y + hull$intercept[prop$i]\n    # This is an online safety check for non-log-concavity.\n    if (hy > upper + 1e-6) stop(\"non-log-concave density detected during sampling\")\n    # Rejection from the tangent envelope; adding every proposal adapts the hull.\n    accept <- log(runif(1L)) <= hy - upper\n    if (accept) {\n      got <- got + 1L\n      ans[got] <- y\n    }\n    ins <- .ars_insert(x, h, y, hy)\n    x <- ins$x; h <- ins$h\n  }\n  ans\n}\n\n.ars_report <- function(name, ok, z, target = NA_real_) {\n  if (length(z)) {\n    extra <- if (is.finite(target)) sprintf(\", target=%.4f\", target) else \"\"\n    cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f%s)\\n\", name,\n                if (ok) \"PASS\" else \"FAIL\", mean(z), sd(z), extra))\n  } else cat(sprintf(\"%s: %s\\n\", name, if (ok) \"PASS\" else \"FAIL\"))\n  invisible(ok)\n}\n\ntest <- function() {\n  set.seed(202503)\n  normal <- ars(function(x) dnorm(x), c(-8, 8), n = 3000)\n  exponential <- ars(function(x) dexp(x), c(0, 25), n = 3000)\n  normal_ok <- abs(mean(normal)) < .10 && abs(sd(normal) - 1) < .10\n  exponential_ok <- abs(mean(exponential) - 1) < .08 && abs(sd(exponential) - 1) < .08\n  nonconcave_ok <- tryCatch({ ars(function(x) 1 + .8 * sin(x), c(0, 2*pi), 10); FALSE }, error = function(e) TRUE)\n  invalid_ok <- tryCatch({ ars(dnorm, c(2, 1), 2); FALSE }, error = function(e) TRUE)\n  .ars_report(\"NORMAL_MOMENTS\", normal_ok, normal, 0)\n  .ars_report(\"EXPONENTIAL_MOMENTS\", exponential_ok, exponential, 1)\n  .ars_report(\"NON_LOG_CONCAVE_REJECTION\", nonconcave_ok, numeric(0))\n  .ars_report(\"INVALID_DOMAIN_REJECTION\", invalid_ok, numeric(0))\n  write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\n  all_ok <- normal_ok && exponential_ok && nonconcave_ok && invalid_ok\n  cat(sprintf(\"ALL_TESTS: %s\\n\", if (all_ok) \"PASS\" else \"FAIL\"))\n  invisible(all_ok)\n}\nEOF\nRscript -e 'source(\"/app/ars.R\"); test()'\n"]
[200.304292, "o", "cat > /app/ars.R <<'EOF'\r\n\u001b[?2004l\r"]
[200.305011, "o", "\u001b[?2004h> # Adaptive rejection sampler based on Gilks, Wild (1992).\r\n\u001b[?2004l\r"]
[200.305684, "o", "\u001b[?2004h> # The target may be unnormalised, but must be positive and log-concave.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_validate <- function(density_function, domain, n) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.305761, "o", "  if (!is.function(density_function)) stop(\"density_function must be a function\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.306314, "o", "  if (!is.numeric(domain) || length(domain) != 2L || any(!is.finite(domain)) || domain[1] >= domain[2])\r\n\u001b[?2004l\rgot + 1L\r\n      an\u001b[?2004h> "]
[200.306588, "o", "    stop(\"domain must be finite c(lower, upper), with lower < upper\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.306721, "o", "  if (!is.numeric(n) || length(n) != 1L || !is.finite(n) || n < 0 || n != floor(n))\r\n\u001b[?2004l\r {\r\n  \u001b[?2004h"]
[200.306829, "o", "> "]
[200.307265, "o", "    stop(\"n must be one non-negative integer\")\r\n\u001b[?2004l\r\u001b[?2004h>   invisible(TRUE)\r\n\u001b[?2004l\rget)) sprintf(\", t"]
[200.308094, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\rar\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_log_density <- function(f, x) {\r\n\u001b[?2004l\r\u001b[?2004h>   y <- tryCatch(f(x), error = function(e) stop(\"density_function error: \", e$message))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.30838, "o", "  if (length(y) == 1L && length(x) > 1L) y <- rep(y, length(x))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.308811, "o", "  if (length(y) != length(x)) stop(\"density_function must be vectorized\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.308898, "o", "  if (any(!is.finite(y)) || any(y <= 0))\r\n\u001b[?2004l\r"]
[200.309238, "o", "\u001b[?2004h>     stop(\"density_function must return finite positive values on the domain\")\r\n\u001b[?2004l\r\u001b[?2004h>   log(y)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r, 25), n = "]
[200.310043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_check_concavity <- function(f, domain, grid_n = 201L, tol = 1e-7) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.327441, "o", "> "]
[200.327541, "o", "  x <- seq(domain[1], domain[2], length.out = grid_n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.327983, "o", "  h <- .ars_log_density(f, x)\r\n\u001b[?2004l\r\u001b[?2004h>   # For equally spaced points, concavity means every second difference <= 0.\r\n\u001b[?2004l\r\u001b[?2004h>   d2 <- h[-c(1, 2)] - 2 * h[-c(1, length(h))] + h[-c(length(h)-1, length(h))]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.328241, "o", "  scale <- 1 + abs(h[-c(1, 2)]) + 2 * abs(h[-c(1, length(h))]) + abs(h[-c(length(h)-1, length(h))])\r\n\u001b[?2004l\r"]
[200.328402, "o", "\u001b[?2004h> "]
[200.328659, "o", "  if (any(d2 > tol * scale)) stop(\"density appears non-log-concave on the supplied domain\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.32887, "o", "> "]
[200.329004, "o", "  invisible(TRUE)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[200.329252, "o", "\u001b[?2004h> .ars_slopes <- function(x, h) {\r\n\u001b[?2004l\r\r\n  .\u001b[?2004h> "]
[200.329332, "o", "  sec <- diff(h) / diff(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.330125, "o", "  if (length(sec) == 1L) return(rep(sec, 2L))\r\n\u001b[?2004l\rte.ta\u001b[?2004h>   # Interior derivative estimates are weighted averages of adjacent secants.\r\n\u001b[?2004l\r"]
[200.330295, "o", "\u001b[?2004h>   interior <- (sec[-length(sec)] * diff(x)[-length(sec)] +\r\n\u001b[?2004l\r"]
[200.330834, "o", "\u001b[?2004h> "]
[200.331282, "o", "               sec[-1L] * diff(x)[-1L]) /\r\n\u001b[?2004l\r\u001b[?2004h>               (diff(x)[-length(sec)] + diff(x)[-1L])\r\n\u001b[?2004l\rl_o\u001b[?2004h>   c(sec[1L], interior, sec[length(sec)])\r\n\u001b[?2004l\rR\")"]
[200.331313, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.331744, "o", ".ars_hull <- function(x, h) {\r\n\u001b[?2004l\r\u001b[?2004h>   slope <- .ars_slopes(x, h)\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h>   z <- numeric(k + 1L)\r\n\u001b[?2004l\r\u001b[?2004h>   z[1L] <- x[1L]; z[k + 1L] <- x[k]\r\n\u001b[?2004l\r\u001b[?2004h>   for (i in seq_len(k - 1L)) {\r\n\u001b[?2004l\r\u001b[?2004h>     den <- slope[i + 1L] - slope[i]\r\n\u001b[?2004l\r"]
[200.331995, "o", "\u001b[?2004h>     if (abs(den) < 1e-12) val <- (x[i] + x[i + 1L]) / 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.33206, "o", ">     else val <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] - h[i] + slope[i] * x[i]) / den\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.332485, "o", "    z[i + 1L] <- max(x[i], min(x[i + 1L], val))\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   intercept <- h - slope * x\r\n\u001b[?2004l\r\u001b[?2004h>   list(x = x, h = h, slope = slope, intercept = intercept, z = z)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_mass <- function(a, b, m, c) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.3326, "o", "  mid <- (a + b) / 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.332747, "o", "  if (abs(m) < 1e-10) return(exp(m * mid + c) * (b - a))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.332946, "o", "  # midpoint form is substantially more stable than exp(c)*(exp(mb)-exp(ma)).\r\n\u001b[?2004l\r\u001b[?2004h>   exp(m * mid + c) * (2 * sinh(m * (b - a) / 2) / m)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.333138, "o", ".ars_hull_masses <- function(hull) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(hull$x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.333182, "o", "  mass <- vapply(seq_len(k), function(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.333342, "o", "    .ars_mass(hull$z[i], hull$z[i + 1L], hull$slope[i], hull$intercept[i]), numeric(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.33349, "o", "  if (any(!is.finite(mass)) || any(mass <= 0)) stop(\"could not construct a finite ARS envelope\")\r\n\u001b[?2004l\r\u001b[?2004h>   mass\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[200.333531, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[200.333676, "o", "> "]
[200.333821, "o", ".ars_propose <- function(hull, mass) {\r\n\u001b[?2004l\r\u001b[?2004h>   i <- sample.int(length(mass), 1L, prob = mass / sum(mass))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.334049, "o", "  a <- hull$z[i]; b <- hull$z[i + 1L]; m <- hull$slope[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.334204, "o", "  if (abs(m) < 1e-10) y <- a + runif(1L) * (b - a)\r\n\u001b[?2004l\r"]
[200.334332, "o", "\u001b[?2004h> "]
[200.334393, "o", "  else y <- a + log1p(runif(1L) * expm1(m * (b - a))) / m\r\n"]
[200.334513, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[200.334739, "o", "  list(y = min(max(y, a), b), i = i)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[200.334864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.334907, "o", ".ars_insert <- function(x, h, y, hy) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.335177, "o", "  if (any(abs(x - y) < 1e-12)) return(list(x = x, h = h))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.335311, "o", "  o <- order(c(x, y))\r\n\u001b[?2004l\r\u001b[?2004h>   xx <- c(x, y); hh <- c(h, hy)\r\n\u001b[?2004l\r\u001b[?2004h>   list(x = xx[o], h = hh[o])\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ars <- function(density_function, domain, n = sample_count) {\r\n\u001b[?2004l\r"]
[200.335481, "o", "\u001b[?2004h> "]
[200.3356, "o", "  .ars_validate(density_function, domain, n)\r\n\u001b[?2004l\r\u001b[?2004h>   n <- as.integer(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.335707, "o", "> "]
[200.335741, "o", "  if (n == 0L) return(numeric(0L))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.335931, "o", "  .ars_check_concavity(density_function, domain)\r\n\u001b[?2004l\r\u001b[?2004h>   lo <- domain[1L]; hi <- domain[2L]\r\n\u001b[?2004l\r"]
[200.336035, "o", "\u001b[?2004h> "]
[200.336169, "o", "  x <- c(lo, (lo + hi) / 2, hi)\r\n\u001b[?2004l\r\u001b[?2004h>   h <- .ars_log_density(density_function, x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.336416, "o", "  ans <- numeric(n); got <- 0L; attempts <- 0L\r\n\u001b[?2004l\r\u001b[?2004h>   while (got < n) {\r\n\u001b[?2004l\r\u001b[?2004h>     attempts <- attempts + 1L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.336589, "o", "    if (attempts > max(10000L, 2000L * n)) stop(\"ARS acceptance rate is too low\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.336745, "o", "    hull <- .ars_hull(x, h)\r\n\u001b[?2004l\r\u001b[?2004h>     mass <- .ars_hull_masses(hull)\r\n\u001b[?2004l\r\u001b[?2004h>     prop <- .ars_propose(hull, mass)\r\n\u001b[?2004l\r"]
[200.336786, "o", "\u001b[?2004h>     y <- prop$y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337028, "o", "    hy <- .ars_log_density(density_function, y)\r\n\u001b[?2004l\r\u001b[?2004h>     upper <- hull$slope[prop$i] * y + hull$intercept[prop$i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337128, "o", "    # This is an online safety check for non-log-concavity.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337259, "o", "    if (hy > upper + 1e-6) stop(\"non-log-concave density detected during sampling\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337386, "o", "    # Rejection from the tangent envelope; adding every proposal adapts the hull.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337547, "o", "    accept <- log(runif(1L)) <= hy - upper\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337684, "o", "    if (accept) {\r\n\u001b[?2004l\r\u001b[?2004h>       got <- got + 1L\r\n\u001b[?2004l\r\u001b[?2004h>       ans[got] <- y\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337793, "o", "    ins <- .ars_insert(x, h, y, hy)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.337913, "o", "    x <- ins$x; h <- ins$h\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   ans\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[200.337943, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
