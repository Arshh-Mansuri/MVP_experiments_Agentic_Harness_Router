[313.620157, "o", "\u001b[?2004h>   for (i in seq_len(k - 1L)) {\r\n\u001b[?2004l\r\u001b[?2004h>     den <- slope[i + 1L] - slope[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.62686, "o", "    if (abs(den) < 1e-12) boundary[i + 1L] <- (x[i] + x[i + 1L]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>     else boundary[i + 1L] <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] -\r\n\u001b[?2004l\r\u001b[?2004h>                                h[i] + slope[i] * x[i]) / den\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   boundary <- pmax(x[1L], pmin(x[k], boundary))\r\n\u001b[?2004l\r\u001b[?2004h>   boundary <- cummax(boundary)\r\n\u001b[?2004l\r\u001b[?2004h>   boundary[1L] <- x[1L]; boundary[k + 1L] <- x[k]\r\n\u001b[?2004l\r\u001b[?2004h>   list(x=x, h=h, slope=slope, intercept=h-slope*x, z=boundary)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+hull+s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> # Replace masses with consistent k-1 intervals and zero handling.\r\n\u001b[?2004l\r\u001b[?2004h> a=s.index('.ars_hull_masses <- function'); b=s.index('\\n.ars_propose <- function',a)\r\n\u001b[?2004l\r\u001b[?2004h> mass=r'''.ars_hull_masses <- function(hull) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(hull$x) - 1L\r\n\u001b[?2004l\r\u001b[?2004h>   mass <- vapply(seq_len(k), function(i) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (hull$z[i+1L] <= hull$z[i]) return(0)\r\n\u001b[?2004l\r\u001b[?2004h>     .ars_mass(hull$z[i], hull$z[i+1L], hull$slope[i], hull$intercept[i])\r\n\u001b[?2004l\r\u001b[?2004h>   }, numeric(1L))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.626973, "o", "  mass[!is.finite(mass) | mass < 0] <- 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.627253, "o", "  if (!any(mass > 0)) stop(\"could not construct a finite ARS envelope\")\r\n\u001b[?2004l\r\u001b[?2004h>   mass\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[313.627313, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.627636, "o", "s=s[:a]+mass+s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
