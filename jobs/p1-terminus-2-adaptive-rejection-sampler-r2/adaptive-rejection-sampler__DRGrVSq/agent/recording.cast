[200.338134, "o", "  if (length(z)) {\r\n\u001b[?2004l\r"]
[200.338175, "o", "\u001b[?2004h> "]
[200.33829, "o", "    extra <- if (is.finite(target)) sprintf(\", target=%.4f\", target) else \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.338426, "o", "    cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f%s)\\n\", name,\r\n\u001b[?2004l\r\u001b[?2004h>                 if (ok) \"PASS\" else \"FAIL\", mean(z), sd(z), extra))\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.338452, "o", "> "]
[200.338567, "o", "  } else cat(sprintf(\"%s: %s\\n\", name, if (ok) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h>   invisible(ok)\r\n\u001b[?2004l\r"]
[200.338764, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test <- function() {\r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(202503)\r\n\u001b[?2004l\r\u001b[?2004h>   normal <- ars(function(x) dnorm(x), c(-8, 8), n = 3000)\r\n\u001b[?2004l\r"]
[200.338793, "o", "\u001b[?2004h> "]
[200.338885, "o", "  exponential <- ars(function(x) dexp(x), c(0, 25), n = 3000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.339021, "o", "  normal_ok <- abs(mean(normal)) < .10 && abs(sd(normal) - 1) < .10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.339111, "o", "  exponential_ok <- abs(mean(exponential) - 1) < .08 && abs(sd(exponential) - 1) < .08\r\n\u001b[?2004l\r"]
[200.339197, "o", "\u001b[?2004h> "]
[200.339301, "o", "  nonconcave_ok <- tryCatch({ ars(function(x) 1 + .8 * sin(x), c(0, 2*pi), 10); FALSE }, error = function(e) TRUE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.339419, "o", "  invalid_ok <- tryCatch({ ars(dnorm, c(2, 1), 2); FALSE }, error = function(e) TRUE)\r\n\u001b[?2004l\r"]
[200.339679, "o", "\u001b[?2004h>   .ars_report(\"NORMAL_MOMENTS\", normal_ok, normal, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.339905, "o", "  .ars_report(\"EXPONENTIAL_MOMENTS\", exponential_ok, exponential, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.339955, "o", "  .ars_report(\"NON_LOG_CONCAVE_REJECTION\", nonconcave_ok, numeric(0))\r\n\u001b[?2004l\r\u001b[?2004h>   .ars_report(\"INVALID_DOMAIN_REJECTION\", invalid_ok, numeric(0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.340084, "o", "  write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.340173, "o", "  all_ok <- normal_ok && exponential_ok && nonconcave_ok && invalid_ok\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.340332, "o", "  cat(sprintf(\"ALL_TESTS: %s\\n\", if (all_ok) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h>   invisible(all_ok)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
