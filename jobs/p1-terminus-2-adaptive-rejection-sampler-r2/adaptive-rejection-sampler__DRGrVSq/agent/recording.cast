[23.634884, "i", "cat > /app/ars.R <<'EOF'\n# Adaptive rejection sampling (Gilks and Wild, 1992)\n# The target function may be an unnormalised density, but must return\n# positive finite values and be log-concave on the supplied interval.\n\n.ars_validate_density <- function(density_function, domain, n) {\n  if (!is.function(density_function))\n    stop(\"density_function must be a function\")\n  if (!is.numeric(domain) || length(domain) != 2L || any(!is.finite(domain)) ||\n      domain[1L] >= domain[2L])\n    stop(\"domain must be a finite numeric vector c(lower, upper), with lower < upper\")\n  if (!is.numeric(n) || length(n) != 1L || !is.finite(n) || n < 0 || n != as.integer(n))\n    stop(\"n must be one non-negative integer\")\n  invisible(TRUE)\n}\n\n.ars_eval_log_density <- function(f, x) {\n  y <- tryCatch(f(x), error = function(e) stop(\"density_function failed: \", e$message))\n  if (length(y) == 1L && length(x) > 1L) y <- rep(y, length(x))\n  if (length(y) != length(x)) stop(\"density_function must be vectorized and return one value per x\")\n  if (any(!is.finite(y)) || any(y <= 0))\n    stop(\"density_function must return finite, strictly positive values on the sampled domain\")\n  log(y)\n}\n\n# A grid check catches obvious violations before sampling. Local checks below\n# also catch violations among every triple of active support points.\n.ars_check_log_concavity <- function(f, domain, grid_n = 101L, tolerance = 1e-7) {\n  x <- seq(domain[1L], domain[2L], length.out = grid_n)\n  z <- .ars_eval_log_density(f, x)\n  d2 <- z[-c(1L, 2L)] - 2 * z[-c(1L, length(z))] + z[-c(length(z)-1L, length(z))]\n  if (any(d2 > tolerance * (1 + abs(z[-c(1L, 2L)]))))\n    stop(\"density appears non-log-concave on the supplied domain\")\n  invisible(TRUE)\n}\n\n.ars_slopes <- function(x, h) {\n  n <- length(x)\n  if (n == 2L) return(c((h[2L] - h[1L])/(x[2L] - x[1L]),\n                         (h[2L] - h[1L])/(x[2L] - x[1L])))\n  s <- diff(h) / diff(x)\n  c(s[1L], (s[-1L] * diff(x)[-1L] + s[-length(s)] * diff(x)[-length(s)]) /\n      (diff(x)[-1L] + diff(x)[-length(s)]), s[length(s)])\n}\n\n.ars_intersections <- function(x, h, slope) {\n  n <- length(x)\n  z <- numeric(n - 1L)\n  for (i in seq_len(n - 1L)) {\n    den <- slope[i + 1L] - slope[i]\n    if (abs(den) < 1e-12) z[i] <- (x[i] + x[i + 1L]) / 2\n    else z[i] <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] - h[i] + slope[i] * x[i]) / den\n    z[i] <- max(x[i], min(x[i + 1L], z[i]))\n  }\n  c(x[1L], z, x[n])\n}\n\n.ars_interval_mass <- function(a, b, m, c) {\n  # Integral exp(m*x+c) dx, evaluated stably around the midpoint.\n  mid <- (a + b) / 2\n  w <- exp(m * mid + c)\n  if (abs(m) < 1e-10) w * (b - a) else w * 2 * sinh(m * (b - a) / 2) / m\n}\n\n.ars_draw_from_interval <- function(a, b, m, c) {\n  u <- runif(1L)\n  if (abs(m) < 1e-10) return(a + u * (b - a))\n  # Inverse CDF using a scaled exponential expression, avoiding overflow.\n  a + log1p(u * expm1(m * (b - a))) / m\n}\n\n.ars_hull <- function(x, h) {\n  slope <- .ars_slopes(x, h)\n  z <- .ars_intersections(x, h, slope)\n  # Upper hull on interval [z[i], z[i+1]] uses tangent at x[i].\n  cval <- h - slope * x\n  mass <- vapply(seq_len(length(x) - 1L), function(i)\n    .ars_interval_mass(z[i], z[i + 1L], slope[i], cval[i]), numeric(1L))\n  if (any(!is.finite(mass)) || any(mass <= 0)) stop(\"failed to construct a finite ARS envelope\")\n  list(slope = slope, intercept = cval, z = z, mass = mass)\n}\n\n.ars_propose <- function(hull) {\n  p <- hull$mass / sum(hull$mass)\n  i <- sample.int(length(p), 1L, prob = p)\n  list(x = .ars_draw_from_interval(hull$z[i], hull$z[i + 1L],\n                                   hull$slope[i], hull$intercept[i]), i = i)\n}\n\n# Adaptive rejection sampler. For finite domains the initial support is at both\n# endpoints plus an interior point. The implementation uses tangent upper hulls\n# and squeeze/rejection tests, adding accepted points to adapt the hull.\nars <- function(density_function, domain, n = sample_count) {\n  .ars_validate_density(density_function, domain, n)\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0L))\n  .ars_check_log_concavity(density_function, domain)\n  lo <- domain[1L]; hi <- domain[2L]\n  x "]
[23.634978, "i", "<- c(lo, (lo + hi) / 2, hi)\n  h <- .ars_eval_log_density(density_function, x)\n  if (any(diff(h) == 0)) warning(\"flat portions detected; continuing with ARS\")\n  out <- numeric(n); accepted <- 0L; attempts <- 0L\n  while (accepted < n) {\n    if (attempts > max(10000L, 1000L * n)) stop(\"ARS acceptance is too low; check density and domain\")\n    hull <- .ars_hull(x, h)\n    q <- .ars_propose(hull); y <- q$x\n    hy <- .ars_eval_log_density(density_function, y)[1L]\n    upper <- hull$slope[q$i] * y + hull$intercept[q$i]\n    if (hy > upper + 1e-7) stop(\"non-log-concave density detected during sampling\")\n    attempts <- attempts + 1L\n    if (log(runif(1L)) <= hy - upper) {\n      accepted <- accepted + 1L; out[accepted] <- y\n      if (all(abs(x - y) > 1e-10)) {\n        k <- order(c(x, y)); xx <- c(x, y); hh <- c(h, hy)\n        x <- xx[k]; h <- hh[k]\n      }\n    } else if (all(abs(x - y) > 1e-10)) {\n      k <- order(c(x, y)); xx <- c(x, y); hh <- c(h, hy)\n      x <- xx[k]; h <- hh[k]\n    }\n  }\n  out\n}\n\n.print_test <- function(name, ok, values = numeric(0L), target = NA_real_) {\n  if (length(values)) {\n    cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f\", name, if (ok) \"PASS\" else \"FAIL\",\n                mean(values), sd(values)))\n    if (is.finite(target)) cat(sprintf(\", target=%.4f\", target))\n    cat(\")\\n\")\n  } else cat(sprintf(\"%s: %s\\n\", name, if (ok) \"PASS\" else \"FAIL\"))\n  invisible(ok)\n}\n\n# Formal stochastic tests against known moments and input/error behavior.\ntest <- function() {\n  set.seed(2024)\n  normal <- ars(function(x) dnorm(x), c(-8, 8), 3000)\n  exponential <- ars(function(x) dexp(x), c(0, 25), 3000)\n  ok1 <- abs(mean(normal)) < 0.10 && abs(sd(normal) - 1) < 0.10\n  ok2 <- abs(mean(exponential) - 1) < 0.08 && abs(sd(exponential) - 1) < 0.08\n  bad <- tryCatch({ ars(function(x) 1 + 0.8 * sin(x), c(0, 2*pi), 10); FALSE }, error = function(e) TRUE)\n  invalid <- tryCatch({ ars(function(x) dnorm(x), c(1, 0), 2); FALSE }, error = function(e) TRUE)\n  .print_test(\"NORMAL_MOMENTS\", ok1, normal, 0)\n  .print_test(\"EXPONENTIAL_MOMENTS\", ok2, exponential, 1)\n  .print_test(\"NON_LOG_CONCAVE_REJECTION\", bad)\n  .print_test(\"INVALID_DOMAIN_REJECTION\", invalid)\n  write.table(normal, \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\n  all_ok <- ok1 && ok2 && bad && invalid\n  cat(sprintf(\"ALL_TESTS: %s\\n\", if (all_ok) \"PASS\" else \"FAIL\"))\n  invisible(all_ok)\n}\nEOF\nRscript -e 'source(\"/app/ars.R\"); test()'\nls -l /app/ars.R /app/normal_samples.txt\n"]
[23.636022, "o", "cat > /app/ars.R <<'EOF'\r\n# Adaptive rejection sampling (Gilks and Wild, 1992)\r\n# The target function may be an unnormalised density, but must return\r\n# positive finite values and be log-concave on the supplied interval.\r\n\r\n.ars_validate_density <- function(density_function, domain, n) {\r\n  if (!is.function(density_function))\r\n    stop(\"density_function must be a function\")\r\n  if (!is.numeric(domain) || length(domain) != 2L || any(!is.finite(domain)) ||\r\n      domain[1L] >= domain[2L])\r\n    stop(\"domain must be a finite numeric vector c(lower, upper), with lower < upper\")\r\n  if (!is.numeric(n) || length(n) != 1L || !is.finite(n) || n < 0 || n != as.integer(n))\r\n    stop(\"n must be one non-negative integer\")\r\n  invisible(TRUE)\r\n}\r\n\r\n.ars_eval_log_density <- function(f, x) {\r\n  y <- tryCatch(f(x), error = function(e) stop(\"density_function failed: \", e$message))\r\n  if (length(y) == 1L && length(x) > 1L) y <- rep(y, length(x))\r\n  if (length(y) != length(x)) stop(\"density_function must be vectorized and return one value per x\")\r\n  if (any(!is.finite(y)) || any(y <= 0))\r\n    stop(\"density_function must return finite, strictly positive values on the sampled domain\")\r\n  log(y)\r\n}\r\n\r\n# A grid check catches obvious violations before sampling. Local checks below\r\n# also catch violations among every triple of active support points.\r\n.ars_check_log_concavity <- function(f, domain, grid_n = 101L, tolerance = 1e-7) {\r\n  x <- seq(domain[1L], domain[2L], length.out = grid_n)\r\n  z <- .ars_eval_log_density(f, x)\r\n  d2 <- z[-c(1L, 2L)] - 2 * z[-c(1L, length(z))] + z[-c(length(z)-1L, length(z))]\r\n  if (any(d2 > tolerance * (1 + abs(z[-c(1L, 2L)]))))\r\n    stop(\"density appears non-log-concave on the supplied domain\")\r\n  invisible(TRUE)\r\n}\r\n\r\n.ars_slopes <- function(x, h) {\r\n  n <- length(x)\r\n  if (n == 2L) return(c((h[2L] - h[1L])/(x[2L] - x[1L]),\r\n                         (h[2L] - h[1L])/(x[2L] - x[1L])))\r\n  s <- diff(h) / diff(x)\r\n  c(s[1L], (s[-1L] * diff(x)[-1L] + s[-length(s)] * diff(x)[-length(s)]) /\r\n      (diff(x)[-1L] + diff(x)[-length(s)]), s[length(s)])\r\n}\r\n\r\n.ars_intersections <- function(x, h, slope) {\r\n  n <- length(x)\r\n  z <- numeric(n - 1L)\r\n  for (i in seq_len(n - 1L)) {\r\n    den <- slope[i + 1L] - slope[i]\r\n    if (abs(den) < 1e-12) z[i] <- (x[i] + x[i + 1L]) / 2\r\n    else z[i] <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] - h[i] + slope[i] * x[i]) / den\r\n    z[i] <- max(x[i], min(x[i + 1L], z[i]))\r\n  }\r\n  c(x[1L], z, x[n])\r\n}\r\n\r\n.ars_interval_mass <- function(a, b, m, c) {\r\n  # Integral exp(m*x+c) dx, evaluated stably around the midpoint.\r\n  mid <- (a + b) / 2\r\n  w <- exp(m * mid + c)\r\n  if (abs(m) < 1e-10) w * (b - a) else w * 2 * sinh(m * (b - a) / 2) / m\r\n}\r\n\r\n.ars_draw_from_interval <- function(a, b, m, c) {\r\n  u <- runif(1L)\r\n  if (abs(m) < 1e-10) return(a + u * (b - a))\r\n  # Inverse CDF using a scaled exponential expression, avoiding overflow.\r\n  a + log1p(u * expm1(m * (b - a))) / m\r\n}\r\n\r\n.ars_hull <- function(x, h) {\r\n  slope <- .ars_slopes(x, h)\r\n  z <- .ars_intersections(x, h, slope)\r\n  # Upper hull on interval [z[i], z[i+1]] uses tangent at x[i].\r\n  cval <- h - slope * x\r\n  mass <- vapply(seq_len(length(x) - 1L), function(i)\r\n    .ars_interval_mass(z[i], z[i + 1L], slope[i], cval[i]), numeric(1L))\r\n  if (any(!is.finite(mass)) || any(mass <= 0)) stop(\"failed to construct a finite ARS envelope\")\r\n  list(slope = slope, intercept = cval, z = z, mass = mass)\r\n}\r\n\r\n.ars_propose <- function(hull) {\r\n  p <- hull$mass / sum(hull$mass)\r\n  i <- sample.int(length(p), 1L, prob = p)\r\n  list(x = .ars_draw_from_interval(hull$z[i], hull$z[i + 1L],\r\n                                   hull$slope[i], hull$intercept[i]), i = i)\r\n}\r\n\r\n# Adaptive rejection sampler. For finite domains the initial support is at both\r\n# endpoints plus an