[229.694745, "i", "python3 - <<'PY'\np='/app/ars.R'\ns=open(p).read()\nold='''  if (length(sec) == 1L) return(rep(sec, 2L))\n  # Interior derivative estimates are weighted averages of adjacent secants.\n  interior <- (sec[-length(sec)] * diff(x)[-length(sec)] +\n               sec[-1L] * diff(x)[-1L]) /\n              (diff(x)[-length(sec)] + diff(x)[-1L])\n  c(sec[1L], interior, sec[length(sec)])'''\nnew='''  if (length(sec) == 1L) return(rep(sec, 2L))\n  dx <- diff(x)\n  # For a concave log density the endpoint derivatives lie beyond the\n  # adjacent secants. Extrapolation prevents a boundary tangent from\n  # falling below the log density on a finite domain.\n  left <- sec[1L] + (sec[1L] - sec[2L]) * dx[1L] / max(dx[2L], .Machine$double.eps)\n  right <- sec[length(sec)] +\n    (sec[length(sec)] - sec[length(sec) - 1L]) *\n    dx[length(dx)] / max(dx[length(dx) - 1L], .Machine$double.eps)\n  # Interior derivative estimates are weighted averages of adjacent secants.\n  interior <- (sec[-length(sec)] * dx[-length(dx)] +\n               sec[-1L] * dx[-1L]) /\n              (dx[-length(dx)] + dx[-1L])\n  c(left, interior, right)'''\nif old not in s:\n    raise SystemExit('target block not found')\nopen(p,'w').write(s.replace(old,new))\nPY\nRscript -e 'source(\"/app/ars.R\"); test()'\n"]
[229.699805, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/ars.R'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old='''  if (length(sec) == 1L) return(rep(sec, 2L))\r\n\u001b[?2004l\r\u001b[?2004h>   # Interior derivative estimates are weighted averages of adjacent secants.\r\n\u001b[?2004l\r\u001b[?2004h>   interior <- (sec[-length(sec)] * diff(x)[-length(sec)] +\r\n\u001b[?2004l\r\u001b[?2004h>                sec[-1L] * diff(x)[-1L]) /\r\n\u001b[?2004l\r\u001b[?2004h>               (diff(x)[-length(sec)] + diff(x)[-1L])\r\n\u001b[?2004l\r\u001b[?2004h>   c(sec[1L], interior, sec[length(sec)])'''\r\n\u001b[?2004l\r\u001b[?2004h> new='''  if (length(sec) == 1L) return(rep(sec, 2L))\r\n\u001b[?2004l\r\u001b[?2004h>   dx <- diff(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
