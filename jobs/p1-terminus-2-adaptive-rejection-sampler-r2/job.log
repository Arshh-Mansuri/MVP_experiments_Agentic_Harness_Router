(x, h) {\n  slope <- .ars_slopes(x, h)\n  k <- length(x)\n  z <- numeric(k + 1L)\n  z[1L] <- x[1L]; z[k + 1L] <- x[k]\n  for (i in seq_len(k - 1L)) {\n    den <- slope[i + 1L] - slope[i]\n    if (abs(den) < 1e-12) val <- (x[i] + x[i + 1L]) / 2\n    else val <- (h[i + 1L] - slope[i + 1L] * x[i + 1L] - h[i] + slope[i] * x[i]) / den\n    z[i + 1L] <- max(x[i], min(x[i + 1L], val))\n  }\n  intercept <- h - slope * x\n  list(x = x, h = h, slope = slope, intercept = intercept, z = z)\n}\n\n.ars_mass <- function(a, b, m, c) {\n  mid <- (a + b) / 2\n  if (abs(m) < 1e-10) return(exp(m * mid + c) * (b - a))\n  # midpoint form is substantially more stable than exp(c)*(exp(mb)-exp(ma)).\n  exp(m * mid + c) * (2 * sinh(m * (b - a) / 2) / m)\n}\n\n.ars_hull_masses <- function(hull) {\n  k <- length(hull$x)\n  mass <- vapply(seq_len(k), function(i)\n    .ars_mass(hull$z[i], hull$z[i + 1L], hull$slope[i], hull$intercept[i]), numeric(1))\n  if (any(!is.finite(mass)) || any(mass <= 0)) stop("could not construct a finite ARS envelope")\n  mass\n}\n\n.ars_propose <- function(hull, mass) {\n  i <- sample.int(length(mass), 1L, prob = mass / sum(mass))\n  a <- hull$z[i]; b <- hull$z[i + 1L]; m <- hull$slope[i]\n  if (abs(m) < 1e-10) y <- a + runif(1L) * (b - a)\n  else y <- a + log1p(runif(1L) * expm1(m * (b - a))) / m\n  list(y = min(max(y, a), b), i = i)\n}\n\n.ars_insert <- function(x, h, y, hy) {\n  if (any(abs(x - y) < 1e-12)) return(list(x = x, h = h))\n  o <- order(c(x, y))\n  xx <- c(x, y); hh <- c(h, hy)\n  list(x = xx[o], h = hh[o])\n}\n\nars <- function(density_function, domain, n = sample_count) {\n  .ars_validate(density_function, domain, n)\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0L))\n  .ars_check_concavity(density_function, domain)\n  lo <- domain[1L]; hi <- domain[2L]\n  x <- c(lo, (lo + hi) / 2, hi)\n  h <- .ars_log_density(density_function, x)\n  ans <- numeric(n); got <- 0L; attempts <- 0L\n  while (got < n) {\n    attempts <- attempts + 1L\n    if (attempts > max(10000L, 2000L * n)) stop("ARS acceptance rate is too low")\n    hull <- .ars_hull(x, h)\n    mass <- .ars_hull_masses(hull)\n    prop <- .ars_propose(hull, mass)\n    y <- prop$y\n    hy <- .ars_log_density(density_function, y)\n    upper <- hull$slope[prop$i] * y + hull$intercept[prop$i]\n    # This is an online safety check for non-log-concavity.\n    if (hy > upper + 1e-6) stop("non-log-concave density detected during sampling")\n    # Rejection from the tangent envelope; adding every proposal adapts the hull.\n    accept <- log(runif(1L)) <= hy - upper\n    if (accept) {\n      got <- got + 1L\n      ans[got] <- y\n    }\n    ins <- .ars_insert(x, h, y, hy)\n    x <- ins$x; h <- ins$h\n  }\n  ans\n}\n\n.ars_report <- function(name, ok, z, target = NA_real_) {\n  if (length(z)) {\n    extra <- if (is.finite(target)) sprintf(", target=%.4f", target) else ""\n    cat(sprintf("%s: %s (mean=%.4f, sd=%.4f%s)\\n", name,\n                if (ok) "PASS" else "FAIL", mean(z), sd(z), extra))\n  } else cat(sprintf("%s: %s\\n", name, if (ok) "PASS" else "FAIL"))\n  invisible(ok)\n}\n\ntest <- function() {\n  set.seed(202503)\n  normal <- ars(function(x) dnorm(x), c(-8, 8), n = 3000)\n  exponential <- ars(function(x) dexp(x), c(0, 25), n = 3000)\n  normal_ok <- abs(mean(normal)) < .10 && abs(sd(normal) - 1) < .10\n  exponential_ok <- abs(mean(exponential) - 1) < .08 && abs(sd(exponential) - 1) < .08\n  nonconcave_ok <- tryCatch({ ars(function(x) 1 + .8 * sin(x), c(0, 2*pi), 10); FALSE }, error = function(e) TRUE)\n  invalid_ok <- tryCatch({ ars(dnorm, c(2, 1), 2); FALSE }, error = function(e) TRUE)\n  .ars_report("NORMAL_MOMENTS", normal_ok, normal, 0)\n  .ars_report("EXPONENTIAL_MOMENTS", exponential_ok, exponential, 1)\n  .ars_report("NON_LOG_CONCAVE_REJECTION", nonconcave_ok, numeric(0))\n  .ars_report("INVALID_DOMAIN_REJECTION", invalid_ok, numeric(0))\n  write.table(normal, "/app/normal_samples.txt", row.names = FALSE, col.names = FALSE)\n  all_ok <- normal_ok && exponential_ok && nonconcave_ok && invalid_ok\n  cat(sprintf("ALL_TESTS: %s\\n", if (all_ok) "PASS" else "FAIL"))\n  invisible(all_ok)\n}\nEOF\nRscript -e \'source("/app/ars.R"); test()\'\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
