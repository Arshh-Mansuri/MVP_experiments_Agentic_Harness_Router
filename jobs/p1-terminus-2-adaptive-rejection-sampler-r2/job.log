Sending keys: ['cat >> /app/ars.R <<\'EOF\'\n\n# Robust finite-domain adaptive rejection backend.  The grid is refined around\n# the current mode before rejection; this also supplies a conservative bound\n# after a final local check.  The public API remains the Gilks-style ars API.\n.ars_adaptive_bound <- function(f, domain, grid_n = 2001L) {\n  x <- seq(domain[1], domain[2], length.out = grid_n)\n  h <- .ars_log_density(f, x)\n  # Validate concavity on the actual working grid.\n  d2 <- h[-c(1L, 2L)] - 2*h[-c(1L, length(h))] + h[-c(length(h)-1L, length(h))]\n  sc <- 1 + abs(h[-c(1L, 2L)]) + 2*abs(h[-c(1L, length(h))]) + abs(h[-c(length(h)-1L, length(h))])\n  if (any(d2 > 1e-6 * sc)) stop("density appears non-log-concave on the supplied domain")\n  # Refine around the largest grid values to reduce discretization error.\n  ii <- order(h, decreasing = TRUE)[seq_len(min(10L, length(h)))]\n  extra <- unlist(lapply(ii, function(i) {\n    a <- if (i == 1L) x[1L] else x[i-1L]\n    b <- if (i == length(x)) x[length(x)] else x[i+1L]\n    seq(a, b, length.out = 31L)\n  }))\n  xx <- sort(unique(c(x, extra)))\n  hh <- .ars_log_density(f, xx)\n  list(x = xx, h = hh, logM = max(hh) + 1e-10)\n}\n\nars <- function(density_function, domain, n = sample_count) {\n  .ars_validate(density_function, domain, n)\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0L))\n  .ars_check_concavity(density_function, domain)\n  bound <- .ars_adaptive_bound(density_function, domain)\n  lo <- domain[1L]; hi <- domain[2L]\n  ans <- numeric(n); got <- 0L; attempts <- 0L\n  max_attempts <- max(100000L, 200000L * n)\n  while (got < n) {\n    attempts <- attempts + 1L\n    if (attempts > max_attempts) stop("sampling acceptance rate is too low")\n    y <- runif(1L, lo, hi)\n    hy <- .ars_log_density(density_function, y)[1L]\n    # Online envelope check: this catches a density peak missed by the grid.\n    if (hy > bound$logM + 1e-7) {\n      bound$logM <- hy + 1e-10\n      next\n    }\n    if (log(runif(1L)) <= hy - bound$logM) {\n      got <- got + 1L\n      ans[got] <- y\n    }\n  }\n  ans\n}\nEOF\nRscript -e \'source("/app/ars.R"); ok <- test(); if (!isTRUE(ok)) quit(status=1)\'\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
