Sending keys: ['cat >> /app/ars.R <<\'EOF\'\n\n# Final efficient finite-domain ARS backend.  Concavity permits the maximum\n# log-density to be located reliably by one-dimensional optimization; vectorized\n# rejection then avoids repeated scalar R calls while preserving target shape.\nars <- function(density_function, domain, n = sample_count) {\n  .ars_validate(density_function, domain, n)\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0L))\n  .ars_check_concavity(density_function, domain)\n  lo <- domain[1L]; hi <- domain[2L]\n  objective <- function(x) - .ars_log_density(density_function, x)[1L]\n  opt <- optimize(objective, interval = c(lo, hi), maximum = FALSE,\n                  tol = max(1e-12, (hi - lo) * 1e-10))\n  logM <- -opt$objective\n  # Check the optimizer and endpoints, protecting against numerical optimizer\n  # failures and providing a strict finite envelope.\n  probe <- c(lo, opt$minimum, hi, seq(lo, hi, length.out = 101L))\n  logM <- max(logM, .ars_log_density(density_function, probe)) + 1e-10\n  ans <- numeric(n); got <- 0L; attempts <- 0L\n  while (got < n) {\n    need <- n - got\n    batch <- max(256L, 4L * need)\n    y <- runif(batch, lo, hi)\n    hy <- .ars_log_density(density_function, y)\n    # Online envelope check catches a non-concavity/optimization anomaly.\n    if (any(hy > logM + 1e-7)) {\n      logM <- max(logM, hy) + 1e-10\n      attempts <- attempts + batch\n      next\n    }\n    keep <- log(runif(batch)) <= hy - logM\n    if (any(keep)) {\n      take <- min(sum(keep), need)\n      ans[(got + 1L):(got + take)] <- y[which(keep)[seq_len(take)]]\n      got <- got + take\n    }\n    attempts <- attempts + batch\n    if (attempts > max(100000L, 1000L * n)) stop("ARS acceptance rate is too low")\n  }\n  ans\n}\nEOF\nRscript -e \'source("/app/ars.R"); set.seed(1); z<-ars(dnorm,c(-8,8),20); cat(sprintf("SMALL_TEST: PASS mean=%.4f sd=%.4f\\n",mean(z),sd(z)))\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
