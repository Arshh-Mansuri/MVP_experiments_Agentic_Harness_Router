[80.551951, "i", "echo 'APP'; ls -la /app; echo 'WAL-LIKE'; find /app /tmp /root -type f \\( -iname '*wal*' -o -iname '*main*' -o -iname '*.db*' \\) -printf '%p %s bytes\\n' 2>/dev/null; echo 'DELETED OPEN'; for p in /proc/[0-9]*/fd/*; do x=$(readlink \"$p\" 2>/dev/null) || continue; case \"$x\" in *deleted*) echo \"$p -> $x\";; esac; done; echo 'ALL SQLITE'; find / -type f -size -10M \\( -name '*.db' -o -name '*-wal' -o -name '*-journal' -o -name '*-shm' \\) -printf '%p %s\\n' 2>/dev/null\n"]
