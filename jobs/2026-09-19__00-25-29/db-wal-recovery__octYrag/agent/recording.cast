[72.005373, "i", "cp /app/main.db-wal /app/main.db-wal.encrypted && python3 - <<'PY'\np='/app/main.db-wal'\nb=bytearray(open(p,'rb').read())\nfor i in range(len(b)):\n    b[i] ^= 0x42\nopen(p,'wb').write(b)\nprint('decrypted',len(b),'bytes; header',bytes(b[:8]).hex())\nPY\npython3 - <<'PY'\nimport sqlite3,json\np='/app/main.db'\nc=sqlite3.connect(p)\nrows=c.execute('select id,name,value from items order by id').fetchall()\nprint('rows',len(rows),rows)\nif len(rows)!=11: raise SystemExit('expected 11 rows')\nout=[{'id':r[0],'name':r[1],'value':r[2]} for r in rows]\nwith open('/app/recovered.json','w') as f: json.dump(out,f,separators=(',',':'))\nprint('wrote /app/recovered.json')\nPY\npython3 - <<'PY'\nimport json\nx=json.load(open('/app/recovered.json'))\nassert len(x)==11\nassert [r['id'] for r in x]==list(range(1,12))\nprint(json.dumps(x,indent=2))\nPY\n"]
