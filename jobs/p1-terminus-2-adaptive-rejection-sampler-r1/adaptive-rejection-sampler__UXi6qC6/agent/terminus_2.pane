# Adaptive rejection sampling following Gilks and Wild (1992).
# The density function must accept a numeric vector and return a vector
# of nonnegative (possibly unnormalised) density values.

sample_count <- 100

.ars_validate_domain <- function(domain) {
  if (!is.numeric(domain) || length(domain) != 2L || anyNA(domain))
    stop("domain must be a numeric vector of length two")
  if (domain[1] >= domain[2]) stop("domain must satisfy domain[1] < domain[2]")
  if (is.nan(domain[1]) || is.nan(domain[2])) stop("domain contains NaN")
  invisible(TRUE)
}

.ars_eval_log_density <- function(f, x, domain) {
  if (!is.numeric(x)) stop("internal error: x must be numeric")
  if (any(x < domain[1] | x > domain[2])) stop("point outside domain")
  z <- tryCatch(f(x), error = function(e) stop("density_function failed: ", e$message))
  if (!is.numeric(z) || length(z) != length(x))
    stop("density_function must return a numeric vector of the same length")
  if (any(is.na(z)) || any(!is.finite(z) & z != 0) || any(z < 0))
    stop("density_function must return finite nonnegative values")
  ans <- rep(-Inf, length(z))
  good <- z > 0
  ans[good] <- log(z[good])
  ans
}

.ars_initial_knots <- function(domain) {
  lo <- domain[1]; hi <- domain[2]
  if (is.finite(lo) && is.finite(hi)) {
    p <- seq(0.08, 0.92, length.out = 5)
    return(lo + p * (hi - lo))
  }
  if (!is.finite(lo) && !is.finite(hi)) return(c(-4, -1, 0, 1, 4))
  if (!is.finite(lo)) return(hi - c(8, 4, 2, 1, 0.25))
  return(lo + c(0.05, 0.25, 1, 3, 8))
}

.ars_derivative <- function(f, x, domain) {
  # A finite-difference derivative is adequate for the continuously
  # differentiable densities normally used with ARS.
  h <- 1e-5 * max(1, abs(x))
  a <- if (is.finite(domain[1])) max(domain[1], x - h) else x - h
  b <- if (is.finite(domain[2])) min(domain[2], x + h) else x + h
  if (b <= a) stop("cannot calculate a derivative at this domain")
  ya <- .ars_eval_log_density(f, a, domain)
  yb <- .ars_eval_log_density(f, b, domain)
  if (!is.finite(ya) || !is.finite(yb)) stop("density is zero near an initial knot")
  (yb - ya) / (b - a)
}

.ars_check_concavity <- function(x, y, d, tolerance = 2e-3) {
  keep <- is.finite(y) & is.finite(d)
  if (sum(keep) < 3) stop("density has insufficient positive support for ARS")
  xx <- x[keep]; dd <- d[keep]
  if (any(diff(dd) > tolerance * (1 + abs(dd[-length(dd)]))))
    stop("density appears not to be log-concave")
  if (length(xx) >= 3) {
    slopes <- diff(y[keep]) / diff(xx)
    if (any(diff(slopes) > 5e-3 * (1 + abs(slopes[-length(slopes)]))))
      stop("density appears not to be log-concave")
  }
  invisible(TRUE)
}

.ars_hull <- function(x, y, d, domain) {
  m <- length(x)
  z <- numeric(m + 1L)
  z[1] <- domain[1]
  z[m + 1L] <- domain[2]
  if (m > 1L) {
    for (i in 1:(m - 1L)) {
      den <- d[i] - d[i + 1L]
      if (abs(den) < 1e-12) z[i + 1L] <- (x[i] + x[i + 1L]) / 2
      else z[i + 1L] <- (y[i + 1L] - d[i + 1L] * x[i + 1L] -
                           y[i] + d[i] * x[i]) / den
    }
  }
  z[-1L] <- pmax(z[-1L], z[-length(z)] + 1e-12)
  z[1] <- domain[1]; z[m + 1L] <- domain[2]
  if (any(z[-1L] <= z[-length(z)])) stop("failed to construct ARS hull")
  list(bounds = z, slopes = d, intercepts = y - d * x)
}

.ars_interval_mass <- function(a, b, slope, intercept) {
  # Integral of exp(intercept + slope*x), with stable handling of slope zero.
  if (is.infinite(a) || is.infinite(b)) {
    if ((is.infinite(a) && slope <= 0) || (is.infinite(b) && slope >= 0))
      return(Inf)
  }
  if (abs(slope) < 1e-10) return(exp(intercept) * (b - a))
  v <- exp(intercept + slope * a) * (-expm1(slope * (b - a))) / slope
  if (!is.finite(v) || v <= 0) {
    # Equivalent expression for large exponents.
    v <- (exp(intercept + slope * b) - exp(intercept + slope * a)) / slope
  }
  v
}

