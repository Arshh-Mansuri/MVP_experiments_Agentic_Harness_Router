[224.122521, "o", "ars <- function(density_function, domain, n=sample_count) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.function(density_function)) stop(\"density_function must be a function\")\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.numeric(domain) || length(domain)!=2 || anyNA(domain) || domain[1]>=domain[2])\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"domain must be numeric length two with lower < upper\")\r\n\u001b[?2004l\r\u001b[?2004h>   if (length(n)!=1 || !is.numeric(n) || !is.finite(n) || n<0 || n!=as.integer(n))\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"n must be a nonnegative integer\")\r\n\u001b[?2004l\r\u001b[?2004h>   n <- as.integer(n); if (!n) return(numeric())\r\n\u001b[?2004l\r\u001b[?2004h>   x <- sort(unique(.ars_knots(domain))); y <- .ars_logf(density_function,x,domain)\r\n\u001b[?2004l\r\u001b[?2004h>   s <- vapply(x,function(q) .ars_slope(density_function,q,domain),numeric(1))\r\n\u001b[?2004l\r\u001b[?2004h>   .ars_concave(x,y,s)\r\n\u001b[?2004l\r\u001b[?2004h>   out <- numeric(n); got <- 0L; iter <- 0L\r\n\u001b[?2004l\r\u001b[?2004h>   while (got<n) {\r\n\u001b[?2004l\r\u001b[?2004h>     iter <- iter+1L; if (iter>200000) stop(\"ARS iteration limit exceeded\")\r\n\u001b[?2004l\r\u001b[?2004h>     o <- order(x); x<-x[o]; y<-y[o]; s<-s[o]; h <- .ars_hull(x,y,s,domain)\r\n\u001b[?2004l\r\u001b[?2004h>     lm <- vapply(seq_along(s),function(i) .ars_logmass(h$z[i],h$z[i+1],s[i],h$intercept[i]),numeric(1))\r\n\u001b[?2004l\r\u001b[?2004h>     if (all(!is.finite(lm))) stop(\"density has no usable integrable envelope\")\r\n\u001b[?2004l\r\u001b[?2004h>     mx <- max(lm); pr <- exp(lm-mx); pr[!is.finite(pr)] <- 0; k <- sample.int(length(pr),1,prob=pr)\r\n\u001b[?2004l\r\u001b[?2004h>     q <- .ars_draw(h$z[k],h$z[k+1],s[k],runif(1)); lq <- .ars_logf(density_function,q,domain)\r\n\u001b[?2004l\r\u001b[?2004h>     uq <- h$intercept[k]+s[k]*q\r\n\u001b[?2004l\r\u001b[?2004h>     if (!is.finite(lq) || lq>uq+1e-6) stop(\"density violates the ARS upper hull; not log-concave\")\r\n\u001b[?2004l\r\u001b[?2004h>     if (log(runif(1)) <= lq-uq) { got<-got+1L; out[got]<-q }\r\n\u001b[?2004l\r\u001b[?2004h>     else { x<-c(x,q); y<-c(y,lq); s<-c(s,.ars_slope(density_function,q,domain)); .ars_concave(sort(x),y[order(x)],s[order(x)]) }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sample_count <- 100\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .test_result <- function(name,ok,z) cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f)\\n\",name,if(ok)\"PASS\" else \"FAIL\",mean(z),sd(z)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test <- function() {\r\n\u001b[?2004l\r\u001b[?2004h>   set.seed(12345)\r\n\u001b[?2004l\r\u001b[?2004h>   z <- ars(function(x) dnorm(x),c(-Inf,Inf),3000)\r\n\u001b[?2004l\r\u001b[?2004h>   ok1 <- abs(mean(z))<.12 && abs(sd(z)-1)<.12; .test_result(\"NORMAL_SAMPLING\",ok1,z)\r\n\u001b[?2004l\r\u001b[?2004h>   write.table(z,\"/app/normal_samples.txt\",row.names=FALSE,col.names=FALSE)\r\n\u001b[?2004l\r\u001b[?2004h>   e <- ars(function(x) dexp(x),c(0,Inf),3000)\r\n\u001b[?2004l\r\u001b[?2004h>   ok2 <- abs(mean(e)-1)<.12 && abs(sd(e)-1)<.12 && all(e>=0); .test_result(\"EXPONENTIAL_SAMPLING\",ok2,e)\r\n\u001b[?2004l\r\u001b[?2004h>   write.table(e,\"/app/exponential_samples.txt\",row.names=FALSE,col.names=FALSE)\r\n\u001b[?2004l\r\u001b[?2004h>   bad <- tryCatch({ars(function(x) exp(-(x^2-1)^2),c(-3,3),10);FALSE},error=function(e)TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"NON_LOG_CONCAVE_REJECTION: %s (mean=NA, sd=NA)\\n\",if(bad)\"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h>   inv <- tryCatch({ars(dnorm,c(1,0),1);FALSE},error=function(e)TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   cat(sprintf(\"INPUT_VALIDATION: %s (mean=NA, sd=NA)\\n\",if(inv)\"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r\u001b[?2004h>   isTRUE(all