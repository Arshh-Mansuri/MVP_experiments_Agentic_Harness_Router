[37.028497, "i", "cat > /app/ars.R <<'EOF'\n# Adaptive rejection sampling following Gilks and Wild (1992).\n# The density function must accept a numeric vector and return a vector\n# of nonnegative (possibly unnormalised) density values.\n\nsample_count <- 100\n\n.ars_validate_domain <- function(domain) {\n  if (!is.numeric(domain) || length(domain) != 2L || anyNA(domain))\n    stop(\"domain must be a numeric vector of length two\")\n  if (domain[1] >= domain[2]) stop(\"domain must satisfy domain[1] < domain[2]\")\n  if (is.nan(domain[1]) || is.nan(domain[2])) stop(\"domain contains NaN\")\n  invisible(TRUE)\n}\n\n.ars_eval_log_density <- function(f, x, domain) {\n  if (!is.numeric(x)) stop(\"internal error: x must be numeric\")\n  if (any(x < domain[1] | x > domain[2])) stop(\"point outside domain\")\n  z <- tryCatch(f(x), error = function(e) stop(\"density_function failed: \", e$message))\n  if (!is.numeric(z) || length(z) != length(x))\n    stop(\"density_function must return a numeric vector of the same length\")\n  if (any(is.na(z)) || any(!is.finite(z) & z != 0) || any(z < 0))\n    stop(\"density_function must return finite nonnegative values\")\n  ans <- rep(-Inf, length(z))\n  good <- z > 0\n  ans[good] <- log(z[good])\n  ans\n}\n\n.ars_initial_knots <- function(domain) {\n  lo <- domain[1]; hi <- domain[2]\n  if (is.finite(lo) && is.finite(hi)) {\n    p <- seq(0.08, 0.92, length.out = 5)\n    return(lo + p * (hi - lo))\n  }\n  if (!is.finite(lo) && !is.finite(hi)) return(c(-4, -1, 0, 1, 4))\n  if (!is.finite(lo)) return(hi - c(8, 4, 2, 1, 0.25))\n  return(lo + c(0.05, 0.25, 1, 3, 8))\n}\n\n.ars_derivative <- function(f, x, domain) {\n  # A finite-difference derivative is adequate for the continuously\n  # differentiable densities normally used with ARS.\n  h <- 1e-5 * max(1, abs(x))\n  a <- if (is.finite(domain[1])) max(domain[1], x - h) else x - h\n  b <- if (is.finite(domain[2])) min(domain[2], x + h) else x + h\n  if (b <= a) stop(\"cannot calculate a derivative at this domain\")\n  ya <- .ars_eval_log_density(f, a, domain)\n  yb <- .ars_eval_log_density(f, b, domain)\n  if (!is.finite(ya) || !is.finite(yb)) stop(\"density is zero near an initial knot\")\n  (yb - ya) / (b - a)\n}\n\n.ars_check_concavity <- function(x, y, d, tolerance = 2e-3) {\n  keep <- is.finite(y) & is.finite(d)\n  if (sum(keep) < 3) stop(\"density has insufficient positive support for ARS\")\n  xx <- x[keep]; dd <- d[keep]\n  if (any(diff(dd) > tolerance * (1 + abs(dd[-length(dd)]))))\n    stop(\"density appears not to be log-concave\")\n  if (length(xx) >= 3) {\n    slopes <- diff(y[keep]) / diff(xx)\n    if (any(diff(slopes) > 5e-3 * (1 + abs(slopes[-length(slopes)]))))\n      stop(\"density appears not to be log-concave\")\n  }\n  invisible(TRUE)\n}\n\n.ars_hull <- function(x, y, d, domain) {\n  m <- length(x)\n  z <- numeric(m + 1L)\n  z[1] <- domain[1]\n  z[m + 1L] <- domain[2]\n  if (m > 1L) {\n    for (i in 1:(m - 1L)) {\n      den <- d[i] - d[i + 1L]\n      if (abs(den) < 1e-12) z[i + 1L] <- (x[i] + x[i + 1L]) / 2\n      else z[i + 1L] <- (y[i + 1L] - d[i + 1L] * x[i + 1L] -\n                           y[i] + d[i] * x[i]) / den\n    }\n  }\n  z[-1L] <- pmax(z[-1L], z[-length(z)] + 1e-12)\n  z[1] <- domain[1]; z[m + 1L] <- domain[2]\n  if (any(z[-1L] <= z[-length(z)])) stop(\"failed to construct ARS hull\")\n  list(bounds = z, slopes = d, intercepts = y - d * x)\n}\n\n.ars_interval_mass <- function(a, b, slope, intercept) {\n  # Integral of exp(intercept + slope*x), with stable handling of slope zero.\n  if (is.infinite(a) || is.infinite(b)) {\n    if ((is.infinite(a) && slope <= 0) || (is.infinite(b) && slope >= 0))\n      return(Inf)\n  }\n  if (abs(slope) < 1e-10) return(exp(intercept) * (b - a))\n  v <- exp(intercept + slope * a) * (-expm1(slope * (b - a))) / slope\n  if (!is.finite(v) || v <= 0) {\n    # Equivalent expression for large exponents.\n    v <- (exp(intercept + slope * b) - exp(intercept + slope * a)) / slope\n  }\n  v\n}\n\n.ars_draw_from_interval <- function(a, b, slope, intercept, u) {\n  if (abs(slope) < 1e-10) return(a + u * (b - a))\n  # Invert the truncated exponential using the endpoint with the smaller\n  # exponent to avoid overflow.\n  if (slope > 0) "]
[37.028912, "i", "{\n    eb <- exp(slope * (b - a))\n    a + log1p(u * (eb - 1)) / slope\n  } else {\n    a + log1p(-u * (1 - exp(slope * (b - a)))) / slope\n  }\n}\n\nars <- function(density_function, domain, n = sample_count) {\n  if (!is.function(density_function)) stop(\"density_function must be a function\")\n  .ars_validate_domain(domain)\n  if (length(n) != 1L || !is.numeric(n) || is.na(n) || !is.finite(n) || n < 0 || n != as.integer(n))\n    stop(\"n must be one nonnegative finite integer\")\n  n <- as.integer(n)\n  if (n == 0L) return(numeric(0))\n\n  knots <- sort(unique(.ars_initial_knots(domain)))\n  knots <- knots[knots > domain[1] & knots < domain[2]]\n  y <- .ars_eval_log_density(density_function, knots, domain)\n  if (any(!is.finite(y))) stop(\"density must be positive at initial knots\")\n  d <- vapply(knots, function(q) .ars_derivative(density_function, q, domain), numeric(1))\n  .ars_check_concavity(knots, y, d)\n\n  ans <- numeric(n); got <- 0L; iterations <- 0L\n  while (got < n) {\n    iterations <- iterations + 1L\n    if (iterations > 100000L) stop(\"ARS exceeded iteration limit; check the density\")\n    ord <- order(knots); knots <- knots[ord]; y <- y[ord]; d <- d[ord]\n    hull <- .ars_hull(knots, y, d, domain)\n    masses <- vapply(seq_along(d), function(i)\n      .ars_interval_mass(hull$bounds[i], hull$bounds[i + 1L], d[i], hull$intercepts[i]), numeric(1))\n    if (any(!is.finite(masses)) || sum(masses) <= 0 || !is.finite(sum(masses)))\n      stop(\"invalid or nonintegrable ARS envelope\")\n    k <- sample.int(length(masses), 1L, prob = masses)\n    x <- .ars_draw_from_interval(hull$bounds[k], hull$bounds[k + 1L], d[k], hull$intercepts[k], runif(1))\n    lx <- .ars_eval_log_density(density_function, x, domain)\n    ux <- hull$intercepts[k] + hull$slopes[k] * x\n    if (!is.finite(lx) || lx > ux + 1e-7) stop(\"density violates log-concavity or ARS envelope\")\n    if (log(runif(1)) <= lx - ux) {\n      got <- got + 1L; ans[got] <- x\n    } else {\n      # Rejection points refine the upper hull.\n      dy <- .ars_derivative(density_function, x, domain)\n      knots <- c(knots, x); y <- c(y, lx); d <- c(d, dy)\n      .ars_check_concavity(knots[order(knots)], y[order(knots)], d[order(knots)])\n    }\n  }\n  ans\n}\n\n.test_line <- function(name, ok, x) {\n  cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f)\\n\", name, if (ok) \"PASS\" else \"FAIL\", mean(x), sd(x)))\n  invisible(ok)\n}\n\ntest <- function() {\n  set.seed(2024)\n  z <- ars(function(x) dnorm(x), c(-Inf, Inf), 3000)\n  ok1 <- abs(mean(z)) < 0.12 && abs(sd(z) - 1) < 0.12\n  .test_line(\"NORMAL_SAMPLING\", ok1, z)\n  write.table(z, \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\n\n  e <- ars(function(x) dexp(x), c(0, Inf), 3000)\n  ok2 <- abs(mean(e) - 1) < 0.12 && abs(sd(e) - 1) < 0.12 && all(e >= 0)\n  .test_line(\"EXPONENTIAL_SAMPLING\", ok2, e)\n  write.table(e, \"/app/exponential_samples.txt\", row.names = FALSE, col.names = FALSE)\n\n  bad <- tryCatch({ ars(function(x) exp(-(x^2 - 1)^2), c(-3, 3), 10); FALSE }, error = function(e) TRUE)\n  cat(sprintf(\"NON_LOG_CONCAVE_REJECTION: %s (mean=NA, sd=NA)\\n\", if (bad) \"PASS\" else \"FAIL\"))\n  invalid <- tryCatch({ ars(dnorm, c(1, 0), 2); FALSE }, error = function(e) TRUE)\n  cat(sprintf(\"INPUT_VALIDATION: %s (mean=NA, sd=NA)\\n\", if (invalid) \"PASS\" else \"FAIL\"))\n  all(c(ok1, ok2, bad, invalid))\n}\nEOF\nRscript -e 'source(\"/app/ars.R\"); ok <- test(); if (!isTRUE(ok)) quit(status=1)'\nls -lh /app/ars.R /app/normal_samples.txt /app/exponential_samples.txt\n"]
