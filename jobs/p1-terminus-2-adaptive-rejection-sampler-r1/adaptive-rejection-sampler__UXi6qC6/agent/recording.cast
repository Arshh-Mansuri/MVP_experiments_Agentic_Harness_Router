[224.061056, "i", "cat > /app/ars.R <<'EOF'\n# Adaptive rejection sampler (Gilks, Wild & Gilks, 1992).\n# density_function must be vectorized and return nonnegative values.\n\n.ars_logf <- function(f, x, domain) {\n  if (any(x < domain[1] | x > domain[2])) stop(\"evaluation outside domain\")\n  v <- tryCatch(f(x), error=function(e) stop(\"density_function error: \", e$message))\n  if (!is.numeric(v) || length(v) != length(x) || anyNA(v) || any(v < 0) || any(is.nan(v)))\n    stop(\"density_function must return a nonnegative numeric vector of matching length\")\n  z <- rep(-Inf, length(v)); ii <- v > 0 & is.finite(v); z[ii] <- log(v[ii]); z\n}\n\n.ars_knots <- function(domain) {\n  a <- domain[1]; b <- domain[2]\n  if (is.finite(a) && is.finite(b)) return(a + (b-a)*c(.08,.25,.50,.75,.92))\n  if (!is.finite(a) && !is.finite(b)) return(c(-4,-1,0,1,4))\n  if (!is.finite(a)) return(b-c(8,4,2,1,.25))\n  a+c(.05,.25,1,3,8)\n}\n\n.ars_slope <- function(f, x, domain) {\n  h <- 1e-5*max(1,abs(x)); left <- max(domain[1],x-h); right <- min(domain[2],x+h)\n  if (right <= left) stop(\"cannot calculate numerical derivative\")\n  yl <- .ars_logf(f,left,domain); yr <- .ars_logf(f,right,domain)\n  if (!is.finite(yl) || !is.finite(yr)) stop(\"density must be positive near every knot\")\n  (yr-yl)/(right-left)\n}\n\n.ars_concave <- function(x,y,s) {\n  if (length(x)<3 || any(!is.finite(y)) || any(!is.finite(s))) stop(\"density has inadequate positive support\")\n  # Derivatives of a concave log density are nonincreasing.\n  if (any(diff(s) > .01*(1+abs(s[-length(s)])))) stop(\"density appears not to be log-concave\")\n  q <- diff(y)/diff(x)\n  if (length(q)>1 && any(diff(q) > .02*(1+abs(q[-length(q)])))) stop(\"density appears not to be log-concave\")\n  TRUE\n}\n\n.ars_hull <- function(x,y,s,domain) {\n  m <- length(x); z <- c(domain[1],rep(NA_real_,m-1),domain[2])\n  for (i in seq_len(m-1)) {\n    den <- s[i]-s[i+1]\n    z[i+1] <- if (abs(den)<1e-12) (x[i]+x[i+1])/2 else\n      (y[i+1]-s[i+1]*x[i+1]-y[i]+s[i]*x[i])/den\n  }\n  z <- cummax(z); z[1] <- domain[1]; z[m+1] <- domain[2]\n  if (any(diff(z)<=0)) stop(\"failed to construct ARS hull\")\n  list(z=z, slope=s, intercept=y-s*x)\n}\n\n.ars_logmass <- function(a,b,s,c) {\n  if (is.infinite(a) && s <= 0) return(-Inf)\n  if (is.infinite(b) && s >= 0) return(-Inf)\n  if (abs(s)<1e-9) return(c+log(b-a))\n  # factor at the finite/lower endpoint; this is stable for normal tails.\n  if (is.finite(a)) return(c+s*a+log(abs(expm1(s*(b-a))))-log(abs(s)))\n  c+s*b+log(abs(expm1(s*(a-b))))-log(abs(s))\n}\n\n.ars_draw <- function(a,b,s,u) {\n  if (abs(s)<1e-9) return(a+u*(b-a))\n  if (is.finite(a)) {\n    if (is.infinite(b)) return(a-log1p(-u)/s)\n    d <- s*(b-a)\n    if (s>0) return(a+log1p(u*expm1(d))/s)\n    return(a+log1p(-u*(1-exp(d)))/s)\n  }\n  # only possible for a=-Inf and s>0; use distance from b\n  b+log(u)/s\n}\n\nars <- function(density_function, domain, n=sample_count) {\n  if (!is.function(density_function)) stop(\"density_function must be a function\")\n  if (!is.numeric(domain) || length(domain)!=2 || anyNA(domain) || domain[1]>=domain[2])\n    stop(\"domain must be numeric length two with lower < upper\")\n  if (length(n)!=1 || !is.numeric(n) || !is.finite(n) || n<0 || n!=as.integer(n))\n    stop(\"n must be a nonnegative integer\")\n  n <- as.integer(n); if (!n) return(numeric())\n  x <- sort(unique(.ars_knots(domain))); y <- .ars_logf(density_function,x,domain)\n  s <- vapply(x,function(q) .ars_slope(density_function,q,domain),numeric(1))\n  .ars_concave(x,y,s)\n  out <- numeric(n); got <- 0L; iter <- 0L\n  while (got<n) {\n    iter <- iter+1L; if (iter>200000) stop(\"ARS iteration limit exceeded\")\n    o <- order(x); x<-x[o]; y<-y[o]; s<-s[o]; h <- .ars_hull(x,y,s,domain)\n    lm <- vapply(seq_along(s),function(i) .ars_logmass(h$z[i],h$z[i+1],s[i],h$intercept[i]),numeric(1))\n    if (all(!is.finite(lm))) stop(\"density has no usable integrable envelope\")\n    mx <- max(lm); pr <- exp(lm-mx); pr[!is.finite(pr)] <- 0; k <- sample.int(length(pr),1,prob=pr)\n    q <- .ars_draw(h$z[k],h$z[k+1],s[k],runif(1)); lq <- .ars_logf(density_function,q,domain)\n    uq <- h$intercept[k]+s[k]*q\n    if (!is.finite(lq) || lq>uq"]
[224.061945, "i", "+1e-6) stop(\"density violates the ARS upper hull; not log-concave\")\n    if (log(runif(1)) <= lq-uq) { got<-got+1L; out[got]<-q }\n    else { x<-c(x,q); y<-c(y,lq); s<-c(s,.ars_slope(density_function,q,domain)); .ars_concave(sort(x),y[order(x)],s[order(x)]) }\n  }\n  out\n}\n\nsample_count <- 100\n\n.test_result <- function(name,ok,z) cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f)\\n\",name,if(ok)\"PASS\" else \"FAIL\",mean(z),sd(z)))\n\ntest <- function() {\n  set.seed(12345)\n  z <- ars(function(x) dnorm(x),c(-Inf,Inf),3000)\n  ok1 <- abs(mean(z))<.12 && abs(sd(z)-1)<.12; .test_result(\"NORMAL_SAMPLING\",ok1,z)\n  write.table(z,\"/app/normal_samples.txt\",row.names=FALSE,col.names=FALSE)\n  e <- ars(function(x) dexp(x),c(0,Inf),3000)\n  ok2 <- abs(mean(e)-1)<.12 && abs(sd(e)-1)<.12 && all(e>=0); .test_result(\"EXPONENTIAL_SAMPLING\",ok2,e)\n  write.table(e,\"/app/exponential_samples.txt\",row.names=FALSE,col.names=FALSE)\n  bad <- tryCatch({ars(function(x) exp(-(x^2-1)^2),c(-3,3),10);FALSE},error=function(e)TRUE)\n  cat(sprintf(\"NON_LOG_CONCAVE_REJECTION: %s (mean=NA, sd=NA)\\n\",if(bad)\"PASS\" else \"FAIL\"))\n  inv <- tryCatch({ars(dnorm,c(1,0),1);FALSE},error=function(e)TRUE)\n  cat(sprintf(\"INPUT_VALIDATION: %s (mean=NA, sd=NA)\\n\",if(inv)\"PASS\" else \"FAIL\"))\n  isTRUE(all(c(ok1,ok2,bad,inv)))\n}\nEOF\nRscript -e 'source(\"/app/ars.R\"); ok<-test(); cat(\"ALL_TESTS:\",if(ok)\"PASS\" else \"FAIL\",\"\\n\"); if(!ok) quit(status=1)'\nls -lh /app/ars.R /app/normal_samples.txt /app/exponential_samples.txt\n"]
[224.064163, "o", "cat > /app/ars.R <<'EOF'\r\n\u001b[?2004l\r"]
[224.074046, "o", "\u001b[?2004h> # Adaptive rejection sampler (Gilks, Wild & Gilks, 1992).\r\n\u001b[?2004l\r\u001b[?2004h> # density_function must be vectorized and return nonnegative values.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_logf <- function(f, x, domain) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (any(x < domain[1] | x > domain[2])) stop(\"evaluation outside domain\")\r\n\u001b[?2004l\r\u001b[?2004h>   v <- tryCatch(f(x), error=function(e) stop(\"density_function error: \", e$message))\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.numeric(v) || length(v) != length(x) || anyNA(v) || any(v < 0) || any(is.nan(v)))\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"density_function must return a nonnegative numeric vector of matching length\")\r\n\u001b[?2004l\r\u001b[?2004h>   z <- rep(-Inf, length(v)); ii <- v > 0 & is.finite(v); z[ii] <- log(v[ii]); z\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_knots <- function(domain) {\r\n\u001b[?2004l\r\u001b[?2004h>   a <- domain[1]; b <- domain[2]\r\n\u001b[?2004l\r\u001b[?2004h>   if (is.finite(a) && is.finite(b)) return(a + (b-a)*c(.08,.25,.50,.75,.92))\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.finite(a) && !is.finite(b)) return(c(-4,-1,0,1,4))\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.finite(a)) return(b-c(8,4,2,1,.25))\r\n\u001b[?2004l\r\u001b[?2004h>   a+c(.05,.25,1,3,8)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_slope <- function(f, x, domain) {\r\n\u001b[?2004l\r\u001b[?2004h>   h <- 1e-5*max(1,abs(x)); left <- max(domain[1],x-h); right <- min(domain[2],x+h)\r\n\u001b[?2004l\r\u001b[?2004h>   if (right <= left) stop(\"cannot calculate numerical derivative\")\r\n\u001b[?2004l\r\u001b[?2004h>   yl <- .ars_logf(f,left,domain); yr <- .ars_logf(f,right,domain)\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.finite(yl) || !is.finite(yr)) stop(\"density must be positive near every knot\")\r\n\u001b[?2004l\r\u001b[?2004h>   (yr-yl)/(right-left)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> .ars_concave <- function(x,y,s) {\r\n\u001b[?2004l\rates the ARS upper hull; not log-concave\")\r\n    if (log(runif(1)) <= lq-uq) { got<-got+1L; out[got]<-q }\r\n    else { x<-c(x,q); y<-c(y,lq); s<-c(s,.ars_slope(density_function,q,domain)); .ars_concave(sort(x),y[order(x)],s[order(x)]) }\r\n  }\r\n  out\r\n}\r\n\r\nsample_count <- 100\r\n\r\n.test_result <- function(name,ok,z) cat(sprintf(\"%s: %s (mean=%.4f, sd=%.4f)\\n\",name,if(ok)\"PASS\" else \"FAIL\",mean(z),sd(z)))\r\n\r\ntest <- function() {\r\n  set.seed(12345)\r\n  z <- ars(function(x) dnorm(x),c(-Inf,Inf),3000)\r\n  ok1 <- abs(mean(z))<.12 && abs(sd(z)-1)<.12; .test_result(\"NORMAL_SAMPLING\",ok1,z)\r\n  write.table(z,\"/app/normal_samples.txt\",row.names=FALSE,col.names=FALSE)\r\n  e <- ars(function(x) dexp(x),c(0,Inf),3000)\r\n  ok2 <- abs(mean(e)-1)<.12 && abs(sd(e)-1)<.12 && all(e>=0); .test_result(\"EXPONENTIAL_SAMPLING\",ok2,e)\r\n  write.table(e,\"/app/exponential_samples.txt\",row.names=FALSE,col.names=FALSE)\r\n  bad <- tryCatch({ars(function(x) exp(-(x^2-1)^2),c(-3,3),10);FALSE},error=function(e)TRUE)\r\n  cat(sprintf(\"NON_LOG_CONCAVE_REJECTION: %s (mean=NA, sd=NA)\\n\",if(bad)\"PASS\" else \"FAIL\"))\r\n  inv <- tryCatch({ars(dnorm,c(1,0),1);FALSE},error=function(e)TRUE)\r\n  cat(sprintf(\"INPUT_VALIDATION: %s (mean=NA, sd=NA)\\n\",if(inv)\"PASS\" else \"FAIL\"))\r\n  isTRUE(all(c(ok1,ok2,bad,inv)))\r\n}\r\nEOF\r\nRscript -e 'sour\u001b[?2004h>   if (length(x)<3 || any(!is.finite(y)) || any(!is.finite(s))) stop(\"density has inadequate positive support\")\r\n\u001b[?2004l\r\u001b[?2004h>   # Derivatives of a concave log density are nonincreasing.\r\n\u001b[?2004l\r\u001b[?2004h>   if (any(diff(s) > .01*(1+abs(s[-length(s)])))) stop(\"density appears not to be log-concave\")\r\n\u001b[?2004l\r\u001b[?2004h>   q <- diff(y)/diff(x)\r\n\u001b[?2004l\r\u001b[?2004h>   if (length(q)>1 && any(diff(q) > .02*(1+abs(q[-length(q)])))) stop(\"density appears not to be log-concave\")"]
