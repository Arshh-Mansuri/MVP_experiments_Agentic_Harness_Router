[14.123907, "i", "cat > /app/run.py <<'PY'\nimport asyncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]],\n    max_concurrent: int,\n) -> None:\n    \"\"\"Run async job callables with a bound on concurrent execution.\n\n    If this function is cancelled, all started jobs are cancelled and awaited\n    before cancellation is propagated, so their cleanup code can run.\n    \"\"\"\n    if max_concurrent <= 0:\n        raise ValueError(\"max_concurrent must be greater than zero\")\n\n    semaphore = asyncio.Semaphore(max_concurrent)\n\n    async def run_one(task_factory: Callable[[], Awaitable[None]]) -> None:\n        async with semaphore:\n            await task_factory()\n\n    child_tasks = [asyncio.create_task(run_one(task)) for task in tasks]\n    try:\n        results = await asyncio.gather(*child_tasks, return_exceptions=True)\n    except asyncio.CancelledError:\n        for task in child_tasks:\n            if not task.done():\n                task.cancel()\n        await asyncio.gat"]
[14.125177, "i", "her(*child_tasks, return_exceptions=True)\n        raise\n\n    for result in results:\n        if isinstance(result, BaseException):\n            raise result\nPY\npython3 -m py_compile /app/run.py\npython3 - <<'PY'\nimport asyncio\nimport sys\nsys.path.insert(0, '/app')\nfrom run import run_tasks\n\nasync def main():\n    active = 0\n    peak = 0\n    cleaned = 0\n\n    async def job():\n        nonlocal active, peak, cleaned\n        active += 1\n        peak = max(peak, active)\n        try:\n            await asyncio.sleep(0.02)\n        finally:\n            active -= 1\n            cleaned += 1\n\n    await run_tasks([job for _ in range(5)], 2)\n    assert peak == 2 and cleaned == 5\n\n    async def cancellable():\n        nonlocal cleaned\n        try:\n            await asyncio.sleep(10)\n        finally:\n            cleaned += 1\n\n    runner = asyncio.create_task(run_tasks([cancellable, cancellable], 2))\n    await asyncio.sleep(0.01)\n    runner.cancel()\n    try:\n        await runner\n    except asyncio.CancelledError:\n        pass\n    a"]
