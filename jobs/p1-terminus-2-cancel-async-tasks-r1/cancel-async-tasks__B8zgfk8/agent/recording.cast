[21.79516, "i", "python3 -m py_compile /app/run.py && python3 - <<'PY'\nimport asyncio\nimport sys\nsys.path.insert(0, '/app')\nfrom run import run_tasks\n\nasync def main():\n    active = 0\n    peak = 0\n    cleaned = 0\n\n    async def job():\n        nonlocal active, peak, cleaned\n        active += 1\n        peak = max(peak, active)\n        try:\n            await asyncio.sleep(0.01)\n        finally:\n            active -= 1\n            cleaned += 1\n\n    await run_tasks([job] * 6, 2)\n    assert peak == 2\n    assert cleaned == 6\n\n    async def long_job():\n        nonlocal cleaned\n        try:\n            await asyncio.sleep(10)\n        finally:\n            cleaned += 1\n\n    pending = asyncio.create_task(run_tasks([long_job, long_job], 2))\n    await asyncio.sleep(0.02)\n    pending.cancel()\n    try:\n        await pending\n    except asyncio.CancelledError:\n        pass\n    assert cleaned == 8\n\nasyncio.run(main())\nprint('validation ok')\nPY\n"]
