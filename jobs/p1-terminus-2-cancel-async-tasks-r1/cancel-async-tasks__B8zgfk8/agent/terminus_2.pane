python3 - <<'PY'
import asyncio
import sys
sys.path.insert(0, '/app')
from run import run_tasks

async def main():
    active = 0
    peak = 0
    cleaned = 0

    async def job():
        nonlocal active, peak, cleaned
        active += 1
        peak = max(peak, active)
        try:
            await asyncio.sleep(0.02)
        finally:
            active -= 1
            cleaned += 1

    await run_tasks([job for _ in range(5)], 2)
    assert peak == 2 and cleaned == 5

    async def cancellable():
        nonlocal cleaned
        try:
            await asyncio.sleep(10)
        finally:
            cleaned += 1

    runner = asyncio.create_task(run_tasks([cancellable, cancellable], 2))
    await asyncio.sleep(0.01)
    runner.cancel()
    try:
        await runner
    except asyncio.CancelledError:
        pass
    assert cleaned == 7

asyncio.run(main())
print('ok')
