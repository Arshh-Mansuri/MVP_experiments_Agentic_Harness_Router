[89.253653, "o", "/*\r\n * Common code for the BitLocker format.\r\n */\r\n\r\n#include \"arch.h\"\r\n#include \"misc.h\"\r\n#include \"common.h\"\r\n#include \"bitlocker_common.h\"\r\n#include \"hmac_sha.h\"\r\n#include \"johnswap.h\"\r\n\r\nunsigned int bitlocker_common_iteration_count(void *salt)\r\n{\r\n\tbitlocker_custom_salt *cs = salt;\r\n\r\n\treturn (unsigned int) cs->iterations;\r\n}\r\n"]
