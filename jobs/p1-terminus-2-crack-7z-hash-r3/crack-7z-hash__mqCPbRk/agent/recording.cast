[47.113754, "o", "#!/usr/bin/env perl\r\n\r\nuse warnings;\r\n\r\n$i=1;\r\n\r\nwhile(<>) {\r\n\tchomp;\r\n\tif(/^$/) {\r\n\t\tif($object{\"uid\"} ne \"\") {\r\n\t\t\tprint $object{\"uid\"}.\":\";\r\n\t\t\tprint $object{\"userPassword\"} ne \"\" ? $object{\"userPassword\"} : \"*\";\r\n\t\t\tprint \":\";\r\n\t\t\tprint $i.\":\";\r\n\t\t\tprint $i.\":\";\r\n\t\t\tprint $object{\"cn\"}.\":\";\r\n\t\t\tprint $object{\"homeDirectory\"} ne \"\" ? $object{\"homeDirectory\"} : \"/\";\r\n\t\t\tprint \":/bin/sh\\n\";\r\n\t\t}\r\n\t\t%object = ();\r\n\t\t$i++;\r\n\t\tnext;\r\n\t}\r\n\r\n\t($lhs, $rhs) = split(/: /);\r\n\t$object{$lhs} = $rhs;\r\n}\r\n"]
