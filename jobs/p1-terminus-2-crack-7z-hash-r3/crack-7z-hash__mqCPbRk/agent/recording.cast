[41.8369, "o", "# NOTE, same format as dynamic_0  It is slower (50% slower, or more).  But it is not limited to 55 byte passwords.\r\n# This should work for passwords up to 110 bytes long (max length dynamic will currently allow). It should not be\r\n# used for shorter passwords (under 55 bytes).  Use dyna_0 for those.\r\n[List.Generic:dynamic_2000]\r\nExpression=md5($p) (PW > 55 bytes)\r\nFlag=MGF_FLAT_BUFFERS\r\nFlag=MGF_KEYS_INPUT\r\nFlag=MGF_SOURCE\r\nFlag=MGF_POOR_OMP\r\nMaxInputLenX86=110\r\nMaxInputLen=110\r\n"]
[41.837329, "o", "Func=DynamicFunc__MD5_crypt"]
[41.838862, "o", "\r\n"]
