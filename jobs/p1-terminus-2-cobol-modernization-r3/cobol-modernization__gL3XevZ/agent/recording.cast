[92.267791, "i", "set -e\nrm -rf /tmp/final-original; mkdir -p /tmp/final-original/data; cp /app/data/*.DAT /tmp/final-original/data/; cp /app/src/INPUT.DAT /tmp/final-original/INPUT.DAT\ncp /tmp/bookforum-ref/data/*.DAT /app/data/\nprintf 'U001U002B001200\\n' > /app/src/INPUT.DAT\ncd /app && python3 program.py\npython3 - <<'PY'\nfrom pathlib import Path\nok=True\nfor n in ('ACCOUNTS.DAT','BOOKS.DAT','TRANSACTIONS.DAT'):\n    a=(Path('/app/data')/n).read_bytes()\n    b=(Path('/tmp/bookforum-success/data')/n).read_bytes()\n    print(n, 'MATCH' if a==b else 'DIFFER')\n    ok &= a==b\nassert ok\nPY\ncp /tmp/final-original/data/*.DAT /app/data/\ncp /tmp/final-original/INPUT.DAT /app/src/INPUT.DAT\n"]
[92.267922, "o", "set -e\r\nrm -rf /tmp/final-original; mkdir -p /tmp/final-original/data; cp /app/data/*.DAT /tmp/final-original/data/; cp /app/src/INPUT.DAT /tmp/final-original/INPUT.DAT\r\ncp /tmp/bookforum-ref/data/*.DAT /app/data/\r\nprintf 'U001U002B001200\\n' > /app/src/INPUT.DAT\r\ncd /app && python3 program.py\r\npython3 - <<'PY'\r\nfrom pathlib import Path\r\nok=True\r\nfor n in ('ACCOUNTS.DAT','BOOKS.DAT','TRANSACTIONS.DAT'):\r\n    a=(Path('/app/data')/n).read_bytes()\r\n    b=(Path('/tmp/bookforum-success/data')/n).read_bytes()\r\n    print(n, 'MATCH' if a==b else 'DIFFER')\r\n    ok &= a==b\r\nassert ok\r\nPY\r\ncp /tmp/final-original/data/*.DAT /app/data/\r\ncp /tmp/final-original/INPUT.DAT /app/src/INPUT.DAT\r\n"]
