[91.974014, "i", "cd /app && python3 - <<'PY'\np='program.py'\ns=open(p).read()\ns=s.replace(\"    raw = INPUT.read_bytes()\\n    # The COBOL input record\", \"    raw = INPUT.read_bytes().rstrip(b'\\\\r\\\\n')\\n    if not raw:\\n        print('Error: Input file is empty')\\n        return\\n    # The COBOL input record\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/program.py\n"]
[91.976576, "o", "cd /app && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='program.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"    raw = INPUT.read_bytes()\\n    # The COBOL input record\", \"    raw = INPUT.read_bytes().rstrip(b'\\\\r\\\\n')\\n    if not raw:\\n        print('Error: Input file is empty')\\n        return\\n    # The COBOL input record\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
