[35.292403, "i", "cd /app && cat > program.py <<'PY'\n#!/usr/bin/env python3\nfrom pathlib import Path\n\nBASE = Path('/app')\nDATA = BASE / 'data'\nINPUT = BASE / 'src' / 'INPUT.DAT'\n\n\ndef records(path, width):\n    data = path.read_bytes()\n    return [bytearray(data[i:i + width]) for i in range(0, len(data), width)]\n\n\ndef main():\n    raw = INPUT.read_bytes()\n    # The COBOL input record is fixed-width, but the supplied files may omit\n    # trailing spaces.  Missing bytes therefore behave as blank fields.\n    raw = raw[:22].ljust(22, b' ')\n    buyer = raw[0:4]\n    seller = raw[4:8]\n    book_id = raw[8:12]\n    amount_raw = raw[12:22]\n    try:\n        amount = int(amount_raw.decode('ascii').strip() or '0')\n    except ValueError:\n        amount = 0\n\n    account_path = DATA / 'ACCOUNTS.DAT'\n    book_path = DATA / 'BOOKS.DAT'\n    transaction_path = DATA / 'TRANSACTIONS.DAT'\n    accounts = records(account_path, 34)\n    books = records(book_path, 28)\n\n    buyer_found = any(r[0:4] == buyer for r in accounts)\n    seller_found = any(r[0:4] =="]
[35.292542, "o", "cd /app && cat > program.py <<'PY'\r\n#!/usr/bin/env python3\r\nfrom pathlib import Path\r\n\r\nBASE = Path('/app')\r\nDATA = BASE / 'data'\r\nINPUT = BASE / 'src' / 'INPUT.DAT'\r\n\r\n\r\ndef records(path, width):\r\n    data = path.read_bytes()\r\n    return [bytearray(data[i:i + width]) for i in range(0, len(data), width)]\r\n\r\n\r\ndef main():\r\n    raw = INPUT.read_bytes()\r\n    # The COBOL input record is fixed-width, but the supplied files may omit\r\n    # trailing spaces.  Missing bytes therefore behave as blank fields.\r\n    raw = raw[:22].ljust(22, b' ')\r\n    buyer = raw[0:4]\r\n    seller = raw[4:8]\r\n    book_id = raw[8:12]\r\n    amount_raw = raw[12:22]\r\n    try:\r\n        amount = int(amount_raw.decode('ascii').strip() or '0')\r\n    except ValueError:\r\n        amount = 0\r\n\r\n    account_path = DATA / 'ACCOUNTS.DAT'\r\n    book_path = DATA / 'BOOKS.DAT'\r\n    transaction_path = DATA / 'TRANSACTIONS.DAT'\r\n    accounts = records(account_path, 34)\r\n    books = records(book_path, 28)\r\n\r\n    buyer_found = any(r[0:4] == buyer for r in accounts"]
[35.292653, "i", " seller for r in accounts)\n    matching_books = [r for r in books if r[0:4] == book_id]\n    book_found = bool(matching_books)\n    valid_owner = any(r[24:28] == seller for r in matching_books)\n\n    if not (buyer_found and seller_found and book_found and valid_owner):\n        print('Transaction failed due to validation errors')\n        return\n\n    for r in accounts:\n        account_id = bytes(r[0:4])\n        if account_id == buyer or account_id == seller:\n            balance = int(bytes(r[24:34]).decode('ascii'))\n            if account_id == buyer:\n                balance -= amount\n            if account_id == seller:\n                balance += amount\n            r[24:34] = f'{balance:010d}'.encode('ascii')\n    account_path.write_bytes(b''.join(accounts))\n\n    for r in books:\n        if bytes(r[0:4]) == book_id:\n            r[24:28] = buyer\n    book_path.write_bytes(b''.join(books))\n\n    transaction = book_id + f'{amount:010d}'.encode('ascii') + seller + buyer\n    with transaction_path.open('ab') as f:\n        "]
