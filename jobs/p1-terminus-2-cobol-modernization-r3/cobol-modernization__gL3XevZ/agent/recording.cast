[80.957558, "i", "set -e\nrm -rf /tmp/app-original; mkdir -p /tmp/app-original/data; cp /app/data/*.DAT /tmp/app-original/data/; cp /app/src/INPUT.DAT /tmp/app-original/INPUT.DAT\ncp /tmp/bookforum-success/data/*.DAT /app/data/\nprintf 'U001U002B001200' > /app/src/INPUT.DAT\ncd /app && python3 program.py\npython3 - <<'PY'\nfrom pathlib import Path\nok = True\nfor name in ('ACCOUNTS.DAT','BOOKS.DAT','TRANSACTIONS.DAT'):\n    got = (Path('/app/data') / name).read_bytes()\n    ref = (Path('/tmp/bookforum-success/data') / name).read_bytes()\n    same = got == ref\n    print(name, 'MATCH' if same else 'DIFFER', len(got), len(ref))\n    ok &= same\nraise SystemExit(0 if ok else 1)\nPY\n"]
