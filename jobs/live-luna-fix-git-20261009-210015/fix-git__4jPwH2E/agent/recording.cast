[75.02909, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K"]
[75.029118, "o", "\u001b[H\u001b[J\u001b[H                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-SPACE         *  Forward  one windo"]
[75.029124, "o", "w, but don't stop"]
[75.029416, "o", " at end-of-file.\u001b[m\r\n  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Default \"window\" is the screen height.\u001b[m\r\n        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                          \u001b[1mSEARCHING\u001b["]
[75.029449, "o", "0m\u001b[m\r\n\u001b[m\r\n  /\u001b["]
[75.030015, "o", "4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[H\u001b[J\u001b[H  N                 *  Repeat previous search in reverse direction.\u001b[m\r\n  ESC-n             *  Repeat previous search, spanning files.\u001b[m\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\u001b[m\r\n  ESC-u                Undo (toggle) search highlighting.\u001b[m\r\n  ESC-U                Clear search highlighting.\u001b[m\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A sea"]
[75.0302, "o", "rch pattern may begin with one or more of:\u001b[m\r\n        ^N or !  Search for NON-matching lines.\u001b[m\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\u001b[m\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\u001b[m\r\n        ^K       Highlight matches, but don't move (KEEP position).\u001b[m\r\n        ^R       Don't use REGULAR EXPRESSIONS.\u001b[m\r\n        ^W       WRAP search if no match found.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mJUMPING\u001b[0m\u001b[m\r\n\u001b[m\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\u001b[m\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\u001b[m\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m-th) previous tag.\u001b[m\r\n  {  (  [           *  Find close bracket } ) ].\u001b[m\r\n  }  )  ]           *  Find open bracket { ( [.\u001b["]
[75.030229, "o", "m\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\u001b[m\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Each \"find close bracket\" command goes forward to the close bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\u001b[m\r\n        Each \"find open bracket\" command goes backward to the open bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\u001b[m\r\n\u001b[m\r\n  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\u001b[m\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\u001b[m\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\u001b[m\r\n  ''                   Go to the previous position.\u001b[m\r\n  ^X^X                 Same as '.\u001b[m\r\n  ESC-M\u001b[4m<letter>\u001b[24m        Clear a mark.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[K--\u001b[Kn\bn\u001b[Ko\bo\u001b[K-\b-\u001b[Kf\bf\u0007\u001b[Kf\bf\u0007\u001b[K \b \u0007\u001b[Kr"]
[75.030236, "o", "\br\u0007\u001b[Ke\be\u0007\u001b[Kc\bc\u0007\u001b[Ko\bo\u0007\u001b[Kv\bv\u0007\u001b[Ke\be\u0007\u001b[Kr\br\u0007\u001b[Ke\be\u0007\u001b[Kd\bd\u0007\u001b[K-\b-\u0007\u001b[Kc\bc\u0007\u001b[Kh\bh\u0007\u001b[Ka\ba\u0007\u001b[Kn\bn\u0007\u001b[Kg\bg\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[K \b \u0007\u001b[K-\b-\u0007\u001b[Km\bm\u0007\u001b[K \b \u0007\u001b[K\"\b\"\u0007\u001b[KM\bM\u0007\u001b[Ke\be\u0007\u001b[Kr\br\u0007\u001b[Kg\bg\u0007\u001b[Ke\be\u0007\u001b[K \b \u0007\u001b[Kr\br\u0007\u001b[Ke\be\u0007\u001b[Kc\bc\u0007\u001b[Ko\bo\u0007\u001b[Kv\bv\u0007\u001b[Ke\be\u0007\u001b[Kr\br\u0007\u001b[Ke\be\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[KS\bS\u0007\u001b[Kt\bt\u0007\u001b[Ka\ba\u0007\u001b[Kn\bn\u0007\u001b[Kf\bf\u0007\u001b[Ko\bo\u0007\u001b[Kr\br\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[Kc\bc\u0007\u001b[Kh\bh\u0007\u001b[Ka\ba\u0007\u001b[Kn\bn\u0007\u001b[Kg\bg\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[K\"\b\"\u0007"]
