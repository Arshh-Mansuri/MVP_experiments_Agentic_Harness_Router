[93.045974, "o", "\u001b[H\u001b[J\u001b[H\u001b[31m-                            {% if pub.author contains \"Michael Merrill\" %} \u001b[m\u001b[m\r\n\u001b[31m-                                {% assign a = pub.author | split: 'Michael Merrill' %} \u001b[m\u001b[m\r\n\u001b[31m-                                {{a[0]}}<span class=\"author\">Michael Merrill</span>{{a[1]}} \u001b[m\u001b[m\r\n\u001b[31m-                            {% elsif pub.author contains \"Mike A. Merrill*\" %} \u001b[m\u001b[m\r\n\u001b[31m-                                {% assign a = pub.author | split: 'Mike A. Merrill' %} \u001b[m\u001b[m\r\n\u001b[31m-                                {{a[0]}}<span class=\"author\">Mike A. Merrill*</span>{{a[1]}} \u001b[m\u001b[m\r\n\u001b[31m-                            {% elsif pub.author contains \"Mike A. Merrill\" %} \u001b[m\u001b[m\r\n\u001b[31m-                                {% assign a = pub.author | split: 'Mike A. Merrill' %} \u001b[m\u001b[m\r\n\u001b[31m-                                {{a[0]}}<span class=\"author\">Mike A. Merrill</span>{{a[1]}} \u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                            {% if pub.author contains \"Michael Merrill\" %}\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m         "]
