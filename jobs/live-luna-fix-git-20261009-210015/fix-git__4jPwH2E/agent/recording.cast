[28.431645, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[Klog file: \u001b[Kw\bw\u001b[Ki\bi\u001b[Kt\bt\u001b[Kc\bc\u001b[Kh\bh\u001b[K \b \u001b[Km\bm\u001b[Ka\ba\u001b[Ks\bs\u001b[Kt\bt\u001b[Ke\be\u001b[Kr\br\r\u001b[K\r\u001b[K\u001b[7mLog file is already in use  (press RETURN)\u001b[27m"]
