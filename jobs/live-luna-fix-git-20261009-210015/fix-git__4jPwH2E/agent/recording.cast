[66.044197, "o", "\u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H\r\u001b[KOverwrite, Append, Don't log, or Quit? (Type \"O\", \"A\", \"D\" or \"Q\") \u001b[40;1H"]
