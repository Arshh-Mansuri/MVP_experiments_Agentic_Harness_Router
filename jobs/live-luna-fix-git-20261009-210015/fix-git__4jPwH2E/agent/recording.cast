[50.136415, "o", "\bg\u001b[Ke\be\u001b[Ks\bs\u001b[K \b \u001b[Kc\bc\u001b[K4\b4\u001b[K9\b9\u001b[K9\b9\u001b[K7\b7\u001b[K3\b3\u001b[K0\b0\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Ks\bs\u001b[Kw\bw\u001b[Ki\bi\u001b[Kt\bt\u001b[Kc\bc\u001b[Kh\bh\u001b[K \b \u001b[Km\bm\u001b[Ka\ba\u001b[Ks\bs\u001b[Kt\bt\u001b[Ke\be\u001b[Kr\br\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[KG\bG\u001b[KI\bI\u001b[KT\bT\u001b[K_\b_\u001b[KP\bP\u001b[KA\bA\u001b[KG\bG\u001b[KE\bE\u001b[KR\bR\u001b[K=\b=\u001b[Kc\bc\u001b[Ka\ba\u001b[Kt\bt\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Km\bm\u001b[Ke\be\u001b[Kr\br\u001b[Kg\bg\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kn\bn\u001b[Ko\bo\u001b[K-\b-\u001b[Kf\bf\u001b[Kf\bf\u001b[K \b \u001b[Kr\br\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kv\bv\u001b[Ke\be\u001b[Kr\br\u001b[Ke\be\u001b[Kd\bd\u001b[K-\b-\u001b[Kc\bc\u001b[Kh\bh\u001b[Ka\ba\u001b[Kn\bn\u001b[Kg\bg\u001b[Ke\be\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[Km\bm\u001b[K \b \u001b[K\"\b\"\u001b[KM\bM\u001b[Ke\be\u001b[Kr\br\u001b[Kg\bg\u001b[Ke\be\u001b[K \b \u001b[Kr\br\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kv\bv\u001b[Ke\be\u001b[Kr\br\u001b[Ke\be\u001b[Kd\bd\u001b[K \b \u001b[KS\bS\u001b[Kt\bt\u001b[Ka\ba\u001b[Kn\bn\u001b[Kf\bf\u001b[Ko\bo\u001b[Kr\br\u001b[Kd\bd\u001b[K \b \u001b[Kc\bc\u001b[K\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[KAGER=cat git merge --no-ff recovered-changes -m \"Merge recovered Stanford ch\bh\u001b[Ka\ba\u001b[Kn\bn\u001b[Kg\bg\u001b[Ke\be\u001b[Ks\bs\u001b[K\"\b\"\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[KG\bG\u001b[KI\bI\u001b[KT\bT\u001b[K_\b_\u001b[KP\bP\u001b[KA\bA\u001b[