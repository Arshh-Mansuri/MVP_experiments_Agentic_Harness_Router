[127.830961, "o", "\u001b[40;1H\u001b[K\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-"]
[127.831183, "o", "\r\u001b[K\u001b[7mRepaint by scrolling from bottom of screen  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K"]
