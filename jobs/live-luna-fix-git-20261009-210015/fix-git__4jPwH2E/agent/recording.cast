[13.14103, "o", "\u001b[K\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[Krge recovered Stanford changes\" && git status --short --branch && git log -\b-\u001b[K-\b-\u001b[Ko\bo\u001b[Kn\bn\u001b[Ke\be\u001b[Kl\bl\u001b[Ki\bi\u001b[Kn\bn\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kd\bd\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kr\br\u001b[Ka\ba\u001b[Kt\bt\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kg\bg\u001b[Kr\br\u001b[Ka\ba\u001b[Kp\bp\u001b[Kh\bh\u001b[K \b \u001b[K-\b-\u001b[K5\b5\r\u001b[K"]
