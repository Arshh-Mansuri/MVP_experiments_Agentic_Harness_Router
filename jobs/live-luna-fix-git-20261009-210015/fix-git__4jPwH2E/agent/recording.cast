[43.096362, "o", "\u001b[Ke\be"]
[43.096395, "o", "\u001b[Kd\bd\u001b[K \b \u001b[KS\bS\u001b[Kt\bt\u001b[Ka\ba\u001b[Kn\bn\u001b[Kf\bf\u001b[Ko\bo\u001b[Kr\br\u001b[Kd\bd\u001b[K \b \u001b[Kc\bc\u001b[Kh\bh\u001b[Ka\ba\u001b[Kn\bn\u001b[Kg\bg\u001b[Ke\be\u001b[Ks\bs\u001b[K\"\b\"\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[KG\bG\u001b[KI\bI\u001b[KT\bT\u001b[K_\b_\u001b[KP\bP\u001b[KA\bA\u001b[KG\bG\u001b[KE\bE\u001b[KR\bR\u001b[K=\b=\u001b[Kc\bc\u001b[Ka\ba\u001b[Kt\bt\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Ks\bs\u001b[Kt\bt\u001b[Ka\ba"]
[43.096583, "o", "\u001b[Kt\bt\u001b[Ku\bu\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ks\bs\u001b[Kh\bh\u001b[Ko\bo\u001b[Kr\br\u001b[Kt\bt\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kb\bb\u001b[Kr\br"]
[43.096611, "o", "\u001b[Ka\ba\u001b[Kn\bn\u001b[K\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[Krge recovered Stanford changes\" && GIT_PAGER=cat git status --short --branc\bc\u001b[Kh\bh\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[KG\bG\u001b[KI\bI\u001b[KT\bT\u001b[K_\b_\u001b[KP\bP\u001b[KA\bA\u001b[KG\bG\u001b[KE\bE\u001b[KR\bR\u001b[K=\b=\u001b[Kc\bc\u001b[Ka\ba\u001b[Kt\bt\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Kl\bl\u001b[Ko\bo\u001b[Kg\bg\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ko\bo\u001b[Kn\bn\u001b[Ke\be\u001b[Kl\bl\u001b[Ki\bi\u001b[Kn\bn\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kd\bd\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kr\br\u001b[Ka\ba\u001b[Kt\bt\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kg\bg\u001b[Kr\br\u001b[Ka\ba\u001b[Kp\bp\u001b[Kh\bh\u001b[K \b \u001b[K-\b-\u001b[K6\b6\r\u001b[K\r\u001b[K\u001b[7mLog file is already in use  (press RETURN)\u001b[27m"]
[49.642764, "i", "C-c\n"]
[49.643824, "o", "\u001b[40;1H\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[K\u001b[7mRepaint by scrolling from bottom of screen  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K"]
[50.129444, "i", "GIT_PAGER=cat git branch -f recovered-changes c499730 && git switch master && GIT_PAGER=cat git merge --no-ff recovered-changes -m \"Merge recovered Stanford changes\" && GIT_PAGER=cat git status --short --branch && GIT_PAGER=cat git log --oneline --decorate --graph -6\n"]
[50.130363, "o", "\r\u001b[K"]
[50.135086, "o", "...skipping...\r\n                --no-histdups\u001b[m\r\n                  Remove duplicates from command history.\u001b[m\r\n                --rscroll=C\u001b[m\r\n                  Set the character used to mark truncated lines.\u001b[m\r\n                --save-marks\u001b[m\r\n                  Retain marks across invocations of less.\u001b[m\r\n                --status-col-width=N\u001b[m\r\n                  Set the width of the -J status column to N characters.\u001b[m\r\n                --use-backslash\u001b[m\r\n                  Subsequent options use backslash as escape char.\u001b[m\r\n                --use-color\u001b[m\r\n                  Enables colored text.\u001b[m\r\n                --wheel-lines=N\u001b[m\r\n                  Each click of the mouse wheel moves N lines.\u001b[m\r\n\u001b[m\r\n\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                          \u001b[1mLINE\u001b[0m \u001b[1mEDITING\u001b[0m\u001b[m\r\n\u001b[m\r\n        These keys can be used to edit text being entered \u001b[m\r\n        on the \"command line\" at the bottom of the screen.\u001b[m\r\n\u001b[m\r\n RightArrow ......."]
[50.135524, "o", ".............. ESC-l ... Move cursor right one character.\u001b[m\r\n LeftArrow ...................... ESC-h ... Move cursor left one character.\u001b[m\r\n ctrl-RightArrow  ESC-RightArrow  ESC-w ... Move cursor right one word.\u001b[m\r\n ctrl-LeftArrow   ESC-LeftArrow   ESC-b ... Move cursor left one word.\u001b[m\r\n HOME ........................... ESC-0 ... Move cursor to start of line.\u001b[m\r\n END ............................ ESC-$ ... Move cursor to end of line.\u001b[m\r\n BACKSPACE ................................ Delete char to left of cursor.\u001b[m\r\n DELETE ......................... ESC-x ... Delete char under cursor.\u001b[m\r\n ctrl-BACKSPACE   ESC-BACKSPACE ........... Delete word to left of cursor.\u001b[m\r\n ctrl-DELETE .... ESC-DELETE .... ESC-X ... Delete word under cursor.\u001b[m\r\n ctrl-U ......... ESC (MS-DOS only) ....... Delete entire line.\u001b[m\r\n UpArrow ........................ ESC-k ... Retrieve previous command line.\u001b[m\r\n DownArrow ...................... ESC-j ... Retrieve next command line.\u001b[m\r\n TAB ...................................... Com"]
