[90.009475, "i", "cat > eval.scm <<'EOF'\n;; Metacircular evaluator for interp.py\n\n(define (caar x) (car (car x)))\n(define (cadr x) (car (cdr x)))\n(define (caddr x) (car (cdr (cdr x))))\n(define (cddr x) (cdr (cdr x)))\n(define (cdar x) (cdr (car x)))\n(define (cadddr x) (car (cdr (cdr (cdr x)))))\n\n(define (my-list . xs) xs)\n\n;; An environment is a list of mutable frames.  Each frame starts with a\n;; dummy binding so that new bindings can be inserted with set-cdr!.\n(define (new-frame) (cons (cons '__dummy__ #f) '()))\n(define (new-env) (cons (new-frame) '()))\n\n(define (frame-find name frame)\n  (if (null? (cdr frame))\n      #f\n      (if (eq? name (car (car (cdr frame))))\n          (car (cdr frame))\n          (frame-find name (cdr frame)))))\n\n(define (find-binding name env)\n  (if (null? env)\n      #f\n      (let ((b (frame-find name (car env))))\n        (if b b (find-binding name (cdr env))))))\n\n(define (lookup name env)\n  (let ((b (find-binding name env)))\n    (if b (cdr b) (cons 'primitive name))))\n\n(define (define-in-frame name val"]
