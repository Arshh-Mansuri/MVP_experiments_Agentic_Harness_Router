[51.245665, "o", "    return env\r\n\r\n\r\ndef run_file(filename):\r\n    env = make_global_env()\r\n\r\n    with open(filename, \"r\") as f:\r\n        content = f.read()\r\n\r\n    tokens = tokenize(content)\r\n    index = 0\r\n\r\n    while index < len(tokens):\r\n        try:\r\n            # Parse one complete expression\r\n            expr, new_index = parse_expr(tokens, index)\r\n            index = new_index\r\n\r\n            # Evaluate it\r\n            eval_expr(expr, env)\r\n\r\n            # Don't print results - only display/newline should print\r\n            pass\r\n\r\n        except SchemeError as e:\r\n            print(f\"Error: {e}\")\r\n            break\r\n\r\n        except Exception as e:\r\n            print(f\"Unexpected error: {e}\")\r\n            break\r\n\r\n\r\ndef parse_expr(tokens, index):\r\n    if index >= len(tokens):\r\n        raise SchemeError(\"Unexpected end of input\")\r\n\r\n    token = tokens[index]\r\n\r\n    if token == \"(\":\r\n        index += 1\r\n        elements = []\r\n"]
