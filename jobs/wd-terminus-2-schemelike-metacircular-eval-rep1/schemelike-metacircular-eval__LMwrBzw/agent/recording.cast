[90.010171, "i", "    (cons (evaluate (car xs) env)\n            (eval-list (cdr xs) env))))\n\n(define (apply-value proc args)\n  (if (closure? proc)\n      (sequence (caddr proc) (extend (cadr proc) args (cadddr proc)))\n      (if (primitive? proc)\n          (apply-primitive (cdr proc) args)\n          #f)))\n\n(define (apply-primitive name a)\n  (cond\n    ((eq? name '+) (+ (car a) (cadr a)))\n    ((eq? name '-) (- (car a) (cadr a)))\n    ((eq? name '*) (* (car a) (cadr a)))\n    ((eq? name '/) (/ (car a) (cadr a)))\n    ((eq? name '%) (% (car a) (cadr a)))\n    ((eq? name '=) (= (car a) (cadr a)))\n    ((eq? name '<) (< (car a) (cadr a)))\n    ((eq? name '>) (> (car a) (cadr a)))\n    ((eq? name '<=) (<= (car a) (cadr a)))\n    ((eq? name '>=) (>= (car a) (cadr a)))\n    ((eq? name 'cons) (cons (car a) (cadr a)))\n    ((eq? name 'car) (car (car a)))\n    ((eq? name 'cdr) (cdr (car a)))\n    ((eq? name 'null?) (null? (car a)))\n    ((eq? name 'pair?) (pair? (car a)))\n    ((eq? name 'number?) (number? (car a)))\n    ((eq? name 'symbol?) (symbol? (car"]
[90.010188, "i", " a)))\n    ((eq? name 'string?) (string? (car a)))\n    ((eq? name 'eq?) (eq? (car a) (cadr a)))\n    ((eq? name 'equal?) (equal? (car a) (cadr a)))\n    ((eq? name 'not) (if (car a) #f #t))\n    ((eq? name 'display) (display (car a)))\n    ((eq? name 'newline) (newline))\n    ((eq? name 'read) (read))\n    ((eq? name 'set-car!) (set-car! (car a) (cadr a)))\n    ((eq? name 'set-cdr!) (set-cdr! (car a) (cadr a)))\n    ((eq? name 'fopen) (fopen (car a) (cadr a)))\n    ((eq? name 'fclose) (fclose (car a)))\n    ((eq? name 'fread) (fread (car a)))\n    ((eq? name 'fgetchr) (fgetchr (car a)))\n    ((eq? name 'fputchr) (fputchr (car a) (cadr a)))\n    ((eq? name 'fdisplay) (fdisplay (car a) (cadr a)))\n    (else #f)))\n\n(define (evaluate-cond clauses env)\n  (if (null? clauses) #f\n      (if (eq? (caar clauses) 'else)\n          (sequence (cdar clauses) env)\n          (if (evaluate (caar clauses) env)\n              (sequence (cdar clauses) env)\n              (evaluate-cond (cdr clauses) env)))))\n\n(define (evaluate x env)\n  (cond\n    ("]
[90.011856, "i", "(number? x) x)\n    ((string? x) x)\n    ((eq? x #t) #t)\n    ((eq? x #f) #f)\n    ((symbol? x) (lookup x env))\n    ((null? x) '())\n    ((eq? (car x) 'quote) (cadr x))\n    ((eq? (car x) 'if)\n     (if (evaluate (cadr x) env)\n         (evaluate (caddr x) env)\n         (evaluate (cadddr x) env)))\n    ((eq? (car x) 'begin) (sequence (cdr x) env))\n    ((eq? (car x) 'progn) (sequence (cdr x) env))\n    ((eq? (car x) 'lambda) (closure (cadr x) (cddr x) env))\n    ((eq? (car x) 'let)\n     (evaluate (cons (cons 'lambda\n                           (cons (map car (cadr x)) (cddr x)))\n                     (map cadr (cadr x))) env))\n    ((eq? (car x) 'set!)\n     (set-binding (cadr x) (evaluate (caddr x) env) env))\n    ((eq? (car x) 'define)\n     (if (pair? (cadr x))\n         (define-in-frame (car (cadr x))\n                          (closure (cdr (cadr x)) (cddr x) env)\n                          (car env))\n         (define-in-frame (cadr x) (evaluate (caddr x) env) (car env))))\n    ((eq? (car x) 'cond) (evaluate-cond (cdr x) env)"]
