[17.430119, "i", "cat > /app/filter.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Remove executable JavaScript from an HTML file in place.\"\"\"\n\nimport re\nimport sys\nfrom html.parser import HTMLParser\nfrom pathlib import Path\n\n\n# Elements whose contents can execute script or otherwise provide an active\n# browser execution context.  Removing the complete element is safer than\n# trying to rewrite its contents.\nDROP_ELEMENTS = {\n    \"script\", \"iframe\", \"object\", \"embed\", \"applet\", \"base\", \"form\",\n}\n\n# URL-bearing attributes which must not contain executable schemes.\nURL_ATTRIBUTES = {\n    \"href\", \"src\", \"action\", \"formaction\", \"cite\", \"background\",\n    \"poster\", \"profile\", \"usemap\", \"longdesc\", \"dynsrc\", \"lowsrc\",\n    \"ping\", \"xlink:href\",\n}\n\n# Keep the parser close to the original HTML serialization: only remove the\n# dangerous pieces, and retain ordinary start/end tags and text verbatim.\nEVENT_ATTRIBUTE = re.compile(r\"^on[a-z0-9_:-]+$\", re.I)\nLEADING_SPACE = re.compile(r\"^[\\s\\ufeff]*\")\n\n\ndef dangerous_url(value: str) -> bool:\n    \"\"\"Return"]
[17.430172, "i", " true for URL values that can execute script in a browser.\"\"\"\n    normalized = re.sub(r\"[\\x00-\\x20\\t\\r\\n\\f]+\", \"\", value).lower()\n    return (\n        normalized.startswith(\"javascript:\")\n        or normalized.startswith(\"vbscript:\")\n        or normalized.startswith(\"data:text/html\")\n        or normalized.startswith(\"data:application/xhtml+xml\")\n        or normalized.startswith(\"data:image/svg+xml\")\n    )\n\n\nclass Sanitizer(HTMLParser):\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=False)\n        self.out = []\n        self.drop_depth = 0\n        self.raw_depth = 0\n\n    def handle_starttag(self, tag, attrs):\n        tag_lower = tag.lower()\n        if self.drop_depth:\n            if tag_lower in DROP_ELEMENTS:\n                self.drop_depth += 1\n            return\n        if tag_lower in DROP_ELEMENTS:\n            self.drop_depth = 1\n            return\n\n        kept = []\n        for name, value in attrs:\n            name_lower = name.lower()\n            if EVENT_ATTRIBUTE.match(name_"]
[17.430229, "i", "lower):\n                continue\n            if name_lower in URL_ATTRIBUTES and value is not None and dangerous_url(value):\n                continue\n            # SVG/MathML namespace attributes can also carry script URLs.\n            if name_lower in {\"href\", \"xlink:href\"} and value is not None and dangerous_url(value):\n                continue\n            kept.append((name, value))\n\n        # Re-emit only this tag. Attribute quoting may be normalized by the\n        # standard parser, which is explicitly allowed by the task.\n        self.out.append(\"<\" + tag)\n        for name, value in kept:\n            self.out.append(\" \" + name)\n            if value is not None:\n                escaped = value.replace(\"&\", \"&amp;\").replace('\"', \"&quot;\")\n                self.out.append('=\"' + escaped + '\"')\n        self.out.append(\">\")\n\n    def handle_startendtag(self, tag, attrs):\n        tag_lower = tag.lower()\n        if self.drop_depth or tag_lower in DROP_ELEMENTS:\n            return\n        kept = []\n        for nam"]
[17.430251, "i", "e, value in attrs:\n            if EVENT_ATTRIBUTE.match(name.lower()):\n                continue\n            if name.lower() in URL_ATTRIBUTES and value is not None and dangerous_url(value):\n                continue\n            kept.append((name, value))\n        self.out.append(\"<\" + tag)\n        for name, value in kept:\n            self.out.append(\" \" + name)\n            if value is not None:\n                self.out.append('=\"' + value.replace(\"&\", \"&amp;\").replace('\"', \"&quot;\") + '\"')\n        self.out.append(\"/>\")\n\n    def handle_endtag(self, tag):\n        if self.drop_depth:\n            if tag.lower() in DROP_ELEMENTS:\n                self.drop_depth -= 1\n            return\n        self.out.append(\"</\" + tag + \">\")\n\n    def handle_data(self, data):\n        if not self.drop_depth:\n            self.out.append(data)\n\n    def handle_entityref(self, name):\n        if not self.drop_depth:\n            self.out.append(\"&\" + name + \";\")\n\n    def handle_charref(self, name):\n        if not self.drop_depth:\n         "]
[17.43027, "i", "   self.out.append(\"&#\" + name + \";\")\n\n    def handle_comment(self, data):\n        # HTML comments can contain browser conditional/script tricks; remove\n        # comments that contain script-looking content, preserve other comments.\n        if not self.drop_depth:\n            if re.search(r\"(?:<\\s*script|javascript\\s*:|\\bon\\w+\\s*=)\", data, re.I):\n                return\n            self.out.append(\"<!--\" + data + \"-->\")\n\n    def handle_decl(self, decl):\n        if not self.drop_depth:\n            self.out.append(\"<!\" + decl + \">\")\n\n    def handle_pi(self, data):\n        if not self.drop_depth:\n            self.out.append(\"<?\" + data + \">\")\n\n    def handle_unknown_decl(self, data):\n        if not self.drop_depth:\n            self.out.append(\"<![\" + data + \"]>\")\n\n\ndef sanitize(text: str) -> str:\n    parser = Sanitizer()\n    parser.feed(text)\n    parser.close()\n    return \"\".join(parser.out)\n\n\ndef main() -> int:\n    if len(sys.argv) != 2:\n        print(f\"usage: {sys.argv[0]} HTML_FILE\", file=sys.stderr)\n        "]
[17.430323, "i", "return 2\n    path = Path(sys.argv[1])\n    raw = path.read_bytes()\n    # Preserve UTF-8 and common legacy encodings as far as possible.\n    try:\n        text = raw.decode(\"utf-8\")\n    except UnicodeDecodeError:\n        text = raw.decode(\"latin-1\")\n    result = sanitize(text)\n    path.write_bytes(result.encode(\"utf-8\"))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\nchmod +x /app/filter.py\npython3 -m py_compile /app/filter.py\n"]
