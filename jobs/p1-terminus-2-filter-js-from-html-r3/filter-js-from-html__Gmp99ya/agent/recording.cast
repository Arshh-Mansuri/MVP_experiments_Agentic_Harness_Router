[17.448325, "o", "def sanitize(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.448515, "o", "    parser = Sanitizer()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.448636, "o", "    parser.feed(text)\r\n\u001b[?2004l\r"]
[17.448752, "o", "\u001b[?2004h> "]
[17.448956, "o", "    parser.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.449013, "o", "> "]
[17.449053, "o", "    return \"\".join(parser.out)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[17.449068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.44921, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.449305, "o", "        print(f\"usage: {sys.argv[0]} HTML_FILE\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.449463, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.449618, "o", "    path = Path(sys.argv[1])\r\n\u001b[?2004l\r"]
[17.449684, "o", "\u001b[?2004h> "]
[17.449832, "o", "    raw = path.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.44996, "o", "    # Preserve UTF-8 and common legacy encodings as far as possible.\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.450193, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h>         text = raw.decode(\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.450219, "o", "    except UnicodeDecodeError:\r\n\u001b[?2004l\r"]
[17.450347, "o", "\u001b[?2004h> "]
[17.450366, "o", "        text = raw.decode(\"latin-1\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.450608, "o", "    result = sanitize(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.450698, "o", "> "]
[17.450775, "o", "    path.write_bytes(result.encode(\"utf-8\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.45084, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.450913, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.45099, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
[17.451138, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
