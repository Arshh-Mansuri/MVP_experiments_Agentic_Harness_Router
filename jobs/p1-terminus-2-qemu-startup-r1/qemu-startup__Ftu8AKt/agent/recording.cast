[8.882559, "i", "QEMU=$(command -v qemu-system-x86_64 || command -v qemu-system-i386); nohup \"$QEMU\" -cdrom /app/alpine.iso -m 512 -nographic -serial tcp:127.0.0.1:6665,server=on,wait=off > /tmp/alpine-qemu.log 2>&1 & echo $! > /tmp/alpine-qemu.pid; for i in $(seq 1 60); do if kill -0 \"$(cat /tmp/alpine-qemu.pid)\" 2>/dev/null && (echo >/dev/tcp/127.0.0.1/6665) 2>/dev/null; then echo \"QEMU running and telnet listener ready (PID $(cat /tmp/alpine-qemu.pid))\"; exit 0; fi; sleep 1; done; echo 'QEMU did not become ready'; cat /tmp/alpine-qemu.log; exit 1\n"]
