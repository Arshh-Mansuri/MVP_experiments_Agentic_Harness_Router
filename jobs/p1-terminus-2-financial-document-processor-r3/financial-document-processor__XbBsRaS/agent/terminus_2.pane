[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for m in re.finditer(rb'stream\r?\n',data):
[?2004l[?2004h>   start=m.end(); end=data.find(b'endstream',start)
[?2004l[?2004h>   if end<0: continue
[?2004l[?2004h>   s=data[start:end].rstrip(b'\r\n')
[?2004l[?2004h>   candidates=[s]
[?2004l[?2004h>   try: candidates.append(zlib.decompress(s))
[?2004l[?2004h>   except: pass
[?2004l[?2004h>   for x in candidates:
[?2004l[?2004h>    if any(k in x for k in (b'BT',b'Tj',b'TJ')):
[?2004l[?2004h>     out.append(x)
[?2004l[?2004h>  return b'\n'.join(out)
[?2004l[?2004h> def pdf_decode(x):
[?2004l[?2004h>  x=re.sub(rb'\\([\\()])',rb'\1',x)
[?2004l[?2004h>  x=re.sub(rb'\\n',b'\n',x)
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for m in re.finditer(rb'\((.*?)\)\s*Tj',x,re.S): vals.append(m.group(1))
[?2004l[?2004h>  for m in re.finditer(rb'\[(.*?)\]\s*TJ',x,re.S): vals += re.findall(rb'\((.*?)\)',m.group(1),re.S)
[?2004l[?2004h>  return b' '.join(vals)
[?2004l[?2004h> for n in sorted(os.listdir(root)):
[?2004l[?2004h>  p=os.path.join(root,n); d=open(p,'rb').read()
