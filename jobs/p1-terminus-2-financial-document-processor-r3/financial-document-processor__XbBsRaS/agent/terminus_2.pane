[?2004l[?2004h>  if n.lower().endswith('.pdf'):
[?2004l[?2004h>   raw=pdf_text(d); print(pdf_decode(raw)[:5000].decode('latin1','replace'))
[?2004l[?2004h>  else:
[?2004l[?2004h>   # JPEG marker scan: dimensions, comments, printable runs
[?2004l[?2004h>   pos=2
[?2004l[?2004h>   while pos+9<len(d):
[?2004l[?2004h>    if d[pos]!=255: pos+=1; continue
[?2004l[?2004h>    marker=d[pos+1]; pos+=2
[?2004l[?2004h>    if marker in (216,217): continue
[?2004l[?2004h>    if pos+2>len(d): break
[?2004l[?2004h>    ln=struct.unpack('>H',d[pos:pos+2])[0]
[?2004l[?2004h>    if marker in (192,194) and pos+7<len(d):
[?2004l[?2004h>     h,w=struct.unpack('>HH',d[pos+3:pos+7]); print('dimensions',w,h)
[?2004l[?2004h>    if marker==254: print('COMMENT',d[pos+2:pos+ln].decode('latin1','replace'))
[?2004l[?2004h>    pos+=ln
[?2004l[?2004h>   runs=re.findall(rb'[ -~]{8,}',d)
