[24.344482, "i", "python3 - <<'PY'\nimport os,re,zlib,struct\nroot='/app/documents'\ndef pdf_text(data):\n out=[]\n for m in re.finditer(rb'stream\\r?\\n',data):\n  start=m.end(); end=data.find(b'endstream',start)\n  if end<0: continue\n  s=data[start:end].rstrip(b'\\r\\n')\n  candidates=[s]\n  try: candidates.append(zlib.decompress(s))\n  except: pass\n  for x in candidates:\n   if any(k in x for k in (b'BT',b'Tj',b'TJ')):\n    out.append(x)\n return b'\\n'.join(out)\ndef pdf_decode(x):\n x=re.sub(rb'\\\\([\\\\()])',rb'\\1',x)\n x=re.sub(rb'\\\\n',b'\\n',x)\n vals=[]\n for m in re.finditer(rb'\\((.*?)\\)\\s*Tj',x,re.S): vals.append(m.group(1))\n for m in re.finditer(rb'\\[(.*?)\\]\\s*TJ',x,re.S): vals += re.findall(rb'\\((.*?)\\)',m.group(1),re.S)\n return b' '.join(vals)\nfor n in sorted(os.listdir(root)):\n p=os.path.join(root,n); d=open(p,'rb').read()\n print('\\n###',n,len(d))\n if n.lower().endswith('.pdf'):\n  raw=pdf_text(d); print(pdf_decode(raw)[:5000].decode('latin1','replace'))\n else:\n  # JPEG marker scan: dimensions, comments, printable runs\n  pos=2\n  while pos+9<len(d):\n   if d[pos]!=255: pos+=1; continue\n   marker=d[pos+1]; pos+=2\n   if marker in (216,217): continue\n   if pos+2>len(d): break\n   ln=struct.unpack('>H',d[pos:pos+2])[0]\n   if marker in (192,194) and pos+7<len(d):\n    h,w=struct.unpack('>HH',d[pos+3:pos+7]); print('dimensions',w,h)\n   if marker==254: print('COMMENT',d[pos+2:pos+ln].decode('latin1','replace'))\n   pos+=ln\n  runs=re.findall(rb'[ -~]{8,}',d)\n  print('strings:',b' | '.join(runs[:20]).decode('latin1','replace'))\nPY\n"]
[24.346607, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[24.350974, "o", "\u001b[?2004h> import os,re,zlib,struct\r\n\u001b[?2004l\r\u001b[?2004h> root='/app/documents'\r\n\u001b[?2004l\r\u001b[?2004h> def pdf_text(data):\r\n\u001b[?2004l\r\u001b[?2004h>  out=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for m in re.finditer(rb'stream\\r?\\n',data):\r\n\u001b[?2004l\r\u001b[?2004h>   start=m.end(); end=data.find(b'endstream',start)\r\n\u001b[?2004l\r\u001b[?2004h>   if end<0: continue\r\n\u001b[?2004l\r\u001b[?2004h>   s=data[start:end].rstrip(b'\\r\\n')\r\n\u001b[?2004l\r\u001b[?2004h>   candidates=[s]\r\n\u001b[?2004l\r\u001b[?2004h>   try: candidates.append(zlib.decompress(s))\r\n\u001b[?2004l\r\u001b[?2004h>   except: pass\r\n\u001b[?2004l\r\u001b[?2004h>   for x in candidates:\r\n\u001b[?2004l\r\u001b[?2004h>    if any(k in x for k in (b'BT',b'Tj',b'TJ')):\r\n\u001b[?2004l\r\u001b[?2004h>     out.append(x)\r\n\u001b[?2004l\r\u001b[?2004h>  return b'\\n'.join(out)\r\n\u001b[?2004l\r\u001b[?2004h> def pdf_decode(x):\r\n\u001b[?2004l\r\u001b[?2004h>  x=re.sub(rb'\\\\([\\\\()])',rb'\\1',x)\r\n\u001b[?2004l\r\u001b[?2004h>  x=re.sub(rb'\\\\n',b'\\n',x)\r\n\u001b[?2004l\r\u001b[?2004h>  vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for m in re.finditer(rb'\\((.*?)\\)\\s*Tj',x,re.S): vals.append(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  for m in re.finditer(rb'\\[(.*?)\\]\\s*TJ',x,re.S): vals += re.findall(rb'\\((.*?)\\)',m.group(1),re.S)\r\n\u001b[?2004l\r\u001b[?2004h>  return b' '.join(vals)\r\n\u001b[?2004l\r\u001b[?2004h> for n in sorted(os.listdir(root)):\r\n\u001b[?2004l\r\u001b[?2004h>  p=os.path.join(root,n); d=open(p,'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n###',n,len(d))\r\n\u001b[?2004l\r\u001b[?2004h>  if n.lower().endswith('.pdf'):\r\n\u001b[?2004l\r\u001b[?2004h>   raw=pdf_text(d); print(pdf_decode(raw)[:5000].decode('latin1','replace'))\r\n\u001b[?2004l\r\u001b[?2004h>  else:\r\n\u001b[?2004l\r\u001b[?2004h>   # JPEG marker scan: dimensions, comments, printable runs\r\n\u001b[?2004l\r\u001b[?2004h>   pos=2\r\n\u001b[?2004l\r\u001b[?2004h>   while pos+9<len(d):\r\n\u001b[?2004l\r\u001b[?2004h>    if d[pos]!=255: pos+=1; continue\r\n\u001b[?2004l\r\u001b[?2004h>    marker=d[pos+1]; pos+=2\r\n\u001b[?2004l\r\u001b[?2004h>    if marker in (216,217): continue\r\n\u001b[?2004l\r\u001b[?2004h>    if pos+2>len(d): break\r\n\u001b[?2004l\r\u001b[?2004h>    ln=struct.unpack('>H',d[pos:pos+2])[0]\r\n\u001b[?2004l\r\u001b[?2004h>    if marker in (192,194) and pos+7<len(d):\r\n\u001b[?2004l\r\u001b[?2004h>     h,w=struct.unpack('>HH',d[pos+3:pos+7]); print('dimensions',w,h)\r\n\u001b[?2004l\r\u001b[?2004h> "]
