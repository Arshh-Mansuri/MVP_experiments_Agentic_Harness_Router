[80.90694, "i", "rm -rf /tmp/doc_text /tmp/doc_pages; mkdir -p /tmp/doc_text /tmp/doc_pages; for f in /app/documents/*; do n=$(basename \"$f\"); stem=${n%.*}; ext=${n##*.}; out=/tmp/doc_text/$stem.txt; if [ \"$ext\" = pdf ]; then pdftotext -layout \"$f\" \"$out\" 2>/dev/null || :; chars=$(wc -c < \"$out\" 2>/dev/null || echo 0); if [ \"$chars\" -lt 80 ]; then mkdir -p \"/tmp/doc_pages/$stem\"; pdftoppm -r 200 -jpeg \"$f\" \"/tmp/doc_pages/$stem/page\" >/dev/null 2>&1; : > \"$out\"; for p in /tmp/doc_pages/$stem/*.jpg; do [ -f \"$p\" ] && tesseract \"$p\" stdout 2>/dev/null >> \"$out\"; done; fi; else tesseract \"$f\" \"$out\" 2>/dev/null || :; fi; done; echo '--- extracted files ---'; for t in /tmp/doc_text/*.txt; do echo; echo \"### $(basename \"$t\")\"; sed -n '1,80p' \"$t\"; done\n"]
[80.909188, "o", "rm -rf /tmp/doc_text /tmp/doc_pages; mkdir -p /tmp/doc_text /tmp/doc_pages; for f in /app/documents/*; do n=$(basename \"$f\"); stem=${n%.*}; ext=${n##*.}; out=/tmp/doc_text/$stem.txt; if [ \"$ext\" = pdf ]; then pdftotext -layout \"$f\" \"$out\" 2>/dev/null || :; chars=$(wc -c < \"$out\" 2>/dev/null || echo 0); if [ \"$chars\" -lt 80 ]; then mkdir -p \"/tmp/doc_pages/$stem\"; pdftoppm -r 200 -jpeg \"$f\" \"/tmp/doc_pages/$stem/page\" >/dev/null 2>&1; : > \"$out\"; for p in /tmp/doc_pages/$stem/*.jpg; do [ -f \"$p\" ] && tesseract \"$p\" stdout 2>/dev/null >> \"$out\"; done; fi; else tesseract \"$f\" \"$out\" 2>/dev/null || :; fi; done; echo '--- extracted files ---'; for t in /tmp/doc_text/*.txt; do echo; echo \"### $(basename \"$t\")\"; sed -n '1,80p' \"$t\"; done\r\n"]
