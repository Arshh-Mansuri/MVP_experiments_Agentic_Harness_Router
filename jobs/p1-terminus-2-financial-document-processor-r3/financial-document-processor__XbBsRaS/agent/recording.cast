[13.013835, "i", "printf '%s\\n' '--- available commands ---'; for x in file pdfinfo pdftoppm pdftocairo mutool identify convert magick python3; do printf '%-12s' \"$x\"; command -v \"$x\" || true; done; printf '%s\\n' '--- python modules ---'; python3 - <<'PY'\nmods=['fitz','PyPDF2','pypdf','pdfplumber','PIL','cv2',' pytesseract'.strip()]\nfor m in mods:\n try:\n  __import__(m); print(m, 'OK')\n except Exception as e: print(m, 'NO')\nPY\nprintf '%s\\n' '--- signatures ---'; python3 - <<'PY'\nimport os\nfor n in sorted(os.listdir('/app/documents')):\n p='/app/documents/'+n\n with open(p,'rb') as f: h=f.read(16)\n print(n, h)\nPY\n"]
