[571.328624, "i", "cp warriors/g2-clear.red /tmp/g2.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2.red warriors/stone.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2.red warriors/paper.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2.red warriors/vampire.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2.red warriors/g2-clear.red\ncat > /tmp/g2scan.red <<'EOF'\n;redcode-94\n;name Clear Scanner\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\ndec equ 2700\norg clear-1\nstart spl clear\n      jmp scan\nbptr dat bomb,9\nbomb spl #dec,11\nclear mov *bptr,>gate\n      mov *bptr,>gate\n      djn.f clear,}bomb\ngate equ clear-4\nscan add #1,sp\n     jmz scan,@sp\n     mov bomb,@sp\n     mov bomb,*sp\n     jmp scan\nsp dat 400,400\nend start\nEOF\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2scan.red warriors/stone.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2scan.red warriors/paper.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2scan.red warriors/vampire.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2scan.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/g2scan.red warriors/g2-clear.red\n"]
