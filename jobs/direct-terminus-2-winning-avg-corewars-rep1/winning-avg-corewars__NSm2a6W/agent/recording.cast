[177.356553, "i", "cat > /tmp/eight.red <<'EOF'\n;redcode-94\n;name Eight Way Scanner\n;author assistant\n;strategy Eight parallel full-core scanners\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart spl s2\n      spl s3\n      spl s4\n      spl s5\n      spl s6\n      spl s7\n      spl s8\ns1    add #1,p1\n      jmz s1,@p1\n      mov bomb,@p1\n      mov bomb,*p1\n      jmp s1\ns2    add #1,p2\n      jmz s2,@p2\n      mov bomb,@p2\n      mov bomb,*p2\n      jmp s2\ns3    add #1,p3\n      jmz s3,@p3\n      mov bomb,@p3\n      mov bomb,*p3\n      jmp s3\ns4    add #1,p4\n      jmz s4,@p4\n      mov bomb,@p4\n      mov bomb,*p4\n      jmp s4\ns5    add #1,p5\n      jmz s5,@p5\n      mov bomb,@p5\n      mov bomb,*p5\n      jmp s5\ns6    add #1,p6\n      jmz s6,@p6\n      mov bomb,@p6\n      mov bomb,*p6\n      jmp s6\ns7    add #1,p7\n      jmz s7,@p7\n      mov bomb,@p7\n      mov bomb,*p7\n      jmp s7\ns8    add #1,p8\n      jmz s8,@p8\n      mov bomb,@p8\n      mov bomb,*p8\n      jmp s8\np1 dat 100,100\np2 dat 1100,1100\np3 dat 2100,2100\np4 dat 3100,3100\np5 dat 4100,4100\np6 dat 5100,5100\np7 dat 6100,6100\np8 dat 7100,7100\nbomb dat 0,0\nend start\nEOF\n/usr/local/bin/pmars -b -r 100 -f /tmp/eight.red warriors/stone.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/eight.red warriors/paper.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/eight.red warriors/vampire.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/eight.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/eight.red warriors/g2-clear.red\n"]
