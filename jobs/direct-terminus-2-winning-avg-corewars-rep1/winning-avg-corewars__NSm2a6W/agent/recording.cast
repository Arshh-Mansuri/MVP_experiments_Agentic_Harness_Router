[605.020912, "i", "cat > /tmp/tune_g2.py <<'PY'\nimport re, subprocess\nbase=open('/tmp/g2.red').read()\nvariants=[]\nfor dec in [2600,2650,2680,2690,2695,2700,2705,2710,2720,2750,2800]:\n  for off in [7,8,9,10,11,12,13]:\n    s=base.replace('dec     equ     2700',f'dec     equ     {dec}')\n    s=s.replace('bptr    dat     bomb,       9',f'bptr    dat     bomb,       {off}')\n    variants.append((f'd{dec}o{off}',s))\nfor name,s in variants:\n  fn='/tmp/g_'+name+'.red'; open(fn,'w').write(s)\n  wins=[]\n  for o in ['stone','paper','vampire','snake','g2-clear']:\n    out=subprocess.check_output(['/usr/local/bin/pmars','-b','-r','100','-f',fn,'warriors/'+o+'.red'],text=True)\n    line=[x for x in out.splitlines() if x.startswith('Results:')][-1]\n    wins.append(int(re.findall(r'\\d+',line)[0]))\n  print(name,wins,flush=True)\n  if wins[0]>=75 and wins[1]>=75 and wins[2]>=75 and wins[3]>=33 and wins[4]>=33:\n    open('/tmp/winner.red','w').write(s)\n    print('WINNER',name,wins)\n    break\nPY\npython3 /tmp/tune_g2.py\n"]
[605.031629, "o", "cat > /tmp/tune_g2.py <<'PY'\r\n\u001b[?2004l\r"]
