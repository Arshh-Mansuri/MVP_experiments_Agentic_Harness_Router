[450.302531, "i", "python3 - <<'PY'\nimport re\nbase=open('/tmp/snake.red').read()\nbase=base.replace('start   mov     trap+4,','core    mov     trap+4,',1)\n# Remove ten decoys, then append a self-contained bomber and payload.\nbase=re.sub(r'^\\s*dat\\s+<trap,\\s*<1.*\\n','',base,count=10,flags=re.M)\ninsert='''\\nstart   spl     bomber\\n        jmp     core\\nbomber  add     #7, bptr\\n        mov     bd, @bptr\\n        jmp     bomber\\nbptr    dat     300, 300\\nbd      dat     0, 0\\n'''\ns=base.replace('        end     start',insert+'\\n        end     start')\nopen('/tmp/sb7fixed2.red','w').write(s)\nPY\n/usr/local/bin/pmars -b -r 100 -f /tmp/sb7fixed2.red warriors/snake.red\n"]
