[518.254771, "i", "cat > /tmp/search4.py <<'PY'\nimport re, subprocess\nbase=open('/tmp/snake.red').read()\nvariants=[]\n# Trap target and fang offsets.\nfor x in [-300,-200,-121,-100,-79,-53,-31,-17,17,31,53,79,100,121,149,181,233]:\n    variants.append((f't{x}',base.replace('pit-x-121+2, x+121',f'pit-x-{x}+2, x+{x}')))\n# Pit clear addressing variants.\nfor x in [-3,-2,-1,0,1,2,3,4,5,7,11,13]:\n    variants.append((f'p{x}',base.replace('mov @dist,        <0-dist',f'mov @{x},        <0-{x}')))\n# Change startup hide and first vampire launch expression.\nfor x in [1400,1500,1550,1650,1700,1800,1900,2000,2200]:\n    variants.append((f'h{x}',base.replace('hide    equ 1600',f'hide    equ {x}')))\n# Turn selected decoys into differing DAT values, preserving line count.\nlines=base.splitlines()\ninds=[i for i,l in enumerate(lines) if 'dat     <trap' in l]\nfor k in range(min(20,len(inds))):\n    ll=lines[:]\n    ll[inds[k]]='        dat     0, 0'\n    variants.append((f'd{k}','\\n'.join(ll)+'\\n'))\nres=[]\nfor name,s in variants:\n    fn='/tmp/q_'+name.replace('-','m')+'.red'; open(fn,'w').write(s)\n    try: out=subprocess.check_output(['/usr/local/bin/pmars','-b','-r','100','-f',fn,'warriors/snake.red'],text=True,stderr=subprocess.STDOUT)\n    except subprocess.CalledProcessError: continue\n    line=[x for x in out.splitlines() if x.startswith('Results:')]\n    if line:\n      n=list(map(int,re.findall(r'\\d+',line[-1]))); res.append((n[0],name,n[1],n[2],fn))\nfor x in sorted(res,reverse=True)[:25]: print(*x)\nPY\npython3 /tmp/search4.py\n"]
[518.256604, "o", "cat > /tmp/search4.py <<'PY'\r\n"]
