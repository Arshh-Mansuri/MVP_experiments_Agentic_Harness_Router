[140.188773, "i", "/usr/local/bin/pmars -b -r 100 -f /tmp/paper.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/paper.red warriors/g2-clear.red\ncat > /tmp/carpet.red <<'EOF'\n;redcode-94\n;name Multi Bomber\n;author test\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart spl b2\n      spl b3\n      jmp scan\nb1    add #4, p1\n      mov bomb, @p1\n      jmp b1\nb2    add #7, p2\n      mov bomb, @p2\n      jmp b2\nb3    add #13, p3\n      mov bomb, @p3\n      jmp b3\nscan  add #1, p4\n      jmz scan, @p4\n      mov bomb, @p4\n      mov bomb, *p4\n      jmp scan\np1 dat 300,300\np2 dat 301,301\np3 dat 302,302\np4 dat 303,303\nbomb dat 0,0\nend start\nEOF\n/usr/local/bin/pmars -b -r 100 -f /tmp/carpet.red warriors/stone.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/carpet.red warriors/paper.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/carpet.red warriors/vampire.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/carpet.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/carpet.red warriors/g2-clear.red\n"]
