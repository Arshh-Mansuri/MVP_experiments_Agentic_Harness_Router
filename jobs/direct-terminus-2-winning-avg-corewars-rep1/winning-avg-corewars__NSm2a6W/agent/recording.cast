[67.105291, "i", "cat > /tmp/paper.red <<'EOF'\n;redcode-94\n;name Direct Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl 1\nloop mov copy, *ptr\n     add #1, ptr\n     mov copy, @ptr\n     add #step, ptr\n     jmp loop\ncopy spl 0, 0\nptr dat step, step*2\nend start\nEOF\ncat > /tmp/stone.red <<'EOF'\n;redcode-94\n;name Direct Stone\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart add #4, 3\n      mov 2, @2\n      jmp -2\n      dat #0, #0\nend start\nEOF\ncat > /tmp/paper2.red <<'EOF'\n;redcode-94\n;name Fast Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl 1\n      spl 1\nloop  mov copy, *ptr\n      add #1, ptr\n      mov copy, @ptr\n      add #step, ptr\n      jmp loop\ncopy  spl 0, 0\nptr   dat step, step*2\nend start\nEOF\nfor f in /tmp/paper.red /tmp/stone.red /tmp/paper2.red; do echo ==== $f ====; for o in stone paper vampire snake g2-clear; do printf '%s ' $o; /usr/local/bin/pmars -b -r 100 -f \"$f\" warriors/$o.red | tail -1; done; done"]
