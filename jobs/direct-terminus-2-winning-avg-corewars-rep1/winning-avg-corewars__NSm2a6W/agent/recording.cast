[199.710076, "i", "cat > /tmp/paper2.red <<'EOF'\n;redcode-94\n;name Two Process Paper\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl 1\n      spl 1\nloop  mov copy,*ptr\n      add one,ptr\n      mov copy,@ptr\n      add #step,ptr\n      jmp loop\ncopy  spl 0,0\nptr   dat step,step*2\none   dat 1,1\nend start\nEOF\ncat > /tmp/silk.red <<'EOF'\n;redcode-94\n;name Silk Replicator\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl 1\n      mov 0,1\n      spl 1\n      mov 0,1\nloop  mov 0,*ptr\n      add #1,ptr\n      mov 0,@ptr\n      add #step,ptr\n      jmp loop\nptr   dat step,step*2\nend start\nEOF\ncat > /tmp/paperimp.red <<'EOF'\n;redcode-94\n;name Paper Imp\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl paper\n      jmp imp\npaper spl 1\n      spl 1\nloop  mov copy,*ptr\n      add one,ptr\n      mov copy,@ptr\n      add #step,ptr\n      jmp loop\ncopy  spl 0,0\nptr   dat step,step*2\none   dat 1,1\nimp   mov 0,2667\n      jmp -1\nend start\nEOF\nfor f in /tmp/paper2.red /tmp/silk.red /tmp/paperimp.red; do echo ==== $f ====; /usr/local/bin/pmars -b -r 100 -f $f warriors/stone.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/paper.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/vampire.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/snake.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/g2-clear.red; done\n"]
