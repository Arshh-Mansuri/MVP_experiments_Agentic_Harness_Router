[54.86927, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Scanner Paper Imp\n;author assistant\n;strategy Scanner backed by replicator and imp\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n\nstart   spl     scan\n        spl     paper\n        jmp     imp\n\nscan    add     #1, sptr\n        jmz     scan, @sptr\n        mov     bomb, @sptr\n        mov     bomb, *sptr\n        jmp     scan\nsptr    dat     300, 300\nbomb    dat     0, 0\n\npaper   spl     1\n        spl     1\nploop   mov     pcopy, *pptr\n        add     one, pptr\n        mov     pcopy, @pptr\n        add     stride, pptr\n        jmp     ploop\npcopy   spl     0, 0\npptr    dat     2667, 5334\none     dat     1, 1\nstride  dat     2667, 2667\n\nimp     mov     0, 2667\n        jmp     -1\n        end     start\nEOF\nfor o in stone paper vampire snake g2-clear; do echo ===$o===; /usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/$o.red; done\n"]
