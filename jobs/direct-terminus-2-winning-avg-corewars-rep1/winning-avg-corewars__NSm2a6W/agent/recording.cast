[301.538231, "i", "cat > /tmp/search.py <<'PY'\nimport re, subprocess\nbase=open('/tmp/snake.red').read()\nvariants=[]\n# Alter the first ring split and several binary-tree split counts.\nfor a,b,c,d in [(1,2,3,4),(2,3,4,5),(3,4,5,6),(4,5,6,7),(5,6,7,8),(1,3,5,7),(2,4,6,8),(6,5,4,3)]:\n    s=base\n    s=re.sub(r'(ring\\s+spl\\s+)9',r'\\g<1>'+str(a),s)\n    s=re.sub(r'(\\n\\s*spl\\s+)5',r'\\g<1>'+str(b),s,1)\n    s=re.sub(r'(\\n\\s*spl\\s+)3',r'\\g<1>'+str(c),s,1)\n    s=re.sub(r'(\\n\\s*spl\\s+)2',r'\\g<1>'+str(d),s,1)\n    variants.append((f'{a}{b}{c}{d}',s))\n# Alter ring jump offsets, which changes the initial imp/vampire race.\nfor off in [1,2,3,4,5,7,11,13,17,23,31,41,53,67,79,97]:\n    s=base.replace('jmp     imp,          <4250',f'jmp     imp+{off},        <4250')\n    variants.append((f'o{off}',s))\nfor name,s in variants:\n    fn='/tmp/cw_'+name+'.red'; open(fn,'w').write(s)\n    out=subprocess.check_output(['/usr/local/bin/pmars','-b','-r','100','-f',fn,'warriors/snake.red'],text=True)\n    line=[x for x in out.splitlines() if x.startswith('Results:')][-1]\n    nums=list(map(int,re.findall(r'\\d+',line)))\n    print(name, nums[0], nums[1], nums[2], flush=True)\nPY\npython3 /tmp/search.py\n"]
[301.540652, "o", "cat > /tmp/search.py <<'PY'\r\n"]
