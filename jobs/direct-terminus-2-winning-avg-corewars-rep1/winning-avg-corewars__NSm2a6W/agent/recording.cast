[441.472759, "i", "python3 - <<'PY'\nimport re\nbase=open('/tmp/snake.red').read()\nbase=base.replace('start   mov     trap+4,','core    mov     trap+4,',1)\n# Remove eight decoy DAT instructions robustly.\nbase=re.sub(r'^\\s*dat\\s+<trap,\\s*<1.*\\n','',base,count=8,flags=re.M)\ns=base.replace('        end     start','''start   spl     bomber\n        jmp     core\nbomber  add     #7, bptr\n        mov     data, @bptr\n        jmp     bomber\nbptr    dat     300, 300\n\n        end     start''')\nopen('/tmp/sb7fixed.red','w').write(s)\nprint('decoys left',len(re.findall(r'^\\s*dat\\s+<trap,\\s*<1',s,re.M)))\nPY\ngrep -n '^start\\|^core\\|bomber\\|^data\\|^end' /tmp/sb7fixed.red\n/usr/local/bin/pmars -b -r 100 -f /tmp/sb7fixed.red warriors/snake.red\n"]
