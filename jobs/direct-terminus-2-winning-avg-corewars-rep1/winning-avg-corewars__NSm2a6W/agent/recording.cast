[340.862281, "i", "cat > /tmp/search2.py <<'PY'\nimport re, subprocess, random\nbase=open('/tmp/snake.red').read()\nrng=random.Random(94)\nvals=[]\nfor i in range(60):\n    s=base\n    dist=rng.choice([97,101,103,107,109,113,117,119,121,125,127,131,137,139,143,149])\n    hide=rng.choice([1400,1450,1500,1550,1600,1650,1700,1750,1800,1900,2000])\n    imp=rng.choice([2659,2661,2663,2665,2667,2669,2671,2673,2677,2681])\n    ring=rng.choice([1,2,3,5,7,9,11,13])\n    s=re.sub(r'dist\\s+equ\\s+121',f'dist    equ {dist}',s)\n    s=re.sub(r'hide\\s+equ\\s+1600',f'hide    equ {hide}',s)\n    s=s.replace('mov     0,              2667',f'mov     0,              {imp}')\n    s=re.sub(r'(ring\\s+spl\\s+)9',r'\\g<1>'+str(ring),s)\n    fn=f'/tmp/mut{i}.red'; open(fn,'w').write(s)\n    out=subprocess.check_output(['/usr/local/bin/pmars','-b','-r','100','-f',fn,'warriors/snake.red'],text=True)\n    line=[x for x in out.splitlines() if x.startswith('Results:')][-1]\n    n=list(map(int,re.findall(r'\\d+',line)))\n    vals.append((n[0],fn,dist,hide,imp,ring,n))\nfor x in sorted(vals,reverse=True)[:12]: print(x)\nPY\npython3 /tmp/search2.py\n"]
