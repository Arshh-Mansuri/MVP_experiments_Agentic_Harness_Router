[399.822793, "i", "cat > /tmp/makebomb2.py <<'PY'\nbase=open('/tmp/snake.red').read()\nbase=base.replace('start   mov     trap+4,', 'core    mov     trap+4,', 1)\nold='''        dat     <trap,          <1      ; decoys\n'''\nfor stride in [3,4,5,7,9,13,17,23]:\n    s=base.replace('        end     start', f'''start   spl     bomber\n        jmp     core\nbomber  add     #{stride}, bptr\n        mov     data, @bptr\n        jmp     bomber\nbptr    dat     300, 300\n\n        end     start''')\n    # Remove six decoy lines to keep the warrior under the 100-line limit.\n    s=s.replace(old,'',6)\n    open(f'/tmp/sb{stride}.red','w').write(s)\nPY\npython3 /tmp/makebomb2.py\nfor n in 3 4 5 7 9 13 17 23; do echo ==== $n ====; /usr/local/bin/pmars -b -r 100 -f /tmp/sb$n.red warriors/snake.red; done\n"]
