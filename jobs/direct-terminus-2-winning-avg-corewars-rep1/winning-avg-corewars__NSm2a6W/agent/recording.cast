[377.482415, "i", "cat > /tmp/makebomb.py <<'PY'\nbase=open('/tmp/snake.red').read()\nfor stride in [3,4,5,7,9,13,17]:\n    s=base.replace('start   mov     trap+4,', 'core    mov     trap+4,', 1)\n    s=s.replace('        end     start', f'''start   spl     bomber\n        jmp     core\nbomber  add     #{stride}, bptr\n        mov     bd, @bptr\n        jmp     bomber\nbptr    dat     300, 300\nbd      dat     0, 0\n\n        end     start''')\n    open(f'/tmp/sb{stride}.red','w').write(s)\nPY\npython3 /tmp/makebomb.py\nfor n in 3 4 5 7 9 13 17; do echo ==== $n ====; /usr/local/bin/pmars -b -r 100 -f /tmp/sb$n.red warriors/snake.red; done\n"]
[377.485651, "o", "cat > /tmp/makebomb.py <<'PY'\r\n\u001b[?2004l\r"]
