[41.822716, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Twin Scanner\n;author assistant\n;strategy Two parallel parity scanners\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n\nstart   spl     scan2\nscan1   add     #2, p1\n        jmz     scan1, @p1\n        mov     bomb, @p1\n        mov     bomb, *p1\n        jmp     scan1\n\nscan2   add     #2, p2\n        jmz     scan2, @p2\n        mov     bomb, @p2\n        mov     bomb, *p2\n        jmp     scan2\n\np1      dat     200, 200\np2      dat     201, 201\nbomb    dat     0, 0\n        end     start\nEOF\n/usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/stone.red\n/usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/paper.red\n/usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/vampire.red\n/usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/snake.red\n/usr/local/bin/pmars -b -r 100 -f my_warrior.red warriors/g2-clear.red\n"]
[41.829215, "o", "cat > my_warrior.red <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> ;redcode-94\r\n\u001b[?2004l\r\u001b[?2004h> ;name Twin Scanner\r\n\u001b[?2004l\r\u001b[?2004h> ;author assistant\r\n\u001b[?2004l\r\u001b[?2004h> ;strategy Two parallel parity scanners\r\n\u001b[?2004l\r\u001b[?2004h> ;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> start   spl     scan2\r\n\u001b[?2004l\r\u001b[?2004h> scan1   add     #2, p1\r\n\u001b[?2004l\r\u001b[?2004h>         jmz     scan1, @p1\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, @p1\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, *p1\r\n\u001b[?2004l\r\u001b[?2004h>         jmp     scan1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scan2   add     #2, p2\r\n\u001b[?2004l\r\u001b[?2004h>         jmz     scan2, @p2\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, @p2\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, *p2\r\n\u001b[?2004l\r\u001b[?2004h>         jmp     scan2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p1      dat     200, 200\r\n\u001b[?2004l\r\u001b[?2004h> p2      dat     201, 201\r\n\u001b[?2004l\r\u001b[?2004h> bomb    dat     0, 0\r\n\u001b[?2004l\r\u001b[?2004h>         end     start\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
