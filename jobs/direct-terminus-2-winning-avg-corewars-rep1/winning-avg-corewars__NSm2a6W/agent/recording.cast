[450.142275, "o", "    20\t\r\n    21\t; Trap and pit for vampire victims\r\n    22\ttrap    jmp pit-x-121+2, x+121   ; Trap statement in front to foil tracers\r\n    23\tx       spl 0,           trap\r\n    24\t        mov @0,          @trap\r\n    25\t        sub 4,           @-1\r\n    26\t        jmp -2\r\n    27\tpit     mov @dist,       <0-dist\r\n    28\t        spl 0                     ; This should change more losses into ties\r\n    29\t        spl -1                    ; than wins into ties\r\n    30\t\r\n    31\t; Massive decoy field - 63 lines to slow down enemy djn scans\r\n    32\t        dat     <trap,          <1      ; decoys\r\n"]
[450.219285, "o", "    80\t        dat     <trap,          <1\r\n    81\t        dat     <trap,          <1\r\n    82\t        dat     <trap,          <1\r\n    83\t        dat     <trap,          <1\r\n    84\t        dat     <trap,          <1\r\n    85\t        dat     <trap,          <1\r\n    86\t        dat     <trap,          <1\r\n    87\t\r\n    88\t; Main execution - vampire setup and binary ring launcher  \r\n    89\tcore    mov     trap+4,         hide            ; Copy vampire components\r\n    90\t        mov     trap+3,         <start          ; to safe hide location\r\n    91\t        mov     trap+2,         <start          \r\n    92\t        mov     trap+1,         <start\r\n    93\t        mov     trap,           <start\r\n    94\t        mov     pit+2,          hide\r\n    95\t        mov     pit+1,          <-1\r\n    96\t        mov     pit,            <-2\r\n    97\t        spl     start+hide-3,   <1              ; 1st split to vampire\r\n    98\t\r\n    99\t; Binary ring imp launcher - creates multiple imp streams\r\n   100\tring    spl     9,              <4050           ; Binary tree startup\r\n   101\t        spl     5,              <4100           \r\n   102\t        spl     3,              <4150\r\n   103\t        mov     icopy,          imp             ; Copy imp template away from decoys\r\n   104\t        jmp     start+hide-3,   <4200           ; 2nd split to vampire\r\n   105\t        jmp     imp,            <4250           ; Launch first imp stream\r\n   106\t        spl     2,              <4300\r\n   107\t        jmp     2667+imp,       <6350           ; Imp stream at 2667 interval\r\n   108\t        jmp     5334+imp,       <4400           ; Imp stream at 5334 interval  \r\n   109\t        spl     4,              <4450\r\n   110\t        spl     2,              <4500\r\n   111\t        jmp     1+imp,          <4550           ; Imp stream at +1 offset\r\n   112\t        jmp     2668+imp,       <4600           ; Imp stream at 2668 interval\r\n   113\t        spl     2,              <4650\r\n   114\t        jmp     5335+imp,       <4700           ; Imp stream at 5335 interval\r\n   115\t        jmp     2+imp,          <4750           ; Imp stream at +2 offset\r\n   116\t\r\n   117\t; Imp template\r\n   118\ticopy   mov     0,              2667            ; Basic imp: mov 0, 2667\r\n   119\t\r\n   120\tstart   spl     bomber\r\n   121\t        jmp     core\r\n   122\tbomber  add     #7, bptr\r\n   123\t        mov     data, @bptr\r\n   124\t        jmp     bomber\r\n   125\tbptr    dat     300, 300\r\n   126\t\r\n   127\t        end     start\r\n"]
