[157.835908, "i", "cat > /tmp/hybrid1.red <<'EOF'\n;redcode-94\n;name Paper Bomber Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl paper\n      spl b2\n      spl b3\n      jmp b1\nb1    add #4,p1\n      mov bomb,@p1\n      jmp b1\nb2    add #7,p2\n      mov bomb,@p2\n      jmp b2\nb3    add #13,p3\n      mov bomb,@p3\n      jmp b3\np1 dat 300,300\np2 dat 301,301\np3 dat 302,302\nbomb dat 0,0\npaper spl 1\nloop mov copy,*pp\n     add one,pp\n     mov copy,@pp\n     add #step,pp\n     jmp loop\ncopy spl 0,0\npp dat step,step*2\none dat 1,1\nend start\nEOF\ncat > /tmp/hybrid2.red <<'EOF'\n;redcode-94\n;name Paper Carpet Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 2667\nstart spl paper\n      spl b2\n      jmp b1\nb1    add #4,p1\n      mov bomb,@p1\n      jmp b1\nb2    add #7,p2\n      mov bomb,@p2\n      jmp b2\np1 dat 300,300\np2 dat 301,301\nbomb dat 0,0\npaper spl 1\n      spl 1\nloop  mov copy,*pp\n      add one,pp\n      mov copy,@pp\n      add #step,pp\n      jmp loop\ncopy  spl 0,0\npp    dat step,step*2\none   dat 1,1\nend start\nEOF\nfor f in /tmp/hybrid1.red /tmp/hybrid2.red; do echo ==== $f ====; /usr/local/bin/pmars -b -r 100 -f $f warriors/stone.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/paper.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/vampire.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/snake.red; /usr/local/bin/pmars -b -r 100 -f $f warriors/g2-clear.red; done\n"]
[157.836216, "o", "cat > /tmp/hybrid1.red <<'EOF'\r\n\u001b[?2004l\r"]
[157.836491, "o", "\u001b[?2004h> ;redcode-94\r\n\u001b[?2004l\r\u001b[?2004h> ;name Paper Bomber Hybrid\r\n\u001b[?2004l\r\u001b[?2004h> "]
