[12.365664, "o", "pmars-0.9.4/config/94xm.opt\r\npmars-0.9.4/config/mw.mac\r\npmars-0.9.4/config/pmars.mac\r\npmars-0.9.4/config/tinylp.opt\r\npmars-0.9.4/config/94nop.opt\r\npmars-0.9.4/config/94x.opt\r\npmars-0.9.4/config/nano.opt\r\npmars-0.9.4/config/94b.opt\r\npmars-0.9.4/config/mp.opt\r\npmars-0.9.4/config/94t.opt\r\npmars-0.9.4/config/94.opt\r\npmars-0.9.4/config/tiny.opt\r\npmars-0.9.4/config/88.opt\r\npmars-0.9.4/config/icws.opt\r\npmars-0.9.4/config/lp.opt\r\npmars-0.9.4/config/94m.opt\r\npmars-0.9.4/.pc/.quilt_series\r\npmars-0.9.4/.pc/.version\r\npmars-0.9.4/.pc/.quilt_patches\r\npmars-0.9.4/.pc/applied-patches\r\npmars-0.9.4/README\r\npmars-0.9.4/doc/pmars.txt\r\npmars-0.9.4/doc/primer.94\r\npmars-0.9.4/doc/corewar-faq.html\r\npmars-0.9.4/doc/corewar-glossary.html\r\npmars-0.9.4/doc/whatsnew.080\r\npmars-0.9.4/doc/Makefile\r\npmars-0.9.4/doc/pmars.6\r\npmars-0.9.4/doc/makedoc.ex\r\npmars-0.9.4/doc/primer.cdb\r\n"]
[12.368027, "o", "\u001b[?2004hroot@f6f00ca15204:/app# "]
[12.541165, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Fast Hybrid\n;author assistant\n;strategy Multi-process paper with imp support\n;assert CORESIZE == 8000\n\nstep    equ 2667\nimp     equ 4000\n\nstart   spl     paper\n        spl     launcher\n        jmp     impstart\n\n; Fast replicator: two copies per iteration, with a large coprime stride\npaper   spl     1\n        spl     1\n        mov     copy, *p\n        add     one, p\n        mov     copy, @p\n        add     stepv, p\n        jmp     -4\ncopy    spl     0, 0\np       dat     step, step*2\none     dat     1, 1\nstepv   dat     step, step\n\n; Launch several separated imp streams\nlauncher spl     2\n        spl     1\n        jmp     impstart\n        jmp     impstart+2667\n        spl     2\n        jmp     impstart+5334\n        jmp     impstart+1\n\nimpstart mov     0, imp\n        jmp     -1\n\n        end     start\nEOF\nls -l my_warrior.red\n"]
[12.541661, "o", "cat > my_warrior.red <<'EOF'\r\n\u001b[?2004l\r"]
