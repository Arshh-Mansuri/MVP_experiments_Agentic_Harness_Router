[13.012942, "o", "\u001b[H\u001b[J\u001b[H\u001bM  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM        Default \"half-window\" is half of the screen height.\u001b[m\r\n\u001b[H\u001bM        Default \"window\" is the screen height.\u001b[m\r\n\u001b[H\u001bM        ---------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  R                    Repaint screen, discarding buffered input.\u001b[m\r\n\u001b[H\u001bM  r  ^R  ^L            Repaint screen.\u001b[m\r\n\u001b[H\u001bM  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n\u001b[H\u001bM  F                    Forward forever; like \"tail -f\".\u001b[m\r\n\u001b[H\u001bM  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n\u001b[H\u001bM  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n\u001b[H\u001bM  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  ESC"]
[13.012957, "o", "-)  RightArrow "]
[13.013108, "o", "*  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n\u001b[H\u001bM  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n\u001b[H\u001bM  h  H                "]
[13.013137, "o", " Display this help.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[H\u001bM      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n\u001b[H\u001bM      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[Klog file: \u001b[Kt\bt\u001b[Ka\ba\u001b[Kt\bt\u001b[Ku\bu\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ks\bs\u001b[Kh\bh\u001b[Ko\bo\u001b[Kr\br\u001b[Kt\bt\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kb\bb"]
[13.013397, "o", "\u001b[Kr\br\u001b[Ka\ba\u001b[Kn\bn\u001b[Kc\bc\u001b[Kh\bh\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Kl\bl\u001b[Ko\bo\u001b[Kg\bg\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ko\bo\u001b[Kn\bn\u001b[Ke\be\u001b[Kl\bl\u001b[Ki\bi\u001b[Kn\bn\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kd\bd\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kr\br\u001b[Ka\ba\u001b[Kt\bt\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kg\bg\u001b[Kr\br\u001b[Ka\ba\u001b[Kp\bp\u001b[Kh\bh\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ka\ba\u001b[Kl\bl\u001b[Kl\bl\u001b[K \b \u001b[K-\b-\u001b[K8\b8\r\u001b[K"]
