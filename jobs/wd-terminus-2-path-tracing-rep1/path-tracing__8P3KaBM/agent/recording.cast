[569.75857, "o", "\u001b[01m\u001b[Kimage.c:5:1:\u001b[m\u001b[K \u001b[01;31m\u001b[Kerror: \u001b[m\u001b[Kexpected declaration or statement at end of input\r\n    5 | \u001b[01;31m\u001b[Kint\u001b[m\u001b[K main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x-1200.)/1200.,Y=y/900.,u=X*X*(1-Y)*(1-Y),v=pow(Y,1.5);int r=146+40*v+13*u,g=190+26*v+7*u,b=255;double dx=x-1200,dy=y-990;if(dx*dx/(185.*185.)+dy*dy/(180.*180.)<1&&y<1170)r=51,g=10,b=10;else if(y>=900){double d=y-900,q=(x-1200)/((2./3)*d),z=1800/d;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;double L=0,R=0;if(y>=1175&&y<1200){L=925-(y-1175)*4.24;R=1272+(y-1175)*.24;}else if(y<1250){L=819-(y-1200)*3.1;R=1278-(y-1200)*.92;}else if(y<1300){L=664-(y-1250)*2.16;R=1232-(y-1250)*1.84;}else if(y<1350){L=556-(y-1300)*1.32;R=1140-(y-1300)*2.68;}else if(y<1400){L=490+(y-1350)*.02;R=1006-(y-1350)*4.02;if(x>L&&x<R)r=g=b=(int)(r*.303);}fputc(r,f);fputc(g,f);fputc(b,f);}fclose(f);return 0;}\r\n      | \u001b[01;31m\u001b[K^~~\u001b[m\u001b[K\r\n"]
