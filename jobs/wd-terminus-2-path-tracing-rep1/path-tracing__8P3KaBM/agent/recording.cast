[82.738028, "i", "python3 - <<'PY'\nimport struct,math\n\ndef read(fn):\n f=open(fn,'rb'); t=[]\n while len(t)<4:\n  s=f.readline()\n  if s.startswith(b'#'):continue\n  t+=s.split()\n w,h,m=map(int,t[1:4]); d=f.read(); return w,h,bytes(d)\na=read('image.ppm');b=read('reconstructed.ppm');print('sizes',a[:2],b[:2],len(a[2]),len(b[2]))\nA,B=a[2],b[2]; ss=se=0\nfor x,y in zip(A,B): ss+=(x-y)*(x-y); se+=x*x\nprint('rmse',math.sqrt(ss/len(A)),'similarity',1-math.sqrt(ss/se))\nfor y in [0,300,600,800,900,950,1000,1100,1200,1500,1700]:\n print(y, [tuple(A[(y*2400+x)*3:(y*2400+x+1)*3]) for x in [0,600,1200,1800,2399]], [tuple(B[(y*2400+x)*3:(y*2400+x+1)*3]) for x in [0,600,1200,1800,2399]])\nPY\nwc -c image.c; gzip -c image.c | wc -c; ls -l reconstructed.ppm\n"]
