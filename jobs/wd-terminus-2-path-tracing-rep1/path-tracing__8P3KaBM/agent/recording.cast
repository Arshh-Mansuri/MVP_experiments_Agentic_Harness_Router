[595.1369, "i", "python3 - <<'PY'\nimport math\n\ndef tok():\n for s in open('image.ppm','rb'):\n  if not s.startswith(b'#'):yield from s.split()\ng=tok();next(g);W=int(next(g));H=int(next(g));next(g)\nf=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read()\nS=[[0,0,0] for _ in range(4)]\nfor i,z in enumerate(g):\n a=int(z);b=B[i];d=a-b; pix=i//3; y=pix//W\n if y<900:k=0\n elif a in (20,46):k=3\n elif a==51:k=1\n else:k=2\n S[k][0]+=d*d;S[k][1]+=a*a;S[k][2]+=1\nfor k,(e,n,c) in enumerate(S):print(k,'rmse',math.sqrt(e/(c*3)),'sim',1-math.sqrt(e/n) if n else 0,'pixels',c//3)\nPY\n"]
