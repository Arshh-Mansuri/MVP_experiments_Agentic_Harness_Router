[166.079094, "i", "cat > image.c <<'EOF'\n#include<stdio.h>\n#include<math.h>\n#define W 2400\n#define H 1800\nint main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x-1200.)/1200,Y=y/900.,u=X*X*(1-Y)*(1-Y);int r=146+40*Y+13*u,g=190+26*Y+7*u,b=255;double dx=x-1200,dy=y-1000;/* red sphere */\nif(dx*dx/185./185.+dy*dy/195./195.<1){r=51;g=10;b=10;}\nelse if(y>=900){double d=y-900,q=x/(.67*d),z=1300/d-.5;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;/* contact shadow */if(d>190&&d<430){double s=(x-1200)/500.,t=(d-260)/180.;double sh=exp(-s*s-t*t);r*=1-.7*sh;g*=1-.7*sh;b*=1-.7*sh;}}\nfputc(r<0?0:r>255?255:r,f);fputc(g<0?0:g>255?255:g,f);fputc(b<0?0:b>255?255:b,f);}fclose(f);}\nEOF\ngcc -static -O2 -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\ndef ts(fn):\n f=open(fn,'rb')\n for s in f:\n  if not s.startswith(b'#'):yield from s.split()\ng=ts('image.ppm');[next(g) for _ in range(4)];f=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read();ss=se=0\nfor i,v in enumerate(g):\n d=int(v)-B[i];ss+=d*d;se+=int(v)*int(v)\nprint('similarity',1-math.sqrt(ss/se),'rmse',math.sqrt(ss/(2400*1800*3)))\nPY\ngzip -c image.c | wc -c\n"]
[166.086713, "o", "cat > image.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include<stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include<math.h>\r\n\u001b[?2004l\r\u001b[?2004h> #define W 2400\r\n\u001b[?2004l\r\u001b[?2004h> #define H 1800\r\n\u001b[?2004l\r\u001b[?2004h> int main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x-1200.)/1200,Y=y/900.,u=X*X*(1-Y)*(1-Y);int r=146+40*Y+13*u,g=190+26*Y+7*u,b=255;double dx=x-1200,dy=y-1000;/* red sphere */\r\n\u001b[?2004l\r\u001b[?2004h> if(dx*dx/185./185.+dy*dy/195./195.<1){r=51;g=10;b=10;}\r\n\u001b[?2004l\r\u001b[?2004h> else if(y>=900){double d=y-900,q=x/(.67*d),z=1300/d-.5;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;/* contact shadow */if(d>190&&d<430){double s=(x-1200)/500.,t=(d-260)/180.;double sh=exp(-s*s-t*t);r*=1-.7*sh;g*=1-.7*sh;b*=1-.7*sh;}}\r\n\u001b[?2004l\r\u001b[?2004h> fputc(r<0?0:r>255?255:r,f);fputc(g<0?0:g>255?255:g,f);fputc(b<0?0:b>255?255:b,f);}fclose(f);}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
