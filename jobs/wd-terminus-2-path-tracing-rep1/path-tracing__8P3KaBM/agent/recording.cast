[544.840842, "i", "cat > image.c <<'EOF'\n#include<stdio.h>\n#include<math.h>\n#define W 2400\n#define H 1800\nint main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x-1200.)/1200.,Y=y/900.,u=X*X*(1-Y)*(1-Y),v=pow(Y,1.5);int r=146+40*v+13*u,g=190+26*v+7*u,b=255;double dx=x-1200,dy=y-990;if(dx*dx/(185.*185.)+dy*dy/(180.*180.)<1&&y<1170)r=51,g=10,b=10;else if(y>=900){double d=y-900,q=(x-1200)/((2./3)*d),z=1800/d;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;double L=0,R=0;if(y>=1165&&y<1200){L=900-(y-1165)*2.31;R=1360-(y-1165)*2.34;}else if(y<1300){L=819-(y-1200)*2.63;R=1278-(y-1200)*1.38;}else if(y<1400){L=556-(y-1300)*.65;R=1140-(y-1300)*2.75;}else if(y<1450){L=491+(y-1400)*3.5;R=865-(y-1400)*2.5;}if(x>L&&x<R)r=g=b=(int)(r*.303);}fputc(r,f);fputc(g,f);fputc(b,f);}fclose(f);return 0;}\nEOF\ngcc -static -o image image.c -lm && ./image\nls -l image.c reconstructed.ppm\ngzip -c image.c | wc -c\n"]
