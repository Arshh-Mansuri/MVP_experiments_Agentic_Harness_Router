[238.833018, "i", "python3 - <<'PY'\nimport math\n\ndef raw(fn):\n with open(fn,'rb') as f:\n  for s in f:\n   if not s.startswith(b'#'):\n    yield from s.split()\ng=raw('image.ppm')\nnext(g); next(g); next(g); next(g)\nf=open('reconstructed.ppm','rb'); f.readline(); f.readline(); f.readline(); B=f.read()\nss=se=0\nfor i,z in enumerate(g):\n x=int(z); y=B[i]; ss+=(x-y)*(x-y); se+=x*x\nprint('similarity',1-math.sqrt(ss/se),'rmse',math.sqrt(ss/len(B)))\nPY\n"]
