[925.729246, "i", "cat >/tmp/fit.c <<'EOF'\n#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\ntypedef struct{short x,y,c;} P;\nint main(){FILE*f=fopen(\"image.ppm\",\"r\");char s[8];int w,h,m;fscanf(f,\"%s%d%d%d\",s,&w,&h,&m);P*p=malloc(100000*sizeof(P));int n=0;\nfor(int y=0;y<h;y++)for(int x=0;x<w;x++){int r,g,b;fscanf(f,\"%d%d%d\",&r,&g,&b);if(y>=900&&x%8==0&&y%8==0&&(r==67||r==152)){p[n++]=(P){x,y,r};}}\nfclose(f);long best=1L<<60;int bc=0;for(int C=1000;C<=2600;C++){long e=0;for(int i=0;i<n;i++){int d=p[i].y-900,q=floor((p[i].x-1200.)/((2./3)*d)),z=floor(C/(double)d),v=((q+z)&1)?67:152;e+=(v-p[i].c)*(v-p[i].c);}if(e<best){best=e;bc=C;printf(\"best C=%d error=%ld\\n\",bc,best);}}fprintf(stderr,\"FINAL %d %ld samples=%d\\n\",bc,best,n);}\nEOF\ngcc -O3 -o /tmp/fit /tmp/fit.c -lm && /tmp/fit\n"]
[925.72997, "o", "cat >/tmp/fit.c <<'EOF'\r\n#include<stdio.h>\r\n#include<stdlib.h>\r\n#include<math.h>\r\ntypedef struct{short x,y,c;} P;\r\nint main(){FILE*f=fopen(\"image.ppm\",\"r\");char s[8];int w,h,m;fscanf(f,\"%s%d%d%d\",s,&w,&h,&m);P*p=malloc(100000*sizeof(P));int n=0;\r\nfor(int y=0;y<h;y++)for(int x=0;x<w;x++){int r,g,b;fscanf(f,\"%d%d%d\",&r,&g,&b);if(y>=900&&x%8==0&&y%8==0&&(r==67||r==152)){p[n++]=(P){x,y,r};}}\r\nfclose(f);long best=1L<<60;int bc=0;for(int C=1000;C<=2600;C++){long e=0;for(int i=0;i<n;i++){int d=p[i].y-900,q=floor((p[i].x-1200.)/((2./3)*d)),z=floor(C/(double)d),v=((q+z)&1)?67:152;e+=(v-p[i].c)*(v-p[i].c);}if(e<best){best=e;bc=C;printf(\"best C=%d error=%ld\\n\",bc,best);}}fprintf(stderr,\"FINAL %d %ld samples=%d\\n\",bc,best,n);}\r\nEOF\r\ngcc -O3 -o /tmp/fit /tmp/fit.c -lm && /tmp/fit\r\n"]
