[430.308499, "i", "python3 - <<'PY'\ndef p3rows():\n def g():\n  for s in open('image.ppm','rb'):\n   if not s.startswith(b'#'):yield from s.split()\n q=g();next(q);W=int(next(q));H=int(next(q));next(q)\n for y in range(H):\n  yield [tuple(int(next(q)) for _ in range(3)) for x in range(W)]\ndef runs(row):\n out=[]; st=0; c=row[0]\n for x,v in enumerate(row[1:],1):\n  if v!=c:\n   if x-st>10:out.append((st,x-1,x-st,c))\n   st=x;c=v\n if 2400-st>10:out.append((st,2399,2400-st,c))\n return out\nfor y,row in zip(range(1800),p3rows()):\n if y in (900,920,950,1000,1100,1200,1300,1400,1500,1600,1700):print(y,runs(row)[:18])\nPY\n"]
