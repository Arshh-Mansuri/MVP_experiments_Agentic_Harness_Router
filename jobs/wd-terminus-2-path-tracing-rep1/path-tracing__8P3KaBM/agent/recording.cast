[15.875483, "i", "python3 - <<'PY'\nfrom collections import Counter\np='image.ppm'\nwith open(p,'rb') as f:\n    tok=[]\n    while len(tok)<3:\n        s=f.readline()\n        if not s: break\n        if s.startswith(b'#'): continue\n        tok += s.split()\n    w,h,m=map(int,tok[:3]); print('SIZE',w,h,'MAX',m)\n    c=Counter(); rows=[]; vals=[]\n    for y in range(h):\n        row=[]\n        while len(row)<3*w:\n            s=f.readline()\n            if not s: break\n            if s.startswith(b'#'): continue\n            row += list(map(int,s.split()))\n        c.update(zip(row[0::3],row[1::3],row[2::3]))\n        if y%(h//30)==0:\n            # 80 horizontal blocks, average RGB\n            for x in range(80):\n                a=(x*w)//80; b=((x+1)*w)//80\n                q=row[3*a:3*b]\n                if q:\n                    n=len(q)//3; r=sum(q[0::3])/n; g=sum(q[1::3])/n; bl=sum(q[2::3])/n\n                    lum=(r+g+bl)/3\n                    rowc=' .:-=+*#%@'[min(9,int(lum*10/256))]\n                    row.append(0)\n                    vals.append((y,x,rowc,r,g,bl))\n    print('COLORS',len(c),'TOP',c.most_common(20))\n    for y in range(0,h,h//30):\n        print(''.join(v[2] for v in vals if v[0]==y))\nPY\n"]
