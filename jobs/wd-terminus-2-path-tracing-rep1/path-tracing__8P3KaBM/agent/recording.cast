[223.904607, "i", "python3 -c 'import math\nf=open(\"image.ppm\",\"rb\")\ndef g():\n for s in f:\n  if not s.startswith(b\"#\"):\n   for z in s.split():yield int(z)\ng=g();next(g);next(g);next(g);next(g);q=open(\"reconstructed.ppm\",\"rb\");q.readline();q.readline();q.readline();B=q.read();ss=se=0\nfor i,x in enumerate(g):\n y=B[i];ss+=(x-y)*(x-y);se+=x*x\nprint(\"similarity\",1-math.sqrt(ss/se),\"rmse\",math.sqrt(ss/(2400*1800*3)))'\n"]
