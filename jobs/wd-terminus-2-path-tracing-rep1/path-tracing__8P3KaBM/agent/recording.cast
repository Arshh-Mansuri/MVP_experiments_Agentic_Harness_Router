[552.858987, "i", "python3 - <<'PY'\ndef rows():\n def g():\n  for s in open('image.ppm','rb'):\n   if not s.startswith(b'#'):yield from s.split()\n q=g();next(q);W=int(next(q));H=int(next(q));next(q)\n for y in range(H):yield [tuple(int(next(q)) for _ in range(3)) for _ in range(W)]\nfor y,row in zip(range(1800),rows()):\n if y%25 or y<1100:continue\n xs=[x for x,c in enumerate(row) if c in ((20,20,20),(46,46,46))]\n if xs:\n  runs=[];a=xs[0];p=a\n  for x in xs[1:]:\n   if x>p+1:\n    if p-a>8:runs.append((a,p))\n    a=x\n   p=x\n  if p-a>8:runs.append((a,p))\n  print(y,runs)\nPY\n"]
