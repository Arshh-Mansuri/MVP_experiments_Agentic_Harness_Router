[135.126559, "i", "python3 - <<'PY'\ndef gen():\n f=open('image.ppm','rb')\n while 1:\n  s=f.readline()\n  if not s:return\n  if not s.startswith(b'#'):yield from s.split()\ng=gen(); [next(g) for _ in range(4)]\nW,H=2400,1800\nP=[tuple(int(next(g)) for _ in range(3)) for _ in range(W*H)]\nfor y in [0,100,300,500,700,800,850,880,900,920,1000,1200,1500,1700]:\n print('Y',y,[(x,P[y*W+x]) for x in range(0,W,200)])\nprint('vertical center')\nfor y in range(0,H,50):print(y,P[y*W+1200])\n# runs on selected rows\nfor y in [900,920,1000,1200,1500,1700]:\n r=[];last=P[y*W]; st=0\n for x in range(1,W):\n  if P[y*W+x]!=last:\n   if x-st>20:r.append((st,x-1,last))\n   st=x;last=P[y*W+x]\n if W-st>20:r.append((st,W-1,last))\n print('RUN',y,r[:30])\nPY\n"]
[135.128233, "o", "python3 - <<'PY'\r\n"]
