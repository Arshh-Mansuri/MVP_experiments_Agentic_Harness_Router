[168.511485, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> def ts(fn):\r\n\u001b[?2004l\r\u001b[?2004h>  f=open(fn,'rb')\r\n\u001b[?2004l\r\u001b[?2004h>  for s in f:\r\n\u001b[?2004l\r\u001b[?2004h>   if not s.startswith(b'#'):yield from s.split()\r\n\u001b[?2004l\r\u001b[?2004h> g=ts('image.ppm');[next(g) for _ in range(4)];f=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read();ss=se=0\r\n\u001b[?2004l\r\u001b[?2004h> for i,v in enumerate(g):\r\n\u001b[?2004l\r\u001b[?2004h>  d=int(v)-B[i];ss+=d*d;se+=int(v)*int(v)\r\n\u001b[?2004l\r\u001b[?2004h> print('similarity',1-math.sqrt(ss/se),'rmse',math.sqrt(ss/(2400*1800*3)))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
