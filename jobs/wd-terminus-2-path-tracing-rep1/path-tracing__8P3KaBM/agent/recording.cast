[46.77719, "o", " xs=[x for x in range(w) if (lambda c:c[0]>c[1]*1.5 and c[0]>c[2]*1.5)(p[y*w+x])]\r\n\u001b[?2004l\r"]
[46.777494, "o", "\u001b[?2004h> "]
[46.777552, "o", " if xs and (y%20==0 or y<1000): print('RED',y,min(xs),max(xs),len(xs))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
