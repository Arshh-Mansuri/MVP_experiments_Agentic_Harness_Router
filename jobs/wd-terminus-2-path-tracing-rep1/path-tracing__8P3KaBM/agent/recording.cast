[118.220281, "i", "python3 - <<'PY'\ndef ts(fn):\n f=open(fn,'rb')\n while 1:\n  s=f.readline()\n  if not s: return\n  if s.startswith(b'#'): continue\n  yield from s.split()\ng=ts('image.ppm'); print([next(g) for _ in range(20)])\n# fresh generator, consume header, then collect decoded RGB\nq=ts('image.ppm'); print('header',[next(q) for _ in range(4)])\nfor k in range(5): print('rgb',k,[int(next(q)) for _ in range(3)])\n# selected pixels\nq=ts('image.ppm'); [next(q) for _ in range(4)]\npts={(0,0),(1200,0),(0,300),(1200,300),(1200,800),(0,900),(600,900),(1200,900),(1200,1000)}\nfor y in range(1800):\n for x in range(2400):\n  c=tuple(int(next(q)) for _ in range(3))\n  if (x,y) in pts: print((x,y),c)\n  if x==2399 and y>=1000 and len(pts)==0: break\n # cannot cheaply stop because iterator order; continue\nPY\n"]
