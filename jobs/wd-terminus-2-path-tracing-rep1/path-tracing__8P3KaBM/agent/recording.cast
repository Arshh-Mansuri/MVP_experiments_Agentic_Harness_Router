[198.014107, "i", "python3 -c 'import math\nf=open(\"image.ppm\",\"rb\");t=[]\nfor s in f:\n if not s.startswith(b\"#\"):t+=s.split()\nA=list(map(int,t[4:]));f=open(\"reconstructed.ppm\",\"rb\");f.readline();f.readline();f.readline();B=f.read();ss=se=0\nfor x,y in zip(A,B):ss+=(x-y)**2;se+=x*x\nprint(\"similarity\",1-math.sqrt(ss/se),\"rmse\",math.sqrt(ss/len(A)))'\ngzip -c image.c | wc -c\nls -l image.c reconstructed.ppm\n"]
