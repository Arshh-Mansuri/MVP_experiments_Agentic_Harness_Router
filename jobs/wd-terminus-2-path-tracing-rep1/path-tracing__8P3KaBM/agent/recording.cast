[46.741603, "i", "python3 - <<'PY'\nfrom collections import Counter\nf=open('image.ppm','rb'); t=[]\nwhile len(t)<4:\n s=f.readline()\n if s.startswith(b'#'): continue\n t+=s.split()\nw,h,m=map(int,t[1:4]); a=[]\nfor s in f:\n if not s.startswith(b'#'): a+=map(int,s.split())\np=list(zip(a[0::3],a[1::3],a[2::3])); print(w,h,len(p))\n# dominant colors per broad row bands\nfor y in range(0,h,100):\n c=Counter(p[y*w:(y+100)*w]); print(y,c.most_common(5))\n# 100x45 map, classify by RGB properties / brightness\nfor yy in range(45):\n y=min(h-1,(yy*h)//45); out=''\n for xx in range(100):\n  x=min(w-1,(xx*w)//100); r,g,b=p[y*w+x]; z=(r+g+b)//3\n  if r>g*1.5 and r>b*1.5: q='R'\n  elif r<35 and g<35 and b<35:q='@'\n  elif abs(r-g)<3 and abs(g-b)<3:\n   q=' .'[z>80] if z<130 else ('+' if z<180 else '#')\n  elif b>r+35:q='S'\n  elif z<80:q='d'\n  else:q='o'\n  out+=q\n print(out)\n# red bounds and per-row bounds\nfor y in range(h):\n xs=[x for x in range(w) if (lambda c:c[0]>c[1]*1.5 and c[0]>c[2]*1.5)(p[y*w+x])]\n if xs and (y%20==0 or y<1000): print('RED',y,min(xs),max(xs),len(xs))\nPY\n"]
