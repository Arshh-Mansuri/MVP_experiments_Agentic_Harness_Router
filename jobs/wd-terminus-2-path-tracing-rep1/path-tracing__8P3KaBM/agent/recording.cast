[76.357442, "i", "cat > image.c <<'EOF'\n#include <stdio.h>\n#include <math.h>\n#define W 2400\n#define H 1800\nint main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x+0.5-1200)/1200.,Y=(y+0.5-900)/900.;unsigned char r,g,b;\n/* sky */\n double rr=148+40*(y/900.),gg=191+25*(y/900.);r=rr;g=gg;b=255;\n /* perspective ground: camera rays meet plane at z=1/(Y), with a mild wide-angle correction */\n if(y>=900){double z=2.35/(Y), q=X*z;int ix=(int)floor(q),iz=(int)floor(z);int ck=(ix+iz)&1;r=g=b=ck?152:67;\n  /* soft dark cast shadow behind the sphere */\n  double sx=q, sz=z-1.0, sh=exp(-((sx*sx)/.7+(sz*sz)/.9));\n  if(sh>.02){double v=1-.72*sh;r*=v;g*=v;b*=v;}\n }\n /* sphere, projected almost circular and sitting on the plane */\n double dx=(x-1200)/1.0,dy=(y-985)/1.0, rr2=dx*dx+dy*dy;\n if(rr2<184.0*184.0){double zz=sqrt(1-rr2/(184.0*184.0));double lx=-.45,ly=-.65,lz=.62;double nx=dx/184,ny=dy/184,nz=zz;double d=nx*lx+ny*ly+nz*lz;double v=.18+.82*(d>0?d:0);r=51*v;g=10*v;b=10*v;}\n fputc(r,f);fputc(g,f);fputc(b,f);}fclose(f);return 0;}\nEOF\ngcc -static -O2 -o image image.c -lm && ./image\nls -l image.c reconstructed.ppm\n"]
