[403.84557, "i", "python3 - <<'PY'\ndef pix(fn):\n g=[]\n for s in open(fn,'rb'):\n  if not s.startswith(b'#'):g+=s.split()\n for y in range(900,1800):\n  i=(y*2400+1200)*3\n  yield y,tuple(map(int,g[i:i+3]))\nfor fn in ['image.ppm','reconstructed.ppm']:\n print(fn); last=None;st=900\n for y,c in pix(fn):\n  if c!=last:\n   if last is not None and y-st>=3:print(st,y-1,last)\n   st=y;last=c\n print(st,1799,last)\nPY\n"]
[403.860021, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
