[373.303164, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();s=s.replace('q=x/(.67*d),z=1300/d-.5','q=(x-1200)/(.667*d),z=1600/d');open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\ndef tok():\n for s in open('image.ppm','rb'):\n  if not s.startswith(b'#'):yield from s.split()\ng=tok();next(g);next(g);next(g);next(g);f=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read();ss=se=0\nfor i,z in enumerate(g):\n x=int(z);d=x-B[i];ss+=d*d;se+=x*x\nprint('similarity',1-math.sqrt(ss/se))\nPY\n"]
