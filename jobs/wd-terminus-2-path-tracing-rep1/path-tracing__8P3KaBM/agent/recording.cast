[98.278429, "i", "python3 - <<'PY'\nimport math\n\ndef toks(fn):\n with open(fn,'rb') as f:\n  for line in f:\n   if line.startswith(b'#'): continue\n   for z in line.split(): yield z\n\ndef ref():\n g=toks('image.ppm'); assert next(g)==b'P3'; w=int(next(g));h=int(next(g));next(g)\n for z in g: yield int(z)\ng=ref(); f=open('reconstructed.ppm','rb');\nassert f.readline()==b'P6\\n'; w,h=map(int,f.readline().split()); assert f.readline()==b'255\\n'; B=f.read()\nss=se=0;n=0\nsamples={}\nfor i,x in enumerate(g):\n y=B[i]\n d=x-y;ss+=d*d;se+=x*x;n+=1\n if i%3==0 and i//3 in [0,2400*300,2400*600,2400*800,2400*900,2400*1000,2400*1200,2400*1500,2400*1700]: samples[i//3]=(x,y,B[i:i+3])\nprint('pixels',n//3,'rmse',math.sqrt(ss/n),'similarity',1-math.sqrt(ss/se))\nprint(samples)\nPY\ngzip -c image.c | wc -c\n"]
[98.278966, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.28434, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def toks(fn):\r\n\u001b[?2004l\r\u001b[?2004h>  with open(fn,'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>   for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>    if line.startswith(b'#'): continue\r\n\u001b[?2004l\r\u001b[?2004h>    for z in line.split(): yield z\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ref():\r\n\u001b[?2004l\r\u001b[?2004h>  g=toks('image.ppm'); assert next(g)==b'P3'; w=int(next(g));h=int(next(g));next(g)\r\n\u001b[?2004l\r\u001b[?2004h>  for z in g: yield int(z)\r\n\u001b[?2004l\r\u001b[?2004h> g=ref(); f=open('reconstructed.ppm','rb');\r\n\u001b[?2004l\r\u001b[?2004h> assert f.readline()==b'P6\\n'; w,h=map(int,f.readline().split()); assert f.readline()==b'255\\n'; B=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> ss=se=0;n=0\r\n\u001b[?2004l\r\u001b[?2004h> samples={}\r\n\u001b[?2004l\r\u001b[?2004h> for i,x in enumerate(g):\r\n\u001b[?2004l\r\u001b[?2004h>  y=B[i]\r\n\u001b[?2004l\r\u001b[?2004h>  d=x-y;ss+=d*d;se+=x*x;n+=1\r\n\u001b[?2004l\r\u001b[?2004h>  if i%3==0 and i//3 in [0,2400*300,2400*600,2400*800,2400*900,2400*1000,2400*1200,2400*1500,2400*1700]: samples[i//3]=(x,y,B[i:i+3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.286369, "o", "print('pixels',n//3,'rmse',math.sqrt(ss/n),'similarity',1-math.sqrt(ss/se))\r\n\u001b[?2004l\r\u001b[?2004h> print(samples)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
