[293.312908, "i", "cat > image.c <<'EOF'\n#include<stdio.h>\n#include<math.h>\n#define W 2400\n#define H 1800\nint main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x-1200.)/1200,Y=y/900.,u=X*X*(1-Y)*(1-Y),v=pow(Y,1.5);int r=146+40*v+13*u,g=190+26*v+7*u,b=255;double dx=x-1200,dy=y-1000;if(dx*dx/185./185.+dy*dy/145./145.<1&&y<1165){r=51;g=10;b=10;}else if(y>=900){double d=y-900,q=x/(.67*d),z=1300/d-.5;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;}fputc(r>255?255:r,f);fputc(g>255?255:g,f);fputc(b,f);}fclose(f);}\nEOF\ngcc -static -O2 -o image image.c -lm && ./image\nls -l image.c reconstructed.ppm\ngzip -c image.c | wc -c\n"]
