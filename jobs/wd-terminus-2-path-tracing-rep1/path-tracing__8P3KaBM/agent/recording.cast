[888.342291, "i", "cat >/tmp/fit.c <<'EOF'\n#include<stdio.h>\n#include<math.h>\nint main(){FILE*f=fopen(\"image.ppm\",\"r\");char s[32];int w,h,m;fscanf(f,\"%s%d%d%d\",s,&w,&h,&m);long best=1L<<60;int bc=0;for(int C=1000;C<=2600;C++){rewind(f);fscanf(f,\"%s%d%d%d\",s,&w,&h,&m);long e=0;for(int y=0;y<h;y++)for(int x=0;x<w;x++){int r,g,b;fscanf(f,\"%d%d%d\",&r,&g,&b);if(y>=900&&x%8==0&&y%8==0&&(r==67||r==152)){int q=(int)floor((x-1200.)/((2./3)*(y-900)));int z=(int)floor(C/(double)(y-900));int v=((q+z)&1)?67:152;e+=(v-r)*(v-r);}}if(e<best){best=e;bc=C;printf(\"%d %ld\\n\",C,e);}}}\nEOF\ngcc -O3 -o /tmp/fit /tmp/fit.c -lm && /tmp/fit\n"]
[888.343868, "o", "cat >/tmp/fit.c <<'EOF'\r\n\u001b[?2004l\r"]
