[888.598394, "o", "\u001b[01m\u001b[K/tmp/fit.c:3:63:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[Kignoring return value of ‘\u001b[01m\u001b[Kfscanf\u001b[m\u001b[K’ declared with attribute ‘\u001b[01m\u001b[Kwarn_unused_result\u001b[m\u001b[K’ [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wunused-result\u0007-Wunused-result\u001b]8;;\u0007\u001b[m\u001b[K]\r\n    3 | int main(){FILE*f=fopen(\"image.ppm\",\"r\");char s[32];int w,h,m;\u001b[01;35m\u001b[Kfscanf(f,\"%s%d%d%d\",s,&w,&h,&m)\u001b[m\u001b[K;long best=1L<<60;int bc=0;for(int C=1000;C<=2600;C++){rewind(f);fscanf(f,\"%s%d%d%d\",s,&w,&h,&m);long e=0;for(int y=0;y<h;y++)for(int x=0;x<w;x++){int r,g,b;fscanf(f,\"%d%d%d\",&r,&g,&b);if(y>=900&&x%8==0&&y%8==0&&(r==67||r==152)){int q=(int)floor((x-1200.)/((2./3)*(y-900)));int z=(int)floor(C/(double)(y-900));int v=((q+z)&1)?67:152;e+=(v-r)*(v-r);}}if(e<best){best=e;bc=C;printf(\"%d %ld\\n\",C,e);}}}\r\n      |                                                               \u001b[01;35m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
