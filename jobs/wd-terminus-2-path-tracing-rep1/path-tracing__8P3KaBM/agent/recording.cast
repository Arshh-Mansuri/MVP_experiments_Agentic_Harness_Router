[317.120896, "i", "cat > image.c <<'EOF'\n#include <stdio.h>\n#include <math.h>\n#define W 2400\n#define H 1800\nint main(){\n FILE*f=fopen(\"reconstructed.ppm\",\"wb\");\n fprintf(f,\"P6\\n%d %d\\n255\\n\",W,H);\n for(int y=0;y<H;y++)for(int x=0;x<W;x++){\n  double X=(x-1200.)/1200.,Y=y/900.,u=X*X*(1-Y)*(1-Y),v=pow(Y,1.5);\n  int r=146+40*v+13*u,g=190+26*v+7*u,b=255;\n  double dx=x-1200,dy=y-990;\n  if(dx*dx/(185.*185.)+dy*dy/(180.*180.)<1&&y<1170)r=51,g=10,b=10;\n  else if(y>=900){double d=y-900,q=x/(.67*d),z=1300/d-.5;int k=((int)floor(q)+(int)floor(z))&1;r=g=b=k?67:152;}\n  fputc(r,f);fputc(g,f);fputc(b,f);\n }\n fclose(f);return 0;\n}\nEOF\ngcc -static -o image image.c -lm && ./image\nls -l image.c reconstructed.ppm\ngzip -c image.c | wc -c\n"]
[317.123543, "o", "cat > image.c <<'EOF'\r\n\u001b[?2004l\r"]
