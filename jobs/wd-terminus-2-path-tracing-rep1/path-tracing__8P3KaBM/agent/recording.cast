[324.90109, "i", "python3 - <<'PY'\nimport math\n\ndef tok():\n for s in open('image.ppm','rb'):\n  if not s.startswith(b'#'): yield from s.split()\ng=tok(); next(g); W=int(next(g)); H=int(next(g)); next(g)\nf=open('reconstructed.ppm','rb'); f.readline(); f.readline(); f.readline(); B=f.read()\nss=se=0; reg=[[0,0,0] for _ in range(3)]\nfor i,z in enumerate(g):\n x=int(z); y=B[i]; d=x-y; ss+=d*d; se+=x*x\n p=i//3; yy=p//W\n k=0 if yy<900 else (2 if ((p%W-1200)**2+(yy-990)**2<200**2) else 1)\n reg[k][0]+=d*d;reg[k][1]+=1;reg[k][2]+=x*x\nprint('similarity',1-math.sqrt(ss/se),'rmse',math.sqrt(ss/len(B)))\nfor z in reg: print('region',math.sqrt(z[0]/(z[1]*3)),'sim',1-math.sqrt(z[0]/z[2]))\nPY\n"]
