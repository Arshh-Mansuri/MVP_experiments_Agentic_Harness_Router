[791.065125, "i", "python3 - <<'PY'\nimport math\nW,H=2400,1800; step=8\n# Decode only a sparse grid from the P3 source while retaining enough data for fitting.\ndef tok():\n for s in open('image.ppm','rb'):\n  if not s.startswith(b'#'): yield from s.split()\ng=tok(); next(g); next(g); next(g); next(g)\nS=[]\nfor y in range(H):\n for x in range(W):\n  r=int(next(g)); gg=int(next(g)); b=int(next(g))\n  if y>=900 and x%step==0 and y%step==0:\n   S.append((x,y,r))\nprint('samples',len(S))\n# Fit parity only outside red/shadow colors, using observed exact checker gray values.\nS=[p for p in S if p[2] in (67,152)]\nbest=[]\nfor A in [0.64+i*.002 for i in range(31)]:\n for C in range(1500,2201,10):\n  for ph in range(4):\n   e=0\n   for x,y,r in S:\n    d=y-900\n    q=math.floor((x-1200)/(A*d))\n    z=math.floor(C/d)+ph\n    v=67 if (int(q)+int(z))&1 else 152\n    e+=(v-r)*(v-r)\n   best.append((e,A,C,ph))\nprint(sorted(best)[:10])\nPY\n"]
[791.068698, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> W,H=2400,1800; step=8\r\n\u001b[?2004l\r\u001b[?2004h> # Decode only a sparse grid from the P3 source while retaining enough data for fitting.\r\n\u001b[?2004l\r\u001b[?2004h> def tok():\r\n\u001b[?2004l\r\u001b[?2004h>  for s in open('image.ppm','rb'):\r\n\u001b[?2004l\r\u001b[?2004h>   if not s.startswith(b'#'): yield from s.split()\r\n\u001b[?2004l\r\u001b[?2004h> g=tok(); next(g); next(g); next(g); next(g)\r\n\u001b[?2004l\r\u001b[?2004h> S=[]\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(H):\r\n\u001b[?2004l\r\u001b[?2004h>  for x in range(W):\r\n\u001b[?2004l\r\u001b[?2004h>   r=int(next(g)); gg=int(next(g)); b=int(next(g))\r\n\u001b[?2004l\r\u001b[?2004h>   if y>=900 and x%step==0 and y%step==0:\r\n\u001b[?2004l\r\u001b[?2004h>    S.append((x,y,r))\r\n\u001b[?2004l\r"]
[791.068762, "o", "\u001b[?2004h> print('samples',len(S))\r\n\u001b[?2004l\r\u001b[?2004h> "]
