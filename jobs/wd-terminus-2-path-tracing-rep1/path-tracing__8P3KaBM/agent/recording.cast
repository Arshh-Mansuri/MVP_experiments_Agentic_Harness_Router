[629.82453, "i", "python3 - <<'PY'\ndef ref():\n def g():\n  for s in open('image.ppm','rb'):\n   if not s.startswith(b'#'):yield from s.split()\n q=g();next(q);W=int(next(q));H=int(next(q));next(q)\n for _ in range(W*H):yield tuple(int(next(q)) for _ in range(3))\nA=ref(); pts={(y,x) for y in [920,950,1000,1050,1100,1150,1200,1250,1300,1350,1400,1450,1500,1550,1600,1650,1700,1750] for x in [0,600,900,1500,2000]}\nR={}\nfor y in range(1800):\n for x in range(2400):\n  c=next(A)\n  if (y,x) in pts:R[y,x]=c[0]\nf=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read()\nfor y in sorted({p[0] for p in pts}):\n print(y,'ref',[R[y,x] for x in [0,600,900,1500,2000]],'out',[B[(y*2400+x)*3] for x in [0,600,900,1500,2000]])\nPY\n"]
