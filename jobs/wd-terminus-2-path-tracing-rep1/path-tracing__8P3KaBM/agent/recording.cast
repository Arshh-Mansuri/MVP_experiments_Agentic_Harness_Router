[569.411971, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();a=s.index('double L=0,R=0;');b=s.index('if(x>L&&x<R)',a)\nnew='double L=0,R=0;if(y>=1175&&y<1200){L=925-(y-1175)*4.24;R=1272+(y-1175)*.24;}else if(y<1250){L=819-(y-1200)*3.1;R=1278-(y-1200)*.92;}else if(y<1300){L=664-(y-1250)*2.16;R=1232-(y-1250)*1.84;}else if(y<1350){L=556-(y-1300)*1.32;R=1140-(y-1300)*2.68;}else if(y<1400){L=490+(y-1350)*.02;R=1006-(y-1350)*4.02);'\n# correct the intentional closing typo before insertion\nnew=new.replace('4.02);','4.02;')\ns=s[:a]+new+s[b:];open(p,'w').write(s)\nPY\ngcc -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\ndef tok():\n for s in open('image.ppm','rb'):\n  if not s.startswith(b'#'):yield from s.split()\ng=tok();[next(g) for _ in range(4)];f=open('reconstructed.ppm','rb');f.readline();f.readline();f.readline();B=f.read();ss=se=0\nfor i,z in enumerate(g):\n x=int(z);d=x-B[i];ss+=d*d;se+=x*x\nprint('similarity',1-math.sqrt(ss/se),'rmse',math.sqrt(ss/len(B)))\nPY\ngzip -c image.c | wc -c\n"]
