[30.19297, "i", "python3 - <<'PY'\nfrom collections import Counter\nf=open('image.ppm','rb'); t=[]\nwhile len(t)<4:\n s=f.readline()\n if not s: break\n if s.startswith(b'#'): continue\n t += s.split()\nassert t[0]==b'P3'\nw,h,m=map(int,t[1:4]); print('SIZE',w,h,'MAX',m)\nc=Counter(); thumb=[]\nchars=' .:-=+*#%@'\nfor y in range(h):\n a=[]\n while len(a)<3*w:\n  s=f.readline()\n  if not s: break\n  if not s.startswith(b'#'): a += map(int,s.split())\n a=list(a); c.update(zip(a[0::3],a[1::3],a[2::3]))\n if y%(h//30)==0:\n  out=''\n  for x in range(80):\n   l=(x*w)//80; r=((x+1)*w)//80; n=r-l\n   R=sum(a[3*l:3*r:3])/n; G=sum(a[3*l+1:3*r:3])/n; B=sum(a[3*l+2:3*r:3])/n\n   z=(R+G+B)/3\n   if z<35: ch=' '\n   elif R>G*1.35 and R>B*1.25: ch='R'\n   elif G>R*1.25 and G>B*1.15: ch='G'\n   elif B>R*1.25 and B>G*1.15: ch='B'\n   elif z>220: ch='@'\n   else: ch=chars[min(9,int(z*10/256))]\n   out+=ch\n  thumb.append(out)\nprint('UNIQUE COLORS',len(c)); print('TOP COLORS',c.most_common(30)); print('\\n'.join(thumb))\nPY\n"]
