#include<stdio.h>
#include<stdlib.h>
#include<math.h>
typedef struct{short x,y,c;} P;
int main(){FILE*f=fopen("image.ppm","r");char s[8];int w,h,m;fscanf(f,"%s%d%d%d",s,&w,&h,&m);P*p=malloc(100000*sizeof(P));int n=0;
for(int y=0;y<h;y++)for(int x=0;x<w;x++){int r,g,b;fscanf(f,"%d%d%d",&r,&g,&b);if(y>=900&&x%8==0&&y%8==0&&(r==67||r==152)){p[n++]=(P){x,y,r};}}
fclose(f);long best=1L<<60;int bc=0;for(int C=1000;C<=2600;C++){long e=0;for(int i=0;i<n;i++){int d=p[i].y-900,q=floor((p[i].x-1200.)/((2./3)*d)),z=floor(C/(double)d),v=((q+z)&1)?67:152;e+=(v-p[i].c)*(v-p[i].c);}if(e<best){best=e;bc=C;printf("best C=%d error=%ld\n",bc,best);}}fprintf(stderr,"FINAL %d %ld samples=%d\n",bc,best,n);}
EOF
