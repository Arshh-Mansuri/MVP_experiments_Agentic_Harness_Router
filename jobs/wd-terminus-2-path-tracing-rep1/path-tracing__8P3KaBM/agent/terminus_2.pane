[?2004hroot@1834f88c5da1:/app# cat > image.c <<'EOF'
[?2004l[?2004h> #include <stdio.h>
[?2004l[?2004h> #include <math.h>
[?2004l[?2004h> #define W 2400
[?2004l[?2004h> #define H 1800
[?2004l[?2004h> int main(){FILE*f=fopen("reconstructed.ppm","wb");fprintf(f,"P6\n%d %d\n255\n",W,H);for(int y=0;y<H;y++)for(int x=0;x<W;x++){double X=(x+0.5-1200)/1200.,Y=(y+0.5-900)/900.;unsigned char r,g,b;
[?2004l[?2004h> /* sky */
[?2004l[?2004h>  double rr=148+40*(y/900.),gg=191+25*(y/900.);r=rr;g=gg;b=255;
[?2004l[?2004h>  /* perspective ground: camera rays meet plane at z=1/(Y), with a mild wide-angle correction */
[?2004l[?2004h>  if(y>=900){double z=2.35/(Y), q=X*z;int ix=(int)floor(q),iz=(int)floor(z);int ck=(ix+iz)&1;r=g=b=ck?152:67;
[?2004l[?2004h>   /* soft dark cast shadow behind the sphere */
[?2004l[?2004h>   double sx=q, sz=z-1.0, sh=exp(-((sx*sx)/.7+(sz*sz)/.9));
[?2004l[?2004h>   if(sh>.02){double v=1-.72*sh;r*=v;g*=v;b*=v;}
[?2004l[?2004h>  }
[?2004l[?2004h>  /* sphere, projected almost circular and sitting on the plane */
[?2004l[?2004h>  double dx=(x-1200)/1.0,dy=(y-985)/1.0, rr2=dx*dx+dy*dy;
[?2004l[?2004h>  if(rr2<184.0*184.0){double zz=sqrt(1-rr2/(184.0*184.0));double lx=-.45,ly=-.65,lz=.62;double nx=dx/184,ny=dy/184,nz=zz;double d=nx*lx+ny*ly+nz*lz;double v=.18+.82*(d>0?d:0);r=51*v;g=10*v;b=10*v;}
[?2004l[?2004h>  fputc(r,f);fputc(g,f);fputc(b,f);}fclose(f);return 0;}
[?2004l[?2004h> EOF
