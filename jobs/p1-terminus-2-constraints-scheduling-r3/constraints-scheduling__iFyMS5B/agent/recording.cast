[15.964714, "i", "cat > /app/meeting_scheduled.ics <<'EOF'\nBEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Terminal-Bench//Team Meeting Scheduler//EN\nCALSCALE:GREGORIAN\nMETHOD:PUBLISH\nBEGIN:VEVENT\nUID:team-planning-20240116T123000Z@example.com\nDTSTAMP:20240101T000000Z\nDTSTART:20240116T123000Z\nDTEND:20240116T133000Z\nSUMMARY:Team Planning Meeting\nATTENDEE;CN=Alice:mailto:alice@example.com\nATTENDEE;CN=Bob:mailto:bob@example.com\nATTENDEE;CN=Carol:mailto:carol@example.com\nEND:VEVENT\nEND:VCALENDAR\nEOF\nprintf '%s\\n' '--- meeting_scheduled.ics ---'\ncat /app/meeting_scheduled.ics\nprintf '%s\\n' '--- validation ---'\ntest \"$(head -n 1 /app/meeting_scheduled.ics)\" = \"BEGIN:VCALENDAR\" && test \"$(tail -n 1 /app/meeting_scheduled.ics)\" = \"END:VCALENDAR\" && grep -q 'DTSTART:20240116T123000Z' /app/meeting_scheduled.ics && grep -q 'DTEND:20240116T133000Z' /app/meeting_scheduled.ics && grep -q 'alice@example.com' /app/meeting_scheduled.ics && grep -q 'bob@example.com' /app/meeting_scheduled.ics && grep -q 'carol@example.com' /app/meeting_scheduled.ics && echo 'ICS validation passed'\n"]
