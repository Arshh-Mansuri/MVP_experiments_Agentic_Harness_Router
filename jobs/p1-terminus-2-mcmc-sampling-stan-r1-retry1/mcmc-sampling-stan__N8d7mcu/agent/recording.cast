[92.869678, "i", "cat > /app/hierarchical_model.stan <<'EOF'\ndata {\n  int<lower=1> N;\n  array[N] int<lower=0> y;\n  array[N] int<lower=0> n;\n}\nparameters {\n  real<lower=0> alpha;\n  real<lower=0> beta;\n  vector<lower=0, upper=1>[N] theta;\n}\nmodel {\n  // (alpha + beta)^(-5/2), up to a proportionality constant\n  target += -2.5 * log(alpha + beta);\n  theta ~ beta(alpha, beta);\n  y ~ binomial(n, theta);\n}\nEOF\ncat > /app/analysis.R <<'EOF'\noptions(mc.cores = parallel::detectCores())\nSys.setenv(LOCAL_CPPFLAGS = \"-O2\")\nlibrary(rstan)\nrstan_options(auto_write = TRUE)\n\ninput <- read.csv(\"/app/data.csv\", header = TRUE)\nstopifnot(all(c(\"y\", \"n\") %in% names(input)))\nstan_data <- list(\n  N = nrow(input),\n  y = as.integer(input$y),\n  n = as.integer(input$n)\n)\n\nfit <- sampling(\n  stan_model(\"/app/hierarchical_model.stan\"),\n  data = stan_data,\n  chains = 4,\n  iter = 100000,\n  seed = 1,\n  refresh = 1000,\n  control = list(adapt_delta = 0.9, max_treedepth = 12)\n)\n\ns <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\nwriteLines(sprintf(\"%.17g\", mean(s$alpha)), \"/app/posterior_alpha_mean.txt\")\nwriteLines(sprintf(\"%.17g\", mean(s$beta)), \"/app/posterior_beta_mean.txt\")\nEOF\nRscript /app/analysis.R\n"]
[92.870251, "o", "cat > /app/hierarchical_model.stan <<'EOF'\r\ndata {\r\n  int<lower=1> N;\r\n  array[N] int<lower=0> y;\r\n  array[N] int<lower=0> n;\r\n}\r\nparameters {\r\n  real<lower=0> alpha;\r\n  real<lower=0> beta;\r\n  vector<lower=0, upper=1>[N] theta;\r\n}\r\nmodel {\r\n  // (alpha + beta)^(-5/2), up to a proportionality constant\r\n  target += -2.5 * log(alpha + beta);\r\n  theta ~ beta(alpha, beta);\r\n  y ~ binomial(n, theta);\r\n}\r\nEOF\r\ncat > /app/analysis.R <<'EOF'\r\noptions(mc.cores = parallel::detectCores())\r\nSys.setenv(LOCAL_CPPFLAGS = \"-O2\")\r\nlibrary(rstan)\r\nrstan_options(auto_write = TRUE)\r\n\r\ninput <- read.csv(\"/app/data.csv\", header = TRUE)\r\nstopifnot(all(c(\"y\", \"n\") %in% names(input)))\r\nstan_data <- list(\r\n  N = nrow(input),\r\n  y = as.integer(input$y),\r\n  n = as.integer(input$n)\r\n)\r\n\r\nfit <- sampling(\r\n  stan_model(\"/app/hierarchical_model.stan\"),\r\n  data = stan_data,\r\n  chains = 4,\r\n  iter = 100000,\r\n  seed = 1,\r\n  refresh = 1000,\r\n  control = list(adapt_delta = 0.9, max_treedepth = 12)\r\n)\r\n\r\ns <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\r\nwriteLines(sprintf(\"%.17g\", mean(s$alpha)), \"/app/posterior_alpha_mean.txt\")\r\nwriteLines(sprintf(\"%.17g\", mean(s$beta)), \"/app/posterior_beta_mean.txt\")\r\nEOF\r\nRscript /app/analysis.R\r\n"]
