[238.783322, "i", "cat > /app/hierarchical_model.stan <<'EOF'\ndata {\n  int<lower=1> N;\n  array[N] int<lower=0> y;\n  array[N] int<lower=0> n;\n}\nparameters {\n  real<lower=0> alpha;\n  real<lower=0> beta;\n  vector<lower=0, upper=1>[N] theta;\n}\nmodel {\n  target += -2.5 * log(alpha + beta);\n  theta ~ beta(alpha, beta);\n  y ~ binomial(n, theta);\n}\nEOF\ncat > /app/analysis.R <<'EOF'\noptions(mc.cores = parallel::detectCores())\nlibrary(rstan)\nrstan_options(auto_write = TRUE)\n\ninput <- read.csv(\"/app/data.csv\", header = TRUE)\nstopifnot(all(c(\"y\", \"n\") %in% names(input)))\nstan_data <- list(\n  N = nrow(input),\n  y = as.integer(input$y),\n  n = as.integer(input$n)\n)\n\nmodel <- stan_model(file = \"/app/hierarchical_model.stan\")\nfit <- sampling(\n  model,\n  data = stan_data,\n  chains = 4,\n  iter = 100000,\n  seed = 1,\n  refresh = 1000,\n  control = list(adapt_delta = 0.9, max_treedepth = 12)\n)\n\nsamples <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\nwriteLines(sprintf(\"%.17g\", mean(samples$alpha)), \"/app/posterior_alpha_mean.txt\")\nwriteLines(sprintf(\"%.17g\", mean(samples$beta)), \"/app/posterior_beta_mean.txt\")\nEOF\nls -l /app/hierarchical_model.stan /app/analysis.R\n"]
[238.784539, "o", "cat > /app/hierarchical_model.stan <<'EOF'\r\ndata {\r\n  int<lower=1> N;\r\n  array[N] int<lower=0> y;\r\n  array[N] int<lower=0> n;\r\n}\r\nparameters {\r\n  real<lower=0> alpha;\r\n  real<lower=0> beta;\r\n  vector<lower=0, upper=1>[N] theta;\r\n}\r\nmodel {\r\n  target += -2.5 * log(alpha + beta);\r\n  theta ~ beta(alpha, beta);\r\n  y ~ binomial(n, theta);\r\n}\r\nEOF\r\ncat > /app/analysis.R <<'EOF'\r\noptions(mc.cores = parallel::detectCores())\r\nlibrary(rstan)\r\nrstan_options(auto_write = TRUE)\r\n\r\ninput <- read.csv(\"/app/data.csv\", header = TRUE)\r\nstopifnot(all(c(\"y\", \"n\") %in% names(input)))\r\nstan_data <- list(\r\n  N = nrow(input),\r\n  y = as.integer(input$y),\r\n  n = as.integer(input$n)\r\n)\r\n\r\nmodel <- stan_model(file = \"/app/hierarchical_model.stan\")\r\nfit <- sampling(\r\n  model,\r\n  data = stan_data,\r\n  chains = 4,\r\n  iter = 100000,\r\n  seed = 1,\r\n  refresh = 1000,\r\n  control = list(adapt_delta = 0.9, max_treedepth = 12)\r\n)\r\n\r\nsamples <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\r\nwriteLines(sprintf(\"%.17g\", mean(samples$alpha)), \"/app/posterior_alpha_mean.txt\")\r\nwriteLines(sprintf(\"%.17g\", mean(samples$beta)), \"/app/posterior_beta_mean.txt\")\r\nEOF\r\nls -l /app/hierarchical_model.stan /app/analysis.R\r\n"]
[238.973261, "i", "Rscript /app/analysis.R\n"]
[238.973697, "o", "Rscript /app/analysis.R\r\n"]
