[178.783829, "i", "Rscript -e 'options(repos=c(CRAN=\"https://cloud.r-project.org\")); pkgs <- c(\"Rcpp\",\"RcppEigen\",\"StanHeaders\",\"rstan\"); miss <- pkgs[!vapply(pkgs, requireNamespace, logical(1), quietly=TRUE)]; if (length(miss)) install.packages(miss, dependencies=TRUE); cat(\"rstan:\", as.character(packageVersion(\"rstan\")), \"\\n\"); stopifnot(as.character(packageVersion(\"rstan\")) == \"2.32.7\")'\n"]
[178.790983, "o", "Rscript -e 'options(repos=c(CRAN=\"https://cloud.r-project.org\")); pkgs <- c(\"Rcpp\",\"RcppEigen\",\"StanHeaders\",\"rstan\"); miss <- pkgs[!vapply(pkgs, requireNamespace, logical(1), quietly=TRUE)]; if (length(miss)) install.packages(miss, dependencies=TRUE); cat(\"rstan:\", as.character(packageVersion(\"rstan\")), \"\\n\"); stopifnot(as.character(packageVersion(\"rstan\")) == \"2.32.7\")'\r\n\u001b[?2004l\r"]
