[320.331554, "i", "python3 - <<'PY'\nimport json,urllib.request,urllib.parse\n\ndef get(u):\n r=urllib.request.Request(u,headers={'User-Agent':'build-task'})\n return json.load(urllib.request.urlopen(r,timeout=15))\nfor u in ['https://api.github.com/repos/POV-Ray/povray/tags?per_page=100','https://archive.org/metadata/archlinux_pkg_povray','https://snapshot.debian.org/mr/package/povray/']:\n print('\\nURL',u)\n try:\n  d=get(u)\n  if isinstance(d,list):\n   for x in d: print(x.get('name'),x.get('zipball_url') or x.get('tarball_url'))\n  elif 'files' in d:\n   for f in d['files']:\n    n=f.get('name','')\n    if any(z in n.lower() for z in ('povray','source','tar','pkgbuild')): print(n,f.get('size'))\n  else: print(str(d)[:10000])\n except Exception as e: print('ERROR',e)\nPY\n"]
