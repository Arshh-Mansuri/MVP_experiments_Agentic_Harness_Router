[183.156775, "i", "python3 - <<'PY'\nimport json,urllib.request\nfor url in ['https://api.github.com/search/repositories?q=POV-Ray','https://api.github.com/repos/POV-Ray/povray/tags?per_page=100','https://api.github.com/repos/POV-Ray/povray/branches?per_page=100']:\n print('\\nURL',url)\n try:\n  d=json.load(urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'Mozilla/5.0'}),timeout=30))\n  if isinstance(d,dict) and 'items' in d: d=d['items']\n  for x in d: print(x.get('full_name') or x.get('name'),x.get('tarball_url') or x.get('zipball_url') or x.get('commit',{}).get('sha'))\n except Exception as e: print('ERROR',e)\nPY\n"]
