[173.191099, "i", "python3 - <<'PY'\nimport json,urllib.parse,urllib.request\nqueries=['title:povray','povray','pov-ray','povray AND source']\nfor query in queries:\n print('\\nQUERY',query)\n u='https://archive.org/advancedsearch.php?'+urllib.parse.urlencode([('q',query),('fl[]','identifier'),('fl[]','title'),('rows','100'),('output','json')])\n try:\n  d=json.load(urllib.request.urlopen(u,timeout=30))\n  print('count',d['response']['numFound'])\n  for x in d['response']['docs']: print(x)\n except Exception as e: print('ERROR',e)\nPY\n"]
