import json,urllib.request,urllib.parse

def get(u):
 r=urllib.request.Request(u,headers={'User-Agent':'build-task'})
 return json.load(urllib.request.urlopen(r,timeout=15))
for u in ['https://api.github.com/repos/POV-Ray/povray/tags?per_page=100','https://archive.org/metadata/archlinux_pkg_povray','https://snapshot.debian.org/mr/package/povray/']:
 print('\nURL',u)
 try:
  d=get(u)
  if isinstance(d,list):
   for x in d: print(x.get('name'),x.get('zipball_url') or x.get('tarball_url'))
  elif 'files' in d:
   for f in d['files']:
    n=f.get('name','')
    if any(z in n.lower() for z in ('povray','source','tar','pkgbuild')): print(n,f.get('size'))
  else: print(str(d)[:10000])
 except Exception as e: print('ERROR',e)
PY
