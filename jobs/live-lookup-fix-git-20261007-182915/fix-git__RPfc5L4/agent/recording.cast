[33.281983, "o", "...skipping...\r\n\u001b[m\r\n                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-SPACE         *  Forwar"]
[33.282146, "o", "d  one window, but don't stop at end-of-file.\u001b[m\r\n  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Default \"window\" is the screen height.\u001b[m\r\n        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n            "]
[33.282293, "o", "              \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[m\r\n  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K...skipping...\r\n                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b["]
[33.282342, "o", "24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search"]
[33.282459, "o", " pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Default \"window\" is the screen height.\u001b[m\r\n        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[m\r\n  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K...skipping...\r\n                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n  "]
[33.282567, "o", "    A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right on"]
[33.282597, "o", "e half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Default \"window\" is the screen height.\u001b[m\r\n        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[m\r\n  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  n                 *  Repeat previous search"]
[33.282718, "o", " (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[K\u001b[7mCannot change the -p (--pattern) option  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n  N                 *  Repeat previous search in reverse direction.\u001b[m\r\n  ESC-n             *  Repeat previous search, spanning files.\u001b[m\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\u001b[m\r\n  ESC-u                Undo (toggle) search highlighting.\u001b[m\r\n  ESC-U                Clear search highlighting.\u001b[m\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A search patter"]
[33.282765, "o", "n may begin with one or more of:\u001b[m\r\n        ^N or !  Search for NON-matching lines.\u001b[m\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\u001b[m\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\u001b[m\r\n        ^K       Highlight matches, but don't move (KEEP position).\u001b[m\r\n        ^R       Don't use REGULAR EXPRESSIONS.\u001b[m\r\n        ^W       WRAP search if no match found.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mJUMPING\u001b[0m\u001b[m\r\n\u001b[m\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\u001b[m\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\u001b[m\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m-th) previous tag.\u001b[m\r\n  {  (  [           *  Find close bracket } ) ].\u001b[m\r\n  }  )  ]           *  Find open bracket { ( [.\u001b[m\r\n  ESC-^"]
[33.282819, "o", "F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\u001b[m\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Each \"find close bracket\" command goes forward to the close bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\u001b[m\r\n        Each \"find open bracket\" command goes backward to the open bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\u001b[m\r\n\u001b[m\r\n  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\u001b[m\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\u001b[m\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\u001b[m\r\n  ''                   Go to the previous position.\u001b[m\r\n  ^X^X                 Same as '.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K:\u001b[K4\b4\u001b[K9\b9\u001b[K9\b9\u001b[K7\b7\u001b[K3\b3\u001b[K0\b0\r\u001b[K  ESC-M"]
[33.282843, "o", "\u001b[4m<letter>\u001b[24m        Clear a mark.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A mark is any upper-case or lower-case letter.\u001b[m\r\n        Certain marks are predefined:\u001b[m\r\n             ^  means  beginning of the file\u001b[m\r\n             $  means  end of the file\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                        \u001b[1mCHANGING\u001b[0m \u001b[1mFILES\u001b[0m\u001b[m\r\n\u001b[m\r\n  :e [\u001b[4mfile\u001b[24m]            Examine a new file.\u001b[m\r\n  ^X^V                 Same as :e.\u001b[m\r\n  :n                *  Examine the (\u001b[4mN\u001b[24m-th) next file from the command line.\u001b[m\r\n  :p                *  Examine the (\u001b[4mN\u001b[24m-th) previous file from the command line.\u001b[m\r\n  :x                *  Examine the first (or \u001b[4mN\u001b[24m-th) file from the command line.\u001b[m\r\n  :d                   Delete the current file from the command line list.\u001b[m\r\n  =  ^G  :f            Print current file name.\u001b[m\r\n ---------------------------------------------------------------------------"]
[33.282941, "o", "\u001b[m\r\n\u001b[m\r\n                    \u001b[1mMISCELLANEOUS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n  -\u001b[4m<flag>\u001b[24m              Toggle a command line option [see OPTIONS below].\u001b[m\r\n  --\u001b[4m<name>\u001b[24m             Toggle a command line option, by name.\u001b[m\r\n  _\u001b[4m<flag>\u001b[24m              Display the setting of a command line option.\u001b[m\r\n  __\u001b[4m<name>\u001b[24m             Display the setting of an option, by name.\u001b[m\r\n  +\u001b[4mcmd\u001b[24m                 Execute the less cmd each time a new file is examined.\u001b[m\r\n\u001b[m\r\n  !\u001b[4mcommand\u001b[24m             Execute the shell command with $SHELL.\u001b[m\r\n  |\u001b[1mX\u001b[0m\u001b[4mcommand\u001b[24m            Pipe file between current pos & mark \u001b[1mX\u001b[0m to shell command.\u001b[m\r\n  s \u001b[4mfile\u001b[24m               Save input to a file.\u001b[m\r\n  v                    Edit the current file with $VISUAL or $EDITOR.\u001b[m\r\n  V                    Print version number of \"less\".\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mOPTIONS\u001b[0m\u001b[m\r\n\u001b[m\r\n        Most op"]
[33.283067, "o", "tions may be changed either on the command line,\u001b[m\r\n        or from within less by using the - or -- command.\u001b[m\r\n        Options may be given in one of two forms: either a single\u001b[m\r\n        character preceded by a -, or a name preceded by --.\u001b[m\r\n\u001b[m\r\n  -?  ........  --help\u001b[m\r\n                  Display help (from command line).\u001b[m\r\n  -a  ........  --search-skip-screen\u001b[m\r\n                  Search skips current screen.\u001b[m\r\n  -A  ........  --SEARCH-SKIP-SCREEN\u001b[m\r\n                  Search starts just after target line.\u001b[m\r\n  -b [\u001b[4mN\u001b[24m]  ....  --buffers=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Number of buffers.\u001b[m\r\n  -B  ........  --auto-buffers\u001b[m\r\n                  Don't automatically allocate buffers for pipes.\u001b[m\r\n  -c  ........  --clear-screen\u001b[m\r\n                  Repaint by clearing rather than scrolling.\u001b[m\r\n  -d  ........  --dumb\u001b[m\r\n                  Dumb terminal.\u001b[m\r\n  -D \u001b[1mx\u001b[0m\u001b[4mcolor\u001b[24m  .  --color=\u001b[1mx\u001b[0m\u001b[4mcolor\u001b[24m\u001b[m\r\n                  Set screen colors.\u001b[m\r\n  -e  -E  ....  --qui"]
[33.283171, "o", "t-at-eof  --QUIT-AT-EOF\u001b[m\r\n                  Quit at end of file.\u001b[m\r\n  -f  ........  --force\u001b[m\r\n                  Force open non-regular files.\u001b[m\r\n  -F  ........  --quit-if-one-screen\u001b[m\r\n                  Quit if entire file fits on first screen.\u001b[m\r\n  -g  ........  --hilite-search\u001b[m\r\n                  Highlight only last match for searches.\u001b[m\r\n  -G  ........  --HILITE-SEARCH\u001b[m\r\n                  Don't highlight any matches for searches.\u001b[m\r\n  -h [\u001b[4mN\u001b[24m]  ....  --max-back-scroll=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Backward scroll limit.\u001b[m\r\n  -i  ........  --ignore-case\u001b[m\r\n                  Ignore case in searches that do not contain uppercase.\u001b[m\r\n  -I  ........  --IGNORE-CASE\u001b[m\r\n                  Ignore case in all searches.\u001b[m\r\n  -j [\u001b[4mN\u001b[24m]  ....  --jump-target=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Screen position of target lines.\u001b[m\r\n  -J  ........  --status-column\u001b[m\r\n                  Display a status column at left edge of screen.\u001b[m\r\n  -k [\u001b[4mfile\u001b[24m]  .  --lesskey-file=[\u001b[4mfile\u001b[2"]
[33.283319, "o", "4m]\u001b[m\r\n                  Use a lesskey file.\u001b[m\r\n  -K  ........  --quit-on-intr\u001b[m\r\n                  Exit less in response to ctrl-C.\u001b[m\r\n  -L  ........  --no-lessopen\u001b[m\r\n                  Ignore the LESSOPEN environment variable.\u001b[m\r\n  -m  -M  ....  --long-prompt  --LONG-PROMPT\u001b[m\r\n                  Set prompt style.\u001b[m\r\n  -n  -N  ....  --line-numbers  --LINE-NUMBERS\u001b[m\r\n                  Don't use line numbers.\u001b[m\r\n  -o [\u001b[4mfile\u001b[24m]  .  --log-file=[\u001b[4mfile\u001b[24m]\u001b[m\r\n                  Copy to log file (standard input only).\u001b[m\r\n  -O [\u001b[4mfile\u001b[24m]  .  --LOG-FILE=[\u001b[4mfile\u001b[24m]\u001b[m\r\n                  Copy to log file (unconditionally overwrite).\u001b[m\r\n  -p [\u001b[4mpattern\u001b[24m]  --pattern=[\u001b[4mpattern\u001b[24m]\u001b[m\r\n                  Start at pattern (from command line).\u001b[m\r\n  -P [\u001b[4mprompt\u001b[24m]   --prompt=[\u001b[4mprompt\u001b[24m]\u001b[m\r\n                  Define new prompt.\u001b[m\r\n  -q  -Q  ....  --quiet  --QUIET  --silent --SILENT\u001b[m\r\n                  Quiet the terminal bell.\u001b[m\r\n  -r  -R  ....  --raw-control-chars  --R"]
[33.283429, "o", "AW-CONTROL-CHARS\u001b[m\r\n                  Output \"raw\" control characters.\u001b[m\r\n  -s  ........  --squeeze-blank-lines\u001b[m\r\n                  Squeeze multiple blank lines.\u001b[m\r\n  -S  ........  --chop-long-lines\u001b[m\r\n                  Chop (truncate) long lines rather than wrapping.\u001b[m\r\n  -t [\u001b[4mtag\u001b[24m]  ..  --tag=[\u001b[4mtag\u001b[24m]\u001b[m\r\n                  Find a tag.\u001b[m\r\n  -T [\u001b[4mtagsfile\u001b[24m] --tag-file=[\u001b[4mtagsfile\u001b[24m]\u001b[m\r\n                  Use an alternate tags file.\u001b[m\r\n  -u  -U  ....  --underline-special  --UNDERLINE-SPECIAL\u001b[m\r\n                  Change handling of backspaces.\u001b[m\r\n  -V  ........  --version\u001b[m\r\n                  Display the version number of \"less\".\u001b[m\r\n  -w  ........  --hilite-unread\u001b[m\r\n                  Highlight first new line after forward-screen.\u001b[m\r\n  -W  ........  --HILITE-UNREAD\u001b[m\r\n                  Highlight first new line after any forward movement.\u001b[m\r\n  -x [\u001b[4mN\u001b[24m[,...]]  --tabs=[\u001b[4mN\u001b[24m[,...]]\u001b[m\r\n                  Set tab stops.\u001b[m\r\n  -X  ........  --no-init\u001b[m\r\n         "]
[33.283582, "o", "         Don't use termcap init/deinit strings.\u001b[m\r\n  -y [\u001b[4mN\u001b[24m]  ....  --max-forw-scroll=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Forward scroll limit.\u001b[m\r\n  -z [\u001b[4mN\u001b[24m]  ....  --window=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Set size of window.\u001b[m\r\n  -\" [\u001b[4mc\u001b[24m[\u001b[4mc\u001b[24m]]  .  --quotes=[\u001b[4mc\u001b[24m[\u001b[4mc\u001b[24m]]\u001b[m\r\n                  Set shell quote characters.\u001b[m\r\n  -~  ........  --tilde\u001b[m\r\n                  Don't display tildes after end of file.\u001b[m\r\n  -# [\u001b[4mN\u001b[24m]  ....  --shift=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Set horizontal scroll amount (0 = one half screen width).\u001b[m\r\n                --file-size\u001b[m\r\n                  Automatically determine the size of the input file.\u001b[m\r\n                --follow-name\u001b[m\r\n                  The F command changes files if the input file is renamed.\u001b[m\r\n                --incsearch\u001b[m\r\n                  Search file as each pattern character is typed in.\u001b[m\r\n                --line-num-width=N\u001b[m\r\n                  Set the width of the -N line number field to N char"]
[33.283606, "o", "acters.\u001b[m\r\n                --mouse\u001b[m\r\n                  Enable mouse input.\u001b[m\r\n                --no-keypad\u001b[m\r\n                  Don't send termcap keypad init/deinit strings.\u001b[m\r\n                --no-histdups\u001b[m\r\n                  Remove duplicates from command history.\u001b[m\r\n                --rscroll=C\u001b[m\r\n                  Set the character used to mark truncated lines.\u001b[m\r\n                --save-marks\u001b[m\r\n                  Retain marks across invocations of less.\u001b[m\r\n                --status-col-width=N\u001b[m\r\n                  Set the width of the -J status column to N characters.\u001b[m\r\n                --use-backslash\u001b[m\r\n                  Subsequent options use backslash as escape char.\u001b[m\r\n                --use-color\u001b[m\r\n                  Enables colored text.\u001b[m\r\n                --wheel-lines=N\u001b[m\r\n                  Each click of the mouse wheel moves N lines.\u001b[m\r\n\u001b[m\r\n\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                          \u001b[1mLINE\u001b[0m \u001b[1mEDIT"]
[33.283699, "o", "ING\u001b[0m\u001b[m\r\n\u001b[m\r\n        These keys can be used to edit text being entered \u001b[m\r\n        on the \"command line\" at the bottom of the screen.\u001b[m\r\n\u001b[m\r\n RightArrow ..................... ESC-l ... Move cursor right one character.\u001b[m\r\n LeftArrow ...................... ESC-h ... Move cursor left one character.\u001b[m\r\n ctrl-RightArrow  ESC-RightArrow  ESC-w ... Move cursor right one word.\u001b[m\r\n ctrl-LeftArrow   ESC-LeftArrow   ESC-b ... Move cursor left one word.\u001b[m\r\n HOME ........................... ESC-0 ... Move cursor to start of line.\u001b[m\r\n END ............................ ESC-$ ... Move cursor to end of line.\u001b[m\r\n BACKSPACE ................................ Delete char to left of cursor.\u001b[m\r\n DELETE ......................... ESC-x ... Delete char under cursor.\u001b[m\r\n ctrl-BACKSPACE   ESC-BACKSPACE ........... Delete word to left of cursor.\u001b[m\r\n ctrl-DELETE .... ESC-DELETE .... ESC-X ... Delete word under cursor.\u001b[m\r\n ctrl-U ......... ESC (MS-DOS only) ....... Delete entire line.\u001b[m\r\n UpArrow ........................ ES"]
[33.283758, "o", "C-k ... Retrieve previous command line.\u001b[m\r\n DownArrow ...................... ESC-j ... Retrieve next command line.\u001b[m\r\n TAB ...................................... Complete filename & cycle.\u001b[m\r\n SHIFT-TAB ...................... ESC-TAB   Complete filename & reverse cycle.\u001b[m\r\n ctrl-L ................................... Complete filename, list all.\u001b[m\r\n\u001b[7mHELP -- END -- Press g to see it again, or q when done\u001b[27m\u001b[K"]
[34.324174, "i", "git status --short --branch && git log --oneline --decorate --all -8\n"]
[34.324337, "o", "\r\u001b[K"]
[34.324568, "o", "\u001b[H\u001b[J\u001b[H\u001bM  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM        Default \"half-window\" is half of the screen height.\u001b[m\r\n\u001b[H\u001bM        Default \"window\" is the screen height.\u001b[m\r\n\u001b[H\u001bM        ---------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  R                    Repaint screen, discarding buffered input.\u001b[m\r\n\u001b[H\u001bM  r  ^R  ^L            Repaint screen.\u001b[m\r\n\u001b[H\u001bM  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n\u001b[H\u001bM  F                    Forward forever; like \"tail -f\".\u001b[m\r\n\u001b[H\u001bM  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n\u001b[H\u001bM  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n\u001b[H\u001bM  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  ESC"]
[34.32465, "o", "-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n\u001b[H\u001bM  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n\u001b[H\u001bM  h  H "]
[34.324775, "o", "                Display this help.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[H\u001bM      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n\u001b[H\u001bM      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[Klog file: \u001b[Kt\bt\u001b[Ka\ba\u001b[Kt\bt\u001b[Ku\bu\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ks\bs\u001b[Kh\bh\u001b[Ko\bo\u001b[Kr\br\u001b[Kt\bt\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kb\bb\u001b[Kr\br\u001b[Ka\ba\u001b[Kn\bn\u001b[Kc\bc\u001b[Kh\bh\u001b[K \b "]
