[?2004hroot@b998d7cb3c1b:/app# cat > /app/sol.sql <<'SQL'
[?2004l[?2004h> WITH word_synsets AS MATERIALIZED (
[?2004l[?2004h>   SELECT
[?2004l[?2004h>     s.wordid,
[?2004l[?2004h>     s.synsetid,
[?2004l[?2004h>     COUNT(*) AS sense_count,
[?2004l[?2004h>     syn.domainid,
[?2004l[?2004h>     syn.posid
[?2004l[?2004h>   FROM senses AS s
[?2004l[?2004h>   JOIN synsets AS syn ON syn.synsetid = s.synsetid
[?2004l[?2004h>   GROUP BY s.wordid, s.synsetid, syn.domainid, syn.posid
[?2004l[?2004h> ), word_stats AS MATERIALIZED (
[?2004l[?2004h>   SELECT
[?2004l[?2004h>     wordid,
[?2004l[?2004h>     COUNT(*) AS total_synsets,
[?2004l[?2004h>     SUM(sense_count) AS total_senses,
[?2004l[?2004h>     COUNT(DISTINCT domainid) AS distinct_domains,
[?2004l[?2004h>     COUNT(DISTINCT posid) AS distinct_posids
[?2004l[?2004h>   FROM word_synsets
[?2004l[?2004h>   GROUP BY wordid
[?2004l[?2004h> ), ranked_synsets AS (
[?2004l[?2004h>   SELECT
[?2004l[?2004h>     wordid,
[?2004l[?2004h>     synsetid,
[?2004l[?2004h>     sense_count,
[?2004l[?2004h>     ROW_NUMBER() OVER (
[?2004l[?2004h>       PARTITION BY wordid
[?2004l[?2004h>       ORDER BY sense_count DESC, synsetid ASC
[?2004l[?2004h>     ) AS rank_number
[?2004l[?2004h>   FROM word_synsets
[?2004l[?2004h> )
[?2004l[?2004h> SELECT
[?2004l[?2004h>   w.wordid AS word_id,
[?2004l[?2004h>   w.word AS word,
[?2004l[?2004h>   ws.total_synsets,
[?2004l[?2004h>   ws.total_senses,
[?2004l[?2004h>   ws.distinct_domains,
[?2004l[?2004h>   ws.distinct_posids,
[?2004l[?2004h>   rs.synsetid AS top_synsetid,
[?2004l[?2004h>   rs.sense_count AS top_synset_sense_count
[?2004l[?2004h> FROM word_stats AS ws
[?2004l[?2004h> JOIN words AS w ON w.wordid = ws.wordid
[?2004l[?2004h> JOIN ranked_synsets AS rs
[?2004l[?2004h>   ON rs.wordid = ws.wordid
[?2004l[?2004h>  AND rs.rank_number = 1
[?2004l[?2004h> WHERE ws.total_synsets >= 2
[?2004l[?2004h>   AND ws.distinct_domains >= 2
[?2004l[?2004h>   AND ws.total_senses >= 2
[?2004l[?2004h> ORDER BY
[?2004l[?2004h>   ws.total_senses DESC,
[?2004l[?2004h>   ws.total_synsets DESC,
[?2004l[?2004h>   ws.distinct_domains DESC,
[?2004l[?2004h>   word_id ASC
[?2004l[?2004h> LIMIT 500;
[?2004l[?2004h> SQL
[?2004l[?2004hroot@b998d7cb3c1b:/app# sqlite3 /app/oewn.sqlite < /app/sol.sql >/dev/null
[?2004l[?2004hroot@b998d7cb3c1b:/app# sqlite3 /app/oewn.sqlite "EXPLAIN QUERY PLAN $(cat /app/sol.sql)" >/dev/null
[?2004l[?2004hroot@b998d7cb3c1b:/app# printf 'sol.sql validated\n'
[?2004lsol.sql validated
