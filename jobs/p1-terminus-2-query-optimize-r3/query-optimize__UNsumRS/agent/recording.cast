[54.066595, "i", "python3 - <<'PY'\nimport re\np='/app/sol.sql'\ns=open(p, encoding='utf-8').read()\nassert not re.search(r'(^|\\n)\\s*--|/\\*', s)\nassert s.count(';') == 1 and s.rstrip().endswith(';')\nprint('single comment-free statement: OK')\nPY\nsqlite3 -header -csv /app/oewn.sqlite < /app/my-sql-query.sql > /tmp/original.csv\nsqlite3 -header -csv /app/oewn.sqlite < /app/sol.sql > /tmp/optimized.csv\ncmp /tmp/original.csv /tmp/optimized.csv && echo 'output identical: OK'\n"]
