[34.131147, "o", "table|adjpositions|CREATE TABLE `adjpositions` (\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL,\r\n`position` VARCHAR(24) NOT NULL\r\n)\r\ntable|casedwords|CREATE TABLE `casedwords` (\r\n`casedwordid` INT NOT NULL,\r\n`wordid` INT NOT NULL ,\r\n`casedword` VARCHAR(80) NOT NULL\r\n)\r\ntable|domains|CREATE TABLE `domains` (\r\n`domainid` INT NOT NULL,\r\n`domain` VARCHAR(32) NOT NULL,\r\n`domainname` VARCHAR(32) NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL\r\n)\r\ntable|ilis|CREATE TABLE `ilis` (\r\n`ili` VARCHAR(7) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\ntable|lexes|CREATE TABLE `lexes` (\r\n`luid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL\r\n)\r\ntable|lexes_morphs|CREATE TABLE `lexes_morphs` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`morphid` INT NOT NULL\r\n)\r\ntable|lexes_pronunciations|CREATE TABLE `lexes_pronunciations` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pronunciationid` INT NOT NULL,\r\n`variety` VARCHAR(2) DEFAULT NULL\r\n)\r\ntable|lexrelations|CREATE TABLE `lexrelations` (\r\n`synset1id` INT NOT NULL,\r\n`lu1id` INT NOT NULL,\r\n`word1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`lu2id` INT NOT NULL,\r\n`word2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\ntable|morphs|CREATE TABLE `morphs` (\r\n`morphid` INT NOT NULL,\r\n`morph` VARCHAR(70) NOT NULL\r\n)\r\ntable|poses|CREATE TABLE `poses` (\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pos` VARCHAR(20) NOT NULL\r\n)\r\ntable|pronunciations|CREATE TABLE `pronunciations` (\r\n`pronunciationid` INT NOT NULL,\r\n`pronunciation` VARCHAR(50) NOT NULL\r\n)\r\ntable|relations|CREATE TABLE `relations` (\r\n`relationid` INT NOT NULL,\r\n`relation` VARCHAR(50) NOT NULL,\r\n`recurses` TINYINT(1) NOT NULL\r\n)\r\ntable|samples|CREATE TABLE `samples` (\r\n`sampleid` INT NOT NULL,\r\n`sample` MEDIUMTEXT NOT NULL,\r\n`source` MEDIUMTEXT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\ntable|semrelations|CREATE TABLE `semrelations` (\r\n`synset1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\ntable|senses|CREATE TABLE `senses` (\r\n`senseid` INT NOT NULL,\r\n`sensekey` VARCHAR(100) DEFAULT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL,\r\n`lexid` INT NOT NULL,\r\n`sensenum` INT DEFAULT NULL,\r\n`tagcount` INT DEFAULT NULL\r\n)\r\ntable|senses_adjpositions|CREATE TABLE `senses_adjpositions` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL\r\n)\r\ntable|senses_vframes|CREATE TABLE `senses_vframes` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`frameid` INT NOT NULL\r\n)\r\ntable|senses_vtemplates|CREATE TABLE `senses_vtemplates` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`templateid` INT NOT NULL\r\n)\r\ntable|synsets|CREATE TABLE `synsets` (\r\n`synsetid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`domainid` INT NOT NULL,\r\n`definition` MEDIUMTEXT NOT NULL\r\n)\r\ntable|usages|CREATE TABLE `usages` (\r\n`usageid` INT NOT NULL,\r\n`usagenote` MEDIUMTEXT NOT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\ntable|vframes|CREATE TABLE `vframes` (\r\n`frameid` INT NOT NULL,\r\n`frame` VARCHAR(50) NOT NULL\r\n)\r\ntable|vtemplates|CREATE TABLE `vtemplates` (\r\n`templateid` INT NOT NULL,\r\n`template` MEDIUMTEXT NOT NULL\r\n)\r\ntable|wikidatas|CREATE TABLE `wikidatas` (\r\n`wikidata` VARCHAR(12) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\ntable|words|CREATE TABLE `words` (\r\n`wordid` INT NOT NULL,\r\n`word` VARCHAR(80) NOT NULL\r\n)\r\n"]
[34.134527, "o", "\u001b[?2004hroot@b998d7cb3c1b:/app# "]
[46.715258, "i", "cat > /app/sol.sql <<'SQL'\nWITH word_synsets AS MATERIALIZED (\n  SELECT\n    s.wordid,\n    s.synsetid,\n    COUNT(*) AS sense_count,\n    syn.domainid,\n    syn.posid\n  FROM senses AS s\n  JOIN synsets AS syn ON syn.synsetid = s.synsetid\n  GROUP BY s.wordid, s.synsetid, syn.domainid, syn.posid\n), word_stats AS MATERIALIZED (\n  SELECT\n    wordid,\n    COUNT(*) AS total_synsets,\n    SUM(sense_count) AS total_senses,\n    COUNT(DISTINCT domainid) AS distinct_domains,\n    COUNT(DISTINCT posid) AS distinct_posids\n  FROM word_synsets\n  GROUP BY wordid\n), ranked_synsets AS (\n  SELECT\n    wordid,\n    synsetid,\n    sense_count,\n    ROW_NUMBER() OVER (\n      PARTITION BY wordid\n      ORDER BY sense_count DESC, synsetid ASC\n    ) AS rank_number\n  FROM word_synsets\n)\nSELECT\n  w.wordid AS word_id,\n  w.word AS word,\n  ws.total_synsets,\n  ws.total_senses,\n  ws.distinct_domains,\n  ws.distinct_posids,\n  rs.synsetid AS top_synsetid,\n  rs.sense_count AS top_synset_sense_count\nFROM word_stats AS ws\nJOIN words AS w ON w.wordid = ws.wordid\nJOIN ranked_synsets AS rs\n  ON rs.wordid = ws.wordid\n AND rs.rank_number = 1\nWHERE ws.total_synsets >= 2\n  AND ws.distinct_domains >= 2\n  AND ws.total_senses >= 2\nORDER BY\n  ws.total_senses DESC,\n  ws.total_synsets DESC,\n  ws.distinct_domains DESC,\n  word_id ASC\nLIMIT 500;\nSQL\nsqlite3 /app/oewn.sqlite < /app/sol.sql >/dev/null\nsqlite3 /app/oewn.sqlite \"EXPLAIN QUERY PLAN $(cat /app/sol.sql)\" >/dev/null\nprintf 'sol.sql validated\\n'\n"]
[46.719736, "o", "cat > /app/sol.sql <<'SQL'\r\n\u001b[?2004l\r"]
[46.722175, "o", "\u001b[?2004h> "]
[46.722289, "o", "WITH word_synsets AS MATERIALIZED (\r\n\u001b[?2004l\r"]
[46.722573, "o", "\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.723815, "o", "    s.wordid,\r\n\u001b[?2004l\r\u001b[?2004h>     s.synsetid,\r\n\u001b[?2004l\r\u001b[?2004h>     COUNT(*) AS sense_count,\r\n\u001b[?2004l\r\u001b[?2004h>     syn.domainid,\r\n\u001b[?2004l\r\u001b[?2004h>     syn.posid\r\n\u001b[?2004l\r\u001b[?2004h>   FROM senses AS s\r\n\u001b[?2004l\r\u001b[?2004h>   JOIN synsets AS syn ON syn.synsetid = s.synsetid\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY s.wordid, s.synsetid, syn.domainid, syn.posid\r\n\u001b[?2004l\r\u001b[?2004h> ), word_stats AS MATERIALIZED (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r\u001b[?2004h>     wordid,\r\n\u001b[?2004l\r\u001b[?2004h>     COUNT(*) AS total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.725259, "o", "    SUM(sense_count) AS total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>     COUNT(DISTINCT domainid) AS distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h>     COUNT(DISTINCT posid) AS distinct_posids\r\n\u001b[?2004l\r\u001b[?2004h>   FROM word_synsets\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY wordid\r\n\u001b[?2004l\r\u001b[?2004h> ), ranked_synsets AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r\u001b[?2004h>     wordid,\r\n\u001b[?2004l\r\u001b[?2004h>     synsetid,\r\n\u001b[?2004l\r\u001b[?2004h>     sense_count,\r\n\u001b[?2004l\r\u001b[?2004h>     ROW_NUMBER() OVER (\r\n\u001b[?2004l\r\u001b[?2004h>       PARTITION BY wordid\r\n\u001b[?2004l\r\u001b[?2004h>       ORDER BY sense_count DESC, synsetid ASC\r\n\u001b[?2004l\r\u001b[?2004h>     ) AS rank_number\r\n\u001b[?2004l\r\u001b[?2004h>   FROM word_synsets\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> SELECT\r\n\u001b[?2004l\r\u001b[?2004h>   w.wordid AS word_id,\r\n\u001b[?2004l\r\u001b[?2004h>   w.word AS word,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.728124, "o", "  ws.total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_posids,\r\n\u001b[?2004l\r\u001b[?2004h>   rs.synsetid AS top_synsetid,\r\n\u001b[?2004l\r\u001b[?2004h>   rs.sense_count AS top_synset_sense_count\r\n\u001b[?2004l\r\u001b[?2004h> FROM word_stats AS ws\r\n\u001b[?2004l\r\u001b[?2004h> JOIN words AS w ON w.wordid = ws.wordid\r\n\u001b[?2004l\r\u001b[?2004h> JOIN ranked_synsets AS rs\r\n\u001b[?2004l\r\u001b[?2004h>   ON rs.wordid = ws.wordid\r\n\u001b[?2004l\r\u001b[?2004h>  AND rs.rank_number = 1\r\n\u001b[?2004l\r\u001b[?2004h> WHERE ws.total_synsets >= 2\r\n\u001b[?2004l\r\u001b[?2004h>   AND ws.distinct_domains >= 2\r\n\u001b[?2004l\r\u001b[?2004h>   AND ws.total_senses >= 2\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_senses DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.total_synsets DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   ws.distinct_domains DESC,\r\n\u001b[?2004l\r\u001b[?2004h>   word_id ASC\r\n\u001b[?2004l\r\u001b[?2004h> LIMIT 500;\r\n\u001b[?2004l\r\u001b[?2004h> SQL\r\n\u001b[?2004l\r"]
