Sending keys: ['cat > /app/sol.sql <<\'SQL\'\nWITH word_synsets AS MATERIALIZED (\n  SELECT\n    s.wordid,\n    s.synsetid,\n    COUNT(*) AS sense_count,\n    syn.domainid,\n    syn.posid\n  FROM senses AS s\n  JOIN synsets AS syn ON syn.synsetid = s.synsetid\n  GROUP BY s.wordid, s.synsetid, syn.domainid, syn.posid\n), word_stats AS MATERIALIZED (\n  SELECT\n    wordid,\n    COUNT(*) AS total_synsets,\n    SUM(sense_count) AS total_senses,\n    COUNT(DISTINCT domainid) AS distinct_domains,\n    COUNT(DISTINCT posid) AS distinct_posids\n  FROM word_synsets\n  GROUP BY wordid\n), ranked_synsets AS (\n  SELECT\n    wordid,\n    synsetid,\n    sense_count,\n    ROW_NUMBER() OVER (\n      PARTITION BY wordid\n      ORDER BY sense_count DESC, synsetid ASC\n    ) AS rank_number\n  FROM word_synsets\n)\nSELECT\n  w.wordid AS word_id,\n  w.word AS word,\n  ws.total_synsets,\n  ws.total_senses,\n  ws.distinct_domains,\n  ws.distinct_posids,\n  rs.synsetid AS top_synsetid,\n  rs.sense_count AS top_synset_sense_count\nFROM word_stats AS ws\nJOIN words AS w ON w.wordid = ws.wordid\nJOIN ranked_synsets AS rs\n  ON rs.wordid = ws.wordid\n AND rs.rank_number = 1\nWHERE ws.total_synsets >= 2\n  AND ws.distinct_domains >= 2\n  AND ws.total_senses >= 2\nORDER BY\n  ws.total_senses DESC,\n  ws.total_synsets DESC,\n  ws.distinct_domains DESC,\n  word_id ASC\nLIMIT 500;\nSQL\nsqlite3 /app/oewn.sqlite < /app/sol.sql >/dev/null\nsqlite3 /app/oewn.sqlite "EXPLAIN QUERY PLAN $(cat /app/sol.sql)" >/dev/null\nprintf \'sol.sql validated\\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
