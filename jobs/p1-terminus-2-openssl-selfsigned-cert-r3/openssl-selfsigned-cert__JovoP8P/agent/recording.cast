[9.176277, "i", "mkdir -p /app/ssl\nopenssl genrsa -out /app/ssl/server.key 2048\nchmod 600 /app/ssl/server.key\nopenssl req -x509 -new -key /app/ssl/server.key -sha256 -days 365 -out /app/ssl/server.crt -subj \"/O=DevOps Team/CN=dev-internal.company.local\"\ncat /app/ssl/server.key /app/ssl/server.crt > /app/ssl/server.pem\nchmod 600 /app/ssl/server.pem\n{\n  openssl x509 -in /app/ssl/server.crt -noout -subject\n  openssl x509 -in /app/ssl/server.crt -noout -dates\n  openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256\n} > /app/ssl/verification.txt\ncat > /app/check_cert.py <<'PY'\n#!/usr/bin/env python3\nimport ssl\nfrom datetime import datetime, timezone\n\ncert_path = \"/app/ssl/server.crt\"\nexpected_cn = \"dev-internal.company.local\"\n\ntry:\n    cert = ssl._test_decode_cert(cert_path)\n    subject = dict(item for rdn in cert.get(\"subject\", ()) for item in rdn)\n    common_name = subject.get(\"commonName\")\n    not_after = cert.get(\"notAfter\")\n    if not common_name or not not_after:\n        raise ValueError(\"Certificate is missing req"]
[9.177221, "i", "uired details\")\n    expiration = datetime.strptime(not_after, \"%b %d %H:%M:%S %Y %Z\").replace(tzinfo=timezone.utc)\n    if common_name != expected_cn:\n        raise ValueError(f\"Unexpected Common Name: {common_name}\")\n    if expiration <= datetime.now(timezone.utc):\n        raise ValueError(\"Certificate is expired\")\n    print(f\"Common Name: {common_name}\")\n    print(f\"Expiration date: {expiration.strftime('%Y-%m-%d')}\")\n    print(\"Certificate verification successful\")\nexcept Exception as exc:\n    print(f\"Certificate verification failed: {exc}\")\n    raise SystemExit(1)\nPY\nchmod 755 /app/check_cert.py\nprintf '\\n--- verification.txt ---\\n'\ncat /app/ssl/verification.txt\nprintf '\\n--- check_cert.py ---\\n'\n/app/check_cert.py\nprintf '\\n--- permissions ---\\n'\nstat -c '%A %a %n' /app/ssl/server.key /app/ssl/server.crt /app/ssl/server.pem /app/ssl/verification.txt /app/check_cert.py\n"]
