[17.437813, "i", "cat > /app/check_cert.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport ssl\nfrom datetime import datetime, timezone\n\nCERT_PATH = \"/app/ssl/server.crt\"\nEXPECTED_CN = \"dev-internal.company.local\"\n\nif not os.path.isfile(CERT_PATH):\n    raise SystemExit(f\"Certificate not found: {CERT_PATH}\")\n\ntry:\n    cert = ssl._ssl._test_decode_cert(CERT_PATH)\n    subject = {\n        key: value\n        for rdn in cert.get(\"subject\", ())\n        for key, value in rdn\n    }\n    common_name = subject.get(\"commonName\")\n    not_after = cert.get(\"notAfter\")\n    if common_name != EXPECTED_CN:\n        raise ValueError(f\"unexpected Common Name: {common_name!r}\")\n    if not not_after:\n        raise ValueError(\"certificate has no expiration date\")\n    expiration = datetime.strptime(\n        not_after, \"%b %d %H:%M:%S %Y %Z\"\n    ).replace(tzinfo=timezone.utc)\n    if expiration <= datetime.now(timezone.utc):\n        raise ValueError(\"certificate is expired\")\n    print(f\"Common Name: {common_name}\")\n    print(f\"Expiration date: {expiration:%"]
[17.437893, "i", "Y-%m-%d}\")\n    print(\"Certificate verification successful\")\nexcept Exception as exc:\n    print(f\"Certificate verification failed: {exc}\")\n    raise SystemExit(1)\nPY\nchmod 755 /app/check_cert.py\n/app/check_cert.py\nprintf '\\n--- files ---\\n'\nls -l /app/ssl/server.key /app/ssl/server.crt /app/ssl/server.pem /app/ssl/verification.txt /app/check_cert.py\nprintf '\\n--- PEM validation ---\\n'\nopenssl rsa -in /app/ssl/server.key -check -noout\nopenssl x509 -in /app/ssl/server.crt -noout -subject -dates -fingerprint -sha256\n"]
