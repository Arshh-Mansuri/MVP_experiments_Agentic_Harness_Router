cat > /git/project/hooks/post-receive <<'EOF'
#!/bin/sh
set -eu
REPO=/git/project
WEB=/var/www/html
while read oldrev newrev ref; do
    case "$ref" in
        refs/heads/main)
            mkdir -p "$WEB/.main-staging"
            rm -rf "$WEB/.main-staging"/* "$WEB/.main-staging"/.[!.]* "$WEB/.main-staging"/..?* 2>/dev/null || true
            git --work-tree="$WEB/.main-staging" --git-dir="$REPO" checkout -f main
            rm -rf "$WEB/index.html"
            if [ -f "$WEB/.main-staging/index.html" ]; then cp "$WEB/.main-staging/index.html" "$WEB/index.html"; fi
            rm -rf "$WEB/.main-staging"
            ;;
        refs/heads/dev)
            mkdir -p "$WEB/dev/.staging"
            rm -rf "$WEB/dev/.staging"/* "$WEB/dev/.staging"/.[!.]* "$WEB/dev/.staging"/..?* 2>/dev/null || true
            git --work-tree="$WEB/dev/.staging" --git-dir="$REPO" checkout -f dev
            rm -rf "$WEB/dev/index.html"
            if [ -f "$WEB/dev/.staging/index.html" ]; then cp "$WEB/dev/.staging/index.html" "$WEB/dev/index.html"; fi
            rm -rf "$WEB/dev/.staging"
            ;;
    esac
done
EOF
chmod 755 /git/project/hooks/post-receive
chown git:git /git/project/hooks/post-receive
cat > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM yes
EOF
mkdir -p /etc/ssl/git-server
openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
  -keyout /etc/ssl/git-server/server.key \
  -out /etc/ssl/git-server/server.crt \
  -subj '/CN=localhost' \
  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'
chmod 600 /etc/ssl/git-server/server.key
cat > /etc/nginx/sites-available/git-https <<'EOF'
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name localhost;
    root /var/www/html;
    index index.html;
    ssl_certificate /etc/ssl/git-server/server.crt;
    ssl_certificate_key /etc/ssl/git-server/server.key;
    location / {
        try_files $uri $uri/ =404;
    }
}
EOF
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/git-https /etc/nginx/sites-enabled/git-https
nginx -t
