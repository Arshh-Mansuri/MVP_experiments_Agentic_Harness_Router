[48.803661, "i", "mkdir -p /run/sshd /etc/ssh/sshd_config.d /etc/ssl/git-server /var/www/html/dev\nprintf 'git:password\\n' | chpasswd\ncat > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'\nPasswordAuthentication yes\nKbdInteractiveAuthentication no\nUsePAM yes\nEOF\nif [ ! -s /etc/ssl/git-server/server.key ] || [ ! -s /etc/ssl/git-server/server.crt ]; then openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -keyout /etc/ssl/git-server/server.key -out /etc/ssl/git-server/server.crt -subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'; fi\nchmod 600 /etc/ssl/git-server/server.key\ncat > /etc/nginx/sites-available/git-https <<'EOF'\nserver {\n    listen 8443 ssl;\n    listen [::]:8443 ssl;\n    server_name localhost;\n    root /var/www/html;\n    ssl_certificate /etc/ssl/git-server/server.crt;\n    ssl_certificate_key /etc/ssl/git-server/server.key;\n    location / { try_files $uri $uri/ =404; }\n}\nEOF\nrm -f /etc/nginx/sites-enabled/default\nln -sf /etc/nginx/sites-available/git-https /etc/nginx/sites-enabled/git-https\nnginx -t\n"]
