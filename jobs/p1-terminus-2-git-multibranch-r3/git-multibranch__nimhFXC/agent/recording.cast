[49.76243, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/sh\nset -eu\nrepo=/git/project\nweb=/var/www/html\nwhile read old new ref; do\n  case \"$ref\" in\n    refs/heads/main)\n      tmp=$(mktemp -d)\n      trap 'rm -rf \"$tmp\"' EXIT\n      git --git-dir=\"$repo\" archive main index.html | tar -x -C \"$tmp\"\n      if [ -f \"$tmp/index.html\" ]; then cp \"$tmp/index.html\" \"$web/index.html\"; fi\n      rm -rf \"$tmp\"\n      trap - EXIT\n      ;;\n    refs/heads/dev)\n      tmp=$(mktemp -d)\n      trap 'rm -rf \"$tmp\"' EXIT\n      git --git-dir=\"$repo\" archive dev index.html | tar -x -C \"$tmp\"\n      if [ -f \"$tmp/index.html\" ]; then mkdir -p \"$web/dev\"; cp \"$tmp/index.html\" \"$web/dev/index.html\"; fi\n      rm -rf \"$tmp\"\n      trap - EXIT\n      ;;\n  esac\ndone\nEOF\nchmod 755 /git/project/hooks/post-receive\nchown git:git /git/project/hooks/post-receive /git/project\nchown -R git:git /git\nchown git:git /var/www/html /var/www/html/dev\n"]
[49.764698, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/sh\r\n\u001b[?2004l\r\u001b[?2004h> set -eu\r\n\u001b[?2004l\r\u001b[?2004h> repo=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> web=/var/www/html\r\n\u001b[?2004l\r\u001b[?2004h> while read old new ref; do\r\n\u001b[?2004l\r\u001b[?2004h>   case \"$ref\" in\r\n\u001b[?2004l\r\u001b[?2004h>     refs/heads/main)\r\n\u001b[?2004l\r\u001b[?2004h>       tmp=$(mktemp -d)\r\n\u001b[?2004l\r\u001b[?2004h>       trap 'rm -rf \"$tmp\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h>       git --git-dir=\"$repo\" archive main index.html | tar -x -C \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>       if [ -f \"$tmp/index.html\" ]; then cp \"$tmp/index.html\" \"$web/index.html\"; fi\r\n\u001b[?2004l\r\u001b[?2004h>       rm -rf \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>       trap - EXIT\r\n\u001b[?2004l\r\u001b[?2004h>       ;;\r\n\u001b[?2004l\r\u001b[?2004h>     refs/heads/dev)\r\n\u001b[?2004l\r\u001b[?2004h>       tmp=$(mktemp -d)\r\n\u001b[?2004l\r\u001b[?2004h>       trap 'rm -rf \"$tmp\"' EXIT\r\n\u001b[?2004l\r\u001b[?2004h>       git --git-dir=\"$repo\" archive dev index.html | tar -x -C \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>       if [ -f \"$tmp/index.html\" ]; then mkdir -p \"$web/dev\"; cp \"$tmp/index.html\" \"$web/dev/index.html\"; fi\r\n\u001b[?2004l\r\u001b[?2004h>       rm -rf \"$tmp\"\r\n\u001b[?2004l\r\u001b[?2004h>       trap - EXIT\r\n\u001b[?2004l\r\u001b[?2004h>       ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r+ cat\r\n"]
