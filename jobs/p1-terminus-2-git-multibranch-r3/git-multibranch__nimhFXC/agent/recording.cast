[49.511823, "o", "\u001b[?2004h> server {\r\n\u001b[?2004l\r"]
[49.511838, "o", "\u001b[?2004h"]
[49.511975, "o", ">     listen 8443 ssl;\r\n\u001b[?2004l\r\u001b[?2004h>     listen [::]:8443 ssl;\r\n\u001b[?2004l\r\u001b[?2004h>     server_name localhost;\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.512006, "o", ">     root /var/www/html;\r\n\u001b[?2004l\r"]
[49.512215, "o", "\u001b[?2004h>     ssl_certificate /etc/ssl/git-server/server.crt;\r\n\u001b[?2004l\r\u001b[?2004h>     ssl_certificate_key /etc/ssl/git-server/server.key;\r\n\u001b[?2004l\r"]
