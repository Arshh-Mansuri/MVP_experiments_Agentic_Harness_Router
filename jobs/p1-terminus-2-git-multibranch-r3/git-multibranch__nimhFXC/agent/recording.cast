[24.818659, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/sh\nset -eu\nREPO=/git/project\nWEB=/var/www/html\nwhile read oldrev newrev ref; do\n    case \"$ref\" in\n        refs/heads/main)\n            mkdir -p \"$WEB/.main-staging\"\n            rm -rf \"$WEB/.main-staging\"/* \"$WEB/.main-staging\"/.[!.]* \"$WEB/.main-staging\"/..?* 2>/dev/null || true\n            git --work-tree=\"$WEB/.main-staging\" --git-dir=\"$REPO\" checkout -f main\n            rm -rf \"$WEB/index.html\"\n            if [ -f \"$WEB/.main-staging/index.html\" ]; then cp \"$WEB/.main-staging/index.html\" \"$WEB/index.html\"; fi\n            rm -rf \"$WEB/.main-staging\"\n            ;;\n        refs/heads/dev)\n            mkdir -p \"$WEB/dev/.staging\"\n            rm -rf \"$WEB/dev/.staging\"/* \"$WEB/dev/.staging\"/.[!.]* \"$WEB/dev/.staging\"/..?* 2>/dev/null || true\n            git --work-tree=\"$WEB/dev/.staging\" --git-dir=\"$REPO\" checkout -f dev\n            rm -rf \"$WEB/dev/index.html\"\n            if [ -f \"$WEB/dev/.staging/index.html\" ]; then cp \"$WEB/dev/.staging/index.html\" \"$WEB/dev/index.html\"; fi\n            rm -rf \"$WEB/dev/.staging\"\n            ;;\n    esac\ndone\nEOF\nchmod 755 /git/project/hooks/post-receive\nchown git:git /git/project/hooks/post-receive\n"]
[24.868115, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n#!/bin/sh\r\nset -eu\r\nREPO=/git/project\r\nWEB=/var/www/html\r\nwhile read oldrev newrev ref; do\r\n    case \"$ref\" in\r\n        refs/heads/main)\r\n            mkdir -p \"$WEB/.main-staging\"\r\n            rm -rf \"$WEB/.main-staging\"/* \"$WEB/.main-staging\"/.[!.]* \"$WEB/.main-staging\"/..?* 2>/dev/null || true\r\n            git --work-tree=\"$WEB/.main-staging\" --git-dir=\"$REPO\" checkout -f main\r\n            rm -rf \"$WEB/index.html\"\r\n            if [ -f \"$WEB/.main-staging/index.html\" ]; then cp \"$WEB/.main-staging/index.html\" \"$WEB/index.html\"; fi\r\n            rm -rf \"$WEB/.main-staging\"\r\n            ;;\r\n        refs/heads/dev)\r\n            mkdir -p \"$WEB/dev/.staging\"\r\n            rm -rf \"$WEB/dev/.staging\"/* \"$WEB/dev/.staging\"/.[!.]* \"$WEB/dev/.staging\"/..?* 2>/dev/null || true\r\n            git --work-tree=\"$WEB/dev/.staging\" --git-dir=\"$REPO\" checkout -f dev\r\n            rm -rf \"$WEB/dev/index.html\"\r\n            if [ -f \"$WEB/dev/.staging/index.html\" ]; then cp \"$WEB/dev/.staging/index.html\" \"$WEB/dev/index.html\"; fi\r\n            rm -rf \"$WEB/dev/.staging\"\r\n            ;;\r\n    esac\r\ndone\r\nEOF\r\nchmod 755 /git/project/hooks/post-receive\r\nchown git:git /git/project/hooks/post-receive\r\n"]
[25.096763, "i", "cat > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'\nPasswordAuthentication yes\nKbdInteractiveAuthentication no\nPermitRootLogin no\nUsePAM yes\nEOF\nmkdir -p /etc/ssl/git-server\nopenssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\n  -keyout /etc/ssl/git-server/server.key \\\n  -out /etc/ssl/git-server/server.crt \\\n  -subj '/CN=localhost' \\\n  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'\nchmod 600 /etc/ssl/git-server/server.key\ncat > /etc/nginx/sites-available/git-https <<'EOF'\nserver {\n    listen 8443 ssl;\n    listen [::]:8443 ssl;\n    server_name localhost;\n    root /var/www/html;\n    index index.html;\n    ssl_certificate /etc/ssl/git-server/server.crt;\n    ssl_certificate_key /etc/ssl/git-server/server.key;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\nrm -f /etc/nginx/sites-enabled/default\nln -sf /etc/nginx/sites-available/git-https /etc/nginx/sites-enabled/git-https\nnginx -t\n"]
[25.097824, "o", "ca"]
[25.098068, "o", "t > /etc/ssh/sshd_config.d/git-server.conf <<'EOF'\r\nPasswordAuthentication yes\r\nKbdInteractiveAuthentication no\r\nPermitRootLogin no\r\nUsePAM yes\r\nEOF\r\nmkdir -p /etc/ssl/git-server\r\nopenssl req -x509 -nodes -newkey rsa:2048 -days 3650 \\\r\n  -keyout /etc/ssl/git-server/server.key \\\r\n  -out /etc/ssl/git-server/server.crt \\\r\n  -subj '/CN=localhost' \\\r\n  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'\r\nchmod 600 /etc/ssl/git-server/server.key\r\ncat > /etc/nginx/sites-available/git-https <<'EOF'\r\nserver {\r\n    listen 8443 ssl;\r\n    listen [::]:8443 ssl;\r\n    server_name localhost;\r\n    root /var/www/html;\r\n    index index.html;\r\n    ssl_certificate /etc/ssl/git-server/server.crt;\r\n    ssl_certificate_key /etc/ssl/git-server/server.key;\r\n    location / {\r\n        try_files $uri $uri/ =404;\r\n    }\r\n}\r\nEOF\r\nrm -f /etc/nginx/sites-enabled/default\r\nln -sf /etc/nginx/sites-available/git-https /etc/nginx/sites-enabled/git-https\r\nnginx -t\r\n"]
