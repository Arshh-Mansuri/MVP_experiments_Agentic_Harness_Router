[18.627631, "o", "\u001b[?2004h>   int32 val = 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> message SetValRequest {\r\n\u001b[?2004l\r\u001b[?2004h>   string key = 1;\r\n\u001b[?2004l\r\u001b[?2004h>   int32 value = 2;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> message SetValResponse {\r\n\u001b[?2004l\r\u001b[?2004h>   int32 val = 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
