[28.000364, "o", "    set_response = client.SetVal(kv_store_pb2.SetValRequest(key='test', value=123), timeout=3)\r\n\u001b[?2004l\r\u001b[?2004h>     get_response = client.GetVal(kv_store_pb2.GetValRequest(key='test'), timeout=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
