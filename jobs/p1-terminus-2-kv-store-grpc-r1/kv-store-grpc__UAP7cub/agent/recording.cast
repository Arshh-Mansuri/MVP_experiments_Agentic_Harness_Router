[28.001264, "o", "    print('GetVal:', get_response.val)\r\n\u001b[?2004l\r\u001b[?2004h>     assert set_response.val == 123\r\n\u001b[?2004l\r\u001b[?2004h>     assert get_response.val == 123\r\n\u001b[?2004l\r\u001b[?2004h>     print('gRPC round trip successful')\r\n\u001b[?2004l\r\u001b[?2004h> finally:\r\n\u001b[?2004l\r\u001b[?2004h>     channel.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
