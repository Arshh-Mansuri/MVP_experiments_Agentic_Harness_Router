[27.998396, "i", "python3 - <<'PY'\nimport grpc\nimport kv_store_pb2\nimport kv_store_pb2_grpc\n\nchannel = grpc.insecure_channel('localhost:5328')\ntry:\n    grpc.channel_ready_future(channel).result(timeout=3)\n    client = kv_store_pb2_grpc.KVStoreStub(channel)\n    set_response = client.SetVal(kv_store_pb2.SetValRequest(key='test', value=123), timeout=3)\n    get_response = client.GetVal(kv_store_pb2.GetValRequest(key='test'), timeout=3)\n    print('SetVal:', set_response.val)\n    print('GetVal:', get_response.val)\n    assert set_response.val == 123\n    assert get_response.val == 123\n    print('gRPC round trip successful')\nfinally:\n    channel.close()\nPY\n"]
