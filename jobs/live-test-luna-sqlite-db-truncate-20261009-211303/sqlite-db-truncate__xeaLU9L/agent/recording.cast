[29.156654, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport json, struct\np=Path('/app/trunc.db'); b=p.read_bytes(); n=len(b)\n\ndef varint(buf, pos):\n    v=0\n    for i in range(9):\n        x=buf[pos+i]\n        if i==8: return (v<<8)|x, pos+9\n        v=(v<<7)|(x&127)\n        if not x&128: return v, pos+i+1\n    raise ValueError('bad varint')\n\ndef serial(buf, pos, typ):\n    if typ==0: return None,pos\n    if typ==1: return int.from_bytes(buf[pos:pos+1],'big',signed=True),pos+1\n    if typ==2: return int.from_bytes(buf[pos:pos+2],'big',signed=True),pos+2\n    if typ==3: return int.from_bytes(buf[pos:pos+3],'big',signed=True),pos+3\n    if typ==4: return int.from_bytes(buf[pos:pos+4],'big',signed=True),pos+4\n    if typ==5: return int.from_bytes(buf[pos:pos+6],'big',signed=True),pos+6\n    if typ==6: return int.from_bytes(buf[pos:pos+8],'big',signed=True),pos+8\n    if typ==7: return struct.unpack('>d',buf[pos:pos+8])[0],pos+8\n    if typ==8: return 0,pos\n    if typ==9: return 1,pos\n    if typ in (10,11): return None,pos\n    if typ>=1"]
[29.158948, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.159084, "i", "2:\n        ln=(typ-12)//2\n        raw=buf[pos:pos+ln]\n        return (raw.decode('utf-8','replace') if typ%2 else raw),pos+ln\n    raise ValueError(typ)\n\nnc=int.from_bytes(b[3:5],'big')\nptrs=[int.from_bytes(b[8+2*i:10+2*i],'big') for i in range(nc)]\nprint('page type',hex(b[0]),'cells',nc,'pointers',ptrs)\nrows=[]\nfor idx,off in enumerate(ptrs):\n    start=off\n    plen,q=varint(b,off); rowid,q=varint(b,q)\n    hend,q2=varint(b,q); hstart=q; hendpos=q+hend\n    types=[]; x=hendpos\n    while x < hendpos: pass\n    # header length includes its own varint; serial types begin at q2\n    x=q2\n    while x < q+hend:\n        t,x=varint(b,x); types.append(t)\n    data=x; vals=[]\n    for t in types:\n        v,data=serial(b,data,t); vals.append(v)\n    print(idx,'offset',off,'payload',plen,'rowid',rowid,'types',types,'values',vals)\n    rows.append(vals)\n\nout=[]\nfor vals in rows:\n    if len(vals)>=2:\n        # expected schema is word text and value integer; tolerate reversed order\n        if isinstance(vals[0],str) and isinstance(v"]
