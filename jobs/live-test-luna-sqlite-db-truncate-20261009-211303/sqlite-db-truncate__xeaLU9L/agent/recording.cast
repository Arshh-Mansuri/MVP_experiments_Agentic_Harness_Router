[38.404842, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport json, struct\nb=Path('/app/trunc.db').read_bytes()\ndef varint(p):\n v=0\n for i in range(9):\n  x=b[p+i]\n  if i==8:return (v<<8)|x,p+9\n  v=(v<<7)|(x&127)\n  if not x&128:return v,p+i+1\ndef sval(p,t):\n if t==0:return None,p\n if t==1:return int.from_bytes(b[p:p+1],'big',signed=True),p+1\n if t==2:return int.from_bytes(b[p:p+2],'big',signed=True),p+2\n if t==3:return int.from_bytes(b[p:p+3],'big',signed=True),p+3\n if t==4:return int.from_bytes(b[p:p+4],'big',signed=True),p+4\n if t==5:return int.from_bytes(b[p:p+6],'big',signed=True),p+6\n if t==6:return int.from_bytes(b[p:p+8],'big',signed=True),p+8\n if t==7:return struct.unpack('>d',b[p:p+8])[0],p+8\n if t==8:return 0,p\n if t==9:return 1,p\n if t>=12:\n  n=(t-12)//2; z=b[p:p+n]\n  return (z.decode('utf8','replace') if t%2 else z),p+n\nrows=[]\nn=int.from_bytes(b[3:5],'big')\nfor i in range(n):\n o=int.from_bytes(b[8+2*i:10+2*i],'big'); plen,o=varint(o); rid,o=varint(o); h,o2=varint(o); x=o2; ts=[]\n while x<o+h: t,x=varint(x); ts"]
[38.405066, "i", ".append(t)\n vals=[]; d=x\n for t in ts: v,d=sval(d,t); vals.append(v)\n word=next(v for v in vals if isinstance(v,str)); value=next(v for v in vals if isinstance(v,(int,float)) and not isinstance(v,bool))\n rows.append((rid,{'word':word,'value':value}))\nrows.sort()\nPath('/app/recover.json').write_text(json.dumps([r for _,r in rows],separators=(',',':'))+'\\n')\nprint(Path('/app/recover.json').read_text(),end='')\nPY\n"]
