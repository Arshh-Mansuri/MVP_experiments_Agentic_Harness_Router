[37.519644, "o", "#!/usr/bin/env python3\r\nimport os\r\n\r\nBASE = \"/app\"\r\n"]
[37.519873, "o", "DATA = os.path.join(BASE, \"data\")\r\nSRC = os.path.join(BASE, \"src\")\r\n\r\n\r\ndef read_records(path, size):\r\n    with open(path, \"rb\") as f:\r\n        data = f.read()\r\n"]
[37.520111, "o", "    return [data[i:i + size] for i in range(0, len(data), size) if len(data[i:i + size]) == size]\r\n\r\n\r\ndef field(record, start, length):\r\n    return record[start:start + length]\r\n\r\n\r\ndef numeric(value):\r\n    # Numeric PIC 9 fields are stored as zero-filled decimal digits.\r\n    return int(value.decode(\"ascii\").strip() or \"0\")\r\n\r\n\r\ndef main():\r\n    with open(os.path.join(SRC, \"INPUT.DAT\"), \"rb\") as f:\r\n        raw = f.read()\r\n    if not raw:\r\n        print(\"Error: Input file is empty\")\r\n        return\r\n\r\n    # INPUT-RECORD is 22 bytes.  Short sequential records are treated as\r\n    # space-padded for the alphanumeric portions; the supplied test input\r\n    # convention uses a short, un-delimited amount at the end.\r\n    inp = raw[:22]\r\n"]
[37.520328, "o", "    buyer = inp[0:4]\r\n    seller = inp[4:8]\r\n    book = inp[8:12]\r\n    amount_bytes = inp[12:22]\r\n    amount_text = amount_bytes.decode(\"ascii\", \"ignore\").strip()\r\n    amount = int(amount_text or \"0\")\r\n\r\n    accounts_path = os.path.join(DATA, \"ACCOUNTS.DAT\")\r\n    books_path = os.path.join(DATA, \"BOOKS.DAT\")\r\n    transactions_path = os.path.join(DATA, \"TRANSACTIONS.DAT\")\r\n\r\n    accounts = read_records(accounts_path, 34)\r\n    books = read_records(books_path, 28)\r\n\r\n    buyer_found = any(field(r, 0, 4) == buyer for r in accounts)\r\n    seller_found = any(field(r, 0, 4) == seller for r in accounts)\r\n    matching_books = [r for r in books if field(r, 0, 4) == book]\r\n    book_found = bool(matching_books)\r\n    valid_owner = any(field(r, 24, 4) == seller for r in matching_books)\r\n\r\n    if not (buyer_found and seller_found and book_found and valid_owner):\r\n        print(\"Transaction failed due to validation errors\")\r\n        return\r\n\r\n    # COBOL updates records in place and retains all other bytes exactly.\r\n    update"]
[37.520364, "o", "d_accounts = []\r\n    for record in accounts:\r\n        r = bytearray(record)\r\n        account_id = bytes(r[0:4])\r\n        balance = numeric(bytes(r[24:34]))\r\n        if account_id == buyer:\r\n            balance -= amount\r\n        if account_id == seller:\r\n"]
[37.520383, "o", "            balance += amount\r\n        if account_id == buyer or account_id == seller:\r\n            r[24:34] = f\"{balance:010d}\".encode(\"ascii\")\r\n"]
[37.520505, "o", "        updated_accounts.append(bytes(r))\r\n    with open(accounts_path, \"wb\") as f:\r\n        f.write(b\"\".join(updated_accounts))\r\n\r\n    updated_books = []\r\n    for record in books:\r\n        r = bytearray(record)\r\n        if bytes(r[0:4]) == book:\r\n            r[24:28] = buyer\r\n        updated_books.append(bytes(r))\r\n    with open(books_path, \"wb\") as f:\r\n        f.write(b\"\".join(updated_books))\r\n\r\n    transaction = book + f\"{amount:010d}\".encode(\"ascii\") + seller + buyer\r\n    with open(transactions_path, \"ab\") as f:\r\n        f.write(transaction)\r\n\r\n    print(\"Transaction completed successfully\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
