[?2004l[?2004h> new=r'''function step(){
[?2004l[?2004h>   let cur=pc>>>0, delay=U32(cur+4), target=delay;
[?2004l[?2004h>   let ins=r32(cur), oldpc=pc;
[?2004l[?2004h>   // Execute the main instruction while diverting all control transfers into target.
