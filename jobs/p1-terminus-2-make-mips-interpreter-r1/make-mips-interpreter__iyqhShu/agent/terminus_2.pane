            fixed_pools[i].free_chunks = ptr;
            fixed_pools[i].used_count--;
            return 1;  // Successfully freed
        }
    }
    
    return 0;  // Not in our pools
}

// Main malloc with fast path for common sizes
void* malloc(size_t size) {
