[77.794837, "i", "identify /app/code.png; echo '--- PSM 6 ---'; tesseract /app/code.png stdout --psm 6; echo '--- PSM 11 ---'; tesseract /app/code.png stdout --psm 11\n"]
[77.797845, "o", "identify /app/code.png; echo '--- PSM 6 ---'; tesseract /app/code.png stdout --psm 6; echo '--- PSM 11 ---'; tesseract /app/code.png stdout --psm 11\r\n\u001b[?2004l\r"]
[77.88167, "o", "/app/code.png PNG 1160x804 1160x804+0+0 8-bit sRGB 95041B 0.020u 0:00.014\r\n"]
[77.886259, "o", "--- PSM 6 ---\r\n"]
[78.448604, "o", "def main():\r\n"]
[78.448835, "o", "SALT = 6’0000TBENCH-SALT”\r\nimg_ bytes = read_file_ bytes( ‘Tapp/code.png’)\r\nho = cha256(img_ bytes)\r\n# cha2z56(ho // hof:10] [/ SALT)\r\nH = cha256(ho, hof:10], SALT)\r\nprint(H.bex())\r\nreturn\r\n"]
[78.518844, "o", "--- PSM 11 ---\r\n"]
[79.124818, "o", "def main():\r\n\r\nGALT = b’0000TBENCH-SALT”\r\n\r\nimg_ bytes = read_file_ bytes( ‘Tapp/code.png’)\r\n\r\nho = cha256(img_ bytes)\r\n\r\n# cha256(ho // hof:10] |/ SALT)\r\n\r\nH = cha2z56(ho, hof:10], SALT)\r\n\r\nprint(H.bex())\r\n\r\nreturn\r\n"]
[79.139013, "o", "\u001b[?2004hroot@a13a30114553:/app# "]
[81.021269, "i", "convert /app/code.png -resize 300% -colorspace Gray -threshold 70% /app/code-prepped.png; echo '--- PREPPED ---'; tesseract /app/code-prepped.png stdout --psm 6\n"]
[81.021825, "o", "convert /app/code.png -resize 300% -colorspace Gray -threshold 70% /app/code-prepped.png; echo '--- PREPPED ---'; tesseract /app/code-prepped.png stdout --psm 6\r\n\u001b[?2004l\r"]
[82.154918, "o", "--- PREPPED ---\r\n"]
[82.744092, "o", "def main 0):\r\nGALT = 6’0000TBENCH-SALT”\r\nimg_ bytes = read_file_ bytes(/app/code.png’)\r\nhO = cha256(img_ bytes)\r\n# oha256(ho // hof-t0] [/ SALT)\r\nH = cha256(ho, hof:10], SALT)\r\nprint(H.hex())\r\nreturn\r\n"]
[82.757248, "o", "\u001b[?2004hroot@a13a30114553:/app# "]
[92.360017, "i", "python3 - <<'PY'\nimport hashlib\np='/app/code.png'\nb=open(p,'rb').read()\nd=hashlib.sha256(b).digest()\nvariants=[]\nfor hname,h in [('raw',d),('hex',hashlib.sha256(b).hexdigest().encode()),('hexupper',hashlib.sha256(b).hexdigest().upper().encode())]:\n  for n in [10]:\n    for salt in [b'0000TBENCH-SALT',b'0000T BENCH-SALT',b'0000TBENCH-SALT',b'0000tbench-salt',b'0000TBENCH-SALT']:\n      for sep in [b'',b' ',b'|',b'//']:\n        x=h+sep+h[:n]+sep+salt\n        out=hashlib.sha256(x).hexdigest()\n        if out.startswith('bee26a'):\n          print('MATCH',hname,salt,sep,out)\n        variants.append(out)\nprint('h0 raw:',d.hex())\nprint('h0 hex:',hashlib.sha256(b).hexdigest())\nPY\n"]
[92.362594, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/code.png'\r\n\u001b[?2004l\r\u001b[?2004h> b=open(p,'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> d=hashlib.sha256(b).digest()\r\n\u001b[?2004l\r\u001b[?2004h> variants=[]\r\n\u001b[?2004l\r\u001b[?2004h> for hname,h in [('raw',d),('hex',hashlib.sha256(b).hexdigest().encode()),('hexupper',hashlib.sha256(b).hexdigest().upper().encode())]:\r\n\u001b[?2004l\r"]
