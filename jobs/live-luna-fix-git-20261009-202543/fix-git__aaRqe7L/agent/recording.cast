[26.890395, "o", "\u001b[K_\b_\u0007\u001b[Ki\bi\u0007\u001b[Kn\bn\u0007\u001b[Kc\bc\u0007\u001b[Kl\bl\u0007\u001b[Ku\bu\u0007\u001b[Kd\bd\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[K/\b/\u0007\u001b[Ka\ba\u0007\u001b[Kb\bb\u0007\u001b[Ko\bo\u0007\u001b[Ku\bu\u0007\u001b[Kt\bt\u0007\u001b[K.\b.\u0007\u001b[Km\bm\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[K&\b&\u0007\u001b[K&\b&\u0007\u001b[K \b \u0007\u001b[Kg\bg\u0007\u001b[Ki\bi\u0007\u001b[Kt\bt\u0007\u001b[K \b \u0007\u001b[Ka\ba\u0007\u001b[Kd\bd\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[K_\b_\u0007\u001b[Ki\bi\u0007\u001b[Kn\bn\u0007\u001b[Kc\bc\u0007\u001b[Kl\bl\u0007\u001b[Ku\bu\u0007\u001b[Kd\bd\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[K/\b/\u0007\u001b[Ka\ba\u0007\u001b[Kb\bb\u0007\u001b[Ko\bo\u0007\u001b[Ku\bu\u0007\u001b[Kt\bt\u0007\u001b[K.\b.\u0007\u001b[Km\bm\u0007"]
[26.890446, "o", "\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[K&\b&\u0007\u001b[K&\b&\u0007\u001b[K \b \u0007\u001b[Kp\bp\u0007\u001b[Kr\br\u0007\u001b[Ki\bi\u0007\u001b[Kn\bn\u0007\u001b[Kt\bt\u0007\u001b[Kf\bf\u0007\u001b[K \b \u0007\u001b[K'\b'\u0007\u001b[K%\b%\u0007\u001b[Ks\bs\u0007"]
[26.890494, "o", "\u001b[K\\\b\\\u0007\u001b[Kn\bn\u0007\u001b[K'\b'\u0007\u001b[K \b \u0007\u001b[K'\b'\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K \b \u0007\u001b[Kr\br\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[Ko\bo\u0007\u001b[Kl\bl\u0007\u001b[Kv\bv\u0007\u001b[Ke\be\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007"]
[26.890559, "o", "\u001b[Ka\ba\u0007\u001b[Kb\bb\u0007\u001b[Ko\bo\u0007\u001b[Ku\bu\u0007\u001b[Kt\bt\u0007\u001b[K.\b.\u0007\u001b[Km\bm\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K'\b'\u0007\u001b[K \b \u0007\u001b[K&\b&\u0007\u001b[K&\b&\u0007\u001b[K \b \u0007\u001b[Kc\bc\u0007\u001b[Ka\ba\u0007\u001b[Kt\bt\u0007\u001b[K \b \u0007\u001b[K_\b_\u0007"]
[26.890622, "o", "\u001b[Ki\bi\u0007\u001b[Kn\bn\u0007\u001b[Kc\bc\u0007\u001b[Kl\bl\u0007\u001b[Ku\bu\u0007\u001b[Kd\bd\u0007\u001b[Ke\be\u0007\u001b[Ks\bs\u0007\u001b[K/\b/\u0007\u001b[Ka\ba\u0007\u001b[Kb\bb\u0007\u001b[Ko\bo\u0007\u001b[Ku\bu\u0007\u001b[Kt\bt\u0007\u001b[K.\b.\u0007\u001b[Km\bm\u0007\u001b[Kd\bd\u0007\u001b[K \b \u0007\u001b[K&\b&\u0007\u001b[K&\b&\u0007"]
[26.890681, "o", "\u001b[K \b \u0007\u001b[Kp\bp\u0007\u001b[Kr\br\u0007\u001b[Ki\bi\u0007\u001b[Kn\bn\u0007\u001b[Kt\bt\u0007\u001b[Kf\bf\u0007\u001b[K \b \u0007\u001b[K'\b'\u0007\u001b[K%\b%\u0007\u001b[Ks\bs\u0007\u001b[K\\\b\\\u0007\u001b[Kn\bn\u0007\u001b[K'\b'\u0007\u001b[K \b \u0007\u001b[K'\b'\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K \b \u0007\u001b[Ks\bs\u0007\u001b[Kt\bt\u0007"]
[26.890769, "o", "\u001b[Ka\ba\u0007\u001b[Kt\bt\u0007\u001b[Ku\bu\u0007"]
[26.891063, "o", "\u001b[K\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[K- resolved about.md ---' && cat _includes/about.md && printf '%s\\n' '--- status\bs\u0007\u001b[K \b \u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[K'\b'\u0007\u001b[K \b \u0007\u001b[K&\b&\u0007"]
[26.891081, "o", "\u001b[K&\b&\u0007\u001b[K \b \u0007\u001b[Kg\bg\u0007\u001b[Ki\bi\u0007\u001b[Kt\bt\u0007\u001b[K \b \u0007\u001b[Ks\bs\u0007\u001b[Kt\bt\u0007\u001b[Ka\ba\u0007\u001b[Kt\bt\u0007\u001b[Ku\bu\u0007\u001b[Ks\bs\u0007\u001b[K \b \u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007\u001b[Ks\bs\u0007\u001b[Kh\bh\u0007\u001b[Ko\bo\u0007\u001b[Kr\br\u0007\u001b[Kt\bt\u0007\u001b[K \b \u0007\u001b[K-\b-\u0007\u001b[K-\b-\u0007"]
[26.891448, "o", "\u001b[Kb\bb\u0007\u001b[Kr\br\u0007\u001b[Ka\ba\u0007\u001b[Kn\bn\u0007\u001b[Kc\bc\u0007\u001b[Kh\bh\u0007\r\u001b[K\u001b[7mThere is no --theirs -- _includes/about.md && git add _includes/about.md && printf '%s\\n' '--- resolved about.md ---' && cat _includes/about.md && printf '%s\\n' '--- status ---' && git status --short --branch option  (press RETURN)\u001b[27m"]
[27.934331, "i", "git diff --check && git commit --no-edit\n"]
[27.937347, "o", "\u001b[40;1H\u001b[K\r\u001b[K\u0007\u001b[H\u001b[J\u001b[H\u001b[H\u001b[J\u001b[H\u001b[m\r\n                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-SPACE "]
[27.937714, "o", "        *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Default \"window\" is the screen height.\u001b[m\r\n        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n"]
[27.937768, "o", "\u001b[m\r\n                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[m\r\n  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m\r\n  N                 *  Repeat previous search in reverse direction.\u001b[m\r\n  ESC-n             *  Repeat previous search, spanning files.\u001b[m\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\u001b[m\r\n  ESC-u                Undo (toggle) search highlighting.\u001b[m\r\n  ESC-U                Clear search highlighting.\u001b[m\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A s"]
[27.937788, "o", "earch pattern may begin with one or more of:\u001b[m\r\n        ^N or !  Search for NON-matching lines.\u001b[m\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\u001b[m\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\u001b[m\r\n        ^K       Highlight matches, but don't move (KEEP position).\u001b[m\r\n        ^R       Don't use REGULAR EXPRESSIONS.\u001b[m\r\n        ^W       WRAP search if no match found.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mJUMPING\u001b[0m\u001b[m\r\n\u001b[m\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\u001b[m\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\u001b[m\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m"]
[27.937807, "o", "-th) previous tag.\u001b[m\r\n  {  (  [           *  Find close bracket } ) ].\u001b[m\r\n  }  )  ]           *  Find open bracket { ( [.\u001b[m\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\u001b[m\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Each \"find close bracket\" command goes forward to the close bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\u001b[m\r\n        Each \"find open bracket\" command goes backward to the open bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\u001b[m\r\n\u001b[m\r\n  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\u001b[m\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\u001b[m\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\u001b[m\r\n  ''                   Go to the previous position.\u001b[m\r\n  ^X^X                 Same as '.\u001b[m\r\n  ESC-M\u001b[4m<letter>\u001b[24m        Cle"]
[27.938051, "o", "ar a mark.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A mark is any upper-case or lower-case letter.\u001b[m\r\n        Certain marks are predefined:\u001b[m\r\n             ^  means  beginning of the file\u001b[m\r\n             $  means  end of the file\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                        \u001b[1mCHANGING\u001b[0m \u001b[1mFILES\u001b[0m\u001b[m\r\n\u001b[m\r\n  :e [\u001b[4mfile\u001b[24m]            Examine a new file.\u001b[m\r\n  ^X^V                 Same as :e.\u001b[m\r\n  :n                *  Examine the (\u001b[4mN\u001b[24m-th) next file from the command line.\u001b[m\r\n  :p                *  Examine the (\u001b[4mN\u001b[24m-th) previous file from the command line.\u001b[m\r\n  :x                *  Examine the first (or \u001b[4mN\u001b[24m-th) file from the command line.\u001b[m\r\n  :d                   Delete the current file from the command line list.\u001b[m\r\n  =  ^G  :f            Print current file name.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                  "]
[27.938148, "o", "  \u001b[1mMISCELLANEOUS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[m\r\n  -\u001b[4m<flag>\u001b[24m              Toggle a command line option [see OPTIONS below].\u001b[m\r\n  --\u001b[4m<name>\u001b[24m             Toggle a command line option, by name.\u001b[m\r\n  _\u001b[4m<flag>\u001b[24m              Display the setting of a command line option.\u001b[m\r\n  __\u001b[4m<name>\u001b[24m             Display the setting of an option, by name.\u001b[m\r\n  +\u001b[4mcmd\u001b[24m                 Execute the less cmd each time a new file is examined.\u001b[m\r\n\u001b[m\r\n  !\u001b[4mcommand\u001b[24m             Execute the shell command with $SHELL.\u001b[m\r\n  |\u001b[1mX\u001b[0m\u001b[4mcommand\u001b[24m            Pipe file between current pos & mark \u001b[1mX\u001b[0m to shell command.\u001b[m\r\n  s \u001b[4mfile\u001b[24m               Save input to a file.\u001b[m\r\n  v                    Edit the current file with $VISUAL or $EDITOR.\u001b[m\r\n  V                    Print version number of \"less\".\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mOPT"]
[27.938358, "o", "IONS\u001b[0m\u001b[m\r\n\u001b[m\r\n        Most options may be changed either on the command line,\u001b[m\r\n        or from within less by using the - or -- command.\u001b[m\r\n        Options may be given in one of two forms: either a single\u001b[m\r\n        character preceded by a -, or a name preceded by --.\u001b[m\r\n\u001b[m\r\n  -?  ........  --help\u001b[m\r\n                  Display help (from command line).\u001b[m\r\n  -a  ........  --search-skip-screen\u001b[m\r\n                  Search skips current screen.\u001b[m\r\n  -A  ........  --SEARCH-SKIP-SCREEN\u001b[m\r\n                  Search starts just after target line.\u001b[m\r\n  -b [\u001b[4mN\u001b[24m]  ....  --buffers=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Number of buffers.\u001b[m\r\n  -B  ........  --auto-buffers\u001b[m\r\n                  Don't automatically allocate buffers for pipes.\u001b[m\r\n  -c  ........  --clear-screen\u001b[m\r\n                  Repaint by clearing rather than scrolling.\u001b[m\r\n  -d  ........  --dumb\u001b[m\r\n                  Dumb terminal.\u001b[m\r\n  -D \u001b[1mx\u001b[0m\u001b[4mcolor\u001b[24m  .  --color=\u001b[1mx\u001b[0m\u001b[4mcolor\u001b[24m\u001b[m\r\n                  Set screen "]
[27.938538, "o", "colors.\u001b[m\r\n  -e  -E  ....  --quit-at-eof  --QUIT-AT-EOF\u001b[m\r\n                  Quit at end of file.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  -f  ........  --force\u001b[m\r\n                  Force open non-regular files.\u001b[m\r\n  -F  ........  --quit-if-one-screen\u001b[m\r\n                  Quit if entire file fits on first screen.\u001b[m\r\n  -g  ........  --hilite-search\u001b[m\r\n                  Highlight only last match for searches.\u001b[m\r\n  -G  ........  --HILITE-SEARCH\u001b[m\r\n                  Don't highlight any matches for searches.\u001b[m\r\n  -h [\u001b[4mN\u001b[24m]  ....  --max-back-scroll=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Backward scroll limit.\u001b[m\r\n  -i  ........  --ignore-case\u001b[m\r\n                  Ignore case in searches that do not contain uppercase.\u001b[m\r\n  -I  ........  --IGNORE-CASE\u001b[m\r\n                  Ignore case in all searches.\u001b[m\r\n  -j [\u001b[4mN\u001b[24m]  ....  --jump-target=[\u001b[4mN\u001b[24m]\u001b[m\r\n                  Screen position of target lines.\u001b[m\r\n  -J  ........  --status-column\u001b[m\r\n                  Display a "]
[27.939063, "o", "status column at left edge of screen.\u001b[m\r\n  -k [\u001b[4mfile\u001b[24m]  .  --lesskey-file=[\u001b[4mfile\u001b[24m]\u001b[m\r\n                  Use a lesskey file.\u001b[m\r\n  -K  ........  --quit-on-intr\u001b[m\r\n                  Exit less in response to ctrl-C.\u001b[m\r\n  -L  ........  --no-lessopen\u001b[m\r\n                  Ignore the LESSOPEN environment variable.\u001b[m\r\n  -m  -M  ....  --long-prompt  --LONG-PROMPT\u001b[m\r\n                  Set prompt style.\u001b[m\r\n  -n  -N  ....  --line-numbers  --LINE-NUMBERS\u001b[m\r\n                  Don't use line numbers.\u001b[m\r\n  -o [\u001b[4mfile\u001b[24m]  .  --log-file=[\u001b[4mfile\u001b[24m]\u001b[m\r\n                  Copy to log file (standard input only).\u001b[m\r\n  -O [\u001b[4mfile\u001b[24m]  .  --LOG-FILE=[\u001b[4mfile\u001b[24m]\u001b[m\r\n                  Copy to log file (unconditionally overwrite).\u001b[m\r\n  -p [\u001b[4mpattern\u001b[24m]  --pattern=[\u001b[4mpattern\u001b[24m]\u001b[m\r\n                  Start at pattern (from command line).\u001b[m\r\n  -P [\u001b[4mprompt\u001b[24m]   --prompt=[\u001b[4mprompt\u001b[24m]\u001b[m\r\n                  Define new prompt.\u001b[m\r\n  -q  -Q  ....  --quiet  --QUIET  --silent --SILE"]
[27.939094, "o", "NT\u001b[m\r\n                  Quiet the terminal bell.\u001b[m\r\n  -r  -R  ....  --raw-control-chars  --RAW-CONTROL-CHARS\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[K--\u001b[Kc\bc\u001b[Kh\bh\r\u001b[K--\u001b[Kc\bc\u001b[Kh\bh\u001b[Ko\bo\u001b[Kp\bp\u001b[K-\b-\u001b[Kl\bl\u001b[Ko\bo\u001b[Kn\bn\u001b[Kg\bg\u001b[K-\b-\u001b[Kl\bl\u001b[Ki\bi\u001b[Kn\bn\u001b[Ke\be\u001b[Ks\bs\r\u001b[K\u001b[7mChop long lines  (press RETURN)\u001b[27m"]
[28.921164, "i", "git status --short --branch && git log --graph --oneline --decorate --all -8 && printf '%s\\n' '--- recovered content checks ---' && grep -nE 'Stanford|Postdoc' _includes/about.md _layouts/default.html\n"]
[28.922533, "o", "\u001b[40;1H\u001b[K\r\u001b[K"]
[28.922586, "o", "\u001b[H\u001b[J\u001b[H\u001bM  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM        Default \"half-window\" is half of the screen height.\u001b[m\r\n\u001b[H\u001bM        Default \"window\" is the screen height.\u001b[m\r\n\u001b[H\u001bM        ---------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  R                    Repaint screen, discarding buffered input.\u001b[m\r\n\u001b[H\u001bM  r  ^R  ^L            Repaint screen.\u001b[m\r\n\u001b[H\u001bM  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n\u001b[H\u001bM  F                    Forward forever; like \"tail -f\".\u001b[m\r\n\u001b[H\u001bM  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n\u001b[H\u001bM  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m\r\n\u001b[H\u001bM  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  ESC"]
[28.922601, "o", "-)  RightArrow "]
[28.922907, "o", "*  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n\u001b[H\u001bM  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m\r\n\u001b[H\u001bM  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n\u001b[H\u001bM  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\u001b[m\r\n\u001b[H\u001bM  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n\u001b[H\u001bM  h  H                "]
[28.922937, "o", " Display this help.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m\r\n\u001b[H\u001bM      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n\u001b[H\u001bM      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[H\u001bM                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[H\u001bM\u001b[m\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K"]
[28.923283, "o", "\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[Klog file: "]
[28.924265, "o", "\u001b[Kt\bt\u001b[Ka\ba\u001b[Kt\bt\u001b[Ku\bu\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ks\bs\u001b[Kh\bh\u001b[Ko\bo\u001b[Kr\br\u001b[Kt\bt\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kb\bb\u001b[Kr\br\u001b[Ka\ba\u001b[Kn\bn\u001b[Kc\bc\u001b[Kh\bh\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[Kg\bg\u001b[Ki\bi\u001b[Kt\bt\u001b[K \b \u001b[Kl\bl\u001b[Ko\bo\u001b[Kg\bg\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kg\bg\u001b[Kr\br\u001b[Ka\ba\u001b[Kp\bp\u001b[Kh\bh\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ko\bo\u001b[Kn\bn\u001b[Ke\be\u001b[Kl\bl\u001b[Ki\bi\u001b[Kn\bn\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Kd\bd\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kr\br\u001b[Ka\ba\u001b[Kt\bt\u001b[Ke\be\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[Ka\ba\u001b[Kl\bl\u001b[Kl\bl\u001b[K \b \u001b[K-\b-\u001b[K8\b8\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[Kp\bp\u001b[Kr\br\u001b[Ki\bi\u001b[Kn\bn\u001b[Kt\bt\u001b[Kf\bf\u001b[K \b \u001b[K'\b'\u001b[K%\b%\u001b[Ks\bs\u001b[K\\\b\\\u001b[Kn\bn\u001b[K'\b'\u001b[K \b \u001b[K'\b'\u001b[K-\b-\u001b[K-\b-\u001b[K-\b-\u001b[K \b \u001b[Kr\br\u001b[Ke\be\u001b[Kc\bc\u001b[Ko\bo\u001b[Kv\bv\u001b[Ke\be\u001b[Kr\br\u001b[Ke\be\u001b[Kd\bd\u001b[K \b \u001b[Kc\bc\u001b[Ko\bo\u001b[Kn\bn\u001b[Kt\bt\u001b[Ke\be\u001b[Kn\bn\u001b[Kt\bt\u001b[K \b \u001b[Kc\bc\u001b[Kh\bh\u001b[Ke\be\u001b[Kc\bc\u001b[Kk\bk\u001b[Ks\bs\u001b[K \b \u001b[K-\b-\u001b[K-\b-\u001b[K-\b-\u001b[K'\b'\u001b[K \b \u001b[K&\b&\u001b[K&\b&\u001b[K \b \u001b[Kg\bg\u001b[Kr\br\u001b[Ke\be\u001b[Kp\bp\u001b[K \b \u001b[K-\b-\u001b[Kn\bn\u001b[KE\bE\u001b[K \b \u001b[K'\b'\u001b[KS\bS\u001b[Kt\bt\u001b[Ka\ba\u001b[Kn\bn\u001b[Kf\bf\u001b[Ko\bo\u001b[Kr\br\u001b[Kd\bd\u001b[K|\b|\u001b[KP\bP\u001b[Ko\bo\u001b[Ks\bs\u001b[K\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b"]
[28.924286, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[Kprintf '%s\\n' '--- recovered content checks ---' && grep -nE 'Stanford|Post\bt\u001b[Kd\bd\u001b[Ko\bo\u001b[Kc\bc\u001b[K'\b'\u001b[K \b \u001b[K_\b_\u001b[Ki\bi\u001b[Kn\bn\u001b[Kc\bc"]
[28.92478, "o", "\u001b[Kl\bl\u001b[Ku\bu\u001b[Kd\bd\u001b[Ke\be\u001b[Ks\bs\u001b[K/\b/\u001b[Ka\ba\u001b[Kb\bb\u001b[Ko\bo\u001b[Ku\bu\u001b[Kt\bt\u001b[K.\b.\u001b[Km\bm\u001b[Kd\bd\u001b[K \b \u001b[K_\b_\u001b[Kl\bl\u001b[Ka\ba\u001b[Ky\by\u001b[Ko\bo\u001b[Ku\bu\u001b[Kt\bt\u001b[Ks\bs\u001b[K/\b/\u001b[Kd\bd\u001b[Ke\be\u001b[Kf\bf\u001b[Ka\ba\u001b[Ku\bu\u001b[Kl\bl\u001b[Kt\bt\u001b[K.\b.\u001b[Kh\bh\u001b[Kt\bt\u001b[Km\bm\u001b[Kl\bl\r\u001b[K"]
[29.099706, "o", "\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K"]
