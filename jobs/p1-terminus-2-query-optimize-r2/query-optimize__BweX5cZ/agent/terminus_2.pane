[?2004l[?2004h> WITH word_synset AS MATERIALIZED (
[?2004l[?2004h>   SELECT s.wordid, s.synsetid, COUNT(*) AS sense_count
[?2004l[?2004h>   FROM senses AS s
[?2004l[?2004h>   GROUP BY s.wordid, s.synsetid
[?2004l[?2004h> ), stats AS (
[?2004l[?2004h>   SELECT ws.wordid, w.word,
[?2004l[?2004h>          COUNT(*) AS total_synsets,
[?2004l[?2004h>          SUM(ws.sense_count) AS total_senses,
[?2004l[?2004h>          COUNT(DISTINCT syn.domainid) AS distinct_domains,
[?2004l[?2004h>          COUNT(DISTINCT syn.posid) AS distinct_posids
[?2004l[?2004h>   FROM word_synset AS ws
[?2004l[?2004h>   JOIN words AS w ON w.wordid = ws.wordid
[?2004l[?2004h>   JOIN synsets AS syn ON syn.synsetid = ws.synsetid
[?2004l[?2004h>   GROUP BY ws.wordid, w.word
[?2004l[?2004h>   HAVING total_synsets >= 2
[?2004l[?2004h>      AND distinct_domains >= 2
[?2004l[?2004h>      AND total_senses >= 2
[?2004l[?2004h> ), ranked AS (
[?2004l[?2004h>   SELECT wordid, synsetid, sense_count,
[?2004l[?2004h>          ROW_NUMBER() OVER (
[?2004l[?2004h>            PARTITION BY wordid
[?2004l[?2004h>            ORDER BY sense_count DESC, synsetid ASC
[?2004l[?2004h>          ) AS rn
[?2004l[?2004h>   FROM word_synset
[?2004l[?2004h> )
[?2004l[?2004h> SELECT st.wordid AS word_id,
[?2004l[?2004h>        st.word AS word,
[?2004l[?2004h>        st.total_synsets,
[?2004l[?2004h>        st.total_senses,
