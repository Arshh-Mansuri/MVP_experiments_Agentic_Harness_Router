[?2004l[?2004h>        st.distinct_posids,
[?2004l[?2004h>        r.synsetid AS top_synsetid,
[?2004l[?2004h>        r.sense_count AS top_synset_sense_count
[?2004l[?2004h> FROM stats AS st
[?2004l[?2004h> JOIN ranked AS r ON r.wordid = st.wordid AND r.rn = 1
[?2004l[?2004h> ORDER BY st.total_senses DESC,
[?2004l[?2004h>          st.total_synsets DESC,
