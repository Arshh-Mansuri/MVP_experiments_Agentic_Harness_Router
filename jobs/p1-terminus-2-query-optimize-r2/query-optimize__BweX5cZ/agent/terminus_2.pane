ynsetid, r.sense_count AS top_synset_sense_count FROM stats AS st JOIN ranked AS r ON r.wordid = st.wordid AND r.rn = 1 ORDER BY st.total_senses DESC, st.total_synsets DESC, st.distinct_domains DESC, word_id ASC LIMIT 500)));"
