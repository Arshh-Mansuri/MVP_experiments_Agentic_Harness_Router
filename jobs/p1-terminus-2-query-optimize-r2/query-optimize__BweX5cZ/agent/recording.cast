[48.687698, "i", "sqlite3 -separator '|' /app/oewn.sqlite \"ATTACH '/tmp/optimized.sql' AS unused; SELECT 'original_minus_optimized', count(*) FROM ((SELECT * FROM (SELECT w.wordid AS word_id, w.word AS word, total_synsets, total_senses, distinct_domains, distinct_posids, (SELECT s.synsetid FROM senses s WHERE s.wordid = w.wordid GROUP BY s.synsetid ORDER BY COUNT(*) DESC, s.synsetid ASC LIMIT 1) AS top_synsetid, (SELECT COUNT(*) FROM senses s WHERE s.wordid = w.wordid AND s.synsetid = (SELECT s2.synsetid FROM senses s2 WHERE s2.wordid = w.wordid GROUP BY s2.synsetid ORDER BY COUNT(*) DESC, s2.synsetid ASC LIMIT 1)) AS top_synset_sense_count FROM (SELECT w.wordid, w.word, COUNT(DISTINCT s.synsetid) AS total_synsets, COUNT(*) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM words w JOIN senses s ON w.wordid = s.wordid JOIN synsets syn ON s.synsetid = syn.synsetid GROUP BY w.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2) w ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, word_id ASC LIMIT 500)) EXCEPT SELECT * FROM (SELECT * FROM (WITH word_synset AS MATERIALIZED (SELECT s.wordid, s.synsetid, COUNT(*) AS sense_count FROM senses AS s GROUP BY s.wordid, s.synsetid), stats AS (SELECT ws.wordid, w.word, COUNT(*) AS total_synsets, SUM(ws.sense_count) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM word_synset AS ws JOIN words AS w ON w.wordid = ws.wordid JOIN synsets AS syn ON syn.synsetid = ws.synsetid GROUP BY ws.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2), ranked AS (SELECT wordid, synsetid, sense_count, ROW_NUMBER() OVER (PARTITION BY wordid ORDER BY sense_count DESC, synsetid ASC) AS rn FROM word_synset) SELECT st.wordid AS word_id, st.word AS word, st.total_synsets, st.total_senses, st.distinct_domains, st.distinct_posids, r.synsetid AS top_synsetid, r.sense_count AS top_synset_sense_count FROM stats AS st JOIN ranked AS r ON r.wordid = st.wordid AND r.rn = 1 ORDER BY st.total_senses DESC, st.total_synsets DESC, st.distinct_domains DESC, word_id ASC LIMIT 500)));\"\n"]
[48.689117, "o", "sqlite3 -separator '|' /app/oewn.sqlite \"ATTACH '/tmp/optimized.sql' AS unused; SELECT 'original_minus_optimized', count(*) FROM ((SELECT * FROM (SELECT w.wordid AS word_id, w.word AS word, total_synsets, total_senses, distinct_domains, distinct_posids, (SELECT s.synsetid FROM senses s WHERE s.wordid = w.wordid GROUP BY s.synsetid ORDER BY COUNT(*) DESC, s.synsetid ASC LIMIT 1) AS top_synsetid, (SELECT COUNT(*) FROM senses s WHERE s.wordid = w.wordid AND s.synsetid = (SELECT s2.synsetid FROM senses s2 WHERE s2.wordid = w.wordid GROUP BY s2.synsetid ORDER BY COUNT(*) DESC, s2.synsetid ASC LIMIT 1)) AS top_synset_sense_count FROM (SELECT w.wordid, w.word, COUNT(DISTINCT s.synsetid) AS total_synsets, COUNT(*) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM words w JOIN senses s ON w.wordid = s.wordid JOIN synsets syn ON s.synsetid = syn.synsetid GROUP BY w.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2) w ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, word_id ASC LIMIT 500)) EXCEPT SELECT * FROM (SELECT * FROM (WITH word_synset AS MATERIALIZED (SELECT s.wordid, s.synsetid, COUNT(*) AS sense_count FROM senses AS s GROUP BY s.wordid, s.synsetid), stats AS (SELECT ws.wordid, w.word, COUNT(*) AS total_synsets, SUM(ws.sense_count) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM word_synset AS ws JOIN words AS w ON w.wordid = ws.wordid JOIN synsets AS syn ON syn.synsetid = ws.synsetid GROUP BY ws.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2), ranked AS (SELECT wordid, synsetid, sense_count, ROW_NUMBER() OVER (PARTITION BY wordid ORDER BY sense_count DESC, synsetid ASC) AS rn FROM word_synset) SELECT st.wordid AS word_id, st.word AS word, st.total_synsets, st.total_senses, st.distinct_domains, st.distinct_posids, r.synsetid AS top_synsetid, r.sense_count AS top_synset_sense_count FROM stats AS st JOIN ranked AS r ON r.wordid = st.wordid AND r.rn = 1 ORDER BY st.total_senses DESC, st.total_synsets DESC, st.distinct_domains DESC, word_id ASC LIMIT 500)));\"\r\n"]
