[47.766042, "i", "printf 'original rows: '; wc -l < /tmp/original.out; printf 'optimized rows: '; wc -l < /tmp/optimized.out; printf 'original hash: '; sha256sum /tmp/original.out; printf 'optimized hash: '; sha256sum /tmp/optimized.out; printf 'byte comparison: '; cmp -s /tmp/original.out /tmp/optimized.out && echo MATCH || echo DIFFERENT; printf 'text diff lines: '; diff -u /tmp/original.out /tmp/optimized.out | wc -l\n"]
