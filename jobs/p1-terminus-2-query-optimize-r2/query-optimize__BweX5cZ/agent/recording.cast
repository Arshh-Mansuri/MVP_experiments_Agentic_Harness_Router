[26.841885, "i", "sqlite3 /app/oewn.sqlite 'EXPLAIN QUERY PLAN SELECT w.wordid AS word_id, w.word AS word, total_synsets, total_senses, distinct_domains, distinct_posids, (SELECT s.synsetid FROM senses s WHERE s.wordid = w.wordid GROUP BY s.synsetid ORDER BY COUNT(*) DESC, s.synsetid ASC LIMIT 1) AS top_synsetid, (SELECT COUNT(*) FROM senses s WHERE s.wordid = w.wordid AND s.synsetid = (SELECT s2.synsetid FROM senses s2 WHERE s2.wordid = w.wordid GROUP BY s2.synsetid ORDER BY COUNT(*) DESC, s2.synsetid ASC LIMIT 1)) AS top_synset_sense_count FROM (SELECT w.wordid, w.word, COUNT(DISTINCT s.synsetid) AS total_synsets, COUNT(*) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM words w JOIN senses s ON w.wordid = s.wordid JOIN synsets syn ON s.synsetid = syn.synsetid GROUP BY w.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2) w ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, word_id ASC LIMIT 500;'\n"]
[26.844701, "o", "sqlite3 /app/oewn.sqlite 'EXPLAIN QUERY PLAN SELECT w.wordid AS word_id, w.word AS word, total_synsets, total_senses, distinct_domains, distinct_posids, (SELECT s.synsetid FROM senses s WHERE s.wordid = w.wordid GROUP BY s.synsetid ORDER BY COUNT(*) DESC, s.synsetid ASC LIMIT 1) AS top_synsetid, (SELECT COUNT(*) FROM senses s WHERE s.wordid = w.wordid AND s.synsetid = (SELECT s2.synsetid FROM senses s2 WHERE s2.wordid = w.wordid GROUP BY s2.synsetid ORDER BY COUNT(*) DESC, s2.synsetid ASC LIMIT 1)) AS top_synset_sense_count FROM (SELECT w.wordid, w.word, COUNT(DISTINCT s.synsetid) AS total_synsets, COUNT(*) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids FROM words w JOIN senses s ON w.wordid = s.wordid JOIN synsets syn ON s.synsetid = syn.synsetid GROUP BY w.wordid, w.word HAVING total_synsets >= 2 AND distinct_domains >= 2 AND total_senses >= 2) w ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, word_id ASC LIMIT 500;'\r\n\u001b[?2004l\r"]
[26.935195, "o", "QUERY PLAN\r\n"]
[26.936623, "o", "|--CO-ROUTINE w\r\n|  |--SCAN w\r\n|  |--BLOOM FILTER ON s (wordid=?)\r\n|  |--SEARCH s USING AUTOMATIC COVERING INDEX (wordid=?)\r\n|  |--BLOOM FILTER ON syn (synsetid=?)\r\n|  |--SEARCH syn USING AUTOMATIC COVERING INDEX (synsetid=?)\r\n|  |--USE TEMP B-TREE FOR GROUP BY\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  `--USE TEMP B-TREE FOR count(DISTINCT)\r\n|--SCAN w\r\n|--CORRELATED SCALAR SUBQUERY 1\r\n|  |--SCAN s\r\n|  |--USE TEMP B-TREE FOR GROUP BY\r\n|  `--USE TEMP B-TREE FOR ORDER BY\r\n|--CORRELATED SCALAR SUBQUERY 3\r\n|  |--SCAN s\r\n|  `--CORRELATED SCALAR SUBQUERY 2\r\n|     |--SCAN s2\r\n|     |--USE TEMP B-TREE FOR GROUP BY\r\n|     `--USE TEMP B-TREE FOR ORDER BY\r\n`--USE TEMP B-TREE FOR ORDER BY\r\n"]
[26.941912, "o", "\u001b[?2004hroot@6ba82ed897d4:/app# "]
[27.867421, "i", "cat > /tmp/optimized.sql <<'SQL'\nWITH word_synset AS MATERIALIZED (\n  SELECT s.wordid, s.synsetid, COUNT(*) AS sense_count\n  FROM senses AS s\n  GROUP BY s.wordid, s.synsetid\n), stats AS (\n  SELECT ws.wordid, w.word,\n         COUNT(*) AS total_synsets,\n         SUM(ws.sense_count) AS total_senses,\n         COUNT(DISTINCT syn.domainid) AS distinct_domains,\n         COUNT(DISTINCT syn.posid) AS distinct_posids\n  FROM word_synset AS ws\n  JOIN words AS w ON w.wordid = ws.wordid\n  JOIN synsets AS syn ON syn.synsetid = ws.synsetid\n  GROUP BY ws.wordid, w.word\n  HAVING total_synsets >= 2\n     AND distinct_domains >= 2\n     AND total_senses >= 2\n), ranked AS (\n  SELECT wordid, synsetid, sense_count,\n         ROW_NUMBER() OVER (\n           PARTITION BY wordid\n           ORDER BY sense_count DESC, synsetid ASC\n         ) AS rn\n  FROM word_synset\n)\nSELECT st.wordid AS word_id,\n       st.word AS word,\n       st.total_synsets,\n       st.total_senses,\n       st.distinct_domains,\n       st.distinct_posids,\n       r.synsetid AS top_synsetid,\n       r.sense_count AS top_synset_sense_count\nFROM stats AS st\nJOIN ranked AS r ON r.wordid = st.wordid AND r.rn = 1\nORDER BY st.total_senses DESC,\n         st.total_synsets DESC,\n         st.distinct_domains DESC,\n         word_id ASC\nLIMIT 500;\nSQL\nsqlite3 /app/oewn.sqlite < /tmp/optimized.sql > /tmp/optimized.out\nsqlite3 /app/oewn.sqlite < /app/my-sql-query.sql > /tmp/original.out\nprintf 'original rows: '; wc -l < /tmp/original.out\nprintf 'optimized rows: '; wc -l < /tmp/optimized.out\nprintf 'original hash: '; sha256sum /tmp/original.out\nprintf 'optimized hash: '; sha256sum /tmp/optimized.out\nprintf 'differences: '; diff -u /tmp/original.out /tmp/optimized.out | head -40\n"]
[27.869137, "o", "cat > /tmp/optimized.sql <<'SQL'"]
[27.869213, "o", "\r\n\u001b[?2004l\r"]
[27.875542, "o", "\u001b[?2004h> WITH word_synset AS MATERIALIZED (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT s.wordid, s.synsetid, COUNT(*) AS sense_count\r\n\u001b[?2004l\r\u001b[?2004h>   FROM senses AS s\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY s.wordid, s.synsetid\r\n\u001b[?2004l\r\u001b[?2004h> ), stats AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT ws.wordid, w.word,\r\n\u001b[?2004l\r\u001b[?2004h>          COUNT(*) AS total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h>          SUM(ws.sense_count) AS total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>          COUNT(DISTINCT syn.domainid) AS distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h>          COUNT(DISTINCT syn.posid) AS distinct_posids\r\n\u001b[?2004l\r\u001b[?2004h>   FROM word_synset AS ws\r\n\u001b[?2004l\r\u001b[?2004h>   JOIN words AS w ON w.wordid = ws.wordid\r\n\u001b[?2004l\r\u001b[?2004h>   JOIN synsets AS syn ON syn.synsetid = ws.synsetid\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY ws.wordid, w.word\r\n\u001b[?2004l\r\u001b[?2004h>   HAVING total_synsets >= 2\r\n\u001b[?2004l\r\u001b[?2004h>      AND distinct_domains >= 2\r\n\u001b[?2004l\r\u001b[?2004h>      AND total_senses >= 2\r\n\u001b[?2004l\r\u001b[?2004h> ), ranked AS (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT wordid, synsetid, sense_count,\r\n\u001b[?2004l\r\u001b[?2004h>          ROW_NUMBER() OVER (\r\n\u001b[?2004l\r\u001b[?2004h>            PARTITION BY wordid\r\n\u001b[?2004l\r\u001b[?2004h>            ORDER BY sense_count DESC, synsetid ASC\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.875851, "o", ">          ) AS rn\r\n\u001b[?2004l\r\u001b[?2004h>   FROM word_synset\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> SELECT st.wordid AS word_id,\r\n\u001b[?2004l\r\u001b[?2004h>        st.word AS word,\r\n\u001b[?2004l\r"]
[27.875932, "o", "\u001b[?2004h> "]
[27.876879, "o", "       st.total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h>        st.total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>        st.distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h>        st.distinct_posids,\r\n\u001b[?2004l\r\u001b[?2004h>        r.synsetid AS top_synsetid,\r\n\u001b[?2004l\r\u001b[?2004h>        r.sense_count AS top_synset_sense_count\r\n\u001b[?2004l\r\u001b[?2004h> FROM stats AS st\r\n\u001b[?2004l\r\u001b[?2004h> "]
