[163.460961, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nreplacements = {\n    'pyknotid/spacecurves/spacecurve.py': {\n        'np.float': 'float',\n        'np.bool': 'bool',\n    },\n    'pyknotid/spacecurves/periodiccell.py': {\n        'np.int': 'np.int64',\n    },\n    'pyknotid/spacecurves/ccomplexity.pyx': {\n        'np.int': 'np.int64',\n    },\n}\nfor name, pairs in replacements.items():\n    p = Path(name)\n    s = p.read_text()\n    old = s\n    for a, b in pairs.items():\n        s = s.replace(a, b)\n    if s != old:\n        p.write_text(s)\n        print('patched', name)\nPY\nrm -rf build\npython3 setup.py build_ext --inplace 2>&1 | tee /tmp/pyknotid-build-final.log\n"]
