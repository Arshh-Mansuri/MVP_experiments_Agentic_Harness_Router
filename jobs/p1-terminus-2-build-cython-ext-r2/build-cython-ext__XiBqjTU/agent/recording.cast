[615.734776, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nimport re\n# spacecurve.py aliases NumPy as n; replace removed scalar aliases only.\nfor p in Path('pyknotid').rglob('*.py'):\n    s=p.read_text()\n    old=s\n    for name,replacement in {\n        'int':'int','float':'float','bool':'bool','complex':'complex',\n        'object':'object','unicode':'str','str':'str'\n    }.items():\n        s=re.sub(r'(?<![A-Za-z0-9_])n\\.'+name+r'(?![A-Za-z0-9_])', replacement, s)\n    if s != old:\n        p.write_text(s)\n        print('patched',p)\nPY\npython3 -m pip install --no-deps .\npython3 - <<'PY'\nimport numpy as np\nimport pyknotid\nfrom pyknotid.spacecurves import chelpers, ccomplexity\nfrom pyknotid import cinvariants\nimport pyknotid.make as mk\nimport pyknotid.spacecurves as sp\nprint('numpy:', np.__version__)\nprint('pyknotid:', pyknotid.__file__)\nprint('chelpers:', chelpers.__file__)\nprint('ccomplexity:', ccomplexity.__file__)\nprint('cinvariants:', cinvariants.__file__)\nk=sp.Knot(mk.three_twist(num_points=100))\nprint('SMO"]
