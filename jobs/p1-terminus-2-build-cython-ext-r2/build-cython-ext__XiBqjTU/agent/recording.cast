[517.409922, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nimport re\n# Replace exact removed aliases only; np.float64/np.int64/etc. are left unchanged.\nrepls = {\n    'int': 'int',\n    'float': 'float',\n    'bool': 'bool',\n    'complex': 'complex',\n    'object': 'object',\n    'unicode': 'str',\n    'str': 'str',\n}\nfor p in Path('pyknotid').rglob('*'):\n    if p.suffix not in ('.py', '.pyx', '.pxd'):\n        continue\n    s = p.read_text()\n    old = s\n    for name, replacement in repls.items():\n        s = re.sub(r'(?<![A-Za-z0-9_])(?:np|numpy)\\.' + name + r'(?![A-Za-z0-9_])', replacement, s)\n    if s != old:\n        p.write_text(s)\n        print('patched', p)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nimport re\nbad=[]\nfor p in Path('pyknotid').rglob('*'):\n    if p.suffix in ('.py','.pyx','.pxd'):\n        for n,line in enumerate(p.read_text().splitlines(),1):\n            if re.search(r'\\b(?:np|numpy)\\.(?:int|float|bool|complex|object|unicode|str)(?![A-Za-z0-9_])', line): bad.append(f'{p}:{n}:{line}')\nprint('\\"]
