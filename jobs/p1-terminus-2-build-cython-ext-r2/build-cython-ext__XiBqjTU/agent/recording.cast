[586.171497, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mk3_1\u001b[39;49;00m(num_points=\u001b[94m100\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m'''Returns a particular trefoil knot conformation.'''\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        data = n.zeros((num_points, \u001b[94m3\u001b[39;49;00m), dtype=n.float64)\u001b[90m\u001b[39;49;00m\r\n        ts = n.linspace(\u001b[94m0\u001b[39;49;00m, \u001b[94m2\u001b[39;49;00m*n.pi, num_points)\u001b[90m\u001b[39;49;00m\r\n        data[:, \u001b[94m0\u001b[39;49;00m] = (\u001b[94m2\u001b[39;49;00m+n.cos(\u001b[94m3\u001b[39;49;00m*ts))*n.cos(\u001b[94m2\u001b[39;49;00m*ts)\u001b[90m\u001b[39;49;00m\r\n        data[:, \u001b[94m1\u001b[39;49;00m] = (\u001b[94m2\u001b[39;49;00m+n.cos(\u001b[94m3\u001b[39;49;00m*ts))*n.sin(\u001b[94m2\u001b[39;49;00m*ts)\u001b[90m\u001b[39;49;00m\r\n        data[:, \u001b[94m2\u001b[39;49;00m] = n.sin(\u001b[94m3\u001b[39;49;00m*ts)\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94mreturn\u001b[39;49;00m Knot(data)\u001b[90m\u001b[39;49;00m\r\n               ^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31mpyknotid/make/named.py\u001b[0m:37: \r\n"]
