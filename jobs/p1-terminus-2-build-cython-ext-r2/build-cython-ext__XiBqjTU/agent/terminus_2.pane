                    normal_1 /= n.linalg.norm(normal_1)

                    join_2 = n.array([line[3, 0], line[3, 1], 0]) - n.array([line[1, 0], line[1, 1], 0])
                    normal_2 = n.cross(join_2, [0, 0, 1])[:2]
