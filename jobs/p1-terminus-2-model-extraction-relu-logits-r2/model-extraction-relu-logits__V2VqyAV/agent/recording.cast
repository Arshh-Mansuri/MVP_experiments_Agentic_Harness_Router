[124.788452, "i", "cat > /app/steal.py <<'PY'\nimport numpy as np\nimport forward\n\nD = 10\nN = 20\n\ndef f(x):\n    return float(forward.forward(np.asarray(x, dtype=float)))\n\ndef grad(x, h=1e-6):\n    x = np.asarray(x, dtype=float)\n    g = np.empty(D)\n    for k in range(D):\n        d = np.zeros(D)\n        d[k] = h\n        g[k] = (f(x+d)-f(x-d))/(2*h)\n    return g\n\ndef kink_indices(v, lo=-40., hi=40., step=.01):\n    ts = np.arange(lo, hi+step*.5, step)\n    yy = np.array([f(t*v) for t in ts])\n    ss = np.diff(yy)/step\n    # The forward function is evaluated in float64, so this threshold is\n    # safely above query roundoff but below even small ReLU slope jumps.\n    dd = np.diff(ss)\n    scale = max(1., float(np.max(np.abs(ss))))\n    mark = np.where(np.abs(dd) > max(2e-9, 2e-8*scale))[0]\n    if not len(mark):\n        return []\n    groups=[]\n    for q in mark:\n        if not groups or q > groups[-1][-1]+2:\n            groups.append([int(q)])\n        else:\n            groups[-1].append(int(q))\n    ans=[]\n    for gr in groups:\n        j=gr[l"]
