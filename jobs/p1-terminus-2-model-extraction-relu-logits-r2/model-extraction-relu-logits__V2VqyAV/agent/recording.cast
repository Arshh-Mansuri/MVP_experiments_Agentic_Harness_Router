[124.792059, "i", "en(gr)//2]\n        # A single kink between t_j and t_{j+1} makes s[j] mixed.\n        # Use stable cells s[j-1] and s[j+1] and probe well outside.\n        if j < 2 or j+2 >= len(ss):\n            continue\n        left_s = .5*(ss[j-2]+ss[j-1])\n        right_s = .5*(ss[j+1]+ss[j+2])\n        if abs(right_s-left_s) < 1e-10:\n            continue\n        # If several cells were marked, retain only transitions whose\n        # surrounding slopes really differ.\n        ans.append((j, ts[j]-.25*step, ts[j+1]+.25*step))\n    return ans\n\ndef add(found, z):\n    n=np.linalg.norm(z)\n    if not np.isfinite(n) or n < 1e-7:\n        return\n    z=z/n\n    for i,u in enumerate(found):\n        c=float(np.dot(u,z))\n        if abs(c)>.985:\n            if c<0: z=-z\n            w=u+z\n            found[i]=w/np.linalg.norm(w)\n            return\n    found.append(z)\n\ndef main():\n    rng=np.random.default_rng(731927)\n    found=[]\n    for trial in range(40):\n        v=rng.normal(size=D)\n        v/=np.linalg.norm(v)\n        for j,tl,tr in kink_i"]
[124.792215, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import forward\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> D = 10\r\n\u001b[?2004l\r\u001b[?2004h> N = 20\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def f(x):\r\n\u001b[?2004l\r\u001b[?2004h>     return float(forward.forward(np.asarray(x, dtype=float)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def grad(x, h=1e-6):\r\n\u001b[?2004l\r\u001b[?2004h>     x = np.asarray(x, dtype=float)\r\n\u001b[?2004l\r\u001b[?2004h>     g = np.empty(D)\r\n\u001b[?2004l\r\u001b[?2004h>     for k in range(D):\r\n\u001b[?2004l\r\u001b[?2004h>         d = np.zeros(D)\r\n\u001b[?2004l\r\u001b[?2004h>         d[k] = h\r\n\u001b[?2004l\r\u001b[?2004h>         g[k] = (f(x+d)-f(x-d))/(2*h)\r\n\u001b[?2004l\r\u001b[?2004h>     return g\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def kink_indices(v, lo=-40., hi=40., step=.01):\r\n\u001b[?2004l\r\u001b[?2004h>     ts = np.arange(lo, hi+step*.5, step)\r\n\u001b[?2004l\r\u001b[?2004h>     yy = np.array([f(t*v) for t in ts])\r\n\u001b[?2004l\r\u001b[?2004h>     ss = np.diff(yy)/step\r\n\u001b[?2004l\r\u001b[?2004h>     # The forward function is evaluated in float64, so this threshold is\r\n\u001b[?2004l\r\u001b[?2004h>     # safely"]
[124.792498, "i", "ndices(v):\n            # Probe at points in the neighboring linear regions.  The\n            # separation is larger than finite-difference h and smaller than\n            # the grid spacing, so unrelated knots are unlikely to intrude.\n            gl=grad(tl*v)\n            gr=grad(tr*v)\n            add(found, gr-gl)\n        if trial % 5 == 4:\n            print('scan', trial+1, 'directions', len(found))\n        if len(found)>=N:\n            break\n    if len(found)<N:\n        raise RuntimeError('recovered only %d of %d directions' % (len(found),N))\n    out=np.asarray(found[:N], dtype=float)\n    np.save('/app/stolen_A1.npy', out)\n    print('recovered matrix shape:', out.shape)\n    print(out)\n\nif __name__=='__main__':\n    main()\nPY\npython3 /app/steal.py\nls -l /app/stolen_A1.npy\n"]
[124.792707, "o", " above query roundoff but below even small ReLU slope jumps.\r\n\u001b[?2004l\r\u001b[?2004h>     dd = np.diff(ss)\r\n\u001b[?2004l\rndices(v):\r\n            # Probe at points in the neighboring linear regions.  The\r\n            # separation is larger than finite-difference h and smaller than\r\n            # the grid spacing, so unrelated knots are unlikely to intrude.\r\n            gl=grad(tl*v)\r\n            gr=grad(tr*v)\r\n            add(found, gr-gl)\r\n        if trial % 5 == 4:\r\n            print('scan', trial+1, 'directions', len(found))\r\n        if len(found)>=N:\r\n            break\r\n    if len(found)<N:\r\n        raise RuntimeError('recovered only %d of %d directions' % (len(found),N))\r\n    out=np.asarray(found[:N], dtype=float)\r\n    np.save('/app/stolen_A1.npy', out)\r\n    print('recovered matrix shape:', out.shape)\r\n    print(out)\r\n\r\nif __name__=='__main__':\r\n    main()\r\nPY\r\npython3 /app/steal.py\r\nls -l /app/stolen_A1.npy\r\n\u001b[?2004h>     scale = max(1., float(np.max(np.abs(ss))))\r\n\u001b[?2004l\r"]
[124.792746, "o", "\u001b[?2004h> "]
[124.792887, "o", "    mark = np.where(np.abs(dd) > max(2e-9, 2e-8*scale))[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.793021, "o", "    if not len(mark):\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r"]
[124.793145, "o", "\u001b[?2004h>     groups=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for q in mark:\r\n\u001b[?2004l\r"]
[124.793168, "o", "\u001b[?2004h"]
[124.793461, "o", ">         if not groups or q > groups[-1][-1]+2:\r\n\u001b[?2004l\r\u001b[?2004h>             groups.append([int(q)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.793527, "o", ">         else:\r\n\u001b[?2004l\r"]
[124.794093, "o", "\u001b[?2004h>             groups[-1].append(int(q))\r\n\u001b[?2004l\r\u001b[?2004h>     ans=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for gr in groups:\r\n\u001b[?2004l\r\u001b[?2004h>         j=gr[len(gr)//2]\r\n\u001b[?2004l\r\u001b[?2004h>         # A single kink between t_j and t_{j+1} makes s[j] mixed.\r\n\u001b[?2004l\r"]
[124.794182, "o", "\u001b[?2004h> "]
[124.794583, "o", "        # Use stable cells s[j-1] and s[j+1] and probe well outside.\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.795156, "o", ">         if j < 2 or j+2 >= len(ss):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         left_s = .5*(ss[j-2]+ss[j-1])\r\n\u001b[?2004l\r\u001b[?2004h>         right_s = .5*(ss[j+1]+ss[j+2])\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(right_s-left_s) < 1e-10:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.795915, "o", "        # If several cells were marked, retain only transitions whose\r\n\u001b[?2004l\r\u001b[?2004h>         # surrounding slopes really differ.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.795953, "o", "        ans.append((j, ts[j]-.25*step, ts[j+1]+.25*step))\r\n\u001b[?2004l\r\u001b[?2004h>     return ans\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def add(found, z):\r\n\u001b[?2004l\r\u001b[?2004h>     n=np.linalg.norm(z)\r\n\u001b[?2004l\r\u001b[?2004h>     if not np.isfinite(n) or n < 1e-7:\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     z=z/n\r\n\u001b[?2004l\r\u001b[?2004h>     for i,u in enumerate(found):\r\n\u001b[?2004l\r\u001b[?2004h>         c=float(np.dot(u,z))\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(c)>.985:\r\n\u001b[?2004l\r\u001b[?2004h>             if c<0: z=-z\r\n\u001b[?2004l\r\u001b[?2004h>             w=u+z\r\n\u001b[?2004l\r"]
[124.796215, "o", "\u001b[?2004h>             found[i]=w/np.linalg.norm(w)\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.796755, "o", ">     found.append(z)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     rng=np.random.default_rng(731927)\r\n\u001b[?2004l\r\u001b[?2004h>     found=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for trial in range(40):\r\n\u001b[?2004l\r\u001b[?2004h>         v=rng.normal(size=D)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.796854, "o", "        v/=np.linalg.norm(v)\r\n\u001b[?2004l\r"]
[124.796901, "o", "\u001b[?2004h"]
[124.797057, "o", "> "]
[124.797748, "o", "        for j,tl,tr in kink_indices(v):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.798558, "o", "            # Probe at points in the neighboring linear regions.  The\r\n\u001b[?2004l\r\u001b[?2004h>             # separation is larger than finite-difference h and smaller than\r\n\u001b[?2004l\r\u001b[?2004h>             # the grid spacing, so unrelated knots are unlikely to intrude.\r\n\u001b[?2004l\r\u001b[?2004h>             gl=grad(tl*v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
