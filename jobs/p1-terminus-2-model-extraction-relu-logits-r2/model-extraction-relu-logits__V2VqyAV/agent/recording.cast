[83.493343, "i", "cat > /app/steal.py <<'PY'\nimport numpy as np\nimport forward\n\nDIM = 10\nNEXPECTED = 20\n\ndef F(x):\n    return float(forward.forward(np.asarray(x, dtype=float)))\n\n\ndef gradient(x, h=2e-6):\n    x = np.asarray(x, dtype=float)\n    g = np.empty(DIM)\n    for k in range(DIM):\n        d = np.zeros(DIM)\n        d[k] = h\n        g[k] = (F(x + d) - F(x - d)) / (2*h)\n    return g\n\n\ndef find_kinks(v, lo=-35.0, hi=35.0, step=0.05):\n    ts = np.arange(lo, hi + step/2, step)\n    ys = np.array([F(t*v) for t in ts])\n    s = np.diff(ys) / step\n    # A ReLU kink produces a jump in consecutive cell slopes.\n    ds = np.abs(np.diff(s))\n    threshold = max(1e-7, 1e-6*np.max(np.abs(s)))\n    inds = np.where(ds > threshold)[0]\n    result = []\n    for i in inds:\n        # s[i] is the cell immediately before/containing the transition and\n        # s[i+1] is immediately after it. Avoid edges and neighboring kinks.\n        if i < 2 or i+2 >= len(ts)-1:\n            continue\n        ml = (s[i-1] + s[i]) / 2.0\n        mr = (s[i+1] + s[i+2]) / 2"]
[83.495002, "o", "cat > /app/steal.py <<'PY'\r\n\u001b[?2004l\r"]
[83.495593, "i", ".0\n        if abs(mr-ml) < 1e-9:\n            continue\n        # Use points definitely on the two sides of the kink. The affine\n        # pieces are y=ml*t+cl and y=mr*t+cr.\n        tl = ts[i]\n        tr = ts[i+2]\n        cl = ys[i] - ml*tl\n        cr = ys[i+2] - mr*tr\n        t = (cl-cr)/(mr-ml)\n        if lo+step < t < hi-step:\n            result.append(float(t))\n    # Deduplicate detections from adjacent slope differences.\n    result.sort()\n    out = []\n    for t in result:\n        if not out or abs(t-out[-1]) > 0.01:\n            out.append(t)\n    return out\n\n\ndef add_direction(found, z):\n    n = np.linalg.norm(z)\n    if not np.isfinite(n) or n < 1e-6:\n        return\n    z = z/n\n    for j, u in enumerate(found):\n        if abs(np.dot(u,z)) > 0.995:\n            if np.dot(u,z) < 0:\n                z = -z\n            found[j] = (u+z)/np.linalg.norm(u+z)\n            return\n    found.append(z)\n\n\ndef main():\n    rng = np.random.default_rng(24681357)\n    found = []\n    for trial in range(30):\n        v = rng.norma"]
