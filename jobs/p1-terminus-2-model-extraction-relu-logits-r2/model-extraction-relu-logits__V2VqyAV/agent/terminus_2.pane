[?2004l[?2004h>             gr=grad(tr*v)
[?2004l[?2004h>             add(found, gr-gl)
[?2004l[?2004h>         if trial % 5 == 4:
[?2004l[?2004h>             print('scan', trial+1, 'directions', len(found))
[?2004l[?2004h>         if len(found)>=N:
[?2004l[?2004h>             break
[?2004l[?2004h>     if len(found)<N:
[?2004l[?2004h>         raise RuntimeError('recovered only %d of %d directions' % (len(found),N))
[?2004l[?2004h>     out=np.asarray(found[:N], dtype=float)
[?2004l[?2004h>     np.save('/app/stolen_A1.npy', out)
[?2004l[?2004h>     print('recovered matrix shape:', out.shape)
[?2004l[?2004h>     print(out)
[?2004l[?2004h> 
