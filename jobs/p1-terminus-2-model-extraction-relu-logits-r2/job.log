Sending keys: ["cat > /app/steal.py <<'PY'\nimport numpy as np\nimport forward\n\nD = 10\nN = 20\n\ndef f(x):\n    return float(forward.forward(np.asarray(x, dtype=float)))\n\ndef grad(x, h=1e-6):\n    x = np.asarray(x, dtype=float)\n    g = np.empty(D)\n    for k in range(D):\n        d = np.zeros(D)\n        d[k] = h\n        g[k] = (f(x+d)-f(x-d))/(2*h)\n    return g\n\ndef kink_indices(v, lo=-40., hi=40., step=.01):\n    ts = np.arange(lo, hi+step*.5, step)\n    yy = np.array([f(t*v) for t in ts])\n    ss = np.diff(yy)/step\n    # The forward function is evaluated in float64, so this threshold is\n    # safely above query roundoff but below even small ReLU slope jumps.\n    dd = np.diff(ss)\n    scale = max(1., float(np.max(np.abs(ss))))\n    mark = np.where(np.abs(dd) > max(2e-9, 2e-8*scale))[0]\n    if not len(mark):\n        return []\n    groups=[]\n    for q in mark:\n        if not groups or q > groups[-1][-1]+2:\n            groups.append([int(q)])\n        else:\n            groups[-1].append(int(q))\n    ans=[]\n    for gr in groups:\n        j=gr[len(gr)//2]\n        # A single kink between t_j and t_{j+1} makes s[j] mixed.\n        # Use stable cells s[j-1] and s[j+1] and probe well outside.\n        if j < 2 or j+2 >= len(ss):\n            continue\n        left_s = .5*(ss[j-2]+ss[j-1])\n        right_s = .5*(ss[j+1]+ss[j+2])\n        if abs(right_s-left_s) < 1e-10:\n            continue\n        # If several cells were marked, retain only transitions whose\n        # surrounding slopes really differ.\n        ans.append((j, ts[j]-.25*step, ts[j+1]+.25*step))\n    return ans\n\ndef add(found, z):\n    n=np.linalg.norm(z)\n    if not np.isfinite(n) or n < 1e-7:\n        return\n    z=z/n\n    for i,u in enumerate(found):\n        c=float(np.dot(u,z))\n        if abs(c)>.985:\n            if c<0: z=-z\n            w=u+z\n            found[i]=w/np.linalg.norm(w)\n            return\n    found.append(z)\n\ndef main():\n    rng=np.random.default_rng(731927)\n    found=[]\n    for trial in range(40):\n        v=rng.normal(size=D)\n        v/=np.linalg.norm(v)\n        for j,tl,tr in kink_indices(v):\n            # Probe at points in the neighboring linear regions.  The\n            # separation is larger than finite-difference h and smaller than\n            # the grid spacing, so unrelated knots are unlikely to intrude.\n            gl=grad(tl*v)\n            gr=grad(tr*v)\n            add(found, gr-gl)\n        if trial % 5 == 4:\n            print('scan', trial+1, 'directions', len(found))\n        if len(found)>=N:\n            break\n    if len(found)<N:\n        raise RuntimeError('recovered only %d of %d directions' % (len(found),N))\n    out=np.asarray(found[:N], dtype=float)\n    np.save('/app/stolen_A1.npy', out)\n    print('recovered matrix shape:', out.shape)\n    print(out)\n\nif __name__=='__main__':\n    main()\nPY\npython3 /app/steal.py\nls -l /app/stolen_A1.npy\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
