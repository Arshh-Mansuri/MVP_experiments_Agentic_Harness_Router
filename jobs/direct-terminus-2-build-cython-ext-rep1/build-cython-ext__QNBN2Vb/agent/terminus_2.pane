 159:     def as_networkx(self):
 160:         '''Get a networkx graph representing the planar diagram, where
 161:         each node is a crossing and each edge is an arc. This is a
 162:         non-directed non-multi graph; where two arcs join the same crossing,
 163:         they are represented as a single edge, but information about
 164:         duplicates is returned alongside the graph.
 165: 
 166:         Returns
 167:         -------
 168:         g : Graph
 169:             The networkx graph
 170:         duplicates : list
 171:             A list of tuples representing nodes joined by multiple edges.
 172:         heights : dict
 173:             A dictionary of (start, end, arc_number) graph edges,
 174:             containing the start and end height of each edge.
 175:         first_edge : tuple
 176:             The first edge in the graph, including (start, end, arc_number).
 177:         '''
 178:         # print('pd is', self)
 179:         import networkx as nx
 180:         edges = []
 181:         cache = {}
 182:         heights = {}
 183:         edge_directions = []
 184:         for node_index, crossing in enumerate(self):
 185:             for crossing_index, arc_number in enumerate(crossing):
 186:                 if arc_number in cache:
 187:                     other_node_index, other_height = cache[arc_number]
 188:                     edges.append([other_node_index, node_index])
 189: 
 190:                     height = index_height(crossing_index)
 191: 
 192:                     if crossing.is_outgoing(arc_number):
 193:                         # print('node {} {}, crossing {} is outgoing to {}'.format(
 194:                         #     node_index, crossing, arc_number, other_node_index))
 195:                         heights[node_index, other_node_index, arc_number] = (height, other_height)
 196:                         edge_directions.append((node_index, other_node_index, arc_number))
 197:                     else:
 198:                         # print('node {} {}, crossing {} is incoming from {}'.format(
 199:                             # node_index, crossing, arc_number, other_node_index))
 200:                         heights[other_node_index, node_index, arc_number] = (other_height, height)
 201:                         edge_directions.append((other_node_index, node_index, arc_number))
 202:                     
 203:                 else:
 204:                     cache[arc_number] = node_index, index_height(crossing_index)
 205: 
 206:         g = nx.Graph()
 207:         g.add_nodes_from(range(len(self)))
 208:         g.add_edges_from(edges)
 209: 
 210:         # print('possible heights:')
 211:         # for key, value in sorted(heights.items()):
 212:         #     print(key, value)
 213: 
 214: 
 215:         seen = set()
 216:         duplicates = list()
 217:         for edge in edges:
 218:             edge = tuple(edge)
 219:             if edge in seen:
 220:                 duplicates.append(sorted(edge))
 221:             seen.add(edge)
 222: 
 223:         return g, duplicates, heights, sorted(edge_directions)[0]
