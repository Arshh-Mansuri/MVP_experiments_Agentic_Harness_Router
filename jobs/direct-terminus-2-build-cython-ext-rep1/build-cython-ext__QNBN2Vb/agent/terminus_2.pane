        import planarity

        # Keep the original NetworkX graph: planarity.networkx_graph()
        # discards pyknotid's node metadata such as 'start' and 'end'.
        # The original graph is already planar and can be laid out directly.
        pg = planarity.PGraph(g)
        pg.embed_drawplanar()

        # planarity >= 1.0.0 does not attach the legacy node/edge drawing
        # attributes used below. Reconstruct them from a planar NetworkX
        # layout while retaining the original graph topology and node IDs.
        import networkx as nx
        positions = nx.planar_layout(g) if g.number_of_nodes() else {}
        ordered_nodes = sorted(g.nodes(), key=lambda node: (float(positions[node][1]), node))
        node_y = {node: float(index) for index, node in enumerate(ordered_nodes)}
        node_x = {node: float(positions[node][0]) for node in g.nodes()}

        for node in g.nodes():
            x = node_x[node]
            g.nodes[node]['pos'] = node_y[node]
            g.nodes[node]['start'] = x - 0.5
            g.nodes[node]['end'] = x + 0.5

        for n1, n2, data in g.edges(data=True):
            data['pos'] = 0.5 * (node_x[n1] + node_x[n2])
            data['start'] = node_y[n1]
            data['end'] = node_y[n2]

        node_labels = {}
        xs = []
        ys = []

        nodes_by_height = {}
