    def _construct_planar_graph(self):
        pd = self.planar_diagram()
        g, duplicates, heights, first_edge = pd.as_networkx_extended()

        import planarity

        # planarity.networkx_graph() may discard NetworkX node attributes.
        # Preserve the metadata required by the original pyknotid layout code.
        original_node_data = {node: dict(data) for node, data in g.nodes(data=True)}

        pg = planarity.PGraph(g)
        pg.embed_drawplanar()
        g = planarity.networkx_graph(pg)

        for node, data in original_node_data.items():
            if node in g:
                g.nodes[node].update(data)

        # planarity >= 1.0.0 no longer attaches draw positions to
        # converted NetworkX nodes. Older pyknotid code expects data['pos'].
        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):
            import networkx as nx
            positions = nx.planar_layout(g)
            for node, position in positions.items():
                g.nodes[node]['pos'] = position

        node_labels = {}
        xs = []
        ys = []

        nodes_by_height = {}
        node_xs_by_y = {}
        node_xs_ys = {}
        node_lefts_rights = {}

        for node, data in g.nodes(data=True):
            y = data['pos']
            xb = data['start']
            xe = data['end']
            x = int((xe + xb) / 2.)

            node_labels[node] = (x, y)
            xs.extend([xb, xe])
            ys.append(y)

            nodes_by_height[data['pos']] = node
            node_xs_by_y[data['pos']] = x
            node_xs_ys[node] = (x, y)
            node_lefts_rights[node] = (xb, xe)

