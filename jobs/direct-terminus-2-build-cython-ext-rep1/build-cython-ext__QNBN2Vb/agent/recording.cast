[443.740063, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\np = Path('pyknotid/representations/representation.py')\ns = p.read_text()\nneedle = \"        g = planarity.networkx_graph(pg)\\n\\n\\n        node_labels = {}\"\nreplacement = \"        g = planarity.networkx_graph(pg)\\n\\n        # planarity >= 1.0.0 no longer attaches draw positions to\\n        # converted NetworkX nodes. Older pyknotid code expects data['pos'].\\n        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):\\n            import networkx as nx\\n            positions = nx.planar_layout(g)\\n            for node, position in positions.items():\\n                g.nodes[node]['pos'] = position\\n\\n        node_labels = {}\"\nif needle not in s:\n    raise SystemExit('patch location not found')\np.write_text(s.replace(needle, replacement, 1))\nprint('patched representation.py')\nPY\nsed -n '325,355p' pyknotid/representations/representation.py\n"]
