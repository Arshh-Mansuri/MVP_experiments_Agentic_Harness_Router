[681.822466, "o", "\r\n        import planarity\r\n\r\n        # Keep the original NetworkX graph: planarity.networkx_graph()\r\n        # discards pyknotid's node metadata such as 'start' and 'end'.\r\n        # The original graph is already planar and can be laid out directly.\r\n        pg = planarity.PGraph(g)\r\n        pg.embed_drawplanar()\r\n\r\n        # planarity >= 1.0.0 does not attach the legacy node/edge drawing\r\n        # attributes used below. Reconstruct them from a planar NetworkX\r\n        # layout while retaining the original graph topology and node IDs.\r\n        import networkx as nx\r\n        positions = nx.planar_layout(g) if g.number_of_nodes() else {}\r\n        ordered_nodes = sorted(g.nodes(), key=lambda node: (float(positions[node][1]), node))\r\n        node_y = {node: float(index) for index, node in enumerate(ordered_nodes)}\r\n        node_x = {node: float(positions[node][0]) for node in g.nodes()}\r\n\r\n        for node in g.nodes():\r\n            x = node_x[node]\r\n            g.nodes[node]['pos'] = node_y[node]\r\n            "]
[681.822524, "o", "g.nodes[node]['start'] = x - 0.5\r\n            g.nodes[node]['end'] = x + 0.5\r\n\r\n        for n1, n2, data in g.edges(data=True):\r\n            data['pos'] = 0.5 * (node_x[n1] + node_x[n2])\r\n            data['start'] = node_y[n1]\r\n            data['end'] = node_y[n2]\r\n\r\n        node_labels = {}\r\n        xs = []\r\n        ys = []\r\n\r\n        nodes_by_height = {}\r\n        node_xs_by_y = {}\r\n        node_xs_ys = {}\r\n        node_lefts_rights = {}\r\n\r\n        for node, data in g.nodes(data=True):\r\n            y = data['pos']\r\n            xb = data['start']\r\n            xe = data['end']\r\n            x = int((xe + xb) / 2.)\r\n\r\n            node_labels[node] = (x, y)\r\n            xs.extend([xb, xe])\r\n"]
