[443.946638, "o", "        g = planarity.networkx_graph(pg)\r\n\r\n        # planarity >= 1.0.0 no longer attaches draw positions to\r\n        # converted NetworkX nodes. Older pyknotid code expects data['pos'].\r\n        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):\r\n            import networkx as nx\r\n            positions = nx.planar_layout(g)\r\n            for node, position in positions.items():\r\n                g.nodes[node]['pos'] = position\r\n\r\n        node_labels = {}\r\n        xs = []\r\n        ys = []\r\n\r\n        nodes_by_height = {}\r\n        node_xs_by_y = {}\r\n        node_xs_ys = {}\r\n        node_lefts_rights = {}\r\n\r\n        for node, data in g.nodes(data=True):\r\n            y = data['pos']\r\n            xb = data['start']\r\n            xe = data['end']\r\n            x = int((xe + xb) / 2.)\r\n\r\n            node_labels[node] = (x, y)\r\n            xs.extend([xb, xe])\r\n            ys.append(y)\r\n\r\n            nodes_by_height[data['pos']] = node\r\n            node_xs_by_y[data['pos']] = x\r\n"]
