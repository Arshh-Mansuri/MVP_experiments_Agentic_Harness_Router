[264.136639, "i", "cd /app/pyknotid && python3 - <<'PY'\nimport numpy\nimport pyknotid\nfrom pyknotid.spacecurves import chelpers, ccomplexity\nfrom pyknotid import cinvariants\nimport pyknotid.make as mk\nimport pyknotid.spacecurves as sp\nprint('numpy:', numpy.__version__)\nprint('pyknotid:', pyknotid.__file__)\nprint('chelpers:', chelpers.__file__)\nprint('ccomplexity:', ccomplexity.__file__)\nprint('cinvariants:', cinvariants.__file__)\nk = sp.Knot(mk.three_twist(num_points=100))\nout = k.alexander_polynomial(-1)\nprint('alexander:', out)\nPY\n"]
[264.143244, "o", "cd /app/pyknotid && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy\r\n\u001b[?2004l\r\u001b[?2004h> import pyknotid\r\n\u001b[?2004l\r\u001b[?2004h> from pyknotid.spacecurves import chelpers, ccomplexity\r\n\u001b[?2004l\r\u001b[?2004h> from pyknotid import cinvariants\r\n\u001b[?2004l\r\u001b[?2004h> import pyknotid.make as mk\r\n\u001b[?2004l\r\u001b[?2004h> import pyknotid.spacecurves as sp\r\n\u001b[?2004l\r\u001b[?2004h> print('numpy:', numpy.__version__)\r\n\u001b[?2004l\r\u001b[?2004h> print('pyknotid:', pyknotid.__file__)\r\n\u001b[?2004l\r\u001b[?2004h> print('chelpers:', chelpers.__file__)\r\n\u001b[?2004l\r\u001b[?2004h> print('ccomplexity:', ccomplexity.__file__)\r\n\u001b[?2004l\r\u001b[?2004h> print('cinvariants:', cinvariants.__file__)\r\n\u001b[?2004l\r\u001b[?2004h> k = sp.Knot(mk.three_twist(num_points=100))\r\n\u001b[?2004l\r\u001b[?2004h> out = k.alexander_polynomial(-1)\r\n\u001b[?2004l\r\u001b[?2004h> print('alexander:', out)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
