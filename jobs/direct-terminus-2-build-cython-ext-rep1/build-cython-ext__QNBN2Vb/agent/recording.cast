[291.861157, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfiles = list(Path('pyknotid').rglob('*.py')) + list(Path('pyknotid').rglob('*.pyx')) + list(Path('pyknotid').rglob('*.pxd'))\nreplacements = {\n    'np.float': 'float',\n    'numpy.float': 'float',\n    'np.int': 'int',\n    'numpy.int': 'int',\n    'np.bool': 'bool',\n    'numpy.bool': 'bool',\n    'np.complex': 'complex',\n    'numpy.complex': 'complex',\n    'np.object': 'object',\n    'numpy.object': 'object',\n    'np.str': 'str',\n    'numpy.str': 'str',\n    'np.unicode': 'str',\n    'numpy.unicode': 'str',\n    'np.long': 'int',\n    'numpy.long': 'int',\n}\nfor path in files:\n    old = path.read_text()\n    new = old\n    for source, target in replacements.items():\n        new = re.sub(r'(?<![A-Za-z0-9_])' + re.escape(source) + r'(?![A-Za-z0-9_])', target, new)\n    if new != old:\n        path.write_text(new)\n        print('patched', path)\nPY\n\ngrep -RInE --include='*.py' --include='*.pyx' --include='*.pxd' 'np\\.(float|int|bool|complex|object|str|unico"]
[291.861428, "i", "de|long)|numpy\\.(float|int|bool|complex|object|str|unicode|long)' pyknotid || true\n"]
