[492.474313, "o", "        pd = self.planar_diagram()\r\n        g, duplicates, heights, first_edge = pd.as_networkx_extended()\r\n\r\n        import planarity\r\n\r\n        # planarity.networkx_graph() may discard NetworkX node attributes.\r\n        # Preserve the metadata required by the original pyknotid layout code.\r\n        original_node_data = {node: dict(data) for node, data in g.nodes(data=True)}\r\n\r\n        pg = planarity.PGraph(g)\r\n        pg.embed_drawplanar()\r\n        g = planarity.networkx_graph(pg)\r\n\r\n        for node, data in original_node_data.items():\r\n            if node in g:\r\n                g.nodes[node].update(data)\r\n\r\n        # planarity >= 1.0.0 no longer attaches draw positions to\r\n        # converted NetworkX nodes. Older pyknotid code expects data['pos'].\r\n        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):\r\n            import networkx as nx\r\n            positions = nx.planar_layout(g)\r\n            for node, position in positions.items():\r\n                g.nodes[node]['p"]
[492.475209, "o", "os'] = position\r\n\r\n        node_labels = {}\r\n        xs = []\r\n        ys = []\r\n\r\n        nodes_by_height = {}\r\n        node_xs_by_y = {}\r\n        node_xs_ys = {}\r\n        node_lefts_rights = {}\r\n\r\n        for node, data in g.nodes(data=True):\r\n            y = data['pos']\r\n            xb = data['start']\r\n            xe = data['end']\r\n            x = int((xe + xb) / 2.)\r\n\r\n            node_labels[node] = (x, y)\r\n            xs.extend([xb, xe])\r\n            ys.append(y)\r\n\r\n            nodes_by_height[data['pos']] = node\r\n            node_xs_by_y[data['pos']] = x\r\n            node_xs_ys[node] = (x, y)\r\n            node_lefts_rights[node] = (xb, xe)\r\n"]
