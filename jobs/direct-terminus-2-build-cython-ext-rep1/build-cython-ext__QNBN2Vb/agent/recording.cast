[492.188042, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\np = Path('pyknotid/representations/representation.py')\ns = p.read_text()\nold = \"        pg = planarity.PGraph(g)\\n        pg.embed_drawplanar()\\n        g = planarity.networkx_graph(pg)\\n\\n        # planarity >= 1.0.0 no longer attaches draw positions to\\n        # converted NetworkX nodes. Older pyknotid code expects data['pos'].\\n        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):\\n\"\nnew = \"        # planarity.networkx_graph() may discard NetworkX node attributes.\\n        # Preserve the metadata required by the original pyknotid layout code.\\n        original_node_data = {node: dict(data) for node, data in g.nodes(data=True)}\\n\\n        pg = planarity.PGraph(g)\\n        pg.embed_drawplanar()\\n        g = planarity.networkx_graph(pg)\\n\\n        for node, data in original_node_data.items():\\n            if node in g:\\n                g.nodes[node].update(data)\\n\\n        # planarity >= 1.0.0 no longer attac"]
[492.188589, "i", "hes draw positions to\\n        # converted NetworkX nodes. Older pyknotid code expects data['pos'].\\n        if g.number_of_nodes() and not all('pos' in data for _, data in g.nodes(data=True)):\\n\"\nif old not in s:\n    raise SystemExit('expected patch block not found')\np.write_text(s.replace(old, new, 1))\nprint('patched node attribute preservation')\nPY\nsed -n '318,365p' pyknotid/representations/representation.py\n"]
