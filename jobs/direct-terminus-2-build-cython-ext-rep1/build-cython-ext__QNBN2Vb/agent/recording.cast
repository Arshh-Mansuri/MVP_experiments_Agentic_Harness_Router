[357.755561, "i", "cd /app/pyknotid && python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfiles = list(Path('pyknotid').rglob('*.py')) + list(Path('pyknotid').rglob('*.pyx')) + list(Path('pyknotid').rglob('*.pxd'))\nrepls = {\n    'float': 'float', 'int': 'int', 'bool': 'bool',\n    'complex': 'complex', 'object': 'object', 'str': 'str',\n    'unicode': 'str', 'long': 'int'\n}\nfor p in files:\n    old = p.read_text()\n    new = old\n    for alias in ('np', 'n', 'numpy'):\n        for name, replacement in repls.items():\n            new = re.sub(r'(?<![A-Za-z0-9_])' + alias + r'\\.' + name + r'(?![A-Za-z0-9_])', replacement, new)\n    if new != old:\n        p.write_text(new)\n        print('patched', p)\nPY\n\ngrep -RIn --exclude-dir=.git --exclude-dir=build --exclude='*.so' --exclude='*.c' -E '(^|[^A-Za-z0-9_])(np|numpy|n)\\.(float|int|bool|complex|object|str|unicode|long)([^A-Za-z0-9_]|$)' pyknotid || true\n"]
