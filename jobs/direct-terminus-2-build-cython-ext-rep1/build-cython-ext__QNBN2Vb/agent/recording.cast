[541.239873, "i", "cd /app/pyknotid && python3 - <<'PY'\nimport planarity\nfrom pyknotid.representations.representation import Representation\n# Use a valid compact Gauss code form accepted by this version.\nfor text in ('1+a,2-a,3+a,1-a,2+a,3-a', '1+a 2-a 3+a 1-a 2+a 3-a'):\n    try:\n        r = Representation(text)\n        print('accepted', repr(text), type(r))\n        break\n    except Exception as e:\n        print('rejected', repr(text), repr(e))\nelse:\n    raise SystemExit\ntry:\n    pd = r.planar_diagram()\n    g, duplicates, heights, first_edge = pd.as_networkx_extended()\n    print('original nodes:', list(g.nodes(data=True))[:12])\n    original = {x: dict(d) for x, d in g.nodes(data=True)}\n    pg = planarity.PGraph(g)\n    print('mapping:', getattr(pg, 'mapping', None))\n    pg.embed_drawplanar()\n    gg = planarity.networkx_graph(pg)\n    print('converted nodes:', list(gg.nodes(data=True))[:12])\nexcept Exception as e:\n    import traceback; traceback.print_exc()\nPY\n"]
