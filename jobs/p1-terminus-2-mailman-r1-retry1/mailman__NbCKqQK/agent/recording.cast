[74.638544, "o", "Usage: mailman [OPTIONS] COMMAND [ARGS]...\r\nTry 'mailman -h' for help.\r\n\r\nError: If you are sure you want to run as root, specify --run-as-root.\r\n"]
[74.654421, "i", "set -e\nif ! runuser -u list -- mailman -C /etc/mailman3/mailman.cfg lists 2>/dev/null | grep -q 'reading-group@local.edu'; then\n  runuser -u list -- mailman -C /etc/mailman3/mailman.cfg create --notify=no reading-group@local.edu\nfi\nrunuser -u list -- python3 - <<'PY'\nfrom mailman.core.initialize import initialize\nfrom mailman.interfaces.listmanager import IListManager\nfrom mailman.interfaces.mailinglist import SubscriptionPolicy, UnsubscriptionPolicy, PostingPolicy\nfrom zope.component import getUtility\nfrom mailman.database.transaction import transaction\ninitialize('/etc/mailman3/mailman.cfg')\nmlist = getUtility(IListManager).get('reading-group@local.edu')\nmlist.subscription_policy = SubscriptionPolicy.open\nmlist.unsubscription_policy = UnsubscriptionPolicy.open\nmlist.posting_policy = PostingPolicy.open\ntransaction.commit()\nprint(mlist.list_id, mlist.subscription_policy, mlist.unsubscription_policy, mlist.posting_policy)\nPY\nrunuser -u list -- mailman -C /etc/mailman3/mailman.cfg aliases\nfind /var/lib/mailman3 -maxdepth 3 -type f -printf '%p\\n' | sort | head -80\n"]
[74.654758, "o", "set -e\r\nif ! runuser -u list -- mailman -C /etc/mailman3/mailman.cfg lists 2>/dev/null | grep -q 'reading-group@local.edu'; then\r\n  runuser -u list -- mailman -C /etc/mailman3/mailman.cfg create --notify=no reading-group@local.edu\r\nfi\r\nrunuser -u list -- python3 - <<'PY'\r\nfrom mailman.core.initialize import initialize\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom mailman.interfaces.mailinglist import SubscriptionPolicy, UnsubscriptionPolicy, PostingPolicy\r\nfrom zope.component import getUtility\r\nfrom mailman.database.transaction import transaction\r\ninitialize('/etc/mailman3/mailman.cfg')\r\nmlist = getUtility(IListManager).get('reading-group@local.edu')\r\nmlist.subscription_policy = SubscriptionPolicy.open\r\n"]
[74.65511, "o", "mlist.unsubscription_policy = UnsubscriptionPolicy.open\r\nmlist.posting_policy = PostingPolicy.open\r\ntransaction.commit()\r\nprint(mlist.list_id, mlist.subscription_policy, mlist.unsubscription_policy, mlist.posting_policy)\r\nPY\r\nrunuser -u list -- mailman -C /etc/mailman3/mailman.cfg aliases\r\nfind /var/lib/mailman3 -maxdepth 3 -type f -printf '%p\\n' | sort | head -80\r\n"]
