[73.735946, "i", "set -e\nmkdir -p /var/lib/mailman3/{data,lists,queue,cache,messages,archives,templates,locks} /var/log/mailman3 /run/mailman3 /var/mail\nchown -R list:list /var/lib/mailman3 /var/log/mailman3 /run/mailman3 /etc/mailman3\nchmod 750 /etc/mailman3\nprintf 'create help:\\n'\nmailman -C /etc/mailman3/mailman.cfg create --help 2>&1 | head -80\nprintf 'cfg:\\n'\nmailman -C /etc/mailman3/mailman.cfg conf paths 2>&1 | head -80\n"]
