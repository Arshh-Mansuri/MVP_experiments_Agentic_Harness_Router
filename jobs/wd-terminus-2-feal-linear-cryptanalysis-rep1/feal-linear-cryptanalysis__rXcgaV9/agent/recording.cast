[32.860256, "i", "cat > /app/solve_attack.py <<'PY'\nfrom z3 import *\nfrom pathlib import Path\n\nMASK = 0xffffffff\n\ndef bv(x):\n    return BitVecVal(x & MASK, 32)\n\ndef expand(k):\n    k = ZeroExt(12, k) if k.size() == 20 else k\n    return (k ^ (k << 16) ^ (k * bv(12345))) & bv(MASK)\n\ndef rot2(x):\n    return ((x << 2) | LShR(x, 6)) & 255\n\ndef g(a,b,c):\n    return rot2((a+b+c) & 255)\n\ndef f(v):\n    x0 = v & 255\n    x1 = LShR(v,8) & 255\n    x2 = LShR(v,16) & 255\n    x3 = LShR(v,24) & 255\n    y2 = g(x3 ^ x2, x1 ^ x0, 1)\n    y3 = g(x3, y2, 0)\n    y1 = g(x1 ^ x0, y2, 0)\n    y0 = g(x0, y1, 1)\n    return (y0 | (y1<<8) | (y2<<16) | (y3<<24)) & bv(MASK)\n\ndef enc(p, ks):\n    l = LShR(p,32) & bv(MASK)\n    r = p & bv(MASK)\n    r = r ^ l\n    for k in ks:\n        m = f(r ^ k)\n        t = r\n        r = l ^ m\n        l = t\n    l = l ^ r\n    return ((r << 32) | l) & bv(0xffffffffffffffff)\n\npairs=[]\nfor line in Path('/app/pairs.txt').read_text().splitlines():\n    a,b=line.split()\n    pairs.append((int(a),int(b)))\n\nseeds=[BitVec(f'k{i}',20) for i in "]
[32.863387, "i", "range(4)]\nks=[expand(x) for x in seeds]\ns=Solver()\n# A few pairs make the candidate unique while keeping solving manageable.\nfor p,c in pairs[:6]:\n    s.add(enc(BitVecVal(p,64),ks) == BitVecVal(c,64))\nprint('solving', flush=True)\nif s.check() != sat:\n    raise SystemExit('no solution')\nm=s.model()\nvals=[m[x].as_long() for x in seeds]\nprint('seeds:', ' '.join(f'{x:05x}' for x in vals), flush=True)\n# Validate all known pairs using concrete arithmetic below.\n\ndef ex(k): return (k ^ (k<<16) ^ (k*12345)) & MASK\n\ndef gf(a,b,c):\n    t=(a+b+c)&255\n    return ((t<<2)|(t>>6))&255\n\ndef ff(v):\n    x=[(v>>(8*i))&255 for i in range(4)]\n    y=[0]*4\n    y[2]=gf(x[3]^x[2],x[1]^x[0],1)\n    y[3]=gf(x[3],y[2],0)\n    y[1]=gf(x[1]^x[0],y[2],0)\n    y[0]=gf(x[0],y[1],1)\n    return sum(y[i]<<(8*i) for i in range(4))\n\ndef ee(p):\n    l=(p>>32)&MASK; r=p&MASK; r^=l\n    for k in map(ex,vals):\n        t=r; r=(l^ff(r^k))&MASK; l=t\n    return ((r<<32)|(l^r)) & ((1<<64)-1)\n\nok=sum(ee(p)==c for p,c in pairs)\nprint('known-pair verification:',o"]
[32.863898, "o", "cat > /app/solve_attack.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from z3 import *\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.864776, "i", "k,'/',len(pairs), flush=True)\nif ok != len(pairs): raise SystemExit('candidate failed validation')\n\ndef dec(c):\n    l=c&MASK; r=(c>>32)&MASK\n    l ^= r\n    for k in reversed(list(map(ex,vals))):\n        temp=l\n        l=r\n        r=temp\n        l ^= ff(temp^k)\n        l &= MASK\n        r &= MASK\n    r ^= l\n    return ((l<<32)|r) & ((1<<64)-1)\n\ncts=[int(x) for x in Path('/app/ciphertexts.txt').read_text().split()]\npts=[dec(c) for c in cts]\nPath('/app/plaintexts.txt').write_text(''.join(str(x)+'\\n' for x in pts))\nprint('decrypted:',len(pts),'ciphertexts', flush=True)\nprint('output:',Path('/app/plaintexts.txt').stat().st_size,'bytes', flush=True)\nPY\npython3 /app/solve_attack.py\n"]
