[4.663651, "o", "]);\r\n        return 1;\r\n    }\r\n    \r\n    // Read and decrypt each ciphertext\r\n    char line[256];\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        uint64_t ciphertext;\r\n        if (sscanf(line, \"%lu\", &ciphertext) == 1) {\r\n            uint64_t plaintext = decrypt(ciphertext);\r\n            printf(\"%lu\\n\", plaintext);\r\n        }\r\n    }\r\n    \r\n    fclose(fp);\r\n    return 0;\r\n"]
