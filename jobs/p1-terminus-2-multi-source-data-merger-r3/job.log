status(rec['status'])\n        for f in ('name', 'email'):\n            if rec[f] is not None:\n                rec[f] = str(rec[f])\n        rows.append(rec)\n    return rows\n\nby_id = {}\nfor source, path in sources:\n    for rec in load(path):\n        by_id.setdefault(rec['user_id'], {})[source] = rec\n\npriority = ['source_a', 'source_b', 'source_c']\nmerged, conflicts = [], []\nfor uid in sorted(by_id):\n    records = by_id[uid]\n    result = {'user_id': uid}\n    for field in fields[1:]:\n        vals = {s: records[s].get(field) for s in priority if s in records and records[s].get(field) is not None}\n        distinct = list(dict.fromkeys(vals.values()))\n        if len(distinct) > 1:\n            selected = next(vals[s] for s in priority if s in vals)\n            conflicts.append({'user_id': uid, 'field': field, 'values': vals, 'selected': selected})\n        result[field] = next((records[s].get(field) for s in priority if s in records and records[s].get(field) is not None), None)\n    merged.append(result)\n\nout = pd.DataFrame(merged, columns=fields)\nout['user_id'] = out['user_id'].astype('int64')\nfor f in fields[1:]:\n    out[f] = out[f].astype('string')\nout.to_parquet('/app/merged_users.parquet', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\nprint('merged rows:', len(out))\nprint('conflicts:', len(conflicts))\nprint(out.to_string(index=False))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
