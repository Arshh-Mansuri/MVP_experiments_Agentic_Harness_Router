cat > /tmp/merge_users.py <<'PY'
import json
from pathlib import Path
from datetime import datetime
import pandas as pd

sources = [
    ('source_a', '/data/source_a/users.json'),
    ('source_b', '/data/source_b/users.csv'),
    ('source_c', '/data/source_c/users.parquet'),
]

field_aliases = {
    'user_id': ['user_id', 'id', 'userId'],
    'email': ['email', 'email_address'],
    'name': ['full_name', 'name', 'userName'],
    'created_date': ['registration_date', 'created_at', 'joined'],
    'status': ['status'],
}
fields = ['user_id', 'name', 'email', 'created_date', 'status']

def load_source(label, path):
    if path.endswith('.json'):
        with open(path, encoding='utf-8') as f:
            obj = json.load(f)
        if isinstance(obj, dict):
            for key in ('users', 'data', 'records'):
                if key in obj and isinstance(obj[key], list):
                    obj = obj[key]
                    break
        df = pd.DataFrame(obj)
    elif path.endswith('.csv'):
        df = pd.read_csv(path, dtype=object, keep_default_na=False)
    else:
        df = pd.read_parquet(path)
    out = []
    for _, row in df.iterrows():
        rec = {}
        for unified, aliases in field_aliases.items():
            value = None
            for alias in aliases:
                if alias in df.columns:
                    v = row[alias]
                    if pd.notna(v) and str(v).strip() != '':
                        value = v
                        break
            rec[unified] = value
        if rec['user_id'] is None:
            continue
        rec['user_id'] = int(float(rec['user_id']))
        if rec['created_date'] is not None:
            v = rec['created_date']
            if isinstance(v, pd.Timestamp):
                rec['created_date'] = v.strftime('%Y-%m-%d')
            else:
                text = str(v).strip()
                parsed = pd.to_datetime(text, errors='coerce')
                rec['created_date'] = parsed.strftime('%Y-%m-%d') if not pd.isna(parsed) else text[:10]
        for f in fields[1:]:
            if rec[f] is not None:
                rec[f] = str(rec[f])
        out.append(rec)
    return out

by_source = {label: load_source(label, path) for label, path in sources}
by_id = {}
for label, records in by_source.items():
    for rec in records:
        by_id.setdefault(rec['user_id'], {})[label] = rec

conflicts = []
merged = []
priority = ['source_a', 'source_b', 'source_c']
for uid in sorted(by_id):
    present = by_id[uid]
    selected = {'user_id': uid}
    for field in fields[1:]:
        values = {src: present[src].get(field) for src in priority if src in present and present[src].get(field) is not None}
        distinct = []
        for value in values.values():
            if value not in distinct:
                distinct.append(value)
        if len(distinct) > 1:
            conflict_values = {src: present[src].get(field) for src in priority if src in present}
            chosen = next((conflict_values[src] for src in priority if src in conflict_values and conflict_values[src] is not None), None)
            conflicts.append({'user_id': uid, 'field': field, 'values': conflict_values, 'selected': chosen})
        selected[field] = next((present[src].get(field) for src in priority if src in present and present[src].get(field) is not None), None)
    merged.append(selected)

out = pd.DataFrame(merged, columns=fields)
out['user_id'] = out['user_id'].astype('int64')
for f in ['name', 'email', 'created_date', 'status']:
    out[f] = out[f].astype('string')
out.to_parquet('/app/merged_users.parquet', index=False)
with open('/app/conflicts.json', 'w', encoding='utf-8') as f:
    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)
print('merged rows:', len(out))
print('conflicts:', len(conflicts))
print(out.to_string(index=False))
