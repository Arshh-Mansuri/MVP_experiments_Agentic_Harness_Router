[39.006067, "i", "python3 - <<'PY'\nimport json\nimport pandas as pd\n\nsources = [\n    ('source_a', '/data/source_a/users.json'),\n    ('source_b', '/data/source_b/users.csv'),\n    ('source_c', '/data/source_c/users.parquet'),\n]\naliases = {\n    'user_id': ['user_id', 'id', 'userId'],\n    'name': ['full_name', 'name', 'userName'],\n    'email': ['email', 'email_address'],\n    'created_date': ['registration_date', 'created_at', 'joined'],\n    'status': ['status', 'is_active', 'active'],\n}\nfields = ['user_id', 'name', 'email', 'created_date', 'status']\n\ndef clean_status(v):\n    if v is None or pd.isna(v) or str(v).strip() == '':\n        return None\n    s = str(v).strip().lower()\n    if s in ('true', '1', 'yes', 'active'):\n        return 'active'\n    if s in ('false', '0', 'no', 'inactive'):\n        return 'inactive'\n    return str(v)\n\ndef load(path):\n    if path.endswith('.json'):\n        with open(path, encoding='utf-8') as f:\n            obj = json.load(f)\n        if isinstance(obj, dict):\n            obj = obj.get('users', obj.get('data', obj.get('records', obj)))\n        df = pd.DataFrame(obj)\n    elif path.endswith('.csv'):\n        df = pd.read_csv(path, dtype=object, keep_default_na=False)\n    else:\n        df = pd.read_parquet(path)\n    rows = []\n    for _, row in df.iterrows():\n        rec = {}\n        for field, names in aliases.items():\n            rec[field] = None\n            for name in names:\n                if name in df.columns and pd.notna(row[name]) and str(row[name]).strip() != '':\n                    rec[field] = row[name]\n                    break\n        if rec['user_id'] is None:\n            continue\n        rec['user_id'] = int(float(rec['user_id']))\n        if rec['created_date'] is not None:\n            d = pd.to_datetime(rec['created_date'], errors='coerce')\n            rec['created_date'] = d.strftime('%Y-%m-%d') if not pd.isna(d) else str(rec['created_date'])[:10]\n        rec['status'] = clean_status(rec['status'])\n        for f in ('name', 'email'):\n            if rec[f] is not None:\n                rec[f] = str(rec[f])\n        rows.append(rec)\n    return rows\n\nby_id = {}\nfor source, path in sources:\n    for rec in load(path):\n        by_id.setdefault(rec['user_id'], {})[source] = rec\n\npriority = ['source_a', 'source_b', 'source_c']\nmerged, conflicts = [], []\nfor uid in sorted(by_id):\n    records = by_id[uid]\n    result = {'user_id': uid}\n    for field in fields[1:]:\n        vals = {s: records[s].get(field) for s in priority if s in records and records[s].get(field) is not None}\n        distinct = list(dict.fromkeys(vals.values()))\n        if len(distinct) > 1:\n            selected = next(vals[s] for s in priority if s in vals)\n            conflicts.append({'user_id': uid, 'field': field, 'values': vals, 'selected': selected})\n        result[field] = next((records[s].get(field) for s in priority if s in records and records[s].get(field) is not None), None)\n    merged.append(result)\n\nout = pd.DataFrame(merged, columns=fields)\nout['user_id'] = out['user_id'].astype('int64')\nfor f in fields[1:]:\n    out[f] = out[f].astype('string')\nout.to_parquet('/app/merged_users.parquet', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\nprint('merged rows:', len(out))\nprint('conflicts:', len(conflicts))\nprint(out.to_string(index=False))\nPY\n"]
