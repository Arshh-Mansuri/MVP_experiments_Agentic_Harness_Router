[23.277285, "o", "\u001b[?2004h> "]
[23.277587, "o", "priority = ['source_a', 'source_b', 'source_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.279664, "o", "for uid in sorted(by_id):\r\n\u001b[?2004l\r\u001b[?2004h>     present = by_id[uid]\r\n\u001b[?2004l\r\u001b[?2004h>     selected = {'user_id': uid}\r\n\u001b[?2004l\r\u001b[?2004h>     for field in fields[1:]:\r\n\u001b[?2004l\r\u001b[?2004h>         values = {src: present[src].get(field) for src in priority if src in present and present[src].get(field) is not None}\r\n\u001b[?2004l\r\u001b[?2004h>         distinct = []\r\n\u001b[?2004l\r\u001b[?2004h>         for value in values.values():\r\n\u001b[?2004l\r\u001b[?2004h>             if value not in distinct:\r\n\u001b[?2004l\r\u001b[?2004h>                 distinct.append(value)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(distinct) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>             conflict_values = {src: present[src].get(field) for src in priority if src in present}\r\n\u001b[?2004l\r\u001b[?2004h>             chosen = next((conflict_values[src] for src in priority if src in conflict_values and conflict_values[src] is not None), None)\r\n\u001b[?2004l\r\u001b[?2004h>             conflicts.append({'user_id': uid, 'field': field, 'values': conflict_values, 'selected': chosen})\r\n\u001b[?2004l\r\u001b[?2004h>         selected[field] = next((present[src].get(field) for src in priority if src in present and present[src].get(field) is not None), None)\r\n\u001b[?2004l\r\u001b[?2004h>     merged.append(selected)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out = pd.DataFrame(merged, columns=fields)\r\n\u001b[?2004l\r\u001b[?2004h> out['user_id'] = out['user_id'].astype('int64')\r\n\u001b[?2004l\r\u001b[?2004h> for f in ['name', 'email', 'created_date', 'status']:\r\n\u001b[?2004l\r\u001b[?2004h>     out[f] = out[f].astype('string')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.279803, "o", "out.to_parquet('/app/merged_users.parquet', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.280064, "o", "with open('/app/conflicts.json', 'w', encoding='utf-8') as f:"]
[23.28076, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('merged rows:', len(out))\r\n\u001b[?2004l\r\u001b[?2004h> print('conflicts:', len(conflicts))\r\n\u001b[?2004l\r\u001b[?2004h> print(out.to_string(index=False))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
