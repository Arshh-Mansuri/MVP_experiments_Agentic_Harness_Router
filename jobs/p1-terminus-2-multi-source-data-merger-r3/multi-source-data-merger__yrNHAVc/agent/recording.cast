[21.880996, "o", "]\r\n                    if pd.notna(v) and str(v).strip() != '':\r\n                        value = v\r\n                        break\r\n            rec[unified] = value\r\n        if rec['user_id'] is None:\r\n            continue\r\n        rec['user_id'] = int(float(rec['user_id']))\r\n        if rec['created_date'] is not None:\r\n            v = rec['created_date']\r\n            if isinstance(v, pd.Timestamp):\r\n                rec['created_date'] = v.strftime('%Y-%m-%d')\r\n            else:\r\n                text = str(v).strip()\r\n                parsed = pd.to_datetime(text, errors='coerce')\r\n                rec['created_date'] = parsed.strftime('%Y-%m-%d') if not pd.isna(parsed) else text[:10]\r\n        for f in fields[1:]:\r\n            if rec[f] is not None:\r\n                rec[f] = str(rec[f])\r\n        out.append(rec)\r\n    return out\r\n\r\nby_source = {label: load_source(label, path) for label, path in sources}\r\nby_id = {}\r\nfor label, records in by_source.items():\r\n    for rec in records:\r\n        by_id.setdefault(rec['user_id'], {})[label] = rec\r\n\r\nconflicts = []\r\nmerged = []\r\npriority = ['source_a', 'source_b', 'source_c']\r\nfor uid in sorted(by_id):\r\n    present = by_id[uid]\r\n    selected = {'user_id': uid}\r\n    for field in fields[1:]:\r\n        values = {src: present[src].get(field) for src in priority if src in present and present[src].get(field) is not None}\r\n        distinct = []\r\n        for value in values.values():\r\n            if value not in distinct:\r\n                distinct.append(value)\r\n        if len(distinct) > 1:\r\n            conflict_values = {src: present[src].get(field) for src in priority if src in present}\r\n            chosen = next((conflict_values[src] for src in priority if src in conflict_values and conflict_values[src] is not None), None)\r\n            conflicts.append({'user_id': uid, 'field': field, 'values': conflict_values, 'selected': chosen})\r\n        selected[field] = next((present[src].get(field) for src in priority if src in present and present[src].get(field) is not None), None)\r\n    merged.append(selected)\r\n\r\nout = pd.DataFrame(merged, columns=fields)\r\nout['user_id'] = out['user_id'].astype('int64')\r\nfor f in ['name', 'email', 'created_date', 'status']:\r\n    out[f] = out[f].astype('string')\r\nout.to_parquet('/app/merged_users.parquet', index=False)\r\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\r\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\r\nprint('merged rows:', len(out))\r\nprint('conflicts:', len(conflicts))\r\nprint(out.to_string(index=False))\r\nPY\r\npython3 /tmp/merge_users.py\r\n"]
