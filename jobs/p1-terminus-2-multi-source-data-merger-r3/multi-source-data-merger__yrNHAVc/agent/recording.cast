[40.970105, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\nimport pandas as pd\np = pd.read_parquet('/app/merged_users.parquet')\nwith open('/app/conflicts.json', encoding='utf-8') as f:\n    c = json.load(f)\nprint('files:', Path('/app/merged_users.parquet').exists(), Path('/app/conflicts.json').exists())\nprint('columns:', list(p.columns))\nprint('dtypes:', p.dtypes.to_dict())\nprint('rows:', len(p), 'ids:', p['user_id'].tolist())\nprint('conflicts:', c['total_conflicts'], len(c['conflicts']))\nprint('dates_valid:', p['created_date'].dropna().astype(str).str.fullmatch(r'\\d{4}-\\d{2}-\\d{2}').all())\nPY\n"]
