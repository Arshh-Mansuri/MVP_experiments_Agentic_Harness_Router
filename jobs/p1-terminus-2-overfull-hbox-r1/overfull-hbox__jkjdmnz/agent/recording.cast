[32.500503, "i", "python3 - <<'PY'\nimport re\ntext=open('input.tex').read()\nfor n,line in enumerate(text.splitlines(),1):\n    ws=re.findall(r'[A-Za-z]+',line)\n    if any(w.lower() in {'curious','natures','riotous','excursions','responsiveness','creative','guide','pathfinder','original','settler','freedom','extraordinary','temperament'} for w in ws):\n        print(n, line)\nPY\n"]
