[11.955733, "o", "\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfreedom\u001b[m\u001b[K, liberty, independence, autonomy, release, emancipation\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kguide\u001b[m\u001b[K, leader, director, mentor\r\n\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khope, optimism, expectation, faith, \u001b[01;31m\u001b[Kconfidence\u001b[m\u001b[K, aspiration\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Knature\u001b[m\u001b[Ks, characters, \u001b[01;31m\u001b[Ktemperament\u001b[m\u001b[Ks, dispositions, essences, personalities\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Koriginal\u001b[m\u001b[K, initial, authentic, innovative\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpathfinder\u001b[m\u001b[K, pioneer, trailblazer, scout\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kplagiaristic, copied, imitative, derivative, borrowed, un\u001b[01;31m\u001b[Koriginal\u001b[m\u001b[K\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kresponsive\u001b[m\u001b[Kness, sensitivity, awareness, reaction, attentiveness\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kriotous\u001b[m\u001b[K, wild, unruly, chaotic, boisterous, tumultuous\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksettler\u001b[m\u001b[K, colonist, resident, inhabitant, homesteader\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktemperament\u001b[m\u001b[K, disposition, \u001b[01;31m\u001b[Knature\u001b[m\u001b[K, character, personality, mood\r\n"]
