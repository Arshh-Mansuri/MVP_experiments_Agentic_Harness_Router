[25.28146, "i", "python3 - <<'PY'\nterms='curious natures confidences riotous excursions privileged glimpses responsiveness creative temperament extraordinary cooked breakfast muttered lonely guide pathfinder original settler freedom neighborhood'.split()\nfor line in open('synonyms.txt'):\n    vals=[x.strip() for x in line.rstrip().split(',')]\n    low=[x.lower() for x in vals]\n    if any(t in low or any(t in x for x in low) for t in terms):\n        print(line.rstrip())\nPY\n"]
[25.283167, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
