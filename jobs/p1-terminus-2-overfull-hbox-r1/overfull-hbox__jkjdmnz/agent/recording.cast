[55.981025, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('input.tex')\ns=p.read_text()\nrepls={\n    'advice':'tips',\n    'advantages':'perks',\n    'mind':'brain',\n    'quality':'trait',\n    'attention':'focus',\n    'forever':'always',\n    'promises':'vows',\n    'machines':'devices',\n    'successful':'winning',\n    'interest':'concern',\n    'practical':'useful',\n    'reference':'mention',\n    'painting':'image',\n    'business':'firm',\n    'college':'school',\n    'family':'clan',\n    'middle':'core',\n    'centre':'core',\n    'single':'one',\n    'quick':'fast',\n    'obvious':'clear',\n    'reserved':'quiet',\n    'vulnerable':'weak',\n    'restless':'uneasy',\n    'revelation':'discovery',\n    'revelations':'exposures',\n    'romantic':'dreamy',\n    'practical':'useful',\n}\nfor old,new in repls.items():\n    s=re.sub(r'(?<![A-Za-z])'+re.escape(old)+r'(?![A-Za-z])',new,s)\np.write_text(s)\nPY\npdflatex -interaction=nonstopmode -halt-on-error main.tex 2>&1 | tee /tmp/pdflatex3.log\n"]
