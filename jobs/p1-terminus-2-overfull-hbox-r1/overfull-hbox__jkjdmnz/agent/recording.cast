[62.945468, "o", "\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kadvantages, benefits, privileges, as\u001b[01;31m\u001b[Kset\u001b[m\u001b[Ks, strengths, perks\r\n\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KConduct\u001b[m\u001b[K, \u001b[01;31m\u001b[KBehavior\u001b[m\u001b[K, \u001b[01;31m\u001b[KActions\u001b[m\u001b[K, Deportment, Demeanor, Bearing\r\n\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdelays, postponements, \u001b[01;31m\u001b[Kset\u001b[m\u001b[Kbacks, holdups, deferrals\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpainting, artwork, por\u001b[01;31m\u001b[Ktrait\u001b[m\u001b[K, picture, canvas, image\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kquality, characteristic, \u001b[01;31m\u001b[Ktrait\u001b[m\u001b[K, attribute, feature, standard\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Krestless, agitated, uneasy, fidgety, anxious, un\u001b[01;31m\u001b[Kset\u001b[m\u001b[Ktled\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kseries\u001b[m\u001b[K, sequence, \u001b[01;31m\u001b[Kchain\u001b[m\u001b[K, succession, \u001b[01;31m\u001b[Kset\u001b[m\u001b[K, progression\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kset\u001b[m\u001b[Ktler, colonist, resident, inhabitant, homesteader\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksuccessful\u001b[m\u001b[K, triumphant, prosperous, \u001b[01;31m\u001b[Keffective\u001b[m\u001b[K, accomplished, \u001b[01;31m\u001b[Kwinning\u001b[m\u001b[K\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktown, community, municipality, \u001b[01;31m\u001b[Kset\u001b[m\u001b[Ktlement, village, borough\r\n"]
