p = solution
arr = np.concatenate([
    np.full(int(counts[0]), p[0]),
    np.full(int(counts[1]), p[1]),
    np.full(int(counts[2]), p[2]),
])

# Renormalize only for floating-point summation, then verify the actual saved array.
arr /= arr.sum()
forward = float(np.sum(arr * np.log(arr * N)))
backward = float(np.sum((1.0 / N) * np.log((1.0 / N) / arr)))

if arr.shape != (N,) or not np.all(np.isfinite(arr)) or np.any(arr <= 0):
    raise RuntimeError("Invalid probability array")
if abs(arr.sum() - 1.0) > 1e-12:
    raise RuntimeError("Distribution does not sum to one")
if abs(forward - target) > 0.001 or abs(backward - target) > 0.001:
    raise RuntimeError(f"KL verification failed: forward={forward}, backward={backward}")

np.save("/app/dist.npy", arr)
print(f"saved /app/dist.npy, shape={arr.shape}, sum={arr.sum():.17g}")
print(f"forward KL={forward:.12f}")
print(f"backward KL={backward:.12f}")
print(f"min={arr.min():.17g}, max={arr.max():.17g}")
