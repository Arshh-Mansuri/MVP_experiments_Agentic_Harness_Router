python3 - <<'PY'
import urllib.request,urllib.parse,json
for q in ['povray','pov-ray']:
 u='https://archive.org/advancedsearch.php?'+urllib.parse.urlencode({'q':q,'fl[]':['identifier','title','year','mediatype'],'rows':500,'output':'json'})
 d=json.load(urllib.request.urlopen(u,timeout=30))
 print('\nQUERY',q)
 for x in d['response']['docs']: print(x.get('identifier'), '|',x.get('title'), '|',x.get('year'), '|',x.get('mediatype'))
PY
