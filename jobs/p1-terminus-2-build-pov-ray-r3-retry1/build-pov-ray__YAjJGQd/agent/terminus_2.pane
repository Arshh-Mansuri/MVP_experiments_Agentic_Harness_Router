python3 - <<'PY'
import urllib.request,urllib.parse,re
for q in ['"povray-2.2.tar.gz"','"povray-2.2.tar.Z"','"POV-Ray 2.2" download','povray 2.2 source archive']:
 print('\nQUERY',q)
 for base in ['https://html.duckduckgo.com/html/?q=','https://www.google.com/search?q=']:
  try:
   s=urllib.request.urlopen(urllib.request.Request(base+urllib.parse.quote(q),headers={'User-Agent':'Mozilla/5.0'}),timeout=30).read().decode('utf8','ignore')
   for x in re.findall(r'https?://[^"<> ]+',s):
    x=x.replace('&amp;','&')
    if not any(z in x for z in ['duckduckgo','google.com','gstatic','schema.org']): print(x[:500])
  except Exception as e: print('ERR',e)
PY
