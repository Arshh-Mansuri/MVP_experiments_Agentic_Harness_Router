python3 - <<'PY'
import urllib.request
for u in ['https://ftp.netbsd.org/pub/pkgsrc/current/pkgsrc/graphics/povray/Makefile','https://cvsweb.netbsd.org/bsdweb.cgi/~checkout~/pkgsrc/graphics/povray/Makefile','https://src.fedoraproject.org/repo/pkgs/povray/']:
 try: print('\n',u,'\n',urllib.request.urlopen(u,timeout=30).read().decode('utf8','ignore')[:10000])
 except Exception as e: print(e)
PY

