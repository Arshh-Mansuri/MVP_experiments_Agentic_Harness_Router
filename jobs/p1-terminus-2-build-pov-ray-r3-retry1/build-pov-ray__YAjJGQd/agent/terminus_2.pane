+system dos4g
+option map=povray
+option stub=wstubq.exe
+option verbose
+option stack=65535
+name povray
+file povray,bezier,blob,bound,boxes
+file camera,colour,cones,csg,discs
+file dump,express,gifdecod,gif,hfield
+file iff,image,lighting,matrices,normal
