FILE machine/ibmpc/zortech/ibmzor.lnk PATCH @@ -0,0 +1,21 @@
+noignore
+map
+output povray
+overlay CODE
+file povray,bezier,blob,bound,boxes,camera,colour,cones
+file csg,discs,express,hfield,image,lighting,matrices,normal
+file objects,pigment,planes,point,poly,quadrics
