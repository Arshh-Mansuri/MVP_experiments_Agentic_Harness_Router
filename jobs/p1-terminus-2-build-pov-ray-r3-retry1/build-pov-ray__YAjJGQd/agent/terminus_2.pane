import urllib.parse,urllib.request,json
for q in ['"povray-2.2.tar.gz"','"povray-2.2" source','povray 2.2 unix source download']:
 u='https://www.google.com/search?q='+urllib.parse.quote(q)
 try:
  s=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'}),timeout=20).read().decode('utf8','ignore')
  print('QUERY',q)
  import re
