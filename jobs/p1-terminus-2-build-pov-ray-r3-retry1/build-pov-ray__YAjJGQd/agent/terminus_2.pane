   right <4/3, 0.0, 0.0>
}

plane { y, -60.0
   pigment {
      Pine_Wood
      scale <4.0, 1.0, 2.0>
      rotate 45*y
   }
   finish {
      ambient 0.15
      diffuse 0.8
      brilliance 3.0
      crand 0.01
   }
}

object { Cylinder_X
   pigment { Brown }
   finish {
      crand 0.01
      ambient 0.15
      diffuse 0.8
      reflection 0.4
   }

   scale 5.0
   translate <0.0, -60.0, 120.0>
   rotate -40*y
}

