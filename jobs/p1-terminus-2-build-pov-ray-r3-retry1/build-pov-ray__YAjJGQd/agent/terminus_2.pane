    16	// These macros are just interfaces to the trace() function.
    17	// They return values through their parameters:
    18	// If an intersection is found, they return true and set
    19	// OPt to the intersection point, and ONorm to the normal.
    20	// Otherwise they return false, and do not modify OPt or ONorm.
    21	#macro Isect(Pt, Dir, Obj, OPt)
    22	   #local Norm = <0,0,0>;
    23	   #local IPt = trace(Obj, Pt, Dir, Norm);
    24	   #if (vlength(Norm) > 0)
    25	      #declare OPt = IPt;
    26	      #local Return=true;
    27	   #else
    28	      #local Return=false;
    29	   (Return)
    30	#end
    31	#macro IsectN(Pt, Dir, Obj, OPt, ONorm)
    32	   #local Norm = <0,0,0>;
    33	   #local IPt = trace(Obj, Pt, Dir, Norm);
    34	   #if (vlength(Norm) > 0)
    35	      #declare OPt = IPt;
    36	      #declare ONorm = Norm;
    37	      #local Return=true;
    38	   #else
    39	      #local Return=false;
    40	   #end
    41	   (Return)
    42	#end
    43	
    44	
    45	// A shortcut for getting both min and max extents of an object
    46	#macro Extents(Obj, Min, Max)
    47	   #declare Min = min_extent(Obj);
    48	   #declare Max = max_extent(Obj);
    49	#end
    50	
    51	
    52	// shortcuts for using the CenterTrans and AlignTrans
    53	// macros with objects.
    54	#macro Center_Object(Object, Axis)
    55	   object {Object Center_Trans(Object, Axis)}
    56	#end
    57	
    58	#macro Align_Object(Object, Axis, Pt)
    59	   object {Object Align_Trans(Object, Axis, Pt)}
    60	#end
    61	
    62	
    63	// A simple beveled text macro. The parameters are:
    64	// Font: the name of the font file.
    65	// String: the text string the text object is composed of.
    66	// Cuts: the number of times excess material is cut off, to form the bevel.
    67	//       More cuts will give smoother results, but take longer to render.
    68	// BevelAng: the angle of the bevel.
    69	// BevelDepth: the depth of the bevelled portion of the text.
    70	// Depth: the total depth of the text object.
    71	// Offset: the offset value for the text object.  Since the front faces of each
