data: [{"type":"content","path":"packages/benchmarks/suites/terminal-bench/tasks/build-pov-ray/task.yaml","repositoryID":63480915,"repository":"github.com/elizaOS/eliza","repoStars":19536,"repoLastFetched":"2026-10-04T12:36:35.362831Z","branches":[""],"commit":"612a2d553ded93a438b7efd442bc233fd9eef48e","hunks":null,"lineMatches":[{"line":"  Build POV-Ray 2.2. Find and download the source archives, extract them to `/app/povray-2.2`, then compile and install to `/usr/local/bin/povray`.","lineNumber":3,"offsetAndLengths":[[82,10]]},{"line":"  As a sanity check to see if your build works, you can run `/usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/dev/null +P -V`. This should complete successfully and show rendering statistics.","lineNumber":8,"offsetAndLengths":[[90,10]]}],"language":"YAML"},{"type":"content","path":"packages/benchmarks/suites/terminal-bench/tasks/build-pov-ray/solution.sh","repositoryID":63480915,"repository":"github.com/elizaOS/eliza","repoStars":19536,"repoLastFetched":"2026-10-04T12:36:35.362831Z","branches":[""],"commit":"612a2d553ded93a438b7efd442bc233fd9eef48e","hunks":null,"lineMatches":[{"line":"# Organize all POV-Ray files into /app/povray-2.2 (specified in task instruction)","lineNumber":97,"offsetAndLengths":[[39,10]]},{"line":"mkdir -p povray-2.2","lineNumber":98,"offsetAndLengths":[[9,10]]},{"line":"mv source povray-2.2/","lineNumber":99,"offsetAndLengths":[[10,10]]},{"line":"mv povdoc povray-2.2/","lineNumber":100,"offsetAndLengths":[[10,10]]},{"line":"mv povscn povray-2.2/","lineNumber":101,"offsetAndLengths":[[10,10]]},{"line":"mv machine povray-2.2/","lineNumber":102,"offsetAndLengths":[[11,10]]},{"line":"    [ -f \"$file\" ] \u0026\u0026 mv \"$file\" povray-2.2/","lineNumber":104,"offsetAndLengths":[[33,10]]},{"line":"/usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/dev/null +P -V","lineNumber":109,"offsetAndLengths":[[29,10]]}],"language":"Shell"},{"type":"content","p