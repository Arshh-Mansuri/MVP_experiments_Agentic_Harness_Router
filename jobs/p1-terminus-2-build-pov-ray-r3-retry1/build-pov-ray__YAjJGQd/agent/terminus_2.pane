+option map=povray
+option verbose
+option stack=12032
+option packcode=65536
+name povray
+file povray,bezier,blob,bound,boxes,camera,colour,cones
+file csg,discs,express,hfield,image,lighting,matrices,normal
+file objects,pigment,planes,point,poly,quadrics
+file ray,render,spheres,texture
+file triangle,txttest,vect,ibm
+library ai.lib
+
+begin
+  section file gif,gifdecod
+  section file iff
+  section file parse,tokenize
+end
+
+begin
+  section file dump
+  section file targa
+  section file raw
+end
FILE machine/ibmpc/watcom/ibmwat.mak PATCH @@ -19,125 +19,110 @@ CC      =wccp
 OBJ     =obj
 MACHINE_OBJ     = ibm.$(OBJ)
 
-LINKER  =wlink8
+LINKER  =wlink
 
 # Uncomment for 8086/8088 instruction set usage
 #
-#CFLAGS =-m$(CMODEL) -fpi -d2 -s -zc
+#CFLAGS =-m$(CMODEL) -fpc -s -zc
 
 # Uncomment for 80186/80268 (incl. V20!) instruction set usage  [/Gmsr2]
 #
-CFLAGS  =-m$(CMODEL) -7 -2 -d2 -s -zc -D__NO_MATH_OPS
-
-# If you have OS/2 to compile under, fix directory name and add this option
-# to CFLAGS above...
-#
-# /B2 C:\msc\c2l.exe
-#
+CFLAGS  =-m$(CMODEL) -7 -2 -s -zc
 
 # MS's NMAKE implicit rules for making an .OBJ file from a .C file...
 #
 # The second command converts debugging info from Watcom's to Turbo Debugger's
 #
 .c.obj :
-	$(CC) $(CFLAGS) -oxat $*.c
+	$(CC) $(CFLAGS) -oxamt -oe=100 $*.c
 #       w2td $*.obj
 
-# The option:
-#
-# /Oaxz
-#
-# Is purported by Microsoft to produce the fastest possible code.  In fact it
-# will break the RGB->HSV->RGB routines in IBM.C, if using the 8087 emulator.
-# So, for IBM.C we are using:
-#
-# /Ogiltaz
-#
-# This optimization string works for IBM.C and should then have worked for all
-# files, but, somehow, it BREAKS the compiler! (Internal compiler error C1001
-# on TEXTURE.C!!)  Oh, well...
-#
+F1 = povray.$(OBJ) bezier.$(OBJ) blob.$(OBJ) bound.$(OBJ) boxes.$(OBJ) 
+F2 = camera.$(OBJ) colour.$(OBJ) cones.$(OBJ) csg.$(OBJ) discs.$(OBJ) 
+F3 = dump.$(OBJ) express.$(OBJ) gifdecod.$(OBJ) gif.$(OBJ) hfield.$(OBJ) 
+F4 = iff.$(OBJ) image.$(OBJ) lighting.$(OBJ) matrices.$(OBJ) normal.$(OBJ) 
+F5 = objects.$(OBJ) parse.$(OBJ) pigment.$(OBJ) planes.$(OBJ) point.$(OBJ)
+F6 = poly.$(OBJ) quadrics.$(OBJ) raw.$(OBJ) ray.$(OBJ) render.$(OBJ) 
+F7 = spheres.$(OBJ) targa.$(OBJ) texture.$(OBJ) tokenize.$(OBJ) 
+F8 = triangle.$(OBJ) txttest.$(OBJ) vect.$(OBJ) $(MACHINE_OBJ)
 
-POVOBJS = povray.$(OBJ) render.$(OBJ) tokenize.$(OBJ) parse.$(OBJ) \
-	  objects.$(OBJ) spheres.$(OBJ) quadrics.$(OBJ) lighting.$(OBJ) \
-	  texture.$(OBJ) txtcolor.$(OBJ) txtbump.$(OBJ) txtmap.$(OBJ) \
-	  txttest.$(OBJ) prioq.$(OBJ) matrices.$(OBJ) csg.$(OBJ) hfield.$(OBJ) \
-	  colour.$(OBJ) viewpnt.$(OBJ) ray.$(OBJ) planes.$(OBJ) \
-	  point.$(OBJ) boxes.$(OBJ) iff.$(OBJ) blob.$(OBJ)\
-	  gif.$(OBJ) gifdecod.$(OBJ) triangle.$(OBJ) raw.$(OBJ) dump.$(OBJ) \
-	  targa.$(OBJ) poly.$(OBJ) bezier.$(OBJ) vect.$(OBJ) $(MACHINE_OBJ)
+PVOBJS = $(F1) $(F2) $(F3) $(F4) $(F5) $(F6) $(F7) $(F8) 
 
 # POV-Ray Specific Dependencies
 #
-povray.exe : $(POVOBJS)
+povray.exe : $(PVOBJS)
 	$(LINKER) @ibmwat.lnk
 
+#
+# Specific module/header dependencies for PV-Ray:
+#
