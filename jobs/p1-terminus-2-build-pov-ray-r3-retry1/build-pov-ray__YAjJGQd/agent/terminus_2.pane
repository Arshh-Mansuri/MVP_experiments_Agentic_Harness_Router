    73	#macro Bevelled_Text(Font, String, Cuts, BevelAng, BevelDepth, Depth, Offset, UseMerge)
    74	   #local BBox = text {ttf Font, String Depth, Offset*(x+y)}
    75	   #if(UseMerge)
