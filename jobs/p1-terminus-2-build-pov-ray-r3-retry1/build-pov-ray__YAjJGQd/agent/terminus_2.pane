FILE machine/unix/unix.mak PATCH @@ -42,3 +42,76 @@ POVOBJS = povray.$(OBJ) bezier.$(OBJ) blob.$(OBJ) bound.$(OBJ) boxes.$(OBJ)  \
 povray:	$(POVOBJS)
 	$(CC) $(LFLAGS) $(POVOBJS) -lm
 
