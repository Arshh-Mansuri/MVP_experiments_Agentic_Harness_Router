cd /app
python3 - <<'PY'
import urllib.request,json
ids=['povray','povray2','povray-2','povray-source','povray_unix','povray22','pov-ray']
for ident in ids:
 try:
  d=json.load(urllib.request.urlopen('https://archive.org/metadata/'+ident,timeout=20))
  print('\nIDENT',ident,'TITLE',d.get('metadata',{}).get('title'))
  for f in d.get('files',[]): print(f.get('name'))
 except Exception as e: pass
PY
