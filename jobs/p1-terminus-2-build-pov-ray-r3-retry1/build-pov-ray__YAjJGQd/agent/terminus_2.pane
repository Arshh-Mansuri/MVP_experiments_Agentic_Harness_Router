    46	               Shear_Trans(x, y, < cos(A)*SA, sin(A)*SA, CA>/CA)
    47	            }
    48	      }
    49	      translate z*BevelDepth
    50	      bounded_by {box {min_extent(BBox), max_extent(BBox)}}
