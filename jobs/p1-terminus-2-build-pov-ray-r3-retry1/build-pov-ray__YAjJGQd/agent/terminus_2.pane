import urllib.request,urllib.parse,json
for q in ['povray-2.2','povray 2.2','POV-Ray 2.2']:
 u='https://grep.app/api/search?'+urllib.parse.urlencode({'q':q,'regexp':'false','filter[lang]':'Shell'})
 try:
  d=json.load(urllib.request.urlopen(u,timeout=30)); print('\n',q,d.get('hits',{}).get('total'))
  for h in d.get('hits',{}).get('hits',[]): print(h.get('repo'),h.get('path'),h.get('content',{}).get('snippet',''))
 except Exception as e: print(e)
