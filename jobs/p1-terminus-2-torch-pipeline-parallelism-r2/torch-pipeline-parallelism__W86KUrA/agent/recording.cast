[54.346667, "i", "cat > /app/pipeline_parallel.py <<'PY'\n\"\"\"AFAB pipeline-parallel training for Hugging Face LLaMA models.\"\"\"\n\nimport inspect\nfrom typing import List\n\nimport torch\nimport torch.distributed as dist\nimport torch.nn.functional as F\n\n\ndef _call_decoder_layer(layer, hidden_states, attention_mask, position_ids,\n                        position_embeddings=None):\n    \"\"\"Call decoder layers across the relevant HF Transformers API variants.\"\"\"\n    parameters = inspect.signature(layer.forward).parameters\n    kwargs = {}\n    if \"attention_mask\" in parameters:\n        kwargs[\"attention_mask\"] = attention_mask\n    if \"position_ids\" in parameters:\n        kwargs[\"position_ids\"] = position_ids\n    if position_embeddings is not None and \"position_embeddings\" in parameters:\n        kwargs[\"position_embeddings\"] = position_embeddings\n    if \"past_key_value\" in parameters:\n        kwargs[\"past_key_value\"] = None\n    if \"past_key_values\" in parameters:\n        kwargs[\"past_key_values\"] = None\n    if \"use_cache\" in parameters:\n        kwargs[\"use_cache\"] = False\n    if \"output_attentions\" in parameters:\n        kwargs[\"output_attentions\"] = False\n\n    result = layer(hidden_states, **kwargs)\n    return result[0] if isinstance(result, (tuple, list)) else result\n\n\ndef _make_causal_mask(batch, sequence_length, device, dtype):\n    \"\"\"Return the additive causal mask accepted by LLaMA attention layers.\"\"\"\n    # The diagonal and lower triangle are zero; the strict upper triangle is -inf.\n    mask = torch.zeros(\n        (sequence_length, sequence_length), device=device, dtype=dtype\n    )\n    mask = mask.masked_fill(\n        torch.triu(torch.ones_like(mask, dtype=torch.bool), diagonal=1),\n        torch.finfo(dtype).min,\n    )\n    return mask[None, None, :, :].expand(batch, 1, sequence_length, sequence_length)\n\n\ndef _position_embeddings(backbone, hidden_states, position_ids):\n    rotary = getattr(backbone, \"rotary_emb\", None)\n    if rotary is None:\n        return None\n    try:\n        params = inspect.signature(rotary.forward).parameters\n        kwargs = {}\n        if \"position_ids\" in params:\n            kwargs[\"position_ids\"] = position_ids\n        if \"cache_position\" in params:\n            kwargs[\"cache_position\"] = position_ids[0]\n        return rotary(hidden_states, **kwargs)\n    except (TypeError, ValueError):\n        try:\n            return rotary(hidden_states, position_ids)\n        except TypeError:\n            return None\n\n\ndef _layer_ranges(num_layers, world_size):\n    base, remainder = divmod(num_layers, world_size)\n    ranges = []\n    start = 0\n    for rank in range(world_size):\n        count = base + (1 if rank < remainder else 0)\n        ranges.append((start, start + count))\n        start += count\n    return ranges\n\n\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    \"\"\"Run one all-forward-all-backward pipeline-parallel training step.\n\n    Decoder layers are divided into contiguous balanced ranges.  Activations\n    crossing a stage boundary are detached before transmission, while the\n    sending stage retains its local autograd graph for the later backward pass.\n    \"\"\"\n    rank = dist.get_rank() if dist.is_available() and dist.is_initialized() else 0\n    world_size = (dist.get_world_size()\n                  if dist.is_available() and dist.is_initialized() else 1)\n\n    backbone = model.model\n    layers = backbone.layers\n    first, last = _layer_ranges(len(layers), world_size)[rank]\n    local_layers = layers[first:last]\n    num_microbatches = len(inputs)\n    if num_microbatches != len(targets):\n        raise ValueError(\"inputs and targets must contain the same number of microbatches\")\n\n    # LLaMA's decoder layers use a causal additive mask.  Position IDs are\n    # regenerated per microbatch because sequence lengths may differ.\n    saved_outputs: List[torch.Tensor] = []\n    saved_inputs: List[torch.Tensor] = []\n\n    for microbatch, input_ids in enumerate(inputs):\n        input_ids = input_ids.to(device=device)\n        batch, seq_len = input_ids.shape[-2], input_ids.shape[-1]\n        position_ids = torch.arange(seq_len,"]
[54.347653, "i", " device=device, dtype=torch.long)\n        position_ids = position_ids.unsqueeze(0).expand(batch, -1)\n        hidden = None\n\n        if rank == 0:\n            hidden = backbone.embed_tokens(input_ids).to(dtype=dtype, device=device)\n        else:\n            hidden = torch.empty(\n                (batch, seq_len, model.config.hidden_size),\n                device=device,\n                dtype=dtype,\n            )\n            dist.recv(hidden, src=rank - 1, tag=microbatch)\n            hidden.requires_grad_(True)\n\n        saved_inputs.append(hidden)\n        mask = _make_causal_mask(batch, seq_len, device, hidden.dtype)\n        pos_emb = _position_embeddings(backbone, hidden, position_ids)\n        for layer in local_layers:\n            hidden = _call_decoder_layer(\n                layer, hidden, mask, position_ids, pos_emb\n            )\n\n        saved_outputs.append(hidden)\n        if rank < world_size - 1:\n            dist.send(hidden.detach().contiguous(), dst=rank + 1, tag=microbatch)\n\n    # AFAB: no backward operation occurs until every microbatch has completed\n    # its forward pass on this stage.\n    for microbatch in reversed(range(num_microbatches)):\n        output = saved_outputs[microbatch]\n        if rank == world_size - 1:\n            hidden = backbone.norm(output)\n            logits = model.lm_head(hidden)\n            target = targets[microbatch].to(device=device, dtype=torch.long)\n            loss = F.cross_entropy(\n                logits.float().reshape(-1, logits.shape[-1]),\n                target.reshape(-1),\n                reduction=\"mean\",\n            ) / max(1, num_microbatches)\n            loss.backward()\n            grad = saved_inputs[microbatch].grad\n        else:\n            grad = torch.empty_like(output)\n            dist.recv(grad, src=rank + 1, tag=100000 + microbatch)\n            torch.autograd.backward(output, grad)\n            grad = saved_inputs[microbatch].grad\n\n        if rank > 0:\n            if grad is None:\n                raise RuntimeError(\"pipeline stage produced no input gradient\")\n            dist.send(grad.to(device=device, dtype=dtype).contiguous(),\n                      dst=rank - 1, tag=100000 + microbatch)\n\n    # The loss is intentionally returned only on the final rank.  Returning\n    # None elsewhere avoids introducing a second cross-stage synchronization.\n    return loss.detach() if rank == world_size - 1 else None\nPY\npython3 -m py_compile /app/pipeline_parallel.py\n"]
