[54.396563, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         saved_outputs.append(hidden)\r\n\u001b[?2004l\r\u001b[?2004h>         if rank < world_size - 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.396662, "o", "            dist.send(hidden.detach().contiguous(), dst=rank + 1, tag=microbatch)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.396851, "o", "    # AFAB: no backward operation occurs until every microbatch has completed\r\n\u001b[?2004l\r\u001b[?2004h>     # its forward pass on this stage.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.396905, "o", "    for microbatch in reversed(range(num_microbatches)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.397134, "o", "        output = saved_outputs[microbatch]\r\n\u001b[?2004l\r\u001b[?2004h>         if rank == world_size - 1:\r\n\u001b[?2004l\r\u001b[?2004h>             hidden = backbone.norm(output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.397261, "o", "            logits = model.lm_head(hidden)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.397529, "o", "            target = targets[microbatch].to(device=device, dtype=torch.long)\r\n\u001b[?2004l\r\u001b[?2004h>             loss = F.cross_entropy(\r\n\u001b[?2004l\r"]
[54.39757, "o", "\u001b[?2004h> "]
[54.397665, "o", "                logits.float().reshape(-1, logits.shape[-1]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.397826, "o", "                target.reshape(-1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.398026, "o", "                reduction=\"mean\",\r\n\u001b[?2004l\r"]
[54.39817, "o", "\u001b[?2004h>             ) / max(1, num_microbatches)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.39838, "o", "            loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.398424, "o", ">             grad = saved_inputs[microbatch].grad\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.3987, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h>             grad = torch.empty_like(output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.398862, "o", "            dist.recv(grad, src=rank + 1, tag=100000 + microbatch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.398979, "o", "            torch.autograd.backward(output, grad)\r\n\u001b[?2004l\r\u001b[?2004h>             grad = saved_inputs[microbatch].grad\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.399065, "o", "        if rank > 0:\r\n\u001b[?2004l\r"]
[54.399095, "o", "\u001b[?2004h> "]
[54.399215, "o", "            if grad is None:\r\n\u001b[?2004l\r"]
[54.399405, "o", "\u001b[?2004h>                 raise RuntimeError(\"pipeline stage produced no input gradient\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.399749, "o", "            dist.send(grad.to(device=device, dtype=dtype).contiguous(),\r\n\u001b[?2004l\r\u001b[?2004h>                       dst=rank - 1, tag=100000 + microbatch)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.399924, "o", "    # The loss is intentionally returned only on the final rank.  Returning\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.400011, "o", "    # None elsewhere avoids introducing a second cross-stage synchronization.\r\n\u001b[?2004l\r\u001b[?2004h>     return loss.detach() if rank == world_size - 1 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.400174, "o", "PY\r\n\u001b[?2004l\r"]
[54.426063, "o", "\u001b[?2004hroot@2136dee51ad5:/app# "]
[54.426164, "o", "python3 -m py_compile /app/pipeline_parallel.py\r\n\u001b[?2004l\r"]
[54.669923, "o", "\u001b[?2004hroot@2136dee51ad5:/app# "]
[64.881927, "i", "python3 - <<'PY'\np = '/app/pipeline_parallel.py'\ns = open(p).read()\nold = '            hidden = backbone.embed_tokens(input_ids).to(dtype=dtype, device=device)\\n'\nnew = old + '            # Embedding output is non-leaf; retain its gradient for pipeline send.\\n            hidden.retain_grad()\\n'\nif old not in s:\n    raise SystemExit('expected embedding line not found')\nopen(p, 'w').write(s.replace(old, new, 1))\nPY\npython3 -m py_compile /app/pipeline_parallel.py\ngrep -n -A4 -B2 'embed_tokens' /app/pipeline_parallel.py\n"]
[64.88332, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.883756, "o", "p = '/app/pipeline_parallel.py'\r\n\u001b[?2004l\r\u001b[?2004h> s = open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.88538, "o", "old = '            hidden = backbone.embed_tokens(input_ids).to(dtype=dtype, device=device)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> new = old + '            # Embedding output is non-leaf; retain its gradient for pipeline send.\\n            hidden.retain_grad()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected embedding line not found')\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[65.024862, "o", "\u001b[?2004hroot@2136dee51ad5:/app# "]
[65.025067, "o", "python3 -m py_compile /app/pipeline_parallel.py\r\n\u001b[?2004l\r"]
[65.202344, "o", "\u001b[?2004hroot@2136dee51ad5:/app# "]
[65.20259, "o", "grep -n -A4 -B2 'embed_tokens' /app/pipeline_parallel.py\r\n\u001b[?2004l\r"]
[65.23378, "o", "\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K109\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if rank == 0:\r\n"]
[65.235578, "o", "\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            hidden = backbone.\u001b[01;31m\u001b[Kembed_tokens\u001b[m\u001b[K(input_ids).to(dtype=dtype, device=device)\r\n"]
[65.235885, "o", "\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # Embedding output is non-leaf; retain its gradient for pipeline send.\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            hidden.retain_grad()\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else:\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            hidden = torch.empty(\r\n"]
