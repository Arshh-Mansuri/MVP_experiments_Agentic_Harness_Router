[85.16282, "i", "cat > /app/polyglot/main.py.c <<'EOF'\n#if 0\nif 0:\n    \"\"\"\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <stddef.h>\n\nint main(int argc, char **argv) {\n    if (argc < 2) return 1;\n    size_t n = strtoull(argv[1], NULL, 10);\n    size_t cap = n + 3;\n    unsigned char *a = calloc(cap, 1);\n    unsigned char *b = calloc(cap, 1);\n    unsigned char *c = calloc(cap, 1);\n    if (!a || !b || !c) return 1;\n\n    size_t la = 1, lb = 1;\n    a[0] = 0;\n    b[0] = 1;\n    for (size_t i = 0; i < n; ++i) {\n        size_t lc = la > lb ? la : lb;\n        unsigned carry = 0;\n        for (size_t j = 0; j < lc; ++j) {\n            unsigned v = carry;\n            if (j < la) v += a[j];\n            if (j < lb) v += b[j];\n            c[j] = (unsigned char)(v % 10);\n            carry = v / 10;\n        }\n        if (carry) c[lc++] = (unsigned char)carry;\n\n        unsigned char *t = a;\n        a = b;\n        b = c;\n        c = t;\n        la = lb;\n        lb = lc;\n    }\n\n    for (size_t i = la; i-- > 0;) putchar('0' + a[i]);\n    putchar('\\n');\n    free(a);\n    free(b);\n    free(c);\n    return 0;\n}\n#if 0\n    \"\"\"\n#endif\nimport sys\n\nn = int(sys.argv[1])\na, b = 0, 1\nfor _ in range(n):\n    a, b = b, a + b\nprint(a)\nEOF\npython3 /app/polyglot/main.py.c 0\npython3 /app/polyglot/main.py.c 1\npython3 /app/polyglot/main.py.c 10\npython3 /app/polyglot/main.py.c 100\ngcc -Wall -Wextra /app/polyglot/main.py.c -o /app/polyglot/cmain\n/app/polyglot/cmain 0\n/app/polyglot/cmain 1\n/app/polyglot/cmain 10\n/app/polyglot/cmain 100\n"]
