[?2004l[?2004h> import contextlib,io,math
[?2004l[?2004h> with contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])
[?2004l[?2004h> # all-layer planar projection, rendered at 240x64
[?2004l[?2004h> W,H=240,64; g=[[0]*W for _ in range(H)]
[?2004l[?2004h> for a,b,c,d in P:
[?2004l[?2004h>  n=max(2,int(math.hypot(c-a,d-b)*10))
[?2004l[?2004h>  for k in range(n+1):
[?2004l[?2004h>   t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t
[?2004l[?2004h>   ix=round((X-x0)/(x1-x0)*(W-1)); iy=H-1-round((Y-y0)/(y1-y0)*(H-1))
[?2004l[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]=1
[?2004l[?2004h> # pad and braille encode, 2x4 dots
[?2004l[?2004h> for part,a in enumerate(range(0,W,60),1):
[?2004l[?2004h>  print('===',part,'===')
[?2004l[?2004h>  for yy in range(0,H,4):
[?2004l[?2004h>   out=''
[?2004l[?2004h>   for xx in range(a,min(a+60,W),2):
[?2004l[?2004h>    bits=0
[?2004l[?2004h>    for dx,dy,bit in [(0,0,1),(0,1,2),(0,2,4),(1,0,8),(1,1,16),(1,2,32),(0,3,64),(1,3,128)]:
[?2004l[?2004h>     if yy+dy<H and xx+dx<W and g[yy+dy][xx+dx]: bits|=bit
[?2004l[?2004h>    out+=chr(0x2800+bits) if bits else ' '
[?2004l[?2004h>   print(out.rstrip())
