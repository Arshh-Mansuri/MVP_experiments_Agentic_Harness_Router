[?2004hroot@057edc6a1cbe:/app# cat > /tmp/glyphs.py <<'PY'
[?2004l[?2004h> import re,math
[?2004l[?2004h> num=r'-?(?:\d+(?:\.\d*)?|\.\d+)'; obj=None;x=y=z=0.; seg=[]; pts=[]
[?2004l[?2004h> for raw in open('/app/text.gcode',errors='ignore'):
[?2004l[?2004h>  s=raw.strip(); m=re.match(r'M486 S(-?\d+)',s)
[?2004l[?2004h>  if m:
[?2004l[?2004h>   v=int(m.group(1)); obj=v if v>=0 else None; continue
[?2004l[?2004h>  if obj!=0 or not s.startswith(('G0 ','G1 ')): continue
[?2004l[?2004h>  def get(ch,old):
[?2004l[?2004h>   q=re.search(r'(?:^|\s)'+ch+'('+num+r')',s); return float(q.group(1)) if q else old
[?2004l[?2004h>  nx,ny,nz=get('X',x),get('Y',y),get('Z',z); q=re.search(r'(?:^|\s)E('+num+r')',s)
[?2004l[?2004h>  if q and float(q.group(1))>0 and (nx!=x or ny!=y or nz!=z): seg.append(((x,y,z),(nx,ny,nz))); pts += [(x,y,z),(nx,ny,nz)]
[?2004l[?2004h>  x,y,z=nx,ny,nz
[?2004l[?2004h> mean=[sum(p[j] for p in pts)/len(pts) for j in range(3)]
[?2004l[?2004h> def dot(a,b): return sum(i*j for i,j in zip(a,b))
[?2004l[?2004h> def norm(v): return math.sqrt(dot(v,v))
[?2004l[?2004h> C=[[sum((p[i]-mean[i])*(p[j]-mean[j]) for p in pts) for j in range(3)] for i in range(3)]
[?2004l[?2004h> def eig(M,v):
[?2004l[?2004h>  for _ in range(300):
[?2004l[?2004h>   w=[sum(M[i][j]*v[j] for j in range(3)) for i in range(3)]; n=norm(w); v=[a/n for a in w]
[?2004l[?2004h>  return v,dot(v,[sum(M[i][j]*v[j] for j in range(3)) for i in range(3)])
[?2004l[?2004h> v1,l=eig(C,[1,1,1]); M=[[C[i][j]-l*v1[i]*v1[j] for j in range(3)] for i in range(3)]; v2,l=eig(M,[1,-1,0])
[?2004l[?2004h> def pr(p,v): return dot([p[i]-mean[i] for i in range(3)],v)
[?2004l[?2004h> P=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in seg]
[?2004l[?2004h> x0=min(min(a,c) for a,b,c,d in P); x1=max(max(a,c) for a,b,c,d in P); y0=min(min(b,d) for a,b,c,d in P); y1=max(max(b,d) for a,b,c,d in P)
[?2004l[?2004h> W,H=360,100; g=[[0]*W for _ in range(H)]
[?2004l[?2004h> for a,b,c,d in P:
[?2004l[?2004h>  n=max(2,int(math.hypot(c-a,d-b)*8))
[?2004l[?2004h>  for k in range(n+1):
[?2004l[?2004h>   t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))
[?2004l[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]=1
[?2004l[?2004h> cols=[sum(g[y][x] for y in range(H)) for x in range(W)]
[?2004l[?2004h> # glyph runs, allowing small internal gaps but splitting long gaps
[?2004l[?2004h> runs=[]; start=None; gap=0
[?2004l[?2004h> for i,c in enumerate(cols+[0]):
[?2004l[?2004h>  if c: 
[?2004l[?2004h>   if start is None:start=i
[?2004l[?2004h>   gap=0
[?2004l[?2004h>  elif start is not None:
[?2004l[?2004h>   gap+=1
[?2004l[?2004h>   if gap>=5:
[?2004l[?2004h>    runs.append((start,i-gap+1)); start=None;gap=0
[?2004l[?2004h> print('glyph runs',runs)
[?2004l[?2004h> for ri,(a,b) in enumerate(runs):
[?2004l[?2004h>  print('\nGLYPH',ri,'columns',a,b)
[?2004l[?2004h>  for yy in range(0,H,2):
[?2004l[?2004h>   print(''.join('##' if any(g[j][xx] for j in range(yy,min(H,yy+2))) else '  ' for xx in range(a,b)).rstrip())
[?2004l[?2004h> PY
