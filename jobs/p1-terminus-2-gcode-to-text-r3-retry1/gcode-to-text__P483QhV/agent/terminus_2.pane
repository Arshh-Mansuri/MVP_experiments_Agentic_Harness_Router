 L=math.hypot(c-a,d-b)
 if L>12: continue
 n=max(2,int(L*5))
 for k in range(n+1):
  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t
  ix=round((xx-xmin)/(xmax-xmin)*(W-1)); iy=H-1-round((yy-ymin)/(ymax-ymin)*(H-1))
