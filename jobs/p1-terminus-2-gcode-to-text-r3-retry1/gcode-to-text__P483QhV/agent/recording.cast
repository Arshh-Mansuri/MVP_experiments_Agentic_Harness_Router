[270.465811, "i", "python3 - <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\nzs=[max(a[2],b[2]) for a,b in seg]; cutoff=sorted(zs)[int(len(zs)*.85)]; top=[q for q,zz in zip(seg,zs) if zz>=cutoff]\nP2=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in top]\nxx=[q for p in P2 for q in (p[0],p[2])]; yy=[q for p in P2 for q in (p[1],p[3])]; xlo,xhi=min(xx),max(xx); ylo,yhi=min(yy),max(yy)\nW,H=240,48; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P2:\n n=max(2,int(math.hypot(c-a,d-b)*12))\n for k in range(n+1):\n  t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t; ix=round((X-xlo)/(xhi-xlo)*(W-1)); iy=H-1-round((Y-ylo)/(yhi-ylo)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\ncols=[sum(g[y][x] for y in range(H)) for x in range(W)]\nprint(''.join(' ' if c==0 else '.' if c<3 else '+' if c<10 else '#' for c in cols))\n# Find valleys of at least 3 blank columns, then print runs\nruns=[]; s=None; gap=0\nfor i,c in enumerate(cols+[0]):\n if c:\n  if s is None:s=i\n  gap=0\n elif s is not No"]
[270.469106, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[270.469243, "i", "ne:\n  gap+=1\n  if gap>=3:runs.append((s,i-gap+1));s=None;gap=0\nprint('runs',runs)\nfor k,(a,b) in enumerate(runs):\n print('\\nGLYPH',k,a,b)\n ys=[y for y in range(H) if any(g[y][x] for x in range(a,b))]\n if not ys:continue\n for y in range(max(0,min(ys)-1),min(H,max(ys)+2)):\n  print(''.join('█' if g[y][x] else ' ' for x in range(a,b)))\nPY\n"]
