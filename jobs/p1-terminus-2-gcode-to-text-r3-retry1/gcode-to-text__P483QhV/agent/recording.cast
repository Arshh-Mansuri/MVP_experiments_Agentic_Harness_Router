[70.765945, "i", "python3 - <<'PY'\nimport re,collections\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None;x=y=0.; z=None; layers=collections.defaultdict(list)\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\n if m: obj=int(m.group(1)) if int(m.group(1))>=0 else None; continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n mx=re.search(r'(?:^|\\s)X('+num+r')',s); my=re.search(r'(?:^|\\s)Y('+num+r')',s); mz=re.search(r'(?:^|\\s)Z('+num+r')',s); me=re.search(r'(?:^|\\s)E('+num+r')',s)\n nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\n if mz: z=float(mz.group(1))\n if me and float(me.group(1))>0 and (mx or my) and not mz and z is not None: layers[z].append((x,y,nx,ny))\n x,y=nx,ny\n# render most populated layer\nzz,segs=max(layers.items(),key=lambda q:len(q[1])); print('RENDER Z',zz,'segments',len(segs))\nxmin=min(min(a,c) for a,b,c,d in segs); xmax=max(max(a,c) for a,b,c,d in segs); ymin=min(min(b,d) for a,b,c,d in segs); ymax=max(max(b,d) for a,b,c,d in segs)\nW,H"]
[70.766132, "i", "=180,45; g=[[' ']*W for _ in range(H)]\nfor a,b,c,d in segs:\n n=max(2,int((((c-a)**2+(d-b)**2)**.5)/.08))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=round((xx-xmin)/(xmax-xmin)*(W-1)); iy=H-1-round((yy-ymin)/(ymax-ymin)*(H-1)); g[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\n"]
