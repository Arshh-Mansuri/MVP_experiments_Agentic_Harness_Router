[84.538177, "i", "python3 - <<'PY'\nimport re,collections\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None;x=y=0.; z=None; layers=collections.defaultdict(list)\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\n if m: obj=int(m.group(1)) if int(m.group(1))>=0 else None; continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n mx=re.search(r'(?:^|\\s)X('+num+r')',s); my=re.search(r'(?:^|\\s)Y('+num+r')',s); mz=re.search(r'(?:^|\\s)Z('+num+r')',s); me=re.search(r'(?:^|\\s)E('+num+r')',s)\n nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\n if mz: z=float(mz.group(1))\n if me and float(me.group(1))>0 and (mx or my) and not mz and z is not None: layers[round(z,3)].append((x,y,nx,ny))\n x,y=nx,ny\nsegs=layers[11.12]; xmin=min(min(a,c) for a,b,c,d in segs); xmax=max(max(a,c) for a,b,c,d in segs); ymin=min(min(b,d) for a,b,c,d in segs); ymax=max(max(b,d) for a,b,c,d in segs)\n# square-ish physical pixels: 2 pixels/mm\nW=300; H=max(1,round((ymax-ymin)*2)); grid=[[0]*W for _ "]
[84.538377, "i", "in range(H)]\nfor a,b,c,d in segs:\n n=max(2,round(((c-a)**2+(d-b)**2)**.5*4))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=min(W-1,max(0,round((xx-xmin)/(xmax-xmin)*(W-1)))); iy=min(H-1,max(0,H-1-round((yy-ymin)/(ymax-ymin)*(H-1))))\n  grid[iy][ix]=1\n# downsample to terminal cells, using any ink in 2x2 blocks\nsx=3; sy=2\nfor yy in range(0,H,sy):\n line=''\n for xx in range(0,W,sx):\n  hit=any(grid[j][i] for j in range(yy,min(H,yy+sy)) for i in range(xx,min(W,xx+sx)))\n  line += '█' if hit else ' '\n print(line.rstrip())\nPY\n"]
