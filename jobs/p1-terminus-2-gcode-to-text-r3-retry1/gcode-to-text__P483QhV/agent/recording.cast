[285.572945, "i", "python3 - <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\n# all-layer planar projection, rendered at 240x64\nW,H=240,64; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*10))\n for k in range(n+1):\n  t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t\n  ix=round((X-x0)/(x1-x0)*(W-1)); iy=H-1-round((Y-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\n# pad and braille encode, 2x4 dots\nfor part,a in enumerate(range(0,W,60),1):\n print('===',part,'===')\n for yy in range(0,H,4):\n  out=''\n  for xx in range(a,min(a+60,W),2):\n   bits=0\n   for dx,dy,bit in [(0,0,1),(0,1,2),(0,2,4),(1,0,8),(1,1,16),(1,2,32),(0,3,64),(1,3,128)]:\n    if yy+dy<H and xx+dx<W and g[yy+dy][xx+dx]: bits|=bit\n   out+=chr(0x2800+bits) if bits else ' '\n  print(out.rstrip())\nPY\n"]
[285.573431, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[285.575576, "o", "\u001b[?2004h> import contextlib,io,math\r\n\u001b[?2004l\r\u001b[?2004h> with contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\r\n\u001b[?2004l\r\u001b[?2004h> # all-layer planar projection, rendered at 240x64\r\n\u001b[?2004l\r\u001b[?2004h> W,H=240,64; g=[[0]*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,c,d in P:\r\n\u001b[?2004l\r\u001b[?2004h>  n=max(2,int(math.hypot(c-a,d-b)*10))\r\n\u001b[?2004l\r\u001b[?2004h>  for k in range(n+1):\r\n\u001b[?2004l\r\u001b[?2004h>   t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t\r\n\u001b[?2004l\r\u001b[?2004h>   ix=round((X-x0)/(x1-x0)*(W-1)); iy=H-1-round((Y-y0)/(y1-y0)*(H-1))\r\n\u001b[?2004l\r\u001b[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\r\n\u001b[?2004l\r\u001b[?2004h> # pad and braille encode, 2x4 dots\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.575766, "o", "for part,a in enumerate(range(0,W,60),1):\r\n\u001b[?2004l\r\u001b[?2004h>  print('===',part,'===')\r\n\u001b[?2004l\r\u001b[?2004h> "]
