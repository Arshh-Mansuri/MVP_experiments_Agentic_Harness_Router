[232.341743, "i", "python3 - <<'PY'\n# obtain projection, suppress parser diagnostics\nimport contextlib,io\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\nW,H=180,36; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*7))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\nfor part,a in enumerate(range(0,W,30),1):\n print('===',part,'X',a,'-',min(a+30,W),'===')\n for y in range(H): print(''.join('█' if g[y][x] else ' ' for x in range(a,min(a+30,W))).rstrip())\nPY\n"]
