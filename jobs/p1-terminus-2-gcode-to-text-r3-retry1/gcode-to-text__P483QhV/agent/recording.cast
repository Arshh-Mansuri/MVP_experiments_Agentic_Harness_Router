[19.933125, "i", "python3 - <<'PY'\nimport re\np='/app/text.gcode'\nlayers={}\ncurz=None\nn=0\nxmin=ymin=1e9;xmax=ymax=-1e9\nfor line in open(p, errors='ignore'):\n    s=line.strip()\n    if s.startswith(('G0 ','G1 ','G2 ','G3 ')):\n        z=re.search(r'\\bZ(-?\\d+(?:\\.\\d+)?)',s)\n        if z: curz=float(z.group(1))\n        if curz is not None:\n            layers.setdefault(curz,0)\n        if s.startswith('G1 ') and ' E' in s:\n            n+=1\n            x=re.search(r'\\bX(-?\\d+(?:\\.\\d+)?)',s); y=re.search(r'\\bY(-?\\d+(?:\\.\\d+)?)',s)\n            if x and y:\n                x=float(x.group(1)); y=float(y.group(1)); xmin=min(xmin,x);xmax=max(xmax,x);ymin=min(ymin,y);ymax=max(ymax,y)\nprint('extrusion G1 moves:',n)\nprint('all Z values:', sorted(layers.items())[:20], '... total',len(layers))\nprint('XY bounds of extrusion endpoints:',xmin,xmax,ymin,ymax)\nPY\n"]
