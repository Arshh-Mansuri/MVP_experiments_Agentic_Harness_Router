[118.792357, "i", "python3 - <<'PY'\nimport re,collections,math\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None;x=y=0.;z=None; layers=collections.defaultdict(list); allseg=[]\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\n if m:\n  v=int(m.group(1)); obj=v if v>=0 else None; continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n mx=re.search(r'(?:^|\\s)X('+num+r')',s); my=re.search(r'(?:^|\\s)Y('+num+r')',s); mz=re.search(r'(?:^|\\s)Z('+num+r')',s); me=re.search(r'(?:^|\\s)E('+num+r')',s)\n nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\n if mz: z=float(mz.group(1))\n if me and float(me.group(1))>0 and (mx or my) and not mz and z is not None:\n  q=(x,y,nx,ny); layers[round(z,3)].append(q); allseg.append(q)\n x,y=nx,ny\nfor zz in sorted(layers)[::max(1,len(layers)//15)]:\n q=layers[zz]; print(f'z={zz:.3f} n={len(q)} bbox=({min(min(a,c) for a,b,c,d in q):.1f},{max(max(a,c) for a,b,c,d in q):.1f},{min(min(b,d) for a,b,c,d in q):.1f},{max(max(b,d) for a,b,c,d in q"]
[118.794617, "i", "):.1f})')\nprint('all',len(allseg),'bbox',min(min(a,c) for a,b,c,d in allseg),max(max(a,c) for a,b,c,d in allseg),min(min(b,d) for a,b,c,d in allseg),max(max(b,d) for a,b,c,d in allseg))\n# projection raster\nxmin=min(min(a,c) for a,b,c,d in allseg); xmax=max(max(a,c) for a,b,c,d in allseg); ymin=min(min(b,d) for a,b,c,d in allseg); ymax=max(max(b,d) for a,b,c,d in allseg)\nW,H=300,140; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in allseg:\n L=math.hypot(c-a,d-b)\n if L>12: continue\n n=max(2,int(L*5))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=round((xx-xmin)/(xmax-xmin)*(W-1)); iy=H-1-round((yy-ymin)/(ymax-ymin)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\n# terminal aspect: 2 horizontal pixels per displayed char, 4 vertical rows per char\nfor yy in range(0,H,4):\n line=''\n for xx in range(0,W,2):\n  hit=any(g[j][i] for j in range(yy,min(H,yy+4)) for i in range(xx,min(W,xx+2)))\n  line+='█' if hit else ' '\n print(line.rstrip())\nPY\n"]
[118.795193, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re,collections,math\r\n\u001b[?2004l\r\u001b[?2004h> num=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None;x=y=0.;z=None; layers=collections.defaultdict(list); allseg=[]\r\n\u001b[?2004l\r\u001b[?2004h> for raw in open('/app/text.gcode',errors='ignore'):\r\n\u001b[?2004l\r\u001b[?2004h>  s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m:\r\n\u001b[?2004l\r\u001b[?2004h>   v=int(m.group(1)); obj=v if v>=0 else None; continue\r\n\u001b[?2004l\r\u001b[?2004h>  if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\r\n\u001b[?2004l\r\u001b[?2004h>  mx=re.search(r'(?:^|\\s)X('+num+r')',s); my=re.search(r'(?:^|\\s)Y('+num+r')',s); mz=re.search(r'(?:^|\\s)Z('+num+r')',s); me=re.search(r'(?:^|\\s)E('+num+r')',s)\r\n\u001b[?2004l\r\u001b[?2004h>  nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\r\n\u001b[?2004l\r):.1f})')\r\nprint('all',len(allseg),'bbox',min(min(a,c) for a,b,c,d in allseg),max(max(a,c) for a,b,c,d in allseg),min(min(b,d) for a,b,c,d in allseg),max(max(b,d) for a,b,c,d in allseg))\r\n# projection raster\r\nxmin=min(min(a,c) for a,b,"]
