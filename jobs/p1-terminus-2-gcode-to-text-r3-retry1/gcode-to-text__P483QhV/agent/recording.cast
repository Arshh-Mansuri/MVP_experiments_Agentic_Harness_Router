[353.062696, "i", "cat > /tmp/ocr.py <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\ndef make(name,items):\n P2=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in items]\n xs=[q for p in P2 for q in (p[0],p[2])]; ys=[q for p in P2 for q in (p[1],p[3])]\n xa,xb=min(xs),max(xs); ya,yb=min(ys),max(ys); W,H=1800,360; pix=[[0]*W for _ in range(H)]\n for a,b,c,d in P2:\n  n=max(2,int(math.hypot(c-a,d-b)*30))\n  for k in range(n+1):\n   t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t; ix=round((X-xa)/(xb-xa)*(W-1)); iy=H-1-round((Y-ya)/(yb-ya)*(H-1))\n   if 0<=ix<W and 0<=iy<H: pix[iy][ix]=1\n with open('/tmp/'+name+'.pbm','w') as f:\n  f.write(f'P1\\n{W} {H}\\n')\n  for r in pix:f.write(' '.join(map(str,r))+'\\n')\nzs=[max(a[2],b[2]) for a,b in seg]; cutoff=sorted(zs)[int(len(zs)*.85)]\nmake('all',seg); make('top',[q for q,z in zip(seg,zs) if z>=cutoff])\nPY\npython3 /tmp/ocr.py\nfor f in /tmp/all /tmp/top; do for p in 6 7 11 13; do echo \"=== $f psm$p ===\"; tesseract \"$f.pbm\" stdout"]
[353.063766, "o", "cat > /tmp/ocr.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import contextlib,io,math\r\n\u001b[?2004l\r\u001b[?2004h> with contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.063858, "i", " --psm $p 2>/dev/null; done; done\n"]
