[381.316724, "i", "cat > /tmp/ocr2.py <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\ndef make(name,items):\n P2=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in items]\n xs=[q for p in P2 for q in (p[0],p[2])]; ys=[q for p in P2 for q in (p[1],p[3])]\n xa,xb=min(xs),max(xs); ya,yb=min(ys),max(ys); scale=12; W=round((xb-xa)*scale)+40; H=round((yb-ya)*scale)+40; pix=[[0]*W for _ in range(H)]\n for a,b,c,d in P2:\n  n=max(2,int(math.hypot(c-a,d-b)*scale*2))\n  for k in range(n+1):\n   t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t; ix=20+round((X-xa)/(xb-xa)*(W-40)); iy=H-20-round((Y-ya)/(yb-ya)*(H-40))\n   if 0<=ix<W and 0<=iy<H: pix[iy][ix]=1\n with open('/tmp/'+name+'.pbm','w') as f:\n  f.write(f'P1\\n{W} {H}\\n'); [f.write(' '.join(map(str,r))+'\\n') for r in pix]\nzs=[max(a[2],b[2]) for a,b in seg]; cutoff=sorted(zs)[int(len(zs)*.85)]\nmake('proper',seg); make('propertop',[q for q,z in zip(seg,zs) if z>=cutoff])\nPY\npython3 /tmp/ocr2.py\nfor f in /tmp/proper /tmp/prope"]
[381.317228, "i", "rtop; do for p in 6 7 13; do echo \"=== $f psm$p ===\"; tesseract \"$f.pbm\" stdout --psm $p 2>/dev/null; done; done\n"]
