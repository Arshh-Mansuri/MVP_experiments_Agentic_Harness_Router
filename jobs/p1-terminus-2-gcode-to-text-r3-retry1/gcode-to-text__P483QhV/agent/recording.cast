[162.594309, "i", "v,dot(v,[sum(M[i][j]*v[j] for j in range(3)) for i in range(3)])\nv1,l=eig(C,[1,1,1]); M=[[C[i][j]-l*v1[i]*v1[j] for j in range(3)] for i in range(3)]; v2,l=eig(M,[1,-1,0])\ndef pr(p,v): return dot([p[i]-mean[i] for i in range(3)],v)\nP=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in seg]\nx0=min(min(a,c) for a,b,c,d in P); x1=max(max(a,c) for a,b,c,d in P); y0=min(min(b,d) for a,b,c,d in P); y1=max(max(b,d) for a,b,c,d in P)\nW,H=360,100; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*8))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\ncols=[sum(g[y][x] for y in range(H)) for x in range(W)]\n# glyph runs, allowing small internal gaps but splitting long gaps\nruns=[]; start=None; gap=0\nfor i,c in enumerate(cols+[0]):\n if c: \n  if start is None:start=i\n  gap=0\n elif start is not None:\n  gap+=1\n  if gap>=5:\n   runs.append((start,i-gap+1)); start=None;gap=0\nprint('glyph "]
