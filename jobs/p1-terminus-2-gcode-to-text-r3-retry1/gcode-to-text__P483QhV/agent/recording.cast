[147.239991, "i", "python3 - <<'PY'\nimport re,math\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None; x=y=z=0.; seg=[]; pts=[]\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\n if m:\n  v=int(m.group(1)); obj=v if v>=0 else None; continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n def get(ch,old):\n  q=re.search(r'(?:^|\\s)'+ch+'('+num+r')',s); return float(q.group(1)) if q else old\n nx,ny,nz=get('X',x),get('Y',y),get('Z',z); q=re.search(r'(?:^|\\s)E('+num+r')',s)\n if q and float(q.group(1))>0 and (nx!=x or ny!=y or nz!=z):\n  seg.append(((x,y,z),(nx,ny,nz))); pts += [(x,y,z),(nx,ny,nz)]\n x,y,z=nx,ny,nz\nmean=[sum(p[j] for p in pts)/len(pts) for j in range(3)]\nC=[[sum((p[i]-mean[i])*(p[j]-mean[j]) for p in pts) for j in range(3)] for i in range(3)]\ndef norm(v): return math.sqrt(sum(a*a for a in v))\ndef mat(v): return [sum(C[i][j]*v[j] for j in range(3)) for i in range(3)]\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef eig(M, start):\n v=start[:]\n for _ in range(300):\n  w="]
[147.240108, "i", "[sum(M[i][j]*v[j] for j in range(3)) for i in range(3)]; n=norm(w)\n  if not n: break\n  v=[a/n for a in w]\n return v, dot(v,[sum(M[i][j]*v[j] for j in range(3)) for i in range(3)])\nv1,l1=eig(C,[1,1,1])\nM=[[C[i][j]-l1*v1[i]*v1[j] for j in range(3)] for i in range(3)]\nv2,l2=eig(M,[1,-1,0])\nprint('eigenvalues',round(l1,2),round(l2,2)); print('directions',v1,v2)\ndef proj(p,v): return dot([p[i]-mean[i] for i in range(3)],v)\nP=[(proj(a,v1),proj(a,v2),proj(b,v1),proj(b,v2)) for a,b in seg]\nx0=min(min(a,c) for a,b,c,d in P); x1=max(max(a,c) for a,b,c,d in P); y0=min(min(b,d) for a,b,c,d in P); y1=max(max(b,d) for a,b,c,d in P)\nW,H=180,60; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*5))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t; ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\nfor r in g: print(''.join('##' if v else '  ' for v in r).rstrip())\nPY\n"]
