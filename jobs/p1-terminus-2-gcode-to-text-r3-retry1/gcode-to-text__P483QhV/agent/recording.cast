[209.724875, "i", "python3 - <<'PY'\n# load the working parser/projection without its large render\nsrc=open('/tmp/glyphs.py').read().split('cols=[')[0]\nexec(src)\nW,H=180,48; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*7))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\nfor part,(a,b) in enumerate([(0,48),(40,88),(80,128),(120,180)],1):\n print(f'===== PART {part} columns {a}:{b} =====')\n for y in range(H): print(''.join('█' if g[y][x] else ' ' for x in range(a,b)).rstrip())\nPY\n"]
[209.727101, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
