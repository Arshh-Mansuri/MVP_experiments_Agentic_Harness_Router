[427.516172, "i", "cat > /tmp/ocr4.py <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\nP2=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2)) for a,b in seg]\nxs=[q for p in P2 for q in (p[0],p[2])]; ys=[q for p in P2 for q in (p[1],p[3])]; xa,xb=min(xs),max(xs);ya,yb=min(ys),max(ys); S=18; W=round((xb-xa)*S)+60;H=round((yb-ya)*S)+60\nbase=[[0]*W for _ in range(H)]\nfor a,b,c,d in P2:\n n=max(2,int(math.hypot(c-a,d-b)*S*2))\n for k in range(n+1):\n  t=k/n;X=a+(c-a)*t;Y=b+(d-b)*t;ix=30+round((X-xa)/(xb-xa)*(W-60));iy=H-30-round((Y-ya)/(yb-ya)*(H-60))\n  if 0<=ix<W and 0<=iy<H:base[iy][ix]=1\nvariants={'normal':base,'flipx':[r[::-1] for r in base],'flipy':base[::-1],'rot180':[r[::-1] for r in base[::-1]]}\nfor name,img in variants.items():\n with open('/tmp/v_'+name+'.pbm','w') as f:\n  f.write(f'P1\\n{W} {H}\\n');\n  for r in img:f.write(' '.join(map(str,r))+'\\n')\nPY\npython3 /tmp/ocr4.py\nfor f in /tmp/v_*; do for p in 6 7 13; do printf '%s psm%s: ' \"$f\" \"$p\"; tesseract "]
[427.517439, "o", "cat > /tmp/ocr4.py <<'PY'\r\n\u001b[?2004l\r"]
