[44.460445, "i", "python3 - <<'PY'\nimport re\nobj=None;x=y=0.; seg=[]\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip()\n m=re.match(r'M486 S(-?\\d+)',s)\n if m:\n  v=int(m.group(1))\n  if v>=0: obj=v\n  else: obj=None\n  continue\n if not (obj==0 and s.startswith(('G0 ','G1 '))): continue\n mx=re.search(r'(?:^|\\s)X(-?\\d+(?:\\.\\d+)?)',s); my=re.search(r'(?:^|\\s)Y(-?\\d+(?:\\.\\d+)?)',s)\n me=re.search(r'(?:^|\\s)E(-?\\d+(?:\\.\\d+)?)',s)\n nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\n if me and float(me.group(1))>0 and (mx or my): seg.append((x,y,nx,ny))\n x,y=nx,ny\nprint('segments',len(seg))\nif not seg: raise SystemExit\nxmin=min(min(a,c) for a,b,c,d in seg); xmax=max(max(a,c) for a,b,c,d in seg); ymin=min(min(b,d) for a,b,c,d in seg); ymax=max(max(b,d) for a,b,c,d in seg)\nprint('bounds',xmin,xmax,ymin,ymax)\nW,H=180,60; g=[[' ']*W for _ in range(H)]\nfor a,b,c,d in seg:\n n=max(2,int((((c-a)**2+(d-b)**2)**.5)/.08))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=min(W-1,max(0,round((xx-xmin)/"]
[44.460685, "i", "(xmax-xmin)*(W-1))))\n  iy=min(H-1,max(0,H-1-round((yy-ymin)/(ymax-ymin)*(H-1))))\n  g[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\n"]
