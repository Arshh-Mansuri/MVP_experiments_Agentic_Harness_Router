[299.010509, "i", "python3 - <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\n# rasterize projected all-layer paths into a moderate bitmap\nW,H=240,48; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*10))\n for k in range(n+1):\n  t=k/n; X=a+(c-a)*t; Y=b+(d-b)*t; ix=round((X-x0)/(x1-x0)*(W-1)); iy=H-1-round((Y-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\n# print compressed horizontal bands, one glyph region at a time; overlap windows of 24 px\nfor a in range(0,W,24):\n print('\\n=== X',a,'-',min(a+24,W),'===')\n for yy in range(0,H,2):\n  print(''.join('█' if any(g[j][x] for j in range(yy,min(yy+2,H))) else ' ' for x in range(a,min(a+24,W))).rstrip())\nPY\n"]
