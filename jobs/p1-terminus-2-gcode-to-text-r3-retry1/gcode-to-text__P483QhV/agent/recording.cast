[196.765631, "i", "python3 - <<'PY'\nexec(open('/tmp/glyphs.py').read().split(\"cols=[\")[0])\nW,H=180,48; g=[[0]*W for _ in range(H)]\nfor a,b,c,d in P:\n n=max(2,int(math.hypot(c-a,d-b)*7))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=round((xx-x0)/(x1-x0)*(W-1)); iy=H-1-round((yy-y0)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\ncols=[sum(g[y][x] for y in range(H)) for x in range(W)]\nprint('column density:')\nprint(''.join(' ' if c==0 else '.' if c<4 else '+' if c<12 else '#' for c in cols))\n# split on gaps >= 2, then merge tiny runs\nruns=[]; s=None; gap=0\nfor i,c in enumerate(cols+[0]):\n if c:\n  if s is None:s=i\n  gap=0\n elif s is not None:\n  gap+=1\n  if gap>=2:\n   runs.append((s,i-gap+1));s=None;gap=0\nprint('runs',runs)\nfor ri,(a,b) in enumerate(runs):\n print('\\nCHAR',ri,a,b)\n # crop y to ink and render with one terminal char per pixel, doubled vertically\n ys=[y for y in range(H) if any(g[y][x] for x in range(a,b))]\n if not ys:continue\n ya,yb=max(0,min(ys)-1),min(H,max(ys)+2)\n for y in range(ya,yb): print("]
