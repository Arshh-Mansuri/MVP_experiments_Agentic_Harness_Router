[32.130001, "i", "python3 - <<'PY'\nimport re\np='/app/text.gcode'\nobj=None;x=y=0.0; paths=[]; cur=[]\nfor raw in open(p,errors='ignore'):\n s=raw.strip()\n if s.startswith('M486 S'):\n  m=re.match(r'M486 S(-?\\d+)',s); obj=int(m.group(1)) if m else obj\n  if obj!=0 and cur: paths.append(cur); cur=[]\n  continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n mx=re.search(r'\\bX(-?\\d+(?:\\.\\d+)?)',s); my=re.search(r'\\bY(-?\\d+(?:\\.\\d+)?)',s)\n me=re.search(r'\\bE(-?\\d+(?:\\.\\d+)?)',s)\n nx=float(mx.group(1)) if mx else x; ny=float(my.group(1)) if my else y\n if me and float(me.group(1))>0 and (mx or my): cur.append((x,y,nx,ny))\n x,y=nx,ny\nif cur: paths.append(cur)\nseg=[z for q in paths for z in q]\nprint('paths',len(paths),'segments',len(seg))\nprint('bounds',min(min(a,c) for a,b,c,d in seg),max(max(a,c) for a,b,c,d in seg),min(min(b,d) for a,b,c,d in seg),max(max(b,d) for a,b,c,d in seg))\n# rasterize segments into 120x40 ascii\nxmin=min(min(a,c) for a,b,c,d in seg); xmax=max(max(a,c) for a,b,c,d in seg); ymin=min(min(b,d) for a,b,c,d in"]
[32.130106, "i", " seg); ymax=max(max(b,d) for a,b,c,d in seg)\nW,H=160,50; grid=[[' ']*W for _ in range(H)]\nfor a,b,c,d in seg:\n for k in range(max(2,int(((c-a)**2+(d-b)**2)**.5/0.12))):\n  t=k/max(1,int(((c-a)**2+(d-b)**2)**.5/0.12)); xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=min(W-1,max(0,int((xx-xmin)/(xmax-xmin)* (W-1)))); iy=min(H-1,max(0,H-1-int((yy-ymin)/(ymax-ymin)*(H-1))))\n  grid[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in grid))\nPY\n"]
