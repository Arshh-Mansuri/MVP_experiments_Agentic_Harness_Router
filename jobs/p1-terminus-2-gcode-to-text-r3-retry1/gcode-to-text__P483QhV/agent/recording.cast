[134.834471, "i", "python3 - <<'PY'\nimport re,math\ntry:\n import numpy as np\nexcept Exception as e:\n print('NO_NUMPY',e); raise SystemExit\nnum=r'-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)'; obj=None;x=y=z=0.; pts=[]\nfor raw in open('/app/text.gcode',errors='ignore'):\n s=raw.strip(); m=re.match(r'M486 S(-?\\d+)',s)\n if m:\n  v=int(m.group(1)); obj=v if v>=0 else None; continue\n if obj!=0 or not s.startswith(('G0 ','G1 ')): continue\n def get(ch,old):\n  q=re.search(r'(?:^|\\s)'+ch+'('+num+r')',s); return float(q.group(1)) if q else old\n nx,ny,nz=get('X',x),get('Y',y),get('Z',z)\n q=re.search(r'(?:^|\\s)E('+num+r')',s)\n if q and float(q.group(1))>0 and (nx!=x or ny!=y or nz!=z): pts += [(x,y,z),(nx,ny,nz)]\n x,y,z=nx,ny,nz\nA=np.array(pts); C=A-A.mean(0); cov=C.T@C; val,vec=np.linalg.eigh(cov); order=np.argsort(val)[::-1]; vec=vec[:,order]\nprint('eigenvalues',val[order]); print('directions',vec[:,0],vec[:,1],vec[:,2])\nP=C@vec[:,:2];\n# orient axes so first coordinate increases left-right and second bottom-top\nxmin,xmax=P[:,0].min(),P[:,0].max(); ymin,ymax=P"]
[134.835397, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re,math\r\n\u001b[?2004l\r"]
[134.835439, "i", "[:,1].min(),P[:,1].max(); print('projected bounds',xmin,xmax,ymin,ymax)\nW,H=180,60; g=[[0]*W for _ in range(H)]\nfor i in range(0,len(P)-1,2):\n a,b=P[i]; c,d=P[i+1]; L=math.hypot(c-a,d-b); n=max(2,int(L*4))\n for k in range(n+1):\n  t=k/n; xx=a+(c-a)*t; yy=b+(d-b)*t\n  ix=round((xx-xmin)/(xmax-xmin)*(W-1)); iy=H-1-round((yy-ymin)/(ymax-ymin)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\nfor r in g: print(''.join('██' if v else '  ' for v in r).rstrip())\nPY\n"]
