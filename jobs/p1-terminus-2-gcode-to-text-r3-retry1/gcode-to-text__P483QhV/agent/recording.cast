[398.571537, "i", "cat > /tmp/ocr3.py <<'PY'\nimport contextlib,io,math\nwith contextlib.redirect_stdout(io.StringIO()): exec(open('/tmp/glyphs.py').read().split('cols=[')[0])\nP2=[(pr(a,v1),pr(a,v2),pr(b,v1),pr(b,v2),math.hypot(b[0]-a[0],b[1]-a[1])) for a,b in seg]\nxs=[q for p in P2 for q in (p[0],p[2])]; ys=[q for p in P2 for q in (p[1],p[3])]; xa,xb=min(xs),max(xs);ya,yb=min(ys),max(ys)\nfor variant,keep in [('all',lambda q:True),('long',lambda q:q[4]>.35),('mid',lambda q:.15<q[4]<4)]:\n W=2400; H=round((yb-ya)/(xb-xa)*W)+80; pix=[[0]*W for _ in range(H)]\n for a,b,c,d,L in P2:\n  if not keep((a,b,c,d,L)):continue\n  n=max(2,int(L*20))\n  for k in range(n+1):\n   t=k/n;X=a+(c-a)*t;Y=b+(d-b)*t;ix=40+round((X-xa)/(xb-xa)*(W-80));iy=H-40-round((Y-ya)/(yb-ya)*(H-80))\n   if 0<=ix<W and 0<=iy<H:pix[iy][ix]=1\n with open('/tmp/'+variant+'.pbm','w') as f:\n  f.write(f'P1\\n{W} {H}\\n');\n  for r in pix:f.write(' '.join(map(str,r))+'\\n')\nPY\npython3 /tmp/ocr3.py\nfor f in /tmp/all /tmp/long /tmp/mid; do for p in 6 7 13; do echo ===$f-$p===; tesseract"]
[398.573599, "i", " $f.pbm stdout --psm $p -c tessedit_char_whitelist='ABCDEFGHIJKLMNOPQRSTUVWXYZ ' 2>/dev/null; done; done\n"]
