[106.90915, "o", "               (begin (define-binding (car (car bs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.909299, "o", "                                      (meval (car (cdr (car bs))) env) ne)\r\n\u001b[?2004l\r\u001b[?2004h>                       (do (cdr bs)))))\r\n\u001b[?2004l\r"]
[106.909513, "o", "\u001b[?2004h>          (do bs) (eval-sequence body ne))))\r\n\u001b[?2004l\r\u001b[?2004h>     ((eq? (car x) 'let*)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.909664, "o", "     (meval (cons (list3 'lambda (bindings->names (car (cdr x)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.909686, "o", "                         (cons (car (cdr (cdr x))) '()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.90982, "o", "                  (bindings->values (car (cdr x)) env)) env))\r\n"]
[106.90987, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.909965, "o", "    ((eq? (car x) 'cond) (eval-cond (cdr x) env))\r\n\u001b[?2004l\r"]
[106.909986, "o", "\u001b[?2004h> "]
[106.910057, "o", "    ((eq? (car x) 'and)\r\n\u001b[?2004l\r"]
[106.91009, "o", "\u001b[?2004h> "]
[106.910157, "o", "     (if (null? (cdr x)) #t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.910183, "o", "         (if (truth (meval (car (cdr x)) env))\r\n\u001b[?2004l\r"]
[106.910353, "o", "\u001b[?2004h>              (meval (cons 'and (cdr (cdr x))) env) #f)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.91068, "o", "    ((eq? (car x) 'or)\r\n\u001b[?2004l\r\u001b[?2004h>      (if (null? (cdr x)) #f\r\n\u001b[?2004l\r\u001b[?2004h>          (let ((v (meval (car (cdr x)) env)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.910728, "o", "           (if (truth v) v (meval (cons 'or (cdr (cdr x))) env)))))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.910936, "o", "    (else (mapply (meval (car x) env) (eval-list (cdr x) env)))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.910964, "o", ";; Host interp.py supplies read, but target source is read from a file.  Its\r\n"]
[106.912336, "o", "\u001b[?2004l\r\u001b[?2004h> ;; `fread` primitive returns a complete parsed expression for file handles in\r\n\u001b[?2004l\r\u001b[?2004h> ;; this assignment's implementation; repeatedly call it until EOF.\r\n\u001b[?2004l\r\u001b[?2004h> (define (run-file filename env)\r\n\u001b[?2004l\r\u001b[?2004h>   (let ((f (fopen filename \"r\")))\r\n\u001b[?2004l\r\u001b[?2004h>     (define (go)\r\n\u001b[?2004l\r\u001b[?2004h>       (let ((x (fread f)))\r\n\u001b[?2004l\r\u001b[?2004h>         (if x (begin (meval x env) (go)) #f)))\r\n\u001b[?2004l\r\u001b[?2004h>     (go) (fclose f)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ;; First line is the target path. `read` consumes that line as a Scheme atom.\r\n\u001b[?2004l\r\u001b[?2004h> (define target (read))"]
[106.9125, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.912598, "o", "(run-file target (cons (make-frame '()) '()))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[106.935131, "o", "\u001b[?2004hroot@31ff2218c56f:/app# "]
[106.935404, "o", "python3 interp.py eval.scm < /dev/null\r\n\u001b[?2004l\r"]
[107.099349, "o", "Unexpected error: EOF when reading a line\r\n"]
[107.108512, "o", "\u001b[?2004hroot@31ff2218c56f:/app# "]
