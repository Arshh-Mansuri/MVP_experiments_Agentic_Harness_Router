[106.878909, "i", "lauses) env)))))\n\n(define (meval x env)\n  (cond\n    ((number? x) x)\n    ((string? x) x)\n    ((boolean? x) x)\n    ((symbol? x) (lookup x env))\n    ((null? x) '())\n    ((eq? (car x) 'quote) (car (cdr x)))\n    ((eq? (car x) 'if)\n     (if (truth (meval (car (cdr x)) env))\n         (meval (car (cdr (cdr x))) env)\n         (if (null? (cdr (cdr (cdr x)))) #f\n             (meval (car (cdr (cdr (cdr x)))) env))))\n    ((eq? (car x) 'begin) (eval-sequence (cdr x) env))\n    ((eq? (car x) 'progn) (eval-sequence (cdr x) env))\n    ((eq? (car x) 'lambda) (make-closure (car (cdr x)) (cdr (cdr x)) env))\n    ((eq? (car x) 'define)\n     (if (pair? (car (cdr x)))\n         (define-binding (car (car (cdr x)))\n                         (make-closure (cdr (car (cdr x))) (cdr (cdr x)) env) env)\n         (define-binding (car (cdr x)) (meval (car (cdr (cdr x))) env) env)))\n    ((eq? (car x) 'set!)\n     (set-binding (car (cdr x)) (meval (car (cdr (cdr x))) env) env))\n    ((eq? (car x) 'let)\n     (let ((bs (car (cdr x))) (body (cdr (cdr x)"]
