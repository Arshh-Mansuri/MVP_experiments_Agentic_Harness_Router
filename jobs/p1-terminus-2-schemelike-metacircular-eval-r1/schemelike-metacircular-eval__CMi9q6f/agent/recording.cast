[106.872441, "i", "cat > eval.scm <<'EOF'\n;; Metacircular evaluator for the language implemented by interp.py.\n;; The host primitives used here are cons/car/cdr/null?/pair?, eq?, equal?,\n;; read, display, newline, fopen, fread and fclose.\n\n(define (list1 a) (cons a '()))\n(define (list2 a b) (cons a (cons b '())))\n(define (list3 a b c) (cons a (cons b (cons c '()))))\n(define (list4 a b c d) (cons a (cons b (cons c (cons d '())))))\n\n(define (append x y)\n  (if (null? x) y (cons (car x) (append (cdr x) y))))\n\n(define (reverse x)\n  (define (loop x r)\n    (if (null? x) r (loop (cdr x) (cons (car x) r))))\n  (loop x '()))\n\n;; Read all characters from an open host file.  fread returns one character\n;; (or a false value at EOF) in the supplied implementation.\n(define (read-file f)\n  (define (go r)\n    (let ((c (fread f)))\n      (if c (go (cons c r)) (reverse r))))\n  (go '()))\n\n(define (chars->string cs)\n  (if (null? cs) \"\"\n      (cons-string (car cs) (chars->string (cdr cs)))))\n\n;; Strings in the host language are atomic, so construct so"]
[106.876684, "o", "cat > eval.scm <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> ;; Metacircular evaluator for the language implemented by interp.py.\r\n\u001b[?2004l\r\u001b[?2004h> ;; The host primitives used here are cons/car/cdr/null?/pair?, eq?, equal?,\r\n\u001b[?2004l\r\u001b[?2004h> ;; read, display, newline, fopen, fread and fclose.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.876863, "i", "urce text by\n;; repeatedly using the host's fdisplay-like behavior is not available.\n;; Instead, source is read one expression at a time through the host `read`\n;; only for stdin; target files are loaded with a host helper below.\n\n;; Environment frames are (frame bindings parent), bindings are (name . value).\n(define (make-frame parent) (list2 'frame (cons '() parent)))\n(define (frame-bindings f) (car (cdr f)))\n(define (frame-parent f) (cdr (cdr f)))\n(define (set-frame-bindings! f b) (set-car! (cdr f) b))\n\n(define (find-binding name env)\n  (if (null? env) #f\n      (let ((bs (frame-bindings (car env))))\n        (define (scan bs)\n          (if (null? bs) #f\n              (if (eq? name (car (car bs))) (car bs)\n                  (scan (cdr bs)))))\n        (let ((hit (scan bs)))\n          (if hit hit (find-binding name (cdr env)))))))\n\n(define (lookup name env)\n  (let ((b (find-binding name env)))\n    (if b (cdr b) (error \"unbound variable\" name))))\n\n(define (define-binding name value env)\n  (let ((f (car env)))\n "]
[106.87691, "o", "> (define (list1 a) (cons a '()))\r\n\u001b[?2004l\r\u001b[?2004h> (define (list2 a b) (cons a (cons b '())))\r\n\u001b[?2004l\r\u001b[?2004h> (define (list3 a b c) (cons a (cons b (cons c '()))))\r\n\u001b[?2004l\r\u001b[?2004h> (define (list4 a b c d) (cons a (cons b (cons c (cons d '())))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (append x y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.876925, "i", "   (set-frame-bindings! f (cons (cons name value) (frame-bindings f)))\n    value))\n\n(define (set-binding name value env)\n  (let ((b (find-binding name env)))\n    (if b (begin (set-cdr! b value) value)\n        (error \"unbound variable\" name))))\n\n(define (truth x) (if (eq? x #f) #f #t))\n\n;; Tagged closures: (closure parameters body environment).\n(define (closure? x) (and (pair? x) (eq? (car x) 'closure)))\n(define (make-closure p b e) (list4 'closure p b e))\n(define (closure-params x) (car (cdr x)))\n(define (closure-body x) (car (cdr (cdr x))))\n(define (closure-env x) (car (cdr (cdr (cdr x)))))\n\n(define (eval-sequence body env)\n  (if (null? body) #f\n      (if (null? (cdr body)) (meval (car body) env)\n          (begin (meval (car body) env) (eval-sequence (cdr body) env)))))\n\n(define (bind-params ps as e)\n  (if (null? ps) e\n      (bind-params (cdr ps) (cdr as)\n                   (cons (make-frame (car e)) '()))))\n\n;; Application is kept separate so primitive procedures supplied by interp.py\n;; can be invoked norm"]
