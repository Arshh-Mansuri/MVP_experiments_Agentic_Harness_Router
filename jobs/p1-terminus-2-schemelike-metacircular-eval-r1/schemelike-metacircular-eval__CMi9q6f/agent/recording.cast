[106.878571, "i", "ally. User closures are represented by tagged lists.\n(define (mapply p args)\n  (if (closure? p)\n      (let ((new (cons (make-frame (closure-env p)) '())))\n        (define (put ps as)\n          (if (null? ps) #t\n              (begin (define-binding (car ps) (car as) new)\n                     (put (cdr ps) (cdr as)))))\n        (put (closure-params p) args)\n        (eval-sequence (closure-body p) new))\n      (apply p args)))\n\n(define (eval-list xs env)\n  (if (null? xs) '()\n      (cons (meval (car xs) env) (eval-list (cdr xs) env))))\n\n(define (bindings->names bs)\n  (if (null? bs) '() (cons (car (car bs)) (bindings->names (cdr bs)))))\n(define (bindings->values bs env)\n  (if (null? bs) '() (cons (meval (car (cdr (car bs))) env)\n                              (bindings->values (cdr bs) env))))\n\n(define (eval-cond clauses env)\n  (if (null? clauses) #f\n      (let ((cl (car clauses)))\n        (if (or (eq? (car cl) 'else) (truth (meval (car cl) env)))\n            (eval-sequence (cdr cl) env)\n            (eval-cond (cdr c"]
