[152.455131, "i", "python3 - <<'PY'\ns=open('eval.scm').read().splitlines(); n=0\nfor i,l in enumerate(s,1):\n    in_str=False; esc=False\n    for c in l:\n        if c=='\"' and not esc: in_str=not in_str\n        if not in_str:\n            if c=='(': n+=1\n            elif c==')': n-=1\n        esc=(c=='\\\\' and not esc)\n    if n<0: print('negative at',i,l); break\nprint('final balance',n)\nPY\nnl -ba eval.scm | sed -n '90,155p'\n"]
