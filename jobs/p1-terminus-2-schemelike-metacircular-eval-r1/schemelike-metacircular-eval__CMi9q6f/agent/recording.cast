[106.879376, "i", "om a file.  Its\n;; `fread` primitive returns a complete parsed expression for file handles in\n;; this assignment's implementation; repeatedly call it until EOF.\n(define (run-file filename env)\n  (let ((f (fopen filename \"r\")))\n    (define (go)\n      (let ((x (fread f)))\n        (if x (begin (meval x env) (go)) #f)))\n    (go) (fclose f)))\n\n;; First line is the target path. `read` consumes that line as a Scheme atom.\n(define target (read))\n(run-file target (cons (make-frame '()) '()))\nEOF\npython3 interp.py eval.scm < /dev/null\n"]
