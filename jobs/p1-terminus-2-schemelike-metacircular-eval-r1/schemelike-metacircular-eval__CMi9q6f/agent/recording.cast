[15.712456, "i", "cat test/README.md; for f in test/calculator.scm test/01-factorial.scm test/03-list-operations.scm test/04-higher-order.scm test/05-simple-io.scm test/06-interactive-io.scm test/08-progn-sequencing.scm test/10-advanced-features.scm; do echo \"### $f\"; cat \"$f\"; done\n"]
