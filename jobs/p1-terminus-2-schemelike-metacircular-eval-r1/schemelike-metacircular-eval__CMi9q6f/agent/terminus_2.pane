(define (four a b c d) (h-cons a (h-cons b (h-cons c (h-cons d '())))))

;; A frame is (bindings . parent-environment); an environment is a list of frames.
(define (new-frame parent) (h-cons '() parent))
(define (bindings f) (h-car f))
(define (parent f) (h-cdr f))
(define (new-env parent) (h-cons (new-frame parent) '()))
(define (add-binding name value env)
  (let ((f (h-car env)))
    (h-set-car! f (h-cons (h-cons name value) (bindings f))) value))

(define (find name env)
  (if (empty? env) #f
      (let ((bs (bindings (h-car env))))
        (define (scan bs)
          (if (empty? bs) #f
              (if (h-eq? name (h-car (h-car bs))) (h-car bs)
                  (scan (h-cdr bs)))))
        (let ((b (scan bs)))
          (if b b (find name (h-cdr env)))))))
(define (lookup name env)
  (let ((b (find name env))) (if b (h-cdr b) #f)))
(define (assign name value env)
  (let ((b (find name env))) (if b (begin (h-set-cdr! b value) value) value)))

(define (closure p body env) (four 'closure p body env))
(define (closure? x) (and (h-pair? x) (h-eq? (h-car x) 'closure)))
