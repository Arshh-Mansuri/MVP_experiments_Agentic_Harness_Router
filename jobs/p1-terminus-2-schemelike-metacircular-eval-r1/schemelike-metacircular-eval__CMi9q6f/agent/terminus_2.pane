(newline)

;; Reverse a list
(define (reverse lst)
  (define (reverse-iter lst acc)
    (if (null? lst)
        acc
        (reverse-iter (cdr lst) (cons (car lst) acc))))
  (reverse-iter lst '()))

;; Reversed list
(display (reverse lst))
(newline)

;; Map function
