[?2004hroot@68fc7ec77741:/app# python3 - <<'PY'
[?2004l[?2004h> p='/app/vm.js';s=open(p).read()
[?2004l[?2004h> # Add a broad SPECIAL3 handler before the normal opcode switch default.
[?2004l[?2004h> old="else {let v=(op===12||op===13)?imm:(op===14?imm:(sim));switch(op){"
[?2004l[?2004h> new="""else if(op===31){
[?2004l[?2004h>   // SPECIAL3: support common MIPS32r2 bitfield/CPU-register operations.
[?2004l[?2004h>   let fn3=ins&63;
[?2004l[?2004h>   if(fn3===32){ R[rt]=0; }                 // rdhwr: cycle/count style registers are virtualized
[?2004l[?2004h>   else if(fn3===0){ R[rd]=(B<<sh)|(B>>>(32-sh)); }
[?2004l[?2004h>   else if(fn3===4){ R[rd]=(B>>>sh)|(B<<(32-sh)); }
[?2004l[?2004h>   else if(fn3===16){ R[rd]=(B & ((1<<(sh+1))-1)); }
[?2004l[?2004h>   else if(fn3===20){ R[rd]=(B>>>sh); }
[?2004l[?2004h>   else { throw Error('SPECIAL3 '+fn3.toString(16)+' ins '+ins.toString(16)+' pc '+at.toString(16)); }
[?2004l[?2004h> }
[?2004l[?2004h> else {let v=(op===12||op===13)?imm:(op===14?imm:(sim));switch(op){"""
[?2004l[?2004h> if old not in s: raise SystemExit('pattern missing')
[?2004l[?2004h> s=s.replace(old,new,1)
[?2004l[?2004h> # Keep only minimal initial tracing.
[?2004l[?2004h> s=s.replace("if(steps<80) console.error('T',steps,pc.toString(16),'sp',R[29].toString(16),'ra',R[31].toString(16),'a0',R[4]);", "if(steps<5) console.error('T',steps,pc.toString(16));")
[?2004l[?2004h> open(p,'w').write(s)
[?2004l[?2004h> PY
[?2004l[?2004hroot@68fc7ec77741:/app# rm -f /tmp/frame.bmp
