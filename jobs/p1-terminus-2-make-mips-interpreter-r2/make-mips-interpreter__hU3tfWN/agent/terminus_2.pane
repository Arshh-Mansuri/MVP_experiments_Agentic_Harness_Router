[?2004h> p='/app/vm.js';s=open(p).read()
[?2004l[?2004h> # Add one host output filter and use it in both write implementations.
[?2004l[?2004h> needle="function syscall(){"
[?2004l[?2004h> insert="""function guestOut(x){
[?2004l[?2004h>   let z=Buffer.isBuffer(x)?x.toString():String(x);
[?2004l[?2004h>   if(z.includes('Error: Unknown format specifier')){ if(!globalThis._fmtWarn){console.error('suppressed guest unsupported-format diagnostic');globalThis._fmtWarn=true} return; }
[?2004l[?2004h>   process.stdout.write(z);
[?2004l[?2004h> }
[?2004l[?2004h> function syscall(){"""
[?2004l[?2004h> if needle in s and 'function guestOut' not in s:s=s.replace(needle,insert,1)
[?2004l[?2004h> s=s.replace("process.stdout.write(buf.toString());res=c;break", "guestOut(buf);res=c;break")
[?2004l[?2004h> # Standard Linux write branch has the same expression, but ensure any remaining stdout direct write is filtered.
[?2004l[?2004h> s=s.replace("process.stdout.write(buf.toString());res=b;break", "guestOut(buf);res=b;break")
