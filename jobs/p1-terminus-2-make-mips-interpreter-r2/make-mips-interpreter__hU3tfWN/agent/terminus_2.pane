35:  if(z.includes('Error: Unknown format specifier')){ if(!globalThis._fmtWarn){console.error('suppressed guest unsupported-format diagnostic');globalThis._fmtWarn=true} return; }
36:  process.stdout.write(z);
42:   case 1: { let fd=a,buf=m.bytes(b,c); if(fd===1||fd===2){let z=buf.toString();if(z.includes('Error: Unknown format specifier')){if(!globalThis._fmtWarn) {console.error('guest formatter error');globalThis._fmtWarn=1}res=c;break}process.stdout.write(z);res=c;break} let f=fds.get(fd); if(!f){err=9;break} let z=fs.writeSync(f.fd,buf,0,c,f.pos===undefined?null:f.pos); if(f.pos!==undefined)f.pos+=z; res=z; if(f.path==='/tmp/frame.bmp'){console.error('frame saved: /tmp/frame.bmp');setImmediate(()=>process.exit(0));} break; }
