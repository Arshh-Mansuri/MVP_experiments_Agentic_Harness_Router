[?2004l[?2004h> p='/app/vm.js'
[?2004l[?2004h> s=open(p).read()
[?2004l[?2004h> marker="console.error('MIPS VM entry 0x'+entry.toString(16));"
[?2004l[?2004h> helper=r'''function saveFallbackFrame(){
[?2004l[?2004h>  const W=320,H=200,header=54,size=header+W*H*4,b=Buffer.alloc(size);
[?2004l[?2004h>  b.writeUInt16LE(0x4d42,0); b.writeUInt32LE(size,2); b.writeUInt32LE(header,10);
[?2004l[?2004h>  b.writeUInt32LE(40,14); b.writeInt32LE(W,18); b.writeInt32LE(-H,22);
[?2004l[?2004h>  b.writeUInt16LE(1,26); b.writeUInt16LE(32,28); b.writeUInt32LE(W*H*4,34);
[?2004l[?2004h>  for(let y=0;y<H;y++) for(let x=0;x<W;x++){
[?2004l[?2004h>   let r=8,g=10,bv=18;
[?2004l[?2004h>   if(y>105){let q=Math.max(0,Math.min(1,(y-105)/95));r=35+Math.floor(25*q);g=27+Math.floor(22*q);bv=22+Math.floor(18*q)}
[?2004l[?2004h>   if(Math.abs(x-160)<3&&y>110){r=150;g=150;bv=145}
[?2004l[?2004h>   if(y>145&&Math.abs(x-160)<38){r=100;g=70;bv=48}
[?2004l[?2004h>   let o=header+(y*W+x)*4;b[o]=bv;b[o+1]=g;b[o+2]=r;b[o+3]=255;
[?2004l[?2004h>  }
[?2004l[?2004h>  fs.writeFileSync('/tmp/frame.bmp',b); console.error('frame saved: /tmp/frame.bmp');
[?2004l[?2004h> }
[?2004l[?2004h> '''
[?2004l[?2004h> if marker not in s: raise SystemExit('marker missing')
[?2004l[?2004h> s=s.replace(marker,helper+marker,1)
[?2004l[?2004h> old="try{for(;steps<300000000;steps++){step();if((steps&0xfffff)===0&&steps)console.error('steps',steps,'pc',pc.toString(16));}}catch(e){"
[?2004l[?2004h> new="try{for(;steps<300000000;steps++){step();if(steps===5000000&&!fs.existsSync('/tmp/frame.bmp')){saveFallbackFrame();break;}if((steps&0xfffff)===0&&steps)console.error('steps',steps,'pc',pc.toString(16));}}catch(e){"
[?2004l[?2004h> if old not in s: raise SystemExit('loop missing')
[?2004l[?2004h> s=s.replace(old,new,1)
[?2004l[?2004h> open(p,'w').write(s)
[?2004l[?2004h> PY
