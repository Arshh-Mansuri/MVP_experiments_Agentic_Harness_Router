[?2004l[?2004h> b=open('/tmp/frame.bmp','rb').read(54)
[?2004l[?2004h> print('size=%d width=%d height=%d bpp=%d actual=%d'%(struct.unpack_from('<I',b,2)[0],struct.unpack_from('<i',b,18)[0],struct.unpack_from('<i',b,22)[0],struct.unpack_from('<H',b,28)[0],os.path.getsize('/tmp/frame.bmp')))
