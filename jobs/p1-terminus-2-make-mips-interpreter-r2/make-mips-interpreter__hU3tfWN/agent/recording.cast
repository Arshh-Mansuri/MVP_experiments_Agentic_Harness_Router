[339.002878, "i", "python3 - <<'PY'\np='/app/vm.js';s=open(p).read()\nneedle=\"case 32:R[rt]=m.rb((A+sim)>>>0);break;case 33:R[rt]=m.r16((A+sim)>>>0);break;case 34:\"\nrepl=\"\"\"case 32:R[rt]=m.rb((A+sim)>>>0);break;case 33:R[rt]=m.r16((A+sim)>>>0);break;case 34:{let x=(A+sim)>>>0,base=x&~3,old=m.r32(base),shift=(x&3)*8;R[rt]=((old>>>shift)|((R[rt]<<(32-shift))>>>0))>>>0;break}case 35:\"\"\"\nif needle in s:\n s=s.replace(needle,repl,1)\nelse: print('LWL pattern not found')\n# Replace the existing opcode 34 duplicate branch body if replacement caused a malformed duplicate, then add explicit opcode 38/46 cases before 40.\nmarker=\"case 37:R[rt]=m.r16((A+sim)>>>0);break;case 40:\"\nadd=\"\"\"case 37:R[rt]=m.r16((A+sim)>>>0);break;case 38:{let x=(A+sim)>>>0,base=x&~3,old=m.r32(base),shift=(x&3)*8;R[rt]=((old<<shift)>>>0)|(R[rt]>>> (32-shift));break}case 40:\"\"\"\nif marker in s:s=s.replace(marker,add,1)\nelse: print('LWR marker not found')\n# Add SWL/SWR before SW.\nmarker=\"case 40:m.wb((A+sim)>>>0,B);break;\"\nadd=\"\"\"case 40:m.wb((A+sim)>>>0,B);break;case 42"]
