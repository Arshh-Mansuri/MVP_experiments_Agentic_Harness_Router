[384.680136, "o", "# Don't let the diagnostic's exit kill the VM; normal exit remains bounded by frame detection/timeout.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.68016, "o", "s=s.replace(\"case 4001: case 4246: process.exit(0);\", \"case 4001: case 4246: res=0; break;\")\r\n\u001b[?2004l\r"]
[384.680279, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[384.821841, "o", "\u001b[?2004hroot@68fc7ec77741:/app# "]
[384.822175, "o", "node --check /app/vm.js; rm -f /tmp/frame.bmp /tmp/vm.log /tmp/vm.out; timeout 30s node /app/vm.js >/tmp/vm.out 2>/tmp/vm.log; echo EXIT:$?; echo '--- stderr ---'; tail -30 /tmp/vm.log; echo '--- stdout ---'; tail -20 /tmp/vm.out; ls -l /tmp/frame.bmp 2>/dev/null || true\r\n\u001b[?2004l\r"]
