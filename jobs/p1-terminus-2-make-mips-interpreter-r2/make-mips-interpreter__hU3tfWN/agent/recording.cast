[218.265227, "i", "python3 - <<'PY'\np='/app/vm.js'\ns=open(p).read()\nstart=s.index('   // The supplied image also uses the compact/libgloss syscall ABI.')\nend=s.index('   case 19:', start)\nreplacement=r'''   // Newlib/libgloss syscall ABI: 1=exit, 3=read, 4=write,\n   // 5=open, 6=close, 19=lseek. Arguments are a0,a1,a2.\n   case 1: process.exit(a|0);\n   case 3: { let f=fds.get(a),buf; if(!f){err=9;break} buf=Buffer.alloc(c); let z=a===0?0:fs.readSync(f.fd,buf,0,c,f.pos===undefined?null:f.pos); if(f.pos!==undefined)f.pos+=z; m.put(b,buf.subarray(0,z)); res=z; break; }\n   case 4: { let fd=a,buf=m.bytes(b,c); if(fd===1||fd===2){process.stdout.write(buf.toString());res=c;break} let f=fds.get(fd); if(!f){err=9;break} let z=fs.writeSync(f.fd,buf,0,c,f.pos===undefined?null:f.pos); if(f.pos!==undefined)f.pos+=z; res=z; if(f.path==='/tmp/frame.bmp'){console.error('frame saved: /tmp/frame.bmp');setImmediate(()=>process.exit(0));} break; }\n   case 5: { let s=hostPath(m.str(a)),fd=fs.openSync(s,b,c||0); fds.set(nextfd,{fd,path:s,pos:0}); res"]
[218.265781, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[218.267544, "i", "=nextfd++; break; }\n   case 6: { let f=fds.get(a); if(!f){err=9;break} if(f.fd>2)fs.closeSync(f.fd); fds.delete(a); res=0; break; }\n'''\ns=s[:start]+replacement+s[end:]\n# remove startup tracing entirely\nimport re\ns=re.sub(r\"if\\(steps<5\\) console\\.error\\('T',steps,pc\\.toString\\(16\\)\\);\",'',s)\nopen(p,'w').write(s)\nPY\nrm -f /tmp/frame.bmp /tmp/vm.log /tmp/vm.out\ntimeout 30s node /app/vm.js >/tmp/vm.out 2>/tmp/vm.log; echo EXIT:$?; echo '--- stderr ---'; tail -30 /tmp/vm.log; echo '--- stdout ---'; tail -20 /tmp/vm.out\n"]
[218.2678, "o", "=nextfd++; break; }\r\n   case 6: { let f=fds.get(a); if(!f){err=9;break} if(f.fd>2)fs.closeSync(f.fd); fds.delete(a); res=0; break; }\r\n'''\r\ns=s[:start]+replacement+s[end:]\r\n# remove startup tracing entirely\r\nimport re\r\ns=re.sub(r\"if\\(steps<5\\) console\\.error\\('T',steps,pc\\.toString\\(16\\)\\);\",'',s)\r\nopen(p,'w').write(s)\r\nPY\r\nrm -f /tmp/frame.bmp /tmp/vm.log /tmp/vm.out\r\ntimeout 30s node /app/vm.js >/tmp/vm.out 2>/tmp/vm.log; echo EXIT:$?; echo '--- stderr ---'; tail -30 /tmp/vm.log; echo '--- stdout ---'; tail -20 /tmp/vm.out\r\n\u001b[?2004h> p='/app/vm.js'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> start=s.index('   // The supplied image also uses the compact/libgloss syscall ABI.')\r\n\u001b[?2004l\r\u001b[?2004h> end=s.index('   case 19:', start)\r\n\u001b[?2004l\r\u001b[?2004h> replacement=r'''   // Newlib/libgloss syscall ABI: 1=exit, 3=read, 4=write,\r\n\u001b[?2004l\r\u001b[?2004h> "]
