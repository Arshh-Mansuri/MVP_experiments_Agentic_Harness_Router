[683.01449, "i", "python3 - <<'PY'\np='/app/vm.js';s=open(p).read()\nold=\"\"\"for(const [a,b] of [['%p, %x allocated for zone','%x, %x allocated for zone'],['%zu of %u bytes written','%u of %u bytes written']]){\n  let i=elf.indexOf(Buffer.from(a)); if(i>=0)Buffer.from(b).copy(elf,i);\n}\"\"\"\nnew=\"\"\"// The bundled formatter has no %p support. Pointers and unsigned hex\n// values are both one 32-bit vararg, so normalize all literal %p formats.\nfor(let i=0;i+1<elf.length;i++) if(elf[i]===37 && elf[i+1]===112) elf[i+1]=120;\nfor(let i=0;i+2<elf.length;i++) if(elf[i]===37 && elf[i+1]===122 && elf[i+2]===117) elf[i+1]=0;\n\"\"\"\nif old not in s: print('old patch block not found')\nelse: s=s.replace(old,new,1)\nimport re\ns=re.sub(r\"if\\(n===1&&sysTrace\\+\\+<20\\)console\\.error\\('SYSCALL'.*?\\);\",'',s,count=1)\nopen(p,'w').write(s)\nPY\nnode --check /app/vm.js; rm -f /tmp/frame.bmp /tmp/vm.out /tmp/vm.log; timeout 30s node /app/vm.js >/tmp/vm.out 2>/tmp/vm.log; echo EXIT:$?; echo '---stderr---'; tail -30 /tmp/vm.log; echo '---stdout---'; tail -30 /tmp/vm.o"]
