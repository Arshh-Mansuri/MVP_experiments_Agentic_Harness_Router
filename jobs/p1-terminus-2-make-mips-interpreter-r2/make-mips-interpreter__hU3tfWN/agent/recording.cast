[714.035414, "i", "if [ -f /tmp/frame.bmp ]; then od -An -tx1 -N32 /tmp/frame.bmp; python3 - <<'PY'\nimport struct,os\nb=open('/tmp/frame.bmp','rb').read(54)\nprint('size=%d width=%d height=%d bpp=%d actual=%d'%(struct.unpack_from('<I',b,2)[0],struct.unpack_from('<i',b,18)[0],struct.unpack_from('<i',b,22)[0],struct.unpack_from('<H',b,28)[0],os.path.getsize('/tmp/frame.bmp')))\nPY\nfi\n"]
