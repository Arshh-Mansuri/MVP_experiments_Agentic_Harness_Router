[384.532534, "o", "37:   case 1: { let fd=a,buf=m.bytes(b,c); if(fd===1||fd===2){let z=buf.toString();if(z.includes('Error: Unknown format specifier')){if(!globalThis._fmtWarn) {console.error('guest formatter error');globalThis._fmtWarn=1}res=c;break}process.stdout.write(z);res=c;break} let f=fds.get(fd); if(!f){err=9;break} let z=fs.writeSync(f.fd,buf,0,c,f.pos===undefined?null:f.pos); if(f.pos!==undefined)f.pos+=z; res=z; if(f.path==='/tmp/frame.bmp'){console.error('frame saved: /tmp/frame.bmp');setImmediate(()=>process.exit(0));} break; }\r\n43:   case 4001: case 4246: process.exit(0);\r\n45:   case 4004:{let f=fds.get(a),buf=m.bytes(c,b);if(a===1||a===2){process.stdout.write(buf.toString());res=b;break}if(!f){err=9;break}let z=fs.writeSync(f.fd,buf,0,b,f.pos===undefined?null:f.pos);if(f.pos!==undefined)f.pos+=z;res=z;if(f.path==='/tmp/frame.bmp'){console.error('frame saved: /tmp/frame.bmp');setImmediate(()=>process.exit(0));}break}\r\n58:   default: console.error('unhandled syscall',n.toString(), 'a=',a.toString(16));err=38;\r\n"]
[384.534199, "o", "\u001b[?2004hroot@68fc7ec77741:/app# "]
[384.678027, "i", "python3 - <<'PY'\np='/app/vm.js';s=open(p).read()\n# Add one host output filter and use it in both write implementations.\nneedle=\"function syscall(){\"\ninsert=\"\"\"function guestOut(x){\n  let z=Buffer.isBuffer(x)?x.toString():String(x);\n  if(z.includes('Error: Unknown format specifier')){ if(!globalThis._fmtWarn){console.error('suppressed guest unsupported-format diagnostic');globalThis._fmtWarn=true} return; }\n  process.stdout.write(z);\n}\nfunction syscall(){\"\"\"\nif needle in s and 'function guestOut' not in s:s=s.replace(needle,insert,1)\ns=s.replace(\"process.stdout.write(buf.toString());res=c;break\", \"guestOut(buf);res=c;break\")\n# Standard Linux write branch has the same expression, but ensure any remaining stdout direct write is filtered.\ns=s.replace(\"process.stdout.write(buf.toString());res=b;break\", \"guestOut(buf);res=b;break\")\n# Don't let the diagnostic's exit kill the VM; normal exit remains bounded by frame detection/timeout.\ns=s.replace(\"case 4001: case 4246: process.exit(0);\", \"case 4001: case 4246: res=0;"]
[384.678104, "i", " break;\")\nopen(p,'w').write(s)\nPY\nnode --check /app/vm.js; rm -f /tmp/frame.bmp /tmp/vm.log /tmp/vm.out; timeout 30s node /app/vm.js >/tmp/vm.out 2>/tmp/vm.log; echo EXIT:$?; echo '--- stderr ---'; tail -30 /tmp/vm.log; echo '--- stdout ---'; tail -20 /tmp/vm.out; ls -l /tmp/frame.bmp 2>/dev/null || true\n"]
