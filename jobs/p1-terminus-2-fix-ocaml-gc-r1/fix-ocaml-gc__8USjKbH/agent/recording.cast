[17.489176, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        (_Atomic(pool*)*)&local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i],\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(!heap->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i]);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(!heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i]);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic intnat \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(struct caml_heap_state* local,\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if( !atomic_load_relaxed(&pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz]) &&\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K356\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if( atomic_load_relaxed(&pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz]) ) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r = atomic_load_relaxed(&pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz]);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K360\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      atomic_store_relaxed(&pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz], r->next);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz] = r;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(local, &local->full_pools[sz], sz, 0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r = local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r = local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  while (!local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz] && local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz]) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(local, &local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz], sz, 0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r = local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz] = r;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K472\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz] = r->next;\r\n"]
[17.489257, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kstatic intnat \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(struct caml_heap_state* local, pool** plist,\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K669\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      pool** list = all_used ? &local->full_pools[sz] : &local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K736\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(local, &local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz], sz, 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K740\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      full_sweep_work = \u001b[01;31m\u001b[Kpool_sweep\u001b[m\u001b[K(local,\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K802\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool_finalise(local, &local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz], sz);\r\n"]
[17.489342, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(heap->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class] == NULL);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          atomic_load_relaxed(&pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class]) ==\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool* cur_pool = heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    cur_pool = heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    cur_pool = heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1327\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K       pools from [unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K] and eventually attach them all to\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pool **last_pool_p = &heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            pool* to_pool = heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class];\r\n"]
[17.489443, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class] = to_pool->next;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1475\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    compact_update_pools(heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[sz_class]);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1613\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] == NULL);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    for (pool *p = local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i]; p; p = p->next)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1657\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] == NULL);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1658\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    local->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] = local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1659\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    local->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] = NULL;\r\n"]
