[523.862403, "i", "cd /app/ocaml; python3 - <<'PY'\nfrom pathlib import Path\np = Path('runtime/shared_heap.c')\ns = p.read_text()\nold = '''      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\n      if (Has_status_hd(hd, caml_global_heap_state.GARBAGE)) {'''\nnew = '''      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\n      mlsize_t block_wh = Whsize_hd(hd);\n      if (Has_status_hd(hd, caml_global_heap_state.GARBAGE)) {'''\nif s.count(old) != 1:\n    raise SystemExit(f'header context matches: {s.count(old)}')\ns = s.replace(old, new)\nold = '''      p += Whsize_hd(hd);\n    } while (p + wh <= end);'''\nnew = '''      p += block_wh;\n    } while (p + wh <= end);'''\nif s.count(old) != 1:\n    raise SystemExit(f'tail context matches: {s.count(old)}')\ns = s.replace(old, new)\np.write_text(s)\nPY\nsed -n '550,655p' runtime/shared_heap.c\n"]
