[413.374669, "o", "--- stdlib variables ---\r\n"]
[413.412128, "o", "#**************************************************************************\r\n#*                                                                        *\r\n#*                                 OCaml                                  *\r\n#*                                                                        *\r\n#*            Xavier Leroy, projet Cristal, INRIA Rocquencourt            *\r\n#*                                                                        *\r\n#*   Copyright 1999 Institut National de Recherche en Informatique et     *\r\n#*     en Automatique.                                                    *\r\n#*                                                                        *\r\n#*   All rights reserved.  This file is distributed under the terms of    *\r\n#*   the GNU Lesser General Public License version 2.1, with the          *\r\n#*   special exception on linking described in the file LICENSE.          *\r\n#*                                                                        *\r\n#**************************************************************************\r\n\r\nROOTDIR = ..\r\n# NOTE: it is important that the OCAMLDEP variable is defined *before*\r\n# Makefile.common gets included, so that its local definition here\r\n# take precedence over its general shared definitions in Makefile.common.\r\nOCAMLDEP ?= $(BOOT_OCAMLDEP)\r\n\r\ninclude $(ROOTDIR)/Makefile.common\r\n\r\n# There are three ways the Standard Library is compiled in bytecode:\r\n# 1. During coldstart\r\n#      - using ../boot/ocamlc which runs on ../boot/ocamlrun\r\n# 2. During coreall (via library),\r\n#      - using ../ocamlc which runs on ../boot/ocamlrun\r\n# 3. During coreboot (via library-cross),\r\n#      - using ../ocamlc which at that point runs on ../runtime/ocamlrun\r\n# If $(USE_BOOT_OCAMLC) is non-empty, we select case 1 and use $(BOOT_OCAMLC).\r\n# Otherwise, we use $(OCAMLRUN) ../ocamlc, with $(OCAMLRUN) being\r\n# ../boot/ocamlrun by default, but able to overridden by library-cross to\r\n# ../runtime/ocamlrun.\r\nUSE_BOOT_OCAMLC ?=\r\n\r\nifeq \"$(USE_BOOT_OCAMLC)\" \"\"\r\nCAMLC = $(OCAMLRUN) $(ROOTDIR)/ocamlc$(EXE)\r\nelse\r\nCAMLC = $(BOOT_OCAMLC)\r\nendif\r\nCOMPFLAGS = -strict-sequence -absname -w +a-4-9-41-42-44-45-48 \\\r\n            -g -warn-error +A -bin-annot -nostdlib -principal\r\nifeq \"$(FLAMBDA)\" \"true\"\r\nOPTCOMPFLAGS += -O3\r\nendif\r\nOPTCOMPILER=$(ROOTDIR)/ocamlopt$(EXE)\r\nCAMLOPT=$(OCAMLRUN) $(OPTCOMPILER)\r\n\r\ninclude StdlibModules\r\n\r\nOBJS=$(addsuffix .cmo,$(STDLIB_MODULES))\r\nNOSTDLIB= camlinternalFormatBasics.cmo stdlib.cmo\r\nOTHERS=$(filter-out $(NOSTDLIB),$(OBJS))\r\n\r\n.PHONY: all\r\nall: stdlib.cma std_exit.cmo $(HEADER_NAME) target_$(HEADER_NAME)\r\n\r\n.PHONY: allopt opt.opt # allopt and opt.opt are synonyms\r\nallopt: stdlib.cmxa std_exit.cmx\r\nopt.opt: allopt\r\n\r\nINSTALL_STDLIB_META_DIR=$(DESTDIR)$(LIBDIR)/stdlib\r\n\r\n.PHONY: install\r\ninstall::\r\n\t$(INSTALL_DATA) \\\r\n\t  stdlib.cma std_exit.cmo *.cmi \"$(INSTALL_LIBDIR)\"\r\n\t$(MKDIR) \"$(INSTALL_STDLIB_META_DIR)\"\r\n\t$(INSTALL_DATA) META \"$(INSTALL_STDLIB_META_DIR)\"\r\nifeq \"$(INSTALL_SOURCE_ARTIFACTS)\" \"true\"\r\n\t$(INSTALL_DATA) \\\r\n\t  *.cmt *.cmti *.mli *.ml *.ml.in \\\r\n\t  \"$(INSTALL_LIBDIR)\"\r\nendif\r\n\t$(INSTALL_DATA) target_$(HEADER_NAME) \"$(INSTALL_LIBDIR)/$(HEADER_NAME)\"\r\n\r\n.PHONY: installopt\r\ninstallopt: installopt-default\r\n\r\n.PHONY: installopt-default\r\ninstallopt-default:\r\n\t$(INSTALL_DATA) \\\r\n\t  stdlib.cmxa stdlib.$(A) std_exit.$(O) *.cmx \\\r\n\t  \"$(INSTALL_LIBDIR)\"\r\n\r\n%-launch-info: %.info tmpheader.exe\r\n\t@cat $^ > $@\r\n\r\n# The mingw-w64 and MSVC versions of tmpheader.exe are linked with special flags\r\n# to reduce their size (considerably). In particular, the entry point is\r\n# overridden, which prevents the linking of crt0.\r\nifeq \"$(TOOLCHAIN)\" \"mingw\"\r\n# mingw-w64: optimise header.o for space and remove all unused sections during\r\n# linking.\r\nheader.o: OC_CFLAGS += -Os\r\nifeq \"$(SYSTEM)\" \"mingw\"\r\n  ENTRYPOINT = _wmainCRTStartup\r\nelse\r\n  ENTRYPOINT = wmainCRTStartup\r\nendif\r\n# Certainly for GCC, -nostdlib automatically adds -nostartfiles (clang's\r\n# documentation is not explicit on this point, but it would be unusual for clang\r\n# and GCC to differ). --gc-sec"]
[413.41263, "o", "tions removes unreferenced code and data sections.\r\ntmpheader.exe: OC_LDFLAGS += \\\r\n  -nostdlib -nostartfiles -Wl,--gc-sections -Wl,-e,$(ENTRYPOINT)\r\nHEADERLIBS = -lkernel32\r\nelse ifeq \"$(TOOLCHAIN)\" \"msvc\"\r\n# MSVC: Optimise header.obj for space. cl doesn't have an equivalent of\r\n# -nostdlib, however it also doesn't have default libraries in the same way as\r\n# GCC - the equivalent of crt0.o is linked because it provides the entry point\r\n# symbol, rather than by being explicitly added to the linking command line.\r\n# /GS- disables compilation of runtime security checks and /NOCOFFGRPINFO is an\r\n# undocumented linker flag which removes the debug directory from the PE+ image.\r\nheader.obj: OC_CFLAGS += /GS- /Os\r\ntmpheader.exe: OC_LDFLAGS += /NOCOFFGRPINFO /subsystem:console\r\nHEADERLIBS = kernel32.lib\r\nelse\r\nHEADERLIBS =\r\nendif\r\n\r\n.INTERMEDIATE: tmpheader.exe\r\ntmpheader.exe: header.$(O)\r\n\t$(V_MKEXE)$(call MKEXE_VIA_CC,$@,$^ $(HEADERLIBS))\r\n# Do not strip the header produced by cl\r\n"]
[413.419987, "o", "--- compiler invocation references ---\r\n"]
[413.49957, "o", "Makefile:32:CAMLC = $(BOOT_OCAMLC) $(BOOT_STDLIBFLAGS) -use-prims runtime/primitives\r\nMakefile:593:# Since the compiler libraries are necessarily compiled with boot/ocamlc,\r\nMakefile:598:  CAMLC = $(BOOT_OCAMLC) $(BOOT_STDLIBFLAGS) -use-prims runtime/primitives\r\nMakefile:648:\t  OCAMLOPT='$(value BOOT_OCAMLC) $(USE_RUNTIME_PRIMS) $(USE_STDLIB)' \\\r\nMakefile:696:\t$(MAKE) -C stdlib OCAMLRUN='$$(ROOTDIR)/$<' USE_BOOT_OCAMLC=true all\r\nMakefile:727:\t@if $(CMPCMD) boot/ocamlc ocamlc$(EXE) \\\r\nMakefile:741:\t$(PROMOTE) ocamlc$(EXE) boot/ocamlc\r\nMakefile:1050:otherlibs/dynlink/%: CAMLC = $(BEST_OCAMLC) $(STDLIBFLAGS)\r\nMakefile:1858:ocamldoc/%: CAMLC = $(BEST_OCAMLC) $(STDLIBFLAGS)\r\nMakefile:1945:ocamltest/%: CAMLC = $(BEST_OCAMLC) $(STDLIBFLAGS)\r\nMakefile:2004:testsuite/tools/test_in_prefi%: CAMLC = $(BEST_OCAMLC) $(STDLIBFLAGS)\r\nMakefile:2203:debugger/%: CAMLC = $(BEST_OCAMLC) $(STDLIBFLAGS)\r\nMakefile:2215:\t$(V_OCAMLC)$(CAMLC) $(OC_COMMON_COMPFLAGS) -pack -o $@ $^\r\nMakefile:2476:# $(ROOTDIR)/ocamlc rather than with $(ROOTDIR)/boot/ocamlc since the boot\r\nMakefile:2481:$(ocamltex): CAMLC = $(OCAMLRUN) $(ROOTDIR)/ocamlc$(EXE) $(STDLIBFLAGS)\r\nMakefile:2558:\t$(V_GEN)$(CAMLC) -i $< > $@\r\nMakefile:2573:\t$(V_OCAMLC)$(CAMLC) $(OC_COMMON_COMPFLAGS) -I $(@D) $(INCLUDES) -c $<\r\nMakefile:2576:\t$(V_OCAMLC)$(CAMLC) $(OC_COMMON_COMPFLAGS) -I $(@D) $(INCLUDES) -c $<\r\nMakefile:2679:\t      boot/*.cm* boot/libcamlrun.a boot/libcamlrun.lib boot/ocamlc.opt\r\nstdlib/.depend:115:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:124:    camlinternalFormatBasics.cmx \\\r\nstdlib/.depend:129:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:131:camlinternalFormatBasics.cmo : \\\r\nstdlib/.depend:132:    camlinternalFormatBasics.cmi\r\nstdlib/.depend:133:camlinternalFormatBasics.cmx : \\\r\nstdlib/.depend:134:    camlinternalFormatBasics.cmi\r\nstdlib/.depend:135:camlinternalFormatBasics.cmi :\r\nstdlib/.depend:348:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:365:    camlinternalFormatBasics.cmx \\\r\nstdlib/.depend:653:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:658:    camlinternalFormatBasics.cmx \\\r\nstdlib/.depend:720:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:730:    camlinternalFormatBasics.cmx \\\r\nstdlib/.depend:873:    camlinternalFormatBasics.cmi \\\r\nstdlib/.depend:876:    camlinternalFormatBasics.cmx \\\r\nstdlib/.depend:879:    camlinternalFormatBasics.cmi\r\nstdlib/StdlibModules:37:  camlinternalFormatBasics \\\r\nstdlib/Makefile:26:#      - using ../boot/ocamlc which runs on ../boot/ocamlrun\r\nstdlib/Makefile:31:# If $(USE_BOOT_OCAMLC) is non-empty, we select case 1 and use $(BOOT_OCAMLC).\r\nstdlib/Makefile:35:USE_BOOT_OCAMLC ?=\r\nstdlib/Makefile:37:ifeq \"$(USE_BOOT_OCAMLC)\" \"\"\r\nstdlib/Makefile:38:CAMLC = $(OCAMLRUN) $(ROOTDIR)/ocamlc$(EXE)\r\nstdlib/Makefile:40:CAMLC = $(BOOT_OCAMLC)\r\nstdlib/Makefile:53:NOSTDLIB= camlinternalFormatBasics.cmo stdlib.cmo\r\nstdlib/Makefile:131:\t$(V_LINKC)$(CAMLC) -a -o $@ $^\r\nstdlib/Makefile:147:\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) -c $<\r\nstdlib/Makefile:152:\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) \\\r\nstdlib/Makefile:156:\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) -c $<\r\nstdlib/Makefile:161:\t$(V_OCAMLC)$(CAMLC) $(COMPFLAGS) $(shell ./Compflags $@) \\\r\nstdlib/Makefile:174:COMPILER_DEPS=$(filter-out $(OCAMLRUN), $(CAMLC))\r\nstdlib/Compflags:22:  camlinternalFormatBasics*.cm[iox]) echo ' -nopervasives';;\r\n"]
