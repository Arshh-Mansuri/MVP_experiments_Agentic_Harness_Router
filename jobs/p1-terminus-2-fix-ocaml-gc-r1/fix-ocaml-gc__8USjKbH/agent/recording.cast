[17.488716, "o", "\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K930\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* Turn \u001b[01;31m\u001b[Kcompression\u001b[m\u001b[K off if Zlib missing or if called from\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K947\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    uintnat un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_len = extern_output_length(s);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K954\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        && (un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_len >= (uintnat)1 << 32\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K963\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /* Write the header in \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K format */\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K964\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    store32(header, Intext_magic_number_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K);\r\n\u001b[35m\u001b[Kruntime/extern.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K967\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    len = storevlq(header + pos, un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_len); pos += len;\r\n"]
[17.489072, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  _Atomic(pool*) global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[NUM_SIZECLASSES];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  pool* \u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[NUM_SIZECLASSES];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  pool* unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[NUM_SIZECLASSES];\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      heap->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] = heap->full_pools[i] =\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        heap->unswept_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i] = heap->unswept_full_pools[i] = 0;\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      move_all_pools(&heap->\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i],\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                     &pool_freelist.global_\u001b[01;31m\u001b[Kavail_pools\u001b[m\u001b[K[i], NULL);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(!heap->unswept_\u001b[0