[17.486743, "o", "\u001b[35m\u001b[Kruntime/caml/intext.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define Intext_magic_number_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K 0x8495A6BD\r\n\u001b[35m\u001b[Kruntime/caml/intext.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  Header format for the \"\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K\" model: 10 to 55 bytes\r\n\u001b[35m\u001b[Kruntime/caml/intext.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K       0   \"\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K\" magic number\r\n\u001b[35m\u001b[Kruntime/caml/intext.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K           - length of \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K marshaled data, in bytes\r\n\u001b[35m\u001b[Kruntime/caml/intext.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K           - length of un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K marshaled data, in bytes\r\n"]
