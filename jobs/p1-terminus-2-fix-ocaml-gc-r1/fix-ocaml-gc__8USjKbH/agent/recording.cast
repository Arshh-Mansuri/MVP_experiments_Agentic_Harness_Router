[665.138177, "o", "\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(end == p);\r\n\u001b[32m\u001b[K307\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  s->pool_words += POOL_WSIZE;\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t* end = POOL_END(r);\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat pool_blocks = (end - p) / wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K318\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->next = 0;\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->owner = owner;\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = (value*)p;\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  r->sz = sz;\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  p[0] = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(pool_blocks-1);\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  p[1] = 0;\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K327\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  for (p += 2; p < end; p++) *p = Debug_free_major;\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert((uintptr_t)end % Cache_line_bsize == 0);\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K363\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      local->avail_pools[sz] = r;\r\n\u001b[32m\u001b[K364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      adopt_pool_stats_with_lock(local, r, sz);\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      #ifdef DEBUG\r\n\u001b[32m\u001b[K367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      {\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        value* \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K369\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        while( \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K ) {\r\n\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K));\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = (value*)\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K[1];\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      #endif\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* There were no global avail pools, so let's adopt one of the full ones and\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  value* next;\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  pool* r = pool_find(local, sz);\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!r) return 0;\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  p = r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* assert that p is inside the pool */\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(p >= (value*)POOL_FIRST_BLOCK(r, sz));\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(p < (value*)r + POOL_WSIZE);\r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p));\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* in this case there are more free blocks immediately after */\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if( Wosize_hp(p) > 0 ) {\r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    next = (value*)(p + wsize_sizeclass[sz]);\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* we update the pool header of the next block */\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(p) - 1);\r\n\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /* also copy the \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K pointer from p */\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(p[1] == 0 || \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p[1]));\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    next[1] = p[1];\r\n\u001b[32m\u001b[K466\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  } else {\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    next = (value*)p[1];\r\n\u001b[32m\u001b[K468\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K470\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = next;\r\n\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!next) {\r\n\u001b[32m\u001b[K472\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->avail_pools[sz] = r->next;\r\n\u001b[32m\u001b[K473\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r->next = local->full_pools[sz];\r\n\u001b[32m\u001b[K474\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    local->full_pools[sz] = "]
[665.14868, "o", "r;\r\n\u001b[32m\u001b[K475\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K476\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(\r\n\u001b[32m\u001b[K478\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* either there's no more free space and we've moved the pool */\r\n\u001b[32m\u001b[K479\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    (r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K == 0 && local->full_pools[sz] == r)\r\n\u001b[32m\u001b[K480\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* or there's still free space */\r\n\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    || \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(r->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K));\r\n\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K483\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  return p;\r\n\u001b[32m\u001b[K484\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K486\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void* large_allocate(struct caml_heap_state* local, mlsize_t sz) {\r\n\u001b[32m\u001b[K487\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  large_alloc* a = malloc(sz + LARGE_ALLOC_HEADER_SZ);\r\n\u001b[32m\u001b[K488\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  if (!a) return NULL;\r\n\u001b[32m\u001b[K489\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  local->stats.large_words += Wsize_bsize(sz + LARGE_ALLOC_HEADER_SZ);\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    int all_used = 1;\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    struct heap_stats* s = &local->stats;\r\n\u001b[32m\u001b[K557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(a->owner == local->owner);\r\n\u001b[32m\u001b[K559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = 0;\r\n\u001b[32m\u001b[K561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K562\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    /* note that the below will have to be changed for the new GC pacing\r\n\u001b[32m\u001b[K563\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      logic */\r\n\u001b[32m\u001b[K564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    work = end - p;\r\n\u001b[32m\u001b[K565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    do {\r\n\u001b[32m\u001b[K566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K567\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      if( (char*)p + caml_plat_pagesize < (char*)end ) {\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* add to freelist. This could be optimised, we don't need\r\n\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        to write the free header if we're going to merge it with a prior\r\n\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        free block but it makes this codepath more complex. */\r\n\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        *p = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K592\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Is_block((value)p));\r\n\u001b[32m\u001b[K593\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K594\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for (mlsize_t i = 1, wo = Wosize_whsize(wh); i < wo; i++) {\r\n\u001b[32m\u001b[K595\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          Field(Val_hp(p), i) = Debug_free_major;\r\n\u001b[32m\u001b[K596\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K597\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K598\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_live_words -= Whsize_hd(hd);\r\n\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        local->owner->swept_words += Whsize_hd(hd);\r\n\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* reload hd */\r\n\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        hd = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* If the current block was garbage (and is now a free block) or was\r\n\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      initially a free block, see if we can merge it with the last free block we\r\n\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      encountered or if we cannot then update the pointer in the last free block\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      to point to this one */\r\n\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if any block is free then this is no longer a full pool */\r\n\u001b[32m\u001b[K616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all_used = 0;\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K618\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* if there was a free block before us, check"]
[665.149845, "o", " first if we can\r\n\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           merge with it */\r\n\u001b[32m\u001b[K620\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if( last_free_block ) {\r\n\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(last_free_block));\r\n\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* check if we can merge with the last free block */\r\n\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          if( last_free_block + (1 + \u001b[01;31m\u001b[KWosize_hp(last_free\u001b[m\u001b[K_block)) * wh == p ) {\r\n\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if we can then update the wosize of the last free block */\r\n\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_free_block = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(\u001b[01;31m\u001b[KWosize_hp(last_free\u001b[m\u001b[K_block)\r\n\u001b[32m\u001b[K627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                                                  + Wosize_hd(hd) + 1);\r\n\u001b[32m\u001b[K628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          } else {\r\n\u001b[32m\u001b[K629\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* in this case there's a non-free block between us so update\r\n\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                the next pointer */\r\n\u001b[32m\u001b[K631\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block[1] = (value)p;\r\n\u001b[32m\u001b[K632\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K633\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            last_free_block = p;\r\n\u001b[32m\u001b[K634\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          }\r\n\u001b[32m\u001b[K635\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[32m\u001b[K636\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          /* if we're the first free block then set the \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K pointer for\r\n\u001b[32m\u001b[K637\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            the pool (which indicates the start of the freelist) */\r\n\u001b[32m\u001b[K638\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = (value*)p;\r\n\u001b[32m\u001b[K639\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K640\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          last_free_block = p;\r\n\u001b[32m\u001b[K641\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K642\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* The free header stores the number of additional pool blocks. */\r\n\u001b[32m\u001b[K644\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K645\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* there's still a live block, the pool can't be released to the global\r\n\u001b[32m\u001b[K646\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            freelist */\r\n\u001b[32m\u001b[K647\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        release_to_global_pool = 0;\r\n\u001b[32m\u001b[K648\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K649\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd))\r\n\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * (Wosize_hd(hd) + 1);\r\n\u001b[32m\u001b[K651\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      else\r\n\u001b[32m\u001b[K652\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += Whsize_hd(hd);\r\n\u001b[32m\u001b[K653\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } while (p + wh <= end);\r\n\u001b[32m\u001b[K654\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(p == end);\r\n\u001b[32m\u001b[K655\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K656\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if( !all_used ) {\r\n\u001b[32m\u001b[K657\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* the last free block should have 0 as its next pointer */\r\n\u001b[32m\u001b[K658\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      last_free_block[1] = 0;\r\n\u001b[32m\u001b[K659\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K660\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K661\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(\r\n\u001b[32m\u001b[K662\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      /* if all spaces are used then \u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K should be 0 */\r\n\u001b[32m\u001b[K663\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      (all_used && !a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K664\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      /* otherwise it should point to a free block */\r\n\u001b[32m\u001b[K665\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      || (!all_used && \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    );\r\n\u001b[32m\u001b[K667\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K668\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if (release_to_global_pool) {\r\n\u001b[32m\u001b[K669\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_release(local, a, sz);\r\n\u001b[32m\u001b[K670\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    } else {\r\n\u001b[32m\u001b[K671\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool** list = all_used ? &local->full_pools[sz] : &local->avail_pools[sz];\r\n\u001b[32m\u001b[K672\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      a->next = *list;\r\n\u001b[32m\u001b[K673\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      *list = a;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K775\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K776\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K777\u001b[m\u001b[K"]
[665.150471, "o", "\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K778\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[32m\u001b[K779\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K780\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K781\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        CAMLassert(Whsize_hd(hd) <= wh);\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Tag_hd (hd) == Custom_tag) {\r\n\u001b[32m\u001b[K783\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;\r\n\u001b[32m\u001b[K784\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (final_fun != NULL) final_fun(Val_hp(p));\r\n\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K786\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        atomic_store_relaxed((atomic_uintnat*)p, 0);\r\n\u001b[32m\u001b[K787\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p[1] = (value)0;\r\n\u001b[32m\u001b[K788\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1075\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K{\r\n\u001b[32m\u001b[K1076\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  header_t hd = Hd_hp(p);\r\n\u001b[32m\u001b[K1077\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1078\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* We should never be called with a block that is free (this would indicate a\r\n\u001b[32m\u001b[K1079\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     bug in traversing the shared pools). */\r\n\u001b[32m\u001b[K1080\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p));\r\n\u001b[32m\u001b[K1081\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1082\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  tag_t tag = Tag_hd(hd);\r\n\u001b[32m\u001b[K1083\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1084\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  /* We should never encounter an Infix tag iterating over the shared pools or\r\n\u001b[32m\u001b[K1085\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    large allocations. We could find it in roots but those use\r\n\u001b[32m\u001b[K1086\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    [compact_update_value]. */\r\n\u001b[32m\u001b[K1087\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  CAMLassert(tag != Infix_tag);\r\n\u001b[32m\u001b[K1088\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\n\u001b[32m\u001b[K1116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(cur_pool);\r\n\u001b[32m\u001b[K1117\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wh = wsize_sizeclass[cur_pool->sz];\r\n\u001b[32m\u001b[K1118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    while (p + wh <= end) {\r\n\u001b[32m\u001b[K1120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(p)) {\r\n\u001b[32m\u001b[K1121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if (Has_status_val(Val_hp(p), caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          compact_update_block(p);\r\n\u001b[32m\u001b[K1123\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n\u001b[32m\u001b[K1124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* Skip over free blocks */\r\n\u001b[32m\u001b[K1126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += wh * Wosize_hp(p);\r\n\u001b[32m\u001b[K1127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      }\r\n\u001b[32m\u001b[K1128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      p += wh;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1281\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      pool_stats[k].live_blocks = 0;\r\n\u001b[32m\u001b[K1282\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1283\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[32m\u001b[K1284\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t h = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K1285\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1286\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(h)) {\r\n\u001b[32m\u001b[K1287\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* this tells us the number of spaces of size wh after this */\r\n\u001b[32m\u001b[K1288\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          mlsize_t wosize = Wosize_hd(h);\r\n\u001b[32m\u001b[K1289\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1290\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          pool_stats[k].free_blocks += wosize + 1;\r\n\u001b[32m\u001b[K1291\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#ifdef DEBUG\r\n\u001b[32m\u001b[K1292\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          total_free_blocks += wosize + 1;\r\n\u001b[32m\u001b[K1293\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K#endif\r\n\u001b[32m\u001b[K1294\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* skip to the next block */\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1358\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      mlsize_t wh = wsize_sizeclass[sz_class];\r\n\u001b[32m\u001b[K1359\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1360\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      while (p + wh <= end) {\r\n\u001b[32m\u001b[K1361\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);\r\n\u001b[32m\u001b[K1362\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1363\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if (!\u001b[01;31m\u001b[KPOOL_B"]
[665.150796, "o", "LOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K1364\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, caml_global_heap_state.MARKED));\r\n\u001b[32m\u001b[K1365\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          CAMLassert (!Has_status_hd(hd, NOT_MARKABLE));\r\n\u001b[32m\u001b[K1366\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1367\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          /* Reminder: since colours have rotated, UNMARKED indicates a MARKED\r\n\u001b[32m\u001b[K1368\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          (i.e live) block */\r\n\u001b[32m\u001b[K1369\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          if (Has_status_hd(hd, caml_global_heap_state.UNMARKED)) {\r\n\u001b[32m\u001b[K1370\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* live block in an evacuating pool, so we evacuate it to\r\n\u001b[32m\u001b[K1371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K             * the first available block */\r\n\u001b[32m\u001b[K1372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            pool* to_pool = heap->unswept_avail_pools[sz_class];\r\n\u001b[32m\u001b[K1373\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            value* new_p = to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K;\r\n\u001b[32m\u001b[K1374\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(new_p));\r\n\u001b[32m\u001b[K1375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            /* if there are free blocks after this, use those */\r\n\u001b[32m\u001b[K1376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            mlsize_t wosize = Wosize_hp(new_p);\r\n\u001b[32m\u001b[K1377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if( wosize > 0 ) {\r\n\u001b[32m\u001b[K1378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              /* copy the header and free pointer over */\r\n\u001b[32m\u001b[K1379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value* next = (value*)(new_p + wh);\r\n\u001b[32m\u001b[K1380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert(\r\n\u001b[32m\u001b[K1382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\n\u001b[32m\u001b[K1383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              );\r\n\u001b[32m\u001b[K1384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              CAMLassert((header_t*)next <= POOL_END(to_pool));\r\n\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize - 1);\r\n\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              next[1] = new_p[1];\r\n\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = next;\r\n\u001b[32m\u001b[K1390\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            } else {\r\n\u001b[32m\u001b[K1391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              value *next = (value*)new_p[1];\r\n\u001b[32m\u001b[K1392\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              to_pool->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K = next;\r\n\u001b[32m\u001b[K1393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              if (!next) {\r\n\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                /* This pool is full. Move it to unswept_full_pools */\r\n\u001b[32m\u001b[K1396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_avail_pools[sz_class] = to_pool->next;\r\n\u001b[32m\u001b[K1397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                to_pool->next = heap->unswept_full_pools[sz_class];\r\n\u001b[32m\u001b[K1398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                heap->unswept_full_pools[sz_class] = to_pool;\r\n\u001b[32m\u001b[K1399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              }\r\n\u001b[32m\u001b[K1400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            }\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1557\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1558\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  uintnat live_blocks;\r\n\u001b[32m\u001b[K1559\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K};\r\n\u001b[32m\u001b[K1560\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1561\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kstatic void verify_pool(pool* a, sizeclass sz, struct mem_stats* s) {\r\n\u001b[32m\u001b[K1562\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  for (value *v = a->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K; v; v = (value*)v[1]) {\r\n\u001b[32m\u001b[K1563\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HP(v));\r\n\u001b[32m\u001b[K1564\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1565\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1566\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  {\r\n\u001b[32m\u001b[K1567\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\n\u001b[32m\u001b[K1568\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    header_t* end = POOL_END(a);\r\n\u001b[32m\u001b[K1569\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    mlsize_t wh = wsize_sizeclass[sz];\r\n\u001b[32m\u001b[K1570\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    s->overhead += POOL_SLAB_WOFFSET(sz);\r\n\u001b[32m\u001b[K1571\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1574\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         this is fine: marking can only turn UNMARKED objects into MARKED or\r\n\u001b[32m\u001b[K1575\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         NOT_MARKABLE, which is of no consequence for this verif"]
[665.151195, "o", "ication\r\n\u001b[32m\u001b[K1576\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K         (namely, that there is no garbage left). */\r\n\u001b[32m\u001b[K1577\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      header_t hd = Hd_hp(p);\r\n\u001b[32m\u001b[K1578\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      CAMLassert(\r\n\u001b[32m\u001b[K1579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd) ||\r\n\u001b[32m\u001b[K1580\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K          !Has_status_hd(hd, caml_global_heap_state.GARBAGE)\r\n\u001b[32m\u001b[K1581\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      );\r\n\u001b[32m\u001b[K1582\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE\u001b[m\u001b[K_HD(hd)) {\r\n\u001b[32m\u001b[K1583\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live += Whsize_hd(hd);\r\n\u001b[32m\u001b[K1584\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->overhead += wh - Whsize_hd(hd);\r\n\u001b[32m\u001b[K1585\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->live_blocks++;\r\n\u001b[32m\u001b[K1586\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      } else {\r\n\u001b[32m\u001b[K1587\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        /* count the free block and any that follow it (stored in the\r\n\u001b[32m\u001b[K1588\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K           size bits in the header)*/\r\n\u001b[32m\u001b[K1589\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        s->free += wh * (1 + Wosize_hd(hd));\r\n\u001b[32m\u001b[K1590\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        p += Wosize_hd(hd) * wh;\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_avail_pools[i] == NULL);\r\n\u001b[32m\u001b[K1616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    CAMLassert(local->unswept_full_pools[i] == NULL);\r\n\u001b[32m\u001b[K1617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (pool *p = local->avail_pools[i]; p; p = p->next)\r\n\u001b[32m\u001b[K1618\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      verify_pool(p, i, &pool_stats);\r\n\u001b[32m\u001b[K1619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for (pool *p = local->full_pools[i]; p; p = p->next) {\r\n\u001b[32m\u001b[K1620\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      CAMLassert(p->\u001b[01;31m\u001b[Knext_obj\u001b[m\u001b[K == NULL);\r\n\u001b[32m\u001b[K1621\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      verify_pool(p, i, &pool_stats);\r\n\u001b[32m\u001b[K1622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K1623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  }\r\n\u001b[32m\u001b[K1624\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  caml_gc_log(\"Pooled memory: %\" CAML_PRIuNAT \" allocated, \"\r\n\u001b[32m\u001b[K1625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              \"%\" CAML_PRIuNAT \" free, %\" CAML_PRIuNAT \" fragmentation\",\r\n\u001b[32m\u001b[K1626\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K              pool_stats.allocated, pool_stats.free, pool_stats.overhead);\r\n\u001b[32m\u001b[K1627\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K1628\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  verify_large(local->swept_large, &large_stats);\r\n"]
