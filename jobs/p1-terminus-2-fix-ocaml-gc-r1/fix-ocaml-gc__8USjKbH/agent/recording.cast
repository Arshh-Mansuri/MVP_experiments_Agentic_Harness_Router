[17.390395, "i", "cd /app/ocaml; printf '%s\\n' '--- compression/free-space identifiers ---'; grep -RInE 'run.?length|RLE|compressed|compression|free_space|free_space|next_free|avail_pools|pool_sweep' runtime --include='*.c' --include='*.h'; printf '%s\\n' '--- shared heap declarations ---'; sed -n '1,230p' runtime/shared_heap.c; printf '%s\\n' '--- pool sweep/allocation ---'; sed -n '300,820p' runtime/shared_heap.c; printf '%s\\n' '--- relevant headers ---'; sed -n '1,220p' runtime/caml/shared_heap.h; sed -n '1,180p' runtime/caml/config.h\n"]
[17.39624, "o", "cd /app/ocaml; printf '%s\\n' '--- compression/free-space identifiers ---'; grep -RInE 'run.?length|RLE|compressed|compression|free_space|free_space|next_free|avail_pools|pool_sweep' runtime --include='*.c' --include='*.h'; printf '%s\\n' '--- shared heap declarations ---'; sed -n '1,230p' runtime/shared_heap.c; printf '%s\\n' '--- pool sweep/allocation ---'; sed -n '300,820p' runtime/shared_heap.c; printf '%s\\n' '--- relevant headers ---'; sed -n '1,220p' runtime/caml/shared_heap.h; sed -n '1,180p' runtime/caml/config.h\r\n\u001b[?2004l\r"]
[17.397876, "o", "--- compression/free-space identifiers ---\r\n"]
[17.483436, "o", "\u001b[35m\u001b[Kruntime/zstd.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* The old un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K blocks that remain to be freed */\r\n\u001b[35m\u001b[Kruntime/zstd.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* Free the newly-allocated \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K blocks */\r\n\u001b[35m\u001b[Kruntime/zstd.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                   uintnat un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_data_len,\r\n\u001b[35m\u001b[Kruntime/zstd.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  return ZSTD_decompress(blk, un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_data_len, intern_src, data_len);\r\n"]
[17.483933, "o", "\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K938\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   2. the \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack - a bitset of fields that need to be marked.\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K941\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   overflows the bound, then entries from the stack are \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K and\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K942\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   transferred into the \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack, expect for \"large\" entries,\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K944\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   represented as spans and remain on the un\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack.\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K946\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   When the stack is empty, the \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack is processed.\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K947\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   The \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack iterator marks the point up to which\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K948\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K   \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack entries have already been processed.\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K960\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  struct addrmap \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K961\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  addrmap_iterator \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack_iter;\r\n"]
[17.484016, "o", "\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1014\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K     new \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack entries into an existing, partially-processed\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1015\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K     \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack. Thus, we create a new \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack and insert the\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1016\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K     unprocessed entries of the existing \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack into the new one. */\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1017\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  uintnat old_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries = 0;\r\n"]
[17.484304, "o", "\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1018\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  struct addrmap new_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack = ADDRMAP_INIT;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1019\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  for (addrmap_iterator it = stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack_iter;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1020\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K       caml_addrmap_iter_ok(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1021\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K       it = caml_addrmap_next(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it)) {\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1022\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    value k = caml_addrmap_iter_key(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1023\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    value v = caml_addrmap_iter_value(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1024\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    caml_addrmap_insert(&new_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, k, v);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1025\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    ++old_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1027\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  if (old_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries > 0) {\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1028\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    caml_gc_log(\"Preserved %\" CAML_PRIdNAT \" \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K entries\",\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1029\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                old_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1031\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  caml_addrmap_clear(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1032\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack = new_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack;\r\n"]
[17.484351, "o", "\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  uintnat new_stk_count = 0, \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries = 0, total_words = 0;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1044\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries += add_addr(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack,\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1053\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              \"%\" CAML_PRIdNAT \" \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K entries\",\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1055\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries+old_\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_entries);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1060\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  /* setup the \u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K stack iterator */\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1061\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack_iter = caml_addrmap_iterator(&stk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1386\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      addrmap_iterator it = mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack_iter;\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1387\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (caml_addrmap_iter_ok(&mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it)) {\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        uintnat chunk = caml_addrmap_iter_key(&mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1389\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        uintnat bitset = caml_addrmap_iter_value(&mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack_iter =\r\n\u001b[35m\u001b[Kruntime/major_gc.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1395\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                      caml_addrmap_next(&mstk->\u001b[01;31m\u001b[Kcompressed\u001b[m\u001b[K_stack, it);\r\n"]
