[839.967103, "o", "\u001b[?2004hroot@5200926ff3a1:/app/ocaml# "]
[868.803308, "i", "cd /app/ocaml; python3 - <<'PY'\nfrom pathlib import Path\npath=Path('runtime/shared_heap.c')\ns=path.read_text()\nstart=s.index('/* Sweeping of the major heap shared pools */')\nend=s.index('static intnat large_alloc_sweep', start)\npart=s[start:end]\n# Remove temporary mismatch diagnostic block.\nstart_diag=part.find('    if (p != end) {')\nif start_diag >= 0:\n    end_diag=part.index('    CAMLassert(p == end);', start_diag)\n    part=part[:start_diag]+part[end_diag:]\n# Remove temporary per-step diagnostic block.\nstart_diag=part.find('      if (p - POOL_FIRST_BLOCK(a, sz) < 5000) {')\nif start_diag >= 0:\n    end_diag=part.index('      if (POOL_BLOCK_FREE_HD(hd))', start_diag)\n    part=part[:start_diag]+part[end_diag:]\nold='''      if (POOL_BLOCK_FREE_HD(hd))\n        p += wh;\n      else\n        p += Whsize_hd(hd);'''\nnew='''      if (POOL_BLOCK_FREE_HD(hd))\n        p += wh;\n      else\n        p += wh;'''\nassert part.count(old)==1, part.count(old)\npart=part.replace(old,new,1)\npath.write_text(s[:start]+part+s[end:])\nPY\nsed -n '638,655p' runtime/shared_heap.c; grep -n 'SWEEP MISMATCH\\|SWEEP step' runtime/shared_heap.c || true\n"]
[868.817628, "o", "cd /app/ocaml; python3 - <<'PY'\r\n"]
[868.817956, "o", "\u001b[?2004l\r"]
[868.823427, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> path=Path('runtime/shared_heap.c')\r\n\u001b[?2004l\r\u001b[?2004h> s=path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start=s.index('/* Sweeping of the major heap shared pools */')\r\n\u001b[?2004l\r\u001b[?2004h> end=s.index('static intnat large_alloc_sweep', start)\r\n\u001b[?2004l\r\u001b[?2004h> part=s[start:end]\r\n\u001b[?2004l\r\u001b[?2004h> # Remove temporary mismatch diagnostic block.\r\n\u001b[?2004l\r\u001b[?2004h> start_diag=part.find('    if (p != end) {')\r\n\u001b[?2004l\r\u001b[?2004h> if start_diag >= 0:\r\n\u001b[?2004l\r\u001b[?2004h>     end_diag=part.index('    CAMLassert(p == end);', start_diag)\r\n\u001b[?2004l\r\u001b[?2004h>     part=part[:start_diag]+part[end_diag:]\r\n\u001b[?2004l\r"]
