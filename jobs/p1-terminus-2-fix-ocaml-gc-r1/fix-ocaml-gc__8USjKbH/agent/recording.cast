[788.386608, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd) \\\r\n"]
[788.3876, "o", "\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(p) (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(Hd_hp(p)))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#define \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(wosize) Make_header(wosize, No_scan_tag, NOT_MARKABLE)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K296\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if (!\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  p[0] = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(pool_blocks-1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(next_obj));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(p));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    *next = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(p) - 1);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    CAMLassert(p[1] == 0 || \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(p[1]));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    || \u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(r->next_obj));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        *p = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        hd = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(0);\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd)) {\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          CAMLassert(\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HP\u001b[m\u001b[K(last_free_block));\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            *last_free_block = \u001b[01;31m\u001b[KPOOL_FREE_HEADER\u001b[m\u001b[K(Wosize_hp(last_free_block)\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      if (\u001b[01;31m\u001b[KPOOL_BLOCK_FREE_HD\u001b[m\u001b[K(hd))\r\n\u001b[35m\u001b[Kruntime/shared_heap.c\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      || (!all_used && \u001b[01;