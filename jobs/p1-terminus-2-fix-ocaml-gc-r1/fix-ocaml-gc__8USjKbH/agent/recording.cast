0;\r\nruntime/shared_heap.c:572:      /* The pools mark a block as being free by setting the tag to No_scan_tag\r\nruntime/shared_heap.c:574:        number of contiguous free blocks that follow. The first field is a\r\nruntime/shared_heap.c:575:        pointer to the next free block beyond the immediately following\r\nruntime/shared_heap.c:576:        contiguous free blocks (if any). */\r\nruntime/shared_heap.c:578:      /* Check if the current block is garbage, if it is turn it into a free\r\nruntime/shared_heap.c:587:        /* add to freelist. This could be optimised, we don't need\r\nruntime/shared_heap.c:588:        to write the free header if we're going to merge it with a prior\r\nruntime/shared_heap.c:589:        free block but it makes this codepath more complex. */\r\nruntime/shared_heap.c:595:          Field(Val_hp(p), i) = Debug_free_major;\r\nruntime/shared_heap.c:601:        s->pool_live_blocks--;\r\nruntime/shared_heap.c:602:        s->pool_live_words -= Whsize_hd(hd);\r\nruntime/shared_heap.c:604:        s->pool_frag_words -= (wh - Whsize_hd(hd));\r\nruntime/shared_heap.c:610:      /* If the current block was garbage (and is now a free block) or was\r\nruntime/shared_heap.c:611:      initially a free block, see if we can merge it with the last free block we\r\nruntime/shared_heap.c:612:      encountered or if we cannot then update the pointer in the last free block\r\nruntime/shared_heap.c:615:        /* if any block is free then this is no longer a full pool */\r\nruntime/shared_heap.c:618:        /* if there was a free block before us, check first if we can\r\nruntime/shared_heap.c:620:        if( last_free_block ) {\r\nruntime/shared_heap.c:621:          CAMLassert(POOL_BLOCK_FREE_HP(last_free_block));\r\nruntime/shared_heap.c:623:          /* check if we can merge with the last free block */\r\nruntime/shared_heap.c:624:          if( last_free_block + (1 + Wosize_hp(last_free_block)) * wh == p ) {\r\nruntime/shared_heap.c:625:            /* if we