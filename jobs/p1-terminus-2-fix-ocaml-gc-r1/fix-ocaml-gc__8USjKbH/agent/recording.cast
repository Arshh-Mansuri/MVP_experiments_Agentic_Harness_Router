[770.278012, "o", "runtime/caml/sizeclasses.h:9:static const unsigned int wsize_sizeclass[NUM_SIZECLASSES] =\r\nruntime/shared_heap.c:53:  value* next_obj;\r\nruntime/shared_heap.c:59:#define POOL_FIRST_BLOCK(p, sz) ((header_t*)(p) + POOL_SLAB_WOFFSET(sz))\r\nruntime/shared_heap.c:289:  header_t* p = POOL_FIRST_BLOCK(a, sz);\r\nruntime/shared_heap.c:291:  mlsize_t wh = wsize_sizeclass[sz];\r\nruntime/shared_heap.c:315:  header_t* p = POOL_FIRST_BLOCK(r, sz);\r\nruntime/shared_heap.c:317:  uintnat pool_blocks = (end - p) / wsize_sizeclass[sz];\r\nruntime/shared_heap.c:321:  r->next_obj = (value*)p;\r\nruntime/shared_heap.c:368:        value* next_obj = r->next_obj;\r\nruntime/shared_heap.c:369:        while( next_obj ) {\r\nruntime/shared_heap.c:370:          CAMLassert(POOL_BLOCK_FREE_HP(next_obj));\r\nruntime/shared_heap.c:371:          next_obj = (value*)next_obj[1];\r\nruntime/shared_heap.c:445:static void* pool_allocate(struct caml_heap_state* local, sizeclass sz) {\r\nruntime/shared_heap.c:452:  p = r->next_obj;\r\nruntime/shared_heap.c:454:  CAMLassert(p >= (value*)POOL_FIRST_BLOCK(r, sz));\r\nruntime/shared_heap.c:460:    next = (value*)(p + wsize_sizeclass[sz]);\r\nruntime/shared_heap.c:463:    /* also copy the next_obj pointer from p */\r\nruntime/shared_heap.c:470:  r->next_obj = next;\r\nruntime/shared_heap.c:479:    (r->next_obj == 0 && local->full_pools[sz] == r)\r\nruntime/shared_heap.c:481:    || POOL_BLOCK_FREE_HP(r->next_obj));\r\nruntime/shared_heap.c:514:    CAMLassert(wsize_sizeclass[sz] >= whsize);\r\nruntime/shared_heap.c:515:    p = pool_allocate(local, sz);\r\nruntime/shared_heap.c:520:    s->pool_frag_words += wsize_sizeclass[sz] - whsize;\r\nruntime/shared_heap.c:551:    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\nruntime/shared_heap.c:554:    const mlsize_t wh = wsize_sizeclass[sz];\r\nruntime/shared_heap.c:560:    a->next_obj = 0;\r\nruntime/shared_heap.c:636:          /* if we're the first free block then set the next_obj pointer for\r\nruntime/shared_heap.c:638:          a->next_obj = (value*)p;\r\nruntime/shared_heap.c:663:      /* if all spaces are used then next_obj should be 0 */\r\nruntime/shared_heap.c:664:      (all_used && !a->next_obj)\r\nruntime/shared_heap.c:666:      || (!all_used && POOL_BLOCK_FREE_HP(a->next_obj))\r\nruntime/shared_heap.c:775:    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\nruntime/shared_heap.c:777:    mlsize_t wh = wsize_sizeclass[sz];\r\nruntime/shared_heap.c:830:  mlsize_t wh = wsize_sizeclass[r->sz];\r\nruntime/shared_heap.c:831:  header_t* p = POOL_FIRST_BLOCK(r, r->sz);\r\nruntime/shared_heap.c:1116:    header_t* p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\nruntime/shared_heap.c:1118:    mlsize_t wh = wsize_sizeclass[cur_pool->sz];\r\nruntime/shared_heap.c:1277:      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\nruntime/shared_heap.c:1279:      mlsize_t wh = wsize_sizeclass[sz_class];\r\nruntime/shared_heap.c:1357:      header_t* p = POOL_FIRST_BLOCK(cur_pool, sz_class);\r\nruntime/shared_heap.c:1359:      mlsize_t wh = wsize_sizeclass[sz_class];\r\nruntime/shared_heap.c:1374:            value* new_p = to_pool->next_obj;\r\nruntime/shared_heap.c:1383:                POOL_FIRST_BLOCK(to_pool, sz_class) <= (header_t*)next\r\nruntime/shared_heap.c:1390:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1393:              to_pool->next_obj = next;\r\nruntime/shared_heap.c:1510:    for (header_t *p = POOL_FIRST_BLOCK(cur_pool, cur_pool->sz);\r\nruntime/shared_heap.c:1563:  for (value *v = a->next_obj; v; v = (value*)v[1]) {\r\nruntime/shared_heap.c:1568:    header_t* p = POOL_FIRST_BLOCK(a, sz);\r\nruntime/shared_heap.c:1570:    mlsize_t wh = wsize_sizeclass[sz];\r\nruntime/shared_heap.c:1621:      CAMLassert(p->next_obj == NULL);\r\n"]
