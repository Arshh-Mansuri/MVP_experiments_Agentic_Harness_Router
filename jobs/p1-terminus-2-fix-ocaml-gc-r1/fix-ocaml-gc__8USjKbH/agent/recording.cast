[377.983743, "o", "647:\t  OCAMLRUN='$$(ROOTDIR)/boot/ocamlrun$(EXE)' NATDYNLINK=false \\\r\n657:    boot/ocamlrun$(EXE) flexlink.byte$(EXE) | $(BYTE_BINDIR)\r\n660:\tcp boot/ocamlrun$(EXE) $@\r\n676:# The recipe for runtime/ocamlruns$(EXE) also produces runtime/primitives\r\n677:boot/ocamlrun$(EXE): runtime/ocamlruns$(EXE)\r\n685:boot/ocamlrun$(EXE): runtime/ocamlrun$(EXE) runtime/primitives\r\n688:# $< refers to runtime/ocamlruns when bootstrapping flexlink and\r\n689:# runtime/ocamlrun otherwise (see above).\r\n690:boot/ocamlrun$(EXE):\r\n695:coldstart: boot/ocamlrun$(EXE) runtime/libcamlrun.$(A)\r\n703:coreall: runtime\r\n755:\trm -f boot/ocamlrun$(EXE)\r\n756:\tcp runtime/ocamlrun$(EXE) boot/ocamlrun$(EXE)\r\n801:# This compiler runs on boot/ocamlrun and produces bytecode for\r\n802:# runtime/ocamlrun\r\n804:# Rebuild ocamlc and ocamllex (run on runtime/ocamlrun)\r\n808:# Rebuild the library (using runtime/ocamlrun ./ocamlc)\r\n811:\t$(MAKE) OCAMLRUN=runtime/ocamlrun$(EXE) promote\r\n840:bootstrap: coreboot\r\n849:world: coldstart\r\n879:  FLEXLINK_OCAMLOPT=../runtime/ocamlrun$(EXE) ../ocamlopt$(EXE)\r\n1015:# boot/ocamlrun and runtime/ocamlrun will be the same when the toplevel\r\n1273:runtime_PROGRAMS = runtime/ocamlrun$(EXE)\r\n1282:runtime_PROGRAMS += runtime/ocamlrund$(EXE)\r\n1288:runtime_PROGRAMS += runtime/ocamlruni$(EXE)\r\n1405:runtime/ocamlrun$(EXE): runtime/prims.$(O) runtime/libcamlrun.$(A)\r\n1408:runtime/ocamlruns$(EXE): runtime/prims.$(O) runtime/libcamlrun_non_shared.$(A)\r\n1417:runtime/ocamlrund$(EXE): runtime/prims.$(O) runtime/libcamlrund.$(A)\r\n1423:runtime/ocamlruni$(EXE): runtime/prims.$(O) runtime/libcamlruni.$(A)\r\n1660:\t$(MAKE) -C stdlib OCAMLRUN=../runtime/ocamlrun$(EXE) all\r\n2677:\trm -f boot/ocamlrun boot/ocamlrun.exe boot/$(HEADER_NAME) \\\r\n"]
