   223	  }
   224	  CAMLassert(!heap->unswept_large);
   225	  CAMLassert(!heap->swept_large);
   226	}
   227	
   228	void caml_free_shared_heap(struct caml_heap_state* heap) {
   229	  caml_assert_shared_heap_is_empty(heap);
   230	  caml_stat_free(heap);
