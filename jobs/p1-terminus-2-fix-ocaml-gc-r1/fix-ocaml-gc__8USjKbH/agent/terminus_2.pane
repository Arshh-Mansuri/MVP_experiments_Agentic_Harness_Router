   766	/* Purging */
   767	
   768	static void pool_finalise(struct caml_heap_state* local, pool** plist,
   769	                         sizeclass sz) {
   770	  pool *a;
   771	  while ((a = *plist) != 0) {
   772	    *plist = a->next;
   773	
   774	    header_t* p = POOL_FIRST_BLOCK(a, sz);
   775	    header_t* end = POOL_END(a);
   776	    mlsize_t wh = wsize_sizeclass[sz];
   777	
   778	    while (p + wh <= end) {
   779	      header_t hd = (header_t)atomic_load_relaxed((atomic_uintnat*)p);
   780	      if (!POOL_BLOCK_FREE_HD(hd)) {
   781	        CAMLassert(Whsize_hd(hd) <= wh);
   782	        if (Tag_hd (hd) == Custom_tag) {
   783	          void (*final_fun)(value) = Custom_ops_val(Val_hp(p))->finalize;
   784	          if (final_fun != NULL) final_fun(Val_hp(p));
   785	        }
   786	        atomic_store_relaxed((atomic_uintnat*)p, 0);
   787	        p[1] = (value)0;
   788	      } else {
   789	        p += wh * Wosize_hd(hd);
   790	      }
   791	      p += wh;
   792	    }
   793	
   794	    pool_release(local, a, sz);
   795	  }
   796	}
