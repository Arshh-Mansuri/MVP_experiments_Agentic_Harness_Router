   234	/* Allocating and deallocating pools from the global freelist. */
   235	
   236	static pool* pool_acquire(struct caml_heap_state* local) {
   237	  pool* r;
   238	
   239	  caml_plat_lock_blocking(&pool_freelist.lock);
   240	  if (!pool_freelist.free) {
