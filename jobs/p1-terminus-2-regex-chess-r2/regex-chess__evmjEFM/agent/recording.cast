[183.349398, "o", "# En passant: white pawn on rank 5, target ep square on rank 6, adjacent black pawn.\r\n\u001b[?2004l\r\u001b[?2004h> def ep_rule(c,dc):\r\n\u001b[?2004l\r\u001b[?2004h>     tc=c+dc; s=sq(3,c); d=sq(2,tc); cap=sq(3,tc)\r\n\u001b[?2004l\r\u001b[?2004h>     # Capture the three relevant squares with segmented groups.\r\n\u001b[?2004l\r\u001b[?2004h>     xs=sorted([s,d,cap]); chars={s:'P',d:'\\\\.',cap:'p'}\r\n\u001b[?2004l\r\u001b[?2004h>     pieces=[]; last=0\r\n\u001b[?2004l\r\u001b[?2004h>     for x in xs:\r\n\u001b[?2004l\r,\u001b[?2004h>         pieces.append(r'(.{%d})%s'%(x-last,chars[x])); last=x+1\r\n\u001b[?2004l\r     rr,cc=\u001b[?2004h>     pieces.append(r'(.{%d})'%(64-last))\r\n\u001b[?2004l\r\u001b[?2004h>     # groups are board segments, then rights and counters\r\n\u001b[?2004l\r\u001b[?2004h>     pat=rf'(?m)^'+''.join(pieces)+rf'\\\\| w ([KQkq-]*) {\"abcdefgh\"[tc]}6 ([^\\\\n]*)$'\r\n\u001b[?2004l\r\u001b[?2004h>     refs=[]; out=[]\r\n\u001b[?2004l\rrke\u001b[?2004h>     for i,x in enumerate(xs):\r\n\u001b[?2004l\r\u001b[?2004h>         out.append(r'\\%d'% (i+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.350178, "o", "        out.append('.' if x in (s,cap) else 'P')\r\n\u001b[?2004l\r\u001b[?2004h>     out.append(r'\\%d'%(len(xs)+1))\r\n\u001b[?2004l\remove marker, insert rank separator"]
[183.3502, "o", "\u001b[?2004h> "]
[183.350499, "o", "    rep='@%02d%02d'%(s,d)+''.join(out)+rf'| b \\{len(xs)+2} - 0 0\\n\\g<0>'\r\n\u001b[?2004l\r\u001b[?2004h>     add(pat,rep)\r\n\u001b[?2004l\r\u001b[?2004h> for c in range(8):\r\n\u001b[?2004l\r"]
[183.350633, "o", "\u001b[?2004h"]
