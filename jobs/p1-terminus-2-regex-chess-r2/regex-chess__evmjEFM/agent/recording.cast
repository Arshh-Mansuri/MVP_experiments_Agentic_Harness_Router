[294.81611, "i", "python3 - <<'PY'\np='/tmp/gen.py'\nlines=open(p).read().splitlines()\n# Replace strict marker-removal rule.\nfor i,line in enumerate(lines):\n    if \"add(r'(?m)^@\\\\d{4}(.{64})\" in line:\n        lines[i]=\"add(r'@\\\\d{4}', '')\"\n# Add robust compression of converted empty-square runs after the existing dot rules.\nfor i,line in enumerate(lines):\n    if line.strip()==\"add(r'\\\\.', '1')\":\n        inserts=[]\n        for n in range(8,1,-1): inserts.append(\"add('1'*%d, '%d')\"%(n,n))\n        lines[i+1:i+1]=inserts\n        break\nopen(p,'w').write('\\n'.join(lines)+'\\n')\nPY\ntail -18 /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\ns='rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'\nfor p,x in r:s=re.sub(p,x,s)\nprint(s); print('outputs',len(s.splitlines()))\nPY\n"]
