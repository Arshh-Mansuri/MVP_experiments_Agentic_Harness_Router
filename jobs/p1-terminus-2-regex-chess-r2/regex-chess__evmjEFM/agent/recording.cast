[724.567959, "i", "python3 - <<'PY'\np='/tmp/gen.py'\ns=open(p).read()\nold=\"\"\"# Remove markers, split the 64-square board into ranks, then compress empties.\nadd(r'@\\\\d{4}', '')\nadd(r'(?m)^(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})( b .*)$', r'\\\\1/\\\\2/\\\\3/\\\\4/\\\\5/\\\\6/\\\\7/\\\\8\\\\9')\n\"\"\"\nnew=\"\"\"# Remove markers and internal pipe, split the 64-square board into ranks, then compress empties.\nadd(r'@\\\\d{4}', '')\nadd(r'\\\\|', '')\nadd(r'(?m)^(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})(.{8})( b .*)$', r'\\\\1/\\\\2/\\\\3/\\\\4/\\\\5/\\\\6/\\\\7/\\\\8\\\\9')\n\"\"\"\nif old not in s: print('format block not found')\nelse: s=s.replace(old,new,1)\nopen(p,'w').write(s)\nPY\ntail -16 /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\nf='rn1qkb1r/ppp2ppp/5n2/4p3/2B1P3/5Q2/PPP2PPP/RNB1K2R w KQkq - 2 7'\ns=f\nfor p,x in r:s=re.sub(p,x,s)\nlines=s.splitlines()\nprint('count',len(lines),'flat',[z for z in lines if '/' not in z.sp"]
