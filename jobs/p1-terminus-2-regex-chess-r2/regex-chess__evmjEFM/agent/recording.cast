[418.399149, "i", "python3 - <<'PY'\np='/tmp/gen.py'; s=open(p).read()\n# Reorder compression: remove the existing single-dot line and insert it after the run loop.\ns=s.replace(\"for n in range(8,1,-1): add(r'\\\\.'*n, str(n))\\nadd(r'\\\\.', '1')\", \"for n in range(8,1,-1): add(r'\\\\.'*n, str(n))\\nadd(r'\\\\.', '1')\")\n# The current ordering is already correct in source, but ensure no duplicate early single-dot rule.\nparts=s.splitlines(); seen=0; out=[]\nfor line in parts:\n    if line.strip()==\"add(r'\\\\.', '1')\":\n        seen+=1\n        if seen>1: continue\n    out.append(line)\nopen(p,'w').write('\\n'.join(out)+'\\n')\nPY\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\n"]
