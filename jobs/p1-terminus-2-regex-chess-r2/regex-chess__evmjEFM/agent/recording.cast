[335.059288, "i", "python3 - <<'PY'\np='/tmp/gen.py'\nlines=open(p).read().splitlines()\nfor i,line in enumerate(lines):\n    if line.strip().startswith(\"rep=rf'@{s:02d}{d:02d}\") and \"\\\\1{put}\" in line:\n        lines[i]=\"        rep=rf'@{s:02d}{d:02d}\\\\1{put}\\\\2.\\\\3 b \\\\4 {ep} 0 0\\\\n\\\\g<0>'\"\nopen(p,'w').write('\\n'.join(lines)+'\\n')\nPY\nsed -n '14,20p' /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\nfor name,s in [('sample','rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'),('start','rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1')]:\n    for p,x in r:s=re.sub(p,x,s)\n    print(name,'lines',len(s.splitlines()))\n    print(s[:1500])\nPY\n"]
