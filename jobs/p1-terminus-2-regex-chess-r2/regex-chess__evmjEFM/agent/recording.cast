[183.351238, "o", "# Castling. Candidate marker @Ck or @Cq, with final board already transformed.\r\n\u001b[?2004l\re"]
[183.351431, "o", "\u001b[?2004h> def castle(kind, right, empties, old, new):\r\n\u001b[?2004l\r retaining FEN spaces.\r\nadd(r'\\|', '')\r\njson.d\u001b[?2004h> "]
