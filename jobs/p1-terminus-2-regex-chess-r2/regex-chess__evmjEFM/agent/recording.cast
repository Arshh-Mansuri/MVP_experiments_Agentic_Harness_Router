[750.228455, "i", "python3 - <<'PY'\np='/tmp/gen.py'\ns=open(p).read()\nneedle=\"# Convert castle markers to ordinary marker and discard originals.\\n\"\nblock=\"\"\"# Castling consumes both white castling rights.\\nfor tag in ('Ck','Cq'):\\n    add(r'(?m)^(@'+tag+r'[^|]*\\\\| b )([^ \\\\n]*)K([^ \\\\n]* .*)$', r'\\\\1\\\\2\\\\3')\\n    add(r'(?m)^(@'+tag+r'[^|]*\\\\| b )([^ \\\\n]*)Q([^ \\\\n]* .*)$', r'\\\\1\\\\2\\\\3')\\n\"\"\"\nif needle not in s: print('needle missing')\nelse: s=s.replace(needle,block+needle,1)\nopen(p,'w').write(s)\nPY\ngrep -n -A8 'Castling consumes' /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\nf='rn1qkb1r/ppp2ppp/5n2/4p3/2B1P3/5Q2/PPP2PPP/RNB1K2R w KQkq - 2 7'\ns=f\nfor p,x in r:s=re.sub(p,x,s)\nprint('castle',[z for z in s.splitlines() if 'RNB2RK1' in z])\nprint('count',len(s.splitlines()))\nPY\n"]
