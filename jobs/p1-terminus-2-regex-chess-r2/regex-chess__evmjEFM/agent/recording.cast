[482.005328, "i", "python3 - <<'PY'\np='/tmp/gen.py'\ns=open(p).read()\nneedle='# Remove lines whose candidate king is attacked by any black piece.\\n'\nblock=r'''# Update white castling rights on candidate moves.\n# Candidate format at this stage: @ssdd + 64 board chars + \" b RIGHTS EP ...\".\nfor prefix,rights in [('@60','KQ'),('@56','Q'),('@63','K')]:\n    for ch in rights:\n        add(r'(?m)^('+prefix+r'\\d{2}.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\n# Capturing a rook on a1/h1 also removes the corresponding right.\nfor dst,ch in [('56','Q'),('63','K')]:\n    add(r'(?m)^(@\\d{2}'+dst+r'.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\n'''\nif needle not in s: print('needle missing')\nelse: s=s.replace(needle,block+needle,1)\nopen(p,'w').write(s)\nPY\ngrep -n -A12 'Update white castling' /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\ns='rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQ"]
