[308.241729, "i", "python3 - <<'PY'\nimport json,re\nr=json.load(open('/app/re.json'))\ns='rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'\n# Replay only expansion rules and slash removal (first 50-ish rules).\nfor p,x in r[:50]: s=re.sub(p,x,s)\nprint('expanded',repr(s),len(s))\n# Find representative rules for known moves: b1-a3 (s57,d40 backward), e2-e4(s52,d36 backward), g1-f3(s62,d45 backward).\nfor code in ('5740','5236','6245','1329'):\n    for i,(p,x) in enumerate(r):\n        if '@'+code in x:\n            print('RULE',code,i,repr(p),repr(x))\n            m=re.search(p,s)\n            print('MATCH',bool(m),m.groups() if m else None)\n            if m: print('OUT',re.sub(p,x,s))\n            break\nPY\n"]
