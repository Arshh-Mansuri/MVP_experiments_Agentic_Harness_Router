[446.696161, "i", "python3 - <<'PY'\nimport json,re\nr=json.load(open('/app/re.json'))\nf='rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQKBNR w KQkq - 0 2'\ns=f\nfor i,(p,x) in enumerate(r,1):\n    s=re.sub(p,x,s)\n    if '/' not in s.split(' w ')[0] and len(s.split(' w ')[0])==64:\n        print('flat at',i,repr(s)); break\n# Find all rules generating marker 6152 and test them.\nfor i,(p,x) in enumerate(r,1):\n    if '@6152' in x:\n        m=re.search(p,s)\n        print(i,'match',bool(m),repr(p),repr(x))\n        if m: print(m.groups())\nPY\n"]
