[183.351888, "o", "    points=sorted(set(old)|set(new)); pieces=[]; last=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.352135, "o", "    for x in points:\r\n\u001b[?2004l\r\u001b[?2004h>         expected=old.get(x,'.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.352523, "o", "        pieces.append(r'(.{%d})%s'%(x-last, expected.replace('.','\\\\.'))); last=x+1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.352597, "o", "    pieces.append(r'(.{%d})'%(64-last))\r\n\u001b[?2004l\r"]
[183.35265, "o", "\u001b[?2004h> "]
