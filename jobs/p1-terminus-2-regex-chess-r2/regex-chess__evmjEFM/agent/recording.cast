[458.621363, "i", "python3 - <<'PY'\np='/tmp/gen.py'\ns=open(p).read()\nneedle=\"for n in range(8,1,-1):\\n    for _ in range(8):\\n        add(r'(?m)^([^ \\\\n]*)'+str(n), r'\\\\1'+'.'*n)\\n\"\nreplacement=needle+\"for _ in range(16):\\n    add(r'(?m)^([^ \\\\n]*)1', r'\\\\1.')\\n\"\nif needle not in s:\n    print('needle not found')\nelse:\n    s=s.replace(needle,replacement,1)\nopen(p,'w').write(s)\nPY\nsed -n '1,12p' /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print('rules',len(r),'bytes',os.path.getsize('/app/re.json'))\nfor name,s in [('sample','rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'),('fail','rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQKBNR w KQkq - 0 2')]:\n    for p,x in r:s=re.sub(p,x,s)\n    print(name,'count',len(s.splitlines()),'trailing',s.endswith('\\n'))\n    print(s[:1600])\nPY\n"]
