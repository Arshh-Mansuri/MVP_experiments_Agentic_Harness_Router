[248.180183, "o", "for n in range(8,1,-1):\r\n    for _ in range(8):\r\n        add(r'(?m)^([^ \\n]*)'+str(n), r'\\1'+'.'*n)\r\nadd(r'/', '')\r\n# Helpers for expanded 64-square boards.\r\ndef move_rule(s,d,p,put=None, target='[pnbrq.]', mids=(), ep='-'):\r\n    if put is None: put=p\r\n    look=''.join(r'(?=.{%d}\\.)'%(i) for i in mids)\r\n    if s<d:\r\n        pat=rf'(?m)^'+look+rf'(.{{{s}}}){p}(.{{{d-s-1}}}){target}(.{{{63-d}}}) w ([KQkq-]*) ([^ ]*) ([^\\n]*)$'\r\n        rep=rf'@{s:02d}{d:02d}\\1.\\2{put}\\3 b \\4 {ep} 0 0\\n\\g<0>'\r\n    else:\r\n        pat=rf'(?m)^'+look+rf'(.{{{d}}}){target}(.{{{s-d-1}}}){p}(.{{{63-s}}}) w ([KQkq-]*) ([^ ]*) ([^\\n]*)$'\r\n        rep=rf'@{s:02d}{d:02d}\\1{put}\\3.\\4 b \\5 {ep} 0 0\\n\\g<0>'\r\n    add(pat,rep)\r\ndef sq(r,c): return 8*r+c\r\n"]
