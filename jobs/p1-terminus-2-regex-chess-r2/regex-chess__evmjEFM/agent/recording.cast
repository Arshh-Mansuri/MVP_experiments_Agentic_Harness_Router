[229.422663, "o", "add(r'(?m)^([^ \\n]*)/', r'\\1/')\r\n# Helpers for expanded 64-square boards.\r\ndef move_rule(s,d,p,put=None, target='[pnbrq.]', mids=(), ep='-'):\r\n    if put is None: put=p\r\n    look=''.join(r'(?=.{%d}\\.)'%(i) for i in mids)\r\n    if s<d:\r\n        pat=rf'(?m)^'+look+rf'(.{{{s}}}){p}(.{{{d-s-1}}}){target}(.{{{63-d}}}) w ([KQkq-]*) ([^ ]*) ([^\\n]*)$'\r\n        rep=rf'@{s:02d}{d:02d}\\1.\\2{put}\\4 b \\5 {ep} 0 0\\n\\g<0>'\r\n    else:\r\n        pat=rf'(?m)^'+look+rf'(.{{{d}}}){target}(.{{{s-d-1}}}){p}(.{{{63-s}}}) w ([KQkq-]*) ([^ ]*) ([^\\n]*)$'\r\n        rep=rf'@{s:02d}{d:02d}\\1{put}\\3.\\4 b \\5 {ep} 0 0\\n\\g<0>'\r\n    add(pat,rep)\r\ndef sq(r,c): return 8*r+c\r\n# Knights and kings.\r\nfor s in range(64):\r\n    r,c=divmod(s,8)\r\n    for p,ds in [('N',[(2,1),(2,-1),(-2,1),(-2,-1),(1,2),(1,-2),(-1,2),(-1,-2)]),('K',[(a,b) for a in (-1,0,1) for b in (-1,0,1) if a or b])]:\r\n        for dr,dc in ds:\r\n            rr,cc=r+dr,c+dc\r\n            if 0<=rr<8 and 0<=cc<8: move_rule(s,sq(rr,cc),p)\r\n# Sliding pieces.\r\n"]
[229.691053, "i", "python3 - <<'PY'\np='/tmp/gen.py'\nlines=open(p).read().splitlines()\nfor i,line in enumerate(lines):\n    if \"rep=rf'@{s:02d}{d:02d}\" in line:\n        if \"\\\\1.\\\\2\" in line:\n            lines[i]=\"        rep=rf'@{s:02d}{d:02d}\\\\1.\\\\2{put}\\\\4 b \\\\5 {ep} 0 0\\\\n\\\\g<0>'\"\n        else:\n            lines[i]=\"        rep=rf'@{s:02d}{d:02d}\\\\1{put}\\\\3.\\\\4 b \\\\5 {ep} 0 0\\\\n\\\\g<0>'\"\nopen(p,'w').write('\\n'.join(lines)+'\\n')\nPY\nsed -n '12,23p' /tmp/gen.py\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\npython3 - <<'PY'\nimport json,re,os\nr=json.load(open('/app/re.json')); print(len(r),os.path.getsize('/app/re.json'))\ns='rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'\nfor p,x in r:s=re.sub(p,x,s)\nprint(repr(s)); print(len(s.splitlines()))\nPY\n"]
[229.691287, "o", "python3 - <<'PY'\r\np='/tmp/gen.py'\r\nlines=open(p).read().splitlines()\r\nfor i,line in enumerate(lines):\r\n    if \"rep=rf'@{s:02d}{d:02d}\" in line:\r\n        if \"\\\\1.\\\\2\" in line:\r\n            lines[i]=\"        rep=rf'@{s:02d}{d:02d}\\\\1.\\\\2{put}\\\\4 b \\\\5 {ep} 0 0\\\\n\\\\g<0>'\"\r\n        else:\r\n            lines[i]=\"        rep=rf'@{s:02d}{d:02d}\\\\1{put}\\\\3.\\\\4 b \\\\5 {ep} 0 0\\\\n\\\\g<0>'\"\r\nopen(p,'w').write('\\n'.join(lines)+'\\n')\r\nPY\r\nsed -n '12,23p' /tmp/gen.py\r\npython3 -m py_compile /tmp/gen.py && python3 /tmp/gen.py\r\npython3 - <<'PY'\r\nimport json,re,os\r\nr=json.load(open('/app/re.json')); print(len(r),os.path.getsize('/app/re.json'))\r\ns='rnb1k1nr/p2p1ppp/3B4/1p1NPN1P/6P1/3P1Q2/P1P5/q4Kb1 w kq - 0 1'\r\nfor p,x in r:s=re.sub(p,x,s)\r\nprint(repr(s)); print(len(s.splitlines()))\r\nPY\r\n"]
