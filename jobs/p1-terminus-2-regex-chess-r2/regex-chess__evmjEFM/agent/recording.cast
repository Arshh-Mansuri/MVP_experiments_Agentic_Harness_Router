[372.91974, "o", "add(r'\\\\.', '1')\r\n\u001b[?2004l\r\u001b[?2004h> add(r'\\\\|', '')\r\n\u001b[?2004l\r\u001b[?2004h> add(r'(?m)^\\\\s*$\\\\n?', '')\r\n\u001b[?2004l\r\u001b[?2004h> add(r'\\\\n\\\\Z', '')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+tail+s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
