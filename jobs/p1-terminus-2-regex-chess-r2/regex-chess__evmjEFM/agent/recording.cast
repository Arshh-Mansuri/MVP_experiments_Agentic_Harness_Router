[482.173642, "o", "93-# Candidate format at this stage: @ssdd + 64 board chars + \" b RIGHTS EP ...\".\r\n94-for prefix,rights in [('@60','KQ'),('@56','Q'),('@63','K')]:\r\n95-    for ch in rights:\r\n96-        add(r'(?m)^('+prefix+r'\\d{2}.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\r\n97-# Capturing a rook on a1/h1 also removes the corresponding right.\r\n98-for dst,ch in [('56','Q'),('63','K')]:\r\n99-    add(r'(?m)^(@\\d{2}'+dst+r'.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\r\n100-# Remove lines whose candidate king is attacked by any black piece.\r\n101-def reject(prefix, k, a, required, between=()):\r\n102-    attacker = required if len(required)==1 else '['+required+']'\r\n103-    cons=''.join(r'(?=.{%d}%s)'%(prefix+i,x) for i,x in [(k,'K'),(a,attacker)])\r\n104-    cons+=''.join(r'(?=.{%d}\\.)'%(prefix+i) for i in between)\r\n"]
