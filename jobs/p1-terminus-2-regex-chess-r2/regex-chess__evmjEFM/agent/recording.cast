[482.007871, "o", "\u001b[?2004h> p='/tmp/gen.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> needle='# Remove lines whose candidate king is attacked by any black piece.\\n'\r\n\u001b[?2004l\r\u001b[?2004h> block=r'''# Update white castling rights on candidate moves.\r\n\u001b[?2004l\r\u001b[?2004h> # Candidate format at this stage: @ssdd + 64 board chars + \" b RIGHTS EP ...\".\r\n\u001b[?2004l\r\u001b[?2004h> for prefix,rights in [('@60','KQ'),('@56','Q'),('@63','K')]:\r\n\u001b[?2004l\r\u001b[?2004h>     for ch in rights:\r\n\u001b[?2004l\r\u001b[?2004h>         add(r'(?m)^('+prefix+r'\\d{2}.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\r\n\u001b[?2004l\r\u001b[?2004h> # Capturing a rook on a1/h1 also removes the corresponding right.\r\n\u001b[?2004l\r\u001b[?2004h> for dst,ch in [('56','Q'),('63','K')]:\r\n\u001b[?2004l\r\u001b[?2004h>     add(r'(?m)^(@\\d{2}'+dst+r'.{64} b )([^ \\n]*)'+ch+r'([^ \\n]* .*)$', r'\\1\\2\\3')\r\n\u001b[?2004l\r\u001b[?2004h> "]
