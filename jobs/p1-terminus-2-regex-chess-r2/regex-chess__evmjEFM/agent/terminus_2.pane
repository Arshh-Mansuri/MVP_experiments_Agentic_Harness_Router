            lines[i]="        rep=rf'@{s:02d}{d:02d}\\1.\\2{put}\\4 b \\5 {ep} 0 0\\n\\g<0>'"
        else:
            lines[i]="        rep=rf'@{s:02d}{d:02d}\\1{put}\\3.\\4 b \\5 {ep} 0 0\\n\\g<0>'"
open(p,'w').write('\n'.join(lines)+'\n')
