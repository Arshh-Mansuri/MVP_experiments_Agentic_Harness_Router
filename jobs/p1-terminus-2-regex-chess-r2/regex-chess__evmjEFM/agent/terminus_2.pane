R=[]
def add(p,r): R.append([p,r])
# Expand only board digits, repeatedly, before the first space.
for n in range(8,1,-1):
    for _ in range(8):
        add(r'(?m)^([^ \n]*)'+str(n), r'\1'+'.'*n)
for _ in range(16):
    add(r'(?m)^([^ \n]*)1', r'\1.')
add(r'/', '')
