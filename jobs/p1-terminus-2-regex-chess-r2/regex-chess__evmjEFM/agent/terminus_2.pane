# En passant: white pawn on rank 5, target ep square on rank 6, adjacent black pawn.
def ep_rule(c,dc):
    tc=c+dc; s=sq(3,c); d=sq(2,tc); cap=sq(3,tc)
    # Capture the three relevant squares with segmented groups.
    xs=sorted([s,d,cap]); chars={s:'P',d:'\\.',cap:'p'}
    pieces=[]; last=0
    for x in xs:
        pieces.append(r'(.{%d})%s'%(x-last,chars[x])); last=x+1
    pieces.append(r'(.{%d})'%(64-last))
    # groups are board segments, then rights and counters
    pat=rf'(?m)^'+''.join(pieces)+rf'\\| w ([KQkq-]*) {"abcdefgh"[tc]}6 ([^\\n]*)$'
    refs=[]; out=[]
    for i,x in enumerate(xs):
        out.append(r'\%d'% (i+1))
        out.append('.' if x in (s,cap) else 'P')
    out.append(r'\%d'%(len(xs)+1))
    rep='@%02d%02d'%(s,d)+''.join(out)+rf'| b \{len(xs)+2} - 0 0\n\g<0>'
    add(pat,rep)
for c in range(8):
    for dc in (-1,1):
        if 0<=c+dc<8: ep_rule(c,dc)
# Castling. Candidate marker @Ck or @Cq, with final board already transformed.
def castle(kind, right, empties, old, new):
    # old/new maps changed squares; capture every interval segment.
    points=sorted(set(old)|set(new)); pieces=[]; last=0
    for x in points:
        expected=old.get(x,'.')
        pieces.append(r'(.{%d})%s'%(x-last, expected.replace('.','\\.'))); last=x+1
    pieces.append(r'(.{%d})'%(64-last))
    rights_pat=rf'(?=[^\\n]*\\| w [^ ]*{right})'
    pat=rf'(?m)^{rights_pat}'+''.join(pieces)+rf'\\| w ([KQkq-]*) ([^ ]*) ([^\\n]*)$'
    vals=[]
    for x in points: vals.append(new.get(x,old.get(x,'.')))
    rep='@C'+kind
    for i,x in enumerate(points): rep+=rf'\{i+1}'+vals[i]
    rep+=rf'\{len(points)+1}| b \{len(points)+2} - 0 0\n\g<0>'
    add(pat,rep)
