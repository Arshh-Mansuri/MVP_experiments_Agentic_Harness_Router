# Helpers for expanded 64-square boards.
def move_rule(s,d,p,put=None, target='[pnbrq.]', mids=(), ep='-'):
    if put is None: put=p
    look=''.join(r'(?=.{%d}\.)'%(i) for i in mids)
    if s<d:
        pat=rf'(?m)^'+look+rf'(.{{{s}}}){p}(.{{{d-s-1}}}){target}(.{{{63-d}}}) w ([KQkq-]*) ([^ ]*) ([^\n]*)$'
        rep=rf'@{s:02d}{d:02d}\1.\2{put}\3 b \4 {ep} 0 0\n\g<0>'
    else:
        pat=rf'(?m)^'+look+rf'(.{{{d}}}){target}(.{{{s-d-1}}}){p}(.{{{63-s}}}) w ([KQkq-]*) ([^ ]*) ([^\n]*)$'
        rep=rf'@{s:02d}{d:02d}\1{put}\3.\4 b \5 {ep} 0 0\n\g<0>'
    add(pat,rep)
def sq(r,c): return 8*r+c
