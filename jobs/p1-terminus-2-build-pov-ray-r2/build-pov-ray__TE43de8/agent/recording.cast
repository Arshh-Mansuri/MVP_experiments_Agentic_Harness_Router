[286.975406, "o", "for id in pov-ray-3 Raytrace_The_Official_POV-RAY_CD-ROM_Walnut_Creek_April_1995 tucows_9887_POV-Ray; do echo \"=== $id\"; curl -sS --connect-timeout 10 --max-time 20 \"https://archive.org/metadata/$id\" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"is_dark\"),d.get(\"metadata\",{}).get(\"title\"),d.get(\"files_count\"),d.get(\"server\"),d.get(\"dir\"))' || true; done\r\n\u001b[?2004l\r"]
