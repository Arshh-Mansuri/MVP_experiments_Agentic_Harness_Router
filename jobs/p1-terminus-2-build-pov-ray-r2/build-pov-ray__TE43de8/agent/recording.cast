[286.970349, "o", "\u001b[33mc3ce13e\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mmaster\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/master\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Update development status in README.md\u001b[m\r\n\u001b[33m6dd2dca\u001b[m [ci skip] Update README.md\u001b[m\r\n\u001b[33m486274b\u001b[m Update README.md with a development status note. Also update the maintained label.\u001b[m\r\n\u001b[33md3b2ad1\u001b[m Update README.md with https links, remove mention of Mac binary.\u001b[m\r\n\u001b[33m67be43e\u001b[m Fixes to scenes/advanced/pawns.pov (#455)\u001b[m\r\n\u001b[33mce11787\u001b[m Merge pull request #456 from luzpaz/various-typos\u001b[m\r\n\u001b[33maa941ed\u001b[m Fix various typos\u001b[m\r\n\u001b[33m76a804d\u001b[m\u001b[33m (\u001b[m\u001b[1;33mtag: \u001b[m\u001b[1;33mgh-actions-v2\u001b[m\u001b[33m)\u001b[m [ci skip] Update GitHub `windows_build` Action to flag builds as official.\u001b[m\r\n\u001b[33m3bad494\u001b[m [ci skip] Clean up obsolete GitHub Actions.\u001b[m\r\n\u001b[33m1cd2788\u001b[m\u001b[33m (\u001b[m\u001b[1;33mtag: \u001b[m\u001b[1;33mgh-actions-v1\u001b[m\u001b[33m)\u001b[m More work on GitHub Actions.\u001b[m\r\n\u001b[33m187e8dc\u001b[m [ci skip] Fix bug in the previous commit 91f28b40.\u001b[m\r\n\u001b[33m91f28b4\u001b[m [ci skip] Update GitHub actions to b"]
[286.97054, "o", "uild versions that still need boost thread library.\u001b[m\r\n\u001b[33m7af8c05\u001b[m Update project status badges.\u001b[m\r\n\u001b[33m86f410a\u001b[m Fix Visual Studio specific compile-time configuration broken by 37b99bd1.\u001b[m\r\n\u001b[33me84e7bb\u001b[m Fix repo name in GitHub workflows.\u001b[m\r\n\u001b[33m1ba1069\u001b[m Set up GitHub Actions for build testing..\u001b[m\r\n\u001b[33mf79bb3d\u001b[m [ci skip] General fix for auto-build branches.\u001b[m\r\n\u001b[33m036b84a\u001b[m Miscellaneous Housekeeping (#409)\u001b[m\r\n\u001b[33m37b99bd\u001b[m Miscellaneous hosekeeping.\u001b[m\r\n\u001b[33m110df4f\u001b[m Fix `.gitignore` to catch a few files created by Windows build process.\u001b[m\r\n"]
