[11.613334, "i", "for i in $(seq 1 60); do if (echo >/dev/tcp/127.0.0.1/6665) >/dev/null 2>&1; then echo \"QEMU telnet console is ready on 127.0.0.1:6665\"; exit 0; fi; if ! kill -0 \"$(cat /app/qemu-alpine.pid)\" 2>/dev/null; then echo 'QEMU exited'; cat /app/qemu-alpine.log; exit 1; fi; sleep 1; done; echo 'Timed out waiting for telnet console'; cat /app/qemu-alpine.log; exit 1\n"]
