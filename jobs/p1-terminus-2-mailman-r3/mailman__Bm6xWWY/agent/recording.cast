[163.901927, "i", "postconf -M 2>/dev/null | head -80; postconf compatibility_level myhostname mydomain mydestination virtual_alias_maps transport_maps local_transport virtual_transport mailbox_command home_mailbox 2>/dev/null || true\n"]
[163.902697, "o", "postconf -M 2>/dev/null | head -80; postconf compatibility_level myhostname mydomain mydestination virtual_alias_maps transport_maps local_transport virtual_transport mailbox_command home_mailbox 2>/dev/null || true\r\n\u001b[?2004l\r"]
[163.93876, "o", "smtp       inet  n       -       y       -       -       smtpd\r\npickup     unix  n       -       y       60      1       pickup\r\ncleanup    unix  n       -       y       -       0       cleanup\r\nqmgr       unix  n       -       n       300     1       qmgr\r\ntlsmgr     unix  -       -       y       1000?   1       tlsmgr\r\nrewrite    unix  -       -       y       -       -       trivial-rewrite\r\nbounce     unix  -       -       y       -       0       bounce\r\ndefer      unix  -       -       y       -       0       bounce\r\ntrace      unix  -       -       y       -       0       bounce\r\nverify     unix  -       -       y       -       1       verify\r\nflush      unix  n       -       y       1000?   0       flush\r\nproxymap   unix  -       -       n       -       -       proxymap\r\nproxywrite unix  -       -       n       -       1       proxymap\r\nsmtp       unix  -       -       y       -       -       smtp\r\nrelay      unix  -       -       y       -       -       smtp -o syslog_name=postfix/$service_name\r\nshowq      unix  n       -       y       -       -       showq\r\nerror      unix  -       -       y       -       -       error\r\nretry      unix  -       -       y       -       -       error\r\ndiscard    unix  -       -       y       -       -       discard\r\nlocal      unix  -       n       n       -       -       local\r\nvirtual    unix  -       n       n       -       -       virtual\r\nlmtp       unix  -       -       y       -       -       lmtp\r\nanvil      unix  -       -       y       -       1       anvil\r\nscache     unix  -       -       y       -       1       scache\r\npostlog    unix-dgram n  -       n       -       1       postlogd\r\nuucp       unix  -       n       n       -       -       pipe flags=Fqhu user=uucp argv=uux -r -n -z -a$sender - $nexthop!rmail ($recipient)\r\n"]
[164.002834, "o", "compatibility_level = 3.6\r\nmyhostname = localhost.local\r\nmydomain = local\r\nmydestination = $myhostname, localhost, localhost.localdomain, , localhost\r\nvirtual_alias_maps = $virtual_maps\r\ntransport_maps =\r\nlocal_transport = local:$myhostname\r\nvirtual_transport = virtual\r\nmailbox_command =\r\nhome_mailbox =\r\n"]
