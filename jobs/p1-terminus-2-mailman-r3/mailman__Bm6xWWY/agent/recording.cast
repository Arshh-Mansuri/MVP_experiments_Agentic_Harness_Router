[64.71196, "o", "python3 - <<'PY'\r\nfrom mailman.core.initialize import initialize\r\nfrom mailman.config import config\r\nfrom zope.component import getUtility\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom mailman.interfaces.mailinglist import SubscriptionPolicy\r\ninitialize('/etc/mailman3/mailman.cfg')\r\nmlist = getUtility(IListManager).get('reading-group@local.edu')\r\nprint('list:', mlist)\r\nprint('old subscription policy:', mlist.subscription_policy)\r\nmlist.subscription_policy = SubscriptionPolicy.open\r\nprint('new subscription policy:', mlist.subscription_policy)\r\nPY\r\n/usr/bin/mailman --run-as-root -C /etc/mailman3/mailman.cfg aliases; find /var/lib/mailman3 -type f \\( -name '*alias*' -o -name '*transport*' \\) -print -exec sh -c 'echo --- $1; head -30 \"$1\"' sh {} \\;\r\n"]
