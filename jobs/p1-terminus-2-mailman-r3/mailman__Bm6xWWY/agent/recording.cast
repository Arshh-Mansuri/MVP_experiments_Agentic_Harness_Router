[162.916791, "i", "echo '-- postfix_domains --'; cat /var/lib/mailman3/data/postfix_domains; echo '-- postfix_lmtp --'; cat /var/lib/mailman3/data/postfix_lmtp; echo '-- main.cf --'; cat /etc/postfix/main.cf; echo '-- master services --'; grep -nE '^(smtp|submission|pickup|cleanup|qmgr|local|virtual|relay|maildrop|#)' /etc/postfix/master.cf | head -100\n"]
[162.918172, "o", "echo '-- postfix_domains --'; cat /var/lib/mailman3/data/postfix_domains; echo '-- postfix_lmtp --'; cat /var/lib/mailman3/data/postfix_lmtp; echo '-- main.cf --'; cat /etc/postfix/main.cf; echo '-- master services --'; grep -nE '^(smtp|submission|pickup|cleanup|qmgr|local|virtual|relay|maildrop|#)' /etc/postfix/master.cf | head -100\r\n\u001b[?2004l\r"]
