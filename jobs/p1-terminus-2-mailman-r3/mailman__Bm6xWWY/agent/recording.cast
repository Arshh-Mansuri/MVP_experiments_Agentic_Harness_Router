[24.275707, "o", "\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[Kd_banner = $myhostname ESMTP $mail_name (Ubuntu)\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[Kd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[Kd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[Kd_tls_security_level=may\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[K_tls_CApath=/etc/ssl/certs\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[K_tls_security_level=may\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[K_tls_session_cache_database = btree:${data_directory}/smtp_scache\r\n\u001b[35m\u001b[K/etc/postfix/main.cf\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ksmtp\u001b[m\u001b[Kd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\r\n"]
