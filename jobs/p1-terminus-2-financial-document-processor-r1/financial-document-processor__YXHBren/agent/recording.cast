[305.352955, "i", "python3 - <<'PY'\nfrom decimal import Decimal\nimport csv, os, shutil\nbase='/app'; src=base+'/documents'; invdir=base+'/invoices'; otherdir=base+'/other'\nos.makedirs(invdir,exist_ok=True); os.makedirs(otherdir,exist_ok=True)\nrows=[\n ('2lgKzDuI4E4g.jpg','6558','0'),\n ('JOiylq2_7S18.jpg','6860.45','623.68'),\n ('KrJiw0OZx7jf.jpg','9963','0'),\n ('ivE2mt3HwvEO.jpg','819.06','74.46'),\n ('lxtL9XrYRsVG.jpg','797.91','72.54'),\n ('vvK89XK847m3.jpg','6204.19','564.02'),\n ('w0i40MJP2Dzm.jpg','44745.59','4067.78'),\n ('T0r6Ou8zvqTA.pdf','4031','0'),\n ('UsN9tVTKskms.pdf','896','0'),\n ('wIQEB5nR79b2.pdf','440','0'),\n]\nothers=['6NVuAIhTV4KB.jpg','F0oZMhSUm2dO.jpg','QOoA_j33PD_E.jpg','WqWMArQQlSMv.jpg','GFAlpKoFg81H.pdf','dvkRkFVFhHga.pdf','dx0AWchV01ZJ.pdf']\ntotal=Decimal('0'); vat=Decimal('0')\nwith open(invdir+'/summary.csv','w',newline='') as f:\n w=csv.writer(f); w.writerow(['filename','total_amount','vat_amount'])\n for fn,t,v in rows:\n  w.writerow([fn,t,v]); total+=Decimal(t); vat+=Decimal(v)\n w.writerow(['total',str(total),str(vat)])\nfor fn,_,_ in rows: shutil.move(src+'/'+fn, invdir+'/'+fn)\nfor fn in others: shutil.move(src+'/'+fn, otherdir+'/'+fn)\nprint('TOTAL',total,'VAT',vat)\nPY\n"]
