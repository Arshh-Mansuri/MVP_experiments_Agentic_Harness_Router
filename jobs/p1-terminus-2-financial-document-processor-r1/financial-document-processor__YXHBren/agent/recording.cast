[21.105886, "i", "python3 - <<'PY'\nimport glob,os,re,zlib,base64\nfor p in sorted(glob.glob('/app/documents/*.pdf')):\n print('\\n### '+os.path.basename(p)+' ###')\n d=open(p,'rb').read()\n for n,m in enumerate(re.finditer(rb'stream\\r?\\n(.*?)\\r?\\nendstream',d,re.S),1):\n  x=m.group(1)\n  try:\n   if b'/ASCII85Decode' in d[max(0,m.start()-200):m.start()]: x=base64.a85decode(x, adobe=True)\n   if b'/FlateDecode' in d[max(0,m.start()-200):m.start()]: x=zlib.decompress(x)\n  except Exception as e: print('stream',n,'decode error',e); continue\n  print('--- stream',n,'---')\n  print(x.decode('latin1','ignore'))\nPY\n"]
