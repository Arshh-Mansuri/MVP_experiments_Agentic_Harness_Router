[39.139762, "i", "command -v tesseract; command -v pdftotext; command -v identify; command -v file; file /app/documents/*\n"]
[39.14146, "o", "command -v tesseract; command -v pdftotext; command -v identify; command -v file; file /app/documents/*\r\n"]
[49.970669, "i", "echo '--- tools ---'; command -v tesseract || true; command -v pdftotext || true; command -v identify || true; command -v file || true; echo '--- files ---'; file /app/documents/* 2>/dev/null || true\n"]
[49.973756, "o", "echo '--- tools ---'; command -v tesseract || true; command -v pdftotext || true; command -v identify || true; command -v file || true; echo '--- files ---'; file /app/documents/* 2>/dev/null || true\r\n"]
[50.446661, "i", "rm -rf /tmp/doc_extract && mkdir -p /tmp/doc_extract/pdf /tmp/doc_extract/jpg; for f in /app/documents/*.pdf; do b=$(basename \"$f\" .pdf); pdftotext -layout \"$f\" \"/tmp/doc_extract/pdf/$b.txt\" 2>/dev/null || true; done; for f in /app/documents/*.jpg; do b=$(basename \"$f\" .jpg); tesseract \"$f\" \"/tmp/doc_extract/jpg/$b\" 2>/dev/null || true; done; echo '--- extracted text ---'; for f in /tmp/doc_extract/pdf/*.txt /tmp/doc_extract/jpg/*.txt; do echo \"### $(basename \"$f\") ###\"; cat \"$f\"; done\n"]
[50.447594, "o", "rm -rf /tmp/doc_extract && mkdir -p /tmp/doc_extract/pdf /tmp/doc_extract/jpg; for f in /app/documents/*.pdf; do b=$(basename \"$f\" .pdf); pdftotext -layout \"$f\" \"/tmp/doc_extract/pdf/$b.txt\" 2>/dev/null || true; done; for f in /app/documents/*.jpg; do b=$(basename \"$f\" .jpg); tesseract \"$f\" \"/tmp/doc_extract/jpg/$b\" 2>/dev/null || true; done; echo '--- extracted text ---'; for f in /tmp/doc_extract/pdf/*.txt /tmp/doc_extract/jpg/*.txt; do echo \"### $(basename \"$f\") ###\"; cat \"$f\"; done\r\n"]
[72.145481, "i", "printf '\\nREADY\\n'; command -v tesseract || true; command -v pdftotext || true; command -v file || true; printf 'DOCS=%s\\n' \"$(find /app/documents -maxdepth 1 -type f | wc -l)\"\n"]
[72.147865, "o", "printf '\\nREADY\\n'; command -v tesseract || true; command -v pdftotext || true; command -v file || true; printf 'DOCS=%s\\n' \"$(find /app/documents -maxdepth 1 -type f | wc -l)\"\r\n"]
[73.142623, "i", "mkdir -p /tmp/doc_extract/pdf /tmp/doc_extract/jpg; for f in /app/documents/*.pdf; do b=$(basename \"$f\" .pdf); echo \"PDF $b\"; pdftotext -layout \"$f\" \"/tmp/doc_extract/pdf/$b.txt\" 2>&1 || echo FAIL; done; echo PDF_DONE\n"]
[73.144355, "o", "mkdir -p /tmp/doc_extract/pdf /tmp/doc_extract/jpg; for f in /app/documents/*.pdf; do b=$(basename \"$f\" .pdf); echo \"PDF $b\"; pdftotext -layout \"$f\" \"/tmp/doc_extract/pdf/$b.txt\" 2>&1 || echo FAIL; done; echo PDF_DONE\r\n"]
[76.469106, "i", "for f in /app/documents/*.jpg; do b=$(basename \"$f\" .jpg); echo \"JPG $b\"; tesseract \"$f\" \"/tmp/doc_extract/jpg/$b\" 2>&1 || echo FAIL; done; echo JPG_DONE\n"]
[76.471006, "o", "for f in /app/documents/*.jpg; do b=$(basename \"$f\" .jpg); echo \"JPG $b\"; tesseract \"$f\" \"/tmp/doc_extract/jpg/$b\" 2>&1 || echo FAIL; done; echo JPG_DONE\r\n"]
[91.385564, "i", "for f in /tmp/doc_extract/pdf/*.txt /tmp/doc_extract/jpg/*.txt; do [ -f \"$f\" ] || continue; echo \"### $(basename \"$f\") ###\"; cat \"$f\"; done\n"]
