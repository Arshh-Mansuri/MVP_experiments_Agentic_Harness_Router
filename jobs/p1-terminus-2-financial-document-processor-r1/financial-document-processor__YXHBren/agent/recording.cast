[174.034238, "i", "echo '--- tools ---'; command -v tesseract; command -v pdftotext; command -v identify; command -v file; rm -rf /tmp/doc_extract; mkdir -p /tmp/doc_extract/pdf /tmp/doc_extract/jpg; for f in /app/documents/*.pdf; do b=$(basename \"$f\" .pdf); echo \"PDF $b\"; pdftotext -layout \"$f\" \"/tmp/doc_extract/pdf/$b.txt\" 2>/dev/null || true; done; for f in /app/documents/*.jpg; do b=$(basename \"$f\" .jpg); echo \"JPG $b\"; tesseract \"$f\" \"/tmp/doc_extract/jpg/$b\" 2>/dev/null || true; done; echo EXTRACT_DONE\n"]
