[254.784146, "i", "python3 - <<'PY'\nimport glob,os,re\npat=re.compile(r'invoice|receipt|statement|total|amount|due|vat|tax|gst|gross|net worth|subtotal|balance',re.I)\nfor f in sorted(glob.glob('/tmp/doc_extract/pdf/*.txt')+glob.glob('/tmp/doc_extract/jpg/*.txt')):\n lines=open(f,errors='ignore').read().splitlines()\n print('\\n###',os.path.basename(f),'###')\n print(' | '.join(x.strip() for x in lines if x.strip() and pat.search(x))[:2500] or '[no keywords]')\nPY\n"]
