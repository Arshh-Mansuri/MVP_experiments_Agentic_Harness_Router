[117.126012, "i", "cd /app && python3 - <<'PY'\np = 'program.py'\ns = open(p).read()\ns = s.replace(\"    # INPUT-RECORD is exactly 15 bytes; COBOL reads one record only.\\n    rec = raw_input[:15]\\n    buyer = rec[0:4]\\n    seller = rec[4:8]\\n    book_id = rec[8:12]\\n    amount_field = rec[12:22]  # normally unavailable; retained for clarity\\n    # The supplied input FD defines 4 + 4 + 4 + 10 = 22 bytes.  Use the\\n    # complete record when present, while remaining compatible with malformed\\n    # short files by taking the amount after the three identifiers.\\n    if len(raw_input) >= 22:\\n        rec = raw_input[:22]\\n        buyer, seller, book_id = rec[0:4], rec[4:8], rec[8:12]\\n        amount_field = rec[12:22]\\n    amount = int(amount_field.decode('ascii') or '0')\", \"    # COBOL reads one sequential record.  The supplied input is commonly\\n    # shorter than the declared 22-byte FD record; GnuCOBOL fills the\\n    # missing trailing numeric positions with zero bytes/characters.\\n    rec = raw_input[:22]\\n    buyer = rec[0:4]\\n  "]
[117.136386, "o", "cd /app && python3 - <<'PY'\r\n"]
[117.136662, "i", "  seller = rec[4:8]\\n    book_id = rec[8:12]\\n    amount_field = rec[12:22].ljust(10, b'0')\\n    amount = int(amount_field.decode('ascii') or '0')\")\nopen(p, 'w').write(s)\nPY\npython3 -m py_compile program.py\nset -e\nrm -rf /tmp/bookforum-check2\nmkdir -p /tmp/bookforum-check2/orig /tmp/bookforum-check2/cobol /tmp/bookforum-check2/python\ncp data/*.DAT src/INPUT.DAT /tmp/bookforum-check2/orig/\nprintf 'U001U002B002200' > src/INPUT.DAT\ncobc -x -o /tmp/bookforum-check2/bookforum src/program.cbl\n/tmp/bookforum-check2/bookforum > /tmp/bookforum-check2/cobol/stdout\ncp data/*.DAT /tmp/bookforum-check2/cobol/\ncp /tmp/bookforum-check2/orig/*.DAT data/\npython3 program.py > /tmp/bookforum-check2/python/stdout\ncp data/*.DAT /tmp/bookforum-check2/python/\nfor f in ACCOUNTS.DAT BOOKS.DAT TRANSACTIONS.DAT; do cmp -s /tmp/bookforum-check2/cobol/$f /tmp/bookforum-check2/python/$f && echo \"$f: identical\" || echo \"$f: DIFFERENT\"; done\ncat /tmp/bookforum-check2/cobol/stdout /tmp/bookforum-check2/python/stdout\ncp /tmp/bookforum-check2/"]
[117.136708, "o", "\u001b[?2004l\r\u001b[?2004h> p = 'program.py'\r\n\u001b[?2004l\r\u001b[?2004h> s = open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"    # INPUT-RECORD is exactly 15 bytes; COBOL reads one record only.\\n    rec = raw_input[:15]\\n    buyer = rec[0:4]\\n    seller = rec[4:8]\\n    book_id = rec[8:12]\\n    amount_field = rec[12:22]  # normally unavailable; retained for clarity\\n    # The supplied input FD defines 4 + 4 + 4 + 10 = 22 bytes.  Use the\\n    # complete record when present, while remaining compatible with malformed\\n    # short files by taking the amount after the three identifiers.\\n    if len(raw_input) >= 22:\\n        rec = raw_input[:22]\\n        buyer, seller, book_id = rec[0:4], rec[4:8], rec[8:12]\\n        amount_field = rec[12:22]\\n    amount = int(amount_field.decode('ascii') or '0')\", \"    # COBOL reads one sequential record.  The supplied input is commonly\\n    # shorter than the declared 22-byte FD record; GnuCOBOL fills the\\n    # missing trailing numeric positions with zero bytes/characters.\\n    rec = raw_input"]
[117.136724, "i", "orig/*.DAT data/\ncp /tmp/bookforum-check2/orig/INPUT.DAT src/INPUT.DAT\n"]
[117.136977, "o", "[:22]\\n    buyer = rec[0:4]\\n  "]
[117.138923, "o", "  seller = rec[4:8]\\n    book_id = rec[8:12]\\n    amount_field = rec[12:22].ljust(10, b'0')\\n    amount = int(amount_field.decode('ascii') or '0')\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
