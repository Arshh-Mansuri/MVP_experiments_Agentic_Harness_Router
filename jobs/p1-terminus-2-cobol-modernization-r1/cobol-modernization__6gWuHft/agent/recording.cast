[66.94134, "o", "    accounts_path.write_bytes(accounts)\r\n\u001b[?2004l\r"]
[66.944862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for offset in range(0, len(books) - BOOK_SIZE + 1, BOOK_SIZE):\r\n\u001b[?2004l\r\u001b[?2004h>         if bytes(books[offset:offset + 4]) == book_id:\r\n\u001b[?2004l\r\u001b[?2004h>             books[offset + 24:offset + 28] = buyer\r\n\u001b[?2004l\r\u001b[?2004h>     books_path.write_bytes(books)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     transaction = book_id + amount_bytes + seller + buyer\r\n\u001b[?2004l\r\u001b[?2004h>     with transactions_path.open('ab') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(transaction)\r\n\u001b[?2004l\r\u001b[?2004h>     print('Transaction completed successfully')\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
