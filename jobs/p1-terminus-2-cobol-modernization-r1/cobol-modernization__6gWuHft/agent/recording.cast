[66.923111, "i", "cat > /app/program.py <<'PY'\n#!/usr/bin/env python3\nfrom pathlib import Path\n\nROOT = Path('/app')\nDATA = ROOT / 'data'\nINPUT = ROOT / 'src' / 'INPUT.DAT'\n\nACCOUNT_SIZE = 34\nBOOK_SIZE = 28\nTRANSACTION_SIZE = 22\n\n\ndef records(blob, size):\n    return [blob[i:i + size] for i in range(0, len(blob), size) if len(blob[i:i + size]) == size]\n\n\ndef main():\n    raw_input = INPUT.read_bytes()\n    if not raw_input:\n        print('Error: Input file is empty')\n        return 0\n\n    # INPUT-RECORD is exactly 15 bytes; COBOL reads one record only.\n    rec = raw_input[:15]\n    buyer = rec[0:4]\n    seller = rec[4:8]\n    book_id = rec[8:12]\n    amount_field = rec[12:22]  # normally unavailable; retained for clarity\n    # The supplied input FD defines 4 + 4 + 4 + 10 = 22 bytes.  Use the\n    # complete record when present, while remaining compatible with malformed\n    # short files by taking the amount after the three identifiers.\n    if len(raw_input) >= 22:\n        rec = raw_input[:22]\n        buyer, seller, book_id = rec[0:4], "]
[66.923826, "i", "rec[4:8], rec[8:12]\n        amount_field = rec[12:22]\n    amount = int(amount_field.decode('ascii') or '0')\n\n    accounts_path = DATA / 'ACCOUNTS.DAT'\n    books_path = DATA / 'BOOKS.DAT'\n    transactions_path = DATA / 'TRANSACTIONS.DAT'\n\n    accounts = bytearray(accounts_path.read_bytes())\n    books = bytearray(books_path.read_bytes())\n\n    account_records = records(accounts, ACCOUNT_SIZE)\n    book_records = records(books, BOOK_SIZE)\n    buyer_found = any(r[0:4] == buyer for r in account_records)\n    seller_found = any(r[0:4] == seller for r in account_records)\n    matching_books = [r for r in book_records if r[0:4] == book_id]\n    book_found = bool(matching_books)\n    valid_owner = any(r[24:28] == seller for r in matching_books)\n\n    if not (buyer_found and seller_found and book_found and valid_owner):\n        print('Transaction failed due to validation errors')\n        return 0\n\n    amount_bytes = f'{amount:010d}'.encode('ascii')\n    for offset in range(0, len(accounts) - ACCOUNT_SIZE + 1, ACCOUNT_SIZE):\n  "]
[66.923847, "i", "      ident = bytes(accounts[offset:offset + 4])\n        if ident == buyer or ident == seller:\n            balance = int(bytes(accounts[offset + 24:offset + 34]).decode('ascii'))\n            if ident == buyer:\n                balance -= amount\n            if ident == seller:\n                balance += amount\n            accounts[offset + 24:offset + 34] = f'{balance:010d}'.encode('ascii')\n    accounts_path.write_bytes(accounts)\n\n    for offset in range(0, len(books) - BOOK_SIZE + 1, BOOK_SIZE):\n        if bytes(books[offset:offset + 4]) == book_id:\n            books[offset + 24:offset + 28] = buyer\n    books_path.write_bytes(books)\n\n    transaction = book_id + amount_bytes + seller + buyer\n    with transactions_path.open('ab') as f:\n        f.write(transaction)\n    print('Transaction completed successfully')\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nchmod +x /app/program.py\npython3 -m py_compile /app/program.py\nsha256sum /app/data/*.DAT\npython3 /app/program.py\nsha256sum /app/da"]
