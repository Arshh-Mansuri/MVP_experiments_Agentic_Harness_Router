Require Import Arith.

Theorem plus_comm : forall n m : nat,
  n + m = m + n.
Proof.
  intros n m.
  induction n as [|n' IHn'].
  - simpl.
    apply plus_n_O.
  - simpl.
    rewrite IHn'.
    apply plus_n_Sm.
Qed.
