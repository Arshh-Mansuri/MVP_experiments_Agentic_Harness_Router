[161.049719, "i", "python3 - <<'PY'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\nprint('loading dataset')\nds = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata', split='train')\nprint(ds)\nprint('domains:', ds['domain'])\nscience = ds.filter(lambda x: str(x['domain']).lower() == 'science')\nprint('science rows:', len(science))\nprint('loading tokenizer')\ntok = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct', use_fast=True)\nreasoning = science['deepseek_reasoning']\nsolution = science['deepseek_solution']\nreasoning_n = sum(len(x) for x in tok(reasoning, add_special_tokens=False)['input_ids'])\nsolution_n = sum(len(x) for x in tok(solution, add_special_tokens=False)['input_ids'])\ncombined_n = sum(len(tok(r + s, add_special_tokens=False)['input_ids']) for r,s in zip(reasoning, solution))\nprint('reasoning tokens:', reasoning_n)\nprint('solution tokens:', solution_n)\nprint('reasoning+solution separate:', reasoning_n + solution_n)\nprint('concatenated tokens:', combined_n)\nPY\n"]
[161.050053, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
