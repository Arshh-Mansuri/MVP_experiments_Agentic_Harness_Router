[222.018066, "i", "python3 - <<'PY'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\nds = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata', split='train')\nscience = [i for i, d in enumerate(ds['domain']) if d in {'physics', 'chemistry', 'biology'}]\ntok = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct', use_fast=True)\nreasoning = [ds['deepseek_reasoning'][i] for i in science]\nsolution = [ds['deepseek_solution'][i] for i in science]\nr_counts = [len(x) for x in tok(reasoning, add_special_tokens=False)['input_ids']]\ns_counts = [len(x) for x in tok(solution, add_special_tokens=False)['input_ids']]\nr_total = sum(r_counts)\ns_total = sum(s_counts)\ntotal = r_total + s_total\nprint('science rows:', len(science))\nprint('reasoning:', r_total)\nprint('solution:', s_total)\nprint('total:', total)\nprint('joined newline:', sum(len(tok(r + '\\n' + s, add_special_tokens=False)['input_ids']) for r,s in zip(reasoning, solution)))\nopen('/app/answer.txt', 'w').write(str(total))\nPY\ncat /app/answer.txt\n"]
[222.020488, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.021618, "o", "from datasets import load_dataset\r\n\u001b[?2004l\r\u001b[?2004h> from transformers import AutoTokenizer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ds = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata', split='train')\r\n\u001b[?2004l\r\u001b[?2004h> science = [i for i, d in enumerate(ds['domain']) if d in {'physics', 'chemistry', 'biology'}]\r\n\u001b[?2004l\r\u001b[?2004h> tok = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct', use_fast=True)\r\n\u001b[?2004l\r\u001b[?2004h> reasoning = [ds['deepseek_reasoning'][i] for i in science]\r\n\u001b[?2004l\r\u001b[?2004h> solution = [ds['deepseek_solution'][i] for i in science]\r\n\u001b[?2004l\r\u001b[?2004h> r_counts = [len(x) for x in tok(reasoning, add_special_tokens=False)['input_ids']]\r\n\u001b[?2004l\r\u001b[?2004h> s_counts = [len(x) for x in tok(solution, add_special_tokens=False)['input_ids']]\r\n\u001b[?2004l\r\u001b[?2004h> r_total = sum(r_counts)\r\n\u001b[?2004l\r\u001b[?2004h> s_total = sum(s_counts)\r\n\u001b[?2004l\r\u001b[?2004h> total = r_total + s_total\r\n\u001b[?2004l\r\u001b[?2004h> print('science rows:', len(science))\r\n\u001b[?2004l\r\u001b[?2004h> "]
