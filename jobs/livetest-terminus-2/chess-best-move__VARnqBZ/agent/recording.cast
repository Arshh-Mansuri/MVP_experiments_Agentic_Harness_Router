[68.269801, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# For each square, compare pixels to the median empty-square texture of the same color.\n# Empty reference squares are selected from clearly empty rows 4 and 3.\nrefs={}\nfor parity in (0,1):\n ps=[]\n for r in (3,4,5):\n  for c in range(8):\n   if (r+c)%2==parity:\n    ps.append([[im.getpixel((c*80+x,r*80+y)) for x in range(80)] for y in range(80)])\n refs[parity]=ps\nfor r in range(8):\n for c in range(8):\n  ref=refs[(r+c)%2][0]\n  score=0\n  for y in range(5,75,3):\n   for x in range(5,75,3):\n    p=im.getpixel((c*80+x,r*80+y)); q=ref[y][x]\n    score+=sum(abs(p[k]-q[k]) for k in range(3))\n  if score>1800: print(chr(97+c)+str(8-r),score)\nPY\n"]
[68.277165, "o", "python3 - <<'PY'\r\n"]
[68.277596, "o", "\u001b[?2004l\r"]
