[26.498578, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Expected board colors inferred from empty squares.\nbase=[[(240,217,181) if (r+c)%2==0 else (181,136,99) for c in range(8)] for r in range(8)]\nchars=' .:-=+*#%@'\nfor r in range(8):\n for c in range(8):\n  b=base[r][c]; rows=[]; score=0\n  for yy in range(4,76,5):\n   s=''\n   for xx in range(4,76,5):\n    p=im.getpixel((c*80+xx,r*80+yy))\n    d=sum((p[k]-b[k])**2 for k in range(3))**0.5\n    score+=d\n    s+=chars[min(9,int(d/18))]\n   rows.append(s)\n  if score>2500:\n   print(chr(97+c)+str(8-r),'score',int(score))\n   print('\\n'.join(rows))\nPY\n"]
