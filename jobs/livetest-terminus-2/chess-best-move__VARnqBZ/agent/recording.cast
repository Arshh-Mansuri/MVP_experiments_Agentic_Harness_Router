[37.735571, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nbase=lambda r,c:(240,217,181) if (r+c)%2==0 else (181,136,99)\n# Show all squares as 16x16 maps. '@' means dark/black deviation, '+' lighter deviation.\nfor r in range(8):\n for c in range(8):\n  b=base(r,c); data=[]; score=0\n  for y in range(2,78,5):\n   row=''\n   for x in range(2,78,5):\n    p=im.getpixel((c*80+x,r*80+y))\n    # signed luminance difference against local board color\n    q=sum(p)//3; z=sum(b)//3; d=q-z\n    score+=abs(d)\n    row += '@' if d < -45 else '#' if d < -20 else '+' if d > 35 else '.' if d > 12 else ' '\n   data.append(row)\n  if score>900:\n   print('\\n'+chr(97+c)+str(8-r)+' score='+str(score))\n   print('\\n'.join(data))\nPY\n"]
