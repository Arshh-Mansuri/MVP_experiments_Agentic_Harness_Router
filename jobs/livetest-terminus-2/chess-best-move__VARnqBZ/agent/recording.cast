[17.378297, "i", "python3 - <<'PY'\nfrom PIL import Image, ImageOps\nim=Image.open('chess_board.png').convert('RGB')\n# Print square average RGB and variation, using only PIL/Python.\nfor r in range(8):\n out=[]\n for c in range(8):\n  vals=[]\n  for y in range(r*80+8,r*80+72,4):\n   for x in range(c*80+8,c*80+72,4): vals.append(im.getpixel((x,y)))\n  av=tuple(sum(p[k] for p in vals)//len(vals) for k in range(3))\n  # compare central area to four corner patches (piece pixels tend to increase variation)\n  lum=[sum(p)//3 for p in vals]\n  mean=sum(lum)/len(lum); sd=(sum((v-mean)**2 for v in lum)/len(lum))**0.5\n  out.append('%3d,%3d,%3d s%3d'%(*av,int(sd)))\n print(' | '.join(out))\nPY\n"]
[17.385519, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image, ImageOps\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> # Print square average RGB and variation, using only PIL/Python.\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>  out=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>   vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for y in range(r*80+8,r*80+72,4):\r\n\u001b[?2004l\r\u001b[?2004h>    for x in range(c*80+8,c*80+72,4): vals.append(im.getpixel((x,y)))\r\n\u001b[?2004l\r\u001b[?2004h>   av=tuple(sum(p[k] for p in vals)//len(vals) for k in range(3))\r\n\u001b[?2004l\r\u001b[?2004h>   # compare central area to four corner patches (piece pixels tend to increase variation)\r\n\u001b[?2004l\r\u001b[?2004h>   lum=[sum(p)//3 for p in vals]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385734, "o", "  mean=sum(lum)/len(lum); sd=(sum((v-mean)**2 for v in lum)/len(lum))**0.5\r\n\u001b[?2004l\r\u001b[?2004h>   out.append('%3d,%3d,%3d s%3d'%(*av,int(sd)))\r\n\u001b[?2004l\r\u001b[?2004h>  print(' | '.join(out))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[18.109657, "i", "python3 - <<'PY'\nfrom PIL import Image,ImageOps\nim=Image.open('chess_board.png').convert('L')\nchars=' .:-=+*#%@'\n# Make compact 12x12 monochrome thumbnails of each square, labeled algebraically.\nfor r in range(8):\n print('\\nRANK',8-r)\n for yy in range(0,80,7):\n  line=[]\n  for c in range(8):\n   s=''\n   for xx in range(0,80,7):\n    v=im.getpixel((c*80+xx+3,r*80+yy+3)); s+=chars[min(9,v*10//256)]\n   line.append(s)\n  print(' '.join(line))\nPY\n"]
[18.111796, "o", "python3 - <<'PY'\r\nfrom PIL import Image,ImageOps\r\nim=Image.open('chess_board.png').convert('L')\r\nchars=' .:-=+*#%@'\r\n# Make compact 12x12 monochrome thumbnails of each square, labeled algebraically.\r\nfor r in range(8):\r\n print('\\nRANK',8-r)\r\n for yy in range(0,80,7):\r\n  line=[]\r\n  for c in range(8):\r\n   s=''\r\n   for xx in range(0,80,7):\r\n    v=im.getpixel((c*80+xx+3,r*80+yy+3)); s+=chars[min(9,v*10//256)]\r\n   line.append(s)\r\n  print(' '.join(line))\r\nPY\r\n"]
