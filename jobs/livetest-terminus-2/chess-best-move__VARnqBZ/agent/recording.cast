[80.561031, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Print foreground width by row for candidate pieces. Dark pieces use pixels below 70;\n# light pieces use deviation from the corresponding empty-square background.\ncands=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5','a1','c1','e1','h1','e2','c3','a3','b2','f2','e5']\nfor sq in cands:\n c=ord(sq[0])-97; r=8-int(sq[1]); dark=[]; light=[]\n b=(240,217,181) if (r+c)%2==0 else (181,136,99)\n for y in range(5,75):\n  nd=nl=0\n  for x in range(5,75):\n   p=im.getpixel((c*80+x,r*80+y)); lum=sum(p)//3\n   if lum<70: nd+=1\n   if abs(lum-sum(b)//3)>18: nl+=1\n  dark.append(nd); light.append(nl)\n use=dark if max(dark)>100 else light\n print(sq, ' '.join(str(v//4) for v in use[::4]))\nPY\n"]
[80.581433, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[80.585232, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> # Print foreground width by row for candidate pieces. Dark pieces use pixels below 70;\r\n\u001b[?2004l\r\u001b[?2004h> # light pieces use deviation from the corresponding empty-square background.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.588256, "o", "cands=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5','a1','c1','e1','h1','e2','c3','a3','b2','f2','e5']\r\n\u001b[?2004l\r\u001b[?2004h> for sq in cands:\r\n\u001b[?2004l\r\u001b[?2004h>  c=ord(sq[0])-97; r=8-int(sq[1]); dark=[]; light=[]\r\n\u001b[?2004l\r\u001b[?2004h>  b=(240,217,181) if (r+c)%2==0 else (181,136,99)\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(5,75):\r\n\u001b[?2004l\r\u001b[?2004h>   nd=nl=0\r\n\u001b[?2004l\r\u001b[?2004h>   for x in range(5,75):\r\n\u001b[?2004l\r\u001b[?2004h>    p=im.getpixel((c*80+x,r*80+y)); lum=sum(p)//3\r\n\u001b[?2004l\r\u001b[?2004h>    if lum<70: nd+=1\r\n\u001b[?2004l\r\u001b[?2004h>    if abs(lum-sum(b)//3)>18: nl+=1\r\n\u001b[?2004l\r\u001b[?2004h>   dark.append(nd); light.append(nl)\r\n\u001b[?2004l\r\u001b[?2004h>  use=dark if max(dark)>100 else light\r\n\u001b[?2004l\r"]
[80.607112, "o", "\u001b[?2004h>  print(sq, ' '.join(str(v//4) for v in use[::4]))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
