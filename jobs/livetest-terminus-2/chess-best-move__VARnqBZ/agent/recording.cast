[27.519928, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Save enlarged individual square crops for likely occupied squares, and print their RGB palette.\nfor r in range(8):\n for c in range(8):\n  vals=[im.getpixel((c*80+x,r*80+y)) for x in range(8,72,8) for y in range(8,72,8)]\n  b=(240,217,181) if (r+c)%2==0 else (181,136,99)\n  score=sum(sum((p[k]-b[k])**2 for k in range(3))**0.5 for p in vals)\n  if score>1800: print(chr(97+c)+str(8-r),int(score),sorted(set(vals),key=lambda p:sum(p))[:5],sorted(set(vals),key=lambda p:sum(p))[-5:])\nPY\n"]
