[52.41056, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Analyze connected dark silhouettes in candidate squares.\ncands=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5']\nfor sq in cands:\n c=ord(sq[0])-97; r=8-int(sq[1]); pts=[]\n for y in range(4,76):\n  for x in range(4,76):\n   p=im.getpixel((c*80+x,r*80+y))\n   if sum(p)//3<70: pts.append((x,y))\n if not pts: continue\n x0=min(x for x,y in pts); x1=max(x for x,y in pts); y0=min(y for x,y in pts); y1=max(y for x,y in pts)\n print('\\n',sq,'bbox',x0,y0,x1,y1,'n',len(pts))\n for y in range(y0,y1+1,4):\n  print(''.join('#' if any(abs(xx-x)<3 and abs(yy-y)<3 for xx,yy in pts) else ' ' for x in range(x0,x1+1,3)))\nPY\n"]
[52.415944, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> # Analyze connected dark silhouettes in candidate squares.\r\n\u001b[?2004l\r\u001b[?2004h> cands=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5']\r\n\u001b[?2004l\r\u001b[?2004h> for sq in cands:\r\n\u001b[?2004l\r\u001b[?2004h>  c=ord(sq[0])-97; r=8-int(sq[1]); pts=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(4,76):\r\n\u001b[?2004l\r\u001b[?2004h>   for x in range(4,76):\r\n\u001b[?2004l\r\u001b[?2004h>    p=im.getpixel((c*80+x,r*80+y))\r\n\u001b[?2004l\r\u001b[?2004h>    if sum(p)//3<70: pts.append((x,y))\r\n\u001b[?2004l\r\u001b[?2004h>  if not pts: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.417638, "o", " x0=min(x for x,y in pts); x1=max(x for x,y in pts); y0=min(y for x,y in pts); y1=max(y for x,y in pts)\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n',sq,'bbox',x0,y0,x1,y1,'n',len(pts))\r\n\u001b[?2004l\r\u001b[?2004h>  for y in range(y0,y1+1,4):\r\n\u001b[?2004l\r\u001b[?2004h>   print(''.join('#' if any(abs(xx-x)<3 and abs(yy-y)<3 for xx,yy in pts) else ' ' for x in range(x0,x1+1,3)))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
