[81.306401, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Determine whether the board has coordinate labels/borders and inspect corner colors.\nprint('corners', [im.getpixel(p) for p in [(0,0),(79,79),(80,0),(639,639)]])\nprint('bbox',im.getbbox(), 'info',im.info)\nPY\n"]
