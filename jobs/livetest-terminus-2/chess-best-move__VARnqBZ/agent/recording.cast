[69.042988, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# High resolution maps for suspected white pieces; '+' is brighter than the square background,\n# '@' is darker, preserving the piece outline.\nfor sq in ['a1','c1','e1','h1','e2','c3']:\n c=ord(sq[0])-97; r=8-int(sq[1]); b=(240,217,181) if (r+c)%2==0 else (181,136,99)\n print('\\n'+sq)\n for y in range(8,72,3):\n  s=''\n  for x in range(8,72,3):\n   p=im.getpixel((c*80+x,r*80+y)); d=sum(p)//3-sum(b)//3\n   s += '+' if d>28 else '.' if d>10 else '@' if d< -25 else ' '\n  print(s)\nPY\n"]
