[10.503589, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png')\n# Print coarse luminance/color summaries for each square to help identify occupied squares.\nimport numpy as np\nx=np.array(im)\nfor r in range(8):\n row=[]\n for c in range(8):\n  q=x[r*80:(r+1)*80,c*80:(c+1)*80]\n  # center region foreground/color statistics\n  z=q[10:70,10:70]\n  row.append('%3d/%3d/%3d'%tuple(z.mean(axis=(0,1)).astype(int)))\n print(' '.join(row))\nPY\n"]
[10.504041, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
