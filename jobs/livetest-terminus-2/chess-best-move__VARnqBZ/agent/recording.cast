[38.509532, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Print compact RGB/luminance samples for likely white-piece squares.\nfor sq in ['a3','b2','f2','a1','c1','e1','c3','e5','g5']:\n c=ord(sq[0])-97; r=8-int(sq[1]); print('\\n',sq)\n for y in range(8,72,6):\n  print(''.join(' .:-=+*#%@'[min(9,sum(im.getpixel((c*80+x,r*80+y)))//3*10//256)] for x in range(8,72,6)))\nPY\n"]
