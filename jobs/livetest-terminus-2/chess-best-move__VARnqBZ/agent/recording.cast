[105.036431, "i", "python3 - <<'PY'\ntry:\n import chess\n # Candidate reconstruction from the image.\n fen='r1bq1r2/1p3pp1/p1n1p1p1/3n1bk1/8/2N5/R1B1Q3/4K2R w KQkq - 0 1'\n b=chess.Board(fen)\n print(b)\n print('legal',b.is_valid(), 'turn',b.turn)\n print('checks/captures:')\n for m in b.legal_moves:\n  if b.gives_check(m) or b.is_capture(m): print(m.uci(), 'check' if b.gives_check(m) else 'capture')\nexcept Exception as e: print(e)\nPY\n"]
