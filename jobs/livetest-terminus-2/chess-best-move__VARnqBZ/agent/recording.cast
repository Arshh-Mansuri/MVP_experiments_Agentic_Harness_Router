[53.388536, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n# Report dark-pixel counts for every square, useful for detecting black pieces.\nfor r in range(8):\n row=[]\n for c in range(8):\n  n=sum(1 for y in range(r*80+5,r*80+75) for x in range(c*80+5,c*80+75) if sum(im.getpixel((x,y)))//3<70)\n  row.append('%3d'%n)\n print(8-r,' '.join(row))\nPY\n"]
