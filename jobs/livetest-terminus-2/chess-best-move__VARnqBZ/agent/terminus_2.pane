from PIL import Image,ImageOps
im=Image.open('chess_board.png').convert('L')
chars=' .:-=+*#%@'
# Make compact 12x12 monochrome thumbnails of each square, labeled algebraically.
for r in range(8):
 print('\nRANK',8-r)
 for yy in range(0,80,7):
  line=[]
  for c in range(8):
   s=''
   for xx in range(0,80,7):
    v=im.getpixel((c*80+xx+3,r*80+yy+3)); s+=chars[min(9,v*10//256)]
   line.append(s)
  print(' '.join(line))
