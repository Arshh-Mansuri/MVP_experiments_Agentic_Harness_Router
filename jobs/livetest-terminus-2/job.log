Sending keys: ["cat > /tmp/solve.py <<'PY'\nfrom functools import lru_cache\n# reconstructed position\nS={}\ndef put(s):\n for i,ch in enumerate(s.replace('/','')):\n  if ch.isdigit(): i0=i\n# board coordinates x=0..7, y=0 rank1\nfen='r1bq1r2/1p3pp1/p1n1p1p1/3n1kb1/8/2N5/R1B1Q3/4K2R'\nfor y,row in enumerate(fen.split('/')[::-1]):\n x=0\n for ch in row:\n  if ch.isdigit(): x+=int(ch)\n  else: S[(x,y)]=ch; x+=1\n\ndef sq(p): return chr(97+p[0])+str(p[1]+1)\ndef color(pc): return pc.isupper()\ndef inside(p): return 0<=p[0]<8 and 0<=p[1]<8\nkn=[(1,2),(2,1),(-1,2),(-2,1),(1,-2),(2,-1),(-1,-2),(-2,-1)]\ndiag=[(1,1),(1,-1),(-1,1),(-1,-1)]\northo=[(1,0),(-1,0),(0,1),(0,-1)]\ndef attacked(B,p,bywhite):\n x,y=p\n for q,pc in B.items():\n  if color(pc)!=bywhite: continue\n  dx,dy=x-q[0],y-q[1]; a=abs(dx); b=abs(dy); P=pc.lower()\n  if P=='p' and b==1 and dx in (-1,1) and dy==(1 if bywhite else -1): return True\n  if P=='n' and (dx,dy) in kn: return True\n  if P=='k' and max(a,b)==1: return True\n  dirs=diag if P=='b' else ortho if P=='r' else diag+ortho if P=='q' else []\n  for vx,vy in dirs:\n   if (dx,dy)!=(0,0) and dx*vy==dy*vx and ((dx//vx if vx else dy//vy)>0):\n    n=1; z=(q[0]+vx,q[1]+vy)\n    while z!=p and z not in B: n+=1; z=(z[0]+vx,z[1]+vy)\n    if z==p: return True\n return False\ndef incheck(B,w):\n k=next((p for p,v in B.items() if v==('K' if w else 'k')),None)\n return k is None or attacked(B,k,not w)\ndef pseudo(B,w):\n for p,pc in list(B.items()):\n  if color(pc)!=w: continue\n  P=pc.lower(); x,y=p\n  if P=='p':\n   d=1 if w else -1; z=(x,y+d)\n   if inside(z) and z not in B:\n    yield p,z\n    z2=(x,y+2*d)\n    if y==(1 if w else 6) and z2 not in B: yield p,z2\n   for dx in (-1,1):\n    z=(x+dx,y+d)\n    if inside(z) and z in B and color(B[z])!=w: yield p,z\n  elif P=='n':\n   for dx,dy in kn:\n    z=(x+dx,y+dy)\n    if inside(z) and (z not in B or color(B[z])!=w): yield p,z\n  elif P=='k':\n   for dx,dy in diag+ortho:\n    z=(x+dx,y+dy)\n    if inside(z) and (z not in B or color(B[z])!=w): yield p,z\n  else:\n   dirs=diag if P=='b' else ortho if P=='r' else diag+ortho\n   for dx,dy in dirs:\n    z=(x+dx,y+dy)\n    while inside(z):\n     if z not in B: yield p,z\n     else:\n      if color(B[z])!=w: yield p,z\n      break\n     z=(z[0]+dx,z[1]+dy)\ndef move(B,m):\n C=B.copy(); p,z=m; pc=C.pop(p); C.pop(z,None)\n if pc.lower()=='p' and z[1] in (0,7): pc='Q' if pc.isupper() else 'q'\n C[z]=pc; return C\ndef legal(B,w):\n for m in pseudo(B,w):\n  C=move(B,m)\n  if not incheck(C,w): yield m,C\nval={'p':100,'n':320,'b':330,'r':500,'q':900,'k':20000}\ndef score(B): return sum((val[v.lower()] if v.isupper() else -val[v.lower()]) for v in B.values())\ndef search(B,w,d,alpha=-10**9,beta=10**9):\n ms=list(legal(B,w))\n if not ms: return (-999999+d if w and incheck(B,w) else 999999-d if (not w and incheck(B,w)) else 0),None\n if d==0:return score(B),None\n best=-10**9 if w else 10**9; bm=None\n for m,C in ms:\n  v,_=search(C,not w,d-1,alpha,beta)\n  if w and v>best:best,bm=v,m\n  if not w and v<best:best,bm=v,m\n  if w: alpha=max(alpha,v)\n  else: beta=min(beta,v)\n  if beta<=alpha:break\n return best,bm\nfor d in (2,3,4):\n arr=[]\n for m,C in legal(S,True):\n  v,_=search(C,False,d-1)\n  arr.append((v,sq(m[0])+sq(m[1])))\n print('depth',d,sorted(arr,reverse=True)[:12])\nv,m=search(S,True,4)\nprint('BEST',sq(m[0])+sq(m[1]),v)\nopen('/app/move.txt','w').write(sq(m[0])+sq(m[1])+'\\n')\nPY\npython3 /tmp/solve.py\ncat /app/move.txt\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
