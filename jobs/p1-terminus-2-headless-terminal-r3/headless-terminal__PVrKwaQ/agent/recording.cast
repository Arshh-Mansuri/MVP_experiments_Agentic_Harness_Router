[42.378773, "i", "cat > /app/headless_terminal.py <<'PY'\n\"\"\"PTY-backed interactive terminal implementation.\"\"\"\n\nfrom __future__ import annotations\n\nimport errno\nimport fcntl\nimport os\nimport pty\nimport select\nimport signal\nimport struct\nimport subprocess\nimport termios\nimport threading\nimport time\nfrom typing import Optional\n\nfrom base_terminal import BaseTerminal\n\n\nclass HeadlessTerminal(BaseTerminal):\n    \"\"\"A small headless terminal backed by an interactive bash process.\n\n    Input is sent exactly as terminal bytes, so newline, escape sequences, and\n    control characters (for example ``\\x03``) work as they do in a real PTY.\n    Output is retained in :attr:`output`; :meth:`read_output` returns output\n    not previously consumed by that method, while :meth:`get_screen` returns a\n    simple current-screen representation.\n    \"\"\"\n\n    def __init__(\n        self,\n        *,\n        shell: str = \"/bin/bash\",\n        cols: int = 120,\n        rows: int = 40,\n        env: Optional[dict[str, str]] = None,\n    ) -> None:\n        if c"]
[42.380913, "i", "ols <= 0 or rows <= 0:\n            raise ValueError(\"terminal dimensions must be positive\")\n        self.cols = cols\n        self.rows = rows\n        self._lock = threading.RLock()\n        self._closed = False\n        self._output = \"\"\n        self._read_position = 0\n        self._screen = \"\"\n        self._reader_done = threading.Event()\n\n        child_env = os.environ.copy()\n        child_env.setdefault(\"TERM\", \"xterm-256color\")\n        child_env[\"COLUMNS\"] = str(cols)\n        child_env[\"LINES\"] = str(rows)\n        if env:\n            child_env.update(env)\n\n        pid, fd = pty.fork()\n        if pid == 0:\n            # pty.fork gives the child a controlling terminal.  Do not use\n            # --noprofile/--norc: interactive bash should source startup files.\n            os.execvpe(shell, [shell, \"-i\"], child_env)\n            os._exit(127)  # pragma: no cover\n\n        self.pid = pid\n        self._fd = fd\n        self._set_winsize(rows, cols)\n        flags = fcntl.fcntl(fd, fcntl.F_GETFL)\n        fcntl.fcntl(f"]
