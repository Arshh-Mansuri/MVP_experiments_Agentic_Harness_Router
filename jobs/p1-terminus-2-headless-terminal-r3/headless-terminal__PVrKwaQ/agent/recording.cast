[42.381329, "i", "must be a str\")\n        if wait_sec < 0:\n            raise ValueError(\"wait_sec must not be negative\")\n        if self._closed:\n            raise RuntimeError(\"terminal is closed\")\n        data = keystrokes.encode(\"utf-8\", errors=\"surrogatepass\")\n        view = memoryview(data)\n        while view:\n            try:\n                written = os.write(self._fd, view)\n                view = view[written:]\n            except InterruptedError:\n                continue\n            except OSError as exc:\n                if exc.errno == errno.EPIPE:\n                    raise RuntimeError(\"terminal process has exited\") from exc\n                raise\n        if wait_sec:\n            time.sleep(wait_sec)\n        self._drain()\n\n    @property\n    def output(self) -> str:\n        with self._lock:\n            return self._output\n\n    def read_output(self) -> str:\n        with self._lock:\n            value = self._output[self._read_position:]\n            self._read_position = len(self._output)\n            return value\n\n    de"]
