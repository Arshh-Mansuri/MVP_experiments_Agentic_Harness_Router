[42.428534, "o", "            elif ch == \"\\n\":\r\n\u001b[?2004l\r"]
[42.428544, "o", "\u001b[?2004h"]
[42.428598, "o", "> "]
[42.428701, "o", "                result.extend(line)\r\n\u001b[?2004l\r 0.15)\u001b[?2004h> "]
[42.428772, "o", "                result.append(\"\\n\")"]
[42.428884, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428952, "o", "                line = []\r\n\u001b[?2004l\r()\r\nPY\r\n\u001b[?2004h> "]
[42.429053, "o", "            elif ch == \"\\b\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429135, "o", "                if line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429254, "o", "                    line.pop()\r\n\u001b[?2004l\r\u001b[?2004h>             elif ch == \"\\t\":"]
[42.429351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429425, "o", "                line.append(\"\\t\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429513, "o", "            elif ch >= \" \" or ch == \"\\x7f\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429576, "o", "                line.append(ch)"]
[42.429667, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         result.extend(line)"]
[42.42976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429874, "o", "        # Keep a bounded screen buffer; output itself is unbounded by design.\r\n\u001b[?2004l\r"]
[42.429927, "o", "\u001b[?2004h> "]
[42.430021, "o", "        return \"\".join(result)[-200000:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430094, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430241, "o", ">     def _read_loop(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430322, "o", "        while not self._closed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430459, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430566, "o", "                readable, _, _ = select.select([self._fd], [], [], 0.1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430683, "o", "            except (OSError, ValueError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430728, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430774, "o", "> "]
[42.430785, "o", "            if not readable:"]
[42.430897, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430953, "o", "> "]
[42.43102, "o", "                    pid, _ = os.waitpid(self.pid, os.WNOHANG)\r\n\u001b[?2004l\r"]
[42.431176, "o", "\u001b[?2004h> "]
[42.431257, "o", "                    if pid:\r\n\u001b[?2004l\r\u001b[?2004h>                         break\r\n\u001b[?2004l\r"]
[42.431338, "o", "\u001b[?2004h> "]
[42.431408, "o", "                except ChildProcessError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431526, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.431569, "o", "> "]
[42.431682, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             try:"]
[42.431756, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431883, "o", "                data = os.read(self._fd, 65536)\r\n\u001b[?2004l\r\u001b[?2004h>             except BlockingIOError:"]
[42.431991, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.432114, "o", ">             except OSError as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432262, "o", "                if exc.errno not in (errno.EIO, errno.EBADF):\r\n\u001b[?2004l\r"]
[42.432356, "o", "\u001b[?2004h>                     pass\r\n\u001b[?2004l\r"]
[42.432444, "o", "\u001b[?2004h> "]
[42.432529, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432606, "o", "            if not data:\r\n\u001b[?2004l\r"]
[42.432679, "o", "\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432761, "o", "            self._append_output(data)\r\n\u001b[?2004l\r"]
[42.432786, "o", "\u001b[?2004h"]
[42.432877, "o", "> "]
[42.432936, "o", "        self._reader_done.set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.432985, "o", "\u001b[?2004h"]
[42.433004, "o", "> "]
[42.43312, "o", "    def _drain(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433244, "o", "        while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433285, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433373, "o", "                data = os.read(self._fd, 65536)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.433418, "o", "> "]
[42.43349, "o", "            except (BlockingIOError, OSError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433551, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.433569, "o", "> "]
[42.433636, "o", "            if not data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433723, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433815, "o", "            self._append_output(data)\r\n\u001b[?2004l\r"]
[42.433846, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.433853, "o", "\u001b[?2004h> "]
[42.433983, "o", "    def send_keystrokes(self, keystrokes: str, wait_sec: float = 0.0) -> None:\r\n\u001b[?2004l\r"]
[42.43405, "o", "\u001b[?2004h> "]
[42.434151, "o", "        if not isinstance(keystrokes, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.43427, "o", "            raise TypeError(\"keystrokes must be a str\")\r\n\u001b[?2004l\r\u001b[?2004h>         if wait_sec < 0:\r\n\u001b[?2004l\r"]
[42.434336, "o", "\u001b[?2004h> "]
[42.434393, "o", "            raise ValueError(\"wait_sec must not be negative\")\r\n\u001b[?2004l\r"]
[42.434409, "o", "\u001b[?2004h"]
[42.434493, "o", ">         if self._closed:"]
[42.434582, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.434685, "o", ">             raise RuntimeError(\"terminal is closed\")"]
[42.434757, "o", "\r\n"]
[42.434817, "o", "\u001b[?2004l\r\u001b[?2004h"]
[42.43489, "o", "> "]
[42.434994, "o", "        data = keystrokes.encode(\"utf-8\", errors=\"surrogatepass\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.435054, "o", "> "]
[42.435117, "o", "        view = memoryview(data)"]
[42.435176, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         while view:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.435242, "o", "> "]
[42.435288, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.435432, "o", "                written = os.write(self._fd, view)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.43554, "o", "                view = view[written:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.435627, "o", "            except InterruptedError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.435644, "o", "                continue\r\n"]
[42.435653, "o", "\u001b[?2004l\r"]
[42.435708, "o", "\u001b[?2004h> "]
[42.435728, "o", "            except OSError as exc:\r\n\u001b[?2004l\r"]
[42.435837, "o", "\u001b[?2004h> "]
[42.435889, "o", "                if exc.errno == errno.EPIPE:\r\n\u001b[?2004l\r"]
[42.435905, "o", "\u001b[?2004h"]
[42.435961, "o", "> "]
[42.436076, "o", "                    raise RuntimeError(\"terminal process has exited\") from exc\r\n\u001b[?2004l\r"]
[42.436151, "o", "\u001b[?2004h>                 raise\r\n\u001b[?2004l\r"]
[42.436199, "o", "\u001b[?2004h> "]
[42.436288, "o", "        if wait_sec:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.436362, "o", "            time.sleep(wait_sec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.436415, "o", "        self._drain()\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.436468, "o", "> \r\n\u001b[?2004l\r"]
[42.436591, "o", "\u001b[?2004h>     @property\r\n\u001b[?2004l\r"]
[42.436638, "o", "\u001b[?2004h"]
[42.436748, "o", ">     def output(self) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.436832, "o", "        with self._lock:\r\n\u001b[?2004l\r"]
[42.436909, "o", "\u001b[?2004h> "]
[42.436966, "o", "            return self._output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437006, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437102, "o", "    def read_output(self) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437158, "o", "        with self._lock:\r\n\u001b[?2004l\r"]
[42.437201, "o", "\u001b[?2004h> "]
[42.437274, "o", "            value = self._output[self._read_position:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437412, "o", "            self._read_position = len(self._output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.43746, "o", "            return value\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.437549, "o", "\u001b[?2004h>     def get_screen(self) -> str:"]
[42.437657, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437674, "o", "        with self._lock:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437768, "o", "            return self._screen\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.437869, "o", "\u001b[?2004h>     def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.437928, "o", "        if self._closed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.438066, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h>         self._closed = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.438081, "o", "        try:\r\n\u001b[?2004l\r"]
[42.438129, "o", "\u001b[?2004h> "]
[42.438234, "o", "            os.close(self._fd)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.438278, "o", "        except OSError:"]
[42.43841, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>         try:"]
[42.438514, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.438613, "o", "            os.kill(self.pid, signal.SIGHUP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.438693, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.438713, "o", "> "]
[42.438775, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.438793, "o", "> "]
[42.438931, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h>             os.waitpid(self.pid, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439054, "o", "        except (ChildProcessError, OSError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439135, "o", "            pass\r\n\u001b[?2004l\r"]
[42.439176, "o", "\u001b[?2004h> "]
[42.439231, "o", "        if self._reader.is_alive():"]
[42.439355, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439375, "o", "            self._reader.join(timeout=1.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.439436, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439498, "o", "    def __enter__(self) -> \"HeadlessTerminal\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439513, "o", "        return self\r\n"]
[42.439545, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.439564, "o", "\u001b[?2004h> "]
[42.439767, "o", "    def __exit__(self, exc_type, exc_value, traceback) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>         self.close()\r\n\u001b[?2004l\r"]
[42.439826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.439973, "o", "    def __del__(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.439988, "o", "> "]
[42.44009, "o", "            self.close()\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass"]
[42.440175, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[42.463059, "o", "\u001b[?2004hroot@49740da534ed:/app# "]
[42.463114, "o", "python3 -m py_compile /app/headless_terminal.py\r\n\u001b[?2004l\r"]
[42.680319, "o", "\u001b[?2004hroot@49740da534ed:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[42.680535, "o", "\u001b[?2004h> import sys, time\r\n\u001b[?2004l\r"]
[42.680775, "o", "\u001b[?2004h> sys.path.insert(0, '/app')\r\n\u001b[?2004l\r\u001b[?2004h> from headless_terminal import HeadlessTerminal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> t = HeadlessTerminal()\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(0.15)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.68086, "o", "t.send_keystrokes(\"printf 'HELLO\\\\n'\\n\", 0.15)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.680938, "o", "print('HAS_HELLO=', 'HELLO' in t.output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.681184, "o", "t.send_keystrokes(\"read -p 'Name: ' name; echo \" + '$name' + \"\\n\", 0.05)\r\n\u001b[?2004l\r\u001b[?2004h> t.send_keystrokes('Alice\\n', 0.15)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.681207, "o", "print('HAS_ALICE=', 'Alice' in t.output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.681341, "o", "t.send_keystrokes(\"sleep 5\\n\", 0.05)\r\n\u001b[?2004l\r\u001b[?2004h> t.send_keystrokes('\\x03', 0.15)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.681532, "o", "print('HAS_INTERRUPT=', 'sleep 5' in t.output)\r\n\u001b[?2004l\r\u001b[?2004h> t.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[43.137072, "o", "HAS_HELLO= True\r\n"]
[43.338736, "o", "HAS_ALICE= True\r\n"]
[43.550415, "o", "HAS_INTERRUPT= True\r\n"]
[43.564625, "o", "\u001b[?2004hroot@49740da534ed:/app# "]
[53.504283, "i", "python3 - <<'PY'\nimport os, sys, tempfile, time\nsys.path.insert(0, '/app')\nfrom headless_terminal import HeadlessTerminal\n\nwith tempfile.TemporaryDirectory() as home:\n    with open(os.path.join(home, '.bashrc'), 'w') as f:\n        f.write(\"export HEADLESS_STARTUP_OK=1\\n\")\n    t = HeadlessTerminal(env={'HOME': home})\n    t.send_keystrokes(\"printf 'startup=%s\\\\n' \\\"$HEADLESS_STARTUP_OK\\\"\\n\", 0.2)\n    assert 'startup=1' in t.output, repr(t.output)\n    t.send_keystrokes(\"python3 -q\\n\", 0.2)\n    t.send_keystrokes(\"print('interactive-python')\\n\", 0.2)\n    t.send_keystrokes(\"exit()\\n\", 0.2)\n    assert 'interactive-python' in t.output, repr(t.output)\n    t.close()\nprint('startup and interactive checks passed')\nPY\npgrep -af 'bash -i|headless-terminal-reader' || true\n"]
[53.505352, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os, sys, tempfile, time\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0, '/app')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.505399, "o", "from headless_terminal import HeadlessTerminal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.505441, "o", "> "]
[53.506016, "o", "with tempfile.TemporaryDirectory() as home:\r\n\u001b[?2004l\r\u001b[?2004h>     with open(os.path.join(home, '.bashrc'), 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(\"export HEADLESS_STARTUP_OK=1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     t = HeadlessTerminal(env={'HOME': home})\r\n\u001b[?2004l\r\u001b[?2004h>     t.send_keystrokes(\"printf 'startup=%s\\\\n' \\\"$HEADLESS_STARTUP_OK\\\"\\n\", 0.2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.506173, "o", "    assert 'startup=1' in t.output, repr(t.output)\r\n\u001b[?2004l\r\u001b[?2004h>     t.send_keystrokes(\"python3 -q\\n\", 0.2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.507272, "o", "    t.send_keystrokes(\"print('interactive-python')\\n\", 0.2)\r\n\u001b[?2004l\r\u001b[?2004h>     t.send_keystrokes(\"exit()\\n\", 0.2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.507561, "o", "    assert 'interactive-python' in t.output, repr(t.output)\r\n\u001b[?2004l\r\u001b[?2004h>     t.close()\r\n\u001b[?2004l\r\u001b[?2004h> print('startup and interactive checks passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[54.491664, "o", "startup and interactive checks passed\r\n"]
[54.509686, "o", "\u001b[?2004hroot@49740da534ed:/app# "]
[54.510019, "o", "pgrep -af 'bash -i|headless-terminal-reader' || true\r\n\u001b[?2004l\r"]
[54.512796, "o", "bash: pgrep: command not found\r\n"]
[54.514397, "o", "\u001b[?2004hroot@49740da534ed:/app# "]
[59.16642, "i", "cd /app && python3 - <<'PY'\nfrom headless_terminal import HeadlessTerminal\nwith HeadlessTerminal() as terminal:\n    terminal.send_keystrokes(\"echo IMPORT_OK\\n\", 0.15)\n    assert \"IMPORT_OK\" in terminal.output\nprint(\"exact import and context-manager checks passed\")\nPY\nwc -l /app/headless_terminal.py\n"]
