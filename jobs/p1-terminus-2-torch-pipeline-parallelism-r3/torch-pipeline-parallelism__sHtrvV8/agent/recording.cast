[78.880679, "o", "\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef _call\u001b[m\u001b[K_decoder_layer(layer, hidden_states, position_ids, \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K, position_embeddings=None):\r\n\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K=\u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K=\u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K = torch.zeros(\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K = \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K.masked_fill(\r\n"]
[78.880941, "o", "\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            hidden = \u001b[01;31m\u001b[K_call_decoder_layer\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                layer, hidden, position_ids, \u001b[01;31m\u001b[Kattention_mask\u001b[m\u001b[K, position_embeddings\r\n"]
[78.882739, "o", "\u001b[?2004hroot@4a56af03722b:/app# "]
