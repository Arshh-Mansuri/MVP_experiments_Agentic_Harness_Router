[46.371273, "i", "python3 - <<'PY'\nimport torch, inspect\ntry:\n import transformers\n from transformers import LlamaForCausalLM\n print('transformers', transformers.__version__)\n print(inspect.signature(LlamaForCausalLM.forward))\n print(inspect.signature(LlamaForCausalLM.model.forward))\n print(inspect.signature(LlamaForCausalLM.model.layers[0].forward) if hasattr(LlamaForCausalLM.model,'layers') else 'no instance')\nexcept Exception as e:\n print(type(e).__name__, e)\nPY\n"]
[46.375982, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[46.376282, "o", "\u001b[?2004h> import torch, inspect\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>  import transformers\r\n\u001b[?2004l\r\u001b[?2004h>  from transformers import LlamaForCausalLM\r\n\u001b[?2004l\r\u001b[?2004h>  print('transformers', transformers.__version__)\r\n\u001b[?2004l\r\u001b[?2004h>  print(inspect.signature(LlamaForCausalLM.forward))\r\n\u001b[?2004l\r\u001b[?2004h>  print(inspect.signature(LlamaForCausalLM.model.forward))\r\n"]
