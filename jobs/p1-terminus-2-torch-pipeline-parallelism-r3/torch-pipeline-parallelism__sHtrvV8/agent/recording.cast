[78.609187, "i", "python3 - <<'PY'\np='/app/pipeline_parallel.py'\ns=open(p).read()\ns=s.replace('def _call_decoder_layer(layer, hidden_states, position_ids, position_embeddings=None):', 'def _call_decoder_layer(layer, hidden_states, position_ids, attention_mask, position_embeddings=None):')\ns=s.replace('                attention_mask=None,\\n                position_ids=position_ids,', '                attention_mask=attention_mask,\\n                position_ids=position_ids,')\ns=s.replace('            attention_mask=None,\\n            position_ids=position_ids,', '            attention_mask=attention_mask,\\n            position_ids=position_ids,')\ns=s.replace('        position_ids = positions_for(hidden)\\n        position_embeddings = maybe_rotary(hidden, position_ids)\\n\\n        for layer in layers[layer_start:layer_end]:\\n            hidden = _call_decoder_layer(\\n                layer, hidden, position_ids, position_embeddings\\n            ).to(device=device, dtype=dtype)', '''        position_ids = positions_for(hidden)\n        sequence_length = hidden.shape[1]\n        attention_mask = torch.zeros(\n            (hidden.shape[0], 1, sequence_length, sequence_length),\n            device=device,\n            dtype=dtype,\n        )\n        attention_mask = attention_mask.masked_fill(\n            torch.triu(\n                torch.ones(\n                    (sequence_length, sequence_length),\n                    device=device,\n                    dtype=torch.bool,\n                ),\n                diagonal=1,\n            ).view(1, 1, sequence_length, sequence_length),\n            torch.finfo(dtype).min,\n        )\n        position_embeddings = maybe_rotary(hidden, position_ids)\n\n        for layer in layers[layer_start:layer_end]:\n            hidden = _call_decoder_layer(\n                layer, hidden, position_ids, attention_mask, position_embeddings\n            ).to(device=device, dtype=dtype)''')\nopen(p,'w').write(s)\nPY\nsed -n '1,125p' /app/pipeline_parallel.py\n"]
