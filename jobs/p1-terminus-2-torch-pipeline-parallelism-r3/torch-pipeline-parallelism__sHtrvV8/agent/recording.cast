[64.781556, "i", "cat > /app/pipeline_parallel.py <<'PY'\n\"\"\"AFAB pipeline-parallel training for a Transformers LLaMA model.\"\"\"\n\nimport torch\nimport torch.distributed as dist\nimport torch.nn.functional as F\n\n\ndef _call_decoder_layer(layer, hidden_states, position_ids, position_embeddings=None):\n    \"\"\"Call decoder layers across supported Transformers API variants.\"\"\"\n    if position_embeddings is not None:\n        try:\n            result = layer(\n                hidden_states,\n                attention_mask=None,\n                position_ids=position_ids,\n                position_embeddings=position_embeddings,\n            )\n            return result[0] if isinstance(result, (tuple, list)) else result\n        except TypeError:\n            pass\n\n    try:\n        result = layer(\n            hidden_states,\n            attention_mask=None,\n            position_ids=position_ids,\n        )\n    except TypeError:\n        result = layer(hidden_states)\n\n    return result[0] if isinstance(result, (tuple, list)) else result\n\n\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    \"\"\"Run one all-forward/all-backward pipeline training step.\n\n    The model is replicated on every rank. Each rank executes only its\n    contiguous partition of ``model.model.layers``. Gradients accumulate in\n    the local model parameters in the usual PyTorch manner.\n    \"\"\"\n    distributed = dist.is_available() and dist.is_initialized()\n    rank = dist.get_rank() if distributed else 0\n    world_size = dist.get_world_size() if distributed else 1\n\n    llama = model.model\n    layers = llama.layers\n    num_layers = len(layers)\n    num_microbatches = len(inputs)\n    if num_microbatches == 0:\n        return torch.zeros((), device=device, dtype=dtype)\n\n    # Contiguous, approximately balanced layer partition.\n    layer_start = (rank * num_layers) // world_size\n    layer_end = ((rank + 1) * num_layers) // world_size\n    first_rank = rank == 0\n    last_rank = rank == world_size - 1\n\n    # Tensor entering this rank's local layer partition for each microbatch.\n    saved_inputs = [None] * num_microbatches\n    losses = [None] * num_microbatches\n\n    def positions_for(hidden):\n        return torch.arange(\n            hidden.shape[1], device=device, dtype=torch.long\n        ).unsqueeze(0).expand(hidden.shape[0], -1)\n\n    def maybe_rotary(hidden, position_ids):\n        rotary_emb = getattr(llama, \"rotary_emb\", None)\n        if rotary_emb is None:\n            return None\n        try:\n            return rotary_emb(hidden, position_ids)\n        except TypeError:\n            try:\n                return rotary_emb(hidden, position_ids=position_ids)\n            except Exception:\n                return None\n\n    # Forward phase: all microbatches are sent through the pipeline first.\n    for microbatch_index, input_ids in enumerate(inputs):\n        if first_rank:\n            input_ids = input_ids.to(device=device, dtype=torch.long)\n            hidden = llama.embed_tokens(input_ids).to(device=device, dtype=dtype)\n        else:\n            input_ids = input_ids.to(device=device)\n            hidden = torch.empty(\n                input_ids.shape[0],\n                input_ids.shape[1],\n                model.config.hidden_size,\n                device=device,\n                dtype=dtype,\n            )\n            dist.recv(hidden, src=rank - 1, tag=microbatch_index)\n            hidden.requires_grad_(True)\n\n        saved_inputs[microbatch_index] = hidden\n        position_ids = positions_for(hidden)\n        position_embeddings = maybe_rotary(hidden, position_ids)\n\n        for layer in layers[layer_start:layer_end]:\n            hidden = _call_decoder_layer(\n                layer, hidden, position_ids, position_embeddings\n            ).to(device=device, dtype=dtype)\n\n        if last_rank:\n            hidden = llama.norm(hidden).to(device=device, dtype=dtype)\n            logits = model.lm_head(hidden)\n            labels = targets[microbatch_index].to(device=device, dtype=torch.long)\n\n            # Match LlamaForCausalLM's shifted next-token loss. Dividing each\n            # loss by the number"]
[64.782724, "i", " of microbatches gives the batch mean.\n            losses[microbatch_index] = F.cross_entropy(\n                logits[..., :-1, :].contiguous().view(-1, logits.shape[-1]),\n                labels[..., 1:].contiguous().view(-1),\n            ) / num_microbatches\n        else:\n            dist.send(\n                hidden.contiguous(),\n                dst=rank + 1,\n                tag=microbatch_index,\n            )\n\n    # Backward phase: reverse order is the AFAB schedule.\n    for microbatch_index in range(num_microbatches - 1, -1, -1):\n        if last_rank:\n            losses[microbatch_index].backward()\n            input_gradient = saved_inputs[microbatch_index].grad\n        else:\n            input_gradient = torch.empty_like(\n                saved_inputs[microbatch_index], device=device, dtype=dtype\n            )\n            dist.recv(\n                input_gradient,\n                src=rank + 1,\n                tag=100000 + microbatch_index,\n            )\n            torch.autograd.backward(\n                saved_inputs[microbatch_index], input_gradient\n            )\n            input_gradient = saved_inputs[microbatch_index].grad\n\n        if not first_rank:\n            dist.send(\n                input_gradient.to(device=device, dtype=dtype).contiguous(),\n                dst=rank - 1,\n                tag=100000 + microbatch_index,\n            )\n\n    if last_rank:\n        return torch.stack([loss.detach() for loss in losses]).sum()\n    return torch.zeros((), device=device, dtype=dtype)\nPY\n"]
