[9.166017, "i", "cat > /app/analyze_climate_modern.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Modern Python 3 climate analysis script.\"\"\"\n\nfrom pathlib import Path\n\nimport pandas as pd\n\n\nDATA_FILE = (\n    Path(__file__).resolve().parent\n    / \"climate_analyzer\"\n    / \"sample_data\"\n    / \"climate_data.csv\"\n)\nSTATIONS = (101, 102)\n\n\ndef main() -> None:\n    \"\"\"Read climate data and print mean temperatures for both stations.\"\"\"\n    data = pd.read_csv(DATA_FILE, encoding=\"utf-8\")\n\n    station_column = \"station\" if \"station\" in data.columns else \"station_id\"\n    temperature_column = (\n        \"temperature\" if \"temperature\" in data.columns else \"temp\"\n    )\n\n    for station_id in STATIONS:\n        temperatures = data.loc[data[station_column] == station_id, temperature_column]\n        if temperatures.empty:\n            raise ValueError(f\"No data found for station {station_id}\")\n        print(\n            f\"Station {station_id} mean temperature: \"\n            f\"{temperatures.mean():.1f}°C\"\n        )\n\n\nif __name__ == \"__main__\":\n    main()\nP"]
