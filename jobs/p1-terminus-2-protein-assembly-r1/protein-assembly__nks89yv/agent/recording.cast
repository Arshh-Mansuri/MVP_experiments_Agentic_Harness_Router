[317.861608, "i", "cat > /tmp/build_gblock.py <<'PY'\nfrom collections import defaultdict\n\n# Common EGFP sequence, used as the target of the supplied anti-GFP antibody.\ngfp='MSKGEELFTGVVPILVELDGDVNGHKFSVSGEGEGDATYGKLTLKFICTTGKLPVPWPTLVTTFGYPVDVYQ\nLKDNTKTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNYNSHNVYITADKQKNGIKANFKIRHN\nIEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSTQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\ngfp=''.join(gfp.split())\n\n# Exact canonical PDB polymer sequences, with construct tags removed where present.\n# 5WJ2: Clover/GFP-like donor; retain sequence beginning at the mature protein M.\nclover='MVSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFXVACFSRYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\n# The RCSB canonical sequence has X placeholders for unresolved residues; use the\n# chemically corresponding common amino acids in the deposited sequence.\nclover=clover.replace('X','F')\n\nmcherry='MVSKGEEDNMAIIKEFMRF"]
[317.86382, "o", "cat > /tmp/build_gblock.py <<'PY'\r\n\u001b[?2004l\r"]
[317.863935, "i", "KVHMEGSVNGHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFXSKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQ DSS LQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'\nmcherry=''.join(mcherry.split()).replace('X','F')\n\n# 3KZY SNAP-tag polymer sequence (PDB canonical sequence; it is deposited without\n# a usable N-terminal methionine, so no additional methionine is introduced).\nsnap='GPGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'\n\ndhfr='ISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR'\n\nparts=[('antibody_target',gfp),('donor_clover',clover),('dhfr',dhfr),('acceptor_mcherry',mcherry),('molecule_binder_snap',snap)]\nfor n,s in parts:\n    if s.startswith('M'): s=s[1:]\n    if not s or any(a not in 'ACDEFGHIKLMNPQRSTVWY' for"]
