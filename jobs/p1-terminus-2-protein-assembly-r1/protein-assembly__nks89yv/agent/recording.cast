[67.647052, "i", "python3 - <<'PY'\nimport urllib.request,json\nids=open('/app/pdb_ids.txt').read().split()\nfor pid in ids:\n try:\n  e=json.load(urllib.request.urlopen('https://data.rcsb.org/rest/v1/core/entry/'+pid,timeout=20))\n  for eid in e.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\n   j=json.load(urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',timeout=20))\n   p=j.get('entity_poly',{}); d=j.get('rcsb_polymer_entity',{})\n   seq=p.get('pdbx_seq_one_letter_code_can','').replace('\\n','')\n   print(f'>{pid}_{eid} {d.get(\"pdbx_description\",\"\")} length={len(seq)}\\n{seq}')\n except Exception as x: print('ERR',pid,x)\nPY\n"]
[67.655295, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request,json\r\n\u001b[?2004l\r\u001b[?2004h> ids=open('/app/pdb_ids.txt').read().split()\r\n\u001b[?2004l\r\u001b[?2004h> for pid in ids:\r\n\u001b[?2004l\r\u001b[?2004h>  try:\r\n\u001b[?2004l\r\u001b[?2004h>   e=json.load(urllib.request.urlopen('https://data.rcsb.org/rest/v1/core/entry/'+pid,timeout=20))\r\n\u001b[?2004l\r\u001b[?2004h>   for eid in e.get('rcsb_entry_container_identifiers',{}).get('polymer_entity_ids',[]):\r\n\u001b[?2004l\r\u001b[?2004h>    j=json.load(urllib.request.urlopen(f'https://data.rcsb.org/rest/v1/core/polymer_entity/{pid}/{eid}',timeout=20))\r\n\u001b[?2004l\r\u001b[?2004h>    p=j.get('entity_poly',{}); d=j.get('rcsb_polymer_entity',{})\r\n\u001b[?2004l\r\u001b[?2004h>    seq=p.get('pdbx_seq_one_letter_code_can','').replace('\\n','')\r\n\u001b[?2004l\r\u001b[?2004h>    print(f'>{pid}_{eid} {d.get(\"pdbx_description\",\"\")} length={len(seq)}\\n{seq}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
