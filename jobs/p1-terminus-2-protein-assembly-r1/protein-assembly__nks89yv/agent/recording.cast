[317.864125, "i", " a in s):\n        raise ValueError((n,s))\n\n# Standard codons; choose synonymous codons by a local GC target.\ncodons={\n'A':['GCT','GCC','GCA','GCG'],'C':['TGT','TGC'],'D':['GAT','GAC'],'E':['GAA','GAG'],\n'F':['TTT','TTC'],'G':['GGT','GGC','GGA','GGG'],'H':['CAT','CAC'],'I':['ATT','ATC','ATA'],\n'K':['AAA','AAG'],'L':['TTA','TTG','CTT','CTC','CTA','CTG'],'M':['ATG'],'N':['AAT','AAC'],\n'P':['CCT','CCC','CCA','CCG'],'Q':['CAA','CAG'],'R':['CGT','CGC','CGA','CGG','AGA','AGG'],\n'S':['TCT','TCC','TCA','TCG','AGT','AGC'],'T':['ACT','ACC','ACA','ACG'],'V':['GTT','GTC','GTA','GTG'],\n'W':['TGG'],'Y':['TAT','TAC']}\ndef gc(x): return sum(c in 'GC' for c in x)\ndef choose(aa, prior):\n    opts=codons[aa]\n    # Prefer codons that maintain the recent sequence near 50% GC and avoid\n    # excessive homopolymers, while retaining deterministic behavior.\n    best=None\n    for c in opts:\n        z=prior+c\n        w=z[-50:]\n        score=abs(gc(w)/len(w)-.50)*10 + max(0,len(z[-8:])-len(z[-8:].rstrip(z[-1]))-3)\n        # modestly prefe"]
[317.864465, "o", "# Common EGFP sequence, used as the target of the supplied anti-GFP antibody.\r\n\u001b[?2004l\rKVHMEGSVNGHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFXSKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQ DSS LQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK'\r\nmcherry=''.join(mcherry.split()).replace('X','F')\r\n\r\n# 3KZY SNAP-tag polymer sequence (PDB canonical sequence; it is deposited without\r\n# a usable N-terminal methionine, so no additional methionine is introduced).\r\nsnap='GPGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR'\r\n\r\ndhfr='ISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR'\r\n\r\nparts=[('antibody_target',gfp),('donor_clover',clover),('dhfr',dhfr),('acceptor_mcherry',mcherry),('molecule_binder_snap',snap)]\r\nfor n,s i"]
[317.864718, "i", "r common E. coli codons on ties\n        score += opts.index(c)*.001\n        if best is None or score<best[0]: best=(score,c)\n    return best[1]\n\n# Linker is exactly GSGSG (15 nt), between every adjacent subprotein only.\nprotein='GSGSG'.join(s[1:] if s.startswith('M') else s for _,s in parts)\ndna=''\nfor aa in protein:\n    dna += choose(aa,dna)\n\n# Repair any 50-nt GC violations by selecting synonymous codons in the offending window.\n# The greedy generation above is normally sufficient; this loop makes the constraint explicit.\nfor _ in range(10000):\n    bad=None\n    for i in range(len(dna)-49):\n        q=dna[i:i+50]; f=gc(q)/50\n        if f<.30 or f>.70: bad=i; break\n    if bad is None: break\n    pos=bad+((50-3)//2)//3*3\n    aa=protein[pos//3]\n    opts=sorted(codons[aa],key=lambda c: abs((gc(dna[max(0,pos-47):pos]+c+dna[pos+3:pos+50])-25)))\n    dna=dna[:pos]+opts[0]+dna[pos+3:]\nelse: raise RuntimeError('GC repair failed')\n\nif len(dna)>3000: raise RuntimeError(len(dna))\nif len(dna)%3: raise RuntimeError('frame')\n"]
[317.864786, "o", "n parts:\r\n    if s.startswith('M'): s=s[1:]\r\n    if not s or any(a not in 'ACDEFGHIKLMNPQRSTVWY' for\u001b[?2004h> gfp='MSKGEELFTGVVPILVELDGDVNGHKFSVSGEGEGDATYGKLTLKFICTTGKLPVPWPTLVTTFGYPVDVYQ\r\n\u001b[?2004l\r\u001b[?2004h> LKDNTKTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNYNSHNVYITADKQKNGIKANFKIRHN\r\n\u001b[?2004l\r\u001b[?2004h> IEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSTQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK'\r\n\u001b[?2004l\r\u001b[?2004h> gfp=''.join(gfp.split())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Exact canonical PDB polymer sequences, with construct tags removed where present.\r\n\u001b[?2004l\r"]
[317.865059, "i", "if dna[:3] in ('ATG','TAA','TAG','TGA') or dna[-3:] in ('ATG','TAA','TAG','TGA'): raise RuntimeError('terminal codon')\nopen('/app/gblock.txt','w').write(dna)\nprint('aa_length',len(protein),'nt_length',len(dna),'overall_gc',round(gc(dna)/len(dna),4))\nprint('components',[(n,len(s[1:] if s.startswith('M') else s)) for n,s in parts])\nprint('gc_minmax',min(gc(dna[i:i+50])/50 for i in range(len(dna)-49)),max(gc(dna[i:i+50])/50 for i in range(len(dna)-49)))\nPY\npython3 /tmp/build_gblock.py\nwc -c /app/gblock.txt\nhead -c 120 /app/gblock.txt; printf '\\n'; tail -c 120 /app/gblock.txt; printf '\\n'\n"]
