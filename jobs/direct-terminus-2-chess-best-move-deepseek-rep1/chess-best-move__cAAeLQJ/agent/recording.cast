[23.617291, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\n\ndef dist(c,t):\n    return abs(c[0]-t[0])+abs(c[1]-t[1])+abs(c[2]-t[2])\n\nfor r in range(8):\n    out=[]\n    for f in range(8):\n        box=(f*80,r*80,(f+1)*80,(r+1)*80)\n        blk=wht=non=0\n        for p in im.crop(box).getdata():\n            if max(p)<120:\n                blk+=1\n            if min(p)>220 and max(p)-min(p)<20:\n                wht+=1\n            if dist(p,light)>30 and dist(p,dark)>30:\n                non+=1\n        if non>100:\n            sym='B' if blk>wht else 'W'\n        else:\n            sym='.'\n        out.append(f'{sym}{non:04d}')\n    print(f'{r}: '+' '.join(out))\nPY\n"]
