[210.60591, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\n\ndef getmask(r,f,color,n=16):\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            cnt=0\n            for y in range(r*80+yy*5,r*80+yy*5+5):\n                for x in range(f*80+xx*5,f*80+xx*5+5):\n                    p=im.getpixel((x,y))\n                    if color=='B':\n                        ok=max(p)<80\n                    else:\n                        ok=min(p)>235 and max(p)-min(p)<12\n                    if ok: cnt+=1\n            row += '#' if cnt>=13 else '.'\n        out.append(row)\n    return out\n\nocc=[]\nfor r in range(8):\n    for f in range(8):\n        blk=wht=0\n        for y in range(r*80,(r+1)*80):\n            for x in range(f*80,(f+1)*80):\n                p=im.getpixel((x,y))\n                if max(p)<80: blk+=1\n                if min(p)>235 and max(p)-min(p)<12: wht+=1\n        if blk>150 or wht>150:\n            color='B' if blk>=wht else 'W'\n            occ.append((r,f,color))\n\nfor color in ('B','W'):\n    print('==========', 'BLACK' if color=='B' else 'WHITE', '==========')\n    row_groups={}\n    for c in occ:\n        if c[2]==color: row_groups.setdefault(c[0],[]).append(c)\n    for rr in sorted(row_groups):\n        group=row_groups[rr]\n        print('ROW',rr,[(r,f) for r,f,_ in group])\n        masks=[getmask(r,f,color) for r,f,_ in group]\n        for i in range(16):\n            print('   '.join(m[i] for m in masks))\n        print()\nPY\n"]
