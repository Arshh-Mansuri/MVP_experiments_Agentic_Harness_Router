[107.051371, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef dist(c,t): return abs(c[0]-t[0])+abs(c[1]-t[1])+abs(c[2]-t[2])\ndef getmask(r,f):\n    m=[]\n    for yy in range(16):\n        row=0\n        for xx in range(16):\n            cnt=tot=0\n            for y in range(r*80+yy*5,r*80+yy*5+5):\n                for x in range(f*80+xx*5,f*80+xx*5+5):\n                    p=im.getpixel((x,y))\n                    if dist(p,light)>35 and dist(p,dark)>35: cnt+=1\n                    tot+=1\n            if cnt>=tot/2: row |= 1<<xx\n        m.append(row)\n    return m\ncoords=[]; masks=[]\nfor r in range(8):\n    for f in range(8):\n        non=0\n        for y in range(r*80,(r+1)*80):\n            for x in range(f*80,(f+1)*80):\n                p=im.getpixel((x,y))\n                if dist(p,light)>35 and dist(p,dark)>35: non+=1\n        if non>120:\n            coords.append((r,f)); masks.append(getmask(r,f))\ndef hd(a,b):\n    s=0\n    for x,y in zip(a,b): s+=(x^y).bit_count()\n    return s\nprint('coords/masks',len(coords))\n# print signatures (row number of leftmost/rightmost set bits)\nfor c,m in zip(coords,masks):\n    sig=[]\n    for row in m:\n        if row:\n            l=(row & -row).bit_length()-1; rr=row.bit_length()-1\n            sig.append(f'{l}-{rr}')\n        else: sig.append('.')\n    print(c, ' '.join(sig))\nprint('\\nclusters (threshold 8):')\nused=set()\nfor i in range(len(coords)):\n    if i in used: continue\n    cl=[i]\n    for j in range(i+1,len(coords)):\n        if j in used: continue\n        if hd(masks[i],masks[j])<=8:\n            cl.append(j)\n    if len(cl)>1 or True:\n        print([coords[k] for k in cl])\n        used.update(cl)\nPY\n"]
