[766.820276, "i", "python3 - <<'PY'\nfrom PIL import Image, ImageDraw, ImageFont\nlight=(240,217,181)\nblack_glyphs={ 'pawn':'\\u265f','knight':'\\u265e','bishop':'\\u265d','rook':'\\u265c','queen':'\\u265b','king':'\\u265a' }\nfor fontpath in ['/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf','/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf']:\n    print('FONT',fontpath)\n    for size in [48,56,64,72]:\n        font=ImageFont.truetype(fontpath,size)\n        line=[]\n        for name,ch in black_glyphs.items():\n            im=Image.new('RGB',(80,80),light); d=ImageDraw.Draw(im)\n            d.text((40,40),ch,font=font,fill=(0,0,0),anchor='mm')\n            pts=[(x,y) for y in range(80) for x in range(80) if max(im.getpixel((x,y)))<100]\n            if pts:\n                xs=[x for x,y in pts]; ys=[y for x,y in pts]\n                bb=(min(xs),min(ys),max(xs),max(ys))\n            else: bb=None\n            line.append(f'{name[:2]}:{bb}')\n        print(' size',size,' '.join(line))\nPY\n"]
