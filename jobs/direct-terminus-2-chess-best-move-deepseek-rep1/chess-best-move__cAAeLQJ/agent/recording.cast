[449.77369, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ndef mask(r,f,n=32,thr=15):\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            ok=False\n            for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):\n                for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):\n                    p=im.getpixel((x,y))\n                    if d(p,light)>thr and d(p,dark)>thr: ok=True\n            row += '#' if ok else '.'\n        out.append(row)\n    return out\nfor c in [(3,4),(3,7),(5,2)]:\n    print('COORD',c)\n    for row in mask(*c): print(row)\n    print()\nPY\n"]
