[727.531843, "i", "python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\n\ndef filled_mask(r,f):\n    W=80\n    ink=[[False]*W for _ in range(W)]\n    for y in range(W):\n        for x in range(W):\n            p=im.getpixel((f*W+x,r*W+y))\n            ink[y][x] = d(p,light)>18 and d(p,dark)>18\n    ext=[[False]*W for _ in range(W)]\n    q=deque()\n    for x in range(W):\n        for y in (0,W-1):\n            if not ink[y][x] and not ext[y][x]:\n                ext[y][x]=True; q.append((x,y))\n    for y in range(W):\n        for x in (0,W-1):\n            if not ink[y][x] and not ext[y][x]:\n                ext[y][x]=True; q.append((x,y))\n    while q:\n        x,y=q.popleft()\n        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n            nx,ny=x+dx,y+dy\n            if 0<=nx<W and 0<=ny<W and not ext[ny][nx] and not ink[ny][nx]:\n                ext[ny][nx]=True; q.append((nx,ny))\n    fill=[[not ext[y][x] for x in range(W)] for y in range(W)]\n    # downsample 32\n    n=32; out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            cnt=0\n            for y in range(yy*80//n,(yy+1)*80//n):\n                for x in range(xx*80//n,(xx+1)*80//n):\n                    if fill[y][x]: cnt+=1\n            row += '#' if cnt>= (80//n)**2 * 0.4 else '.'\n        out.append(row)\n    return out\n\ncoords=[(3,4),(3,7),(5,0),(5,2),(6,1),(6,4),(6,5),(6,6),(7,0),(7,2),(7,4),(7,7)]\nfor c in coords:\n    print('COORD',c)\n    for row in filled_mask(*c): print(row)\n    print()\nPY\n"]
[727.533252, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
