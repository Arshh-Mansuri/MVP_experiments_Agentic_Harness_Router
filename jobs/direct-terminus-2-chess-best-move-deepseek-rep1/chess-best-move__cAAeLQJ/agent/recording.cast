[590.786381, "i", "python3 - <<'PY'\nimport io, chess, chess.svg, cairosvg\nfrom PIL import Image, ImageChops\ncolors={'square light':'#f0d9b5','square dark':'#b58863'}\n\ndef render(board, size=640):\n    svg=chess.svg.board(board, size=size, coordinates=False, colors=colors)\n    out=io.BytesIO()\n    cairosvg.svg2png(bytestring=svg.encode(), output_width=size, output_height=size, write_to=out)\n    out.seek(0)\n    return Image.open(out).convert('RGB')\n\ndef sqname(r,f): return chr(ord('a')+f)+str(8-r)\n\ndef crop_at(img,sq):\n    s=chess.parse_square(sq); f=chess.square_file(s); rr=chess.square_rank(s)\n    row=7-rr; col=f\n    return img.crop((col*80,row*80,(col+1)*80,(row+1)*80))\n\ntarget=Image.open('chess_board.png').convert('RGB')\n# occupied squares determined earlier\nocc=[(0,0),(0,2),(0,3),(0,5),(1,1),(1,5),(1,6),(2,0),(2,2),(2,4),(3,3),(3,4),(3,5),(3,6),(3,7),(5,0),(5,2),(6,1),(6,4),(6,5),(6,6),(7,0),(7,2),(7,4),(7,7)]\n# template pixels, one board render per piece (contains piece at a8)\nptypes=[chess.PAWN,chess.KNIGHT,chess.BISHOP,chess.ROOK,chess.QUEEN,chess.KING]\ntemplates={}\nfor color in (chess.WHITE,chess.BLACK):\n    for pt in ptypes:\n        b=chess.Board(None); b.set_piece_at(chess.A8, chess.Piece(pt,color))\n        img=render(b)\n        templates[(color,pt)]= crop_at(img,'a8')\n\nfor r,f in occ:\n    sq=sqname(r,f)\n    tgt=crop_at(target,sq)\n    best=[]\n    for color in (chess.WHITE,chess.BLACK):\n        for pt in ptypes:\n            d=ImageChops.difference(templates[(color,pt)],tgt)\n            s=sum(sum(p) for p in d.getdata())\n            best.append((s,color,pt))\n    best.sort(key=lambda x:x[0])\n    print(sq, [(s, 'W' if c==chess.WHITE else 'B', chess.piece_symbol(p)) for s,c,p in best[:3]])\nPY\n"]
