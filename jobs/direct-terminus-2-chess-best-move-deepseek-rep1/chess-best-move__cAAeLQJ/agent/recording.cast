[570.838135, "i", "python3 - <<'PY'\nimport io, chess, chess.svg, cairosvg\nfrom PIL import Image, ImageChops\ncolors={'square light':'#f0d9b5','square dark':'#b58863'}\ndef render(board, size=640):\n    svg=chess.svg.board(board, size=size, coordinates=False, colors=colors)\n    out=io.BytesIO()\n    cairosvg.svg2png(bytestring=svg.encode(), output_width=size, output_height=size, write_to=out)\n    out.seek(0)\n    return Image.open(out).convert('RGB')\ntarget=Image.open('chess_board.png').convert('RGB')\nfor name, board in [('empty',chess.Board(None))]:\n    img=render(board); diff=ImageChops.difference(img,target)\n    print(name,'full bbox',diff.getbbox(),'full sum',sum(sum(p) for p in diff.getdata()))\n    for sq,(r,f) in {'a8':(0,0),'e4':(4,4)}.items():\n        d=ImageChops.difference(img.crop((f*80,r*80,(f+1)*80,(r+1)*80)), target.crop((f*80,r*80,(f+1)*80,(r+1)*80)))\n        print(name,sq,'bbox',d.getbbox(),'sum',sum(sum(p) for p in d.getdata()))\nb=chess.Board(None); b.set_piece_at(chess.A8, chess.Piece(chess.ROOK, chess.BLACK))\nimg=render(b); d=ImageChops.difference(img.crop((0,0,80,80)), target.crop((0,0,80,80)))\nprint('black rook a8 vs target bbox',d.getbbox(),'sum',sum(sum(p) for p in d.getdata()))\nPY\n"]
