[80.698103, "o", "=== 0 0 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.....######.....\r\n.....######.....\r\n......####......\r\n......####......\r\n......####......\r\n......####......\r\n.....######.....\r\n....########....\r\n................\r\n................\r\n=== 0 2 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.......##.......\r\n.......##.......\r\n......####......\r\n......####......\r\n......####......\r\n......####......\r\n......####......\r\n....########....\r\n....#......#....\r\n................\r\n=== 0 3 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n......####......\r\n....###..###....\r\n....#.#..#.#....\r\n.....######.....\r\n.....######.....\r\n......####......\r\n......####......\r\n......####......\r\n......####......\r\n................\r\n=== 0 5 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.....######.....\r\n.....######.....\r\n......####......\r\n......####......\r\n......####......\r\n......####......\r\n.....######.....\r\n.....######.....\r\n................\r\n................\r\n=== 1 1 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.......##.......\r\n.......##.......\r\n......####......\r\n......####......\r\n......####......\r\n.....######.....\r\n.....######.....\r\n....########....\r\n................\r\n................\r\n=== 1 5 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.......##.......\r\n.......##.......\r\n......####......\r\n......####......\r\n......####......\r\n.....######.....\r\n.....######.....\r\n....########....\r\n................\r\n................\r\n"]
[80.698188, "o", "=== 1 6 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.......##.......\r\n.......##.......\r\n......####......\r\n......####......\r\n......####......\r\n.....######.....\r\n.....######.....\r\n....########....\r\n................\r\n................\r\n=== 2 0 ===\r\n................\r\n................\r\n................\r\n................\r\n................\r\n................\r\n.......##.......\r\n.......##.......\r\n......####......\r\n......####......\r\n"]
