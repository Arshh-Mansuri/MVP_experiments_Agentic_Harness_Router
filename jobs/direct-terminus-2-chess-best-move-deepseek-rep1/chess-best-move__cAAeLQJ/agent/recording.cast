[343.861335, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\ndef mask(r,f,n=32):\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            cnt=0\n            for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):\n                for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):\n                    p=im.getpixel((x,y))\n                    if max(p)<100: cnt+=1\n            row += '#' if cnt>= (80//n)**2/2 else '.'\n        out.append(row)\n    return out\ncoords=[(1,1),(1,5),(1,6),(2,0),(2,2),(2,4),(3,3),(3,5),(3,6)]\nfor c in coords:\n    print('COORD',c)\n    for row in mask(*c): print(row)\n    print()\nPY\n"]
[343.868438, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> def mask(r,f,n=32):\r\n\u001b[?2004l\r\u001b[?2004h>     out=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for yy in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>         row=''\r\n\u001b[?2004l\r\u001b[?2004h>         for xx in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>             cnt=0\r\n\u001b[?2004l\r\u001b[?2004h>             for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):\r\n\u001b[?2004l\r\u001b[?2004h>                 for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
