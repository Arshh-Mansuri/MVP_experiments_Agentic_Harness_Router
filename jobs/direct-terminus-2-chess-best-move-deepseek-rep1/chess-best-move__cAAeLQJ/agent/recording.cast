[200.128161, "i", "python3 - <<'PY'\nfrom PIL import Image\nfrom collections import Counter\nim=Image.open('chess_board.png').convert('RGB')\nfor name,(r,f) in [('black pawn',(1,1)),('black maybe rook',(0,0)),('white pawn',(5,0)),('white unique',(6,4)),('white rook?',(7,0))]:\n    c=Counter()\n    for y in range(r*80,(r+1)*80):\n        for x in range(f*80,(f+1)*80):\n            c[im.getpixel((x,y))]+=1\n    print('\\n',name,(r,f))\n    for col,n in c.most_common(10): print(col,n)\nPY\n"]
