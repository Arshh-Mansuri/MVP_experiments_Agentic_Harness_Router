[265.036089, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ndef mask(r,f,n=24):\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            cnt=0\n            for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):\n                for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):\n                    p=im.getpixel((x,y))\n                    if d(p,light)>45 and d(p,dark)>45: cnt+=1\n            tot=(80//n)**2\n            row += '#' if cnt>=tot/2 else '.'\n        out.append(row)\n    return out\ncoords=[(3,4),(3,7),(5,0),(5,2)]\nms=[mask(*c) for c in coords]\nprint('COORDS',coords)\nfor i in range(24):\n    print('   '.join(m[i] for m in ms))\nPY\n"]
