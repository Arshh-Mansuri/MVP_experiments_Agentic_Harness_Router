[11.139487, "i", "python3 - <<'PY'\nfrom PIL import Image\nfrom collections import Counter\nim=Image.open('chess_board.png').convert('RGB')\nw,h=im.size\nc=Counter(im.getdata())\nprint('top colors:')\nfor col,n in c.most_common(20):\n    print(col,n)\nprint('center samples:')\nfor r in range(8):\n    row=[]\n    for f in range(8):\n        x=int((f+0.5)*w/8); y=int((r+0.5)*h/8)\n        row.append(im.getpixel((x,y)))\n    print(r, row)\nPY\n"]
