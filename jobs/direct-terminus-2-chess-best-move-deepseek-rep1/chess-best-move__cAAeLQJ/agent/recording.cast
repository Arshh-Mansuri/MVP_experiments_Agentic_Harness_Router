[285.964656, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ndef mask(r,f,n=40,thr=15):\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            ok=False\n            for dy in (0,1):\n                for dx in (0,1):\n                    p=im.getpixel((f*80+xx*2+dx, r*80+yy*2+dy))\n                    if d(p,light)>thr and d(p,dark)>thr:\n                        ok=True\n            row += '#' if ok else '.'\n        out.append(row)\n    return out\nfor c in [(5,0),(6,4)]:\n    print('COORD',c)\n    m=mask(*c)\n    for row in m: print(row)\n    print()\nPY\n"]
