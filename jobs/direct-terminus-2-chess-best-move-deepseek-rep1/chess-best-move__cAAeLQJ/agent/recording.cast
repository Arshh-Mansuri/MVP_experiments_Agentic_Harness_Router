[230.783292, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ndef mask(r,f,white=False,n=40):\n    m=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            # sample 2x2 for 80->40\n            cnt=0\n            for dy in (0,1):\n                for dx in (0,1):\n                    p=im.getpixel((f*80+xx*2+dx, r*80+yy*2+dy))\n                    if white:\n                        good=d(p,light)>45 and d(p,dark)>45\n                    else:\n                        good=max(p)<180\n                    if good: cnt+=1\n            row += '#' if cnt>=2 else '.'\n        m.append(row)\n    return m\ncoords=[(0,0),(0,2),(0,3),(0,5)]\nfor c in coords:\n    print('COORD',c, 'BLACK')\n    m=mask(*c)\n    for row in m: print(row)\n    print()\nPY\n"]
