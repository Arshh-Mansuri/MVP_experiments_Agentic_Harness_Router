[18.283759, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nim=np.array(Image.open('chess_board.png').convert('RGB'))\nh,w,_=im.shape\nsqh=sqh=80\n# background colors\nlight=np.array([240,217,181]); dark=np.array([181,136,99])\nfor r in range(8):\n    line=[]\n    for f in range(8):\n        block=im[r*80:(r+1)*80, f*80:(f+1)*80].astype(int)\n        dbg=np.abs(block-dark).sum(axis=2)\n        lbg=np.abs(block-light).sum(axis=2)\n        bg=(dbg<40)|(lbg<40)\n        blk=(block.sum(axis=2)<80)\n        wht=(block.min(axis=2)>235)\n        nb=bg=mask=0\n        non=~bg\n        nblk=int((blk&non).sum())\n        nwht=int((wht&non).sum())\n        # component bbox-ish for non-bg\n        ys,xs=np.where(non)\n        bbox='.'\n        if len(xs):\n            bbox=f'{xs.min()}-{xs.max()},{ys.min()}-{ys.max()}'\n        line.append(f'{nblk:4d}/{nwht:4d} {bbox}')\n    print(f'{r}: '+' | '.join(line))\nPY\n"]
