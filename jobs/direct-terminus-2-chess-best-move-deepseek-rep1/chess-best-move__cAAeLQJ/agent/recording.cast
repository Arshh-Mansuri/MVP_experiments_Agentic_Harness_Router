[51.009651, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef dist(c,t): return abs(c[0]-t[0])+abs(c[1]-t[1])+abs(c[2]-t[2])\nlines=[]\nfor r in range(8):\n    for f in range(8):\n        blk=wht=non=0\n        for y in range(r*80,(r+1)*80):\n            for x in range(f*80,(f+1)*80):\n                p=im.getpixel((x,y))\n                if max(p)<120: blk+=1\n                if min(p)>220 and max(p)-min(p)<20: wht+=1\n                if dist(p,light)>35 and dist(p,dark)>35: non+=1\n        if non>120:\n            c=im.getpixel((f*80+40,r*80+40))\n            lines.append(f'{r} {f} non={non:4d} blk={blk:4d} wht={wht:4d} center={c}')\nopen('/tmp/occ.txt','w').write('\\n'.join(lines)+'\\n')\nprint('occupied lines',len(lines))\nPY\nwc -l /tmp/occ.txt\n"]
