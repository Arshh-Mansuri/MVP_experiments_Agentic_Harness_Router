[368.657353, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ncoords=[(0,0),(0,2),(0,3),(0,5),(2,2),(3,3),(3,5),(3,6)]\nfor r,f in coords:\n    pts=[]\n    minx=miny=999; maxx=maxy=-1\n    for y in range(80):\n        for x in range(80):\n            p=im.getpixel((f*80+x,r*80+y))\n            if d(p,light)>35 and d(p,dark)>35:\n                pts.append((x,y))\n                minx=min(minx,x);maxx=max(maxx,x);miny=min(miny,y);maxy=max(maxy,y)\n    rows={}\n    for x,y in pts: rows.setdefault(y,[]).append(x)\n    print(f'=== ({r},{f}) bbox x {minx}-{maxx} y {miny}-{maxy} area {len(pts)}')\n    out=[]\n    for y in range(miny,maxy+1):\n        if y in rows: out.append(f'{y}:{min(rows[y])}-{max(rows[y])}({len(rows[y])})')\n        else: out.append(f'{y}:')\n    print(' '.join(out))\nPY\n"]
