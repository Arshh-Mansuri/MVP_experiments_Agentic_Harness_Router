[802.967093, "i", "python3 - <<'PY'\nfrom PIL import Image, ImageDraw, ImageFont\nimport glob\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\ndef raw_fill_mask(r,f):\n    W=80; pts=[]; grid=[[0]*W for _ in range(W)]\n    for y in range(W):\n        for x in range(W):\n            p=im.getpixel((f*W+x,r*W+y))\n            if d(p,light)>25 and d(p,dark)>25:\n                grid[y][x]=1; pts.append((x,y))\n    minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)\n    return grid,minx,miny,maxx,maxy\n\ndef norm_mask(grid,minx,miny,maxx,maxy,n=32):\n    out=[]; w=maxx-minx+1; h=maxy-miny+1\n    for yy in range(n):\n        row=0\n        for xx in range(n):\n            x0=minx+xx*w//n; x1=minx+(xx+1)*w//n; y0=miny+yy*h//n; y1=miny+(yy+1)*h//n\n            cnt=tot=0\n            for y in range(y0,y1):\n                for x in range(x0,x1):\n                    cnt+=grid[y][x]; tot+=1\n            if cnt>=tot*0.35: row|=1<<xx\n        out.append(row)\n    return out\n\ndef hd(a,b): return sum((x^y).bit_count() for x,y in zip(a,b))\n\nblack_syms={'K':'\\u265a','Q':'\\u265b','R':'\\u265c','B':'\\u265d','N':'\\u265e','P':'\\u265f'}\nwhite_syms={'K':'\\u2654','Q':'\\u2655','R':'\\u2656','B':'\\u2657','N':'\\u2658','P':'\\u2659'}\n\ndef render_norm(ch,fontpath,size):\n    font=ImageFont.truetype(fontpath,size)\n    img=Image.new('RGB',(120,120),light); dr=ImageDraw.Draw(img)\n    dr.text((60,60),ch,font=font,fill=(0,0,0),anchor='mm')\n    W=120; pts=[]; grid=[[0]*W for _ in range(W)]\n    for y in range(W):\n        for x in range(W):\n            p=img.getpixel((x,y))\n            if d(p,light)>25:\n                grid[y][x]=1; pts.append((x,y))\n    if not pts: return None\n    minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)\n    return norm_mask(grid,minx,miny,maxx,maxy)\n\nfonts=glob.glob('/usr/share/fonts/**/*.ttf', recursive=True)\nentries={\n 'a8_rook': (0,0), 'c8': (0,2), 'd8_queen': (0,3), 'f8': (0,5),\n 'b7_pawn': (1,1), 'g7': (1,6), 'c6': (2,2), 'd5': (3,3),\n 'f5': (3,5), 'g5': (3,6)\n}\nfor name,(r,f) in entries.items():\n    grid,minx,miny,maxx,maxy=raw_fill_mask(r,f)\n    tgt=norm_mask(grid,minx,miny,maxx,maxy)\n    best=[]\n    for fp in fonts:\n        for size in range(20,90):\n            for sym,ch in black_syms.items():\n                m=render_norm(ch,fp,size)\n                if m is None: continue\n                best.append((hd(tgt,m),fp.split('/')[-1],size,sym))\n    best.sort(key=lambda x:x[0])\n    print('\\n',name,(r,f),'best:')\n    for x in best[:8]: print(x)\nPY\n"]
