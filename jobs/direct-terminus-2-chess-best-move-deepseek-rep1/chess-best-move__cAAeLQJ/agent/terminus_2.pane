[?2004hroot@30ef363e296f:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])
[?2004l[?2004h> def mask(r,f,n=24):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             cnt=0
[?2004l[?2004h>             for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):
[?2004l[?2004h>                 for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):
[?2004l[?2004h>                     p=im.getpixel((x,y))
[?2004l[?2004h>                     if d(p,light)>45 and d(p,dark)>45: cnt+=1
[?2004l[?2004h>             tot=(80//n)**2
[?2004l[?2004h>             row += '#' if cnt>=tot/2 else '.'
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> coords=[(3,4),(3,7),(5,0),(5,2)]
[?2004l[?2004h> ms=[mask(*c) for c in coords]
[?2004l[?2004h> print('COORDS',coords)
[?2004l[?2004h> for i in range(24):
[?2004l[?2004h>     print('   '.join(m[i] for m in ms))
[?2004l[?2004h> PY
