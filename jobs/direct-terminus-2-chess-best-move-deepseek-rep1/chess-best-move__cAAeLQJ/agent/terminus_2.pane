[?2004hroot@30ef363e296f:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image, ImageDraw, ImageFont
[?2004l[?2004h> import glob
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])
[?2004l[?2004h> def raw_fill_mask(r,f):
[?2004l[?2004h>     W=80; pts=[]; grid=[[0]*W for _ in range(W)]
[?2004l[?2004h>     for y in range(W):
[?2004l[?2004h>         for x in range(W):
[?2004l[?2004h>             p=im.getpixel((f*W+x,r*W+y))
[?2004l[?2004h>             if d(p,light)>25 and d(p,dark)>25:
[?2004l[?2004h>                 grid[y][x]=1; pts.append((x,y))
[?2004l[?2004h>     minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)
[?2004l[?2004h>     return grid,minx,miny,maxx,maxy
[?2004l[?2004h> 
[?2004l[?2004h> def norm_mask(grid,minx,miny,maxx,maxy,n=32):
[?2004l[?2004h>     out=[]; w=maxx-minx+1; h=maxy-miny+1
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=0
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             x0=minx+xx*w//n; x1=minx+(xx+1)*w//n; y0=miny+yy*h//n; y1=miny+(yy+1)*h//n
[?2004l[?2004h>             cnt=tot=0
[?2004l[?2004h>             for y in range(y0,y1):
[?2004l[?2004h>                 for x in range(x0,x1):
[?2004l[?2004h>                     cnt+=grid[y][x]; tot+=1
[?2004l[?2004h>             if cnt>=tot*0.35: row|=1<<xx
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def hd(a,b): return sum((x^y).bit_count() for x,y in zip(a,b))
[?2004l[?2004h> 
[?2004l[?2004h> black_syms={'K':'\u265a','Q':'\u265b','R':'\u265c','B':'\u265d','N':'\u265e','P':'\u265f'}
[?2004l[?2004h> white_syms={'K':'\u2654','Q':'\u2655','R':'\u2656','B':'\u2657','N':'\u2658','P':'\u2659'}
[?2004l[?2004h> 
[?2004l[?2004h> def render_norm(ch,fontpath,size):
[?2004l[?2004h>     font=ImageFont.truetype(fontpath,size)
[?2004l[?2004h>     img=Image.new('RGB',(120,120),light); dr=ImageDraw.Draw(img)
[?2004l[?2004h>     dr.text((60,60),ch,font=font,fill=(0,0,0),anchor='mm')
[?2004l[?2004h>     W=120; pts=[]; grid=[[0]*W for _ in range(W)]
[?2004l[?2004h>     for y in range(W):
[?2004l[?2004h>         for x in range(W):
[?2004l[?2004h>             p=img.getpixel((x,y))
[?2004l[?2004h>             if d(p,light)>25:
[?2004l[?2004h>                 grid[y][x]=1; pts.append((x,y))
[?2004l[?2004h>     if not pts: return None
[?2004l[?2004h>     minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)
[?2004l[?2004h>     return norm_mask(grid,minx,miny,maxx,maxy)
[?2004l[?2004h> 
[?2004l[?2004h> fonts=glob.glob('/usr/share/fonts/**/*.ttf', recursive=True)
[?2004l[?2004h> entries={
[?2004l[?2004h>  'a8_rook': (0,0), 'c8': (0,2), 'd8_queen': (0,3), 'f8': (0,5),
[?2004l[?2004h>  'b7_pawn': (1,1), 'g7': (1,6), 'c6': (2,2), 'd5': (3,3),
[?2004l[?2004h>  'f5': (3,5), 'g5': (3,6)
[?2004l[?2004h> }
[?2004l[?2004h> for name,(r,f) in entries.items():
[?2004l[?2004h>     grid,minx,miny,maxx,maxy=raw_fill_mask(r,f)
[?2004l[?2004h>     tgt=norm_mask(grid,minx,miny,maxx,maxy)
[?2004l[?2004h>     best=[]
[?2004l[?2004h>     for fp in fonts:
[?2004l[?2004h>         for size in range(20,90):
[?2004l[?2004h>             for sym,ch in black_syms.items():
[?2004l[?2004h>                 m=render_norm(ch,fp,size)
