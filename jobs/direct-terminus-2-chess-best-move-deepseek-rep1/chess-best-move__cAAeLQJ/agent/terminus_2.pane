[?2004hroot@30ef363e296f:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])
[?2004l[?2004h> def mask(r,f,white=False,n=40):
[?2004l[?2004h>     m=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             # sample 2x2 for 80->40
[?2004l[?2004h>             cnt=0
[?2004l[?2004h>             for dy in (0,1):
[?2004l[?2004h>                 for dx in (0,1):
[?2004l[?2004h>                     p=im.getpixel((f*80+xx*2+dx, r*80+yy*2+dy))
[?2004l[?2004h>                     if white:
[?2004l[?2004h>                         good=d(p,light)>45 and d(p,dark)>45
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         good=max(p)<180
[?2004l[?2004h>                     if good: cnt+=1
[?2004l[?2004h>             row += '#' if cnt>=2 else '.'
[?2004l[?2004h>         m.append(row)
[?2004l[?2004h>     return m
[?2004l[?2004h> coords=[(0,0),(0,2),(0,3),(0,5)]
[?2004l[?2004h> for c in coords:
[?2004l[?2004h>     print('COORD',c, 'BLACK')
[?2004l[?2004h>     m=mask(*c)
[?2004l[?2004h>     for row in m: print(row)
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
[?2004lCOORD (0, 0) BLACK
