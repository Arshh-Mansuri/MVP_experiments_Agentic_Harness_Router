[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> from collections import deque
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> 
[?2004l[?2004h> def piece_mask(r,f,n=16):
[?2004l[?2004h>     W=80
[?2004l[?2004h>     dark=[[False]*W for _ in range(W)]
[?2004l[?2004h>     for y in range(W):
[?2004l[?2004h>         for x in range(W):
[?2004l[?2004h>             p=im.getpixel((f*W+x,r*W+y))
[?2004l[?2004h>             dark[y][x]=(max(p)<180)
[?2004l[?2004h>     # flood fill exterior through non-dark pixels
[?2004l[?2004h>     ext=[[False]*W for _ in range(W)]
[?2004l[?2004h>     q=deque()
[?2004l[?2004h>     for x in range(W):
[?2004l[?2004h>         for y in (0,W-1):
[?2004l[?2004h>             if not dark[y][x] and not ext[y][x]:
[?2004l[?2004h>                 ext[y][x]=True; q.append((x,y))
[?2004l[?2004h>     for y in range(W):
[?2004l[?2004h>         for x in (0,W-1):
[?2004l[?2004h>             if not dark[y][x] and not ext[y][x]:
[?2004l[?2004h>                 ext[y][x]=True; q.append((x,y))
[?2004l[?2004h>     while q:
[?2004l[?2004h>         x,y=q.popleft()
[?2004l[?2004h>         for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
[?2004l[?2004h>             nx,ny=x+dx,y+dy
[?2004l[?2004h>             if 0<=nx<W and 0<=ny<W and not ext[ny][nx] and not dark[ny][nx]:
[?2004l[?2004h>                 ext[ny][nx]=True; q.append((nx,ny))
[?2004l[?2004h>     fill=[[not ext[y][x] for x in range(W)] for y in range(W)]
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             cnt=0
[?2004l[?2004h>             for y in range(yy*5,yy*5+5):
[?2004l[?2004h>                 for x in range(xx*5,xx*5+5):
[?2004l[?2004h>                     if fill[y][x]: cnt+=1
[?2004l[?2004h>             row += '#' if cnt>=13 else '.'
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> coords=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         non=0
[?2004l[?2004h>         for y in range(r*80,(r+1)*80):
[?2004l[?2004h>             for x in range(f*80,(f+1)*80):
[?2004l[?2004h>                 p=im.getpixel((x,y))
[?2004l[?2004h>                 # quick non-bg count
[?2004l[?2004h>                 if abs(p[0]-240)+abs(p[1]-217)+abs(p[2]-181)>35 and abs(p[0]-181)+abs(p[1]-136)+abs(p[2]-99)>35:
[?2004l[?2004h>                     non+=1
[?2004l[?2004h>         if non>120: coords.append((r,f))
[?2004l[?2004h> masks={c:piece_mask(*c) for c in coords}
[?2004l[?2004h> # print groups of 4 side by side
[?2004l[?2004h> for gi in range(0,len(coords),4):
[?2004l[?2004h>     grp=coords[gi:gi+4]
[?2004l[?2004h>     print('GROUP',grp)
[?2004l[?2004h>     for i in range(16):
[?2004l[?2004h>         print('   '.join(masks[c][i] for c in grp))
[?2004l[?2004h>     print()
