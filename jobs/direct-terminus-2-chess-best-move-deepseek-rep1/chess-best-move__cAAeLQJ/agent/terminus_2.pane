[?2004l[?2004h>                     p=im.getpixel((x,y))
[?2004l[?2004h>                     if dist(p,light)>35 and dist(p,dark)>35: cnt+=1
[?2004l[?2004h>                     tot+=1
[?2004l[?2004h>             if cnt>=tot/2: row |= 1<<xx
[?2004l[?2004h>         m.append(row)
[?2004l[?2004h>     return m
[?2004l[?2004h> coords=[]; masks=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         non=0
[?2004l[?2004h>         for y in range(r*80,(r+1)*80):
[?2004l[?2004h>             for x in range(f*80,(f+1)*80):
[?2004l[?2004h>                 p=im.getpixel((x,y))
[?2004l[?2004h>                 if dist(p,light)>35 and dist(p,dark)>35: non+=1
[?2004l[?2004h>         if non>120:
[?2004l[?2004h>             coords.append((r,f)); masks.append(getmask(r,f))
[?2004l[?2004h> def hd(a,b):
[?2004l[?2004h>     s=0
[?2004l[?2004h>     for x,y in zip(a,b): s+=(x^y).bit_count()
[?2004l[?2004h>     return s
[?2004l[?2004h> print('coords/masks',len(coords))
[?2004l[?2004h> # print signatures (row number of leftmost/rightmost set bits)
[?2004l[?2004h> for c,m in zip(coords,masks):
[?2004l[?2004h>     sig=[]
[?2004l[?2004h>     for row in m:
[?2004l[?2004h>         if row:
[?2004l[?2004h>             l=(row & -row).bit_length()-1; rr=row.bit_length()-1
[?2004l[?2004h>             sig.append(f'{l}-{rr}')
[?2004l[?2004h>         else: sig.append('.')
[?2004l[?2004h>     print(c, ' '.join(sig))
