[?2004hroot@30ef363e296f:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> def mask(r,f,n=32):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             cnt=0
[?2004l[?2004h>             for y in range(r*80+yy*80//n, r*80+(yy+1)*80//n):
[?2004l[?2004h>                 for x in range(f*80+xx*80//n, f*80+(xx+1)*80//n):
[?2004l[?2004h>                     p=im.getpixel((x,y))
[?2004l[?2004h>                     if max(p)<100: cnt+=1
[?2004l[?2004h>             row += '#' if cnt>= (80//n)**2/2 else '.'
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> coords=[(1,1),(1,5),(1,6),(2,0),(2,2),(2,4),(3,3),(3,5),(3,6)]
[?2004l[?2004h> for c in coords:
[?2004l[?2004h>     print('COORD',c)
[?2004l[?2004h>     for row in mask(*c): print(row)
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
[?2004lCOORD (1, 1)
