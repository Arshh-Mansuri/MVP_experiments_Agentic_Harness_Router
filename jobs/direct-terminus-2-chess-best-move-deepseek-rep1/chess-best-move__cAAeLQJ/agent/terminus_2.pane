[?2004l[?2004h>         print('ROW',rr,[(r,f) for r,f,_ in group])
[?2004l[?2004h>         masks=[getmask(r,f,color) for r,f,_ in group]
[?2004l[?2004h>         for i in range(16):
[?2004l[?2004h>             print('   '.join(m[i] for m in masks))
[?2004l[?2004h>         print()
