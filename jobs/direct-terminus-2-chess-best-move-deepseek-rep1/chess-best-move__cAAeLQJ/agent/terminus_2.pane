[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> 
[?2004l[?2004h> def getmask(r,f,color,n=16):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             cnt=0
[?2004l[?2004h>             for y in range(r*80+yy*5,r*80+yy*5+5):
[?2004l[?2004h>                 for x in range(f*80+xx*5,f*80+xx*5+5):
[?2004l[?2004h>                     p=im.getpixel((x,y))
[?2004l[?2004h>                     if color=='B':
[?2004l[?2004h>                         ok=max(p)<80
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         ok=min(p)>235 and max(p)-min(p)<12
[?2004l[?2004h>                     if ok: cnt+=1
[?2004l[?2004h>             row += '#' if cnt>=13 else '.'
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> occ=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         blk=wht=0
[?2004l[?2004h>         for y in range(r*80,(r+1)*80):
[?2004l[?2004h>             for x in range(f*80,(f+1)*80):
[?2004l[?2004h>                 p=im.getpixel((x,y))
[?2004l[?2004h>                 if max(p)<80: blk+=1
[?2004l[?2004h>                 if min(p)>235 and max(p)-min(p)<12: wht+=1
[?2004l[?2004h>         if blk>150 or wht>150:
[?2004l[?2004h>             color='B' if blk>=wht else 'W'
[?2004l[?2004h>             occ.append((r,f,color))
[?2004l[?2004h> 
[?2004l[?2004h> for color in ('B','W'):
[?2004l[?2004h>     print('==========', 'BLACK' if color=='B' else 'WHITE', '==========')
[?2004l[?2004h>     row_groups={}
[?2004l[?2004h>     for c in occ:
[?2004l[?2004h>         if c[2]==color: row_groups.setdefault(c[0],[]).append(c)
[?2004l[?2004h>     for rr in sorted(row_groups):
