[?2004hroot@30ef363e296f:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])
[?2004l[?2004h> def mask(r,f,n=40,thr=15):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(n):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(n):
[?2004l[?2004h>             ok=False
[?2004l[?2004h>             for dy in (0,1):
[?2004l[?2004h>                 for dx in (0,1):
[?2004l[?2004h>                     p=im.getpixel((f*80+xx*2+dx, r*80+yy*2+dy))
[?2004l[?2004h>                     if d(p,light)>thr and d(p,dark)>thr:
[?2004l[?2004h>                         ok=True
[?2004l[?2004h>             row += '#' if ok else '.'
[?2004l[?2004h>         out.append(row)
[?2004l[?2004h>     return out
[?2004l[?2004h> for c in [(5,0),(6,4)]:
[?2004l[?2004h>     print('COORD',c)
[?2004l[?2004h>     m=mask(*c)
[?2004l[?2004h>     for row in m: print(row)
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
