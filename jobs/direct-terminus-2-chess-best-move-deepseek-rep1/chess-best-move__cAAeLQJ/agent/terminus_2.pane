[?2004l[?2004h>                 best.append((hd(tgt,m),fp.split('/')[-1],size,sym))
[?2004l[?2004h>     best.sort(key=lambda x:x[0])
[?2004l[?2004h>     print('\n',name,(r,f),'best:')
