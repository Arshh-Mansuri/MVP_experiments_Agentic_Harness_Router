Sending keys: ["python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nim=Image.open('chess_board.png').convert('RGB')\n\ndef piece_mask(r,f,n=16):\n    W=80\n    dark=[[False]*W for _ in range(W)]\n    for y in range(W):\n        for x in range(W):\n            p=im.getpixel((f*W+x,r*W+y))\n            dark[y][x]=(max(p)<180)\n    # flood fill exterior through non-dark pixels\n    ext=[[False]*W for _ in range(W)]\n    q=deque()\n    for x in range(W):\n        for y in (0,W-1):\n            if not dark[y][x] and not ext[y][x]:\n                ext[y][x]=True; q.append((x,y))\n    for y in range(W):\n        for x in (0,W-1):\n            if not dark[y][x] and not ext[y][x]:\n                ext[y][x]=True; q.append((x,y))\n    while q:\n        x,y=q.popleft()\n        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n            nx,ny=x+dx,y+dy\n            if 0<=nx<W and 0<=ny<W and not ext[ny][nx] and not dark[ny][nx]:\n                ext[ny][nx]=True; q.append((nx,ny))\n    fill=[[not ext[y][x] for x in range(W)] for y in range(W)]\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            cnt=0\n            for y in range(yy*5,yy*5+5):\n                for x in range(xx*5,xx*5+5):\n                    if fill[y][x]: cnt+=1\n            row += '#' if cnt>=13 else '.'\n        out.append(row)\n    return out\n\ncoords=[]\nfor r in range(8):\n    for f in range(8):\n        non=0\n        for y in range(r*80,(r+1)*80):\n            for x in range(f*80,(f+1)*80):\n                p=im.getpixel((x,y))\n                # quick non-bg count\n                if abs(p[0]-240)+abs(p[1]-217)+abs(p[2]-181)>35 and abs(p[0]-181)+abs(p[1]-136)+abs(p[2]-99)>35:\n                    non+=1\n        if non>120: coords.append((r,f))\nmasks={c:piece_mask(*c) for c in coords}\n# print groups of 4 side by side\nfor gi in range(0,len(coords),4):\n    grp=coords[gi:gi+4]\n    print('GROUP',grp)\n    for i in range(16):\n        print('   '.join(masks[c][i] for c in grp))\n    print()\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
