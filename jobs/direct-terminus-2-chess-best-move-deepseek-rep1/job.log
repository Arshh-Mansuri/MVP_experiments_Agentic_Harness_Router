Sending keys: ["python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('chess_board.png').convert('RGB')\nlight=(240,217,181); dark=(181,136,99)\ndef d(p,t): return abs(p[0]-t[0])+abs(p[1]-t[1])+abs(p[2]-t[2])\n\ndef rawmask(r,f):\n    pts=[]; grid=[[0]*80 for _ in range(80)]\n    for y in range(80):\n        for x in range(80):\n            p=im.getpixel((f*80+x,r*80+y))\n            if d(p,light)>25 and d(p,dark)>25:\n                grid[y][x]=1; pts.append((x,y))\n    if not pts: return None\n    minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)\n    w=maxx-minx+1; h=maxy-miny+1; n=32\n    out=[]\n    for yy in range(n):\n        row=''\n        for xx in range(n):\n            x0=minx+xx*w//n; x1=minx+(xx+1)*w//n; y0=miny+yy*h//n; y1=miny+(yy+1)*h//n\n            cnt=tot=0\n            for y in range(y0,y1):\n                for x in range(x0,x1):\n                    cnt+=grid[y][x]; tot+=1\n            row += '#' if cnt>=tot/2 else '.'\n        out.append(row)\n    return out, (minx,miny,maxx,maxy), w, h, sum(len([1 for x in range(80) if grid[y][x]]) for y in range(80))\n\nocc=[]\nfor r in range(8):\n    for f in range(8):\n        non=sum(1 for y in range(80) for x in range(80) if d(im.getpixel((f*80+x,r*80+y)),light)>25 and d(im.getpixel((f*80+x,r*80+y)),dark)>25)\n        if non>120: occ.append((r,f))\n\nentries=[]\nfor r,f in occ:\n    m,bbox,w,h,area=rawmask(r,f)\n    entries.append((r,f,m,bbox,w,h,area))\n\ndef hd(a,b): return sum((x^y).bit_count() for x,y in zip(a,b))\n# use string masks converted bitset rows easier\ndef tobits(m): return [int(row.replace('.','0').replace('#','1'),2) for row in m]\nfor e in entries: e[2]=tobits(e[2])\n\nused=set(); clusters=[]\nfor i in range(len(entries)):\n    if i in used: continue\n    cl=[i]; used.add(i)\n    changed=True\n    while changed:\n        changed=False\n        for j in range(len(entries)):\n            if j in used: continue\n            if any(hd(entries[j][2],entries[k][2])<=35 for k in cl):\n                cl.append(j); used.add(j); changed=True\n    clusters.append(cl)\n\nprint('clusters',len(clusters))\nfor ci,cl in enumerate(clusters):\n    labels=[(entries[k][0],entries[k][1],entries[k][4],entries[k][5],entries[k][6]) for k in cl]\n    print('CLUSTER',ci,labels)\n# print representative first 24x24? just full 32 for first member\nfor ci,cl in enumerate(clusters):\n    k=cl[0]; m=entries[k][2]\n    print('=== REP',ci,(entries[k][0],entries[k][1]),'members',len(cl))\n    for row in m: print(''.join('#' if (row>>(31-xx))&1 else '.' for xx in range(32)))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
