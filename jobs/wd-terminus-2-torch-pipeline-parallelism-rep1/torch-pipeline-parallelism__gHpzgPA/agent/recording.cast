[30.89201, "i", "cat > /app/pipeline_parallel.py <<'PY'\n\"\"\"AFAB pipeline-parallel training step for Hugging Face LLaMA models.\"\"\"\n\nimport torch\nimport torch.distributed as dist\nimport torch.nn.functional as F\n\n\ndef _layer_forward(layer, hidden_states, position_ids):\n    \"\"\"Call a LLaMA decoder layer across common Transformers versions.\"\"\"\n    try:\n        result = layer(hidden_states, position_ids=position_ids)\n    except TypeError:\n        result = layer(hidden_states)\n    if isinstance(result, (tuple, list)):\n        return result[0]\n    return result\n\n\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    \"\"\"Run one all-forward/all-backward pipeline-parallel training step.\n\n    ``inputs`` and ``targets`` are lists of microbatches.  The model is\n    replicated on each process, but only the process' contiguous layer range\n    is executed.  Gradients remain attached to the original model parameters.\n    \"\"\"\n    if not dist.is_available() or not dist.is_initialized():\n        raise RuntimeError(\"the distributed process group must be initialized\")\n\n    rank = dist.get_rank()\n    world_size = dist.get_world_size()\n    if len(inputs) != len(targets):\n        raise ValueError(\"inputs and targets must contain the same microbatches\")\n    if not inputs:\n        raise ValueError(\"at least one microbatch is required\")\n\n    n_microbatches = len(inputs)\n    llama = model.model\n    layers = llama.layers\n    n_layers = len(layers)\n\n    # Proportional boundaries give every rank either floor or ceil(n/world)\n    # layers and also work when the number of ranks exceeds the layer count.\n    first_layer = (rank * n_layers) // world_size\n    last_layer = ((rank + 1) * n_layers) // world_size\n    local_layers = layers[first_layer:last_layer]\n    is_first = rank == 0\n    is_last = rank == world_size - 1\n\n    hidden_size = getattr(model.config, \"hidden_size\", None)\n    if hidden_size is None:\n        hidden_size = llama.embed_tokens.embedding_dim\n\n    # Tags are unique per direction and microbatch.  Keeping one send and one\n    # receive in pipeline order avoids requiring a global barrier.\n    fwd_tag = lambda mb: mb\n    bwd_tag = lambda mb: n_microbatches + mb\n\n    saved_inputs = []\n    saved_outputs = []\n    losses = []\n\n    # ---------------------------- all forward ----------------------------\n    for mb, input_ids in enumerate(inputs):\n        input_ids = input_ids.to(device=device)\n        shape = tuple(input_ids.shape)\n        if len(shape) != 2:\n            raise ValueError(\"each input microbatch must have shape [batch, seq]\")\n        batch_size, seq_len = shape\n\n        if is_first:\n            hidden = llama.embed_tokens(input_ids)\n            hidden = hidden.to(device=device, dtype=dtype)\n        else:\n            # Every rank has the microbatch metadata in normal pipeline use.\n            # Targets provide a fallback for callers that only populate inputs\n            # on rank zero.\n            if len(input_ids.shape) == 2:\n                recv_batch, recv_seq = input_ids.shape\n            else:\n                recv_batch, recv_seq = targets[mb].shape\n            hidden = torch.empty(\n                (recv_batch, recv_seq, hidden_size), device=device, dtype=dtype\n            )\n            dist.recv(hidden, src=rank - 1, tag=fwd_tag(mb))\n            hidden.requires_grad_(True)\n\n        hidden = hidden.to(device=device, dtype=dtype)\n        hidden.retain_grad()\n        stage_input = hidden\n\n        position_ids = torch.arange(seq_len, device=device, dtype=torch.long)\n        position_ids = position_ids.unsqueeze(0).expand(batch_size, -1)\n        for layer in local_layers:\n            hidden = _layer_forward(layer, hidden, position_ids)\n            hidden = hidden.to(device=device, dtype=dtype)\n\n        saved_inputs.append(stage_input)\n        saved_outputs.append(hidden)\n\n        if is_last:\n            hidden_for_head = llama.norm(hidden)\n            hidden_for_head = hidden_for_head.to(device=device, dtype=dtype)\n            logits = model.lm_head(hidden_for_head)\n            labels = targets[mb].to(device=device)\n            # Ma"]
[30.893333, "i", "tch Hugging Face causal-LM loss: token t predicts token t+1.\n            shift_logits = logits[..., :-1, :].contiguous()\n            shift_labels = labels[..., 1:].contiguous()\n            loss = F.cross_entropy(\n                shift_logits.view(-1, shift_logits.size(-1)),\n                shift_labels.view(-1),\n            ) / n_microbatches\n            losses.append(loss)\n        else:\n            dist.send(hidden.detach().contiguous(), dst=rank + 1, tag=fwd_tag(mb))\n\n    # ---------------------------- all backward ----------------------------\n    for mb in range(n_microbatches - 1, -1, -1):\n        if is_last:\n            losses[mb].backward()\n            input_grad = saved_inputs[mb].grad\n        else:\n            output = saved_outputs[mb]\n            grad_output = torch.empty_like(output, device=device, dtype=dtype)\n            dist.recv(grad_output, src=rank + 1, tag=bwd_tag(mb))\n            output.backward(grad_output)\n            input_grad = saved_inputs[mb].grad\n\n        if not is_first:\n            if input_grad is None:\n                raise RuntimeError(\"pipeline stage produced no input gradient\")\n            dist.send(\n                input_grad.to(device=device, dtype=dtype).contiguous(),\n                dst=rank - 1,\n                tag=bwd_tag(mb),\n            )\n\n    if is_last:\n        return torch.stack(losses).sum().detach()\n    return None\nPY\npython3 -m py_compile /app/pipeline_parallel.py\nls -l /app/pipeline_parallel.py\n"]
