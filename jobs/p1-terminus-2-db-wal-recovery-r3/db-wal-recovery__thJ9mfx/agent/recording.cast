[27.100077, "i", "python3 - <<'PY'\nimport sqlite3, json\nconn=sqlite3.connect('/app/test.db')\nrows=conn.execute('SELECT id, name, value FROM items ORDER BY id').fetchall()\nprint('count:',len(rows))\nif len(rows) != 11:\n    raise SystemExit(f'expected 11 rows, got {len(rows)}')\ndata=[{'id':r[0], 'name':r[1], 'value':r[2]} for r in rows]\nwith open('/app/recovered.json','w') as f:\n    json.dump(data,f,separators=(',',':'))\n    f.write('\\n')\nprint(json.dumps(data, indent=2))\nPY\ncat /app/recovered.json\n"]
