[17.155717, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/main.db-wal')\nb=p.read_bytes()\nPath('/app/main.db-wal.xor42').write_bytes(bytes(x^0x42 for x in b))\nprint('decoded',len(b),'bytes')\nfor fn in ['/app/main.db-wal','/app/main.db-wal.xor42']:\n d=Path(fn).read_bytes()\n print(fn)\n for i in range(0,min(len(d),160),32): print(f'{i:04x}',d[i:i+32].hex())\nPY\nfile /app/main.db-wal.xor42\ncommand -v sqlite3 || true\npython3 - <<'PY'\nimport sqlite3\nfor db in ['/app/main.db','/app/main.db-wal.xor42']:\n try:\n  c=sqlite3.connect(db)\n  print(db,c.execute(\"select name,sql from sqlite_master\").fetchall())\n  print(c.execute('select * from items').fetchall())\n except Exception as e: print(db,type(e).__name__,e)\nPY\n"]
