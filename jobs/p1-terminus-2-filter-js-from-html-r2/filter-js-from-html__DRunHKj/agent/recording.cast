[22.027906, "i", "\"\"\n\n    def replace_attr(match):\n        name = match.group(\"name\")\n        low = name.lower()\n        value = match.group(\"value\")\n        # HTML event handler attributes (onclick, onload, onerror, ...).\n        if low.startswith(\"on\") and len(low) > 2:\n            return \"\"\n        if low in URL_ATTRS or low in {\"srcdoc\", \"style\", \"content\"}:\n            if dangerous_value(low, value):\n                return \"\"\n        return match.group(0)\n\n    # Do not parse the tag's closing /> as an attribute; ATTR_RE only starts\n    # after whitespace and requires an attribute-name character.\n    return ATTR_RE.sub(replace_attr, tag)\n\n\ndef sanitize(text):\n    out = []\n    pos = 0\n    n = len(text)\n    while pos < n:\n        start = text.find(\"<\", pos)\n        if start < 0:\n            out.append(text[pos:])\n            break\n        out.append(text[pos:start])\n\n        # Remove script element and all of its contents, including malformed\n        # content up to EOF if no closing tag exists.\n        if SCRIPT_OPEN_RE.mat"]
[22.029837, "o", "> import os\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.parse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SCRIPT_OPEN_RE = re.compile(r\"<\\s*script(?:\\s|/?>)\", re.I)\r\n\u001b[?2004l\r\u001b[?2004h> SCRIPT_CLOSE_RE = re.compile(r\"<\\s*/\\s*script\\s*>\", re.I)\r\n\u001b[?2004l\r\u001b[?2004h> TAG_NAME_RE = re.compile(r\"<\\s*([A-Za-z][A-Za-z0-9:_-]*)\")\r\n\u001b[?2004l\r\u001b[?2004h> ATTR_RE = re.compile(\r\n\u001b[?2004l\r\u001b[?2004h>     r\"(?P<lead>\\s+)(?P<name>[A-Za-z_:][A-Za-z0-9:._-]*)\"\r\n\u001b[?2004l\r\u001b[?2004h>     r\"(?:\\s*=\\s*(?P<value>\\\"[^\\\"]*\\\"|'[^']*'|[^\\s>]*))?\",\r\n\u001b[?2004l\r\u001b[?2004h>     re.S,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.030749, "i", "ch(text, start):\n            close = SCRIPT_CLOSE_RE.search(text, start)\n            pos = n if close is None else close.end()\n            continue\n\n        # Find the end of a tag without being confused by > inside quotes.\n        i = start + 1\n        quote = None\n        while i < n:\n            c = text[i]\n            if quote:\n                if c == quote:\n                    quote = None\n            elif c in \"\\\"'\":\n                quote = c\n            elif c == \">\":\n                i += 1\n                break\n            i += 1\n        if i > n:\n            i = n\n        tag = text[start:i]\n        out.append(sanitize_tag(tag))\n        pos = i\n    return \"\".join(out)\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(f\"usage: {sys.argv[0]} HTML_FILE\", file=sys.stderr)\n        return 2\n    path = sys.argv[1]\n    with open(path, \"rb\") as f:\n        raw = f.read()\n    # UTF-8 is standard for HTML; surrogateescape preserves undecodable bytes.\n    text = raw.decode(\"utf-8\", \"surrogateescape\")\n    fil"]
