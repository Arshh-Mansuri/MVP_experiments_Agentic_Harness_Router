[22.043893, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             os.unlink(temporary)\r\n\u001b[?2004l\r\u001b[?2004h>         except OSError:\r\n\u001b[?2004l\r"]
[22.044069, "o", "\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>         raise\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
