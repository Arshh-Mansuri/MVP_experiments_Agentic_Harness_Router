[22.024966, "i", "cat > /app/filter.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Remove executable JavaScript from an HTML file while preserving formatting.\"\"\"\nimport html\nimport os\nimport re\nimport sys\nimport tempfile\nimport urllib.parse\n\nSCRIPT_OPEN_RE = re.compile(r\"<\\s*script(?:\\s|/?>)\", re.I)\nSCRIPT_CLOSE_RE = re.compile(r\"<\\s*/\\s*script\\s*>\", re.I)\nTAG_NAME_RE = re.compile(r\"<\\s*([A-Za-z][A-Za-z0-9:_-]*)\")\nATTR_RE = re.compile(\n    r\"(?P<lead>\\s+)(?P<name>[A-Za-z_:][A-Za-z0-9:._-]*)\"\n    r\"(?:\\s*=\\s*(?P<value>\\\"[^\\\"]*\\\"|'[^']*'|[^\\s>]*))?\",\n    re.S,\n)\n\n# Attributes whose values can directly execute or load script.\nURL_ATTRS = {\n    \"href\", \"src\", \"action\", \" formaction\", \"cite\", \"background\",\n    \"codebase\", \"data\", \"lowsrc\", \"dynsrc\", \"poster\", \"ping\",\n    \"xlink:href\",\n}\n\n\ndef decoded_value(value):\n    if value is None:\n        return \"\"\n    if len(value) >= 2 and value[0] in \"\\\"'\" and value[-1] == value[0]:\n        value = value[1:-1]\n    # Decode repeatedly because entities and percent escapes can be layered.\n    for _ in ra"]
[22.027596, "i", "nge(3):\n        new = html.unescape(urllib.parse.unquote(value))\n        if new == value:\n            break\n        value = new\n    return value.replace(\"\\x00\", \"\").strip().lower()\n\n\ndef dangerous_value(name, value):\n    v = decoded_value(value)\n    compact = re.sub(r\"[\\x00-\\x20\\u007f]+\", \"\", v)\n    if name in URL_ATTRS or name == \"srcdoc\":\n        return compact.startswith(\"javascript:\") or compact.startswith(\"vbscript:\") or compact.startswith(\"data:text/html\") or name == \"srcdoc\"\n    if name == \"style\":\n        return bool(re.search(r\"(?:expression\\s*\\(|url\\s*\\(\\s*['\\\"]?\\s*(?:javascript|vbscript):|behavior\\s*:|-moz-binding\\s*:)\", v, re.I))\n    if name == \"content\":\n        return bool(re.search(r\"(?:^|;)\\s*url\\s*\\(\\s*['\\\"]?\\s*(?:javascript|vbscript):\", v, re.I))\n    return False\n\n\ndef sanitize_tag(tag):\n    \"\"\"Return a tag with only dangerous attributes removed.\"\"\"\n    m = TAG_NAME_RE.match(tag)\n    if not m:\n        return tag\n    tag_name = m.group(1).lower()\n    if tag_name in {\"script\"}:\n        return "]
