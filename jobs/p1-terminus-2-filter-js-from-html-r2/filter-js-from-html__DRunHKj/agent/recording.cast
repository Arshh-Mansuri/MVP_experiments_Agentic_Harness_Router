[22.030832, "i", "tered = sanitize(text)\n    encoded = filtered.encode(\"utf-8\", \"surrogateescape\")\n    directory = os.path.dirname(os.path.abspath(path)) or \".\"\n    fd, temporary = tempfile.mkstemp(prefix=\".filter-\", dir=directory)\n    try:\n        with os.fdopen(fd, \"wb\") as f:\n            f.write(encoded)\n            f.flush()\n            os.fsync(f.fileno())\n        os.replace(temporary, path)\n    except Exception:\n        try:\n            os.unlink(temporary)\n        except OSError:\n            pass\n        raise\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\nchmod 755 /app/filter.py\npython3 -m py_compile /app/filter.py\ncat > /tmp/filter-test.html <<'EOF'\n<!doctype html>\\n<html><head><style>body { color: red }</style><script>alert(1)</script></head>\\n<body class=\"x\" onclick=\"bad()\"><a href=\"javascript:alert(1)\" title=\"ok\">Link</a><img src=\"x\" onerror='bad()'>\\n<table><tr><td>safe</td></tr></table></body></html>\\nEOF\npython3 /app/filter.py /tmp/filter-test.html\ncat /tmp/filter-test.html\n"]
