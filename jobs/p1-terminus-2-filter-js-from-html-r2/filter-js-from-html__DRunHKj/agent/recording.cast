[30.2021, "i", "sed -i 's/\" formaction\"/\"formaction\"/' /app/filter.py\npython3 -m py_compile /app/filter.py\ncat > /tmp/filter-test.html <<'EOF'\n<!doctype html>\n<html><head><style>body { color: red }</style><script>alert(1)</script></head>\n<body class=\"x\" onclick=\"bad()\"><a href=\"javascript:alert(1)\" title=\"ok\">Link</a><img src=\"x\" onerror='bad()'>\n<table><tr><td>safe</td></tr></table></body></html>\nEOF\npython3 /app/filter.py /tmp/filter-test.html\nprintf '%s\\n' '--- filtered output ---'\ncat /tmp/filter-test.html\nprintf '%s\\n' '--- remaining dangerous patterns ---'\nif grep -Ein '(<script|javascript:|\\son[a-z]+\\s*=)' /tmp/filter-test.html; then exit 1; else echo none; fi\n"]
