[61.555716, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.555817, "o", "    @property\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.555982, "o", "    def screen(self) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.556177, "o", "        return self.get_output()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.556216, "o", "    def resize(self, cols: int, rows: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.55624, "o", "        self.cols, self.rows = int(cols), int(rows)\r\n\u001b[?2004l\r"]
[61.556389, "o", "\u001b[?2004h"]
[61.556513, "o", ">         self._set_size(self._master)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.556715, "o", "            os.kill(self.pid, signal.SIGWINCH)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.55686, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[61.556915, "o", "\u001b[?2004h> "]
[61.557044, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.557206, "o", "        if self._closed:\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.557239, "o", "        self._closed = True\r\n\u001b[?2004l\r"]
[61.557385, "o", "\u001b[?2004h"]
[61.557415, "o", ">         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.55757, "o", "            os.killpg(self.pid, signal.SIGHUP)\r\n\u001b[?2004l\r\u001b[?2004h>         except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r"]
[61.557704, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.558342, "o", "            self.process.wait(timeout=1.0)\r\n\u001b[?2004l\r"]
[61.559547, "o", "\u001b[?2004h>         except subprocess.TimeoutExpired:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.559766, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h>                 os.killpg(self.pid, signal.SIGKILL)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.559822, "o", "            except OSError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.55985, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.560025, "o", ">             self.process.wait()\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[61.560078, "o", "\u001b[?2004h> "]
[61.560143, "o", "            os.close(self._master)\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.560169, "o", "> "]
[61.560282, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.560296, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[61.560325, "o", "> "]
[61.560406, "o", "    terminate = close\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[61.560431, "o", "\u001b[?2004h> "]
[61.560595, "o", "    def __enter__(self) -> \"HeadlessTerminal\":\r\n\u001b[?2004l\r\u001b[?2004h>         return self\r\n\u001b[?2004l\r"]
[61.5613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[61.561342, "o", "\u001b[?2004h>     def __exit__(self, exc_type, exc_value, traceback) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>         self.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def __del__(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             self.close()\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r"]
[61.561718, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[61.595448, "o", "\u001b[?2004hroot@6a1d73677ff9:/app# "]
[61.595818, "o", "python3 -m py_compile /app/headless_terminal.py\r\n\u001b[?2004l\r"]
[62.2064, "o", "\u001b[?2004hroot@6a1d73677ff9:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[62.20717, "o", "\u001b[?2004h> import sys, time\r\n\u001b[?2004l\r"]
[62.207206, "o", "\u001b[?2004h> sys.path.insert(0, '/app')\r\n\u001b[?2004l\r\u001b[?2004h> from headless_terminal import HeadlessTerminal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> t = HeadlessTerminal(startup_wait=0.1)\r\n\u001b[?2004l\r\u001b[?2004h> t.send_keystrokes(\"printf 'hello\\\\n'\\n\", 0.2)\r\n\u001b[?2004l\r"]
[62.207248, "o", "\u001b[?2004h> "]
[62.207645, "o", "assert 'hello' in t.get_output()\r\n\u001b[?2004l\r\u001b[?2004h> t.send_keystrokes(\"sleep 10\\n\", 0.05)\r\n\u001b[?2004l\r\u001b[?2004h> t.send_keystrokes(\"\\x03\", 0.2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.207788, "o", "t.send_keystrokes(\"printf 'after-interrupt\\\\n'\\n\", 0.2)\r\n\u001b[?2004l\r"]
[62.208017, "o", "\u001b[?2004h> assert 'after-interrupt' in t.get_output()\r\n\u001b[?2004l\r\u001b[?2004h> t.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.20816, "o", "> print('smoke test passed')\r\n\u001b[?2004l\r\u001b[?2004h> "]
