[61.5158, "i", "      start_new_session=True,\n            env={**os.environ, \"TERM\": os.environ.get(\"TERM\", \"xterm-256color\")},\n        )\n        os.close(slave)\n        self.pid = self.process.pid\n        os.set_blocking(self._master, False)\n        self._collect(startup_wait)\n\n    def _set_size(self, fd: int) -> None:\n        try:\n            termios.tcsetwinsize(fd, (self.rows, self.cols))\n        except AttributeError:\n            import fcntl\n            import struct\n            fcntl.ioctl(\n                fd,\n                termios.TIOCSWINSZ,\n                struct.pack(\"HHHH\", self.rows, self.cols, 0, 0),\n            )\n\n    def _collect(self, wait_sec: float = 0.0) -> str:\n        chunks = []\n        deadline = time.monotonic() + max(0.0, wait_sec)\n        first = True\n        while first or time.monotonic() < deadline:\n            first = False\n            timeout = max(0.0, deadline - time.monotonic()) if wait_sec else 0.0\n            try:\n                ready, _, _ = select.select([self._master], [], [], timeo"]
