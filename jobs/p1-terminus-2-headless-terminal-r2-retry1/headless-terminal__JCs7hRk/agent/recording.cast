[61.510871, "i", "cat > /app/headless_terminal.py <<'PY'\n\"\"\"PTY-backed implementation of the BaseTerminal interface.\"\"\"\nfrom __future__ import annotations\n\nimport errno\nimport os\nimport pty\nimport select\nimport signal\nimport subprocess\nimport termios\nimport time\nfrom typing import Optional\n\nfrom base_terminal import BaseTerminal\n\n\nclass HeadlessTerminal(BaseTerminal):\n    \"\"\"An interactive bash shell connected to a pseudo-terminal.\"\"\"\n\n    def __init__(\n        self,\n        cols: int = 120,\n        rows: int = 40,\n        shell: Optional[str] = None,\n        startup_wait: float = 0.05,\n    ) -> None:\n        self.cols = int(cols)\n        self.rows = int(rows)\n        self._closed = False\n        self._output = \"\"\n        self._master, slave = pty.openpty()\n        self._set_size(slave)\n\n        shell = shell or os.environ.get(\"SHELL\") or \"/bin/bash\"\n        self.process = subprocess.Popen(\n            [shell, \"-i\"],\n            stdin=slave,\n            stdout=slave,\n            stderr=slave,\n            close_fds=True,\n      "]
