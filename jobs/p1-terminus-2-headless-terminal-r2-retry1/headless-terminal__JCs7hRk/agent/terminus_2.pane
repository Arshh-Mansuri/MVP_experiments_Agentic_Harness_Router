    def _collect(self, wait_sec: float = 0.0) -> str:
        chunks = []
        deadline = time.monotonic() + max(0.0, wait_sec)
        first = True
        while first or time.monotonic() < deadline:
            first = False
            timeout = max(0.0, deadline - time.monotonic()) if wait_sec else 0.0
            try:
                ready, _, _ = select.select([self._master], [], [], timeout)
            except (OSError, ValueError):
                break
            if not ready:
                break
            try:
                data = os.read(self._master, 65536)
            except OSError as exc:
                if exc.errno in (errno.EIO, errno.EBADF, errno.EAGAIN):
                    break
                raise
            if not data:
                break
            chunks.append(data)
            if wait_sec:
                deadline = max(deadline, time.monotonic() + 0.01)

        text = b"".join(chunks).decode("utf-8", errors="replace")
        self._output += text
        return text

    def send_keystrokes(self, keystrokes: str, wait_sec: float = 0.0) -> None:
        """Send literal keystrokes, including control characters, to bash."""
        if self._closed:
            raise RuntimeError("terminal is closed")
        data = keystrokes.encode("utf-8")
        view = memoryview(data)
        while view:
            try:
                count = os.write(self._master, view)
                view = view[count:]
            except InterruptedError:
                continue
        self._collect(wait_sec)

    def read(self, wait_sec: float = 0.0) -> str:
        """Collect and return output currently available from the terminal."""
        return self._collect(wait_sec)

    def get_output(self) -> str:
        """Return all output collected since terminal startup."""
        self._collect(0.0)
        return self._output

    @property
    def screen(self) -> str:
        return self.get_output()

