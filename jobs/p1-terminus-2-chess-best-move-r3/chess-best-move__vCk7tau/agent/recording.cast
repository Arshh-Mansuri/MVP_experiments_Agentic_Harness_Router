[292.272209, "i", "python3 - <<'PY'\nimport chess, chess.engine\nfen='r1kq1r2/1p3p2/p1n1p3/3nPbbP/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\nb=chess.Board(fen)\nengine=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\ntry:\n infos=engine.analyse(b,chess.engine.Limit(depth=24),multipv=3)\n for info in infos:\n  print(info['score'].pov(chess.WHITE),b.uci(info['pv'][0]),' '.join(b.uci(m) for m in info['pv'][:10]))\n move=b.uci(infos[0]['pv'][0])\n open('/app/move.txt','w').write(move+'\\n')\n print('written',move)\nfinally:\n engine.quit()\nPY\ncat /app/move.txt\n"]
