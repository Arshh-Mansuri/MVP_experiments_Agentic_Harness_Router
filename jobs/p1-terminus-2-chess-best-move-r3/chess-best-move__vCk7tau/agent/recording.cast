[18.657725, "i", "python3 - <<'PY'\nfrom PIL import Image\nfrom collections import Counter\nim=Image.open('/app/chess_board.png').convert('RGB')\nprint('size',im.size)\nprint('colors',Counter(im.getdata()).most_common(20))\n# bounding box of non-white-ish pixels\npix=im.load(); w,h=im.size\npts=[]\nfor y in range(h):\n for x in range(w):\n  r,g,b=pix[x,y]\n  if min(r,g,b)<245: pts.append((x,y))\nprint('nonwhite bbox', (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else None)\nPY\n"]
