[195.176192, "i", "python3 - <<'PY'\nimport chess, chess.engine\nfen='r1kq1r2/1p3p2/1p3p2/p1n1p3/3nP1Pb/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\n# Correct the intended legal position: black pawns are a6,b7,e6,f7.\nfen='r1kq1r2/1p3p2/p1n1p3/3nP1Pb/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\nb=chess.Board(fen)\nprint('valid',b.is_valid())\nengine=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\ntry:\n info=engine.analyse(b,chess.engine.Limit(depth=12),multipv=1)\n move=b.uci(info['pv'][0])\n print('best',move,'score',info['score'].pov(chess.WHITE))\n with open('/app/move.txt','w') as f: f.write(move+'\\n')\nfinally:\n engine.quit()\nPY\nprintf 'move.txt: '; cat /app/move.txt\n"]
