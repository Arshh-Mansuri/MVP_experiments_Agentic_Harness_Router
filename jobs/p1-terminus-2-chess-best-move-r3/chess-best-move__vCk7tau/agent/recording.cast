[134.034586, "i", "python3 - <<'PY'\nimport chess, chess.engine\nfen='r1kq1r2/1p3p2/p1n1p3/3nP1Pb/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\nb=chess.Board(fen)\nprint(b)\nprint('legal',b.is_valid(), 'fen', b.fen())\nengine=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\nengine.configure({'Threads':2,'Hash':128})\ninfo=engine.analyse(b,chess.engine.Limit(depth=24),multipv=10)\nfor x in info:\n print(x['score'].pov(chess.WHITE), b.uci(x['pv'][0]), 'pv', ' '.join(b.uci(m) for m in x['pv'][:8]))\nengine.quit()\nPY\n"]
[134.03619, "o", "python3 - <<'PY'\r\nimport chess, chess.engine\r\nfen='r1kq1r2/1p3p2/p1n1p3/3nP1Pb/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\r\nb=chess.Board(fen)\r\nprint(b)\r\nprint('legal',b.is_valid(), 'fen', b.fen())\r\nengine=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\r\nengine.configure({'Threads':2,'Hash':128})\r\ninfo=engine.analyse(b,chess.engine.Limit(depth=24),multipv=10)\r\nfor x in info:\r\n print(x['score'].pov(chess.WHITE), b.uci(x['pv'][0]), 'pv', ' '.join(b.uci(m) for m in x['pv'][:8]))\r\nengine.quit()\r\nPY\r\n"]
