[292.278319, "o", "\u001b[?2004h> import chess, chess.engine\r\n\u001b[?2004l\r\u001b[?2004h> fen='r1kq1r2/1p3p2/p1n1p3/3nPbbP/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1'\r\n\u001b[?2004l\r\u001b[?2004h> b=chess.Board(fen)\r\n\u001b[?2004l\r\u001b[?2004h> engine=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>  infos=engine.analyse(b,chess.engine.Limit(depth=24),multipv=3)\r\n\u001b[?2004l\r\u001b[?2004h>  for info in infos:\r\n\u001b[?2004l\r\u001b[?2004h>   print(info['score'].pov(chess.WHITE),b.uci(info['pv'][0]),' '.join(b.uci(m) for m in info['pv'][:10]))\r\n\u001b[?2004l\r\u001b[?2004h>  move=b.uci(infos[0]['pv'][0])\r\n\u001b[?2004l\r\u001b[?2004h>  open('/app/move.txt','w').write(move+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h>  print('written',move)\r\n\u001b[?2004l\r\u001b[?2004h> finally:\r\n\u001b[?2004l\r\u001b[?2004h>  engine.quit()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
