[47.114524, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB'); p=im.load()\n# candidate occupied squares from prior counts\nocc=['a8','c8','d8','f8','b7','f7','a6','c6','e6','d5','f5','g5','e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\nfiles='abcdefgh'\nfor sq in occ:\n c=files.index(sq[0]); r=8-int(sq[1])\n print('\\n',sq)\n for yy in range(4,76,4):\n  line=''\n  for xx in range(4,76,4):\n   # average-ish central pixel, mark non-board colors\n   R,G,B=p[c*80+xx,r*80+yy]\n   if max(R,G,B)<100: ch='#'       # black piece\n   elif min(R,G,B)>248: ch='@'      # white piece\n   elif (R,G,B) in [(181,136,99),(240,217,181)]: ch=' '\n   elif max(R,G,B)<170: ch='+'\n   else: ch='.'\n   line+=ch\n  print(line)\nPY\n"]
[47.118762, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r"]
