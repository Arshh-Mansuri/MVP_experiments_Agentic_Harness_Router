[34.485674, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\np=im.load()\nfor r in range(8):\n row=[]\n for c in range(8):\n  vals=[p[x,y] for y in range(r*80,(r+1)*80) for x in range(c*80,(c+1)*80)]\n  dark=sum(1 for R,G,B in vals if max(R,G,B)<100)\n  white=sum(1 for R,G,B in vals if min(R,G,B)>245)\n  row.append(f'{dark:4}/{white:4}')\n print(' '.join(row))\nprint('\\nTHUMBNAILS (ranks top to bottom, files left to right)')\nchars=' .:-=+*#@'\nfor r in range(8):\n print('RANK',8-r)\n for sy in range(0,80,8):\n  line=''\n  for c in range(8):\n   s=''\n   for sx in range(0,80,8):\n    R,G,B=p[c*80+sx,(r*80)+sy]\n    # show dark ink strongly; show white ink only when on brown square\n    v=255-(R+G+B)//3\n    if v>120: ch='@'\n    elif v>70: ch='#'\n    elif v>35: ch='+'\n    elif v>15: ch='.'\n    else: ch=' '\n    s+=ch\n   line+=s+' | '\n  print(line)\nPY\n"]
