[11.319258, "o", "--- rstan check ---\r\n"]
[11.874565, "i", "cat > /app/hierarchical_model.stan <<'EOF'\ndata {\n  int<lower=1> N;\n  array[N] int<lower=0> y;\n  array[N] int<lower=0> n;\n}\nparameters {\n  real<lower=0> alpha;\n  real<lower=0> beta;\n  vector<lower=0, upper=1>[N] theta;\n}\nmodel {\n  // Prior proportional to (alpha + beta)^(-5/2)\n  target += -2.5 * log(alpha + beta);\n\n  theta ~ beta(alpha, beta);\n  y ~ binomial(n, theta);\n}\nEOF\n\ncat > /app/analysis.R <<'EOF'\noptions(mc.cores = parallel::detectCores())\nSys.setenv(LOCAL_CPP化 = \"\")\n\nif (!requireNamespace(\"rstan\", quietly = TRUE) ||\n    as.character(utils::packageVersion(\"rstan\")) != \"2.32.7\") {\n  install.packages(\"rstan\", version = \"2.32.7\", repos = \"https://cloud.r-project.org\", dependencies = TRUE)\n}\n\nlibrary(rstan)\nrstan_options(auto_write = TRUE)\noptions(mc.cores = parallel::detectCores())\n\ninput_file <- \"/app/data.csv\"\ndata_df <- read.csv(input_file, header = TRUE)\nstopifnot(all(c(\"y\", \"n\") %in% names(data_df)))\nstan_data <- list(\n  N = nrow(data_df),\n  y = as.integer(data_df$y),\n  n = as.integer(data_df$n)\n)\n\nmodel <- stan_model(file = \"/app/hierarchical_model.stan\")\nfit <- sampling(\n  model,\n  data = stan_data,\n  chains = 4,\n  iter = 100000,\n  seed = 1,\n  refresh = 1000\n)\n\nposterior <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\nalpha_mean <- mean(posterior$alpha)\nbeta_mean <- mean(posterior$beta)\n\nwriteLines(sprintf(\"%.17g\", alpha_mean), \"/app/posterior_alpha_mean.txt\")\nwriteLines(sprintf(\"%.17g\", beta_mean), \"/app/posterior_beta_mean.txt\")\nEOF\n\n# Remove an accidental nonstandard environment assignment if present.\nsed -i '/LOCAL_CPP/d' /app/analysis.R\nls -l /app/hierarchical_model.stan /app/analysis.R\n"]
[11.875451, "o", "cat > /app/hierarchical_model.stan <<'EOF'\r\ndata {\r\n  int<lower=1> N;\r\n  array[N] int<lower=0> y;\r\n  array[N] int<lower=0> n;\r\n}\r\nparameters {\r\n  real<lower=0> alpha;\r\n  real<lower=0> beta;\r\n  vector<lower=0, upper=1>[N] theta;\r\n}\r\nmodel {\r\n  // Prior proportional to (alpha + beta)^(-5/2)\r\n  target += -2.5 * log(alpha + beta);\r\n\r\n  theta ~ beta(alpha, beta);\r\n  y ~ binomial(n, theta);\r\n}\r\nEOF\r\n\r\ncat > /app/analysis.R <<'EOF'\r\noptions(mc.cores = parallel::detectCores())\r\nSys.setenv(LOCAL_CPP化 = \"\")\r\n\r\nif (!requireNamespace(\"rstan\", quietly = TRUE) ||\r\n    as.character(utils::packageVersion(\"rstan\")) != \"2.32.7\") {\r\n  install.packages(\"rstan\", version = \"2.32.7\", repos = \"https://cloud.r-project.org\", dependencies = TRUE)\r\n}\r\n\r\nlibrary(rstan)\r\nrstan_options(auto_write = TRUE)\r\noptions(mc.cores = parallel::detectCores())\r\n\r\ninput_file <- \"/app/data.csv\"\r\ndata_df <- read.csv(input_file, header = TRUE)\r\nstopifnot(all(c(\"y\", \"n\") %in% names(data_df)))\r\nstan_data <- list(\r\n  N = nrow(data_df),\r\n  y = as.integer(data_df$y),\r\n  n = as.integer(data_df$n)\r\n)\r\n\r\nmodel <- stan_model(file = \"/app/hierarchical_model.stan\")\r\nfit <- sampling(\r\n  model,\r\n  data = stan_data,\r\n  chains = 4,\r\n  iter = 100000,\r\n  seed = 1,\r\n  refresh = 1000\r\n)\r\n\r\nposterior <- rstan::extract(fit, pars = c(\"alpha\", \"beta\"), permuted = TRUE)\r\nalpha_mean <- mean(posterior$alpha)\r\nbeta_mean <- mean(posterior$beta)\r\n\r\nwriteLines(sprintf(\"%.17g\", alpha_mean), \"/app/posterior_alpha_mean.txt\")\r\nwriteLines(sprintf(\"%.17g\", beta_mean), \"/app/posterior_beta_mean.txt\")\r\nEOF\r\n\r\n# Remove an accidental nonstandard environment assignment if present.\r\nsed -i '/LOCAL_CPP/d' /app/analysis.R\r\nls -l /app/hierarchical_model.stan /app/analysis.R\r\n"]
[12.023214, "o", "NOT_INSTALLED\r\n"]
