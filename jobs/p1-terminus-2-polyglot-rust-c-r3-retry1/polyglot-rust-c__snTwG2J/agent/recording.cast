[150.985264, "i", "cat > /app/polyglot/main.rs <<'EOF'\n/*\n/* */\n#include <iostream>\n#include <cstdlib>\nint main(int argc, char **argv) {\n    unsigned long long n = std::strtoull(argv[1], nullptr, 10);\n    unsigned long long a = 1, b = 1;\n    for (unsigned long long i = 0; i < n; ++i) {\n        unsigned long long c = a + b;\n        a = b;\n        b = c;\n    }\n    std::cout << a << '\\n';\n    return 0;\n}\n// Rust source follows; the backslash continues this C++ comment. \\\n*/ fn main(){let n:u32=std::env::args().nth(1).unwrap().parse().unwrap();let(mut a,mut b):(u128,u128)=(1,1);for _ in 0..n{let c=a+b;a=b;b=c;}println!(\"{}\",a);}\nEOF\nset -e\nrustc /app/polyglot/main.rs -o /app/polyglot/main\ng++ -x c++ /app/polyglot/main.rs -o /app/polyglot/cmain\nfor n in 0 1 2 3 10; do printf '%s: ' \"$n\"; /app/polyglot/main \"$n\"; printf '%s: ' \"$n\"; /app/polyglot/cmain \"$n\"; done\n"]
