[108.074213, "i", "cat > /app/polyglot/main.rs <<'EOF'\nfn main() {\n    let n: u32 = std::env::args().nth(1).unwrap().parse().unwrap();\n    let (mut a, mut b): (u128, u128) = (1, 1);\n    for _ in 0..n {\n        let c = a + b;\n        a = b;\n        b = c;\n    }\n    println!(\"{}\", a);\n    /*\n    /* */\n#include <iostream>\n#include <cstdlib>\n\nint main(int argc, char **argv) {\n    unsigned long long n = std::strtoull(argv[1], nullptr, 10);\n    unsigned long long a = 1, b = 1;\n    for (unsigned long long i = 0; i < n; ++i) {\n        unsigned long long c = a + b;\n        a = b;\n        b = c;\n    }\n    std::cout << a << '\\\\n';\n    \"*/\"\";}\nEOF\nrustc /app/polyglot/main.rs -o /app/polyglot/main && printf 'Rust: '; /app/polyglot/main 10\ng++ -x c++ /app/polyglot/main.rs -o /app/polyglot/cmain && printf 'C++: '; /app/polyglot/cmain 10\nprintf 'Checks: '; /app/polyglot/main 0; /app/polyglot/cmain 1; /app/polyglot/main 2\n"]
