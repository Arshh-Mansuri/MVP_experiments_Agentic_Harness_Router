'user_id')\n\ndef present(v):\n    return v is not None and not pd.isna(v)\n\nframes = {name: read_source(name, path) for name, path in SOURCES}\nall_ids = sorted(set().union(*(set(df.index.tolist()) for df in frames.values())))\nmerged = []\nconflicts = []\nfor uid in all_ids:\n    row = {'user_id': int(uid)}\n    for field in FIELDS:\n        vals = {}\n        for source in PRIORITY:\n            df = frames[source]\n            if uid in df.index:\n                value = df.at[uid, field]\n                if present(value):\n                    vals[source] = value\n        distinct = list(dict.fromkeys(vals.values()))\n        selected = next((vals[s] for s in PRIORITY if s in vals), None)\n        row[field] = selected\n        if len(distinct) > 1:\n            conflicts.append({\n                'user_id': int(uid),\n                'field': field,\n                'values': {s: vals[s] for s in PRIORITY if s in vals},\n                'selected': selected,\n            })\n    merged.append(row)\n\nresult = pd.DataFrame(merged, columns=['user_id', 'name', 'email', 'created_date', 'status'])\nresult['user_id'] = result['user_id'].astype('int64')\nfor col in ['name', 'email', 'created_date', 'status']:\n    result[col] = result[col].where(result[col].notna(), None).astype(object)\nresult.to_parquet('/app/merged_users.parquet', engine='pyarrow', index=False)\nwith open('/app/conflicts.json', 'w', encoding='utf-8') as f:\n    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)\nprint(f'Wrote {len(result)} users and {len(conflicts)} conflicts')\nprint(result.to_string(index=False))\nPY\npython3 /app/merge_users.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
