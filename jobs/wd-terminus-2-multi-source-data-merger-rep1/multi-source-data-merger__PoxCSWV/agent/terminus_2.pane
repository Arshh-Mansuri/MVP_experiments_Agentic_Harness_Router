import json
from datetime import date, datetime
from pathlib import Path

import pandas as pd

SOURCES = [
    ('source_a', '/data/source_a/users.json'),
    ('source_b', '/data/source_b/users.csv'),
    ('source_c', '/data/source_c/users.parquet'),
]
PRIORITY = ['source_a', 'source_b', 'source_c']
FIELDS = ['name', 'email', 'created_date', 'status']
ALIASES = {
    'user_id': ['user_id', 'id', 'userId'],
    'name': ['name', 'full_name', 'userName'],
    'email': ['email', 'email_address'],
    'created_date': ['created_date', 'registration_date', 'created_at', 'joined'],
    'status': ['status'],
}

def read_source(name, path):
    if name == 'source_a':
        with open(path, encoding='utf-8') as f:
            data = json.load(f)
        df = pd.DataFrame(data)
    elif name == 'source_b':
        df = pd.read_csv(path, dtype=str)
    else:
        df = pd.read_parquet(path)
    out = pd.DataFrame()
    for target, aliases in ALIASES.items():
        found = next((col for col in aliases if col in df.columns), None)
        out[target] = df[found] if found else pd.NA
    out['user_id'] = pd.to_numeric(out['user_id'], errors='raise').astype('int64')
    # Normalize all values before comparison and output.
    for col in ['name', 'email', 'status']:
        out[col] = out[col].map(lambda x: None if pd.isna(x) else str(x).strip())
        out[col] = out[col].map(lambda x: None if x == '' else x)
    def norm_date(x):
        if pd.isna(x) or str(x).strip() == '':
            return None
        if isinstance(x, (pd.Timestamp, datetime, date)):
            return x.strftime('%Y-%m-%d')
        return pd.to_datetime(str(x).strip(), errors='raise').strftime('%Y-%m-%d')
    out['created_date'] = out['created_date'].map(norm_date)
    # If a source accidentally contains duplicate IDs, retain its first record.
    return out.drop_duplicates('user_id', keep='first').set_index('user_id')

def present(v):
    return v is not None and not pd.isna(v)

frames = {name: read_source(name, path) for name, path in SOURCES}
all_ids = sorted(set().union(*(set(df.index.tolist()) for df in frames.values())))
merged = []
conflicts = []
for uid in all_ids:
    row = {'user_id': int(uid)}
    for field in FIELDS:
        vals = {}
        for source in PRIORITY:
            df = frames[source]
            if uid in df.index:
                value = df.at[uid, field]
                if present(value):
                    vals[source] = value
        distinct = list(dict.fromkeys(vals.values()))
        selected = next((vals[s] for s in PRIORITY if s in vals), None)
        row[field] = selected
        if len(distinct) > 1:
            conflicts.append({
                'user_id': int(uid),
                'field': field,
                'values': {s: vals[s] for s in PRIORITY if s in vals},
                'selected': selected,
            })
    merged.append(row)

result = pd.DataFrame(merged, columns=['user_id', 'name', 'email', 'created_date', 'status'])
result['user_id'] = result['user_id'].astype('int64')
for col in ['name', 'email', 'created_date', 'status']:
    result[col] = result[col].where(result[col].notna(), None).astype(object)
result.to_parquet('/app/merged_users.parquet', engine='pyarrow', index=False)
with open('/app/conflicts.json', 'w', encoding='utf-8') as f:
    json.dump({'total_conflicts': len(conflicts), 'conflicts': conflicts}, f, indent=2, ensure_ascii=False)
print(f'Wrote {len(result)} users and {len(conflicts)} conflicts')
print(result.to_string(index=False))
