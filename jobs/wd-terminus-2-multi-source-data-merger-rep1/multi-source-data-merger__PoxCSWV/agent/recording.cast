[25.21659, "i", "python3 - <<'PY'\nimport json, os\nimport pandas as pd\np='/app/merged_users.parquet'\nc='/app/conflicts.json'\ndf=pd.read_parquet(p)\nwith open(c) as f: report=json.load(f)\nprint('output files:', os.path.getsize(p), os.path.getsize(c), 'bytes')\nprint('columns:', list(df.columns))\nprint('dtypes:', {k:str(v) for k,v in df.dtypes.items()})\nprint('rows:', len(df), 'conflicts:', report['total_conflicts'], 'listed:', len(report['conflicts']))\nassert df['user_id'].dtype == 'int64'\nassert report['total_conflicts'] == len(report['conflicts'])\nassert len(df) == df['user_id'].nunique()\nassert all((x is None or len(str(x)) == 10) for x in df['created_date'])\nprint('validation: OK')\nprint(json.dumps(report, indent=2))\nPY\n"]
[25.217226, "o", "python3 - <<'PY'\r\nimport json, os\r\nimport pandas as pd\r\np='/app/merged_users.parquet'\r\nc='/app/conflicts.json'\r\ndf=pd.read_parquet(p)\r\nwith open(c) as f: report=json.load(f)\r\nprint('output files:', os.path.getsize(p), os.path.getsize(c), 'bytes')\r\nprint('columns:', list(df.columns))\r\nprint('dtypes:', {k:str(v) for k,v in df.dtypes.items()})\r\nprint('rows:', len(df), 'conflicts:', report['total_conflicts'], 'listed:', len(report['conflicts']))\r\nassert df['user_id'].dtype == 'int64'\r\nassert report['total_conflicts'] == len(report['conflicts'])\r\nassert len(df) == df['user_id'].nunique()\r\nassert all((x is None or len(str(x)) == 10) for x in df['created_date'])\r\nprint('validation: OK')\r\nprint(json.dumps(report, indent=2))\r\nPY\r\n"]
