[271.066271, "i", "python3 - <<'PY'\nimport chess\nb=chess.Board('r1bq1kr1/pp3ppp/ppn1p3/3n1rbB/P7/2B5/1P2QPNP/R1B1K2R w KQ - 0 1')\nprint('status:',b.status(), 'is_valid:',b.is_valid())\nfor name in dir(chess):\n if name.startswith('STATUS_'): print(name,getattr(chess,name))\nprint('white check',b.is_check(), 'black king attacked', b.is_attacked_by(chess.WHITE,chess.F8), 'white king attacked',b.is_attacked_by(chess.BLACK,chess.E1))\nprint('checkers',list(b.checkers()))\nPY\n"]
