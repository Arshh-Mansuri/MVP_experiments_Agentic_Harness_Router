[271.403772, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB'); files='abcdefgh'\n# Print silhouettes for uncertain black pieces with a coordinate header, using darkness only.\nfor sq in ['a8','c8','d8','f8','c6','d5','f5','g5']:\n c=files.index(sq[0]); r=8-int(sq[1]); print('\\n===',sq,'===')\n for yy in range(16):\n  line=''\n  for xx in range(16):\n   n=0\n   for y in range(r*80+yy*5,r*80+(yy+1)*5):\n    for x in range(c*80+xx*5,c*80+(xx+1)*5):\n     if sum(im.getpixel((x,y)))<300:n+=1\n   line+=' .:-=+*#%@'[min(9,n//3)]\n  print(line)\nPY\n"]
