[100.249181, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nfiles='abcdefgh'\nwhite=['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\nfor sq in white:\n c=files.index(sq[0]); r=8-int(sq[1]); print('\\n===',sq,'===')\n for yy in range(16):\n  line=''\n  for xx in range(16):\n   vals=[]\n   for y in range(r*80+yy*5,r*80+(yy+1)*5):\n    for x in range(c*80+xx*5,c*80+(xx+1)*5):\n     p=im.getpixel((x,y)); vals.append(sum(p)/3)\n   v=sum(vals)/len(vals)\n   line += ' .:-=+*#%@'[min(9,max(0,int((v-150)*10/106)))]\n  print(line)\nPY\n"]
[100.250602, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[100.252721, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('/app/chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> files='abcdefgh'\r\n\u001b[?2004l\r\u001b[?2004h> white=['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\r\n\u001b[?2004l\r\u001b[?2004h> for sq in white:\r\n\u001b[?2004l\r\u001b[?2004h>  c=files.index(sq[0]); r=8-int(sq[1]); print('\\n===',sq,'===')\r\n\u001b[?2004l\r\u001b[?2004h>  for yy in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>   line=''\r\n\u001b[?2004l\r\u001b[?2004h>   for xx in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>    vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>    for y in range(r*80+yy*5,r*80+(yy+1)*5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
