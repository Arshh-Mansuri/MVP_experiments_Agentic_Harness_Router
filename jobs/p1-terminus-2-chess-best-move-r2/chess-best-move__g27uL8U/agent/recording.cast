[75.462036, "i", "python3 - <<'PY'\nfrom PIL import Image\nfrom collections import Counter\nim=Image.open('/app/chess_board.png').convert('RGB'); files='abcdefgh'\nfor r in range(8):\n for c in range(8):\n  pts=[im.getpixel((c*80+x,r*80+y)) for y in range(2,10) for x in range(2,10)]\n  bg=[sorted(p[k] for p in pts)[len(pts)//2] for k in range(3)]\n  fg=[]\n  for y in range(r*80+10,r*80+70):\n   for x in range(c*80+10,c*80+70):\n    p=im.getpixel((x,y)); d=sum((p[k]-bg[k])**2 for k in range(3))**0.5\n    if d>30: fg.append(p)\n  if len(fg)<100: continue\n  avg=tuple(sum(p[k] for p in fg)//len(fg) for k in range(3))\n  dark=sum(sum(p)<300 for p in fg)/len(fg)\n  light=sum(sum(p)>600 for p in fg)/len(fg)\n  common=Counter(fg).most_common(3)\n  print(f'{files[c]}{8-r}: n={len(fg):4d} avg={avg} dark={dark:.2f} light={light:.2f} common={common}')\nPY\n"]
