[30.936968, "i", "python3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nim=np.array(Image.open('/app/chess_board.png'))\n# Each square is 80x80. Estimate its background from its corners, then measure deviations.\nfor r in range(8):\n row=[]\n for c in range(8):\n  a=im[r*80:(r+1)*80,c*80:(c+1)*80]\n  bg=np.median(np.concatenate([a[:8,:8].reshape(-1,3),a[:8,-8:].reshape(-1,3),a[-8:,:8].reshape(-1,3),a[-8:,-8:].reshape(-1,3)]),axis=0)\n  d=np.linalg.norm(a.astype(float)-bg,axis=2)\n  # central region avoids grid/corner artifacts\n  score=np.mean(d[8:-8,8:-8]>18)\n  row.append(f'{score:4.2f}')\n print(' '.join(row))\nprint('rows are rank 8 to rank 1; columns files a to h')\nPY\n"]
