[16.744759, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png')\nprint('size=', im.size, 'mode=', im.mode)\nprint('bbox=', im.getbbox())\nprint('corners=', [im.getpixel(p) for p in [(0,0),(im.width-1,0),(0,im.height-1),(im.width-1,im.height-1)]])\nPY\npython3 - <<'PY'\ntry:\n import cv2; print('cv2 available', cv2.__version__)\nexcept Exception as e: print('cv2 unavailable',e)\ntry:\n import chess; print('python-chess available')\nexcept Exception as e: print('python-chess unavailable',e)\nPY\n"]
