[234.482988, "i", "cat > /tmp/analyze.py <<'PY'\nimport chess, chess.engine\nfen='r1bq1kr1/pp3ppp/ppn1p3/3n1rbB/P7/2B5/1P2QPNP/R1B1K2R w KQ - 0 1'\nb=chess.Board(fen)\nprint(b)\nprint('legal=',b.is_valid(), b.status())\neng=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\ninfos=eng.analyse(b,chess.engine.Limit(depth=22),multipv=8)\nfor i in infos:\n print(i['score'].pov(chess.WHITE), b.san(i['pv'][0]), i['pv'][0].uci(), 'PV:', ' '.join(x.uci() for x in i['pv'][:8]))\neng.quit()\nPY\npython3 /tmp/analyze.py\n"]
