[31.425771, "i", "which tesseract chafa viu jp2 2>/dev/null || true; python3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nim=np.array(Image.open('/app/chess_board.png').convert('L'))\nchars=' .:-=+*#%@'\n# Render board at 80 columns x 40 rows, preserving approximate silhouette.\nfor y in range(0,640,16):\n s=''\n for x in range(0,640,8):\n  v=im[y:y+16,x:x+8].mean()\n  s+=chars[min(9,int(v/256*10))]\n print(s)\nPY\n"]
