[204.248783, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nblack=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5']\nwhite=['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\nfiles='abcdefgh'\ndef mask(sq,side):\n c=files.index(sq[0]); r=8-int(sq[1]); out=[]\n for yy in range(16):\n  row=[]\n  for xx in range(16):\n   n=0\n   for y in range(r*80+yy*5,r*80+(yy+1)*5):\n    for x in range(c*80+xx*5,c*80+(xx+1)*5):\n     p=im.getpixel((x,y)); q=sum(p)/3\n     if (side=='b' and q<100) or (side=='w' and q>245): n+=1\n   row.append(n/25)\n  out.append(row)\n return out\nfor w in white:\n a=mask(w,'w'); scores=[]\n for b in black:\n  z=mask(b,'b'); d=sum((a[y][x]-z[y][x])**2 for y in range(16) for x in range(16))\n  scores.append((d,b))\n print(w,sorted(scores)[:5])\nPY\n"]
[204.249354, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[204.249633, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im=Image.open('/app/chess_board.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.249996, "o", "black=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.250294, "o", "white=['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']\r\n\u001b[?2004l\r\u001b[?2004h> files='abcdefgh'\r\n\u001b[?2004l\r\u001b[?2004h> def mask(sq,side):\r\n\u001b[?2004l\r\u001b[?2004h>  c=files.index(sq[0]); r=8-int(sq[1]); out=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for yy in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>   row=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for xx in range(16):\r\n\u001b[?2004l\r\u001b[?2004h>    n=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.250613, "o", "   for y in range(r*80+yy*5,r*80+(yy+1)*5):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(c*80+xx*5,c*80+(xx+1)*5):\r\n\u001b[?2004l\r\u001b[?2004h>      p=im.getpixel((x,y)); q=sum(p)/3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.250895, "o", "     if (side=='b' and q<100) or (side=='w' and q>245): n+=1\r\n\u001b[?2004l\r\u001b[?2004h>    row.append(n/25)\r\n\u001b[?2004l\r\u001b[?2004h>   out.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
