[101.194297, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB'); files='abcdefgh'\n# summarize vertical/horizontal bright-pixel mass for white pieces\nfor sq in ['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']:\n c=files.index(sq[0]); r=8-int(sq[1]); print('\\n',sq)\n for yy in range(0,80,4):\n  n=0\n  for y in range(r*80+yy,r*80+yy+4):\n   for x in range(c*80,c*80+80):\n    if sum(im.getpixel((x,y)))>735:n+=1\n  print('%2d'%min(80,n//2),end=' ')\n print()\nPY\n"]
