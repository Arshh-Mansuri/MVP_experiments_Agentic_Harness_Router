[43.203099, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nfor r in range(8):\n out=[]\n for c in range(8):\n  pts=[]\n  for y in range(r*80+2,r*80+10):\n   for x in range(c*80+2,c*80+10): pts.append(im.getpixel((x,y)))\n  bg=tuple(sorted(p[k] for p in pts)[len(pts)//2] for k in range(3))\n  n=0; total=0\n  for y in range(r*80+10,r*80+70):\n   for x in range(c*80+10,c*80+70):\n    p=im.getpixel((x,y)); d=sum((p[k]-bg[k])**2 for k in range(3))**0.5\n    if d>22: n+=1\n    total+=1\n  out.append('%4.2f'%(n/total))\n print(' '.join(out))\nprint('rank 8 at top; files a-h left to right')\nPY\n"]
