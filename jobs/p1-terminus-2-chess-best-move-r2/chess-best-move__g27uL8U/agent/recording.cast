[300.01053, "i", "cat > /tmp/final.py <<'PY'\nimport chess, chess.engine\nfen='r1bq1r2/1p3pp1/p1n1p3/3n1kb1/8/P1B5/1P2QPN1/R1B4K w - - 0 1'\nb=chess.Board(fen)\nprint(b)\nprint('valid',b.is_valid(),'status',b.status())\neng=chess.engine.SimpleEngine.popen_uci('/usr/games/stockfish')\ninfos=eng.analyse(b,chess.engine.Limit(depth=28),multipv=5)\nfor i in infos:\n m=i['pv'][0]\n print(i['score'].pov(chess.WHITE),b.san(m),m.uci(),' '.join(x.uci() for x in i['pv'][:12]))\n# Write best move in requested format\nopen('/app/move.txt','w').write(infos[0]['pv'][0].uci()+'\\n')\neng.quit()\nPY\npython3 /tmp/final.py\ncat /app/move.txt\n"]
