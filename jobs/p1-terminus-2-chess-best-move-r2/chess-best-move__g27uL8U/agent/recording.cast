[44.561726, "o", "\u001b[?2004hroot@ece661ff3cdf:/app# "]
[56.575133, "i", "python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('/app/chess_board.png').convert('RGB')\nfiles='abcdefgh'\nfor r in range(8):\n for c in range(8):\n  # estimate board color from a thin corner patch\n  pts=[im.getpixel((c*80+x,r*80+y)) for y in range(2,10) for x in range(2,10)]\n  bg=[sorted(p[k] for p in pts)[len(pts)//2] for k in range(3)]\n  vals=[]\n  for y in range(r*80+10,r*80+70):\n   for x in range(c*80+10,c*80+70):\n    p=im.getpixel((x,y)); vals.append(sum((p[k]-bg[k])**2 for k in range(3))**0.5)\n  score=sum(v>22 for v in vals)/len(vals)\n  if score<0.04: continue\n  print('\\n=== %s%d score %.2f bg %s ==='%(files[c],8-r,score,bg))\n  # 16x16 blocks, print deviation from local background; high deviation is piece\n  for yy in range(16):\n   line=''\n   for xx in range(16):\n    ds=[]\n    for y in range(r*80+yy*5,r*80+(yy+1)*5):\n     for x in range(c*80+xx*5,c*80+(xx+1)*5):\n      p=im.getpixel((x,y)); ds.append(sum((p[k]-bg[k])**2 for k in range(3))**0.5)\n    d=sum(ds)/len(ds)\n    line += ' .:-=+*#%@'[min(9,int(d/18))]\n   print(line)\nPY\n"]
[56.576505, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
