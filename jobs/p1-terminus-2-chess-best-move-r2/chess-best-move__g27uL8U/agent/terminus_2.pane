python3 - <<'PY'
from PIL import Image
im=Image.open('/app/chess_board.png').convert('L')
chars=' .:-=+*#%@'
for r in range(8):
 for sy in range(0,80,5):
  line=''
  for c in range(8):
   for sx in range(0,80,5):
    vals=[im.getpixel((c*80+x,r*80+y)) for y in range(sy,sy+5) for x in range(sx,sx+5)]
    v=sum(vals)/len(vals)
    line+=chars[min(9,int(v*10/256))]
   line+=' '
  print(line)
 print()
