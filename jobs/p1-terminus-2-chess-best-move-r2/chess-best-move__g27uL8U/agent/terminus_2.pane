[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('/app/chess_board.png').convert('RGB')
[?2004l[?2004h> files='abcdefgh'
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>  for c in range(8):
[?2004l[?2004h>   # estimate board color from a thin corner patch
[?2004l[?2004h>   pts=[im.getpixel((c*80+x,r*80+y)) for y in range(2,10) for x in range(2,10)]
[?2004l[?2004h>   bg=[sorted(p[k] for p in pts)[len(pts)//2] for k in range(3)]
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for y in range(r*80+10,r*80+70):
[?2004l[?2004h>    for x in range(c*80+10,c*80+70):
[?2004l[?2004h>     p=im.getpixel((x,y)); vals.append(sum((p[k]-bg[k])**2 for k in range(3))**0.5)
[?2004l[?2004h>   score=sum(v>22 for v in vals)/len(vals)
[?2004l[?2004h>   if score<0.04: continue
[?2004l[?2004h>   print('\n=== %s%d score %.2f bg %s ==='%(files[c],8-r,score,bg))
[?2004l[?2004h>   # 16x16 blocks, print deviation from local background; high deviation is piece
[?2004l[?2004h>   for yy in range(16):
[?2004l[?2004h>    line=''
[?2004l[?2004h>    for xx in range(16):
[?2004l[?2004h>     ds=[]
[?2004l[?2004h>     for y in range(r*80+yy*5,r*80+(yy+1)*5):
[?2004l[?2004h>      for x in range(c*80+xx*5,c*80+(xx+1)*5):
[?2004l[?2004h>       p=im.getpixel((x,y)); ds.append(sum((p[k]-bg[k])**2 for k in range(3))**0.5)
[?2004l[?2004h>     d=sum(ds)/len(ds)
[?2004l[?2004h>     line += ' .:-=+*#%@'[min(9,int(d/18))]
[?2004l[?2004h>    print(line)
[?2004l[?2004h> PY
