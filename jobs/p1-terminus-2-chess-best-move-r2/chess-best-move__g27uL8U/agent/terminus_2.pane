[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> im=Image.open('/app/chess_board.png').convert('RGB'); files='abcdefgh'
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>  for c in range(8):
[?2004l[?2004h>   pts=[im.getpixel((c*80+x,r*80+y)) for y in range(2,10) for x in range(2,10)]
[?2004l[?2004h>   bg=[sorted(p[k] for p in pts)[len(pts)//2] for k in range(3)]
[?2004l[?2004h>   fg=[]
[?2004l[?2004h>   for y in range(r*80+10,r*80+70):
[?2004l[?2004h>    for x in range(c*80+10,c*80+70):
[?2004l[?2004h>     p=im.getpixel((x,y)); d=sum((p[k]-bg[k])**2 for k in range(3))**0.5
[?2004l[?2004h>     if d>30: fg.append(p)
[?2004l[?2004h>   if len(fg)<100: continue
