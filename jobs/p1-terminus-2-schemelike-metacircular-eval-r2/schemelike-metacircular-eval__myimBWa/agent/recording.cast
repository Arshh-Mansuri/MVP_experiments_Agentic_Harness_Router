[74.219213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (make-closure params body env)\r\n\u001b[?2004l\r\u001b[?2004h>   (cons 'closure (cons params (cons body env))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (closure? x)\r\n\u001b[?2004l\r\u001b[?2004h>   (and (pair? x) (eq? (car x) 'closure)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.221236, "o", "(define (closure-params x) (car (cdr x)))\r\n\u001b[?2004l\r\u001b[?2004h> (define (closure-body x) (car (cdr (cdr x))))\r\n\u001b[?2004l\r\u001b[?2004h> (define (closure-env x) (cdr (cdr (cdr x))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (bind-params params args env)\r\n\u001b[?2004l\r\u001b[?2004h>   (if (null? params)\r\n\u001b[?2004l\r\u001b[?2004h>       env\r\n\u001b[?2004l\r\u001b[?2004h>       (begin\r\n\u001b[?2004l\r\u001b[?2004h>         (define-var (car params) (car args) env)\r\n\u001b[?2004l\r\u001b[?2004h>         (bind-params (cdr params) (cdr args) env))))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> (define (prim f args)\r\n\u001b[?2004l\r\u001b[?2004h>   (cond\r\n\u001b[?2004l\r\u001b[?2004h>     ((eq? f '+) (apply-host + args))\r\n\u001b[?2004l\r\u001b[?2004h>     ((eq? f '-) (apply-host - args))\r\n\u001b[?2004l\r\u001b[?2004h>     ((eq? f '*) (apply-host * args))\r\n\u001b[?2004l\r"]
