### test/function_composition.scm

(define (compose f g)
  (lambda (x) (f (g x))))

(define (twice f)
  (compose f f))

(define (identity x) x)

(define (add1 x) (+ x 1))
(define (square x) (* x x))
(define (double x) (* x 2))

(define square-then-add1 (compose add1 square))
