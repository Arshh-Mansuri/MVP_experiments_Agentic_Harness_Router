(define combine2 (curried-combine 2))
(define combine2-3 (combine2 3))
(display "Partially applied combine2-3 + 5: ")
(display (combine2-3 5))
(newline)

;; Flip arguments
(define (flip f)
  (lambda (y)
    (lambda (x)
      ((f x) y))))

(define flipped-sub (flip (curry2 -)))
