### test/oeis_sequences3.scm

(define (collatz-steps n)
  (define (collatz n steps)
    (cond ((= n 1) steps)
          ((= (- n (* (/ n 2) 2)) 0) 
           (collatz (/ n 2) (+ steps 1)))
          (else 
           (collatz (+ (* 3 n) 1) (+ steps 1)))))
  (if (<= n 0)
      0
      (collatz n 0)))

(define (pell n)
  (cond ((= n 0) 0)
        ((= n 1) 1)
        (else (+ (* 2 (pell (- n 1)))
                 (pell (- n 2))))))

(define (is-prime? n)
  (cond ((< n 2) #f)
        ((= n 2) #t)
        ((= (- n (* (/ n 2) 2)) 0) #f)
        (else
         (define (check d)
           (cond ((> (* d d) n) #t)
                 ((= (- n (* (/ n d) d)) 0) #f)
                 (else (check (+ d 2)))))
         (check 3))))

(define (nth-prime n)
  (define (find-prime count num)
    (cond ((= count n) (- num 1))
          ((is-prime? num) (find-prime (+ count 1) (+ num 1)))
          (else (find-prime count (+ num 1)))))
  (if (= n 0)
      2
      (find-prime 0 2)))

(define (primorial n)
  (if (= n 0)
      1
      (* (nth-prime (- n 1)) (primorial (- n 1)))))

(define (factorial n)
  (if (= n 0)
      1
      (* n (factorial (- n 1)))))

(define (central-binomial n)
  (/ (factorial (* 2 n))
     (* (factorial n) (factorial n))))

(define (derangements n)
  (cond ((= n 0) 1)
        ((= n 1) 0)
        (else (* (- n 1)
                 (+ (derangements (- n 1))
                    (derangements (- n 2)))))))

(define (generate-seq f n)
  (define (gen i)
    (if (>= i n)
        '()
        (cons (f i) (gen (+ i 1)))))
  (gen 1))  ; Start from 1 for these sequences

(display "Collatz steps for 1-10 (A006577): ")
(display (generate-seq collatz-steps 11))
