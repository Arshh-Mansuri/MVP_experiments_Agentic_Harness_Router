cat > /app/check_cert.py <<'PY'
#!/usr/bin/env python3
import os
import ssl
from datetime import datetime

CERT_PATH = "/app/ssl/server.crt"
EXPECTED_CN = "dev-internal.company.local"

if not os.path.isfile(CERT_PATH):
    raise SystemExit("Certificate verification failed: certificate does not exist")

try:
    cert = ssl._test_decode_cert(CERT_PATH)
except Exception as exc:
    raise SystemExit(f"Certificate verification failed: cannot load certificate: {exc}")

common_names = [value for rdn in cert.get("subject", ()) for key, value in rdn if key == "commonName"]
if EXPECTED_CN not in common_names:
    raise SystemExit(f"Certificate verification failed: Common Name is {common_names}")

not_after = cert.get("notAfter")
if not_after is None:
    raise SystemExit("Certificate verification failed: expiration date is missing")

expiration = datetime.strptime(not_after, "%b %d %H:%M:%S %Y %Z").date()
print(f"Common Name: {common_names[0]}")
print(f"Expiration date: {expiration.isoformat()}")
print("Certificate verification successful")
PY
chmod 755 /app/check_cert.py
/app/check_cert.py
