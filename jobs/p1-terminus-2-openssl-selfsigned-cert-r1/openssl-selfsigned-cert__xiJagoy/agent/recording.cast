[20.99527, "i", "cat > /app/check_cert.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport re\nimport subprocess\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\nEXPECTED_CN = \"dev-internal.company.local\"\n\nif not os.path.isfile(CERT_PATH):\n    raise SystemExit(\"Certificate verification failed: certificate does not exist\")\n\ntry:\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-enddate\"],\n        check=True,\n        capture_output=True,\n        text=True,\n    )\nexcept (OSError, subprocess.CalledProcessError) as exc:\n    raise SystemExit(f\"Certificate verification failed: cannot load certificate: {exc}\")\n\nsubject = next((line.strip() for line in result.stdout.splitlines() if line.startswith(\"subject=\")), \"\")\nenddate = next((line.strip() for line in result.stdout.splitlines() if line.startswith(\"notAfter=\")), \"\")\ncn_match = re.search(r\"(?:^|, )CN\\\\s*=\\\\s*([^,]+)\", subject)\nif not cn_match:\n    raise SystemExit(\"Certificate verification failed: Common Name is missing\")"]
[20.99848, "o", "cat > /app/check_cert.py <<'PY'\r\n\u001b[?2004l\r"]
[20.998575, "i", "\ncommon_name = cn_match.group(1).strip()\nif common_name != EXPECTED_CN:\n    raise SystemExit(f\"Certificate verification failed: unexpected Common Name {common_name}\")\n\ntry:\n    expiration = datetime.strptime(enddate.split(\"=\", 1)[1].strip(), \"%b %d %H:%M:%S %Y %Z\").date()\nexcept (IndexError, ValueError):\n    raise SystemExit(\"Certificate verification failed: invalid expiration date\")\n\nprint(f\"Common Name: {common_name}\")\nprint(f\"Expiration date: {expiration.isoformat()}\")\nprint(\"Certificate verification successful\")\nPY\nchmod 755 /app/check_cert.py\n/app/check_cert.py\n"]
