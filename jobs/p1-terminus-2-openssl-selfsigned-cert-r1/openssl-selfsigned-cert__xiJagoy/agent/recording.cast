[12.999736, "i", "cat > /app/check_cert.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport ssl\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\nEXPECTED_CN = \"dev-internal.company.local\"\n\nif not os.path.isfile(CERT_PATH):\n    raise SystemExit(\"Certificate verification failed: certificate does not exist\")\n\ntry:\n    cert = ssl._test_decode_cert(CERT_PATH)\nexcept Exception as exc:\n    raise SystemExit(f\"Certificate verification failed: cannot load certificate: {exc}\")\n\ncommon_names = [value for rdn in cert.get(\"subject\", ()) for key, value in rdn if key == \"commonName\"]\nif EXPECTED_CN not in common_names:\n    raise SystemExit(f\"Certificate verification failed: Common Name is {common_names}\")\n\nnot_after = cert.get(\"notAfter\")\nif not_after is None:\n    raise SystemExit(\"Certificate verification failed: expiration date is missing\")\n\nexpiration = datetime.strptime(not_after, \"%b %d %H:%M:%S %Y %Z\").date()\nprint(f\"Common Name: {common_names[0]}\")\nprint(f\"Expiration date: {expiration.isoformat()}\")\nprint(\"Certificate ver"]
