[890.300122, "i", "python3 - <<'PY'\nimport itertools\nwords=['secret','secrets','password','archive','solution','challenge','task','file','hidden','private','unlock','extract','sevenzip','7zip','john','security','word','found']\nsuffix=['','1','12','123','1234','12345','2024','2025','2026','01','007','!','!!','@','#','_file','_file1','_7z','7z']\nseps=['','_','-','.']\nvals=set()\nfor w in words:\n    forms={w,w.lower(),w.upper(),w.capitalize(),w.replace('e','3').replace('a','@').replace('s','$').replace('i','1')}\n    for f in forms:\n      for x in suffix: vals.add(f+x)\n      for s in seps:\n        for v in words: vals.add(f+s+v)\n        for x in suffix: vals.add(f+s+x)\nfor a,b in itertools.product(words,words):\n  for s in seps:\n    vals.add(a+s+b); vals.add(a.capitalize()+s+b)\nwith open('/tmp/focused2','w') as f:\n  f.write('\\n'.join(sorted(vals))+'\\n')\nprint(len(vals))\nPY\nhashcat -O -m 11600 -a 0 /tmp/secrets_hashcat.hash /tmp/focused2 --potfile-path=/tmp/focused2.pot --quiet\n"]
