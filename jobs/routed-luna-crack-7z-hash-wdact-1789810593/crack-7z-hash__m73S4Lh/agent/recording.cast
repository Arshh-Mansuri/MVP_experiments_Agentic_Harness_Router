[480.160821, "o", "\u001b[33m8b5bfefbd\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mbleeding-jumbo\u001b[m\u001b[33m)\u001b[m opencl_dynamic_loader.c: Try dlopening soname before linker name.\u001b[m\r\n\u001b[33mc01dbae17\u001b[m OpenCL: Improve loading of NVML and ADL\u001b[m\r\n\u001b[33m9ac0aa3ea\u001b[m SCRAM formats: Report iteration count as a tunable cost\u001b[m\r\n\u001b[33mfccf7d145\u001b[m SCRAM formats: Change FORMAT_LABEL, ALGORITHM_NAME, BENCHMARK_COMMENT\u001b[m\r\n\u001b[33m0d6b9237f\u001b[m SCRAM-SHA-256: Drop the unused username field\u001b[m\r\n\u001b[33m0d9c857bc\u001b[m Support PostgreSQL SCRAM-SHA-256\u001b[m\r\n\u001b[33m0c2cb2c27\u001b[m SCRAM formats: Support varying salt lengths\u001b[m\r\n\u001b[33mc1ce0d797\u001b[m configure: Don't unnecessarily append to CPU_BEST_FLAGS_MAIN\u001b[m\r\n\u001b[33mb9ca0930b\u001b[m configure: Repair portability to Busybox ash\u001b[m\r\n\u001b[33me743684ad\u001b[m SSH format: Mostly enable in --without-openssl builds\u001b[m\r\n"]
