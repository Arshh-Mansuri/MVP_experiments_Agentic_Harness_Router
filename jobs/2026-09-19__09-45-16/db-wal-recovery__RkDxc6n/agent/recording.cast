[14.547057, "i", "python3 - <<'PY'\nimport sqlite3, json\nfrom pathlib import Path\ncon = sqlite3.connect('/app/main.db')\ncon.row_factory = sqlite3.Row\n# Select the user table containing the expected id/name/value columns.\ntable = None\nfor (name,) in con.execute(\"select name from sqlite_master where type='table' and name not like 'sqlite_%'\"):\n    cols = [r[1] for r in con.execute(f'pragma table_info(\"{name}\")')]\n    if {'id', 'name', 'value'}.issubset(cols):\n        table = name\n        break\nif table is None:\n    raise SystemExit('No table with id, name, value columns found')\nrows = [dict(r) for r in con.execute(f'SELECT id, name, value FROM \"{table}\" ORDER BY id')]\nPath('/app/recovered.json').write_text(json.dumps(rows, separators=(',', ':')) + '\\n')\nprint('table:', table, 'count:', len(rows))\nprint(Path('/app/recovered.json').read_text())\nif len(rows) != 11:\n    raise SystemExit(f'Expected 11 rows, got {len(rows)}')\ncon.close()\nPY\n"]
[14.547301, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
