[83.907694, "o", "> def score():\r\n\u001b[?2004l\r\u001b[?2004h>     r=subprocess.run(['pdflatex','-interaction=nonstopmode','-halt-on-error','main.tex'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\r\n\u001b[?2004l\r\u001b[?2004h>     log=r.stdout\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[float(x) for x in re.findall(r'Overfull \\\\hbox \\(([0-9.]+)pt too wide',log)]\r\n\u001b[?2004l\r\u001b[?2004h>     return (len(vals),sum(vals)),log\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> best,log=score()\r\n\u001b[?2004l\r\u001b[?2004h> print('initial',best)\r\n\u001b[?2004l\r\u001b[?2004h> for passno in range(4):\r\n\u001b[?2004l\r\u001b[?2004h>     changed=False\r\n\u001b[?2004l\r\u001b[?2004h>     for fam in families:\r\n\u001b[?2004l\r\u001b[?2004h>         present=[w for w in fam if re.search(r'(?<![A-Za-z])'+re.escape(w)+r'(?![A-Za-z])',p.read_text())]\r\n\u001b[?2004l\r\u001b[?2004h>         if not present: continue\r\n\u001b[?2004l\r\u001b[?2004h>         base=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h>         fambest=best\r\n\u001b[?2004l\r\u001b[?2004h>         besttext=base\r\n\u001b[?2004l\r\u001b[?2004h>         for old in present:\r\n\u001b[?2004l\r\u001b[?2004h>             for new in fam:\r\n\u001b[?2004l\r\u001b[?2004h>                 if new==old: continue\r\n\u001b[?2004l\r\u001b[?2004h>                 candidate=re.sub(r'(?<![A-Za-z])'+re.escape(old)+r'(?![A-Za-z])',new,base)\r\n\u001b[?2004l\r\u001b[?2004h> "]
