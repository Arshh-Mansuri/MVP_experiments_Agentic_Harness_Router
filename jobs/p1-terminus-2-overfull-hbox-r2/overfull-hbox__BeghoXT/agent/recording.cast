[21.164011, "i", "python3 - <<'PY'\np='input.tex'\ns=open(p).read()\nrepls={\n    'curious natures':'odd natures',\n    'veteran bores':'dated bores',\n    'unsought':'unwanted',\n    'riotous excursions':'wild trips',\n    'responsiveness':'reaction',\n    'impressionability':'influence',\n    'creative temperament':'creative mood',\n    'electric stove':'powered stove',\n    'pathfinder':'scout',\n}\nfor a,b in repls.items():\n    if a not in s:\n        raise SystemExit(f'missing expected text: {a}')\n    s=s.replace(a,b)\nopen(p,'w').write(s)\nPY\npdflatex -interaction=nonstopmode -halt-on-error main.tex > build.log 2>&1\nprintf '%s\\n' '--- overfull warnings ---'\ngrep -n -i 'overfull' build.log || true\nprintf '%s\\n' '--- output status ---'\ntail -8 build.log\n"]
