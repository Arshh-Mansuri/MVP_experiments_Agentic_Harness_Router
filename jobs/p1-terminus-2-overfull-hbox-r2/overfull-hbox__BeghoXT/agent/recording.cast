[83.90201, "i", "cat > /tmp/optimize.py <<'PY'\nimport re, subprocess, pathlib, shutil\nfrom collections import defaultdict\np=pathlib.Path('input.tex')\noriginal=p.read_text()\nfamilies=[]\nfor line in pathlib.Path('synonyms.txt').read_text().splitlines():\n    ws=[x.strip() for x in line.split(',') if x.strip()]\n    if ws: families.append(ws)\n\ndef score():\n    r=subprocess.run(['pdflatex','-interaction=nonstopmode','-halt-on-error','main.tex'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\n    log=r.stdout\n    vals=[float(x) for x in re.findall(r'Overfull \\\\hbox \\(([0-9.]+)pt too wide',log)]\n    return (len(vals),sum(vals)),log\n\nbest,log=score()\nprint('initial',best)\nfor passno in range(4):\n    changed=False\n    for fam in families:\n        present=[w for w in fam if re.search(r'(?<![A-Za-z])'+re.escape(w)+r'(?![A-Za-z])',p.read_text())]\n        if not present: continue\n        base=p.read_text()\n        fambest=best\n        besttext=base\n        for old in present:\n            for new in fam:\n                if new==old: continue\n                candidate=re.sub(r'(?<![A-Za-z])'+re.escape(old)+r'(?![A-Za-z])',new,base)\n                p.write_text(candidate)\n                sc,_=score()\n                if sc < fambest:\n                    fambest=sc; besttext=candidate\n        p.write_text(besttext)\n        if fambest < best:\n            best=fambest; changed=True\n            print('pass',passno+1,'improved',best)\n    if not changed: break\nprint('final score',best)\n_,log=score()\nprint('\\n--- overfull ---')\nfor line in log.splitlines():\n    if 'Overfull \\\\hbox' in line: print(line)\nprint('\\n--- result ---')\nfor line in log.splitlines():\n    if 'Output written' in line or 'Fatal error' in line or 'Emergency stop' in line: print(line)\nPY\npython3 /tmp/optimize.py\n"]
[83.903912, "o", "cat > /tmp/optimize.py <<'PY'"]
[83.903986, "o", "\r\n\u001b[?2004l\r"]
