[51.157264, "i", "cat > /app/polyglot/main.py.c <<'EOF'\n#if 0\n\"\"\"\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint main(int argc, char **argv) {\n    if (argc < 2) return 1;\n    unsigned long n = strtoul(argv[1], NULL, 10);\n    unsigned char a[10000] = {0};\n    unsigned char b[10000] = {0};\n    unsigned char c[10000] = {0};\n    size_t la = 1, lb = 1;\n    a[0] = 0;\n    b[0] = 1;\n\n    for (unsigned long k = 0; k < n; ++k) {\n        size_t m = la > lb ? la : lb;\n        unsigned int carry = 0;\n        memset(c, 0, sizeof(c));\n        for (size_t i = 0; i < m; ++i) {\n            unsigned int sum = a[i] + b[i] + carry;\n            c[i] = (unsigned char)(sum % 10);\n            carry = sum / 10;\n        }\n        if (carry) c[m++] = (unsigned char)carry;\n        memcpy(a, b, sizeof(a));\n        memcpy(b, c, sizeof(b));\n        la = lb;\n        lb = m;\n    }\n\n    for (size_t i = la; i-- > 0;) putchar('0' + a[i]);\n    putchar('\\n');\n    return 0;\n}\n/*\n\"\"\"\nimport sys\n\ndef fibonacci(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\nprint(fibonacci(int(sys.argv[1])))\n#*/\nEOF\ngcc -Wall -Wextra /app/polyglot/main.py.c -o /app/polyglot/cmain && for n in 0 1 10 100; do echo \"n=$n python=$(python3 /app/polyglot/main.py.c \"$n\") c=$(/app/polyglot/cmain \"$n\")\"; done\n"]
