004h>     for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>         a, b = b, a + b\r\n\u001b[?2004l\r\u001b[?2004h>     return a\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(fibonacci(int(sys.argv[1])))\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> */\r\n\u001b[?2004l\r\u001b[?2004h> #if 0\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> #endif\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
