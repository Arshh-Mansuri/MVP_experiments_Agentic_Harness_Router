[152.485312, "i", "python3 - <<'PY'\nimport re,collections,math\nlayers=collections.defaultdict(list); active=False;x=y=0.;z=None\nfor n,raw in enumerate(open('text.gcode'),1):\n if n>=15014: break\n s=raw.strip()\n if s=='M486 S0': active=True; continue\n if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n ox,oy=x,y; e=None\n for k in 'XYZ':\n  m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n  if m:\n   if k=='X': x=float(m.group(1))\n   elif k=='Y': y=float(m.group(1))\n   else: z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m: e=float(m.group(1))\n if e is not None and e>0 and z is not None and (x!=ox or y!=oy):\n  L=math.hypot(x-ox,y-oy)\n  if L<1.0: layers[round(z,2)].append((ox,oy,x,y,L))\nprint('short-segment counts:',[(z,len(layers[z])) for z in sorted(layers)])\nfor z in [0.48,1.6,2.72]:\n q=layers[z]; xmin,xmax=55,68; ymin,ymax=79,92; W,H=104,52; g=[['.']*W for _ in range(H)]\n for a,b,c,d,L in q:\n  n=max(1,int(L*20))\n  for i in range(n+1):\n   x"]
[152.485753, "i", "x=a+(c-a)*i/n; yy=b+(d-b)*i/n\n   ix=int((xx-xmin)/(xmax-xmin)*(W-1)); iy=int((ymax-yy)/(ymax-ymin)*(H-1))\n   if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\n print('\\nLAYER',z)\n print('\\n'.join(''.join(r) for r in g))\nPY"]
