[254.820477, "o", "W,H=160,70; xs=[r[0] for r in Q]; ys=[r[1] for r in Q]; x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys); grid=[[0]*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,d in Q:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.820662, "o", " ix=int((a-x0)/(x1-x0+1e-9)*(W-1)); iy=int((y1-b)/(y1-y0+1e-9)*(H-1)); grid[iy][ix]+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.820728, "o", "mx=max(map(max,grid)); print('range',x1-x0,y1-y0,'maxbin',mx)"]
