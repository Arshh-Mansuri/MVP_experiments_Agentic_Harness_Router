[128.094328, "i", "python3 - <<'PY'\nimport re,math\n# collect text S0 extrusion segments in the small-object region (before line 15014)\nq=[];active=False;x=y=0.;z=None\nfor n,raw in enumerate(open('text.gcode'),1):\n if n>=15014:break\n s=raw.strip()\n if s=='M486 S0':active=True;continue\n if s.startswith('M486 ') and s!='M486 S0':active=False;continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue\n ox,oy=x,y;e=None\n for k in 'XYZ':\n  m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n  if m:\n   if k=='X':x=float(m.group(1))\n   elif k=='Y':y=float(m.group(1))\n   else:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m:e=float(m.group(1))\n if e and e>0 and (x!=ox or y!=oy) and z is not None:q.append((ox,oy,x,y,z))\n# project x,y,z onto coordinates along and perpendicular to the observed diagonal growth\n# longitudinal direction approximately (dx,dy,dz)=(142,55,61)\nv=(142.,55.,61.); norm=math.sqrt(sum(t*t for t in v)); v=tuple(t/norm for t in v)\n# choose basis u mostly screen horizontal and w vertical-ish\nu=(v[1]"]
[128.094578, "i", ",-v[0],0); un=math.sqrt(u[0]**2+u[1]**2);u=tuple(t/un for t in u)\nw=(v[1]*u[2]-v[2]*u[1],v[2]*u[0]-v[0]*u[2],v[0]*u[1]-v[1]*u[0])\npts=[]\nfor a,b,c,d,z in q:\n for X,Y in [(a,b),(c,d)]:pts.append((X,Y,z))\ndef proj(p,t):return sum(p[i]*t[i] for i in range(3))\nU=[proj(p,u) for p in pts];Wv=[proj(p,w) for p in pts]\nu0,u1=min(U),max(U);w0,w1=min(Wv),max(Wv)\nprint('points',len(pts),'projected bounds',u0,u1,w0,w1)\nW,H=120,60;g=[[' ']*W for _ in range(H)]\nfor a,b,c,d,z in q:\n n=max(1,int(max(abs(c-a),abs(d-b),abs(z or 0))*8))\n for i in range(n+1):\n  X=a+(c-a)*i/n;Y=b+(d-b)*i/n;Z=z\n  uu=proj((X,Y,Z),u);ww=proj((X,Y,Z),w)\n  ix=int((uu-u0)/(u1-u0+1e-9)*(W-1));iy=int((w1-ww)/(w1-w0+1e-9)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\n"]
