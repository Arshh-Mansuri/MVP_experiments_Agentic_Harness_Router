[214.302261, "i", "z,v)),(P(c,d,z,u),P(c,d,z,v))]\nu0,u1=min(a for a,b in allp),max(a for a,b in allp); v0,v1=min(b for a,b in allp),max(b for a,b in allp)\ng=[[0]*W for _ in range(H)]\nfor a,b,c,d,z in q:\n ua,va=P(a,b,z,u),P(a,b,z,v); uc,vc=P(c,d,z,u),P(c,d,z,v)\n n=max(1,int(max(abs(uc-ua),abs(vc-va))*20))\n for i in range(n+1):\n  U=ua+(uc-ua)*i/n; V=va+(vc-va)*i/n\n  ix=int((U-u0)/(u1-u0+1e-9)*(W-1)); iy=int((v1-V)/(v1-v0+1e-9)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\n# boundary\nb=[[0]*W for _ in range(H)]\nfor y in range(H):\n for x in range(W):\n  if g[y][x] and (x==0 or y==0 or x==W-1 or y==H-1 or not g[y-1][x] or not g[y+1][x] or not g[y][x-1] or not g[y][x+1]): b[y][x]=1\n# downsample by max boundary occupancy\nDW,DH=120,60\nfor yy in range(DH):\n row=''\n for xx in range(DW):\n  hit=any(b[y][x] for y in range(yy*H//DH,(yy+1)*H//DH) for x in range(xx*W//DW,(xx+1)*W//DW))\n  row += '#' if hit else ' '\n print(row.rstrip())\nPY\npython3 /tmp/boundary.py\n"]
