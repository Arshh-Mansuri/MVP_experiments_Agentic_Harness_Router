[128.09695, "o", "\u001b[?2004h>   if m:\r\n\u001b[?2004l\r\u001b[?2004h>    if k=='X':x=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>    elif k=='Y':y=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>    else:z=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  m=re.search(r'\\bE(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m:e=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  if e and e>0 and (x!=ox or y!=oy) and z is not None:q.append((ox,oy,x,y,z))\r\n\u001b[?2004l\r\u001b[?2004h> # project x,y,z onto coordinates along and perpendicular to the observed diagonal growth\r\n\u001b[?2004l\r\u001b[?2004h> # longitudinal direction approximately (dx,dy,dz)=(142,55,61)\r\n\u001b[?2004l\r\u001b[?2004h> v=(142.,55.,61.); norm=math.sqrt(sum(t*t for t in v)); v=tuple(t/norm for t in v)\r\n\u001b[?2004l\r\u001b[?2004h> # choose basis u mostly screen horizontal and w vertical-ish\r\n\u001b[?2004l\r\u001b[?2004h> u=(v[1],-v[0],0); un=math.sqrt(u[0]**2+u[1]**2);u=tuple(t/un for t in u)\r\n\u001b[?2004l\r\u001b[?2004h> w=(v[1]*u[2]-v[2]*u[1],v[2]*u[0]-v[0]*u[2],v[0]*u[1]-v[1]*u[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.097331, "o", "> pts=[]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,c,d,z in q:\r\n\u001b[?2004l\r\u001b[?2004h>  for X,Y in [(a,b),(c,d)]:pts.append((X,Y,z))\r\n\u001b[?2004l\r\u001b[?2004h> def proj(p,t):return sum(p[i]*t[i] for i in range(3))"]
[128.097436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> U=[proj(p,u) for p in pts];Wv=[proj(p,w) for p in pts]\r\n\u001b[?2004l\r\u001b[?2004h> u0,u1=min(U),max(U);w0,w1=min(Wv),max(Wv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.097934, "o", "print('points',len(pts),'projected bounds',u0,u1,w0,w1)\r\n\u001b[?2004l\r\u001b[?2004h> W,H=120,60;g=[[' ']*W for _ in range(H)]\r\n\u001b[?2004l\r\u001b[?2004h> for a,b,c,d,z in q:\r\n\u001b[?2004l\r\u001b[?2004h>  n=max(1,int(max(abs(c-a),abs(d-b),abs(z or 0))*8))\r\n\u001b[?2004l\r\u001b[?2004h>  for i in range(n+1):\r\n\u001b[?2004l\r\u001b[?2004h>   X=a+(c-a)*i/n;Y=b+(d-b)*i/n;Z=z\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.098392, "o", "  uu=proj((X,Y,Z),u);ww=proj((X,Y,Z),w)\r\n\u001b[?2004l\r"]
[128.09852, "o", "\u001b[?2004h> "]
[128.099075, "o", "  ix=int((uu-u0)/(u1-u0+1e-9)*(W-1));iy=int((w1-ww)/(w1-w0+1e-9)*(H-1))\r\n\u001b[?2004l\r\u001b[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\r\n\u001b[?2004l\r\u001b[?2004h> print('\\n'.join(''.join(r).rstrip() for r in g))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
