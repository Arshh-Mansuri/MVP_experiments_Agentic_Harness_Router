[31.580688, "i", "python3 - <<'PY'\nimport re, math\nseg=[]; active=False; x=y=0.; z=None\nfor line in open('text.gcode'):\n    s=line.strip()\n    if s=='M486 S0': active=True; continue\n    if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n    if not active: continue\n    if not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n    ox,oy=x,y\n    m=re.search(r'\\bX(-?[0-9.]+)',s)\n    if m: x=float(m.group(1))\n    m=re.search(r'\\bY(-?[0-9.]+)',s)\n    if m: y=float(m.group(1))\n    m=re.search(r'\\bZ(-?[0-9.]+)',s)\n    if m: z=float(m.group(1))\n    m=re.search(r'\\bE(-?[0-9.]+)',s)\n    e=float(m.group(1)) if m else None\n    if e is not None and e>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y,z))\nprint('segments',len(seg))\nprint('bounds',min(min(a,c) for a,b,c,d,z in seg),max(max(a,c) for a,b,c,d,z in seg),min(min(b,d) for a,b,c,d,z in seg),max(max(b,d) for a,b,c,d,z in seg))\nfrom collections import Counter\nprint('layers',Counter(z for a,b,c,d,z in seg))\n# render all collected paths using actual bounds\nxmin=min(min(a,c"]
