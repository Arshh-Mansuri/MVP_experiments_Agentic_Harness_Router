[31.582905, "i", ") for a,b,c,d,z in seg); xmax=max(max(a,c) for a,b,c,d,z in seg)\nymin=min(min(b,d) for a,b,c,d,z in seg); ymax=max(max(b,d) for a,b,c,d,z in seg)\nW,H=140,60; pix=[[' ']*W for _ in range(H)]\nfor x1,y1,x2,y2,z in seg:\n n=max(1,int(max(abs(x2-x1),abs(y2-y1))*5))\n for i in range(n+1):\n  xx=x1+(x2-x1)*i/n; yy=y1+(y2-y1)*i/n\n  ix=min(W-1,max(0,int((xx-xmin)/(xmax-xmin)*W)))\n  iy=min(H-1,max(0,int((ymax-yy)/(ymax-ymin)*H)))\n  pix[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in pix))\nPY\n"]
