[256.201318, "o", "\u001b[?2004hroot@85fb495742be:/app# "]
[276.623189, "i", "cat > /tmp/surface.py <<'PY'\nexec(open('/tmp/pca.py').read().split(\"W,H=160,70\")[0])\n# Q, axes, and P have been created by the prefix above\nW,H=200,50\nfor label,which in [('high',1),('low',-1)]:\n vals=[]\n for r in Q: vals.append(r[2])\n cut=sorted(vals)[int((.90 if which==1 else .10)*len(vals))]\n g=[[0]*W for _ in range(H)]\n for a,b,d in Q:\n  if (d>=cut if which==1 else d<=cut):\n   ix=int((a-min(x[0] for x in Q))/(max(x[0] for x in Q)-min(x[0] for x in Q)+1e-9)*(W-1))\n   iy=int((max(x[1] for x in Q)-b)/(max(x[1] for x in Q)-min(x[1] for x in Q)+1e-9)*(H-1))\n   if 0<=ix<W and 0<=iy<H:g[iy][ix]=1\n out='\\n'.join(''.join('#' if z else ' ' for z in r).rstrip() for r in g)+'\\n'\n open('/app/'+label+'_surface.txt','w').write(out)\n print('\\n---'+label+'---\\n'+out)\nPY\npython3 /tmp/surface.py\n"]
[276.626242, "o", "cat > /tmp/surface.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> exec(open('/tmp/pca.py').read().split(\"W,H=160,70\")[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
