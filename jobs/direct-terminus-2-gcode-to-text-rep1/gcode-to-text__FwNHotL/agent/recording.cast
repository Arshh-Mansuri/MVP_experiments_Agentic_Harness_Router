[55.075902, "i", "python3 - <<'PY'\nimport re,collections\nactive=False;x=y=0.;z=None;d=collections.defaultdict(list)\nfor raw in open('text.gcode'):\n s=raw.strip()\n if s=='M486 S0': active=True;continue\n if s.startswith('M486 ') and s!='M486 S0': active=False;continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue\n ox,oy=x,y\n m=re.search(r'\\bX(-?[0-9.]+)',s)\n if m:x=float(m.group(1))\n m=re.search(r'\\bY(-?[0-9.]+)',s)\n if m:y=float(m.group(1))\n m=re.search(r'\\bZ(-?[0-9.]+)',s)\n if m:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m and float(m.group(1))>0 and (x!=ox or y!=oy) and z is not None:d[z].append((ox,oy,x,y))\nfor zz in sorted(d):\n q=d[zz]\n print(f'{zz:6.2f} {len(q):5d} X {min(min(a,c) for a,b,c,e in q):.1f}-{max(max(a,c) for a,b,c,e in q):.1f} Y {min(min(b,e) for a,b,c,e in q):.1f}-{max(max(b,e) for a,b,c,e in q):.1f}')\nPY\n"]
