[214.300975, "i", "cat > /tmp/boundary.py <<'PY'\nimport re,math\nq=[]; active=False; x=y=0.; z=None\nfor n,raw in enumerate(open('/app/text.gcode'),1):\n    if n<15014: continue\n    s=raw.strip()\n    if s=='M486 S0': active=True; continue\n    if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n    if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n    ox,oy=x,y; e=None\n    for k in 'XYZ':\n        m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n        if m:\n            if k=='X': x=float(m.group(1))\n            elif k=='Y': y=float(m.group(1))\n            else: z=float(m.group(1))\n    m=re.search(r'\\bE(-?[0-9.]+)',s)\n    if m: e=float(m.group(1))\n    if e is not None and e>0 and z is not None and (x!=ox or y!=oy): q.append((ox,oy,x,y,z))\nv=(142.,55.,61.); nv=math.sqrt(sum(t*t for t in v)); v=tuple(t/nv for t in v)\nu=(55.,-142.,0.); nu=math.sqrt(sum(t*t for t in u)); u=tuple(t/nu for t in u)\ndef P(x,y,z,t): return x*t[0]+y*t[1]+z*t[2]\nW,H=360,140; allp=[]\nfor a,b,c,d,z in q:\n allp += [(P(a,b,z,u),P(a,b,"]
