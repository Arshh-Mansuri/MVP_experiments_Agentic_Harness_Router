[243.239793, "i", "cat > /tmp/pca.py <<'PY'\nimport re,math\nimport numpy as np\nP=[]; active=False; x=y=0.; z=None\nfor n,raw in enumerate(open('/app/text.gcode'),1):\n    if n<15014: continue\n    s=raw.strip()\n    if s=='M486 S0': active=True; continue\n    if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n    if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n    ox,oy=x,y; e=None\n    for k in 'XYZ':\n        m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n        if m:\n            if k=='X':x=float(m.group(1))\n            elif k=='Y':y=float(m.group(1))\n            else:z=float(m.group(1))\n    m=re.search(r'\\bE(-?[0-9.]+)',s)\n    if m:e=float(m.group(1))\n    if e is not None and e>0 and z is not None and (x!=ox or y!=oy):\n        P += [[ox,oy,z],[x,y,z]]\nP=np.array(P); c=P.mean(0); C=np.cov(P-c,rowvar=False); val,vec=np.linalg.eigh(C); ix=np.argsort(val)[::-1]; vec=vec[:,ix]; val=val[ix]\nQ=(P-c)@vec\nprint('eigenvalues',val,'ranges',Q.min(0),Q.max(0))\n# surface coordinates: largest two PCs; depth=thir"]
[243.240848, "o", "cat > /tmp/pca.py <<'PY'\r\n\u001b[?2004l\r"]
[243.242992, "i", "d. Keep upper envelope per 2D cell\nW,H=140,70; a,b=Q[:,0],Q[:,1]; d=Q[:,2]; amin,amax=a.min(),a.max(); bmin,bmax=b.min(),b.max()\ncell={}\nfor A,B,D in zip(a,b,d):\n ix=int((A-amin)/(amax-amin+1e-9)*(W-1)); iy=int((bmax-B)/(bmax-bmin+1e-9)*(H-1)); cell[(ix,iy)]=max(cell.get((ix,iy),-1e9),D)\n# show cells near local envelope, with one-cell gap preserved\nfor iy in range(H):\n print(''.join('#' if (ix,iy) in cell else ' ' for ix in range(W)).rstrip())\nPY\npython3 /tmp/pca.py\n"]
