[39.405982, "i", "python3 - <<'PY'\nimport re\nactive=False; x=y=0.; z=None; seg=[]; start=0; sections=[]; line_no=0\nfor raw in open('text.gcode'):\n line_no+=1; s=raw.strip()\n if s=='M486 S0':\n  active=True; start=line_no; seg=[]; x=y=0.; z=None; continue\n if s.startswith('M486 ') and s!='M486 S0':\n  if active and seg:\n   sections.append((start,line_no-1,seg))\n  active=False; continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n ox,oy=x,y\n m=re.search(r'\\bX(-?[0-9.]+)',s)\n if m:x=float(m.group(1))\n m=re.search(r'\\bY(-?[0-9.]+)',s)\n if m:y=float(m.group(1))\n m=re.search(r'\\bZ(-?[0-9.]+)',s)\n if m:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m and float(m.group(1))>0 and (x!=ox or y!=oy):seg.append((ox,oy,x,y,z))\nif active and seg:sections.append((start,line_no,seg))\nfor i,(a,b,s) in enumerate(sections):\n print(i,a,b,len(s),'xy',round(min(min(q[0],q[2]) for q in s),1),round(max(max(q[0],q[2]) for q in s),1),round(min(min(q[1],q[3]) for q in s),1),round(max(max(q[1],q[3]) for q in s),1)"]
