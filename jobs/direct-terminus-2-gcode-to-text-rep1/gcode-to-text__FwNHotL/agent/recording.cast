[67.783146, "i", "python3 - <<'PY'\nimport re,collections\nactive=False;x=y=0.;z=None;d=collections.defaultdict(list)\nfor raw in open('text.gcode'):\n s=raw.strip()\n if s=='M486 S0': active=True;continue\n if s.startswith('M486 ') and s!='M486 S0': active=False;continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue\n ox,oy=x,y\n for key in 'XYZE':\n  m=re.search(r'\\b'+key+r'(-?[0-9.]+)',s)\n  if m:\n   if key=='X':x=float(m.group(1))\n   elif key=='Y':y=float(m.group(1))\n   elif key=='Z':z=float(m.group(1))\n   else:\n    e=float(m.group(1))\n    if e>0 and (x!=ox or y!=oy) and z is not None:d[round(z,2)].append((ox,oy,x,y))\nfor target in [10.0,20.92,32.4,45.0,58.16,64.88]:\n q=d.get(target,[])\n if not q:continue\n xmin=min(min(a,c) for a,b,c,e in q);xmax=max(max(a,c) for a,b,c,e in q)\n ymin=min(min(b,e) for a,b,c,e in q);ymax=max(max(b,e) for a,b,c,e in q)\n W,H=120,50; pix=[[' ']*W for _ in range(H)]\n for x1,y1,x2,y2 in q:\n  n=max(1,int(max(abs(x2-x1),abs(y2-y1))*15))\n  for i in range(n+1):\n   xx=x1+(x2-x1)*i/n"]
[67.785372, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re,collections\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.785603, "i", "; yy=y1+(y2-y1)*i/n\n   ix=min(W-1,max(0,int((xx-xmin)/(xmax-xmin+1e-9)*(W-1))))\n   iy=min(H-1,max(0,int((ymax-yy)/(ymax-ymin+1e-9)*(H-1))))\n   pix[iy][ix]='#'\n print('\\nLAYER',target,'bounds',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1))\n print('\\n'.join(''.join(r).rstrip() for r in pix))\nPY\n"]
[67.78579, "o", "active=False;x=y=0.;z=None;d=collections.defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> for raw in open('text.gcode'):\r\n\u001b[?2004l\r\u001b[?2004h>  s=raw.strip()\r\n\u001b[?2004l\r\u001b[?2004h>  if s=='M486 S0': active=True;continue\r\n\u001b[?2004l\r\u001b[?2004h>  if s.startswith('M486 ') and s!='M486 S0': active=False;continue\r\n\u001b[?2004l\r\u001b[?2004h>  if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue\r\n\u001b[?2004l\r\u001b[?2004h>  ox,oy=x,y\r\n\u001b[?2004l\r\u001b[?2004h>  for key in 'XYZE':\r\n\u001b[?2004l\r\u001b[?2004h>   m=re.search(r'\\b'+key+r'(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>   if m:\r\n\u001b[?2004l\r\u001b[?2004h>    if key=='X':x=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>    elif key=='Y':y=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
