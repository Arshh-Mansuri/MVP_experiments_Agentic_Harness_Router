[24.019422, "i", "python3 - <<'PY'\nimport re\np='text.gcode'\nactive=False; x=y=0.; z=None; seg=[]; layer=None\nfor line in open(p):\n    s=line.strip()\n    if s=='M486 S0': active=True\n    elif s in ('M486 S1','M486 S-1') and active and s=='M486 S1': active=False\n    if not active: continue\n    if s.startswith('G1') or s.startswith('G0'):\n        mx=re.search(r'\\\\bX(-?[0-9.]+)',s); my=re.search(r'\\\\bY(-?[0-9.]+)',s); mz=re.search(r'\\\\bZ(-?[0-9.]+)',s); me=re.search(r'\\\\bE(-?[0-9.]+)',s)\n        ox,oy=x,y\n        if mx:x=float(mx.group(1))\n        if my:y=float(my.group(1))\n        if mz:z=float(mz.group(1)); layer=z\n        if me and float(me.group(1))>0 and (x!=ox or y!=oy): seg.append((ox,oy,x,y,layer))\nprint('segments',len(seg),'bounds',min(a for a,b,c,d,z in seg),max(a for a,b,c,d,z in seg),min(b for a,b,c,d,z in seg),max(b for a,b,c,d,z in seg),'layers',sorted(set(z for a,b,c,d,z in seg))[:20])\n# render all text segments, excluding accidental purge moves by bounds\nW,H=100,40; xmin,xmax=50,110; ymin,ymax=70,125\npix=[[' ']*W f"]
[24.0195, "i", "or _ in range(H)]\nfor x1,y1,x2,y2,z in seg:\n    if not (xmin<=x1<=xmax and ymin<=y1<=ymax and xmin<=x2<=xmax and ymin<=y2<=ymax): continue\n    n=max(1,int(max(abs(x2-x1),abs(y2-y1))*4))\n    for i in range(n+1):\n      x=x1+(x2-x1)*i/n; y=y1+(y2-y1)*i/n\n      ix=int((x-xmin)/(xmax-xmin)*W); iy=int((ymax-y)/(ymax-ymin)*H)\n      if 0<=ix<W and 0<=iy<H: pix[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in pix))\nPY\n"]
