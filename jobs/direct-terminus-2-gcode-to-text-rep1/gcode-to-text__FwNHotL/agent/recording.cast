[200.404931, "i", "cat > /tmp/project.py <<'PY'\nimport re,math\nq=[]; active=False; x=y=0.; z=None\nfor n,raw in enumerate(open('/app/text.gcode'),1):\n    if n<15014: continue\n    s=raw.strip()\n    if s=='M486 S0': active=True; continue\n    if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n    if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n    ox,oy=x,y; e=None\n    m=re.search(r'\\bX(-?[0-9.]+)',s)\n    if m:x=float(m.group(1))\n    m=re.search(r'\\bY(-?[0-9.]+)',s)\n    if m:y=float(m.group(1))\n    m=re.search(r'\\bZ(-?[0-9.]+)',s)\n    if m:z=float(m.group(1))\n    m=re.search(r'\\bE(-?[0-9.]+)',s)\n    if m:e=float(m.group(1))\n    if e is not None and e>0 and z is not None and (x!=ox or y!=oy): q.append((ox,oy,x,y,z))\n# tangent axes: u across the diagonal in XY, v along the 3D diagonal\nv=(142.,55.,61.); nv=math.sqrt(sum(t*t for t in v)); v=tuple(t/nv for t in v)\nu=(55.,-142.,0.); nu=math.sqrt(sum(t*t for t in u)); u=tuple(t/nu for t in u)\ndef P(x,y,z,t): return x*t[0]+y*t[1]+z*t[2]\nvals=[]\nfo"]
[200.406028, "o", "cat > /tmp/project.py <<'PY'\r\n"]
[200.406103, "i", "r a,b,c,d,z in q:\n vals += [(P(a,b,z,u),P(a,b,z,v)),(P(c,d,z,u),P(c,d,z,v))]\nu0,u1=min(a for a,b in vals),max(a for a,b in vals); v0,v1=min(b for a,b in vals),max(b for a,b in vals)\nprint('segments',len(q),'surface bounds',round(u0,2),round(u1,2),round(v0,2),round(v1,2))\nW,H=180,70; g=[[' ']*W for _ in range(H)]\nfor a,b,c,d,z in q:\n ua,va=P(a,b,z,u),P(a,b,z,v); uc,vc=P(c,d,z,u),P(c,d,z,v)\n n=max(1,int(max(abs(uc-ua),abs(vc-va))*12))\n for i in range(n+1):\n  U=ua+(uc-ua)*i/n; V=va+(vc-va)*i/n\n  ix=int((U-u0)/(u1-u0+1e-9)*(W-1)); iy=int((v1-V)/(v1-v0+1e-9)*(H-1))\n  if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in g))\nPY\npython3 /tmp/project.py\n"]
