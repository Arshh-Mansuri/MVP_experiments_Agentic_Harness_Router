[95.071387, "i", "python3 - <<'PY'\nimport re\npts=[]; active=False; x=y=0.; z=None\nfor raw in open('text.gcode'):\n s=raw.strip()\n if s=='M486 S0': active=True; continue\n if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n ox,oy=x,y; e=None\n for k in 'XYZ':\n  m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n  if m:\n   if k=='X':x=float(m.group(1))\n   elif k=='Y':y=float(m.group(1))\n   else:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m:e=float(m.group(1))\n if e is not None and e>0 and (x!=ox or y!=oy) and z is not None and z>=3: pts.append((ox,oy,x,y,z))\nxr=(203-61)/(64-3); yr=(140-85)/(64-3)\nq=[(a-xr*(z-3),b-yr*(z-3),c-xr*(z-3),d-yr*(z-3)) for a,b,c,d,z in pts]\nx0=min(min(a,c) for a,b,c,d in q); x1=max(max(a,c) for a,b,c,d in q); y0=min(min(b,d) for a,b,c,d in q); y1=max(max(b,d) for a,b,c,d in q)\nW,H=100,50; grid=[[0]*W for _ in range(H)]\nfor a,b,c,d in q:\n n=max(1,int(max(abs(c-a),abs(d-b))*10))\n for i in range(n+1):\n  xx=a+(c-a)*i/n"]
[95.075379, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.075626, "i", "; yy=b+(d-b)*i/n\n  ix=int((xx-x0)/(x1-x0)* (W-1)); iy=int((y1-yy)/(y1-y0)*(H-1))\n  if 0<=ix<W and 0<=iy<H:grid[iy][ix]=1\nopen('/app/text_map.txt','w').write('\\n'.join(''.join('#' if v else '.' for v in r) for r in grid)+'\\n')\nprint('occupied',sum(map(sum,grid)),'of',W*H)\nfor i,r in enumerate(grid): print(f'{i:02d}|'+''.join('#' if v else '.' for v in r)+'|')\nPY\n"]
