[254.817122, "i", "0):\n p,q=max(((i,j) for i in range(3) for j in range(i+1,3)),key=lambda ij:abs(A[ij[0]][ij[1]]))\n if abs(A[p][q])<1e-8: break\n t=(A[q][q]-A[p][p])/(2*A[p][q]); t=(1 if t>=0 else -1)/(abs(t)+math.sqrt(t*t+1)); co=1/math.sqrt(1+t*t); si=t*co\n for k in range(3):\n  ap,aq=A[k][p],A[k][q]; A[k][p]=co*ap-si*aq; A[k][q]=si*ap+co*aq\n for k in range(3):\n  ap,aq=A[p][k],A[q][k]; A[p][k]=co*ap-si*aq; A[q][k]=si*ap+co*aq\n for k in range(3):\n  vp,vq=V[k][p],V[k][q]; V[k][p]=co*vp-si*vq; V[k][q]=si*vp+co*vq\norder=sorted(range(3),key=lambda i:A[i][i],reverse=True); axes=[[V[k][i] for k in range(3)] for i in order]\nprint('eigenvalues',[round(A[i][i],1) for i in order],'axes',axes)\nQ=[]\nfor p in P:\n r=[p[i]-c[i] for i in range(3)]; Q.append([sum(r[k]*a[k] for k in range(3)) for a in axes])\nW,H=160,70; xs=[r[0] for r in Q]; ys=[r[1] for r in Q]; x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys); grid=[[0]*W for _ in range(H)]\nfor a,b,d in Q:\n ix=int((a-x0)/(x1-x0+1e-9)*(W-1)); iy=int((y1-b)/(y1-y0+1e-9)*(H-1)); grid[iy][ix]+=1\nmx=ma"]
