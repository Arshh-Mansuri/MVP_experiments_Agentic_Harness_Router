[84.796925, "i", "python3 - <<'PY'\nimport re,math\npts=[]\nactive=False;x=y=0.;z=None\nfor raw in open('text.gcode'):\n s=raw.strip()\n if s=='M486 S0': active=True; continue\n if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n ox,oy=x,y; e=None\n m=re.search(r'\\bX(-?[0-9.]+)',s)\n if m:x=float(m.group(1))\n m=re.search(r'\\bY(-?[0-9.]+)',s)\n if m:y=float(m.group(1))\n m=re.search(r'\\bZ(-?[0-9.]+)',s)\n if m:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m:e=float(m.group(1))\n if e is not None and e>0 and (x!=ox or y!=oy) and z is not None and z>=3:\n  pts.append((ox,oy,x,y,z))\n# drift estimated from endpoints of the sloped object\nxrate=(203.0-61.0)/(64.0-3.0); yrate=(140.0-85.0)/(64.0-3.0)\nq=[]\nfor x1,y1,x2,y2,z in pts:\n q.append((x1-xrate*(z-3),y1-yrate*(z-3),x2-xrate*(z-3),y2-yrate*(z-3)))\nxmin=min(min(a,c) for a,b,c,d in q); xmax=max(max(a,c) for a,b,c,d in q)\nymin=min(min(b,d) for a,b,c,d in q); ymax=max(max(b,d) for a,b,c,d in q)\np"]
[84.79844, "i", "rint('deskew bounds',xmin,xmax,ymin,ymax,'segments',len(q))\nW,H=180,80; pix=[[' ']*W for _ in range(H)]\nfor x1,y1,x2,y2 in q:\n n=max(1,int(max(abs(x2-x1),abs(y2-y1))*12))\n for i in range(n+1):\n  xx=x1+(x2-x1)*i/n; yy=y1+(y2-y1)*i/n\n  ix=int((xx-xmin)/(xmax-xmin+1e-9)*(W-1)); iy=int((ymax-yy)/(ymax-ymin+1e-9)*(H-1))\n  if 0<=ix<W and 0<=iy<H: pix[iy][ix]='#'\nprint('\\n'.join(''.join(r).rstrip() for r in pix))\nPY\n"]
