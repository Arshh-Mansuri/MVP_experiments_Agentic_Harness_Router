[47.46592, "i", "python3 - <<'PY'\nimport re\nsections=[]; active=False; x=y=0.; z=None; seg=[]; start=0; ln=0\nfor raw in open('text.gcode'):\n ln+=1; s=raw.strip()\n if s=='M486 S0':\n  if active and seg: sections.append(seg)\n  active=True; seg=[]; x=y=0.; z=None; continue\n if s.startswith('M486 ') and s!='M486 S0':\n  if active and seg: sections.append(seg)\n  active=False; seg=[]; continue\n if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n ox,oy=x,y\n m=re.search(r'\\bX(-?[0-9.]+)',s)\n if m:x=float(m.group(1))\n m=re.search(r'\\bY(-?[0-9.]+)',s)\n if m:y=float(m.group(1))\n m=re.search(r'\\bZ(-?[0-9.]+)',s)\n if m:z=float(m.group(1))\n m=re.search(r'\\bE(-?[0-9.]+)',s)\n if m and float(m.group(1))>0 and (x!=ox or y!=oy):seg.append((ox,oy,x,y,z))\nif active and seg: sections.append(seg)\n# only first ten text layers\nS=[q for sec in sections[:10] for q in sec]\nxmin,xmax=56.3,67.0; ymin,ymax=79.8,91.0\nW,H=160,80\nfor name, chosen in [('all',S),('upper', [q for sec in sections[5:10] for q in sec])]:\n pix=[[' ']*W for _ i"]
[47.468594, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.468734, "i", "n range(H)]\n for x1,y1,x2,y2,z in chosen:\n  n=max(1,int(max(abs(x2-x1),abs(y2-y1))*12))\n  for i in range(n+1):\n   xx=x1+(x2-x1)*i/n; yy=y1+(y2-y1)*i/n\n   ix=int((xx-xmin)/(xmax-xmin)*W); iy=int((ymax-yy)/(ymax-ymin)*H)\n   if 0<=ix<W and 0<=iy<H: pix[iy][ix]='#'\n print('\\n---',name,'---')\n print('\\n'.join(''.join(r).rstrip() for r in pix))\nPY\n"]
[47.469173, "o", "sections=[]; active=False; x=y=0.; z=None; seg=[]; start=0; ln=0\r\n\u001b[?2004l\r\u001b[?2004h> for raw in open('text.gcode'):\r\n\u001b[?2004l\r\u001b[?2004h>  ln+=1; s=raw.strip()\r\n\u001b[?2004l\r\u001b[?2004h>  if s=='M486 S0':\r\n\u001b[?2004l\r\u001b[?2004h>   if active and seg: sections.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h>   active=True; seg=[]; x=y=0.; z=None; continue\r\n\u001b[?2004l\r\u001b[?2004h>  if s.startswith('M486 ') and s!='M486 S0':\r\n\u001b[?2004l\r\u001b[?2004h>   if active and seg: sections.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h>   active=False; seg=[]; continue\r\n\u001b[?2004l\r\u001b[?2004h>  if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\r\n\u001b[?2004l\r\u001b[?2004h>  ox,oy=x,y\r\n\u001b[?2004l\r\u001b[?2004h>  m=re.search(r'\\bX(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m:x=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  m=re.search(r'\\bY(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m:y=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  m=re.search(r'\\bZ(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m:z=float(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h>  m=re.search(r'\\bE(-?[0-9.]+)',s)\r\n\u001b[?2004l\r\u001b[?2004h>  if m and float(m"]
