[?2004hroot@85fb495742be:/app# python3 - <<'PY'
[?2004l[?2004h> import re,math
[?2004l[?2004h> # collect text S0 extrusion segments in the small-object region (before line 15014)
[?2004l[?2004h> q=[];active=False;x=y=0.;z=None
[?2004l[?2004h> for n,raw in enumerate(open('text.gcode'),1):
[?2004l[?2004h>  if n>=15014:break
[?2004l[?2004h>  s=raw.strip()
[?2004l[?2004h>  if s=='M486 S0':active=True;continue
[?2004l[?2004h>  if s.startswith('M486 ') and s!='M486 S0':active=False;continue
[?2004l[?2004h>  if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue
[?2004l[?2004h>  ox,oy=x,y;e=None
[?2004l[?2004h>  for k in 'XYZ':
[?2004l[?2004h>   m=re.search(r'\b'+k+r'(-?[0-9.]+)',s)
[?2004l[?2004h>   if m:
[?2004l[?2004h>    if k=='X':x=float(m.group(1))
[?2004l[?2004h>    elif k=='Y':y=float(m.group(1))
[?2004l[?2004h>    else:z=float(m.group(1))
[?2004l[?2004h>  m=re.search(r'\bE(-?[0-9.]+)',s)
[?2004l[?2004h>  if m:e=float(m.group(1))
[?2004l[?2004h>  if e and e>0 and (x!=ox or y!=oy) and z is not None:q.append((ox,oy,x,y,z))
[?2004l[?2004h> # project x,y,z onto coordinates along and perpendicular to the observed diagonal growth
[?2004l[?2004h> # longitudinal direction approximately (dx,dy,dz)=(142,55,61)
[?2004l[?2004h> v=(142.,55.,61.); norm=math.sqrt(sum(t*t for t in v)); v=tuple(t/norm for t in v)
[?2004l[?2004h> # choose basis u mostly screen horizontal and w vertical-ish
[?2004l[?2004h> u=(v[1],-v[0],0); un=math.sqrt(u[0]**2+u[1]**2);u=tuple(t/un for t in u)
[?2004l[?2004h> w=(v[1]*u[2]-v[2]*u[1],v[2]*u[0]-v[0]*u[2],v[0]*u[1]-v[1]*u[0])
[?2004l[?2004h> pts=[]
[?2004l[?2004h> for a,b,c,d,z in q:
[?2004l[?2004h>  for X,Y in [(a,b),(c,d)]:pts.append((X,Y,z))
[?2004l[?2004h> def proj(p,t):return sum(p[i]*t[i] for i in range(3))
[?2004l[?2004h> U=[proj(p,u) for p in pts];Wv=[proj(p,w) for p in pts]
[?2004l[?2004h> u0,u1=min(U),max(U);w0,w1=min(Wv),max(Wv)
[?2004l[?2004h> print('points',len(pts),'projected bounds',u0,u1,w0,w1)
[?2004l[?2004h> W,H=120,60;g=[[' ']*W for _ in range(H)]
[?2004l[?2004h> for a,b,c,d,z in q:
[?2004l[?2004h>  n=max(1,int(max(abs(c-a),abs(d-b),abs(z or 0))*8))
[?2004l[?2004h>  for i in range(n+1):
[?2004l[?2004h>   X=a+(c-a)*i/n;Y=b+(d-b)*i/n;Z=z
[?2004l[?2004h>   uu=proj((X,Y,Z),u);ww=proj((X,Y,Z),w)
[?2004l[?2004h>   ix=int((uu-u0)/(u1-u0+1e-9)*(W-1));iy=int((w1-ww)/(w1-w0+1e-9)*(H-1))
[?2004l[?2004h>   if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'
[?2004l[?2004h> print('\n'.join(''.join(r).rstrip() for r in g))
[?2004l[?2004h> PY
