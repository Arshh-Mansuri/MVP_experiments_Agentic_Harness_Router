[?2004hroot@85fb495742be:/app# cat > /tmp/surface.py <<'PY'
[?2004l[?2004h> exec(open('/tmp/pca.py').read().split("W,H=160,70")[0])
[?2004l[?2004h> # Q, axes, and P have been created by the prefix above
[?2004l[?2004h> W,H=200,50
[?2004l[?2004h> for label,which in [('high',1),('low',-1)]:
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for r in Q: vals.append(r[2])
[?2004l[?2004h>  cut=sorted(vals)[int((.90 if which==1 else .10)*len(vals))]
[?2004l[?2004h>  g=[[0]*W for _ in range(H)]
[?2004l[?2004h>  for a,b,d in Q:
[?2004l[?2004h>   if (d>=cut if which==1 else d<=cut):
[?2004l[?2004h>    ix=int((a-min(x[0] for x in Q))/(max(x[0] for x in Q)-min(x[0] for x in Q)+1e-9)*(W-1))
[?2004l[?2004h>    iy=int((max(x[1] for x in Q)-b)/(max(x[1] for x in Q)-min(x[1] for x in Q)+1e-9)*(H-1))
[?2004l[?2004h>    if 0<=ix<W and 0<=iy<H:g[iy][ix]=1
[?2004l[?2004h>  out='\n'.join(''.join('#' if z else ' ' for z in r).rstrip() for r in g)+'\n'
[?2004l[?2004h>  open('/app/'+label+'_surface.txt','w').write(out)
[?2004l[?2004h>  print('\n---'+label+'---\n'+out)
[?2004l[?2004h> PY
