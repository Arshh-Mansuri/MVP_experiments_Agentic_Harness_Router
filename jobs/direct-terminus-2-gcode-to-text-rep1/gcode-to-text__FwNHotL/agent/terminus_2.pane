[?2004l[?2004h> import re,collections,math
[?2004l[?2004h> layers=collections.defaultdict(list); active=False;x=y=0.;z=None
[?2004l[?2004h> for n,raw in enumerate(open('text.gcode'),1):
[?2004l[?2004h>  if n>=15014: break
[?2004l[?2004h>  s=raw.strip()
[?2004l[?2004h>  if s=='M486 S0': active=True; continue
[?2004l[?2004h>  if s.startswith('M486 ') and s!='M486 S0': active=False; continue
[?2004l[?2004h>  if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue
[?2004l[?2004h>  ox,oy=x,y; e=None
[?2004l[?2004h>  for k in 'XYZ':
[?2004l[?2004h>   m=re.search(r'\b'+k+r'(-?[0-9.]+)',s)
[?2004l[?2004h>   if m:
[?2004l[?2004h>    if k=='X': x=float(m.group(1))
[?2004l[?2004h>    elif k=='Y': y=float(m.group(1))
[?2004l[?2004h>    else: z=float(m.group(1))
[?2004l[?2004h>  m=re.search(r'\bE(-?[0-9.]+)',s)
[?2004l[?2004h>  if m: e=float(m.group(1))
[?2004l[?2004h>  if e is not None and e>0 and z is not None and (x!=ox or y!=oy):
[?2004l[?2004h>   L=math.hypot(x-ox,y-oy)
[?2004l[?2004h>   if L<1.0: layers[round(z,2)].append((ox,oy,x,y,L))
[?2004l[?2004h> print('short-segment counts:',[(z,len(layers[z])) for z in sorted(layers)])
[?2004l[?2004h> for z in [0.48,1.6,2.72]:
[?2004l[?2004h>  q=layers[z]; xmin,xmax=55,68; ymin,ymax=79,92; W,H=104,52; g=[['.']*W for _ in range(H)]
[?2004l[?2004h>  for a,b,c,d,L in q:
[?2004l[?2004h>   n=max(1,int(L*20))
[?2004l[?2004h>   for i in range(n+1):
[?2004l[?2004h>    xx=a+(c-a)*i/n; yy=b+(d-b)*i/n
[?2004l[?2004h>    ix=int((xx-xmin)/(xmax-xmin)*(W-1)); iy=int((ymax-yy)/(ymax-ymin)*(H-1))
[?2004l[?2004h>    if 0<=ix<W and 0<=iy<H:g[iy][ix]='#'
[?2004l[?2004h>  print('\nLAYER',z)
[?2004l[?2004h>  print('\n'.join(''.join(r) for r in g))
[?2004l[?2004h> PY^C[?2004l[?2004h[?2004l
