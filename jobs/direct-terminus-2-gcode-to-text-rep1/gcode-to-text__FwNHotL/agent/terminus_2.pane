[?2004l[?2004h> import re,collections
[?2004l[?2004h> active=False;x=y=0.;z=None;d=collections.defaultdict(list)
[?2004l[?2004h> for raw in open('text.gcode'):
[?2004l[?2004h>  s=raw.strip()
[?2004l[?2004h>  if s=='M486 S0': active=True;continue
[?2004l[?2004h>  if s.startswith('M486 ') and s!='M486 S0': active=False;continue
[?2004l[?2004h>  if not active or not (s.startswith('G1 ') or s.startswith('G0 ')):continue
[?2004l[?2004h>  ox,oy=x,y
[?2004l[?2004h>  for key in 'XYZE':
[?2004l[?2004h>   m=re.search(r'\b'+key+r'(-?[0-9.]+)',s)
[?2004l[?2004h>   if m:
[?2004l[?2004h>    if key=='X':x=float(m.group(1))
[?2004l[?2004h>    elif key=='Y':y=float(m.group(1))
[?2004l[?2004h>    elif key=='Z':z=float(m.group(1))
[?2004l[?2004h>    else:
[?2004l[?2004h>     e=float(m.group(1))
[?2004l[?2004h>     if e>0 and (x!=ox or y!=oy) and z is not None:d[round(z,2)].append((ox,oy,x,y))
[?2004l[?2004h> for target in [10.0,20.92,32.4,45.0,58.16,64.88]:
[?2004l[?2004h>  q=d.get(target,[])
[?2004l[?2004h>  if not q:continue
[?2004l[?2004h>  xmin=min(min(a,c) for a,b,c,e in q);xmax=max(max(a,c) for a,b,c,e in q)
[?2004l[?2004h>  ymin=min(min(b,e) for a,b,c,e in q);ymax=max(max(b,e) for a,b,c,e in q)
[?2004l[?2004h>  W,H=120,50; pix=[[' ']*W for _ in range(H)]
[?2004l[?2004h>  for x1,y1,x2,y2 in q:
[?2004l[?2004h>   n=max(1,int(max(abs(x2-x1),abs(y2-y1))*15))
[?2004l[?2004h>   for i in range(n+1):
[?2004l[?2004h>    xx=x1+(x2-x1)*i/n; yy=y1+(y2-y1)*i/n
[?2004l[?2004h>    ix=min(W-1,max(0,int((xx-xmin)/(xmax-xmin+1e-9)*(W-1))))
[?2004l[?2004h>    iy=min(H-1,max(0,int((ymax-yy)/(ymax-ymin+1e-9)*(H-1))))
[?2004l[?2004h>    pix[iy][ix]='#'
[?2004l[?2004h>  print('\nLAYER',target,'bounds',round(xmin,1),round(xmax,1),round(ymin,1),round(ymax,1))
[?2004l[?2004h>  print('\n'.join(''.join(r).rstrip() for r in pix))
