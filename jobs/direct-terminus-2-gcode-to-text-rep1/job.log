Sending keys: ["cat > /tmp/pca.py <<'PY'\nimport re,math\nP=[]; active=False; x=y=0.; z=None\nfor n,raw in enumerate(open('/app/text.gcode'),1):\n    if n<15014: continue\n    s=raw.strip()\n    if s=='M486 S0': active=True; continue\n    if s.startswith('M486 ') and s!='M486 S0': active=False; continue\n    if not active or not (s.startswith('G1 ') or s.startswith('G0 ')): continue\n    ox,oy=x,y; e=None\n    for k in 'XYZ':\n        m=re.search(r'\\b'+k+r'(-?[0-9.]+)',s)\n        if m:\n            if k=='X': x=float(m.group(1))\n            elif k=='Y': y=float(m.group(1))\n            else: z=float(m.group(1))\n    m=re.search(r'\\bE(-?[0-9.]+)',s)\n    if m: e=float(m.group(1))\n    if e is not None and e>0 and z is not None and (x!=ox or y!=oy):\n        P.extend([(ox,oy,z),(x,y,z)])\nc=[sum(p[i] for p in P)/len(P) for i in range(3)]\nA=[[0.0]*3 for _ in range(3)]\nfor p in P:\n q=[p[i]-c[i] for i in range(3)]\n for i in range(3):\n  for j in range(3): A[i][j]+=q[i]*q[j]\n# Jacobi eigenvectors\nV=[[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]\nfor _ in range(60):\n p,q=max(((i,j) for i in range(3) for j in range(i+1,3)),key=lambda ij:abs(A[ij[0]][ij[1]]))\n if abs(A[p][q])<1e-8: break\n t=(A[q][q]-A[p][p])/(2*A[p][q]); t=(1 if t>=0 else -1)/(abs(t)+math.sqrt(t*t+1)); co=1/math.sqrt(1+t*t); si=t*co\n for k in range(3):\n  ap,aq=A[k][p],A[k][q]; A[k][p]=co*ap-si*aq; A[k][q]=si*ap+co*aq\n for k in range(3):\n  ap,aq=A[p][k],A[q][k]; A[p][k]=co*ap-si*aq; A[q][k]=si*ap+co*aq\n for k in range(3):\n  vp,vq=V[k][p],V[k][q]; V[k][p]=co*vp-si*vq; V[k][q]=si*vp+co*vq\norder=sorted(range(3),key=lambda i:A[i][i],reverse=True); axes=[[V[k][i] for k in range(3)] for i in order]\nprint('eigenvalues',[round(A[i][i],1) for i in order],'axes',axes)\nQ=[]\nfor p in P:\n r=[p[i]-c[i] for i in range(3)]; Q.append([sum(r[k]*a[k] for k in range(3)) for a in axes])\nW,H=160,70; xs=[r[0] for r in Q]; ys=[r[1] for r in Q]; x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys); grid=[[0]*W for _ in range(H)]