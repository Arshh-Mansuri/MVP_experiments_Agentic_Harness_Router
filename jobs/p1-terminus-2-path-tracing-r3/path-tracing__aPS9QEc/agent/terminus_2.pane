p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));
def q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])
for y in [900,920,950,1000,1050,1100,1150,1200,1250,1300,1400,1500,1600,1700,1799]:
 # transitions in grayscale/other color, omit short antialias runs
 z=[q(x,y) for x in range(w)]; runs=[];st=0
 for x in range(1,w):
  if z[x]!=z[x-1]:
   if x-st>=10:runs.append((st,x-1,z[x-1]))
   st=x
 if w-st>=10:runs.append((st,w-1,z[-1]))
 print(y,runs[:30])
