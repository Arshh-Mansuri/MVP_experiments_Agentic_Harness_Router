python3 - <<'PY'
p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));
for col,n in [((152,152,152),'gray152'),((67,67,67),'gray67'),((51,10,10),'red'),((20,20,20),'dark')]:
 pts=[(i%w,i//w) for i in range(w*h) if tuple(a[3*i:3*i+3])==col]
 print(n,len(pts), (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else '')
