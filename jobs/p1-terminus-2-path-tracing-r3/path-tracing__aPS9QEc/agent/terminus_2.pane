python3 - <<'PY'
import math
p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])
print('rmse',math.sqrt(sum((A[j]-B[j])**2 for j in range(len(A)))/len(A)))
xs=[]
for y in range(700,1400):
 for x in range(w):
  k=3*(y*w+x);r,g,b=B[k:k+3]
  if r>g*2 and g<40:xs.append((x,y))
print('bounds',min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs))
PY
