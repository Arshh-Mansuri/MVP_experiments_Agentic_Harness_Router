q=open('reconstructed.ppm','rb').read();B=q[17:];w=2400;xs=[]
for y in range(700,1500):
 for x in range(w):
  k=3*(y*w+x);r,g,b=B[k:k+3]
  if r>g*2 and g<40:xs.append((x,y))
print('bounds', (min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs)) if xs else None)
