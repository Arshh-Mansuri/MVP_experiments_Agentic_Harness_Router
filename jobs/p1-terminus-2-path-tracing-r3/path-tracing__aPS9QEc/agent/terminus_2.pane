cat > /tmp/an.py <<'PY'
p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));
def q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])
def runs(y):
 old=q(0,y); st=0
 for x in range(1,w):
  z=q(x,y)
  if z!=old:
   if x-st>20: print(st,x-1,x-st,old)
   st=x;old=z
 if w-st>20:print(st,w-1,w-st,old)
for y in [0,100,300,500,600,650,675,700,750,800,900,1000,1200,1500,1799]:
 print('\nY',y,'samples',[q(x,y) for x in [0,300,600,900,1100,1150,1200,1250,1300,1500,1800,2100,2399]])
 print('runs:');runs(y)
print('vertical center')
for y in range(0,h,50):print(y,q(0,y),q(1200,y),q(2399,y))
