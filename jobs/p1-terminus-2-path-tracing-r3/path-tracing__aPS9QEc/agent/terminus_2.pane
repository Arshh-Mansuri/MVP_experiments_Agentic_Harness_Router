import math
p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]))
q=open('reconstructed.ppm','rb').read();print('header',repr(q[:17]),'size',len(q));B=list(q[17:]);print('payload',len(B),'expected',w*h*3)
for name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:
 ss=sa=n=0
 for y in range(y0,y1):
  for x in range(w):
   k=3*(y*w+x)
   for c in range(3):
    d=A[k+c]-B[k+c];ss+=d*d;sa+=abs(d);n+=1
 print(name,'rmse',math.sqrt(ss/n),'mae',sa/n)
for x,y in [(0,0),(1200,0),(0,899),(1200,899),(0,900),(300,1000),(1200,1000),(1200,1200),(1200,1500)]:
 k=3*(y*w+x);print(x,y,tuple(A[k:k+3]),tuple(B[k:k+3]))
