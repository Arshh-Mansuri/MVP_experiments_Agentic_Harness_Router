python3 - <<'PY'
import math
p=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])
for name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:
 s=n=0
 for y in range(y0,y1):
  for x in range(w):
   k=3*(y*w+x)
   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1
 print(name,math.sqrt(s/n))
PY
