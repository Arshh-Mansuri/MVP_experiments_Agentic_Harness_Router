[391.844809, "o", "\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K \u001b[01;31m\u001b[Kdouble a\u001b[m\u001b[K=X*X+d*d+1, \u001b[01;31m\u001b[Kq=\u001b[m\u001b[K2*(1.5*d-3), c=.25+9-1; /* ray-sphere quadratic */\r\n\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K \u001b[01;31m\u001b[Kdouble D\u001b[m\u001b[K=q*q-4*a*c, ts=1e9;\r\n"]
