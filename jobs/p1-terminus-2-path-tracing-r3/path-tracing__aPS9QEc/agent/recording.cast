[428.391738, "i", "sed -i '5s/d\\*d+1/q=0;Y*Y+1/;5s/2\\*(\\.5\\*d-3)/2*(.5*Y-3)/' image.c\n# repair the replacement if the compact sed form did not preserve a valid declaration\npython3 - <<'PY'\np='image.c';s=open(p).read();s=s.replace('double a=X*X+q=0;Y*Y+1,q=2*(.5*Y-3)', 'double a=X*X+Y*Y+1,q=2*(.5*Y-3)');open(p,'w').write(s)\nPY\ngrep -n 'if(y<900)' image.c\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\nprint('rmse',math.sqrt(sum((A[j]-B[j])**2 for j in range(len(A)))/len(A)))\nxs=[]\nfor y in range(700,1400):\n for x in range(w):\n  k=3*(y*w+x);r,g,b=B[k:k+3]\n  if r>g*2 and g<40:xs.append((x,y))\nprint('bounds',min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs))\nPY\nwc -c image.c; gzip -c image.c | wc -c\n"]
[428.394008, "o", "sed -i '5s/d\\*d+1/q=0;Y*Y+1/;5s/2\\*(\\.5\\*d-3)/2*(.5*Y-3)/' image.c\r\n# repair the replacement if the compact sed form did not preserve a valid declaration\r\npython3 - <<'PY'\r\np='image.c';s=open(p).read();s=s.replace('double a=X*X+q=0;Y*Y+1,q=2*(.5*Y-3)', 'double a=X*X+Y*Y+1,q=2*(.5*Y-3)');open(p,'w').write(s)\r\nPY\r\ngrep -n 'if(y<900)' image.c\r\ngcc -O2 -static -o image image.c -lm && ./image\r\npython3 - <<'PY'\r\nimport math\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\r\nprint('rmse',math.sqrt(sum((A[j]-B[j])**2 for j in range(len(A)))/len(A)))\r\nxs=[]\r\nfor y in range(700,1400):\r\n for x in range(w):\r\n  k=3*(y*w+x);r,g,b=B[k:k+3]\r\n  if r>g*2 and g<40:xs.append((x,y))\r\nprint('bounds',min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs))\r\nPY\r\nwc -c image.c; gzip -c image.c | wc -c\r\n"]
