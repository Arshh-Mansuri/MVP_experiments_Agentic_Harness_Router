[94.45971, "i", "cat > image.c <<'EOF'\n#include <stdio.h>\n#include <math.h>\nint main(){FILE*f=fopen(\"reconstructed.ppm\",\"wb\");int W=2400,H=1800,x,y;fwrite(\"P6\\n2400 1800\\n255\\n\",1,15,f);\nfor(y=0;y<H;y++)for(x=0;x<W;x++){double X=(x-1200)/600.,Y=(900-y)/600.,dx=fabs(x-1200)/1200.,r,g,b;\nif(y<900){r=146+.0475*y+13*dx*dx*(1-y/900.);g=190+.030*y+7*dx*dx*(1-y/900.);b=255;}\nelse{double d=Y, t=-1.5/d, Xw=X*t, Z=t;int ix=(int)floor(Xw),iz=(int)floor(Z);r=g=b=((ix+iz)&1)?67:152;\n double a=X*X+d*d+1, q=2*(-1.5*d-3), c=2.25+2.25-6+9-1; /* ray-sphere quadratic */\n double D=q*q-4*a*c, ts=1e9;\n if(D>0){double u=(-q-sqrt(D))/(2*a);if(u>0)ts=u;}\n if(ts<t){double sx=X*ts, sy=1.5+d*ts, sz=ts; double lx=-2-sx,ly=5-sy,lz=1-sz,L=sqrt(lx*lx+ly*ly+lz*lz);lx/=L;ly/=L;lz/=L;double nx=sx,ny=sy-1,nz=sz-3,N=sqrt(nx*nx+ny*ny+nz*nz);double z=nx*lx+ny*ly+nz*lz;double sh=.35+.65*(z>0?z/N:0);r=51*sh;g=10*sh;b=10*sh;}\n else {double px=X*t,pz=t;double sx=px-(-2),sz=pz-1;double tt=1.5/5.;double hx=px+sx*tt,hz=pz+sz*tt;double dd=sqrt(hx*hx+(hz-3)*(hz-3));if(dd<1&&pz>3)r=g=b=20;}\n}\nunsigned char q[3]={r<0?0:r>255?255:r,g<0?0:g>255?255:g,b<0?0:b>255?255:b};fwrite(q,1,3,f);}fclose(f);}\nEOF\ngcc -O2 -static -o image image.c -lm && ./image\nwc -c image.c; gzip -c image.c | wc -c\n"]
