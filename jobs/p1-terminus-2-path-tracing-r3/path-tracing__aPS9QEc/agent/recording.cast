[221.0168, "i", "sed -i 's/t=-.5\\/d/t=-15\\/d/' image.c\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\nfor name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\n s=n=0\n for y in range(y0,y1):\n  for x in range(w):\n   k=3*(y*w+x)\n   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1\n print(name,math.sqrt(s/n))\nPY\n"]
[221.018188, "o", "sed -i 's/t=-.5\\/d/t=-15\\/d/' image.c\r\ngcc -O2 -static -o image image.c -lm && ./image\r\npython3 - <<'PY'\r\nimport math\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\r\nfor name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\r\n s=n=0\r\n for y in range(y0,y1):\r\n  for x in range(w):\r\n   k=3*(y*w+x)\r\n   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1\r\n print(name,math.sqrt(s/n))\r\nPY\r\n"]
