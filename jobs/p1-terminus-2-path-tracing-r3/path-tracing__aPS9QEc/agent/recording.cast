[263.196251, "i", "python3 - <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\ndef row(a,y):\n z=[];last=None;st=0\n for x in range(w):\n  k=3*(y*w+x);v=tuple(a[k:k+3])\n  if v!=last:\n   if x-st>30:z.append((st,x-1,last))\n   st=x;last=v;st=x\n if w-st>30:z.append((st,w-1,last))\n return z[:12]\nfor y in [900,920,950,1000,1100,1200,1300,1500,1700]:\n print('Y',y,'T',row(A,y));print('  G',row(B,y))\n# ground mismatch excluding red/shadow pixels\nn=m=0\nfor y in range(900,1800):\n for x in range(w):\n  k=3*(y*w+x); t=tuple(A[k:k+3]);g=tuple(B[k:k+3])\n  if t in ((67,67,67),(152,152,152)):n+=1;m+=t!=g\nprint('checker mismatch',m,n,m/n)\nPY\n"]
[263.197099, "o", "python3 - <<'PY'\r\n"]
