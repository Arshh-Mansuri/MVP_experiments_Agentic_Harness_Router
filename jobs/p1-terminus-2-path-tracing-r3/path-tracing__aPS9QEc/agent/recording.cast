[290.37536, "i", "python3 - <<'PY'\np='image.c';s=open(p).read()\nold='double z=nx*lx+ny*ly+nz*lz;double sh=.35+.65*(z>0?z/N:0);r=51*sh;g=10*sh;b=10*sh;'\ns=s.replace(old,'r=51;g=10;b=10;')\nold='double px=X*t,pz=t;double sx=px-(-2),sz=pz-1;double tt=1.5/5.;double hx=px+sx*tt,hz=pz+sz*tt;double dd=sqrt(hx*hx+(hz-3)*(hz-3));if(dd<1&&pz>3)r=g=b=20;'\nnew='double u=(x-850)/400.,v=(y-1300)/180.;if(u*u+v*v<1){r*=.3;g*=.3;b*=.3;}'\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\nfor name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\n s=n=0\n for y in range(y0,y1):\n  for x in range(w):\n   k=3*(y*w+x)\n   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1\n print(name,math.sqrt(s/n))\nPY\nwc -c image.c; gzip -c image.c | wc -c\n"]
