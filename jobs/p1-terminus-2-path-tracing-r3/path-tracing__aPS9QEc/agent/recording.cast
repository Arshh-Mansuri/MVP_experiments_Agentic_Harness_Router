[31.639355, "i", "python3 - <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\n# average blocks, character based on RGB\nfor yy in range(45):\n s=''\n for xx in range(80):\n  vals=[]\n  for y in range(yy*h//45,(yy+1)*h//45):\n   for x in range(xx*w//80,(xx+1)*w//80): vals.append((a[3*(y*w+x)],a[3*(y*w+x)+1],a[3*(y*w+x)+2]))\n  r=sum(v[0] for v in vals)//len(vals);g=sum(v[1] for v in vals)//len(vals);b=sum(v[2] for v in vals)//len(vals)\n  if r>g+35: c='R'\n  elif b>r+35: c='.'\n  elif max(r,g,b)<35:c='@'\n  elif max(r,g,b)<70:c='#'\n  elif max(r,g,b)<110:c='+'\n  elif max(r,g,b)<170:c='o'\n  elif max(r,g,b)<220:c='O'\n  else:c='W'\n  s+=c\n print(s)\nPY\n"]
