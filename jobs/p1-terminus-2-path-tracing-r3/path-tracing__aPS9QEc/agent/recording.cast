[35.777633, "i", "python3 - <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\nfor col,n in [((152,152,152),'gray152'),((67,67,67),'gray67'),((51,10,10),'red'),((20,20,20),'dark')]:\n pts=[(i%w,i//w) for i in range(w*h) if tuple(a[3*i:3*i+3])==col]\n print(n,len(pts), (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else '')\nPY\n"]
[35.777961, "o", "python3 - <<'PY'\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\r\nfor col,n in [((152,152,152),'gray152'),((67,67,67),'gray67'),((51,10,10),'red'),((20,20,20),'dark')]:\r\n pts=[(i%w,i//w) for i in range(w*h) if tuple(a[3*i:3*i+3])==col]\r\n print(n,len(pts), (min(x for x,y in pts),min(y for x,y in pts),max(x for x,y in pts),max(y for x,y in pts)) if pts else '')\r\nPY\r\n"]
