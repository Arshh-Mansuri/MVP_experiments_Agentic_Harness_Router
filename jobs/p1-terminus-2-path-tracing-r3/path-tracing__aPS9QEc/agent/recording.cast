[161.274373, "i", "sed -i 's/,1,15,f)/,1,18,f)/' image.c\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]))\nq=open('reconstructed.ppm','rb').read();print('header',repr(q[:18]),'size',len(q));B=list(q[18:]);print('payload',len(B),'expected',w*h*3)\nfor name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\n ss=sa=n=0\n for y in range(y0,y1):\n  for x in range(w):\n   k=3*(y*w+x)\n   for c in range(3):\n    d=A[k+c]-B[k+c];ss+=d*d;sa+=abs(d);n+=1\n print(name,'rmse',math.sqrt(ss/n),'mae',sa/n)\nfor x,y in [(0,0),(1200,0),(0,899),(1200,899),(0,900),(300,1000),(1200,1000),(1200,1200),(1200,1500)]:\n k=3*(y*w+x);print(x,y,tuple(A[k:k+3]),tuple(B[k:k+3]))\nPY\nwc -c image.c; gzip -c image.c | wc -c\n"]
