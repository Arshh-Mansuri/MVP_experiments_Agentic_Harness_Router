[417.516916, "i", "python3 - <<'PY'\np='image.c';s=open(p).read();old='if(y<900){r=146+.0475*y+13*dx*dx*(1-y/900.);g=190+.030*y+7*dx*dx*(1-y/900.);b=255;}'\nnew='if(y<900){r=146+.0475*y+13*dx*dx*(1-y/900.);g=190+.030*y+7*dx*dx*(1-y/900.);b=255;double a=X*X+d*d+1,q=2*(.5*d-3),c=8.25,D=q*q-4*a*c;if(D>0&&(-q-sqrt(D))/(2*a)>0)r=51,g=10,b=10;}'\ns=s.replace(old,new);open(p,'w').write(s)\nPY\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\ns=n=0\nfor j in range(len(A)):s+=(A[j]-B[j])**2;n+=1\nprint('rmse',math.sqrt(s/n))\nxs=[]\nfor y in range(700,1400):\n for x in range(w):\n  k=3*(y*w+x);r,g,b=B[k:k+3]\n  if r>g*2 and g<40:xs.append((x,y))\nprint('bounds',min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs))\nPY\nwc -c image.c; gzip -c image.c | wc -c\n"]
