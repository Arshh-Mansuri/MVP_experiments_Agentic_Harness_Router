[136.628349, "i", "python3 - <<'PY'\nfrom collections import Counter\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]))\nq=open('reconstructed.ppm','rb').read();i=q.index(b'\\n255\\n')+6;B=list(q[i:]);\nprint(len(A),len(B),q[:i])\nfor name,ys in [('sky',(0,900)),('ground',(900,1800)),('top',(0,800)),('sphere',(800,1300))]:\n z=[]\n for y in range(*ys):\n  for x in range(w):\n   k=3*(y*w+x);z.extend((A[k]-B[k],A[k+1]-B[k+1],A[k+2]-B[k+2]))\n import math\n print(name,math.sqrt(sum(v*v for v in z)/len(z)),sum(abs(v) for v in z)/len(z))\nprint('gen',Counter(map(tuple,zip(B[::3],B[1::3],B[2::3]))).most_common(12))\nfor x,y in [(0,0),(1200,0),(0,899),(1200,899),(0,900),(300,1000),(1200,1000),(1200,1200),(1200,1500)]:\n k=3*(y*w+x);print(x,y,tuple(A[k:k+3]),tuple(B[k:k+3]))\nPY\n"]
