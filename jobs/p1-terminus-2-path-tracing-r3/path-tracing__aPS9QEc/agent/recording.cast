[195.413514, "i", "python3 - <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\ndef q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])\nfor y in [900,920,950,1000,1050,1100,1150,1200,1250,1300,1400,1500,1600,1700,1799]:\n # transitions in grayscale/other color, omit short antialias runs\n z=[q(x,y) for x in range(w)]; runs=[];st=0\n for x in range(1,w):\n  if z[x]!=z[x-1]:\n   if x-st>=10:runs.append((st,x-1,z[x-1]))\n   st=x\n if w-st>=10:runs.append((st,w-1,z[-1]))\n print(y,runs[:30])\nPY\n"]
[195.414979, "o", "python3 - <<'PY'\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\r\ndef q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])\r\nfor y in [900,920,950,1000,1050,1100,1150,1200,1250,1300,1400,1500,1600,1700,1799]:\r\n # transitions in grayscale/other color, omit short antialias runs\r\n z=[q(x,y) for x in range(w)]; runs=[];st=0\r\n for x in range(1,w):\r\n  if z[x]!=z[x-1]:\r\n   if x-st>=10:runs.append((st,x-1,z[x-1]))\r\n   st=x\r\n if w-st>=10:runs.append((st,w-1,z[-1]))\r\n print(y,runs[:30])\r\nPY\r\n"]
[198.456694, "o", "all rmse 45.52116948515598 mae 23.58895972222222\r\n"]
[199.891443, "i", "python3 - <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\nfor y in range(780,1450,10):\n xs=[]\n for x in range(w):\n  r,g,b=a[3*(y*w+x):3*(y*w+x)+3]\n  if r>g*2 and g<40:xs.append(x)\n if xs:print(y,min(xs),max(xs),len(xs))\nPY\n"]
[199.905086, "o", "python3 - <<'PY'\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\r\nfor y in range(780,1450,10):\r\n xs=[]\r\n for x in range(w):\r\n  r,g,b=a[3*(y*w+x):3*(y*w+x)+3]\r\n  if r>g*2 and g<40:xs.append(x)\r\n if xs:print(y,min(xs),max(xs),len(xs))\r\nPY\r\n"]
