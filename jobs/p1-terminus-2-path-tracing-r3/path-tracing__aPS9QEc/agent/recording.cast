[16.364201, "i", "python3 - <<'PY'\nfrom collections import Counter\np=open('image.ppm','rb').read().split()\nassert p[0]==b'P3'\nw,h,m=map(int,p[1:4]); a=list(map(int,p[4:]))\npix=[tuple(a[i:i+3]) for i in range(0,len(a),3)]\nprint('size',w,h,'pixels',len(pix),'max',m)\nc=Counter(pix); print('unique',len(c)); print('top',c.most_common(30))\nfor name,fn in [('min',min),('max',max)]: print(name,[fn(x[k] for x in pix) for k in range(3)])\n# sample a 60x30 thumbnail by nearest pixel, map dominant colors to symbols\nfor y in range(30):\n s=''\n for x in range(60):\n  q=pix[(y*h//30)*w+(x*w//60)]\n  # common exact color categories / grayscale-ish encoding\n  if q==(159,197,255): ch='.'\n  elif q[0]>240 and q[1]>240 and q[2]>240: ch='W'\n  elif max(q)-min(q)<15 and sum(q)//3<80: ch='#'\n  elif q[2]>q[0]+30: ch='B'\n  elif q[1]>q[0]+25: ch='G'\n  elif q[0]>q[1]+25: ch='R'\n  else: ch='o'\n  s+=ch\n print(s)\nPY\n"]
