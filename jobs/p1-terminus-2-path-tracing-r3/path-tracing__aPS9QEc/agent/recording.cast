[352.527981, "o", "\u001b[?2004hroot@2f8a8f8798bd:/app# "]
[369.258901, "i", "sed -i 's/q=2*(1.5\\*d-3)/q=2*(.5*d-3)/' image.c\ngcc -O2 -static -o image image.c -lm && ./image\npython3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\nfor name,y0,y1 in [('all',0,1800),('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\n s=n=0\n for y in range(y0,y1):\n  for x in range(w):\n   k=3*(y*w+x)\n   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1\n print(name,math.sqrt(s/n))\nxs=[]\nfor y in range(700,1500):\n for x in range(w):\n  k=3*(y*w+x)\n  if B[k]>B[k+1]*2 and B[k+1]<40:xs.append((x,y))\nprint('red bounds',min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs))\nPY\nwc -c image.c; gzip -c image.c | wc -c\n"]
[369.261878, "o", "sed -i 's/q=2*(1.5\\*d-3)/q=2*(.5*d-3)/' image.c\r\n\u001b[?2004l\r"]
