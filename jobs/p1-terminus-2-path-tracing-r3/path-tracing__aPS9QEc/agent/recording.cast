[385.689327, "i", "grep -n 'double a\\|q=\\|double D' image.c\npython3 - <<'PY'\nq=open('reconstructed.ppm','rb').read();B=q[17:];w=2400;xs=[]\nfor y in range(700,1500):\n for x in range(w):\n  k=3*(y*w+x);r,g,b=B[k:k+3]\n  if r>g*2 and g<40:xs.append((x,y))\nprint('bounds', (min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs)) if xs else None)\nPY\n"]
[385.690113, "o", "grep -n 'double a\\|q=\\|double D' image.c\r\npython3 - <<'PY'\r\nq=open('reconstructed.ppm','rb').read();B=q[17:];w=2400;xs=[]\r\nfor y in range(700,1500):\r\n for x in range(w):\r\n  k=3*(y*w+x);r,g,b=B[k:k+3]\r\n  if r>g*2 and g<40:xs.append((x,y))\r\nprint('bounds', (min(x for x,y in xs),max(x for x,y in xs),min(y for x,y in xs),max(y for x,y in xs)) if xs else None)\r\nPY\r\n"]
