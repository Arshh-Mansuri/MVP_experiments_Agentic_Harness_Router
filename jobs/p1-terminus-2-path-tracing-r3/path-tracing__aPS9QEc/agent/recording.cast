[47.395959, "i", "cat > /tmp/an.py <<'PY'\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\ndef q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])\ndef runs(y):\n old=q(0,y); st=0\n for x in range(1,w):\n  z=q(x,y)\n  if z!=old:\n   if x-st>20: print(st,x-1,x-st,old)\n   st=x;old=z\n if w-st>20:print(st,w-1,w-st,old)\nfor y in [0,100,300,500,600,650,675,700,750,800,900,1000,1200,1500,1799]:\n print('\\nY',y,'samples',[q(x,y) for x in [0,300,600,900,1100,1150,1200,1250,1300,1500,1800,2100,2399]])\n print('runs:');runs(y)\nprint('vertical center')\nfor y in range(0,h,50):print(y,q(0,y),q(1200,y),q(2399,y))\nPY\npython3 /tmp/an.py\n"]
[47.397564, "o", "cat > /tmp/an.py <<'PY'\r\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);a=list(map(int,p[4:]));\r\ndef q(x,y):return tuple(a[3*(y*w+x):3*(y*w+x)+3])\r\ndef runs(y):\r\n old=q(0,y); st=0\r\n for x in range(1,w):\r\n  z=q(x,y)\r\n  if z!=old:\r\n   if x-st>20: print(st,x-1,x-st,old)\r\n   st=x;old=z\r\n if w-st>20:print(st,w-1,w-st,old)\r\nfor y in [0,100,300,500,600,650,675,700,750,800,900,1000,1200,1500,1799]:\r\n print('\\nY',y,'samples',[q(x,y) for x in [0,300,600,900,1100,1150,1200,1250,1300,1500,1800,2100,2399]])\r\n print('runs:');runs(y)\r\nprint('vertical center')\r\nfor y in range(0,h,50):print(y,q(0,y),q(1200,y),q(2399,y))\r\nPY\r\npython3 /tmp/an.py\r\n"]
