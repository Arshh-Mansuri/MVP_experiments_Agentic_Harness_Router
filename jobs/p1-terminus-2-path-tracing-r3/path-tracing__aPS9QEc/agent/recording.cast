[146.352427, "i", "python3 - <<'PY'\nfrom collections import Counter\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]))\nq=open('reconstructed.ppm','rb').read();j=q.find(b'255\\n');print('headerpos',j,repr(q[:j+4]));B=list(q[j+4:]);print('lengths',len(A),len(B))\nfor name,y0,y1 in [('sky',0,900),('ground',900,1800),('sphere',800,1300)]:\n ss=0;n=0;sa=0\n for y in range(y0,y1):\n  for x in range(w):\n   k=3*(y*w+x)\n   for c in range(3):\n    d=A[k+c]-B[k+c];ss+=d*d;sa+=abs(d);n+=1\n print(name,'rmse',math.sqrt(ss/n),'mae',sa/n)\nprint('samples')\nfor x,y in [(0,0),(1200,0),(0,899),(1200,899),(0,900),(300,1000),(1200,1000),(1200,1200),(1200,1500)]:\n k=3*(y*w+x);print(x,y,tuple(A[k:k+3]),tuple(B[k:k+3]))\nPY\n"]
