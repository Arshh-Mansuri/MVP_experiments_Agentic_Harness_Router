[490.627125, "i", "python3 - <<'PY'\nfrom collections import Counter\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\ndef runs(a,y):\n z=[];last=None;st=0\n for x in range(w):\n  k=3*(y*w+x);v=tuple(a[k:k+3])\n  if v!=last:\n   if x-st>30:z.append((st,x-1,last))\n   st=x;last=v\n if w-st>30:z.append((st,w-1,last))\n return z[:14]\nfor y in [950,1000,1100,1200,1300,1500,1700]:print(y,'T',runs(A,y),'G',runs(B,y))\nfor name,a in [('T',A),('G',B)]:\n c=Counter(tuple(a[3*i:3*i+3]) for i in range(w*800, min(w*h,w*1300)))\n print(name,c.most_common(12))\nPY\n"]
[490.628457, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
