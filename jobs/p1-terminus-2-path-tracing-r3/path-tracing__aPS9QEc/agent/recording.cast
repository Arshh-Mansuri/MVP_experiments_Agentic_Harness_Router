[335.305349, "i", "python3 - <<'PY'\nimport math\np=open('image.ppm','rb').read().split();w,h=map(int,p[1:3]);A=list(map(int,p[4:]));B=list(open('reconstructed.ppm','rb').read()[17:])\nfor name,y0,y1,x0,x1 in [('all',0,1800,0,w),('sky',0,900,0,w),('ground',900,1800,0,w),('sphere',800,1200,950,1450),('shadow',1150,1450,400,1300)]:\n s=n=0\n for y in range(y0,y1):\n  for x in range(x0,x1):\n   k=3*(y*w+x)\n   for c in range(3):s+=(A[k+c]-B[k+c])**2;n+=1\n print(name,math.sqrt(s/n))\ndef runs(a,y):\n z=[];last=None;st=0\n for x in range(w):\n  k=3*(y*w+x);v=tuple(a[k:k+3])\n  if v!=last:\n   if x-st>40:z.append((st,x-1,last))\n   st=x;last=v\n if w-st>40:z.append((st,w-1,last))\n return z\nfor y in [950,1000,1100,1200,1300,1500]:\n print(y,'T',runs(A,y)[:18]);print(y,'G',runs(B,y)[:18])\nPY\n"]
[335.305903, "o", "python3 - <<'PY'\r\n"]
