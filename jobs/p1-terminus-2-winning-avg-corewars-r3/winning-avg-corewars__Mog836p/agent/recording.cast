[41.152595, "o", "\u001b[?2004h> ;redcode-94\r\n\u001b[?2004l\r\u001b[?2004h> ;name Rapid Scanner\r\n\u001b[?2004l\r\u001b[?2004h> ;author challenge\r\n\u001b[?2004l\r\u001b[?2004h> ;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> step equ 17\r\n\u001b[?2004l\r\u001b[?2004h> start   spl     1\r\n\u001b[?2004l\r\u001b[?2004h>         spl     scan\r\n\u001b[?2004l\r\u001b[?2004h>         jmp     clear\r\n\u001b[?2004l\r\u001b[?2004h> scan    add     #step, ptr\r\n\u001b[?2004l\r\u001b[?2004h>         jmz.f   scan, @ptr\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, @ptr\r\n\u001b[?2004l\r\u001b[?2004h>         mov     bomb, *ptr\r\n\u001b[?2004l\r\u001b[?2004h"]
