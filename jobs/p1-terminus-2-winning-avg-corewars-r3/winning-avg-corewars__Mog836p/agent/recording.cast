[134.41989, "i", "python3 - <<'PY'\nfrom pathlib import Path\nsrc=Path('warriors/g2-clear.red').read_text()\nfor b in range(1,33):\n    s=src.replace('bptr    dat,       9', 'bptr    dat,       9') if False else src\n    # Replace only the actual source line's B field.\n    s=s.replace('bptr    dat,       9', f'bptr    dat,       {b}')\n    s=s.replace('bptr    dat,       9', f'bptr    dat,       {b}')\n    # source has spacing and operands; robustly replace the line\n    lines=[]\n    for line in s.splitlines():\n        if line.lstrip().startswith('bptr'):\n            line=f'bptr    dat     bomb,       {b}'\n        lines.append(line)\n    Path(f'g2b{b}.red').write_text('\\n'.join(lines)+'\\n')\nPY\nfor b in $(seq 1 32); do printf 'b%02d ' $b; pmars -b -r 100 g2b$b.red warriors/stone.red | tail -1; done\n"]
[134.425012, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> src=Path('warriors/g2-clear.red').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> for b in range(1,33):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.429804, "o", "    s=src.replace('bptr    dat,       9', 'bptr    dat,       9') if False else src\r\n\u001b[?2004l\r\u001b[?2004h>     # Replace only the actual source line's B field.\r\n\u001b[?2004l\r\u001b[?2004h>     s=s.replace('bptr    dat,       9', f'bptr    dat,       {b}')\r\n\u001b[?2004l\r"]
