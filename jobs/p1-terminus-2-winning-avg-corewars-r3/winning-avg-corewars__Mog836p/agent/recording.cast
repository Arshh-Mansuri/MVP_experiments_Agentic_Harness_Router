[60.252139, "i", "cat > scan4.red <<'EOF'\n;redcode-94\n;name Fast Scan 4\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 4\nstart spl 1\n      spl scan\n      jmp clear\nscan  add #step, p\n      jmz.f scan, @p\n      mov bomb, @p\n      mov bomb, *p\n      jmp scan\np     dat 100,100\nbomb  dat 0,0\nclear mov bomb, >gate\n      djn clear, >gate\ngate  dat 0,4000\n      end start\nEOF\ncat > scan8.red <<'EOF'\n;redcode-94\n;name Fast Scan 8\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstep equ 8\nstart spl 1\n      spl scan\n      jmp clear\nscan  add #step, p\n      jmz.f scan, @p\n      mov bomb, @p\n      mov bomb, *p\n      jmp scan\np     dat 100,100\nbomb  dat 0,0\nclear mov bomb, >gate\n      djn clear, >gate\ngate  dat 0,4000\n      end start\nEOF\nfor w in scan4 scan8; do echo ===$w===; for o in stone vampire paper snake g2-clear; do pmars -b -r 100 $w.red warriors/$o.red | tail -1; done; done\n"]
