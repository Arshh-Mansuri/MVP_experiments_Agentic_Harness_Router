[206.990548, "i", "for b in 21 27; do for d in 2600 2700; do python3 - \"$b\" \"$d\" <<'PY'\nfrom pathlib import Path\nimport sys\nb,d=sys.argv[1:]\ns=Path('warriors/g2-clear.red').read_text()\nlines=[]\nfor line in s.replace('dec     equ     2700',f'dec     equ     {d}').splitlines():\n    if line.lstrip().startswith('bptr'):\n        line=f'bptr    dat     bomb,       {b}'\n    lines.append(line)\nPath(f'combo{b}_{d}.red').write_text('\\n'.join(lines)+'\\n')\nPY\n  done; done\nfor w in combo21_2600 combo21_2700 combo27_2600 combo27_2700; do echo ===$w===; for o in stone vampire paper snake g2-clear; do printf '%-9s ' \"$o\"; pmars -b -r 100 $w.red warriors/$o.red | tail -1; done; done\n"]
[206.996318, "o", "for b in 21 27; do for d in 2600 2700; do python3 - \"$b\" \"$d\" <<'PY'\r\nfrom pathlib import Path\r\nimport sys\r\nb,d=sys.argv[1:]\r\ns=Path('warriors/g2-clear.red').read_text()\r\nlines=[]\r\nfor line in s.replace('dec     equ     2700',f'dec     equ     {d}').splitlines():\r\n    if line.lstrip().startswith('bptr'):\r\n        line=f'bptr    dat     bomb,       {b}'\r\n    lines.append(line)\r\nPath(f'combo{b}_{d}.red').write_text('\\n'.join(lines)+'\\n')\r\nPY\r\n  done; done\r\nfor w in combo21_2600 combo21_2700 combo27_2600 combo27_2700; do echo ===$w===; for o in stone vampire paper snake g2-clear; do printf '%-9s ' \"$o\"; pmars -b -r 100 $w.red warriors/$o.red | tail -1; done; done\r\n"]
