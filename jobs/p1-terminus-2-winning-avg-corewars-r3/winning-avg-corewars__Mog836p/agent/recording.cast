[38.90523, "i", "cat > my_warrior.red <<'EOF'\n;redcode-94\n;name Rapid Scanner\n;author challenge\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\n\nstep equ 17\nstart   spl     1\n        spl     scan\n        jmp     clear\nscan    add     #step, ptr\n        jmz.f   scan, @ptr\n        mov     bomb, @ptr\n        mov     bomb, *ptr\n        jmp     scan\nptr     dat     100, 100\nbomb    dat     0, 0\nclear   mov     bomb, >gate\n        djn     clear, >gate\ngate    dat     0, 4000\n        end     start\nEOF\npmars -b -r 100 my_warrior.red warriors/stone.red; pmars -b -r 100 my_warrior.red warriors/vampire.red; pmars -b -r 100 my_warrior.red warriors/paper.red; pmars -b -r 100 my_warrior.red warriors/snake.red; pmars -b -r 100 my_warrior.red warriors/g2-clear.red\n"]
[38.906525, "o", "cat > my_warrior.red <<'EOF'\r\n;redcode-94\r\n;name Rapid Scanner\r\n;author challenge\r\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\r\n\r\nstep equ 17\r\nstart   spl     1\r\n        spl     scan\r\n        jmp     clear\r\nscan    add     #step, ptr\r\n        jmz.f   scan, @ptr\r\n        mov     bomb, @ptr\r\n        mov     bomb, *ptr\r\n        jmp     scan\r\nptr     dat     100, 100\r\nbomb    dat     0, 0\r\nclear   mov     bomb, >gate\r\n        djn     clear, >gate\r\ngate    dat     0, 4000\r\n        end     start\r\nEOF\r\npmars -b -r 100 my_warrior.red warriors/stone.red; pmars -b -r 100 my_warrior.red warriors/vampire.red; pmars -b -r 100 my_warrior.red warriors/paper.red; pmars -b -r 100 my_warrior.red warriors/snake.red; pmars -b -r 100 my_warrior.red warriors/g2-clear.red\r\n"]
