[69.872861, "i", "cat > imp.red <<'EOF'\n;redcode-94\n;name Imp Spiral\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart spl 1\n      spl 1\n      spl imp\n      spl imp+2667\n      spl imp+5334\n      jmp imp+1\nimp   mov 0,2667\n      end start\nEOF\nfor o in stone vampire paper snake g2-clear; do echo ===$o===; pmars -b -r 100 imp.red warriors/$o.red | tail -1; done\n"]
