[109.886694, "i", "cat > hybridbomb.red <<'EOF'\n;redcode-94\n;name Carpet Imp Hybrid\n;assert CORESIZE == 8000 && MAXCYCLES == 80000\nstart spl 1\n      spl 1\n      spl bomber\n      spl imp\n      spl imp+2667\n      spl imp+5334\n      jmp imp+1\nbomber add #4,bptr\n       mov bomb,@bptr\n       jmp bomber\nbptr   dat 100,100\nbomb   dat 0,0\nimp    mov 0,2667\n       end start\nEOF\nfor o in stone vampire paper snake g2-clear; do echo ===$o===; pmars -b -r 100 hybridbomb.red warriors/$o.red | tail -1; done\n"]
