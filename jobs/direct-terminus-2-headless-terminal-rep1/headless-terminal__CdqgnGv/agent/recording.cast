[26.017764, "i", "cd /app && python3 - <<'PY'\nimport time\nfrom headless_terminal import HeadlessTerminal\n\nterm = HeadlessTerminal()\nprint('initial:', repr(term.read_output()))\nterm.send_keystrokes('printf READY\\\\n\\n', 0.15)\nprint('echo:', repr(term.drain_output()))\nterm.send_keystrokes(\"printf 'before\\\\n'; sleep 5\\n\", 0.1)\nterm.send_keystrokes('\\x03', 0.1)\nprint('interrupt:', repr(term.drain_output()))\nterm.send_keystrokes(\"read -p 'name: ' name; printf 'got=%s\\\\n' \\\"$name\\\"\\n\", 0.05)\nterm.send_keystrokes('Ada\\n', 0.1)\nprint('interactive:', repr(term.drain_output()))\nterm.close()\nprint('closed')\nPY\n"]
