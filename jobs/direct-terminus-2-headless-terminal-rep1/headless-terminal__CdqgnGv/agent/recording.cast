[36.488566, "o", "\u001b[?2004hroot@7805d50cd74a:/app# "]
[36.579402, "i", "cd /app && python3 - <<'PY'\nimport os\nimport tempfile\nimport time\nfrom headless_terminal import HeadlessTerminal\n\nwith tempfile.TemporaryDirectory() as home:\n    with open(os.path.join(home, '.bashrc'), 'w') as f:\n        f.write(\"export HEADLESS_STARTUP=loaded\\nprintf 'STARTUP_OK\\\\n'\\n\")\n    t = HeadlessTerminal(env={'HOME': home, 'PS1': 'TESTPROMPT> '})\n    t.send_keystrokes(\"printf 'var=%s\\\\n' \\\"$HEADLESS_STARTUP\\\"\\n\", 0.15)\n    output = t.read_output()\n    print('startup_sourced=', 'STARTUP_OK' in output and 'var=loaded' in output)\n    print(repr(output))\n    t.send_keystrokes(\"sleep 30 & echo bg=$!\\n\", 0.1)\n    t.close()\n    print('closed_process=', t.process.poll() is not None)\nPY\n"]
[36.579672, "o", "cd /app && python3 - <<'PY'\r\n\u001b[?2004l\r"]
