[36.265987, "o", "sed -n '1,260p' /app/headless_terminal.py; printf '\\n--- compile ---\\n'; python3 -m py_compile /app/headless_terminal.py\r\n\u001b[?2004l\r"]
[36.297053, "o", "\"\"\"A small PTY-backed interactive terminal implementation.\"\"\"\r\n"]
[36.297373, "o", "\r\nfrom __future__ import annotations\r\n\r\nimport errno\r\nimport os\r\nimport pty\r\nimport select\r\nimport signal\r\nimport subprocess\r\nimport termios\r\nimport time\r\nfrom typing import Optional\r\n\r\nfrom base_terminal import BaseTerminal\r\n\r\n\r\nclass HeadlessTerminal(BaseTerminal):\r\n    \"\"\"Run an interactive bash shell attached to a pseudo-terminal.\r\n\r\n    Keystrokes are sent unchanged (after UTF-8 encoding), so control\r\n    characters such as ``\"\\\\x03\"`` are delivered to the shell's tty driver.\r\n    Output is captured and can be obtained with :meth:`read_output` or the\r\n    :attr:`output` property.\r\n    \"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        *,\r\n        shell: str = \"/bin/bash\",\r\n        cwd: Optional[str] = None,\r\n        env: Optional[dict[str, str]] = None,\r\n        columns: int = 80,\r\n        rows: int = 24,\r\n    ) -> None:\r\n        self._master_fd, slave_fd = pty.openpty()\r\n        self._closed = False\r\n        self._output = bytearray()\r\n        self._columns = columns\r\n        self._rows = rows\r\n\r\n        "]
[36.297638, "o", "child_env = os.environ.copy()\r\n        if env:\r\n            child_env.update(env)\r\n        child_env.setdefault(\"TERM\", \"xterm-256color\")\r\n        child_env.setdefault(\"COLUMNS\", str(columns))\r\n        child_env.setdefault(\"LINES\", str(rows))\r\n\r\n        # Set the PTY window size before bash starts.  This matters to full\r\n        # screen and interactive programs which query the terminal size.\r\n        try:\r\n            winsize = rows.to_bytes(2, \"little\") + columns.to_bytes(2, \"little\")\r\n            fcntl_ioctl = __import__(\"fcntl\").ioctl\r\n            fcntl_ioctl(slave_fd, termios.TIOCSWINSZ, winsize)\r\n        except (OSError, ValueError):\r\n            pass\r\n\r\n        try:\r\n            self.process = subprocess.Popen(\r\n                [shell, \"-i\"],\r\n                stdin=slave_fd,\r\n                stdout=slave_fd,\r\n                stderr=slave_fd,\r\n                cwd=cwd,\r\n                env=child_env,\r\n                start_new_session=True,\r\n                close_fds=True,\r\n            )\r\n        finally"]
[36.29792, "o", ":\r\n            os.close(slave_fd)\r\n\r\n        os.set_blocking(self._master_fd, False)\r\n        # Give bash a chance to print its initial prompt without making\r\n        # construction block indefinitely on a user's startup file.\r\n        self._collect(0.05)\r\n\r\n    def _collect(self, timeout: float = 0.0) -> None:\r\n        if self._closed:\r\n            return\r\n        deadline = time.monotonic() + max(0.0, timeout)\r\n        while True:\r\n            remaining = max(0.0, deadline - time.monotonic())\r\n            wait = remaining if timeout > 0 else 0.0\r\n            try:\r\n                readable, _, _ = select.select([self._master_fd], [], [], wait)\r\n            except (OSError, ValueError):\r\n                return\r\n            if not readable:\r\n                return\r\n            try:\r\n                data = os.read(self._master_fd, 65536)\r\n            except OSError as exc:\r\n                # Linux PTYs report EIO when the slave side has closed.\r\n                if exc.errno in (errno.EIO, errno.EBADF):\r\n       "]
[36.298153, "o", "             return\r\n                if exc.errno == errno.EINTR:\r\n                    continue\r\n                return\r\n            if not data:\r\n                return\r\n            self._output.extend(data)\r\n            if timeout <= 0:\r\n                # Drain everything currently available without spinning.\r\n                continue\r\n\r\n    def send_keystrokes(self, keystrokes: str, wait_sec: float = 0.0) -> None:\r\n        \"\"\"Write keystrokes to the interactive shell and optionally wait.\"\"\"\r\n        if self._closed:\r\n            raise RuntimeError(\"terminal is closed\")\r\n        if not isinstance(keystrokes, str):\r\n            raise TypeError(\"keystrokes must be a string\")\r\n        data = keystrokes.encode(\"utf-8\")\r\n        view = memoryview(data)\r\n        while view:\r\n            try:\r\n                written = os.write(self._master_fd, view)\r\n                view = view[written:]\r\n            except InterruptedError:\r\n                continue\r\n            except OSError as exc:\r\n                if exc.err"]
[36.298365, "o", "no in (errno.EIO, errno.EBADF):\r\n                    raise RuntimeError(\"terminal process has exited\") from exc\r\n                raise\r\n        self._collect(max(0.0, float(wait_sec)))\r\n        # Even with wait_sec=0, collect output already queued by the kernel.\r\n        self._collect(0.0)\r\n\r\n    def read_output(self, *, clear: bool = False, encoding: str = \"utf-8\") -> str:\r\n        \"\"\"Return captured terminal output, optionally removing it.\"\"\"\r\n        self._collect(0.0)\r\n        data = bytes(self._output)\r\n        if clear:\r\n            self._output.clear()\r\n        return data.decode(encoding, errors=\"replace\")\r\n\r\n    @property\r\n    def output(self) -> str:\r\n        return self.read_output()\r\n\r\n    def drain_output(self) -> str:\r\n        return self.read_output(clear=True)\r\n\r\n    def close(self) -> None:\r\n        if self._closed:\r\n            return\r\n        self._closed = True\r\n        try:\r\n            if self.process.poll() is None:\r\n                try:\r\n                    os.killpg(self.process.pid, "]
[36.298462, "o", "signal.SIGHUP)\r\n                except ProcessLookupError:\r\n                    pass\r\n                try:\r\n                    self.process.wait(timeout=1.0)\r\n                except subprocess.TimeoutExpired:\r\n                    self.process.kill()\r\n                    self.process.wait()\r\n        finally:\r\n            try:\r\n                os.close(self._master_fd)\r\n            except OSError:\r\n                pass\r\n\r\n    def __enter__(self) -> \"HeadlessTerminal\":\r\n        return self\r\n\r\n    def __exit__(self, exc_type, exc_value, traceback) -> None:\r\n        self.close()\r\n\r\n    def __del__(self) -> None:\r\n        try:\r\n            self.close()\r\n        except Exception:\r\n            pass\r\n"]
