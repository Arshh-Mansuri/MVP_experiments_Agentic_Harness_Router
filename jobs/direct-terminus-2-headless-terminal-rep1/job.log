lave_fd,\n                cwd=cwd,\n                env=child_env,\n                start_new_session=True,\n                close_fds=True,\n            )\n        finally:\n            os.close(slave_fd)\n\n        os.set_blocking(self._master_fd, False)\n        # Give bash a chance to print its initial prompt without making\n        # construction block indefinitely on a user\'s startup file.\n        self._collect(0.05)\n\n    def _collect(self, timeout: float = 0.0) -> None:\n        if self._closed:\n            return\n        deadline = time.monotonic() + max(0.0, timeout)\n        while True:\n            remaining = max(0.0, deadline - time.monotonic())\n            wait = remaining if timeout > 0 else 0.0\n            try:\n                readable, _, _ = select.select([self._master_fd], [], [], wait)\n            except (OSError, ValueError):\n                return\n            if not readable:\n                return\n            try:\n                data = os.read(self._master_fd, 65536)\n            except OSError as exc:\n                # Linux PTYs report EIO when the slave side has closed.\n                if exc.errno in (errno.EIO, errno.EBADF):\n                    return\n                if exc.errno == errno.EINTR:\n                    continue\n                return\n            if not data:\n                return\n            self._output.extend(data)\n            if timeout <= 0:\n                # Drain everything currently available without spinning.\n                continue\n\n    def send_keystrokes(self, keystrokes: str, wait_sec: float = 0.0) -> None:\n        """Write keystrokes to the interactive shell and optionally wait."""\n        if self._closed:\n            raise RuntimeError("terminal is closed")\n        if not isinstance(keystrokes, str):\n            raise TypeError("keystrokes must be a string")\n        data = keystrokes.encode("utf-8")\n        view = memoryview(data)\n        while view:\n            try:\n                written = os.write(self._master_fd, view)\n                view = view[written:]\n            except InterruptedError:\n                continue\n            except OSError as exc:\n                if exc.errno in (errno.EIO, errno.EBADF):\n                    raise RuntimeError("terminal process has exited") from exc\n                raise\n        self._collect(max(0.0, float(wait_sec)))\n        # Even with wait_sec=0, collect output already queued by the kernel.\n        self._collect(0.0)\n\n    def read_output(self, *, clear: bool = False, encoding: str = "utf-8") -> str:\n        """Return captured terminal output, optionally removing it."""\n        self._collect(0.0)\n        data = bytes(self._output)\n        if clear:\n            self._output.clear()\n        return data.decode(encoding, errors="replace")\n\n    @property\n    def output(self) -> str:\n        return self.read_output()\n\n    def drain_output(self) -> str:\n        return self.read_output(clear=True)\n\n    def close(self) -> None:\n        if self._closed:\n            return\n        self._closed = True\n        try:\n            if self.process.poll() is None:\n                try:\n                    os.killpg(self.process.pid, signal.SIGHUP)\n                except ProcessLookupError:\n                    pass\n                try:\n                    self.process.wait(timeout=1.0)\n                except subprocess.TimeoutExpired:\n                    self.process.kill()\n                    self.process.wait()\n        finally:\n            try:\n                os.close(self._master_fd)\n            except OSError:\n                pass\n\n    def __enter__(self) -> "HeadlessTerminal":\n        return self\n\n    def __exit__(self, exc_type, exc_value, traceback) -> None:\n        self.close()\n\n    def __del__(self) -> None:\n        try:\n            self.close()\n        except Exception:\n            pass\nPY\npython3 -m py_compile /app/headless_terminal.py\n